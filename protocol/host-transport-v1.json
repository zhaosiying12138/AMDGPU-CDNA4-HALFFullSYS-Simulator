  "statuses": {
    "OK": 0,
    "MALFORMED": 1,
    "UNSUPPORTED_VERSION": 2,
    "UNSUPPORTED_CAPABILITY": 3,
    "INSTANCE_MISMATCH": 4,
    "TOPOLOGY_MISMATCH": 5,
    "UNAUTHORIZED": 6,
    "BUSY": 7,
    "RESOURCE_EXHAUSTED": 8,
    "PROTOCOL_STATE": 9,
    "INTERNAL": 10
  },
  "handshake_rules": {
    "server_versions": ["1.0"],
    "required_session_capabilities": ["TOPOLOGY_IDENTITY_V1"],
    "hello_constraints": {
      "connection_id": 0,
      "nonce": "nonzero",
      "version_range": "lexicographically-ordered-and-must-include-server-version-1.0",
      "required_subset_of_offered": true,
      "topology_tlv": "exactly-once-iff-capability-bit-0-offered",
      "capability_bit_0": "must-be-both-offered-and-required-for-success"
    },
    "correlatable_hello": {
      "requires_valid_envelope": true,
      "minimum_payload_bytes": 96,
      "requires_nonzero_client_nonce": true,
      "otherwise": "silent-drop"
    },
    "await_hello_error_precedence": [
      "MALFORMED",
      "UNSUPPORTED_VERSION",
      "UNSUPPORTED_CAPABILITY",
      "INSTANCE_MISMATCH",
      "TOPOLOGY_MISMATCH",
      "BUSY",
      "RESOURCE_EXHAUSTED",
      "INTERNAL"
    ],
    "established_error_precedence": [
      "MALFORMED",
      "PROTOCOL_STATE",
      "INTERNAL"
    ],
    "failure_ack": {
      "selected_version": "0.0",
      "daemon_instance_uuid": "actual-nonzero",
      "connection_id": 0,
      "job_epoch": "actual-nonzero",
      "server_nonce": "all-zero",
      "selected_capabilities": "all-zero",
      "max_record": "daemon-configured-limit",
      "tlvs": "none",
      "client_validation": "correlate-request-and-nonce;require-known-status-and-canonical-zero-fields-and-legal-max-record;apply-expected-identity-only-on-OK",
      "daemon_conformance": "max-record-equals-configured-limit"
    },
    "success_ack": {
      "selected_version": "1.0",
      "daemon_instance_uuid": "actual-nonzero",
      "connection_id": "new-nonzero-not-reused-within-process",
      "job_epoch": "actual-nonzero",
      "selected_capabilities": ["TOPOLOGY_IDENTITY_V1"],
      "topology_tlv": "exactly-one-actual-identity"
    },
    "wildcards": {
      "daemon_instance_uuid": "all-zero",
      "job_epoch": 0,
      "topology": "job-uuid-all-zero,rank-uint32-max,world-size-zero-as-one-tuple",
      "tp_supervisor": "must-use-exact-nonzero-job-and-epoch-plus-rank-and-world"
    },
    "state_machine": {
      "server_initial": "accept-HELLO-only;other-types-silent-drop",
      "client_waiting": "accept-HELLO_ACK-only;other-types-protocol-error",
      "server_established": "after-envelope-and-structural-validation-second-HELLO-canonical-PROTOCOL_STATE-before-negotiation-failure-ACK-then-close",
      "disconnect": "no-session-replay-or-transparent-reconnect"
    }
  },
  "validation_algorithms": {
    "record_length": "after-bounding-record-size-compare-payload-bytes-to-record-size-minus-80",
    "tlv_length": "require-remaining-at-least-8-then-value-length-at-most-remaining-minus-8-then-bound-padding",
    "crc32c": "validate-bounds-before-checksum"
  },
  "endpoint_security": {
    "absolute_path_only": true,
    "same_effective_uid_required": true,
    "parent": "existing-owner-euid-no-group-or-other-bits-no-symlink-components;all-ancestor-directory-entries-protected-from-untrusted-uid-rename-exchange-or-mount-rebind",
    "parent_filesystem": "supports-hard-links-to-pathname-socket-inodes",
    "lock": "same-directory-regular-no-follow-0600-exclusive-flock-fresh-path-identity-for-listener-lifetime-retained-on-exit",
    "stale_removal": "record-dev-inode-owner-type;probe-econnrefused;fresh-dirfd-fstatat-no-follow-exact-match;unlinkat",
    "bind_publication": "bind-random-private-basename;opath-pin;proc-self-fd-chmod-0600;listen;linkat-no-replace-final-name;unlink-private-name;fresh-final-identity;final-absolute-parent-check-after-published-validation-before-readiness",
    "shutdown_removal": "close-listener;four-immediate-retries-per-cleanup-invocation;ordinary-error-retains-pending-alias-retained-opath-pin-dirfd-lock-inode-and-errno-for-later-shutdown-or-destructor-retry;fresh-dirfd-identity-match-retained-opath-pin;unlinkat;process-exit-may-leave-path-for-verified-stale-recovery;preserve-inspection-errno-and-use-estale-only-for-identity-mismatch",
    "coordination_threat_model": "trusted-ancestor-namespace-plus-0700-parent-excludes-other-uids;same-euid-processes-must-honor-lock;no-claim-against-malicious-same-euid-directory-rewrite",
    "descriptor_flags": ["CLOEXEC", "NONBLOCK"],
    "send_flag": "MSG_NOSIGNAL",
    "receive_reject_flags": ["MSG_TRUNC", "MSG_CTRUNC"]

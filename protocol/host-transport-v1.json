      {"name": "reserved1", "offset": 72, "bytes": 8, "type": "u64", "constant": 0}
    ]
  },
  "messages": {
    "HELLO": {
      "value": 1,
      "fixed_payload_bytes": 96,
      "fields": [
        {"name": "minimum_major", "offset": 0, "bytes": 2, "type": "u16"},
        {"name": "minimum_minor", "offset": 2, "bytes": 2, "type": "u16"},
        {"name": "maximum_major", "offset": 4, "bytes": 2, "type": "u16"},
        {"name": "maximum_minor", "offset": 6, "bytes": 2, "type": "u16"},
        {"name": "client_nonce", "offset": 8, "bytes": 16, "type": "bytes", "constraint": "nonzero"},
        {"name": "offered_capabilities", "offset": 24, "bytes": 32, "type": "bitmap"},
        {"name": "required_capabilities", "offset": 56, "bytes": 32, "type": "bitmap"},
        {"name": "rx_max_record", "offset": 88, "bytes": 4, "type": "u32", "minimum": 4096, "maximum": 65536},
        {"name": "role", "offset": 92, "bytes": 2, "type": "u16", "constant": 1},
        {"name": "reserved", "offset": 94, "bytes": 2, "type": "u16", "constant": 0}
      ]
    },
    "HELLO_ACK": {
      "value": 2,
      "fixed_payload_bytes": 80,
      "fields": [
        {"name": "selected_major", "offset": 0, "bytes": 2, "type": "u16"},
        {"name": "selected_minor", "offset": 2, "bytes": 2, "type": "u16"},
        {"name": "status", "offset": 4, "bytes": 4, "type": "u32"},
        {"name": "client_nonce_echo", "offset": 8, "bytes": 16, "type": "bytes"},
        {"name": "server_nonce", "offset": 24, "bytes": 16, "type": "bytes"},
        {"name": "selected_capabilities", "offset": 40, "bytes": 32, "type": "bitmap"},
        {"name": "max_record", "offset": 72, "bytes": 4, "type": "u32", "minimum": 4096, "maximum": 65536},
        {"name": "role", "offset": 76, "bytes": 2, "type": "u16", "constant": 2},
        {"name": "reserved", "offset": 78, "bytes": 2, "type": "u16", "constant": 0}
      ]
    }

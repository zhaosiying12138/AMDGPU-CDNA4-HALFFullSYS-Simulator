      {"name": "framing_minor", "offset": 10, "bytes": 2, "type": "u16", "constant": 0},
      {"name": "header_bytes", "offset": 12, "bytes": 2, "type": "u16", "constant": 80},
      {"name": "message_type", "offset": 14, "bytes": 2, "type": "u16"},
      {"name": "flags", "offset": 16, "bytes": 4, "type": "u32", "constant": 0},
      {"name": "payload_bytes", "offset": 20, "bytes": 4, "type": "u32"},
      {"name": "request_id", "offset": 24, "bytes": 8, "type": "u64", "constraint": "nonzero"},

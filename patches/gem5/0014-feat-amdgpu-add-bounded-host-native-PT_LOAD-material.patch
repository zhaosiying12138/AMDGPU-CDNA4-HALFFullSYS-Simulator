+{
+namespace hostgpu
+{
+
+namespace
+{
+
+bool
+powerOfTwo(uint64_t value)
+{
+    return value != 0 && (value & (value - 1)) == 0;
+}
+
+} // anonymous namespace
+
+HostNativeCodeObjectMapper::HostNativeCodeObjectMapper(
+    HostGPUMemoryState &memoryState, HostNativeMemoryContext &memoryContext,
+    const HostGPUMemoryState::Owner &memoryOwner)
+    : memory(memoryState), context(memoryContext), owner(memoryOwner)
+{}
+
+const char *
+HostNativeCodeObjectMapper::failureName(Failure value)
+{
+    switch (value) {
+      case Failure::None:
+        return "none";
+      case Failure::InvalidPageSize:
+        return "invalid_page_size";
+      case Failure::MalformedManifest:
+        return "malformed_manifest";
+      case Failure::UnsupportedVersion:
+        return "unsupported_version";
+      case Failure::TopologyMismatch:
+        return "topology_mismatch";
+      case Failure::ImageMismatch:
+        return "image_mismatch";
+      case Failure::InvalidImage:
+        return "invalid_image";
+      case Failure::InvalidSegment:
+        return "invalid_segment";
+      case Failure::RangeOverflow:
+        return "range_overflow";
+      case Failure::Busy:
+        return "busy";
+      case Failure::Allocation:
+        return "allocation";
+      case Failure::PageMap:
+        return "page_map";
+      case Failure::Copy:
+        return "copy";
+    }
+    return "unknown";
+}
+
+bool
+HostNativeCodeObjectMapper::rangeEnd(
+    uint64_t start, uint64_t size, uint64_t &end)
+{
+    if (size > std::numeric_limits<uint64_t>::max() - start)
+        return false;
+    end = start + size;
+    return true;
+}
+
+bool
+HostNativeCodeObjectMapper::rangesOverlap(
+    uint64_t leftStart, uint64_t leftSize,
+    uint64_t rightStart, uint64_t rightSize)
+{
+    uint64_t leftEnd = 0;
+    uint64_t rightEnd = 0;
+    if (!rangeEnd(leftStart, leftSize, leftEnd) ||
+        !rangeEnd(rightStart, rightSize, rightEnd)) {
+        return true;
+    }
+    return leftStart < rightEnd && rightStart < leftEnd;
+}
+
+bool
+HostNativeCodeObjectMapper::signedRelation(
+    uint64_t descriptor, int64_t offset, uint64_t code, uint64_t &entry)
+{
+    if (offset >= 0) {
+        const uint64_t positive = static_cast<uint64_t>(offset);
+        if (descriptor > std::numeric_limits<uint64_t>::max() - positive)
+            return false;
+        entry = descriptor + positive;
+    } else {
+        /* Avoid negating INT64_MIN directly. */
+        const uint64_t magnitude = static_cast<uint64_t>(-(offset + 1)) + 1;
+        if (descriptor < magnitude)
+            return false;
+        entry = descriptor - magnitude;
+    }
+    return entry == code;
+}
+
+bool
+HostNativeCodeObjectMapper::validateSegments(
+    const std::vector<uint8_t> &image,
+    const protocol::CodeObjectManifest &manifest,
+    uint64_t &imageVirtualBase, uint64_t &imageVirtualEnd)
+{
+    imageVirtualBase = std::numeric_limits<uint64_t>::max();
+    imageVirtualEnd = 0;
+    if (manifest.segmentCount == 0 ||
+        manifest.segmentCount > protocol::CodeObjectMaximumSegments) {
+        fail(Failure::InvalidSegment);
+        return false;
+    }
+
+    for (size_t index = 0; index < protocol::CodeObjectMaximumSegments;
+         ++index) {
+        const auto &segment = manifest.segments[index];
+        if (index >= manifest.segmentCount) {
+            if (segment.type != 0 || segment.flags != 0 ||
+                segment.fileOffset != 0 || segment.virtualAddress != 0 ||
+                segment.fileSize != 0 || segment.memorySize != 0 ||
+                segment.alignment != 0) {
+                fail(Failure::InvalidSegment);
+                return false;
+            }
+            continue;
+        }
+
+        if (segment.type != 1 || segment.memorySize == 0 ||
+            segment.memorySize < segment.fileSize ||
+            (segment.flags != 4 && segment.flags != 5 && segment.flags != 6) ||
+            !powerOfTwo(segment.alignment) ||
+            segment.fileOffset > image.size() ||
+            segment.fileSize > image.size() - segment.fileOffset ||
+            segment.fileOffset % segment.alignment !=
+                segment.virtualAddress % segment.alignment) {
+            fail(Failure::InvalidSegment);
+            return false;
+        }
+
+        uint64_t virtualEnd = 0;
+        if (!rangeEnd(segment.virtualAddress, segment.memorySize, virtualEnd)) {
+            fail(Failure::RangeOverflow);
+            return false;
+        }
+        imageVirtualBase = std::min(imageVirtualBase, segment.virtualAddress);
+        imageVirtualEnd = std::max(imageVirtualEnd, virtualEnd);
+
+        for (size_t other = index + 1;
+             other < manifest.segmentCount; ++other) {
+            const auto &right = manifest.segments[other];
+            if (rangesOverlap(segment.fileOffset, segment.fileSize,
+                              right.fileOffset, right.fileSize) ||
+                rangesOverlap(segment.virtualAddress, segment.memorySize,
+                              right.virtualAddress, right.memorySize)) {
+                fail(Failure::InvalidSegment);
+                return false;
+            }
+        }
+    }
+
+    if (imageVirtualBase == std::numeric_limits<uint64_t>::max() ||
+        imageVirtualEnd <= imageVirtualBase) {
+        fail(Failure::InvalidSegment);
+        return false;
+    }
+    uint64_t ignoredEntry = 0;
+    if (!signedRelation(manifest.descriptorVirtualAddress,
+                        manifest.kernelCodeEntryByteOffset,
+                        manifest.codeVirtualAddress, ignoredEntry)) {
+        fail(Failure::InvalidSegment);
+        return false;
+    }
+    return true;
+}
+
+bool
+HostNativeCodeObjectMapper::writeRange(
+    Addr address, const uint8_t *source, uint64_t bytes)
+{
+    if (bytes == 0 || source == nullptr)
+        return bytes == 0;
+    uint64_t copied = 0;
+    while (copied < bytes) {
+        const uint64_t count = std::min<uint64_t>(
+            bytes - copied, HostGPUMemoryState::MaximumTransferBytes);
+        if (address > std::numeric_limits<Addr>::max() - copied ||
+            !context.functionalWrite(address + copied, source + copied,
+                                     count)) {
+            return false;
+        }
+        copied += count;
+    }
+    return true;
+}
+
+bool
+HostNativeCodeObjectMapper::zeroRange(Addr address, uint64_t bytes)
+{
+    if (bytes == 0)
+        return true;
+    try {
+        const uint64_t chunk = std::min<uint64_t>(
+            bytes, HostGPUMemoryState::MaximumTransferBytes);
+        const std::vector<uint8_t> zeros(static_cast<size_t>(chunk), 0);
+        uint64_t cleared = 0;
+        while (cleared < bytes) {
+            const uint64_t count = std::min<uint64_t>(chunk, bytes - cleared);
+            if (address > std::numeric_limits<Addr>::max() - cleared ||
+                !context.functionalWrite(address + cleared, zeros.data(),
+                                         count)) {
+                return false;
+            }
+            cleared += count;
+        }
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    return true;
+}
+
+void
+HostNativeCodeObjectMapper::rollback(
+    const std::optional<HostNativeMemoryContext::PageLease> &lease,
+    const protocol::MemoryResponse &allocation)
+{
+    bool leaseReleased = !(lease && lease->valid());
+    if (!leaseReleased &&
+        memory.functionalPageLeaseCount(
+            owner, lease->allocationId, lease->generation) == 1 &&
+        !memory.pinnedDispatchAllocationBusy(
+            owner, lease->allocationId, lease->generation)) {
+        leaseReleased = context.unmap(*lease);
+    }
+    if (allocation.status == protocol::Status::Ok && leaseReleased &&
+        memory.functionalPageLeaseCount(
+            owner, allocation.allocationId, allocation.generation) == 0 &&
+        !memory.pinnedDispatchAllocationBusy(
+            owner, allocation.allocationId, allocation.generation)) {
+        protocol::MemoryRequest freeRequest;
+        freeRequest.opcode = protocol::MemoryOpcode::Free;
+        freeRequest.allocationId = allocation.allocationId;
+        freeRequest.generation = allocation.generation;
+        memory.free(owner, freeRequest, 0);
+    }
+}
+
+std::optional<HostNativeCodeObjectMapper::Mapping>
+HostNativeCodeObjectMapper::map(
+    const std::vector<uint8_t> &image,
+    const protocol::CodeObjectManifest &manifest)
+{
+    lastFailure = Failure::None;
+    const uint64_t pageBytes = context.pageBytes();
+    if (pageBytes != 4096 && pageBytes != 65536) {
+        fail(Failure::InvalidPageSize);
+        return std::nullopt;
+    }
+    const auto manifestStatus = protocol::validateCodeObjectManifest(manifest);
+    switch (manifestStatus) {
+      case protocol::CodeObjectManifestValidation::Valid:
+        break;
+      case protocol::CodeObjectManifestValidation::UnsupportedVersion:
+        fail(Failure::UnsupportedVersion);
+        return std::nullopt;
+      case protocol::CodeObjectManifestValidation::TopologyMismatch:
+        fail(Failure::TopologyMismatch);
+        return std::nullopt;
+      case protocol::CodeObjectManifestValidation::Malformed:
+        fail(Failure::MalformedManifest);
+        return std::nullopt;
+    }
+
+    if (image.empty() || image.size() != manifest.imageSize ||
+        image.size() > protocol::CodeObjectMaximumImageBytes) {
+        fail(Failure::ImageMismatch);
+        return std::nullopt;
+    }
+    try {
+        if (HostGPUCodeObjectState::imageSha256(image) !=
+            manifest.imageSha256) {
+            fail(Failure::ImageMismatch);
+            return std::nullopt;
+        }
+    } catch (const std::bad_alloc &) {
+        fail(Failure::ImageMismatch);
+        return std::nullopt;
+    }
+    if (!validateCodeObjectImage(image, manifest)) {
+        fail(Failure::InvalidImage);
+        return std::nullopt;
+    }
+
+    uint64_t imageVirtualBase = 0;
+    uint64_t imageVirtualEnd = 0;
+    if (!validateSegments(image, manifest, imageVirtualBase,
+                          imageVirtualEnd)) {
+        if (lastFailure == Failure::None)
+            fail(Failure::InvalidSegment);
+        return std::nullopt;
+    }
+
+    if (imageVirtualEnd > std::numeric_limits<uint64_t>::max() -
+            (pageBytes - 1)) {
+        fail(Failure::RangeOverflow);
+        return std::nullopt;
+    }
+    const uint64_t mappedBase = imageVirtualBase & ~(pageBytes - 1);
+    const uint64_t mappedEnd =
+        (imageVirtualEnd + pageBytes - 1) & ~(pageBytes - 1);
+    if (mappedEnd <= mappedBase || mappedEnd - mappedBase >
+            HostGPUMemoryState::MaximumAllocationBytes) {
+        fail(Failure::RangeOverflow);
+        return std::nullopt;
+    }
+    const uint64_t mappedBytes = mappedEnd - mappedBase;
+
+    protocol::MemoryRequest allocateRequest;
+    allocateRequest.opcode = protocol::MemoryOpcode::Allocate;
+    allocateRequest.byteCount = mappedBytes;
+    allocateRequest.argument = pageBytes;
+    const auto allocation = memory.allocate(owner, allocateRequest, 0);
+    if (allocation.status != protocol::Status::Ok) {
+        fail(Failure::Allocation);
+        return std::nullopt;
+    }
+
+    std::optional<HostNativeMemoryContext::PageLease> lease;
+    try {
+        lease = context.map(allocation.value0, mappedBytes);
+    } catch (const std::bad_alloc &) {
+        lease.reset();
+    }
+    if (!lease) {
+        rollback(lease, allocation);
+        fail(Failure::PageMap);
+        return std::nullopt;
+    }
+
+    Mapping result;
+    result.allocation = {
+        allocation.allocationId, allocation.generation, allocation.value0,
+        mappedBytes, pageBytes};
+    result.lease = *lease;
+    result.imageVirtualBase = mappedBase;
+    result.imageVirtualEnd = mappedEnd;
+    result.mappedBytes = mappedBytes;
+    result.segmentCount = manifest.segmentCount;
+    for (size_t index = 0; index < manifest.segmentCount; ++index) {
+        const auto &segment = manifest.segments[index];
+        const uint64_t relative = segment.virtualAddress - mappedBase;
+        if (relative > mappedBytes ||
+            segment.memorySize > mappedBytes - relative ||
+            allocation.value0 > std::numeric_limits<Addr>::max() - relative) {
+            rollback(lease, allocation);
+            fail(Failure::RangeOverflow);
+            return std::nullopt;
+        }
+        result.segments[index] = {
+            segment, allocation.value0 + relative};
+        if (!writeRange(result.segments[index].mappedAddress,
+                        image.data() + static_cast<size_t>(segment.fileOffset),
+                        segment.fileSize) ||
+            !zeroRange(result.segments[index].mappedAddress + segment.fileSize,
+                       segment.memorySize - segment.fileSize)) {
+            rollback(lease, allocation);
+            fail(Failure::Copy);
+            return std::nullopt;
+        }
+    }
+
+    const uint64_t descriptorRelative =
+        manifest.descriptorVirtualAddress - mappedBase;
+    const uint64_t codeRelative = manifest.codeVirtualAddress - mappedBase;
+    if (descriptorRelative > mappedBytes || codeRelative > mappedBytes ||
+        allocation.value0 > std::numeric_limits<Addr>::max() -
+            descriptorRelative ||
+        allocation.value0 > std::numeric_limits<Addr>::max() - codeRelative) {
+        rollback(lease, allocation);
+        fail(Failure::RangeOverflow);
+        return std::nullopt;
+    }
+    result.descriptorGpuVa = allocation.value0 + descriptorRelative;
+    result.codeGpuVa = allocation.value0 + codeRelative;
+    uint64_t entryVirtual = 0;
+    if (!signedRelation(result.descriptorGpuVa,
+                        manifest.kernelCodeEntryByteOffset, result.codeGpuVa,
+                        entryVirtual)) {
+        rollback(lease, allocation);
+        fail(Failure::InvalidSegment);
+        return std::nullopt;
+    }
+    result.entryGpuVa = entryVirtual;
+    return result;
+}
+
+bool
+HostNativeCodeObjectMapper::unmap(const Mapping &mapping)
+{
+    if (!mapping.valid()) {
+        fail(Failure::PageMap);
+        return false;
+    }
+    if (mapping.lease.allocationId != mapping.allocation.allocationId ||
+        mapping.lease.generation != mapping.allocation.generation ||
+        memory.functionalPageLeaseCount(
+            owner, mapping.allocation.allocationId,
+            mapping.allocation.generation) != 1 ||
+        memory.pinnedDispatchAllocationBusy(
+            owner, mapping.allocation.allocationId,
+            mapping.allocation.generation)) {
+        fail(Failure::Busy);
+        return false;
+    }
+    if (!context.unmap(mapping.lease)) {
+        fail(Failure::PageMap);
+        return false;
+    }
+    protocol::MemoryRequest freeRequest;
+    freeRequest.opcode = protocol::MemoryOpcode::Free;
+    freeRequest.allocationId = mapping.allocation.allocationId;
+    freeRequest.generation = mapping.allocation.generation;
+    const auto response = memory.free(owner, freeRequest, 0);
+    if (response.status != protocol::Status::Ok) {
+        fail(Failure::Allocation);
+        return false;
+    }
+    lastFailure = Failure::None;
+    return true;
+}
+
+} // namespace hostgpu
+} // namespace gem5

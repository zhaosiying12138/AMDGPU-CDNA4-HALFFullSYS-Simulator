+#ifndef __DEV_AMDGPU_HOST_NATIVE_CODE_OBJECT_MAPPER_HH__
+#define __DEV_AMDGPU_HOST_NATIVE_CODE_OBJECT_MAPPER_HH__
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "base/types.hh"
+#include "dev/amdgpu/host_gpu_memory_state.hh"
+#include "dev/amdgpu/host_gpu_protocol.hh"
+#include "dev/amdgpu/host_native_memory_context.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Functional PT_LOAD materializer for the host-native control core.
+ *
+ * This adapter deliberately stops at bytes in HostGPUMemoryState.  It does
+ * not apply relocations, create an AQL packet, publish a queue object, or
+ * invoke a GPU dispatcher.  A successful Mapping owns one allocation and one
+ * page lease; callers must release it with unmap().
+ */
+class HostNativeCodeObjectMapper
+{
+  public:
+    enum class Failure
+    {
+        None,
+        InvalidPageSize,
+        MalformedManifest,
+        UnsupportedVersion,
+        TopologyMismatch,
+        ImageMismatch,
+        InvalidImage,
+        InvalidSegment,
+        RangeOverflow,
+        Busy,
+        Allocation,
+        PageMap,
+        Copy,
+    };
+
+    struct SegmentMapping
+    {
+        protocol::CodeObjectSegment segment;
+        Addr mappedAddress = 0;
+    };
+
+    struct Mapping
+    {
+        HostGPUMemoryState::AllocationView allocation;
+        HostNativeMemoryContext::PageLease lease;
+        /* Page-aligned bounds of the union of all PT_LOAD memory ranges. */
+        uint64_t imageVirtualBase = 0;
+        uint64_t imageVirtualEnd = 0;
+        uint64_t mappedBytes = 0;
+        Addr descriptorGpuVa = 0;
+        Addr codeGpuVa = 0;
+        Addr entryGpuVa = 0;
+        uint32_t segmentCount = 0;
+        std::array<SegmentMapping, protocol::CodeObjectMaximumSegments>
+            segments = {};
+
+        bool valid() const
+        {
+            return allocation.allocationId != 0 && lease.valid() &&
+                mappedBytes != 0 && segmentCount != 0;
+        }
+    };
+
+    HostNativeCodeObjectMapper(
+        HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+        const HostGPUMemoryState::Owner &owner);
+
+    HostNativeCodeObjectMapper(const HostNativeCodeObjectMapper &) = delete;
+    HostNativeCodeObjectMapper &operator=(
+        const HostNativeCodeObjectMapper &) = delete;
+
+    std::optional<Mapping> map(
+        const std::vector<uint8_t> &image,
+        const protocol::CodeObjectManifest &manifest);
+    bool unmap(const Mapping &mapping);
+
+    Failure failure() const { return lastFailure; }
+    static const char *failureName(Failure failure);
+
+  private:

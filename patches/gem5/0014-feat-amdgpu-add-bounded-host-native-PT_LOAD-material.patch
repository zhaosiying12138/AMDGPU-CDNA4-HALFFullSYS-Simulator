+
+bool
+sameManifest(const protocol::CodeObjectManifest &left,
+             const protocol::CodeObjectManifest &right)
+{
+    if (left.imageSize != right.imageSize ||
+        left.chunkDataBytes != right.chunkDataBytes ||
+        left.chunkCount != right.chunkCount ||
+        left.segmentCount != right.segmentCount ||
+        left.kernelIndex != right.kernelIndex ||
+        left.imageSha256 != right.imageSha256 ||
+        left.elfMachine != right.elfMachine || left.elfType != right.elfType ||
+        left.elfOsabi != right.elfOsabi ||
+        left.elfAbiVersion != right.elfAbiVersion ||
+        left.elfReserved != right.elfReserved ||
+        left.elfFlags != right.elfFlags || left.gfxTarget != right.gfxTarget ||
+        left.codeObjectVersion != right.codeObjectVersion ||
+        left.metadataMajor != right.metadataMajor ||
+        left.metadataMinor != right.metadataMinor ||
+        left.relocationCount != right.relocationCount ||
+        left.kernargSegmentSize != right.kernargSegmentSize ||
+        left.kernargSegmentAlign != right.kernargSegmentAlign ||
+        left.groupSegmentFixedSize != right.groupSegmentFixedSize ||
+        left.privateSegmentFixedSize != right.privateSegmentFixedSize ||
+        left.maxFlatWorkgroupSize != right.maxFlatWorkgroupSize ||
+        left.wavefrontSize != right.wavefrontSize ||
+        left.sgprCount != right.sgprCount ||
+        left.vgprCount != right.vgprCount ||
+        left.usesDynamicStack != right.usesDynamicStack ||
+        left.descriptorSize != right.descriptorSize ||
+        left.kernelCodeEntryByteOffset != right.kernelCodeEntryByteOffset ||
+        left.codeVirtualAddress != right.codeVirtualAddress ||
+        left.codeFileOffset != right.codeFileOffset ||
+        left.codeSize != right.codeSize ||
+        left.descriptorVirtualAddress != right.descriptorVirtualAddress ||
+        left.descriptorFileOffset != right.descriptorFileOffset ||
+        left.kernelName != right.kernelName ||
+        left.descriptorSymbol != right.descriptorSymbol ||
+        left.descriptor != right.descriptor) {
+        return false;
+    }
+    for (size_t index = 0; index < protocol::CodeObjectMaximumSegments;
+         ++index) {
+        const auto &a = left.segments[index];
+        const auto &b = right.segments[index];
+        if (a.type != b.type || a.flags != b.flags ||
+            a.fileOffset != b.fileOffset ||
+            a.virtualAddress != b.virtualAddress || a.fileSize != b.fileSize ||
+            a.memorySize != b.memorySize || a.alignment != b.alignment) {
+            return false;
+        }
+    }
+    return true;
+}
+
+StagedFixture
+stageFixture(const std::vector<uint8_t> &image,
+             const protocol::CodeObjectManifest &manifest)
+{
+    HostGPUCodeObjectState state;
+    const HostGPUCodeObjectState::Owner owner{37, 1};
+    protocol::CodeObjectRequest begin;
+    begin.opcode = protocol::CodeObjectOpcode::Begin;
+    begin.manifest = manifest;
+    const auto beginResult = state.submit(owner, begin, 1);
+    require(beginResult.accepted && beginResult.response.status ==
+                protocol::Status::Ok,
+            "code-object begin");
+
+    uint64_t offset = 0;
+    for (uint32_t index = 0; index < manifest.chunkCount; ++index) {
+        protocol::CodeObjectRequest chunk;
+        chunk.opcode = protocol::CodeObjectOpcode::Chunk;
+        chunk.objectId = beginResult.response.objectId;
+        chunk.generation = beginResult.response.generation;
+        chunk.imageOffset = offset;
+        chunk.chunkIndex = index;
+        const uint32_t count = static_cast<uint32_t>(std::min<uint64_t>(
+            manifest.imageSize - offset, protocol::CodeObjectChunkDataBytes));
+        chunk.byteCount = count;
+        std::copy_n(image.begin() + static_cast<size_t>(offset), count,
+                    chunk.chunkData.begin());
+        chunk.chunkCrc32c = protocol::crc32c(chunk.chunkData.data(), count);
+        const auto chunkResult = state.submit(owner, chunk, 2 + index);
+        require(chunkResult.accepted && chunkResult.response.status ==
+                    protocol::Status::Ok,
+                "code-object chunk");
+        offset += count;
+    }
+
+    protocol::CodeObjectRequest commit;
+    commit.opcode = protocol::CodeObjectOpcode::Commit;
+    commit.objectId = beginResult.response.objectId;
+    commit.generation = beginResult.response.generation;
+    commit.byteCount = manifest.imageSize;
+    commit.chunkIndex = manifest.chunkCount;
+    commit.commitSha256 = manifest.imageSha256;
+    const auto commitResult = state.submit(owner, commit, 4);
+    require(commitResult.committed && commitResult.response.status ==
+                protocol::Status::Ok,
+            "code-object commit");
+
+    StagedFixture staged;
+    require(state.readCommittedImage(
+                owner, beginResult.response.objectId,
+                beginResult.response.generation, staged.image) &&
+                staged.image == image,
+            "code-object committed image");
+    const auto committedManifest = state.committedManifest(
+        owner, beginResult.response.objectId, beginResult.response.generation);
+    require(committedManifest && sameManifest(*committedManifest, manifest),
+            "code-object committed manifest");
+    staged.manifest = *committedManifest;
+    return staged;
+}
+
+Counts
+counts(const HostGPUMemoryState &memory,
+       const HostNativeMemoryContext &context)
+{
+    return {memory.allocationCount(), memory.totalBytes(),
+            memory.committedChunkCount(), context.leaseCount()};
+}
+
+bool
+sameCounts(const Counts &left, const Counts &right)
+{
+    return left.allocations == right.allocations &&
+        left.bytes == right.bytes && left.chunks == right.chunks &&
+        left.leases == right.leases;
+}
+
+bool
+sameSegment(const protocol::CodeObjectSegment &left,
+            const protocol::CodeObjectSegment &right)
+{
+    return left.type == right.type && left.flags == right.flags &&
+        left.fileOffset == right.fileOffset &&
+        left.virtualAddress == right.virtualAddress &&
+        left.fileSize == right.fileSize &&
+        left.memorySize == right.memorySize &&
+        left.alignment == right.alignment;
+}
+
+bool
+readEquals(HostNativeMemoryContext &context, gem5::Addr address,
+           const std::vector<uint8_t> &expected)
+{
+    std::vector<uint8_t> observed;
+    return context.functionalRead(address, expected.size(), observed) &&
+        observed == expected;
+}
+
+bool
+readZero(HostNativeMemoryContext &context, gem5::Addr address, uint64_t bytes)
+{
+    if (bytes == 0)
+        return true;
+    std::vector<uint8_t> observed;
+    return context.functionalRead(address, bytes, observed) &&
+        std::all_of(observed.begin(), observed.end(),
+                    [](uint8_t byte) { return byte == 0; });
+}
+
+bool
+rejectsAtomically(HostNativeCodeObjectMapper &mapper,
+                  const std::vector<uint8_t> &image,
+                  const protocol::CodeObjectManifest &manifest,
+                  const Counts &before, const HostGPUMemoryState &memory,
+                  const HostNativeMemoryContext &context)
+{
+    const auto rejected = mapper.map(image, manifest);
+    return !rejected && sameCounts(before, counts(memory, context));
+}
+
+void
+runSelfTest(const std::vector<uint8_t> &image)
+{
+    const auto sourceManifest = fixtureManifest(image);
+    require(HostGPUCodeObjectState::imageSha256(image) ==
+                sourceManifest.imageSha256,
+            "fixture SHA-256");
+    const auto staged = stageFixture(image, sourceManifest);
+    const auto &stagedImage = staged.image;
+    const auto &manifest = staged.manifest;
+    require(protocol::validateCodeObjectManifest(manifest) ==
+                protocol::CodeObjectManifestValidation::Valid,
+            "fixture manifest");
+
+    HostGPUMemoryState memory;
+    const HostGPUMemoryState::Owner owner{37, 1};
+    HostNativeMemoryContext context(memory, owner);
+    HostNativeMemoryContext competingContext(memory, owner);
+    HostNativeCodeObjectMapper mapper(memory, context, owner);
+    const Counts empty = counts(memory, context);
+
+    const auto mapped = mapper.map(stagedImage, manifest);
+    require(mapped && mapped->valid(), "PT_LOAD map");
+    const auto &mapping = *mapped;
+    require(mapping.imageVirtualBase == 0 &&
+                mapping.imageVirtualEnd == 0x3000 &&
+                mapping.mappedBytes == 0x3000 &&
+                mapping.lease.pageCount == 3,
+            "PT_LOAD union pages");
+
+    const std::array<protocol::CodeObjectSegment, 3> expected = {{
+        {1, 4, 0, 0, 0x840, 0x840, 0x1000},
+        {1, 5, 0x900, 0x1900, 0x480, 0x480, 0x1000},
+        {1, 6, 0xd80, 0x2d80, 0x70, 0x280, 0x1000},
+    }};
+    for (size_t index = 0; index < expected.size(); ++index) {
+        require(sameSegment(mapping.segments[index].segment, expected[index]),
+                "exact PT_LOAD tuple");
+        require(mapping.segments[index].mappedAddress ==
+                    mapping.allocation.gpuVa +
+                        expected[index].virtualAddress -
+                        mapping.imageVirtualBase,
+                "PT_LOAD mapped address");
+        const std::vector<uint8_t> bytes(
+            stagedImage.begin() + expected[index].fileOffset,
+            stagedImage.begin() + expected[index].fileOffset +
+                expected[index].fileSize);
+        require(readEquals(context, mapping.segments[index].mappedAddress,
+                           bytes),
+                "PT_LOAD file bytes");
+        require(readZero(
+                    context,
+                    mapping.segments[index].mappedAddress +
+                        expected[index].fileSize,
+                    expected[index].memorySize - expected[index].fileSize),
+                "PT_LOAD zero fill");
+    }
+    require(mapping.descriptorGpuVa == mapping.allocation.gpuVa + 0x800 &&
+                mapping.codeGpuVa == mapping.allocation.gpuVa + 0x1900 &&
+                mapping.entryGpuVa == mapping.codeGpuVa &&
+                mapping.descriptorGpuVa + 0x1100 == mapping.entryGpuVa,
+            "descriptor entry relation");
+
+    const Counts mappedCounts = counts(memory, context);
+    require(mappedCounts.allocations == empty.allocations + 1 &&
+                mappedCounts.leases == empty.leases + 1,
+            "mapping lifetime count");
+
+    auto wrongLease = mapping.lease;
+    ++wrongLease.token;
+    require(!context.unmap(wrongLease) && context.leaseCount() == 1,
+            "wrong lease rejection");
+    const auto competingLease = context.map(mapping.allocation.gpuVa, 1);
+    require(competingLease && !mapper.unmap(mapping) &&
+                mapper.failure() == HostNativeCodeObjectMapper::Failure::Busy &&
+                memory.allocationCount() == 1 && context.leaseCount() == 2,
+            "busy unmap retains mapping");
+    require(context.unmap(*competingLease) && context.leaseCount() == 1,
+            "busy unmap retry preparation");
+    protocol::MemoryRequest tokenProbeRequest;
+    tokenProbeRequest.opcode = protocol::MemoryOpcode::Allocate;
+    tokenProbeRequest.byteCount = 4096;
+    tokenProbeRequest.argument = 4096;
+    const auto tokenProbe = memory.allocate(owner, tokenProbeRequest, 2);
+    require(tokenProbe.status == protocol::Status::Ok,
+            "cross-context token probe allocation");
+    const auto tokenProbeLease = competingContext.map(tokenProbe.value0, 1);
+    require(tokenProbeLease && competingContext.unmap(*tokenProbeLease),
+            "cross-context token probe lease");
+    protocol::MemoryRequest tokenProbeFree;
+    tokenProbeFree.opcode = protocol::MemoryOpcode::Free;
+    tokenProbeFree.allocationId = tokenProbe.allocationId;
+    tokenProbeFree.generation = tokenProbe.generation;
+    require(memory.free(owner, tokenProbeFree, 2).status ==
+                protocol::Status::Ok,
+            "cross-context token probe free");
+    const auto competingContextLease = competingContext.map(
+        mapping.allocation.gpuVa + 0x100, 1);
+    require(static_cast<bool>(competingContextLease),
+            "cross-context lease map");
+    require(memory.functionalPageLeaseCount(
+                owner, mapping.allocation.allocationId,
+                mapping.allocation.generation) == 2,
+            "cross-context global lease count");
+    require(!mapper.unmap(mapping) &&
+                mapper.failure() == HostNativeCodeObjectMapper::Failure::Busy,
+            "cross-context busy unmap");
+    require(context.leaseCount() == 1 && competingContext.leaseCount() == 1,
+            "cross-context lease retention");
+    require(competingContext.unmap(*competingContextLease),
+            "cross-context lease release");
+    require(memory.pinPinnedDispatchAllocation(
+                owner, mapping.allocation.allocationId,
+                mapping.allocation.generation, 99) &&
+                !mapper.unmap(mapping) &&
+                mapper.failure() == HostNativeCodeObjectMapper::Failure::Busy &&
+                context.leaseCount() == 1 &&
+                memory.releasePinnedDispatchAllocation(
+                    owner, mapping.allocation.allocationId,
+                    mapping.allocation.generation, 99),
+            "pinned unmap retains mapping");
+    protocol::MemoryRequest freeRequest;
+    freeRequest.opcode = protocol::MemoryOpcode::Free;
+    freeRequest.allocationId = mapping.allocation.allocationId;
+    freeRequest.generation = mapping.allocation.generation;
+    require(memory.free(owner, freeRequest, 1).status ==
+                protocol::Status::Busy,
+            "mapped allocation busy");
+
+    auto relocation = manifest;
+    relocation.relocationCount = 1;
+    require(rejectsAtomically(mapper, stagedImage, relocation, mappedCounts,
+                              memory,
+                              context),
+            "nonzero relocation rejection");
+    auto overlap = manifest;
+    overlap.segments[2].virtualAddress = 0x1900;
+    require(rejectsAtomically(
+                mapper, stagedImage, overlap, mappedCounts, memory, context),
+            "overlap rejection");
+    auto overflow = manifest;
+    overflow.segments[2].virtualAddress =
+        std::numeric_limits<uint64_t>::max() - 0x100;
+    overflow.segments[2].memorySize = 0x200;
+    require(rejectsAtomically(mapper, stagedImage, overflow, mappedCounts,
+                              memory,
+                              context),
+            "overflow rejection");
+    auto unsupportedTarget = manifest;
+    unsupportedTarget.gfxTarget = 949;
+    require(rejectsAtomically(mapper, stagedImage, unsupportedTarget,
+                              mappedCounts,
+                              memory, context),
+            "unsupported target rejection");
+    auto unsupportedVersion = manifest;
+    unsupportedVersion.codeObjectVersion = 7;
+    require(rejectsAtomically(mapper, stagedImage, unsupportedVersion,
+                              mappedCounts,
+                              memory, context),
+            "unsupported version rejection");
+
+    memory.disconnect(owner);
+    require(memory.allocationCount() == 1 && context.leaseCount() == 1,
+            "disconnect retains leased allocation");
+    require(mapper.unmap(mapping), "PT_LOAD unmap");
+    require(sameCounts(empty, counts(memory, context)),
+            "PT_LOAD release lifetime");
+}
+
+} // anonymous namespace
+
+int
+main(int argc, char **argv)
+{
+    try {
+        const auto image = readFixture(argc, argv);
+        runSelfTest(image);
+        std::cout
+            << "{\"schema\":\"gem5.host-native.ptload.v1\","
+               "\"ptload_mapping\":true,"
+               "\"fixture_oracle\":true,"
+               "\"staged_image_roundtrip\":true,"
+               "\"exact_ptload_tuples\":true,"
+               "\"descriptor_entry_relation\":true,"
+               "\"filesz_copy\":true,"
+               "\"memsz_zero_fill\":true,"
+               "\"atomic_rejections\":true,"
+               "\"preallocation_atomic_rejections\":true,"
+               "\"nonzero_relocation_rejected\":true,"
+               "\"overlap_rejected\":true,"
+               "\"overflow_rejected\":true,"
+               "\"unsupported_target_rejected\":true,"
+               "\"unsupported_version_rejected\":true,"
+               "\"functional_page_lifetime\":true,"
+               "\"no_aql\":true,"
+               "\"aql_submitted\":false,"
+               "\"kernel_executed\":false,"
+               "\"cpu_fallback\":false,"
+               "\"vega_x86\":false,"
+               "\"gpu_pipeline_connected\":false,"
+               "\"blocker\":\"fixture-scoped image-relative PT_LOAD staging; "
+               "pre-allocation malformed/unsupported rejection only; no "
+               "permissions, relocations, kernarg, AQL, or execution\"}\n";
+    } catch (const std::exception &error) {
+        std::cerr << "host-native PT_LOAD self-test failed: " << error.what()
+                  << '\n';
+        return 1;
+    }
+    return 0;
+}

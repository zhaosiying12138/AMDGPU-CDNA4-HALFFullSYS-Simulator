+    EXPECT_EQ(state.submit(owner(), header(4), destroy(created.response), 10)
+                  .response.status,
+              protocol::Status::Busy);
+    ASSERT_TRUE(state.popReady(11));
+    EXPECT_EQ(state.submit(owner(), header(5),
+                           doorbell(created.response, 2), 11)
+                  .response.status,
+              protocol::Status::Ok);
+    EXPECT_EQ(state.submit(owner(), header(6),
+                           doorbell(created.response, 2), 11)

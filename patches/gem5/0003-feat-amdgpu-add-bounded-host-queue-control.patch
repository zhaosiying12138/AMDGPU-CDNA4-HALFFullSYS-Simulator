+#ifndef __DEV_AMDGPU_HOST_GPU_QUEUE_STATE_HH__
+#define __DEV_AMDGPU_HOST_GPU_QUEUE_STATE_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <unordered_map>
+
+#include "dev/amdgpu/host_gpu_protocol.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Bounded, control-only queue bookkeeping for HostGPUBridge.
+ *
+ * This object never accepts pointers, packets, or GPU work. A doorbell only
+ * creates a deterministic control completion due one simulation tick later.
+ */
+class HostGPUQueueState
+{
+  public:
+    static constexpr size_t MaximumQueues = 8;
+    static constexpr size_t MaximumInflight = 8;
+    static constexpr uint64_t CompletionDelay = 1;
+
+    struct Owner
+    {
+        int fd = -1;
+        uint64_t clientGeneration = 0;
+
+        bool operator==(const Owner &other) const
+        {
+            return fd == other.fd &&
+                   clientGeneration == other.clientGeneration;
+        }
+    };
+
+    struct Command
+    {
+        Owner owner;
+        protocol::Header header;
+        uint64_t queueId = 0;
+        uint64_t queueGeneration = 0;
+        uint64_t sequence = 0;
+        uint64_t kind = 0;
+        uint64_t readyTick = 0;
+    };
+
+    struct Decision
+    {
+        protocol::QueueResponse response;
+        bool commandAccepted = false;
+    };
+
+    Decision submit(const Owner &owner, const protocol::Header &header,
+                    const protocol::QueueRequest &request, uint64_t now);
+    static bool isNextSequence(uint64_t previous, uint64_t candidate);
+    static protocol::QueueResponse completionResponse(
+        const Command &command, uint64_t now);
+    bool callbackPending(const Command &command) const;
+    std::optional<Command> popReady(uint64_t now);
+    std::optional<uint64_t> nextReadyTick() const;
+    void disconnect(const Owner &owner);
+    void clear();
+
+    size_t queueCount() const { return queues.size(); }
+    size_t inflightCount() const { return commands.size(); }
+
+  private:
+    struct Queue
+    {
+        Owner owner;
+        uint64_t generation = 0;
+        uint64_t depth = 0;
+        uint64_t lastSequence = 0;
+        std::unordered_map<uint64_t, uint64_t> requestIdBySequence;
+    };
+
+    uint64_t allocateQueueId();
+    uint64_t allocateQueueGeneration();
+    static protocol::QueueResponse echo(
+        const protocol::QueueRequest &request, uint64_t now);
+
+    std::unordered_map<uint64_t, Queue> queues;
+    std::deque<Command> commands;
+    uint64_t nextQueueId = 1;
+    uint64_t nextQueueGeneration = 1;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_QUEUE_STATE_HH__

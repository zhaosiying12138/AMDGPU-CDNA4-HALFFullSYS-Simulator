+
+HostGPUQueueState::Owner
+owner(int fd = 7, uint64_t generation = 11)
+{
+    return {fd, generation};
+}
+
+protocol::Header
+header(uint64_t requestId = 1)
+{
+    protocol::Header value;
+    value.requestId = requestId;
+    value.connectionId = 17;
+    value.jobEpoch = 19;
+    value.daemonUuid[0] = 1;
+    return value;
+}
+
+protocol::QueueRequest
+create(uint64_t depth)
+{
+    protocol::QueueRequest request;
+    request.opcode = protocol::QueueOpcode::Create;
+    request.arg0 = depth;
+    return request;
+}
+
+protocol::QueueRequest
+doorbell(const protocol::QueueResponse &created, uint64_t sequence,
+         uint64_t kind = 0)
+{
+    protocol::QueueRequest request;
+    request.opcode = protocol::QueueOpcode::Doorbell;
+    request.queueId = created.queueId;
+    request.generation = created.generation;
+    request.sequence = sequence;
+    request.arg0 = kind;
+    return request;
+}
+
+protocol::QueueRequest
+destroy(const protocol::QueueResponse &created)
+{
+    protocol::QueueRequest request;
+    request.opcode = protocol::QueueOpcode::Destroy;
+    request.queueId = created.queueId;
+    request.generation = created.generation;
+    return request;
+}
+
+TEST(HostGPUQueueState, CreatesAndDestroysOwnedQueue)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(4), 20);
+    EXPECT_EQ(created.response.status, protocol::Status::Ok);
+    EXPECT_NE(created.response.queueId, 0U);
+    EXPECT_NE(created.response.generation, 0U);
+    EXPECT_EQ(created.response.sequence, 0U);
+    EXPECT_EQ(created.response.value, 4U);
+    EXPECT_EQ(created.response.simTick, 20U);
+    EXPECT_EQ(state.queueCount(), 1U);
+
+    const auto removed = state.submit(
+        owner(), header(2), destroy(created.response), 21);
+    EXPECT_EQ(removed.response.status, protocol::Status::Ok);
+    EXPECT_EQ(removed.response.queueId, created.response.queueId);
+    EXPECT_EQ(removed.response.generation, created.response.generation);
+    EXPECT_EQ(removed.response.value, 0U);
+    EXPECT_EQ(state.queueCount(), 0U);
+}
+
+TEST(HostGPUQueueState, EnforcesEightQueueLimit)
+{
+    HostGPUQueueState state;
+    for (size_t index = 0; index < HostGPUQueueState::MaximumQueues; ++index) {
+        EXPECT_EQ(state.submit(owner(), header(index + 1), create(1), index)
+                      .response.status,
+                  protocol::Status::Ok);
+    }
+    const auto rejected = state.submit(owner(), header(9), create(1), 8);
+    EXPECT_EQ(rejected.response.status,
+              protocol::Status::ResourceExhausted);
+    EXPECT_EQ(rejected.response.queueId, 0U);
+    EXPECT_EQ(rejected.response.generation, 0U);
+    EXPECT_EQ(rejected.response.value, 0U);
+    EXPECT_EQ(state.queueCount(), HostGPUQueueState::MaximumQueues);
+}
+
+TEST(HostGPUQueueState, DoorbellCompletesExactlyOneTickLater)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(2), 40);
+    const auto accepted = state.submit(
+        owner(), header(2), doorbell(created.response, 1, 1), 50);
+    EXPECT_EQ(accepted.response.status, protocol::Status::Ok);
+    EXPECT_TRUE(accepted.commandAccepted);
+    EXPECT_EQ(accepted.response.value, 0U);
+    ASSERT_TRUE(state.nextReadyTick());
+    EXPECT_EQ(*state.nextReadyTick(), 51U);
+    EXPECT_FALSE(state.popReady(50));
+
+    const auto command = state.popReady(51);
+    ASSERT_TRUE(command);
+    EXPECT_EQ(command->owner.fd, owner().fd);
+    EXPECT_EQ(command->owner.clientGeneration, owner().clientGeneration);
+    EXPECT_EQ(command->header.requestId, 2U);
+    EXPECT_EQ(command->queueId, created.response.queueId);
+    EXPECT_EQ(command->queueGeneration, created.response.generation);
+    EXPECT_EQ(command->sequence, 1U);
+    EXPECT_EQ(command->kind, 1U);
+    EXPECT_EQ(command->readyTick, 51U);
+    EXPECT_FALSE(state.nextReadyTick());
+}

+    EXPECT_EQ(tracker.observe(6), RequestIdResult::NotIncreasing);
+    EXPECT_EQ(tracker.last(), 7U);
+    EXPECT_EQ(tracker.observe(8), RequestIdResult::Fresh);
+    EXPECT_EQ(tracker.last(), 8U);

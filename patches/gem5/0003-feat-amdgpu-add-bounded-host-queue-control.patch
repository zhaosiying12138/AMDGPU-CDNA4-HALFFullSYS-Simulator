+TEST(HostGPUConnectionState, QueueMalformedPrecedesSessionErrors)
+{
+    EXPECT_EQ(queueRequestStatus(protocol::Status::Malformed,
+                                 protocol::Status::ProtocolState),
+              protocol::Status::Malformed);
+    EXPECT_EQ(queueRequestStatus(protocol::Status::Malformed,
+                                 protocol::Status::InstanceMismatch),
+              protocol::Status::Malformed);
+    EXPECT_EQ(queueRequestStatus(protocol::Status::UnsupportedVersion,
+                                 protocol::Status::ProtocolState),
+              protocol::Status::UnsupportedVersion);
+    EXPECT_EQ(queueRequestStatus(protocol::Status::UnsupportedVersion,
+                                 protocol::Status::InstanceMismatch),
+              protocol::Status::UnsupportedVersion);
+    EXPECT_EQ(queueRequestStatus(protocol::Status::UnsupportedVersion,
+                                 protocol::Status::Ok),
+              protocol::Status::UnsupportedVersion);
+
+    QueueRequestIdTracker tracker;
+    ASSERT_EQ(tracker.observe(7), RequestIdResult::Fresh);
+    const auto malformed = queueRequestStatus(
+        protocol::Status::Malformed, protocol::Status::ProtocolState);
+    ASSERT_NE(malformed, protocol::Status::Ok);
+    EXPECT_EQ(tracker.last(), 7U);

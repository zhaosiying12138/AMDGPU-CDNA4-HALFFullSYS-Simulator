+TEST(HostGPUConnectionState, EstablishedRecordCompletesWithoutPhaseChange)
+{
+    HostGPUConnectionState state;
+    state.noteRecordReceived();
+    state.beginAck(true);
+    state.noteAckSent();
+    ASSERT_EQ(state.phase(), ConnectionPhase::Established);
+    state.noteRecordReceived();
+    EXPECT_TRUE(state.recordPending());
+    EXPECT_FALSE(state.canReceive());
+    state.finishEstablishedRecord();
+    EXPECT_EQ(state.phase(), ConnectionPhase::Established);
+    EXPECT_TRUE(state.committed());
+    EXPECT_FALSE(state.recordPending());
+    EXPECT_TRUE(state.canReceive());
+}

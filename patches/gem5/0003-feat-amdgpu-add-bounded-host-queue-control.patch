+TEST(HostGPUQueueState, CallbackCorrelationRejectsTamperedRequestIdentity)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(1), 0);
+    ASSERT_EQ(state.submit(owner(), header(2),
+                           doorbell(created.response, 1, 1), 70)
+                  .response.status,
+              protocol::Status::Ok);
+
+    HostGPUQueueState::Command callback{
+        owner(), header(2), created.response.queueId,
+        created.response.generation, 1, 1, 71};
+    EXPECT_TRUE(state.callbackPending(callback));
+
+    auto tampered = callback;
+    tampered.header.requestId = 3;
+    EXPECT_FALSE(state.callbackPending(tampered));
+    tampered = callback;
+    ++tampered.owner.clientGeneration;
+    EXPECT_FALSE(state.callbackPending(tampered));
+    tampered = callback;
+    ++tampered.queueGeneration;
+    EXPECT_FALSE(state.callbackPending(tampered));
+    tampered = callback;
+    ++tampered.sequence;
+    EXPECT_FALSE(state.callbackPending(tampered));
+
+    const auto completed = state.popReady(71);
+    ASSERT_TRUE(completed);
+    EXPECT_EQ(completed->header.requestId, 2U);
+    EXPECT_FALSE(state.callbackPending(callback));
+}

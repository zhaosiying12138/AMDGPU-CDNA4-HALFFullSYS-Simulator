+
+void
+HostGPUBridge::completeOutbound(int fd, uint64_t generation,
+                                const OutboundRecord &record)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
         return;
+    switch (record.kind) {
+      case OutboundKind::HandshakeAck:
+        completeAck(fd, generation, record.status, record.success);
+        break;
+      case OutboundKind::QueueAck:
+        if (found->second->state.phase() == ConnectionPhase::Established &&
+            found->second->state.canReceive()) {
+            found->second->socketEvent->setReadable(true);
+        }
+        break;
+      case OutboundKind::QueueCompletion:
+        break;
     }

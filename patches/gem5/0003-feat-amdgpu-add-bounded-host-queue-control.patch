+
+namespace gem5
+{
+namespace hostgpu
+{
+
+protocol::QueueResponse
+HostGPUQueueState::echo(const protocol::QueueRequest &request, uint64_t now)
+{
+    protocol::QueueResponse response;
+    response.opcode = request.opcode;
+    response.queueId = request.queueId;
+    response.generation = request.generation;
+    response.sequence = request.sequence;
+    response.simTick = now;
+    return response;
+}
+
+uint64_t
+HostGPUQueueState::allocateQueueId()
+{
+    for (size_t attempt = 0; attempt <= queues.size(); ++attempt) {
+        const uint64_t candidate = nextQueueId++;
+        if (nextQueueId == 0)
+            ++nextQueueId;
+        if (candidate != 0 && queues.find(candidate) == queues.end())
+            return candidate;
+    }
+    return 0;
+}
+
+uint64_t
+HostGPUQueueState::allocateQueueGeneration()
+{
+    const uint64_t generation = nextQueueGeneration++;
+    if (nextQueueGeneration == 0)
+        ++nextQueueGeneration;
+    return generation;
+}
+
+HostGPUQueueState::Decision
+HostGPUQueueState::submit(const Owner &owner, const protocol::Header &header,
+                          const protocol::QueueRequest &request, uint64_t now)
+{
+    Decision decision;
+    decision.response = echo(request, now);
+
+    switch (request.opcode) {
+      case protocol::QueueOpcode::Create: {
+        if (queues.size() >= MaximumQueues) {
+            decision.response.status = protocol::Status::ResourceExhausted;
+            return decision;
+        }
+        const uint64_t queueId = allocateQueueId();
+        const uint64_t generation = allocateQueueGeneration();
+        if (queueId == 0 || generation == 0) {
+            decision.response.status = protocol::Status::Internal;
+            return decision;
+        }
+        queues.emplace(queueId, Queue{
+            owner, generation, request.arg0, 0, {}});
+        decision.response.status = protocol::Status::Ok;
+        decision.response.queueId = queueId;
+        decision.response.generation = generation;
+        decision.response.value = request.arg0;
+        return decision;
+      }
+      case protocol::QueueOpcode::Destroy: {
+        const auto found = queues.find(request.queueId);
+        if (found == queues.end() || !(found->second.owner == owner) ||
+            found->second.generation != request.generation) {
+            decision.response.status = protocol::Status::ProtocolState;
+            return decision;
+        }
+        if (!found->second.requestIdBySequence.empty()) {
+            decision.response.status = protocol::Status::Busy;
+            return decision;
+        }
+        queues.erase(found);
+        decision.response.status = protocol::Status::Ok;
+        return decision;
+      }
+      case protocol::QueueOpcode::Doorbell: {
+        const auto found = queues.find(request.queueId);
+        if (found == queues.end() || !(found->second.owner == owner) ||
+            found->second.generation != request.generation ||
+            !isNextSequence(found->second.lastSequence, request.sequence)) {
+            decision.response.status = protocol::Status::ProtocolState;
+            return decision;
+        }
+        if (request.arg0 > static_cast<uint64_t>(
+                protocol::QueueCommandKind::ControlErrorTest)) {
+            decision.response.status = protocol::Status::Malformed;
+            return decision;
+        }
+        if (commands.size() >= MaximumInflight ||
+            found->second.requestIdBySequence.size() >= found->second.depth) {
+            decision.response.status = protocol::Status::ResourceExhausted;
+            return decision;
+        }
+        if (now == std::numeric_limits<uint64_t>::max()) {
+            decision.response.status = protocol::Status::Internal;
+            return decision;
+        }
+        const auto inserted = found->second.requestIdBySequence.emplace(
+            request.sequence, header.requestId);
+        if (!inserted.second) {
+            decision.response.status = protocol::Status::Internal;
+            return decision;
+        }
+        found->second.lastSequence = request.sequence;
+        commands.push_back(Command{
+            owner, header, request.queueId, request.generation,
+            request.sequence, request.arg0, now + CompletionDelay});
+        decision.response.status = protocol::Status::Ok;
+        decision.commandAccepted = true;
+        return decision;
+      }
+    }
+
+    decision.response.status = protocol::Status::Malformed;
+    return decision;
+}
+
+bool
+HostGPUQueueState::isNextSequence(uint64_t previous, uint64_t candidate)
+{
+    return previous != std::numeric_limits<uint64_t>::max() &&
+           candidate == previous + 1;
+}
+
+protocol::QueueResponse
+HostGPUQueueState::completionResponse(const Command &command, uint64_t now)
+{
+    protocol::QueueResponse response;
+    const bool injectedError = command.kind == static_cast<uint64_t>(
+        protocol::QueueCommandKind::ControlErrorTest);
+    response.status = injectedError ? protocol::Status::Internal :
+        protocol::Status::Ok;
+    response.opcode = protocol::QueueOpcode::Doorbell;
+    response.queueId = command.queueId;
+    response.generation = command.queueGeneration;
+    response.sequence = command.sequence;
+    response.value = command.kind;
+    response.errorCode = injectedError ? 1 : 0;
+    response.simTick = now;
+    return response;
+}
+
+bool
+HostGPUQueueState::callbackPending(const Command &command) const
+{
+    const auto queue = queues.find(command.queueId);
+    if (queue == queues.end() || !(queue->second.owner == command.owner) ||
+        queue->second.generation != command.queueGeneration) {
+        return false;
+    }
+    const auto request = queue->second.requestIdBySequence.find(
+        command.sequence);
+    return request != queue->second.requestIdBySequence.end() &&
+        command.header.requestId != 0 &&
+        request->second == command.header.requestId;
+}
+
+std::optional<HostGPUQueueState::Command>
+HostGPUQueueState::popReady(uint64_t now)
+{
+    while (!commands.empty() && commands.front().readyTick <= now) {
+        Command command = std::move(commands.front());
+        commands.pop_front();
+        if (!callbackPending(command))
+            continue;
+        auto &queue = queues.at(command.queueId);
+        queue.requestIdBySequence.erase(command.sequence);
+        return command;
+    }
+    return std::nullopt;
+}
+
+std::optional<uint64_t>
+HostGPUQueueState::nextReadyTick() const
+{
+    if (commands.empty())
+        return std::nullopt;
+    return commands.front().readyTick;
+}
+
+void
+HostGPUQueueState::disconnect(const Owner &owner)
+{
+    commands.erase(std::remove_if(
+        commands.begin(), commands.end(),
+        [&owner](const Command &command) { return command.owner == owner; }),
+        commands.end());
+    for (auto iterator = queues.begin(); iterator != queues.end();) {
+        if (iterator->second.owner == owner)
+            iterator = queues.erase(iterator);
+        else
+            ++iterator;
+    }
+}
+
+void
+HostGPUQueueState::clear()
+{
+    commands.clear();
+    queues.clear();
+}

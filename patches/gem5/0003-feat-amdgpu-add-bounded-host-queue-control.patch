+TEST(HostGPUQueueState, DisconnectCancelsOwnedQueuesAndCommands)
+{
+    HostGPUQueueState state;
+    const auto firstOwner = owner(7, 1);
+    const auto secondOwner = owner(8, 2);
+    const auto first = state.submit(firstOwner, header(), create(2), 0);
+    const auto second = state.submit(secondOwner, header(2), create(2), 0);
+    ASSERT_EQ(state.submit(firstOwner, header(3),
+                           doorbell(first.response, 1), 3)
+                  .response.status,
+              protocol::Status::Ok);
+    ASSERT_EQ(state.submit(secondOwner, header(4),
+                           doorbell(second.response, 1), 3)
+                  .response.status,
+              protocol::Status::Ok);
+    state.disconnect(firstOwner);
+    EXPECT_EQ(state.queueCount(), 1U);
+    EXPECT_EQ(state.inflightCount(), 1U);
+    const auto remaining = state.popReady(4);
+    ASSERT_TRUE(remaining);
+    EXPECT_EQ(remaining->owner, secondOwner);
+}

+TEST(HostGPUQueueState, TickOverflowIsRejectedWithoutMutation)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(1), 0);
+    const auto rejected = state.submit(
+        owner(), header(2), doorbell(created.response, 1),
+        std::numeric_limits<uint64_t>::max());
+    EXPECT_EQ(rejected.response.status, protocol::Status::Internal);
+    EXPECT_FALSE(rejected.commandAccepted);
+    EXPECT_EQ(state.inflightCount(), 0U);
+}

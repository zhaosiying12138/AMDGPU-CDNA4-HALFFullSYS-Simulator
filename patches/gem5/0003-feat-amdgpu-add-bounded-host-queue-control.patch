+
+QueueDecodeResult
+decodeQueueRequestRecord(const uint8_t *record, size_t size,
+                         uint32_t configuredMaximum)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeQueueEnvelope(record, size, configuredMaximum, header, payload,
+                             reason))
+        return queueDrop(reason);
+    if (header.messageType != MessageType::QueueRequest)
+        return queueDrop("expected QUEUE_REQUEST");
+    if (size - HeaderBytes != QueuePayloadBytes)
+        return queueDrop("queue payload length");
+
+    QueueRequest request;
+    request.major = load16(payload);
+    request.minor = load16(payload + 2);
+    const uint16_t rawOpcode = load16(payload + 4);
+    request.opcode = static_cast<QueueOpcode>(rawOpcode);
+    request.flags = load16(payload + 6);
+    request.queueId = load64(payload + 8);
+    request.generation = load64(payload + 16);
+    request.sequence = load64(payload + 24);
+    request.arg0 = load64(payload + 32);
+    request.arg1 = load64(payload + 40);
+    const uint64_t reserved0 = load64(payload + 48);
+    const uint64_t reserved1 = load64(payload + 56);
+
+    if (!validQueueOpcode(rawOpcode) || request.flags != 0 ||
+        reserved0 != 0 || reserved1 != 0)
+        return queueAcknowledge(Status::Malformed,
+                                "invalid queue control fields", header,
+                                request);
+
+    switch (request.opcode) {
+      case QueueOpcode::Create:
+        if (request.queueId != 0 || request.generation != 0 ||
+            request.sequence != 0 || request.arg1 != 0 ||
+            request.arg0 == 0 || request.arg0 > 64) {
+            return queueAcknowledge(Status::Malformed,
+                                    "invalid queue create fields", header,
+                                    request);
+        }
+        break;
+      case QueueOpcode::Destroy:
+        if (request.queueId == 0 || request.generation == 0 ||
+            request.sequence != 0 || request.arg0 != 0 ||
+            request.arg1 != 0) {
+            return queueAcknowledge(Status::Malformed,
+                                    "invalid queue destroy fields", header,
+                                    request);
+        }
+        break;
+      case QueueOpcode::Doorbell:
+        if (request.queueId == 0 || request.generation == 0 ||
+            request.sequence == 0 ||
+            request.arg0 >
+                static_cast<uint64_t>(QueueCommandKind::ControlErrorTest) ||
+            request.arg1 != 0) {
+            return queueAcknowledge(Status::Malformed,
+                                    "invalid queue doorbell fields", header,
+                                    request);
+        }
+        break;
+    }
+    if (request.major != QueueControlMajor ||
+        request.minor != QueueControlMinor)
+        return queueAcknowledge(Status::UnsupportedVersion,
+                                "unsupported queue control version", header,
+                                request);
+    return queueAcknowledge(Status::Ok, "valid queue request", header,
+                            request);
+}

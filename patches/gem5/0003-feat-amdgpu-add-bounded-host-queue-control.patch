+TEST(HostGPUQueueState, ControlErrorCompletesAsInternalOneTickLater)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(1), 0);
+    const auto accepted = state.submit(
+        owner(), header(2), doorbell(created.response, 1, 2), 60);
+    ASSERT_EQ(accepted.response.status, protocol::Status::Ok);
+    EXPECT_EQ(accepted.response.value, 0U);
+    EXPECT_EQ(accepted.response.errorCode, 0U);
+    const auto command = state.popReady(61);
+    ASSERT_TRUE(command);
+    const auto completion =
+        HostGPUQueueState::completionResponse(*command, 61);
+    EXPECT_EQ(completion.status, protocol::Status::Internal);
+    EXPECT_EQ(completion.opcode, protocol::QueueOpcode::Doorbell);
+    EXPECT_EQ(completion.queueId, created.response.queueId);
+    EXPECT_EQ(completion.generation, created.response.generation);
+    EXPECT_EQ(completion.sequence, 1U);
+    EXPECT_EQ(completion.value, 2U);
+    EXPECT_EQ(completion.errorCode, 1U);
+    EXPECT_EQ(completion.simTick, 61U);
+}

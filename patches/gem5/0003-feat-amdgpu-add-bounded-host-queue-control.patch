+TEST(HostGPUQueueState, EnforcesGlobalInflightLimit)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(64), 0);
+    for (size_t index = 0; index < HostGPUQueueState::MaximumInflight;
+         ++index) {
+        EXPECT_EQ(state.submit(owner(), header(index + 2),
+                               doorbell(created.response, index + 1), 70)
+                      .response.status,
+                  protocol::Status::Ok);
+    }
+    EXPECT_EQ(state.inflightCount(), HostGPUQueueState::MaximumInflight);
+    EXPECT_EQ(state.submit(owner(), header(10),
+                           doorbell(created.response, 9), 70)
+                  .response.status,
+              protocol::Status::ResourceExhausted);
+    for (size_t index = 0; index < HostGPUQueueState::MaximumInflight;
+         ++index) {
+        ASSERT_TRUE(state.popReady(71));
+    }
+    EXPECT_EQ(state.inflightCount(), 0U);
+    EXPECT_EQ(state.submit(owner(), header(11),
+                           doorbell(created.response, 9), 71)
+                  .response.status,
+              protocol::Status::Ok);
+}

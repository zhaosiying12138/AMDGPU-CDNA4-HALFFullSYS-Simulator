+TEST(HostGPUQueueState, BackpressuredPeerCloseRequiresImmediateCleanup)
+{
+    int sockets[2] = {-1, -1};
+    ASSERT_EQ(::socketpair(AF_UNIX,
+                           SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC,
+                           0, sockets),
+              0);
+    std::array<uint8_t, 256> packet = {};
+    while (::send(sockets[0], packet.data(), packet.size(),
+                  MSG_NOSIGNAL) >= 0) {
+    }
+    ASSERT_TRUE(errno == EAGAIN || errno == EWOULDBLOCK);
+
+    HostGPUQueueState state;
+    const auto socketOwner = owner(sockets[0], 100);
+    const auto created = state.submit(socketOwner, header(), create(1), 0);
+    ASSERT_EQ(created.response.status, protocol::Status::Ok);
+    ASSERT_EQ(state.submit(socketOwner, header(2),
+                           doorbell(created.response, 1), 1)
+                  .response.status,
+              protocol::Status::Ok);
+    ASSERT_EQ(state.queueCount(), 1U);
+    ASSERT_EQ(state.inflightCount(), 1U);
+
+    ::close(sockets[1]);
+    sockets[1] = -1;
+    pollfd descriptor = {sockets[0], POLLIN | POLLOUT, 0};
+    ASSERT_GT(::poll(&descriptor, 1, 1000), 0);
+    ASSERT_TRUE(terminalClientPollEvent(descriptor.revents));
+
+    state.disconnect(socketOwner);
+    EXPECT_EQ(state.queueCount(), 0U);
+    EXPECT_EQ(state.inflightCount(), 0U);
+    ::close(sockets[0]);
+}

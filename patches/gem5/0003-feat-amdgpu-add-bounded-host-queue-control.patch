+void
+HostGPUBridge::processHelloRecord(const PendingRecord &record)
+{
+    auto found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &client = *found->second;
+    const auto decoded = protocol::decodeHelloRecord(
+        record.bytes.data(), record.bytes.size(), maximumRecord);
+    if (decoded.action == protocol::DecodeAction::Drop) {
+        if (decoded.closeConnection)
+            closeClient(record.clientFd);
+        return;
+    }
+
+    protocol::Status status = preNegotiationStatus(
+        client.state, sessionEstablished && activeClientFd < 0,
+        decoded.status);
+    protocol::NegotiationResult negotiation;
+    if (status == protocol::Status::Ok) {
+        protocol::NegotiationContext context;
+        context.busy = activeClientFd >= 0 &&
+            activeClientFd != record.clientFd;
+        context.resourceExhausted =
+            client.admission == ClientAdmission::ResourceLimited;
+        negotiation = protocol::negotiate(
+            decoded.header, decoded.hello, identity, context);
+        status = negotiation.status;
+    }
+
+    protocol::Ack ack;
+    ack.status = status;
+    ack.clientNonce = decoded.hello.clientNonce;
+    uint64_t connectionId = 0;
+    if (status == protocol::Status::Ok) {
+        protocol::Nonce serverNonce = {};
+        bool randomReady = randomNonzeroUuid(serverNonce);
+        for (unsigned attempt = 0; randomReady && attempt < 16; ++attempt) {
+            randomReady = randomNonzero64(connectionId);
+            if (!randomReady || usedConnectionIds.insert(connectionId).second)
+                break;
+            connectionId = 0;
+        }
+        if (connectionId == 0)
+            randomReady = false;
+        if (!randomReady) {
+            status = protocol::Status::Internal;
+            ack.status = status;
+        } else {
+            ack.selectedMajor = negotiation.selectedMajor;
+            ack.selectedMinor = negotiation.selectedMinor;
+            ack.serverNonce = serverNonce;
+            ack.selected = negotiation.selected;
+            ack.maximumRecord = negotiation.maximumRecord;
+            ack.topology.jobUuid = identity.jobUuid;
+            ack.topology.rank = identity.rank;
+            ack.topology.worldSize = identity.worldSize;
+            client.connectionId = connectionId;
+            client.selectedCapabilities = negotiation.selected;
+            const auto inserted = client.requestIds.observe(
+                decoded.header.requestId);
+            assert(inserted == RequestIdResult::Fresh);
+        }
+    }
+    const auto response = protocol::encodeAck(
+        decoded.header, ack, identity, connectionId);
+    const bool success = status == protocol::Status::Ok;
+    client.state.beginAck(success);
+    cancelDeadline(client);
+    if (success)
+        activeClientFd = record.clientFd;
+    sendAck(record.clientFd, record.generation, response, status, success);
+}
+
+void
+HostGPUBridge::processQueueRecord(const PendingRecord &record)
+{
+    auto found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &client = *found->second;
+    const auto decoded = protocol::decodeQueueRequestRecord(
+        record.bytes.data(), record.bytes.size(), maximumRecord);
+    if (decoded.action == protocol::DecodeAction::Drop) {
+        if (decoded.closeConnection)
+            closeClient(record.clientFd);
+        return;
+    }
+
+    protocol::Status sessionStatus = protocol::Status::Ok;
+    const bool queueSelected =
+        (client.selectedCapabilities[protocol::QueueControlCapabilityByte] &
+         protocol::QueueControlCapabilityMask) != 0;
+    if (decoded.header.daemonUuid != identity.daemonUuid) {
+        sessionStatus = protocol::Status::InstanceMismatch;
+    } else if (decoded.header.connectionId != client.connectionId) {
+        sessionStatus = protocol::Status::ProtocolState;
+    } else if (decoded.header.jobEpoch != identity.jobEpoch) {
+        sessionStatus = protocol::Status::TopologyMismatch;
+    } else if (!queueSelected) {
+        sessionStatus = protocol::Status::UnsupportedCapability;
+    }
+    protocol::Status status = queueRequestStatus(
+        decoded.status, sessionStatus);
+    if (status == protocol::Status::Ok) {
+        switch (client.requestIds.observe(decoded.header.requestId)) {
+          case RequestIdResult::Fresh:
+            break;
+          case RequestIdResult::NotIncreasing:
+            status = protocol::Status::ProtocolState;
+            break;
+        }
+    }
+
+    protocol::QueueResponse response;
+    response.status = status;
+    response.opcode = decoded.request.opcode;
+    response.queueId = decoded.request.queueId;
+    response.generation = decoded.request.generation;
+    response.sequence = decoded.request.sequence;
+    response.simTick = curTick();
+    bool commandAccepted = false;
+    if (status == protocol::Status::Ok) {
+        const HostGPUQueueState::Owner owner{
+            record.clientFd, record.generation};
+        auto decision = queueState.submit(
+            owner, decoded.header, decoded.request, curTick());
+        response = decision.response;
+        commandAccepted = decision.commandAccepted;
+    }
+
+    client.state.finishEstablishedRecord();
+    const auto responseHeader = protocol::queueResponseHeader(
+        decoded.header, identity, client.connectionId);
+    const auto encoded = protocol::encodeQueueAck(responseHeader, response);
+    sendQueueResponse(record.clientFd, record.generation, encoded,
+                      OutboundKind::QueueAck);
+    if (commandAccepted)
+        scheduleQueueService();
+}
+
+void
+HostGPUBridge::scheduleQueueService()
+{
+    const auto next = queueState.nextReadyTick();
+    if (next && !queueServiceEvent.scheduled())
+        schedule(queueServiceEvent, static_cast<Tick>(*next));
+}
+
+void
+HostGPUBridge::processQueueCommands()
+{
+    while (const auto command = queueState.popReady(curTick())) {
+        auto found = clients.find(command->owner.fd);
+        if (found == clients.end() ||
+            found->second->generation != command->owner.clientGeneration) {
+            continue;
+        }
+        const auto response = HostGPUQueueState::completionResponse(
+            *command, curTick());
+        const auto encoded = protocol::encodeQueueCompletion(
+            command->header, response);
+        sendQueueResponse(command->owner.fd,
+                          command->owner.clientGeneration, encoded,
+                          OutboundKind::QueueCompletion);
+    }
+    scheduleQueueService();
+}
+
 void
 HostGPUBridge::sendAck(int fd, uint64_t generation,
                        std::vector<uint8_t> record,
                        protocol::Status status, bool success)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
+        return;
+    enqueueOutbound(fd, generation, OutboundRecord{
+        std::move(record), OutboundKind::HandshakeAck, status, success});
+}
+
+void
+HostGPUBridge::sendQueueResponse(int fd, uint64_t generation,
+                                 std::vector<uint8_t> record,
+                                 OutboundKind kind)
+{
+    enqueueOutbound(fd, generation, OutboundRecord{
+        std::move(record), kind, protocol::Status::Ok, true});
+}
+
+void
+HostGPUBridge::enqueueOutbound(int fd, uint64_t generation,
+                               OutboundRecord record)
 {
     auto found = clients.find(fd);
     if (found == clients.end() || found->second->generation != generation)
         return;
     Client &client = *found->second;
-    if (!client.outbound.empty()) {
+    if (client.outbound.size() >= MaximumOutboundRecords) {
         closeClient(fd);
         return;
     }
-    client.outbound = std::move(record);
-    client.outboundStatus = status;
-    client.outboundSuccess = success;
-    flushClient(fd);
+    const bool wasEmpty = client.outbound.empty();
+    client.outbound.push_back(std::move(record));
+    if (wasEmpty)
+        flushClient(fd);
 }
 

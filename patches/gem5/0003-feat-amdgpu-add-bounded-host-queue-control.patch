+TEST(HostGPUQueueState, SequenceMustBePreviousPlusOneWithoutWrap)
+{
+    EXPECT_TRUE(HostGPUQueueState::isNextSequence(0, 1));
+    EXPECT_TRUE(HostGPUQueueState::isNextSequence(1, 2));
+    EXPECT_FALSE(HostGPUQueueState::isNextSequence(1, 1));
+    EXPECT_FALSE(HostGPUQueueState::isNextSequence(1, 3));

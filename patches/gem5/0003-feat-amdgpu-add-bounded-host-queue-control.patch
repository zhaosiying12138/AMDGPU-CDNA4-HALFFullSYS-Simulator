+
+bool
+decodeQueueEnvelope(const uint8_t *record, size_t size,
+                    uint32_t configuredMaximum, Header &header,
+                    const uint8_t *&payload, std::string &reason)
+{
+    if (record == nullptr || size < HeaderBytes ||
+        size > MaximumRecordBytes || size > configuredMaximum) {
+        reason = "record size";
+        return false;
+    }
+    if (!std::equal(Magic.begin(), Magic.end(), record) ||
+        load16(record + 8) != 1 || load16(record + 10) != 0) {
+        reason = "framing";
+        return false;
+    }
+    if (load16(record + 12) != HeaderBytes ||
+        load32(record + 20) != size - HeaderBytes ||
+        load32(record + 16) != 0) {
+        reason = "record envelope";
+        return false;
+    }
+    header.messageType = static_cast<MessageType>(load16(record + 14));
+    header.requestId = load64(record + 24);
+    header.daemonUuid = loadBytes<UuidBytes>(record + 32);
+    header.connectionId = load64(record + 48);
+    header.jobEpoch = load64(record + 56);
+    if (header.requestId == 0 || header.connectionId == 0 ||
+        isZero(header.daemonUuid) || header.jobEpoch == 0 ||
+        load32(record + 68) != 0 || load64(record + 72) != 0) {
+        reason = "request identity or reserved field";
+        return false;
+    }
+    if (crc32c(record, size) != load32(record + CrcOffset)) {
+        reason = "CRC32C";
+        return false;
+    }
+    payload = record + HeaderBytes;
+    return true;
+}

+    store16(payload, 0, response.major);
+    store16(payload, 2, response.minor);
+    store32(payload, 4, static_cast<uint32_t>(response.status));
+    store16(payload, 8, static_cast<uint16_t>(response.opcode));
+    store16(payload, 10, 0);
+    store64(payload, 16, response.queueId);
+    store64(payload, 24, response.generation);
+    store64(payload, 32, response.sequence);
+    store64(payload, 40, response.value);
+    store64(payload, 48, response.errorCode);
+    store64(payload, 56, response.simTick);
+    Header encoded = request;
+    encoded.messageType = type;
+    return encodeFrame(encoded, payload);

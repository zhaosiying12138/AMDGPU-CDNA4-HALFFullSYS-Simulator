+TEST(HostGPUQueueState, RejectsFdReuseAndWrongGeneration)
+{
+    HostGPUQueueState state;
+    const auto original = owner(9, 100);
+    const auto reused = owner(9, 101);
+    const auto created = state.submit(original, header(), create(2), 0);
+    EXPECT_EQ(state.submit(reused, header(2),
+                           doorbell(created.response, 1), 1)
+                  .response.status,
+              protocol::Status::ProtocolState);
+
+    auto wrongGeneration = doorbell(created.response, 1);
+    ++wrongGeneration.generation;
+    EXPECT_EQ(state.submit(original, header(3), wrongGeneration, 1)
+                  .response.status,
+              protocol::Status::ProtocolState);

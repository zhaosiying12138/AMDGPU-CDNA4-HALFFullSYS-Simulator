+        const auto frame = encodeQueueAck(canonical, response);
+        ASSERT_EQ(frame.size(), HeaderBytes + QueuePayloadBytes);
+        EXPECT_EQ(load64(frame.data() + 24), request.requestId);
+        EXPECT_TRUE(std::equal(server.daemonUuid.begin(),
+                               server.daemonUuid.end(), frame.begin() + 32));
+        EXPECT_EQ(load64(frame.data() + 48), actualConnection);
+        EXPECT_EQ(load64(frame.data() + 56), server.jobEpoch);
+    }
+}
+
+TEST(HostGpuProtocol, QueueRequestValidationIsStrict)
+{
+    auto expect = [](std::vector<uint8_t> frame, Status status) {
+        recomputeCrc(frame);
+        const auto decoded = decodeQueueRequestRecord(
+            frame.data(), frame.size(), MaximumRecordBytes);
+        EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+        EXPECT_EQ(decoded.status, status);
+        EXPECT_FALSE(decoded.closeConnection);
+    };
+
+    auto frame = fromHex(GoldenQueueRequestHex);
+    store16(frame, HeaderBytes, 2);
+    expect(frame, Status::UnsupportedVersion);
+
+    frame = fromHex(GoldenQueueRequestHex);
+    store16(frame, HeaderBytes + 2, 1);
+    expect(frame, Status::UnsupportedVersion);
+
+    frame = fromHex(GoldenQueueRequestHex);
+    store16(frame, HeaderBytes, 2);
+    store16(frame, HeaderBytes + 6, 1);
+    expect(frame, Status::Malformed);
+
+    QueueRequest malformedCreate;
+    malformedCreate.major = 2;
+    malformedCreate.opcode = QueueOpcode::Create;
+    malformedCreate.arg0 = 0;
+    frame = encodeQueueRequest(goldenQueueHeader(), malformedCreate);
+    expect(frame, Status::Malformed);
+
+    frame = fromHex(GoldenQueueRequestHex);
+    store16(frame, HeaderBytes + 4, 99);
+    expect(frame, Status::Malformed);
+
+    frame = fromHex(GoldenQueueRequestHex);
+    store16(frame, HeaderBytes + 6, 1);
+    expect(frame, Status::Malformed);
+
+    frame = fromHex(GoldenQueueRequestHex);
+    store64(frame, HeaderBytes + 48, 1);
+    expect(frame, Status::Malformed);
+
+    frame = fromHex(GoldenQueueRequestHex);
+    store64(frame, HeaderBytes + 56, 1);
+    expect(frame, Status::Malformed);
+
+    QueueRequest request;
+    request.opcode = QueueOpcode::Create;
+    request.arg0 = 1;
+    for (const size_t offset : {size_t(8), size_t(16), size_t(24),
+                                size_t(40)}) {
+        frame = encodeQueueRequest(goldenQueueHeader(), request);
+        store64(frame, HeaderBytes + offset, 1);
+        expect(frame, Status::Malformed);
+    }
+    request.arg0 = 0;
+    frame = encodeQueueRequest(goldenQueueHeader(), request);
+    expect(frame, Status::Malformed);
+
+    request.arg0 = 65;
+    frame = encodeQueueRequest(goldenQueueHeader(), request);
+    expect(frame, Status::Malformed);
+
+    request = {};
+    request.opcode = QueueOpcode::Destroy;
+    request.queueId = 1;
+    request.generation = 1;
+    for (const size_t offset : {size_t(24), size_t(32), size_t(40)}) {
+        frame = encodeQueueRequest(goldenQueueHeader(), request);
+        store64(frame, HeaderBytes + offset, 1);
+        expect(frame, Status::Malformed);
+    }
+
+    request = goldenQueueRequest();
+    request.sequence = 0;
+    frame = encodeQueueRequest(goldenQueueHeader(), request);
+    expect(frame, Status::Malformed);
+
+    request = goldenQueueRequest();
+    request.arg0 = 3;
+    frame = encodeQueueRequest(goldenQueueHeader(), request);
+    expect(frame, Status::Malformed);
+
+    request = goldenQueueRequest();
+    request.arg1 = 1;
+    frame = encodeQueueRequest(goldenQueueHeader(), request);
+    expect(frame, Status::Malformed);
+}
+
+TEST(HostGpuProtocol, QueueEnvelopeFailuresDropSilently)
+{
+    const auto golden = fromHex(GoldenQueueRequestHex);
+    std::vector<std::vector<uint8_t>> cases;
+    cases.emplace_back(golden.begin(), golden.begin() + HeaderBytes - 1);
+    cases.push_back(golden);
+    cases.back()[0] ^= 1;
+    cases.push_back(golden);
+    store32(cases.back(), 16, 1);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store64(cases.back(), 24, 0);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store64(cases.back(), 48, 0);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    std::fill(cases.back().begin() + 32, cases.back().begin() + 48, 0);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store64(cases.back(), 56, 0);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store32(cases.back(), 68, 1);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store64(cases.back(), 72, 1);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    cases.back().back() ^= 1;
+    cases.push_back(golden);
+    store16(cases.back(), 14,
+            static_cast<uint16_t>(MessageType::QueueAck));
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    cases.back().pop_back();
+    store32(cases.back(), 20, QueuePayloadBytes - 1);
+    recomputeCrc(cases.back());
+
+    for (const auto &frame : cases) {
+        const auto decoded = decodeQueueRequestRecord(
+            frame.data(), frame.size(), MaximumRecordBytes);
+        EXPECT_EQ(decoded.action, DecodeAction::Drop);
+        EXPECT_TRUE(decoded.closeConnection);
+    }
+}

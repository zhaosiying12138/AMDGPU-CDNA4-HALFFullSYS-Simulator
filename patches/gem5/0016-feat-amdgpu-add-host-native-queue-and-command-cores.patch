+constexpr const char *FixtureRelativePath =
+    "projects/rocm-systems/projects/rdc/rdc_libs/rdc_modules/kernels/"
+    "hsaco/gfx950/gpuReadWrite_kernels.hsaco";
+constexpr uint32_t QueueId = 511;
+constexpr uint64_t QueueGeneration = 1;
+constexpr uint32_t QueueBytes = 4096;
+constexpr uint32_t DoorbellBytes = 8;
+
+void
+require(bool condition, const char *message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+std::vector<uint8_t>
+readFixture(int argc, char **argv)
+{
+    std::vector<std::string> candidates;
+    if (argc > 1)
+        candidates.emplace_back(argv[1]);
+    candidates.emplace_back(FixtureRelativePath);
+    candidates.emplace_back(
+        std::string("../") + std::string(FixtureRelativePath).substr(9));
+    candidates.emplace_back(std::string("../../") + FixtureRelativePath);
+    candidates.emplace_back(std::string("../../../") + FixtureRelativePath);
+    for (const auto &candidate : candidates) {
+        std::ifstream input(candidate, std::ios::binary);
+        if (!input)
+            continue;
+        return {std::istreambuf_iterator<char>(input),
+                std::istreambuf_iterator<char>()};
+    }
+    throw std::runtime_error("locked gpuReadWrite HSACO fixture is unavailable");
+}
+
+protocol::CodeObjectManifest
+fixtureManifest(const std::vector<uint8_t> &image)
+{
+    protocol::CodeObjectManifest manifest;
+    manifest.imageSize = image.size();
+    manifest.chunkCount = 2;
+    manifest.segmentCount = 3;
+    manifest.kernelIndex = 0;
+    manifest.imageSha256 = {
+        0x7b, 0x6a, 0x4d, 0x2b, 0xb7, 0xf9, 0xc4, 0xe7,
+        0x46, 0x6b, 0xcf, 0x69, 0xf3, 0x11, 0x0e, 0xcb,
+        0xfa, 0xb5, 0x4d, 0x07, 0xab, 0xd4, 0xc7, 0x0b,
+        0x6b, 0xd9, 0x6b, 0x6a, 0x6f, 0xb9, 0xde, 0x56,
+    };
+    manifest.elfMachine = code_object_fixture::ElfMachine;
+    manifest.elfType = code_object_fixture::ElfTypeDyn;
+    manifest.elfOsabi = code_object_fixture::ElfOsabiAmdgpuHsa;
+    manifest.elfAbiVersion = code_object_fixture::ElfAbiVersion;
+    manifest.elfFlags = code_object_fixture::ElfFlags;
+    manifest.gfxTarget = code_object_fixture::GfxTarget;
+    manifest.codeObjectVersion = code_object_fixture::CodeObjectVersion;
+    manifest.metadataMajor = code_object_fixture::MetadataMajor;
+    manifest.metadataMinor = code_object_fixture::MetadataMinor;
+    manifest.relocationCount = code_object_fixture::RelocationCount;
+    manifest.kernargSegmentSize = 280;
+    manifest.kernargSegmentAlign = 8;
+    manifest.maxFlatWorkgroupSize = 256;
+    manifest.wavefrontSize = 64;
+    manifest.sgprCount = 22;
+    manifest.vgprCount = 6;
+    manifest.descriptorSize = code_object_fixture::DescriptorBytes;
+    manifest.kernelCodeEntryByteOffset = 0x1100;
+    manifest.codeVirtualAddress = 0x1900;
+    manifest.codeFileOffset = 0x900;
+    manifest.codeSize = 0x78;
+    manifest.descriptorVirtualAddress = 0x800;
+    manifest.descriptorFileOffset = 0x800;
+    std::copy_n("gpuReadWrite", 12, manifest.kernelName.begin());
+    std::copy_n("gpuReadWrite.kd", 15, manifest.descriptorSymbol.begin());
+    require(image.size() == 5528, "gpuReadWrite fixture size");
+    std::copy_n(image.begin() + manifest.descriptorFileOffset,
+                protocol::CodeObjectDescriptorBytes, manifest.descriptor.begin());
+    manifest.segments[0] = {1, 4, 0, 0, 0x840, 0x840, 0x1000};
+    manifest.segments[1] = {1, 5, 0x900, 0x1900, 0x480, 0x480, 0x1000};
+    manifest.segments[2] = {1, 6, 0xd80, 0x2d80, 0x70, 0x280, 0x1000};
+    return manifest;
+}
+
+struct StagedImage
+{
+    std::vector<uint8_t> image;
+    protocol::CodeObjectManifest manifest;
+};
+
+StagedImage
+stageImage(const std::vector<uint8_t> &image,
+           const protocol::CodeObjectManifest &manifest)
+{
+    HostGPUCodeObjectState state;
+    const HostGPUCodeObjectState::Owner owner{37, 1};
+    protocol::CodeObjectRequest begin;
+    begin.opcode = protocol::CodeObjectOpcode::Begin;
+    begin.manifest = manifest;
+    const auto beginResult = state.submit(owner, begin, 1);
+    require(beginResult.accepted, "B1 code-object begin");
+
+    uint64_t offset = 0;
+    for (uint32_t index = 0; index < manifest.chunkCount; ++index) {
+        protocol::CodeObjectRequest chunk;
+        chunk.opcode = protocol::CodeObjectOpcode::Chunk;
+        chunk.objectId = beginResult.response.objectId;
+        chunk.generation = beginResult.response.generation;
+        chunk.imageOffset = offset;
+        chunk.chunkIndex = index;
+        const auto count = static_cast<uint32_t>(std::min<uint64_t>(
+            manifest.imageSize - offset, protocol::CodeObjectChunkDataBytes));
+        chunk.byteCount = count;
+        std::copy_n(image.begin() + offset, count, chunk.chunkData.begin());
+        chunk.chunkCrc32c = protocol::crc32c(chunk.chunkData.data(), count);
+        require(state.submit(owner, chunk, 2 + index).accepted,
+                "B1 code-object chunk");
+        offset += count;
+    }
+
+    protocol::CodeObjectRequest commit;
+    commit.opcode = protocol::CodeObjectOpcode::Commit;
+    commit.objectId = beginResult.response.objectId;
+    commit.generation = beginResult.response.generation;
+    commit.byteCount = manifest.imageSize;
+    commit.chunkIndex = manifest.chunkCount;
+    commit.commitSha256 = manifest.imageSha256;
+    const auto commitResult = state.submit(owner, commit, 4);
+    require(commitResult.committed, "B1 code-object commit");
+
+    StagedImage staged;
+    require(state.readCommittedImage(owner, beginResult.response.objectId,
+                                     beginResult.response.generation,
+                                     staged.image),
+            "B1 committed image");
+    const auto committedManifest = state.committedManifest(
+        owner, beginResult.response.objectId, beginResult.response.generation);
+    require(committedManifest.has_value(), "B1 committed manifest");
+    staged.manifest = *committedManifest;
+    return staged;
+}
+
+struct AllocationLease
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+    Addr gpuVa = 0;
+    HostNativeMemoryContext::PageLease lease;
+};
+
+AllocationLease
+allocate(HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+         const HostGPUMemoryState::Owner &owner, uint64_t bytes, uint64_t now)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Allocate;
+    request.byteCount = bytes;
+    request.argument = 4096;
+    const auto response = memory.allocate(owner, request, now);
+    require(response.status == protocol::Status::Ok, "B1 allocation");
+    const auto lease = context.map(response.value0, bytes);
+    require(lease.has_value(), "B1 page map");
+    return {response.allocationId, response.generation, response.value0,
+            *lease};
+}
+
+void
+release(HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+        const HostGPUMemoryState::Owner &owner, const AllocationLease &value,
+        uint64_t now)
+{
+    require(context.unmap(value.lease), "B1 page unmap");
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Free;
+    request.allocationId = value.id;
+    request.generation = value.generation;
+    require(memory.free(owner, request, now).status == protocol::Status::Ok,
+            "B1 allocation free");
+}
+
+class LifecycleRecorder : public GPUDispatchLifecycleListener
+{
+  public:
+    std::vector<std::string> events;
+
+    void hsaPacketFetched(Addr, uint32_t) override
+    {
+        events.emplace_back("hsa_packet_fetched");
+    }
+    void commandProcessorSubmitted(const HSAQueueEntry &) override
+    {
+        events.emplace_back("command_processor_submitted");
+    }
+    void gpuDispatcherStarted(const HSAQueueEntry &) override
+    {
+        events.emplace_back("gpu_dispatcher_started");
+    }
+    void hsaPacketRetired(const HSAQueueEntry &, int, int) override
+    {
+        events.emplace_back("hsa_packet_retired");
+    }
+};
+
+void
+runSelfTest(const std::vector<uint8_t> &image)
+{
+    const auto manifest = fixtureManifest(image);
+    require(HostGPUCodeObjectState::imageSha256(image) == manifest.imageSha256,
+            "B1 fixture SHA");
+    const auto staged = stageImage(image, manifest);
+
+    HostGPUMemoryState memory;
+    const HostGPUMemoryState::Owner owner{37, 1};
+    HostNativeMemoryContext context(memory, owner);
+    HostNativeCodeObjectMapper mapper(memory, context, owner);
+    const auto mapping = mapper.map(staged.image, staged.manifest);
+    require(mapping && mapping->valid(), "B1 PT_LOAD map");
+
+    const auto data = allocate(memory, context, owner, 4096, 10);
+    const auto kernarg = allocate(memory, context, owner, 4096, 11);
+    const auto packet = allocate(memory, context, owner, QueueBytes, 12);
+    const auto signal = allocate(memory, context, owner, 4096, 13);
+    const auto mqd = allocate(memory, context, owner, 4096, 14);
+    const uint64_t signalObjectWord = 1;
+    require(context.functionalWrite(signal.gpuVa, &signalObjectWord,
+                                    sizeof(signalObjectWord)),
+            "B1 signal initialize");
+
+    {
+    HostNativeDispatchAdmission admission;
+    HostNativeDispatchAdmission::Result admissionResult;
+    require(admission.materialize(
+                *mapping, staged.manifest, context, packet.gpuVa,
+                kernarg.gpuVa, signal.gpuVa, data.gpuVa, data.gpuVa + 0x400,
+                data.gpuVa + 0x800, QueueId, QueueGeneration, 1,
+                admissionResult),
+            admission.failure());
+    require(admissionResult.descriptorLoaded &&
+                admissionResult.descriptorEntryRelation &&
+                admissionResult.hiddenKernargPacked &&
+                admissionResult.aqlFieldsValid &&
+                !admissionResult.hsaQueueEntryValid &&
+                !admissionResult.lifecycleListenerContractSmoke &&
+                admissionResult.listenerEvents.empty() &&
+                !admissionResult.kernelExecuted,
+            "B1 admission result flags");
+
+    _amd_queue_t queueDescriptor = {};
+    queueDescriptor.hsa_queue.base_address =
+        reinterpret_cast<void *>(packet.gpuVa);
+    queueDescriptor.hsa_queue.size =
+        QueueBytes / HostNativeQueueCore::PacketBytes;
+    queueDescriptor.hsa_queue.id = QueueId;
+    queueDescriptor.read_dispatch_id = 0;
+    queueDescriptor.write_dispatch_id = 0;
+    queueDescriptor.read_dispatch_id_field_base_byte_offset =
+        offsetof(_amd_queue_t, read_dispatch_id);
+    static_assert(sizeof(queueDescriptor) == 256);
+    require(context.functionalWrite(mqd.gpuVa, &queueDescriptor,
+                                    sizeof(queueDescriptor)),
+            "B1 MQD initialize");
+
+    HostNativeQueueCore queue(context);
+    HostNativeQueueCore::Config queueConfig;
+    queueConfig.baseVa = packet.gpuVa;
+    queueConfig.hostReadIndexVa =
+        mqd.gpuVa + offsetof(_amd_queue_t, read_dispatch_id);
+    queueConfig.activeQueueId = QueueId;
+    queueConfig.generation = QueueGeneration;
+    queueConfig.registeredIndex = 0;
+    queueConfig.queueBytes = QueueBytes;
+    queueConfig.doorbellBytes = DoorbellBytes;
+    queueConfig.readIndex = 0;
+    {
+        HostNativeQueueCore wrapQueue(context);
+        auto wrapConfig = queueConfig;
+        wrapConfig.readIndex = 63;
+        require(wrapQueue.registerQueue(wrapConfig), wrapQueue.failure());
+        Addr wrapPacketVa = 0;
+        require(HostNativeQueueCore::packetAddress(
+                    packet.gpuVa, 63, QueueBytes /
+                        HostNativeQueueCore::PacketBytes,
+                    wrapPacketVa),
+                "B1 wrap packet address");
+        require(wrapQueue.publish(
+                    wrapPacketVa, admissionResult.aqlBytes.data(),
+                    admissionResult.aqlBytes.size(), 100),
+                wrapQueue.failure());
+        uint32_t wrapRegisteredIndex = 1;
+        require(wrapQueue.ring(64, wrapRegisteredIndex) &&
+                    wrapRegisteredIndex == 0,
+                wrapQueue.failure());
+        HostNativeQueueCore::FetchedPacket wrapFetched;
+        require(wrapQueue.fetch(wrapFetched, nullptr, 100),
+                wrapQueue.failure());
+        require(wrapQueue.acceptDispatch(wrapFetched.ticket) &&
+                    wrapQueue.writeIndex() == 64 &&
+                    wrapQueue.fetchIndex() == 64 &&
+                    wrapQueue.dispatchIndex() == 64 &&
+                    wrapQueue.readIndex() == 63,
+                "B1 queue index 63-to-64 wrap");
+        require(!wrapQueue.unregisterQueue(),
+                "B1 wrapped in-flight unregister rejection");
+    }
+    HostNativeQueueCore invalidQueue(context);
+    auto invalidConfig = queueConfig;
+    invalidConfig.activeQueueId = HostNativeQueueCore::MaxQueueId;
+    require(!invalidQueue.registerQueue(invalidConfig),
+            "B1 invalid active queue ID rejection");
+    require(queue.registerQueue(queueConfig), queue.failure());
+
+    uint32_t registeredIndex = 0;
+    require(!queue.ring(1, registeredIndex),
+            "B1 ring-before-publish rejection");
+    require(queue.publish(packet.gpuVa, admissionResult.aqlBytes.data(),
+                           admissionResult.aqlBytes.size(), 101),
+            queue.failure());
+    require(!queue.ring(2, registeredIndex), "B1 skipped-ring rejection");
+    require(queue.ring(1, registeredIndex) && registeredIndex == 0,
+            queue.failure());
+    queueDescriptor.write_dispatch_id = 1;
+    require(context.functionalWrite(mqd.gpuVa, &queueDescriptor,
+                                    sizeof(queueDescriptor)),
+            "B1 MQD write-index publication");
+
+    LifecycleRecorder recorder;
+    HostNativeQueueCore::FetchedPacket fetched;
+    require(queue.fetch(fetched, &recorder, 102), queue.failure());
+    require(fetched.valid() && fetched.queueIndex == 0 &&
+                fetched.hostPacketVa == packet.gpuVa,
+            "B1 fetched packet identity");
+
+    HostNativeCommandProcessorCore commandProcessor;
+    queueDescriptor.read_dispatch_id_field_base_byte_offset = 64;
+    require(context.functionalWrite(mqd.gpuVa, &queueDescriptor,
+                                    sizeof(queueDescriptor)),
+            "B1 malformed MQD publish");
+    HostNativeCommandProcessorCore::Result rejectedMqd;
+    require(!commandProcessor.submit(fetched, queue, *mapping,
+                                     staged.manifest, context, 1, rejectedMqd,
+                                     &recorder, 103),
+            "B1 malformed MQD offset rejection");
+    require(recorder.events == std::vector<std::string>{"hsa_packet_fetched"},
+            "B1 malformed MQD emitted no CP event");
+    queueDescriptor.read_dispatch_id_field_base_byte_offset =
+        offsetof(_amd_queue_t, read_dispatch_id);
+    require(context.functionalWrite(mqd.gpuVa, &queueDescriptor,
+                                    sizeof(queueDescriptor)),
+            "B1 MQD restore");
+
+    HostNativeCommandProcessorCore::Result rejected;
+    auto malformed = fetched;
+    malformed.bytes[0] = 1;
+    require(!commandProcessor.submit(malformed, queue, *mapping,
+                                     staged.manifest, context, 1, rejected,
+                                     &recorder, 104),
+            "B1 forged packet rejection");
+    require(recorder.events == std::vector<std::string>{"hsa_packet_fetched"},
+            "B1 rejected packet emitted no CP event");
+
+    HostNativeCommandProcessorCore::Result submitted;
+    require(commandProcessor.submit(fetched, queue, *mapping,
+                                     staged.manifest, context, 1, submitted,
+                                     &recorder, 105),
+            commandProcessor.failure());
+    require(submitted.descriptorRead && submitted.kernargRead &&
+                submitted.completionSignalObjectRead && submitted.mqdRead &&
+                submitted.descriptorEntryRelation && submitted.taskValid &&
+                submitted.commandProcessorSubmitted &&
+                submitted.registeredIndex == 0 &&
+                submitted.task->queueId() == 0 &&
+                !submitted.kernelExecuted,
+            "B1 CP result flags");
+    require(submitted.task->kernelName() == "gpuReadWrite" &&
+                submitted.task->gfxVersion() == GfxVersion::gfx950 &&
+                submitted.task->numVectorRegs() == 8 &&
+                submitted.task->numScalarRegs() == 24 &&
+                submitted.task->accumOffset() == 8 &&
+                submitted.task->wgSize(0) == 256 &&
+                submitted.task->gridSize(0) == 1024 &&
+                submitted.task->numWgTotal() == 4 &&
+                submitted.task->hostDispPktAddr() == packet.gpuVa &&
+                submitted.task->codeAddr() == mapping->codeGpuVa &&
+                submitted.task->kernargAddr() == kernarg.gpuVa &&
+                submitted.task->completionSignal() == signal.gpuVa,
+            "B1 HSAQueueEntry descriptor getters");
+    require(submitted.task->hostAMDQueueAddr == mqd.gpuVa &&
+                submitted.task->amdQueue.hsa_queue.id == QueueId &&
+                submitted.task->amdQueue.hsa_queue.size == 64 &&
+                submitted.task->amdQueue.write_dispatch_id == 1 &&
+                submitted.task->amdQueue.read_dispatch_id == 0,
+            "B1 HSAQueueEntry MQD copy");
+    require(recorder.events == std::vector<std::string>{
+                "hsa_packet_fetched", "command_processor_submitted"},
+            "B1 lifecycle ordering");
+
+    _amd_queue_t mqdReadback = {};
+    require(context.functionalRead(mqd.gpuVa, &mqdReadback,
+                                    sizeof(mqdReadback)) &&
+                mqdReadback.read_dispatch_id == 0,
+            "B1 no host read-index write");
+    require(queue.fetchIndex() == 1 && queue.dispatchIndex() == 1 &&
+                queue.readIndex() == 0 && queue.writeIndex() == 1 &&
+                !queue.hostReadIndexUpdated(),
+            "B1 queue acknowledgement boundary");
+    require(!queue.unregisterQueue(), "B1 in-flight unregister rejection");
+    } // B1 queue/CP state teardown; no packet retirement is synthesized.
+
+    require(mapper.unmap(*mapping), "B1 PT_LOAD unmap");
+    release(memory, context, owner, mqd, 106);
+    release(memory, context, owner, signal, 107);
+    release(memory, context, owner, packet, 108);
+    release(memory, context, owner, kernarg, 109);
+    release(memory, context, owner, data, 110);
+}

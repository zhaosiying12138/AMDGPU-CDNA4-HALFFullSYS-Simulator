+int
+main(int argc, char **argv)
+{
+    try {
+        const auto image = gem5::hostgpu::readFixture(argc, argv);
+        gem5::hostgpu::runSelfTest(image);
+        std::cout
+            << "{\"schema\":\"gem5.host-native.dispatch-b1.v1\","
+               "\"staged_image_roundtrip\":true,"
+               "\"native_address_space_resolved\":true,"
+               "\"descriptor_read\":true,\"mqd_read\":true,"
+               "\"kernarg_read\":true,\"completion_signal_object_read\":true,"

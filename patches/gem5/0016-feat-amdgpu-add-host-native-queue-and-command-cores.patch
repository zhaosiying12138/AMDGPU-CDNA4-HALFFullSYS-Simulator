+/**
+ * Functional command-processor admission for the host-native front-end.
+ *
+ * This is the descriptor/MQD half of GPUCommandProcessor::submitDispatchPkt.
+ * It deliberately stops after HSAQueueEntry construction and the shared
+ * lifecycle callback.  Shader, GPUDispatcher, CU, DMA ports, and gem5 System
+ * objects are intentionally absent from this class and its link boundary.
+ */
+class HostNativeCommandProcessorCore
+{
+  public:
+    struct Result
+    {
+        Result() = default;
+        Result(const Result &) = delete;
+        Result &operator=(const Result &) = delete;
+        Result(Result &&) = delete;
+        Result &operator=(Result &&) = delete;
+
+        void reset()
+        {
+            task.reset();
+            packet = {};
+            descriptor = {};
+            mqd = {};
+            machineCodeVa = 0;
+            mqdBaseVa = 0;
+            registeredIndex = 0;
+            descriptorRead = false;
+            kernargRead = false;
+            completionSignalObjectRead = false;
+            mqdRead = false;
+            descriptorEntryRelation = false;
+            taskValid = false;
+            commandProcessorSubmitted = false;
+            kernelExecuted = false;
+        }
+
+        _hsa_dispatch_packet_t packet = {};
+        AMDKernelCode descriptor = {};
+        _amd_queue_t mqd = {};
+        std::optional<HSAQueueEntry> task;
+        Addr machineCodeVa = 0;
+        Addr mqdBaseVa = 0;
+        uint32_t registeredIndex = 0;
+        bool descriptorRead = false;
+        bool kernargRead = false;
+        /* B1 only proves that the signal object range is readable. */
+        bool completionSignalObjectRead = false;
+        bool mqdRead = false;
+        bool descriptorEntryRelation = false;
+        bool taskValid = false;
+        bool commandProcessorSubmitted = false;
+        bool kernelExecuted = false;
+    };
+
+    bool submit(
+        const HostNativeQueueCore::FetchedPacket &fetched,
+        HostNativeQueueCore &queue,
+        const HostNativeCodeObjectMapper::Mapping &mapping,
+        const protocol::CodeObjectManifest &manifest,
+        HostNativeMemoryContext &context, uint64_t dispatchId,
+        Result &result, GPUDispatchLifecycleListener *listener = nullptr,
+        uint64_t requestId = 0);
+
+    const char *failure() const { return failureReason.c_str(); }
+
+  private:
+    bool fail(const char *reason);
+    static bool checkedEntryAddress(
+        Addr descriptor, int64_t offset, Addr &entry);
+    static std::string kernelName(
+        const protocol::CodeObjectManifest &manifest);
+    static bool packetFieldsValid(const _hsa_dispatch_packet_t &packet);
+    bool readMqd(const HostNativeQueueCore &queue,
+                 HostNativeMemoryContext &context, Result &result,
+                 uint64_t requestId);
+    bool validateDescriptor(
+        const HostNativeCodeObjectMapper::Mapping &mapping,
+        const protocol::CodeObjectManifest &manifest,
+        HostNativeMemoryContext &context, Result &result,
+        uint64_t requestId);
+
+    std::string failureReason = "none";
+};
+

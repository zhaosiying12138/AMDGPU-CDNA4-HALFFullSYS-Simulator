+    Addr baseVa, uint64_t index, uint32_t depth, Addr &address)
+{
+    if (baseVa == 0 || depth == 0)
+        return false;
+    const uint64_t slot = index % depth;
+    if (slot > std::numeric_limits<uint64_t>::max() / PacketBytes)
+        return false;
+    const uint64_t offset = slot * PacketBytes;
+    if (baseVa > std::numeric_limits<Addr>::max() - offset)
+        return false;
+    address = baseVa + offset;
+    return true;
+}
+
+bool
+HostNativeQueueCore::validRegistration(const Config &candidate) const
+{
+    if (candidate.baseVa == 0 || candidate.hostReadIndexVa == 0 ||
+        candidate.generation == 0 || candidate.activeQueueId >= MaxQueueId ||
+        candidate.registeredIndex >= MaxQueueId ||
+        candidate.queueBytes < PacketBytes ||
+        candidate.queueBytes % PacketBytes != 0 ||
+        (candidate.doorbellBytes != 4 && candidate.doorbellBytes != 8) ||
+        candidate.activeQueueId > std::numeric_limits<Addr>::max() /
+            candidate.doorbellBytes ||
+        candidate.readIndex == std::numeric_limits<uint64_t>::max()) {
+        return false;
+    }
+    const uint64_t depth = candidate.queueBytes / PacketBytes;
+    return depth != 0;
+}
+
+bool
+HostNativeQueueCore::nextIndex(uint64_t value, uint64_t &next) const
+{
+    if (value == std::numeric_limits<uint64_t>::max())
+        return false;
+    next = value + 1;
+    return true;
+}
+
+bool
+HostNativeQueueCore::queueHasSpace(uint64_t candidateWrite) const
+{
+    if (candidateWrite < readIdx || slots.empty())
+        return false;
+    return candidateWrite - readIdx <= slots.size();
+}
+
+void
+HostNativeQueueCore::reset()
+{
+    queueConfig = {};
+    slots.clear();
+    pending.reset();
+    writeIdx = 0;
+    fetchIdx = 0;
+    readIdx = 0;
+    dispatchIdx = 0;
+    nextTicket = 1;
+    regdIndex = 0;
+    registered = false;
+}
+
+bool
+HostNativeQueueCore::registerQueue(const Config &newConfig)
+{
+    failureReason = "none";
+    if (registered)
+        return fail("queue already registered");
+    if (!validRegistration(newConfig))
+        return fail("invalid queue registration");
+
+    const uint32_t depth = newConfig.queueBytes / PacketBytes;
+    std::vector<uint8_t> probe;
+    if (!context.functionalRead(
+            newConfig.baseVa, PacketBytes, probe)) {
+        return fail("queue base address translation");
+    }
+    if (!context.functionalRead(
+            newConfig.hostReadIndexVa, sizeof(uint64_t), probe)) {
+        return fail("queue read-index address translation");
+    }
+
+    try {
+        slots.resize(depth);
+    } catch (const std::exception &) {
+        return fail("queue ring allocation");
+    }
+    queueConfig = newConfig;
+    writeIdx = newConfig.readIndex;
+    fetchIdx = newConfig.readIndex;
+    readIdx = newConfig.readIndex;
+    dispatchIdx = newConfig.readIndex;
+    regdIndex = newConfig.registeredIndex;
+    registered = true;
+    return true;
+}
+
+bool
+HostNativeQueueCore::publish(
+    Addr packetVa, const uint8_t *bytes, size_t byteCount,
+    uint64_t requestId)
+{
+    failureReason = "none";
+    if (!registered)
+        return fail("queue is not registered");
+    if (!bytes || byteCount != PacketBytes)
+        return fail("invalid AQL packet size");
+
+    Addr expected = 0;
+    if (!packetAddress(queueConfig.baseVa, writeIdx, slots.size(), expected) ||
+        packetVa != expected) {
+        return fail("packet address is outside queue slot");
+    }
+    Slot &slot = slots[writeIdx % slots.size()];
+    if (slot.published || slot.fetched)
+        return fail("queue slot is busy");
+    if (!context.functionalWrite(packetVa, bytes, byteCount, requestId))
+        return fail("AQL packet functional write");
+    std::memcpy(slot.bytes.data(), bytes, PacketBytes);
+    slot.hostPacketVa = packetVa;
+    slot.published = true;
+    return true;
+}
+
+bool
+HostNativeQueueCore::ring(uint64_t newWriteIndex, uint32_t &registeredIndex)
+{
+    failureReason = "none";
+    registeredIndex = 0;
+    if (!registered)
+        return fail("queue is not registered");
+    uint64_t expected = 0;
+    if (!nextIndex(writeIdx, expected) || newWriteIndex != expected)
+        return fail("queue ring index is not monotonic");
+    if (!queueHasSpace(newWriteIndex))
+        return fail("queue ring is full");
+    Slot &slot = slots[writeIdx % slots.size()];
+    if (!slot.published || slot.hostPacketVa == 0)
+        return fail("queue ring has no published packet");
+    writeIdx = newWriteIndex;
+    registeredIndex = regdIndex;
+    return true;
+}
+
+bool
+HostNativeQueueCore::fetch(
+    FetchedPacket &packet, GPUDispatchLifecycleListener *listener,
+    uint64_t requestId)
+{
+    failureReason = "none";
+    packet = {};
+    if (!registered)
+        return fail("queue is not registered");
+    if (pending)
+        return fail("queue fetch already pending");
+    if (fetchIdx >= writeIdx)
+        return fail("queue has no pending packet");
+
+    Addr packetVa = 0;
+    if (!packetAddress(
+            queueConfig.baseVa, fetchIdx, slots.size(), packetVa)) {
+        return fail("queue packet address overflow");
+    }
+    Slot &slot = slots[fetchIdx % slots.size()];
+    if (!slot.published || slot.fetched || slot.hostPacketVa != packetVa)
+        return fail("queue slot publication state");
+
+    std::vector<uint8_t> bytes;
+    if (!context.functionalRead(packetVa, PacketBytes, bytes, requestId) ||
+        bytes.size() != PacketBytes) {
+        return fail("AQL packet functional read");
+    }
+    /* The queue core only accepts kernel dispatch packets. */
+    if ((bytes[0] & 0xffU) != 2U)
+        return fail("AQL packet is not a kernel dispatch");
+    if (nextTicket == 0)
+        return fail("queue fetch ticket exhausted");
+
+    std::memcpy(packet.bytes.data(), bytes.data(), PacketBytes);
+    packet.ticket = nextTicket++;
+    packet.queueIndex = fetchIdx;
+    packet.hostPacketVa = packetVa;
+    packet.activeQueueId = queueConfig.activeQueueId;
+    packet.queueGeneration = queueConfig.generation;
+    packet.registeredIndex = queueConfig.registeredIndex;
+    pending = packet;
+    slot.fetched = true;
+    uint64_t next = 0;
+    if (!nextIndex(fetchIdx, next)) {
+        slot.fetched = false;
+        pending.reset();
+        packet = {};
+        return fail("queue fetch index exhausted");
+    }
+    fetchIdx = next;
+    if (listener)
+        listener->hsaPacketFetched(packetVa, regdIndex);
+    return true;
+}
+
+bool
+HostNativeQueueCore::ownsPending(const FetchedPacket &packet) const
+{
+    return registered && pending && packet.valid() &&
+        pending->ticket == packet.ticket &&
+        pending->queueIndex == packet.queueIndex &&
+        pending->hostPacketVa == packet.hostPacketVa &&
+        pending->activeQueueId == packet.activeQueueId &&
+        pending->queueGeneration == packet.queueGeneration &&
+        pending->registeredIndex == packet.registeredIndex &&
+        pending->bytes == packet.bytes;
+}
+
+bool
+HostNativeQueueCore::acceptDispatch(uint64_t ticket)
+{
+    failureReason = "none";
+    if (!registered || !pending || pending->ticket != ticket)
+        return fail("unknown queue fetch ticket");
+    if (pending->queueIndex != dispatchIdx)
+        return fail("queue dispatch index changed");
+    uint64_t next = 0;
+    if (!nextIndex(dispatchIdx, next))
+        return fail("queue dispatch index exhausted");
+    dispatchIdx = next;
+    pending.reset();
+    return true;
+}
+
+bool
+HostNativeQueueCore::cancelFetch(uint64_t ticket)
+{
+    failureReason = "none";
+    if (!registered || !pending || pending->ticket != ticket)
+        return fail("unknown queue fetch ticket");
+    if (fetchIdx == 0 || pending->queueIndex + 1 != fetchIdx)
+        return fail("queue fetch index changed");
+    Slot &slot = slots[pending->queueIndex % slots.size()];
+    slot.fetched = false;
+    fetchIdx = pending->queueIndex;
+    pending.reset();
+    return true;
+}
+
+bool
+HostNativeQueueCore::unregisterQueue()
+{
+    failureReason = "none";
+    if (!registered)
+        return fail("queue is not registered");
+    if (pending || readIdx != writeIdx)
+        return fail("queue has in-flight packets");
+    reset();
+    return true;
+}
+
+} // namespace hostgpu
+} // namespace gem5

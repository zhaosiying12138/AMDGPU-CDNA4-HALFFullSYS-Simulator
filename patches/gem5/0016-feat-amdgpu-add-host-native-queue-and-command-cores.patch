+{
+
+class GPUDispatchLifecycleListener;
+
+namespace hostgpu
+{
+
+/**
+ * A small host-native implementation of the AQL publication/fetch boundary.
+ *
+ * The legacy HSAPacketProcessor uses a DmaVirtDevice and gem5 events to copy
+ * packets into an internal ring.  This class keeps the same queue invariants,
+ * but uses the host-owned functional address space synchronously.  It does
+ * not model a doorbell device, a DMA port, a GPU VM walker, or execution.
+ */
+class HostNativeQueueCore
+{
+  public:
+    static constexpr size_t PacketBytes = 64;
+    static constexpr uint32_t MaxQueueId = 4096 / 8;
+
+    struct Config
+    {
+        Addr baseVa = 0;
+        Addr hostReadIndexVa = 0;
+        uint64_t activeQueueId = 0;
+        uint64_t generation = 0;
+        uint32_t registeredIndex = 0;
+        uint32_t queueBytes = 0;
+        uint32_t doorbellBytes = 0;
+        uint64_t readIndex = 0;
+    };
+
+    /** A fetched packet copy whose bytes remain valid for the caller. */
+    struct FetchedPacket
+    {
+        uint64_t ticket = 0;
+        uint64_t queueIndex = 0;
+        Addr hostPacketVa = 0;
+        uint64_t activeQueueId = 0;
+        uint64_t queueGeneration = 0;
+        uint32_t registeredIndex = 0;
+        std::array<uint8_t, PacketBytes> bytes = {};
+
+        bool valid() const
+        {
+            return ticket != 0 && hostPacketVa != 0 && queueGeneration != 0;
+        }
+    };
+
+    explicit HostNativeQueueCore(HostNativeMemoryContext &addressSpace)
+        : context(addressSpace)
+    {}
+
+    HostNativeQueueCore(const HostNativeQueueCore &) = delete;
+    HostNativeQueueCore &operator=(const HostNativeQueueCore &) = delete;
+
+    bool registerQueue(const Config &newConfig);
+    bool publish(Addr packetVa, const uint8_t *bytes, size_t byteCount,
+                 uint64_t requestId = 0);
+    bool ring(uint64_t newWriteIndex, uint32_t &registeredIndex);
+    bool fetch(FetchedPacket &packet,
+               GPUDispatchLifecycleListener *listener = nullptr,
+               uint64_t requestId = 0);
+    bool acceptDispatch(uint64_t ticket);
+    bool cancelFetch(uint64_t ticket);
+    bool unregisterQueue();
+
+    bool isRegistered() const { return registered; }
+    const Config &config() const { return queueConfig; }
+    uint64_t writeIndex() const { return writeIdx; }
+    uint64_t fetchIndex() const { return fetchIdx; }
+    uint64_t readIndex() const { return readIdx; }
+    uint64_t dispatchIndex() const { return dispatchIdx; }
+    bool hostReadIndexUpdated() const { return false; }
+    bool ownsPending(const FetchedPacket &packet) const;
+    uint32_t registeredIndex() const { return regdIndex; }
+    const char *failure() const { return failureReason.c_str(); }
+
+    static bool packetAddress(Addr baseVa, uint64_t index, uint32_t depth,
+                              Addr &address);
+
+  private:
+    struct Slot
+    {
+        std::array<uint8_t, PacketBytes> bytes = {};
+        Addr hostPacketVa = 0;
+        bool published = false;
+        bool fetched = false;
+    };
+
+    bool fail(const char *reason);
+    bool validRegistration(const Config &candidate) const;
+    bool queueHasSpace(uint64_t candidateWrite) const;
+    bool nextIndex(uint64_t value, uint64_t &next) const;
+    void reset();
+
+    HostNativeMemoryContext &context;
+    Config queueConfig;
+    std::vector<Slot> slots;
+    std::optional<FetchedPacket> pending;
+    std::string failureReason = "none";
+    uint64_t writeIdx = 0;
+    uint64_t fetchIdx = 0;
+    uint64_t readIdx = 0;
+    uint64_t dispatchIdx = 0;
+    uint64_t nextTicket = 1;
+    uint32_t regdIndex = 0;
+    bool registered = false;
+};
+
+} // namespace hostgpu
+} // namespace gem5

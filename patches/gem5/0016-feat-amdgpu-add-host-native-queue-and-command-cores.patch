+#include "dev/amdgpu/host_gpu_native_command_processor_core.hh"
+
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include <limits>
+#include <new>
+#include <vector>
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+bool
+HostNativeCommandProcessorCore::fail(const char *reason)
+{
+    failureReason = reason;
+    return false;
+}
+
+bool
+HostNativeCommandProcessorCore::checkedEntryAddress(
+    Addr descriptor, int64_t offset, Addr &entry)
+{
+    if (offset >= 0) {
+        const auto positive = static_cast<uint64_t>(offset);
+        if (descriptor > std::numeric_limits<Addr>::max() - positive)
+            return false;
+        entry = descriptor + positive;
+        return true;
+    }
+
+    /* Avoid overflowing when offset is INT64_MIN. */
+    const uint64_t magnitude = static_cast<uint64_t>(-(offset + 1)) + 1;
+    if (descriptor < magnitude)
+        return false;
+    entry = descriptor - magnitude;
+    return true;
+}
+
+std::string
+HostNativeCommandProcessorCore::kernelName(
+    const protocol::CodeObjectManifest &manifest)
+{
+    const auto end = std::find(
+        manifest.kernelName.begin(), manifest.kernelName.end(), uint8_t(0));
+    return std::string(manifest.kernelName.begin(), end);
+}
+
+bool
+HostNativeCommandProcessorCore::packetFieldsValid(
+    const _hsa_dispatch_packet_t &packet)
+{
+    constexpr uint16_t PinnedDispatchHeader = 0x1402;
+    if (packet.header != PinnedDispatchHeader || packet.setup != 1 ||
+        packet.reserved0 != 0 || packet.reserved1 != 0 ||
+        packet.workgroup_size_x == 0 || packet.workgroup_size_y == 0 ||
+        packet.workgroup_size_z == 0 || packet.grid_size_x == 0 ||
+        packet.grid_size_y == 0 || packet.grid_size_z == 0 ||
+        packet.grid_size_x < packet.workgroup_size_x ||
+        packet.grid_size_y < packet.workgroup_size_y ||
+        packet.grid_size_z < packet.workgroup_size_z ||
+        packet.workgroup_size_y != 1 || packet.workgroup_size_z != 1 ||
+        packet.grid_size_y != 1 || packet.grid_size_z != 1 ||
+        packet.kernel_object == 0 || packet.kernarg_address == 0) {
+        return false;
+    }
+    return (packet.kernel_object & 63) == 0 &&
+        (packet.kernarg_address & 7) == 0;
+}
+
+bool
+HostNativeCommandProcessorCore::readMqd(
+    const HostNativeQueueCore &queueCore,
+    HostNativeMemoryContext &context, Result &result, uint64_t requestId)
+{
+    static_assert(sizeof(_amd_queue_t) == 256,
+                  "native MQD layout must remain the locked 256-byte ABI");
+    static_assert(offsetof(_amd_queue_t, read_dispatch_id) == 128,
+                  "native MQD read-dispatch offset changed");
+    static_assert(
+        offsetof(_amd_queue_t,
+                 read_dispatch_id_field_base_byte_offset) == 136,
+        "native MQD read-dispatch-offset field changed");
+    const auto &queue = queueCore.config();
+    if (queue.hostReadIndexVa < sizeof(uint64_t))
+        return fail("MQD read-index address underflow");
+    const Addr offsetAddress = queue.hostReadIndexVa + sizeof(uint64_t);
+    if (offsetAddress < queue.hostReadIndexVa)
+        return fail("MQD offset address overflow");
+
+    uint32_t readDispatchOffset = 0;
+    if (!context.functionalRead(
+            offsetAddress, &readDispatchOffset,
+            sizeof(readDispatchOffset), requestId)) {
+        return fail("MQD read-dispatch offset read");
+    }
+    if (readDispatchOffset != offsetof(_amd_queue_t, read_dispatch_id) ||
+        readDispatchOffset > queue.hostReadIndexVa) {
+        return fail("MQD read-dispatch offset mismatch");
+    }
+
+    result.mqdBaseVa = queue.hostReadIndexVa - readDispatchOffset;
+    if (!context.functionalRead(
+            result.mqdBaseVa, &result.mqd, sizeof(result.mqd), requestId)) {
+        return fail("MQD functional read");
+    }
+    result.mqdRead = true;
+    const Addr queueBase = reinterpret_cast<Addr>(
+        result.mqd.hsa_queue.base_address);
+    if (result.mqd.hsa_queue.type != _HSA_QUEUE_TYPE_MULTI ||
+        result.mqd.hsa_queue.id != queue.activeQueueId ||
+        queueBase != queue.baseVa ||
+        result.mqd.hsa_queue.size !=
+            queue.queueBytes / HostNativeQueueCore::PacketBytes ||
+        result.mqd.read_dispatch_id != queueCore.readIndex() ||
+        result.mqd.write_dispatch_id != queueCore.writeIndex()) {
+        return fail("MQD queue identity mismatch");
+    }
+    return true;
+}
+
+bool
+HostNativeCommandProcessorCore::validateDescriptor(
+    const HostNativeCodeObjectMapper::Mapping &mapping,
+    const protocol::CodeObjectManifest &manifest,
+    HostNativeMemoryContext &context, Result &result, uint64_t requestId)
+{
+    if (!mapping.valid() || (mapping.descriptorGpuVa & 63) != 0 ||
+        manifest.gfxTarget != 950 ||
+        manifest.relocationCount != 0 || manifest.descriptorSize != 64 ||
+        manifest.kernargSegmentSize == 0) {
+        return fail("invalid code-object admission metadata");
+    }
+    if (!context.functionalRead(
+            mapping.descriptorGpuVa, &result.descriptor,
+            sizeof(result.descriptor), requestId)) {
+        return fail("descriptor functional read");
+    }
+    result.descriptorRead = true;
+
+    std::array<uint8_t, protocol::CodeObjectDescriptorBytes> bytes = {};
+    std::memcpy(bytes.data(), &result.descriptor, bytes.size());
+    if (!std::equal(bytes.begin(), bytes.end(), manifest.descriptor.begin()) ||
+        result.descriptor.kernarg_size != manifest.kernargSegmentSize ||
+        result.descriptor.group_segment_fixed_size !=
+            manifest.groupSegmentFixedSize ||
+        result.descriptor.private_segment_fixed_size !=
+            manifest.privateSegmentFixedSize ||
+        result.descriptor.kernel_code_entry_byte_offset !=
+            manifest.kernelCodeEntryByteOffset ||
+        result.descriptor.kernarg_preload_spec_length != 0 ||
+        result.descriptor.kernarg_preload_spec_offset != 0 ||
+        result.descriptor.wgp_mode || result.descriptor.mem_ordered ||
+        result.descriptor.fwd_progress) {
+        return fail("descriptor manifest mismatch");
+    }
+
+    Addr entry = 0;
+    if (!checkedEntryAddress(
+            mapping.descriptorGpuVa,
+            result.descriptor.kernel_code_entry_byte_offset, entry) ||
+        entry != mapping.entryGpuVa || entry != mapping.codeGpuVa) {
+        return fail("descriptor entry relation");
+    }
+    result.descriptorEntryRelation = true;
+    return true;
+}
+
+bool
+HostNativeCommandProcessorCore::submit(
+    const HostNativeQueueCore::FetchedPacket &fetched,
+    HostNativeQueueCore &queueCore,
+    const HostNativeCodeObjectMapper::Mapping &mapping,
+    const protocol::CodeObjectManifest &manifest,
+    HostNativeMemoryContext &context, uint64_t dispatchId, Result &result,
+    GPUDispatchLifecycleListener *listener, uint64_t requestId)
+{
+    failureReason = "none";
+    result.reset();
+    const auto &queue = queueCore.config();
+    if (!fetched.valid() || fetched.bytes.size() != 64 ||
+        !queueCore.isRegistered() || queue.generation == 0 ||
+        dispatchId == 0 || dispatchId > INT_MAX) {
+        return fail("invalid native CP submission input");
+    }
+    Addr expectedPacketVa = 0;
+    const uint32_t depth =
+        queue.queueBytes / HostNativeQueueCore::PacketBytes;
+    if (!queueCore.ownsPending(fetched) ||
+        fetched.activeQueueId != queue.activeQueueId ||
+        fetched.queueGeneration != queue.generation ||
+        fetched.registeredIndex != queue.registeredIndex ||
+        fetched.queueIndex != queueCore.dispatchIndex() ||
+        !HostNativeQueueCore::packetAddress(
+            queue.baseVa, fetched.queueIndex, depth, expectedPacketVa) ||
+        fetched.hostPacketVa != expectedPacketVa) {
+        return fail("fetched packet queue identity mismatch");
+    }
+    result.registeredIndex = queue.registeredIndex;
+    _hsa_dispatch_packet_t fetchedPacket = {};
+    std::memcpy(&fetchedPacket, fetched.bytes.data(), sizeof(fetchedPacket));
+    if (!packetFieldsValid(fetchedPacket)) {
+        return fail("invalid kernel dispatch packet");
+    }
+    result.packet = fetchedPacket;
+    if (result.packet.kernel_object != mapping.descriptorGpuVa)
+        return fail("packet descriptor address mismatch");
+
+    if (!validateDescriptor(mapping, manifest, context, result, requestId))
+        return false;
+
+    std::vector<uint8_t> kernarg;
+    if (!context.functionalRead(
+            result.packet.kernarg_address, manifest.kernargSegmentSize,
+            kernarg, requestId) ||
+        kernarg.size() != manifest.kernargSegmentSize) {
+        return fail("kernarg functional read");
+    }
+    result.kernargRead = true;
+
+    if (result.packet.completion_signal != 0) {
+        uint64_t signalObjectWord = 0;
+        if (!context.functionalRead(
+                result.packet.completion_signal, &signalObjectWord,
+                sizeof(signalObjectWord), requestId) ||
+                signalObjectWord == 0) {
+            return fail("completion signal object range read");
+        }
+        result.completionSignalObjectRead = true;
+    }
+
+    if (!readMqd(queueCore, context, result, requestId))
+        return false;
+
+    if (!checkedEntryAddress(
+            result.packet.kernel_object,
+            result.descriptor.kernel_code_entry_byte_offset,
+            result.machineCodeVa)) {
+        return fail("machine code address overflow");
+    }
+
+    const std::string manifestName = kernelName(manifest);
+    const std::string name = manifestName.empty() ?
+        std::string("gpuReadWrite") : manifestName;
+    try {
+        result.task.emplace(
+            name, queue.registeredIndex,
+            static_cast<int>(dispatchId), &result.packet, &result.descriptor,
+            fetched.hostPacketVa, result.machineCodeVa,
+            GfxVersion::gfx950);
+    } catch (const std::bad_alloc &) {
+        return fail("HSAQueueEntry allocation");
+    }
+    result.task->hostAMDQueueAddr = result.mqdBaseVa;
+    result.task->amdQueue = result.mqd;
+    if (!queueCore.acceptDispatch(fetched.ticket)) {
+        result.task.reset();
+        return fail("queue dispatch acceptance");
+    }
+    result.taskValid = true;
+    if (listener)
+        listener->commandProcessorSubmitted(*result.task);
+    result.commandProcessorSubmitted = true;
+    result.kernelExecuted = false;
+    return true;
+}
+
+} // namespace hostgpu
+} // namespace gem5

diff --git a/src/dev/amdgpu/SConscript b/src/dev/amdgpu/SConscript
index 762faa715..1a83ea141 100644
--- a/src/dev/amdgpu/SConscript
+++ b/src/dev/amdgpu/SConscript
@@ -82,6 +82,26 @@ Executable('host_gpu_native_dispatch_admission_core',
            'host_gpu_memory_state.cc',
            'host_gpu_queue_state.cc')
 
+# CP19/B1 extracted queue and command-processor core.  This target publishes
+# one 64-byte AQL packet, fetches it through the host-owned address space, and
+# performs descriptor/MQD/kernarg admission only.  Every source is explicit so
+# no legacy HSAPP, DMA, dispatcher, CU, System, or ISA object can enter the
+# link closure.
+Executable('host_gpu_native_b1_core',
+           Source('host_gpu_native_b1_main.cc',
+                  append={'CPPDEFINES': ['GEM5_HOST_NATIVE_NO_ISA']}),
+           'host_gpu_native_queue_core.cc',
+           Source('host_gpu_native_command_processor_core.cc',
+                  append={'CPPDEFINES': ['GEM5_HOST_NATIVE_NO_ISA']}),
+           Source('host_gpu_native_dispatch_admission.cc',
+                  append={'CPPDEFINES': ['GEM5_HOST_NATIVE_NO_ISA']}),
+           'host_native_code_object_mapper.cc',
+           'host_native_memory_context.cc',
+           'host_gpu_code_object_image.cc',
+           'host_gpu_code_object_state.cc',
+           'host_gpu_protocol.cc',
+           'host_gpu_memory_state.cc')
+
 if not env['CONF']['USE_X86_ISA']:
     Return()
 

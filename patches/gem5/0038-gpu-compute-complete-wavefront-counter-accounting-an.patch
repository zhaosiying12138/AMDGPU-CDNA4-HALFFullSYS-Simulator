+/**
+ * Nothing that a workgroup dispatch waits for can change while every compute
+ * unit is idle. Wavefront slots, the group segment chunk, the barrier slot
+ * and the register regions are all released by s_endpgm, which needs a
+ * resident wavefront to execute; and exec() is only re-armed by a workgroup
+ * completion, a completed cache invalidate, or a newly enqueued kernel.
+ *
+ * So a kernel that cannot place a single workgroup on an idle device is not
+ * waiting -- it is stuck, permanently and silently. The observed shape is a
+ * simulator that keeps advancing simulated time at full host CPU with zero
+ * retired instructions while the host waits for a completion signal that can
+ * never arrive.
+ *
+ * Fail closed instead, and print the exact demand next to the exact capacity.
+ * The cause is a workgroup that asks for more of some resource than one
+ * compute unit provides -- most often a compute unit configured smaller than
+ * the device the runtime advertised to the compiler -- or a resource that a
+ * completed workgroup failed to release.
+ */
+void
+GPUDispatcher::failStalledDispatch(const std::vector<int> &blocked_ids)
+{
+    if (blocked_ids.empty()) {
+        return;
+    }
+
+    for (int i_cu = 0; i_cu < shader->n_cu; ++i_cu) {
+        if (shader->cuList[i_cu]->activeWaves) {
+            return;
+        }
+    }
+
+    std::string report;
+    for (int kern_id : blocked_ids) {
+        auto task_iter = hsaQueueEntries.find(kern_id);
+        if (task_iter == hsaQueueEntries.end()) {
+            continue;
+        }
+        for (int i_cu = 0; i_cu < shader->n_cu; ++i_cu) {
+            report += "\n  " + shader->cuList[i_cu]
+                ->dispatchResourceReport(task_iter->second);
+        }
+    }
+
+    panic("GPU dispatch deadlock: %d kernel(s) have workgroups left to "
+          "dispatch, no compute unit has a resident wavefront, and no "
+          "workgroup fits. No later event can change this.%s",
+          blocked_ids.size(), report);
+}

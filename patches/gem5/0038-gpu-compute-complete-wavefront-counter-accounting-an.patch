+/*
+ * These three counters are the wave's outstanding vmcnt/expcnt/lgkmcnt, so
+ * none of them may go negative. An underflow means one instruction was
+ * retired twice, which lets a later s_waitcnt fall through while its data is
+ * still in flight and permanently blocks the dependent register. The
+ * complementary failure -- an increment with no matching release -- is not
+ * detectable here, but it is what a hung `s_waitcnt` in the progress dump
+ * shows, so both halves of every pair are worth checking together.
+ */
 void
 Wavefront::decVMemInstsIssued()
 {
+    panic_if(vmemInstsIssued <= 0,
+             "CU%d: WF[%d][%d] wave[%d] kernel %d retired a VMEM "
+             "instruction that was not outstanding (count %d)",
+             computeUnit->cu_id, simdId, wfSlotId, (int)wfDynId, kernId,
+             vmemInstsIssued);
     --vmemInstsIssued;
 }
 
 void
 Wavefront::decExpInstsIssued()
 {
+    panic_if(expInstsIssued <= 0,
+             "CU%d: WF[%d][%d] wave[%d] kernel %d retired an EXP "
+             "instruction that was not outstanding (count %d)",
+             computeUnit->cu_id, simdId, wfSlotId, (int)wfDynId, kernId,
+             expInstsIssued);
     --expInstsIssued;
 }
 

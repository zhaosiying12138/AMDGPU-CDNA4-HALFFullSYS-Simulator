+/**
+ * Create a retained evidence file that no other writer can already own.
+ *
+ * Evidence carries kernel bytes and descriptors, so the parent must be a
+ * private directory of this user and the file must be newly created.
+ */
+int
+createExclusiveEvidenceFile(const std::string &path)
+{
+    const size_t separator = path.rfind('/');
+    const std::string directory = separator == 0 ? "/" :
+        path.substr(0, separator);
+    const std::string basename = path.substr(separator + 1);
+    if (basename.empty() || basename == "." || basename == "..") {
+        errno = EINVAL;
+        return -1;
+    }
+    const int parent = openDirectoryNoSymlinks(directory);
+    if (parent < 0)
+        return -1;
+    struct stat parentStat = {};
+    if (::fstat(parent, &parentStat) != 0 ||
+        !S_ISDIR(parentStat.st_mode) || parentStat.st_uid != ::geteuid() ||
+        (parentStat.st_mode & (S_IRWXG | S_IRWXO)) != 0) {
+        const int savedErrno = errno != 0 ? errno : EPERM;
+        ::close(parent);
+        errno = savedErrno;
+        return -1;
+    }
+    const int fd = ::openat(parent, basename.c_str(),
+        O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    const int savedErrno = errno;
+    ::close(parent);
+    if (fd < 0) {
+        errno = savedErrno;
+        return -1;
+    }
+    struct stat fileStat = {};
+    if (::fstat(fd, &fileStat) != 0 || !S_ISREG(fileStat.st_mode) ||
+        fileStat.st_uid != ::geteuid() || (fileStat.st_mode & 0777) != 0600) {
+        const int invalidErrno = errno != 0 ? errno : EPERM;
+        ::close(fd);
+        errno = invalidErrno;
+        return -1;
+    }
+    return fd;
+}

+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "dev/amdgpu/host_gpu_bridge_tape.hh"
+
+#include <sys/uio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+#include <limits>
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+namespace
+{
+
+void
+storeBigEndian(uint8_t *destination, uint64_t value, size_t width)
+{
+    for (size_t index = 0; index < width; ++index) {
+        destination[index] = static_cast<uint8_t>(
+            value >> ((width - index - 1) * 8));
+    }
+}
+
+} // anonymous namespace
+
+HostGPUBridgeTape::~HostGPUBridgeTape()
+{
+    close();
+}
+
+std::array<uint8_t, HostGPUBridgeTape::FileHeaderBytes>
+HostGPUBridgeTape::encodeFileHeader(const Identity &identity)
+{
+    std::array<uint8_t, FileHeaderBytes> header = {};
+    std::memcpy(header.data(), Magic.data(), Magic.size());
+    storeBigEndian(header.data() + 8, FormatMajor, 2);
+    storeBigEndian(header.data() + 10, FormatMinor, 2);
+    storeBigEndian(header.data() + 12, FileHeaderBytes, 2);
+    storeBigEndian(header.data() + 14, RecordHeaderBytes, 2);
+    storeBigEndian(header.data() + 16, identity.tickFrequencyHz, 8);
+    storeBigEndian(header.data() + 24, identity.epoch, 8);
+    storeBigEndian(header.data() + 32, identity.rank, 4);
+    storeBigEndian(header.data() + 36, identity.worldSize, 4);
+    storeBigEndian(header.data() + 40, identity.maximumRecord, 4);
+    std::memcpy(header.data() + 48, identity.daemonUuid.data(),
+                identity.daemonUuid.size());
+    std::memcpy(header.data() + 64, identity.jobUuid.data(),
+                identity.jobUuid.size());
+    return header;
+}
+
+std::array<uint8_t, HostGPUBridgeTape::RecordHeaderBytes>
+HostGPUBridgeTape::encodeRecordHeader(
+    Direction direction, bool carrier, int clientFd, uint64_t generation,
+    uint64_t sequence, uint64_t simulatedTick, uint64_t monotonicNs,
+    uint32_t recordBytes)
+{
+    std::array<uint8_t, RecordHeaderBytes> header = {};
+    header[0] = static_cast<uint8_t>(direction);
+    header[1] = carrier ? 1 : 0;
+    storeBigEndian(header.data() + 4, static_cast<uint32_t>(clientFd), 4);
+    storeBigEndian(header.data() + 8, recordBytes, 4);
+    storeBigEndian(header.data() + 16, generation, 8);
+    storeBigEndian(header.data() + 24, sequence, 8);
+    storeBigEndian(header.data() + 32, simulatedTick, 8);
+    storeBigEndian(header.data() + 40, monotonicNs, 8);
+    return header;
+}
+
+uint64_t
+HostGPUBridgeTape::monotonicNanoseconds()
+{
+    timespec now = {};
+    if (::clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return 0;
+    return static_cast<uint64_t>(now.tv_sec) * 1000000000ULL +
+        static_cast<uint64_t>(now.tv_nsec);
+}
+
+bool
+HostGPUBridgeTape::adopt(int fd, const Identity &identity)
+{
+    if (fd < 0) {
+        errno = EBADF;
+        return false;
+    }
+    if (descriptor >= 0) {
+        ::close(fd);
+        errno = EBUSY;
+        return false;
+    }
+    const auto header = encodeFileHeader(identity);
+    descriptor = fd;
+    if (!writeAll(header.data(), header.size(), nullptr, 0)) {
+        const int savedErrno = failureErrno;
+        close();
+        errno = savedErrno;
+        return false;
+    }
+    return true;
+}
+
+bool
+HostGPUBridgeTape::append(Direction direction, int clientFd,
+                          uint64_t generation, uint64_t simulatedTick,
+                          bool carrier, const uint8_t *bytes, size_t length)
+{
+    if (descriptor < 0 || length > std::numeric_limits<uint32_t>::max() ||
+        (length != 0 && bytes == nullptr)) {
+        ++droppedRecords;
+        return false;
+    }
+    const auto header = encodeRecordHeader(
+        direction, carrier, clientFd, generation, sequence + 1, simulatedTick,
+        monotonicNanoseconds(), static_cast<uint32_t>(length));
+    if (!writeAll(header.data(), header.size(), bytes, length)) {
+        ++droppedRecords;
+        return false;
+    }
+    ++sequence;
+    ++appendedRecords;
+    return true;
+}
+
+void
+HostGPUBridgeTape::close()
+{
+    if (descriptor < 0)
+        return;
+    ::close(descriptor);
+    descriptor = -1;
+}
+
+bool
+HostGPUBridgeTape::writeAll(const uint8_t *header, size_t headerBytes,
+                            const uint8_t *bytes, size_t length)
+{
+    iovec vectors[2] = {};
+    size_t count = 1;
+    vectors[0].iov_base = const_cast<uint8_t *>(header);
+    vectors[0].iov_len = headerBytes;
+    if (length != 0) {
+        vectors[1].iov_base = const_cast<uint8_t *>(bytes);
+        vectors[1].iov_len = length;
+        count = 2;
+    }
+
+    size_t index = 0;
+    while (index < count) {
+        const ssize_t written = ::writev(
+            descriptor, &vectors[index], static_cast<int>(count - index));
+        if (written < 0) {
+            if (errno == EINTR)
+                continue;
+            failureErrno = errno;
+            close();
+            return false;
+        }
+        if (written == 0) {
+            failureErrno = ENOSPC;
+            close();
+            return false;
+        }
+        size_t remaining = static_cast<size_t>(written);
+        while (index < count && remaining >= vectors[index].iov_len) {
+            remaining -= vectors[index].iov_len;
+            ++index;
+        }
+        if (index < count && remaining != 0) {
+            vectors[index].iov_base =
+                static_cast<uint8_t *>(vectors[index].iov_base) + remaining;
+            vectors[index].iov_len -= remaining;
+        }
+    }
+    return true;
+}
+
+} // namespace hostgpu
+} // namespace gem5

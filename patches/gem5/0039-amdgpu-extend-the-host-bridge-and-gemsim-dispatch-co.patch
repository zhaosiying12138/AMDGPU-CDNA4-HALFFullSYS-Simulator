+#ifndef __DEV_AMDGPU_HOST_GPU_BRIDGE_TAPE_HH__
+#define __DEV_AMDGPU_HOST_GPU_BRIDGE_TAPE_HH__
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Append-only binary log of complete bridge wire records.
+ *
+ * A model kernel failure is only reached after hours of weight load and
+ * prefill, so the traffic that produced it has to be recoverable without
+ * repeating the run.  The dispatch trace records descriptors, never bytes, and
+ * therefore cannot reconstruct an execution; this tape stores the exact bytes
+ * of every record the bridge accepted and every record it fully transmitted,
+ * in wire order, together with the simulated tick and the host monotonic
+ * timestamp observed at that moment.
+ *
+ * The tape is a pure observer.  It never inspects, filters, or interprets a
+ * record, so it stays valid across every protocol revision and cannot become
+ * an operator- or kernel-specific facility.
+ *
+ * Records are written with a single writev and are never buffered in user
+ * space: a simulator panic must leave every record up to the failure durable
+ * in the page cache.  Deliberately no fsync, because per-record durability
+ * against a host power loss is not worth the cost of a long model run.
+ *
+ * Scalars use the big-endian order of the bridge wire contract.
+ *
+ * File header, @ref FileHeaderBytes bytes:
+ *
+ *     0  magic                8   "GSBRTAPE"
+ *     8  format_major         2
+ *    10  format_minor         2
+ *    12  file_header_bytes    2
+ *    14  record_header_bytes  2
+ *    16  tick_frequency_hz    8
+ *    24  epoch                8
+ *    32  rank                 4
+ *    36  world_size           4
+ *    40  maximum_record       4
+ *    44  reserved             4
+ *    48  daemon_uuid         16
+ *    64  job_uuid            16
+ *
+ * Record header, @ref RecordHeaderBytes bytes, followed by record_bytes of
+ * unmodified wire payload:
+ *
+ *     0  direction            1
+ *     1  carrier              1
+ *     2  flags                2
+ *     4  client_fd            4
+ *     8  record_bytes         4
+ *    12  reserved             4
+ *    16  generation           8
+ *    24  sequence             8
+ *    32  simulated_tick       8
+ *    40  monotonic_ns         8
+ */
+class HostGPUBridgeTape
+{
+  public:
+    enum class Direction : uint8_t
+    {
+        /** Client to bridge, exactly as accepted from the endpoint. */
+        Ingress = 0,
+        /** Bridge to client, exactly as fully transmitted to the endpoint. */
+        Egress = 1,
+    };
+
+    /** Run identity a replay driver needs before it can interpret records. */
+    struct Identity
+    {
+        uint64_t tickFrequencyHz = 0;
+        uint64_t epoch = 0;
+        uint32_t rank = 0;
+        uint32_t worldSize = 0;
+        uint32_t maximumRecord = 0;
+        std::array<uint8_t, 16> daemonUuid = {};
+        std::array<uint8_t, 16> jobUuid = {};
+    };
+
+    static constexpr size_t MagicBytes = 8;
+    static constexpr size_t FileHeaderBytes = 80;
+    static constexpr size_t RecordHeaderBytes = 48;
+    static constexpr uint16_t FormatMajor = 1;
+    static constexpr uint16_t FormatMinor = 0;
+    static constexpr std::array<uint8_t, MagicBytes> Magic = {
+        'G', 'S', 'B', 'R', 'T', 'A', 'P', 'E'};
+
+    HostGPUBridgeTape() = default;
+    ~HostGPUBridgeTape();
+
+    HostGPUBridgeTape(const HostGPUBridgeTape &) = delete;
+    HostGPUBridgeTape &operator=(const HostGPUBridgeTape &) = delete;
+
+    static std::array<uint8_t, FileHeaderBytes> encodeFileHeader(
+        const Identity &identity);
+    static std::array<uint8_t, RecordHeaderBytes> encodeRecordHeader(
+        Direction direction, bool carrier, int clientFd, uint64_t generation,
+        uint64_t sequence, uint64_t simulatedTick, uint64_t monotonicNs,
+        uint32_t recordBytes);
+
+    /** Host monotonic sample correlating the tape with external host logs. */
+    static uint64_t monotonicNanoseconds();
+
+    /**
+     * Take ownership of an already created empty file and write the header.
+     * On failure the descriptor is closed and errno describes the cause.
+     */
+    bool adopt(int fd, const Identity &identity);
+
+    /**
+     * Append one complete wire record.  A write error tears the tape, so the
+     * descriptor is closed and every later record is counted as dropped rather
+     * than producing a log that silently looks continuous.
+     */
+    bool append(Direction direction, int clientFd, uint64_t generation,
+                uint64_t simulatedTick, bool carrier, const uint8_t *bytes,
+                size_t length);
+
+    void close();
+
+    bool enabled() const { return descriptor >= 0; }
+    uint64_t appended() const { return appendedRecords; }
+    uint64_t dropped() const { return droppedRecords; }
+    int failure() const { return failureErrno; }
+
+  private:
+    bool writeAll(const uint8_t *header, size_t headerBytes,
+                  const uint8_t *bytes, size_t length);
+
+    int descriptor = -1;
+    uint64_t sequence = 0;
+    uint64_t appendedRecords = 0;
+    uint64_t droppedRecords = 0;
+    int failureErrno = 0;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_BRIDGE_TAPE_HH__

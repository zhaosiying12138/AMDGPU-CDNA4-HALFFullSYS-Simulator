+
+#include "gtest/gtest.h"
+
+namespace gem5::hostgpu
+{
+
+namespace
+{
+
+static_assert(!std::is_copy_constructible_v<HostGPUBridgeTape>);
+static_assert(!std::is_copy_assignable_v<HostGPUBridgeTape>);
+
+uint64_t
+loadBigEndian(const std::vector<uint8_t> &bytes, size_t offset, size_t width)
+{
+    uint64_t value = 0;
+    for (size_t index = 0; index < width; ++index)
+        value = (value << 8) | bytes[offset + index];
+    return value;
+}
+
+HostGPUBridgeTape::Identity sampleIdentity()
+{
+    HostGPUBridgeTape::Identity identity;
+    identity.tickFrequencyHz = 1000000000000ULL;
+    identity.epoch = 0x0102030405060708ULL;
+    identity.rank = 3;
+    identity.worldSize = 16;
+    identity.maximumRecord = 65536;
+    identity.daemonUuid.fill(0xa5);
+    identity.jobUuid.fill(0x5a);
+    return identity;
+}
+
+class TemporaryTape
+{
+  public:
+    TemporaryTape()
+    {
+        char pattern[] = "/tmp/host_gpu_bridge_tape.XXXXXX";
+        descriptor = ::mkstemp(pattern);
+        path = pattern;
+    }
+
+    ~TemporaryTape()
+    {
+        if (descriptor >= 0)
+            ::close(descriptor);
+        ::unlink(path.c_str());
+    }
+
+    int release()
+    {
+        const int fd = descriptor;
+        descriptor = -1;
+        return fd;
+    }
+
+    std::vector<uint8_t> contents() const
+    {
+        std::vector<uint8_t> bytes;
+        const int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+        EXPECT_GE(fd, 0);
+        if (fd < 0)
+            return bytes;
+        uint8_t buffer[4096];
+        ssize_t received = 0;
+        while ((received = ::read(fd, buffer, sizeof(buffer))) > 0)
+            bytes.insert(bytes.end(), buffer, buffer + received);
+        ::close(fd);
+        return bytes;
+    }
+
+  private:
+    int descriptor = -1;
+    std::string path;
+};
+
+TEST(HostGPUBridgeTape, FileHeaderCarriesRunIdentity)
+{
+    const auto header = HostGPUBridgeTape::encodeFileHeader(sampleIdentity());
+    const std::vector<uint8_t> bytes(header.begin(), header.end());
+    ASSERT_EQ(bytes.size(), HostGPUBridgeTape::FileHeaderBytes);
+    EXPECT_EQ(std::memcmp(bytes.data(), HostGPUBridgeTape::Magic.data(),
+                          HostGPUBridgeTape::Magic.size()), 0);
+    EXPECT_EQ(loadBigEndian(bytes, 8, 2), HostGPUBridgeTape::FormatMajor);
+    EXPECT_EQ(loadBigEndian(bytes, 10, 2), HostGPUBridgeTape::FormatMinor);
+    EXPECT_EQ(loadBigEndian(bytes, 12, 2),
+              HostGPUBridgeTape::FileHeaderBytes);
+    EXPECT_EQ(loadBigEndian(bytes, 14, 2),
+              HostGPUBridgeTape::RecordHeaderBytes);
+    EXPECT_EQ(loadBigEndian(bytes, 16, 8), 1000000000000ULL);
+    EXPECT_EQ(loadBigEndian(bytes, 24, 8), 0x0102030405060708ULL);
+    EXPECT_EQ(loadBigEndian(bytes, 32, 4), 3u);
+    EXPECT_EQ(loadBigEndian(bytes, 36, 4), 16u);
+    EXPECT_EQ(loadBigEndian(bytes, 40, 4), 65536u);
+    EXPECT_EQ(loadBigEndian(bytes, 44, 4), 0u);
+    for (size_t index = 0; index < 16; ++index) {
+        EXPECT_EQ(bytes[48 + index], 0xa5);
+        EXPECT_EQ(bytes[64 + index], 0x5a);
+    }
+}
+
+TEST(HostGPUBridgeTape, RecordHeaderIsBigEndianAndFullyDefined)
+{
+    const auto header = HostGPUBridgeTape::encodeRecordHeader(
+        HostGPUBridgeTape::Direction::Egress, true, 11, 0x1122334455667788ULL,
+        7, 0x00000000deadbeefULL, 0x0000abcdefabcdefULL, 336);
+    const std::vector<uint8_t> bytes(header.begin(), header.end());
+    ASSERT_EQ(bytes.size(), HostGPUBridgeTape::RecordHeaderBytes);
+    EXPECT_EQ(bytes[0], 1);
+    EXPECT_EQ(bytes[1], 1);
+    EXPECT_EQ(loadBigEndian(bytes, 2, 2), 0u);
+    EXPECT_EQ(loadBigEndian(bytes, 4, 4), 11u);
+    EXPECT_EQ(loadBigEndian(bytes, 8, 4), 336u);
+    EXPECT_EQ(loadBigEndian(bytes, 12, 4), 0u);
+    EXPECT_EQ(loadBigEndian(bytes, 16, 8), 0x1122334455667788ULL);
+    EXPECT_EQ(loadBigEndian(bytes, 24, 8), 7u);
+    EXPECT_EQ(loadBigEndian(bytes, 32, 8), 0x00000000deadbeefULL);
+    EXPECT_EQ(loadBigEndian(bytes, 40, 8), 0x0000abcdefabcdefULL);
+}
+
+TEST(HostGPUBridgeTape, AppendsBothDirectionsInWireOrder)
+{
+    TemporaryTape file;
+    HostGPUBridgeTape tape;
+    ASSERT_TRUE(tape.adopt(file.release(), sampleIdentity()));
+    EXPECT_TRUE(tape.enabled());
+
+    const std::vector<uint8_t> request(96, 0x11);
+    const std::vector<uint8_t> response(48, 0x22);
+    EXPECT_TRUE(tape.append(HostGPUBridgeTape::Direction::Ingress, 9, 1, 4000,
+                            true, request.data(), request.size()));
+    EXPECT_TRUE(tape.append(HostGPUBridgeTape::Direction::Egress, 9, 1, 5000,
+                            false, response.data(), response.size()));
+    tape.close();
+    EXPECT_EQ(tape.appended(), 2u);
+    EXPECT_EQ(tape.dropped(), 0u);
+    EXPECT_EQ(tape.failure(), 0);
+
+    const std::vector<uint8_t> bytes = file.contents();
+    ASSERT_EQ(bytes.size(),
+              HostGPUBridgeTape::FileHeaderBytes +
+                  2 * HostGPUBridgeTape::RecordHeaderBytes + request.size() +
+                  response.size());
+
+    size_t offset = HostGPUBridgeTape::FileHeaderBytes;
+    EXPECT_EQ(bytes[offset], 0);
+    EXPECT_EQ(bytes[offset + 1], 1);
+    EXPECT_EQ(loadBigEndian(bytes, offset + 8, 4), request.size());
+    EXPECT_EQ(loadBigEndian(bytes, offset + 24, 8), 1u);
+    EXPECT_EQ(loadBigEndian(bytes, offset + 32, 8), 4000u);
+    EXPECT_NE(loadBigEndian(bytes, offset + 40, 8), 0u);
+    offset += HostGPUBridgeTape::RecordHeaderBytes;
+    EXPECT_EQ(std::memcmp(bytes.data() + offset, request.data(),
+                          request.size()), 0);
+
+    offset += request.size();
+    EXPECT_EQ(bytes[offset], 1);
+    EXPECT_EQ(bytes[offset + 1], 0);
+    EXPECT_EQ(loadBigEndian(bytes, offset + 8, 4), response.size());
+    EXPECT_EQ(loadBigEndian(bytes, offset + 24, 8), 2u);
+    EXPECT_EQ(loadBigEndian(bytes, offset + 32, 8), 5000u);
+    offset += HostGPUBridgeTape::RecordHeaderBytes;
+    EXPECT_EQ(std::memcmp(bytes.data() + offset, response.data(),
+                          response.size()), 0);
+}
+
+TEST(HostGPUBridgeTape, DisabledTapeDropsWithoutWriting)
+{
+    HostGPUBridgeTape tape;
+    const std::vector<uint8_t> record(16, 0x33);
+    EXPECT_FALSE(tape.enabled());
+    EXPECT_FALSE(tape.append(HostGPUBridgeTape::Direction::Ingress, 4, 1, 10,
+                             false, record.data(), record.size()));
+    EXPECT_EQ(tape.appended(), 0u);
+    EXPECT_EQ(tape.dropped(), 1u);
+}
+
+TEST(HostGPUBridgeTape, TornTapeStopsRecording)
+{
+    TemporaryTape file;
+    HostGPUBridgeTape tape;
+    ASSERT_TRUE(tape.adopt(file.release(), sampleIdentity()));
+
+    /* A read-only descriptor is the cheapest way to force a write error and
+     * prove that a failed record closes the tape instead of leaving a log
+     * that later looks continuous. */
+    const int readOnly = ::open("/dev/null", O_RDONLY | O_CLOEXEC);
+    ASSERT_GE(readOnly, 0);
+    HostGPUBridgeTape failing;
+    ASSERT_FALSE(failing.adopt(readOnly, sampleIdentity()));
+    EXPECT_FALSE(failing.enabled());
+    EXPECT_NE(failing.failure(), 0);
+
+    const std::vector<uint8_t> record(32, 0x44);
+    EXPECT_TRUE(tape.append(HostGPUBridgeTape::Direction::Ingress, 4, 1, 10,
+                            false, record.data(), record.size()));
+    EXPECT_EQ(tape.appended(), 1u);
+}

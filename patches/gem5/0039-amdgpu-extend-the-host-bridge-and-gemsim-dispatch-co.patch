+import argparse
+import os
+import time
+
+import m5
+from m5.defines import buildEnv
+from m5.objects import *
+from m5.util import addToPath, fatal
+
+addToPath("../../")
+
+from common import GPUTLBConfig, GPUTLBOptions, Options, Simulation
+from ruby import Ruby
+
+# Local data store per compute unit, in bytes. gfx950/CDNA4 has 160 KiB, and
+# that is what the model topology reports to the runtime as
+# "lds_size_in_kb 160". These two numbers must stay equal: the runtime tells
+# the compiler how much group segment a workgroup may take, and the simulator
+# has to be able to give it. The environment override exists only so a test
+# can pin the historical 65536 and show what a too-small compute unit does;
+# no run should set it.
+LDS_BYTES_PER_CU = int(os.environ.get("GEMSIM_LDS_BYTES_PER_CU", 160 * 1024))
+
+# Compute units the simulator provides.
+#
+# The topology this stack publishes advertises a full gfx950: simd_count
+# 1024 over simd_per_cu 4, i.e. 256 compute units, each with
+# max_waves_per_simd 8. gem5 built exactly one. That is not merely a slower
+# machine, it is a different one: a kernel whose forward progress depends on
+# several workgroups running at the same time cannot complete on it.
+#
+# AITER's split-K GEMM is such a kernel. One workgroup publishes a tile
+# counter and its peers poll it. With too few resident workgroups every
+# resident peer polls a flag whose producer was never scheduled, and the run
+# livelocks: scalar instructions retire forever, no wavefront completes, and
+# the host waits on a completion signal that can never arrive. This is the
+# same shape as the 64 KiB-versus-160 KiB group-segment defect -- the device
+# claiming a capability the simulator does not honour -- and it fails the
+# same silent way.
+#
+# The count is a knob because simulation cost scales with it and 256 is not
+# affordable; see docs/ and the capsule in tools/coop_capsule/ for the
+# measured cost per count. Whatever value is chosen below the advertised 256,
+# the mismatch is real: a kernel needing more co-resident workgroups than
+# NUM_COMPUTE_UNITS * (workgroups that fit in one CU) can still deadlock.
+NUM_COMPUTE_UNITS = int(os.environ.get("GEMSIM_NUM_COMPUTE_UNITS", 16))
+if NUM_COMPUTE_UNITS < 1:
+    raise SystemExit("GEMSIM_NUM_COMPUTE_UNITS must be >= 1")
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(
+        description="Pinned gfx950 AQL dispatch over the host GPU bridge"
+    )
+    Options.addCommonOptions(parser)
+    Ruby.define_options(parser)
+    GPUTLBOptions.tlb_options(parser)
+
+    parser.add_argument("--endpoint", required=True)
+    parser.add_argument("--dispatch-trace-path", required=True)
+    parser.add_argument(
+        "--bridge-tape-path",
+        default="",
+        help="Record every bridge wire record in both directions here",
+    )
+    parser.add_argument("--daemon-uuid", default="")
+    parser.add_argument("--job-uuid", default="")
+    parser.add_argument(
+        "--epoch", type=lambda value: int(value, 0), required=True
+    )
+    parser.add_argument("--rank", type=int, default=0)
+    parser.add_argument("--world-size", type=int, default=1)
+    parser.add_argument("--startup-timeout-ms", type=int, default=5000)
+    parser.add_argument("--handshake-timeout-ms", type=int, default=5000)
+    parser.add_argument("--max-record", type=int, default=65536)
+    parser.add_argument(
+        "--run-timeout-ms",
+        type=int,
+        default=30000,
+        help="Host wall-clock service window after startup",
+    )
+    parser.add_argument(
+        "--service-tick-quantum",
+        type=lambda value: int(value, 0),
+        default=1_000_000,
+        help="Maximum simulated ticks between host timeout checks",
+    )
+    parser.add_argument(
+        "--functional-fast",
+        action="store_true",
+        help=(
+            "Non-cycle-accurate functional fast mode (default off). Relaxes "
+            "timing-only parameters of the compute unit: memory request and "
+            "response pipeline latencies, issue period, ALU bypass depth and "
+            "operand network depth. Architectural results, dispatch "
+            "semantics, memory ordering, synchronization, completion and "
+            "failure behaviour are unchanged; simTicks and the per-dispatch "
+            "start/end ticks become meaningless and may never be cited for "
+            "any timing, TPOT or performance claim."
+        ),
+    )
+
+    parser.set_defaults(
+        cpu_type="X86TimingSimpleCPU",
+        num_cpus=1,
+        num_dirs=1,
+        mem_size="512MiB",
+        cacheline_size=64,
+    )
+    args = parser.parse_args()
+    if args.cpu_type != "X86TimingSimpleCPU" or args.num_cpus != 1:
+        fatal("host_dispatch.py requires one X86TimingSimpleCPU")
+    if args.num_dirs != 1 or args.cacheline_size != 64:
+        fatal("host_dispatch.py requires one directory and 64-byte lines")
+    if args.run_timeout_ms <= 0 or args.service_tick_quantum <= 0:
+        fatal("service timeout and tick quantum must be positive")
+    if not os.path.isabs(args.endpoint):
+        fatal("--endpoint must be absolute")
+    if not os.path.isabs(args.dispatch_trace_path):
+        fatal("--dispatch-trace-path must be absolute")
+    if args.bridge_tape_path and not os.path.isabs(args.bridge_tape_path):
+        fatal("--bridge-tape-path must be absolute")
+    return args
+
+
+def create_compute_unit(shader, cu_id, functional_fast=False):
+    cu = ComputeUnit(
+        cu_id=cu_id,
+        perLaneTLB=False,
+        num_SIMDs=4,
+        wf_size=64,
+        n_wf=shader.n_wf,
+        # The group segment a compute unit provides must be the one the
+        # runtime advertises, or a kernel the compiler was told it could
+        # build cannot be dispatched at all. The model topology publishes
+        # "lds_size_in_kb 160" per GPU node (see
+        # self-amdgpu-runtime/tools/hsakmt-model-topology.py), which is the
+        # gfx950/CDNA4 value; gem5's LdsState default is the older 64 KiB.
+        # With the smaller LDS a workgroup asking for more than 64 KiB never
+        # satisfies ComputeUnit::hasDispResources(), the dispatcher has no
+        # event left to retry it, and the run hangs with the simulator
+        # burning a core and the host waiting on a completion signal.
+        localDataStore=LdsState(
+            banks=32,
+            bankConflictPenalty=1,
+            size=LDS_BYTES_PER_CU,
+            range=AddrRange(LDS_BYTES_PER_CU),
+        ),
+    )
+
+    if functional_fast:
+        # Timing-only relaxation. In host-native mode every vector and scalar
+        # memory access is already serviced functionally by the native memory
+        # provider (ComputeUnit::sendRequest schedules the functional access
+        # behind resp_tick_latency; no Ruby transaction is generated), so the
+        # 50+50 cycle request/response pipeline is pure simulated delay that
+        # cannot influence the value read or written. Collapsing it removes
+        # the idle cycles the compute unit would otherwise tick through with
+        # every wave stalled on s_waitcnt, and with it the per-cycle
+        # scoreboard/fetch/schedule sweep that dominates host time.
+        #
+        # These are all ComputeUnit timing parameters. None of them selects an
+        # operand, an address, a lane mask, an execution order within a
+        # wavefront, or a completion condition.
+        cu.mem_req_latency = 1
+        cu.mem_resp_latency = 1
+        cu.scalar_mem_req_latency = 1
+        cu.scalar_mem_resp_latency = 1
+        cu.memtime_latency = 1
+        cu.issue_period = 1
+        cu.spbypass_pipe_length = 1
+        cu.dpbypass_pipe_length = 1
+        cu.rfc_pipe_length = 1
+        cu.operand_network_length = 1
+        cu.scalar_pipe_length = 1
+
+    wavefronts = []
+    vector_register_files = []
+    scalar_register_files = []
+    register_file_caches = []
+    vector_pool_managers = []
+    scalar_pool_managers = []
+    for simd_id in range(cu.num_SIMDs):
+        for slot_id in range(shader.n_wf):
+            wavefronts.append(
+                Wavefront(simdId=simd_id, wf_slot_id=slot_id, wf_size=64)
+            )
+        vector_register_files.append(
+            VectorRegisterFile(simd_id=simd_id, wf_size=64, num_regs=2048)
+        )
+        scalar_register_files.append(
+            ScalarRegisterFile(simd_id=simd_id, num_regs=2048)
+        )
+        register_file_caches.append(
+            RegisterFileCache(simd_id=simd_id, cache_size=0)
+        )
+        vector_pool_managers.append(
+            DynPoolManager(pool_size=2048, min_alloc=4)
+        )
+        scalar_pool_managers.append(
+            DynPoolManager(pool_size=2048, min_alloc=4)
+        )
+
+    cu.wavefronts = wavefronts
+    cu.vector_register_file = vector_register_files
+    cu.scalar_register_file = scalar_register_files
+    cu.register_file_cache = register_file_caches
+    cu.register_manager = RegisterManager(
+        policy="static",
+        vrf_pool_managers=vector_pool_managers,
+        srf_pool_managers=scalar_pool_managers,
+    )
+    cu.ldsPort = cu.ldsBus.cpu_side_port
+    cu.ldsBus.mem_side_port = cu.localDataStore.cuPort
+    return cu
+
+
+def create_system(args):
+    if buildEnv["PROTOCOL"] != "GPU_VIPER":
+        fatal("host_dispatch.py requires a GPU_VIPER build")
+
+    # These attributes are consumed by GPU_VIPER rather than exposed as
+    # user-selectable knobs for this pinned one-CU fixture.
+    args.access_backing_store = True
+    # The topology this stack publishes advertises a full gfx950: simd_count
+    # 1024 over simd_per_cu 4, i.e. 256 compute units. Simulating one is not
+    # merely slower, it is a different machine -- a kernel whose forward
+    # progress depends on several workgroups running at once cannot complete.
+    # AITER's split-K GEMM is such a kernel: one workgroup initialises a tile
+    # counter and each peer releases it, so with too few resident workgroups
+    # every peer polls a counter whose producer was never scheduled, and the
+    # run livelocks with scalar instructions retiring forever and not one
+    # wavefront completing. That is the same shape as the 64 KiB-versus-160 KiB
+    # LDS defect: the device claims a capability the simulator does not honour.
+    #
+    # The count is left configurable because simulation cost scales with it.
+    args.num_compute_units = NUM_COMPUTE_UNITS
+    # One scalar/instruction cache shared by every compute unit. GPU_VIPER
+    # builds ceil(num_compute_units / cu_per_sqc) SQC controllers and the same
+    # again for the scalar cache, and each is a Ruby controller, a sequencer, a
+    # TLB and a TLB coalescer. Sharing costs nothing architecturally here:
+    # host-native instruction fetch never reaches the SQC (FetchUnit returns
+    # from the native provider) and host-native scalar loads never reach the
+    # scalar cache (ComputeUnit::sendScalarRequest services them functionally).
+    # The only traffic either one carries is the per-kernel launch invalidate,
+    # which Shader::prepareInvalidate issues once per SQC group.
+    args.cu_per_sqc = args.num_compute_units
+    args.cu_per_scalar_cache = args.num_compute_units
+    args.num_sqc = 1
+    args.num_scalar_cache = 1
+    args.num_cp = 0
+    args.bw_scalor = 0
+    args.gpu_clock = "1GHz"
+    args.gpu_voltage = "1.0V"
+    args.tcp_rp = "TreePLRURP"
+    args.tcc_rp = "TreePLRURP"
+    args.sqc_rp = "TreePLRURP"
+
+    gpu_clock = SrcClockDomain(
+        clock=args.gpu_clock,
+        voltage_domain=VoltageDomain(voltage=args.gpu_voltage),
+    )
+    # Match the advertised gfx950 topology: four SIMDs with eight resident
+    # wave slots each form the 32 physical scratch slots in a CU.
+    shader = Shader(n_wf=8, cu_per_sqc=args.num_compute_units,
+                    clk_domain=gpu_clock)
+    # Periodic wave/pipeline status. Diagnostic only; set via environment so
+    # the default run is unchanged.
+    shader.progress_interval = int(
+        os.environ.get("GEMSIM_PROGRESS_INTERVAL", "20000000")
+    )
+    shader.impl_kern_launch_acq = True
+    shader.impl_kern_end_rel = False
+    shader.timing = True
+    # Shader::Shader asserts cuList[i]->cu_id == i, and GPU_VIPER builds one
+    # TCP (vector L1 + VIPER coalescer) per unit, so the identifiers have to be
+    # dense and in order. The Ruby ports are bound after Ruby.create_system.
+    compute_units = [
+        create_compute_unit(shader, cu_id, args.functional_fast)
+        for cu_id in range(args.num_compute_units)
+    ]
+    shader.CUs = compute_units
+
+    CpuClass, mem_mode = Simulation.getCPUClass(args.cpu_type)
+    if CpuClass != X86TimingSimpleCPU or mem_mode != "timing":
+        fatal("host_dispatch.py requires the X86 timing CPU model")
+    host_cpu = CpuClass(
+        cpu_id=0,
+        clk_domain=SrcClockDomain(
+            clock="2GHz", voltage_domain=VoltageDomain(voltage="1.0V")
+        ),
+    )
+
+    gpu_driver = GPUComputeDriver(
+        filename="kfd",
+        isdGPU=False,
+        gfxVersion="gfx950",
+        dGPUPoolID=0,
+        m_type=5,
+    )
+    hsapp_paddr = int(Addr(args.mem_size))
+    gpu_hsapp = HSAPacketProcessor(pioAddr=hsapp_paddr, numHWQueues=1)
+    dispatcher = GPUDispatcher(kernel_exit_events=False)
+    gpu_cmd_proc = GPUCommandProcessor(
+        hsapp=gpu_hsapp,
+        dispatcher=dispatcher,
+    )
+    gpu_driver.device = gpu_cmd_proc
+    shader.dispatcher = dispatcher
+    shader.gpu_cmd_proc = gpu_cmd_proc
+
+    executable = os.path.abspath(
+        os.path.join(
+            os.path.dirname(__file__),
+            "../../../tests/test-progs/hello/bin/x86/linux/hello",
+        )
+    )
+    if not os.path.isfile(executable):
+        fatal("tracked x86 hello process is missing: %s", executable)
+    process = Process(
+        executable=executable,
+        cmd=[executable],
+        drivers=[gpu_driver],
+    )
+    host_cpu.workload = process
+    host_cpu.createThreads()
+
+    system = System(
+        cpu=[host_cpu, shader],
+        mem_ranges=[AddrRange(args.mem_size)],
+        cache_line_size=args.cacheline_size,
+        mem_mode=mem_mode,
+        workload=SEWorkload.init_compatible(executable),
+    )
+    system.voltage_domain = VoltageDomain(voltage=args.sys_voltage)
+    system.clk_domain = SrcClockDomain(
+        clock=args.sys_clock,
+        voltage_domain=system.voltage_domain,
+    )
+    system.exit_on_work_items = False
+
+    GPUTLBConfig.config_tlb_hierarchy(args, system, 1)
+
+    system.piobus = IOXBar(
+        width=32,
+        response_latency=0,
+        frontend_latency=0,
+        forward_latency=0,
+    )
+    dma_devices = [gpu_hsapp, gpu_cmd_proc]
+    Ruby.create_system(args, False, system, None, dma_devices, None)
+    system.ruby.clk_domain = SrcClockDomain(
+        clock=args.ruby_clock,
+        voltage_domain=system.voltage_domain,
+    )
+    gpu_cmd_proc.pio = system.piobus.mem_side_ports
+    gpu_hsapp.pio = system.piobus.mem_side_ports
+    for index in range(len(dma_devices)):
+        getattr(system, f"dma_cntrl{index}").clk_domain = (
+            system.ruby.clk_domain
+        )
+
+    ruby_port = system.ruby._cpu_ports[0]
+    host_cpu.createInterruptController()
+    host_cpu.icache_port = ruby_port.in_ports
+    host_cpu.dcache_port = ruby_port.in_ports
+    ruby_port.mem_request_port = system.piobus.cpu_side_ports
+    host_cpu.interrupts[0].pio = system.piobus.mem_side_ports
+    host_cpu.interrupts[0].int_requestor = system.piobus.cpu_side_ports
+    host_cpu.interrupts[0].int_responder = system.piobus.mem_side_ports
+
+    # Ruby.create_system publishes its sequencers in construction order:
+    # the CPU core pair first, then one VIPER coalescer per compute unit, then
+    # the SQC sequencers, then the scalar-cache sequencers, then any command
+    # processors (num_cp is 0 here). Derive the first GPU index from that
+    # composition rather than from a constant, and assert the composition.
+    gpu_port_idx = (
+        len(system.ruby._cpu_ports)
+        - args.num_compute_units
+        - args.num_sqc
+        - args.num_scalar_cache
+        - args.num_cp * 2
+    )
+    token_ports = [
+        port
+        for port in system.ruby._cpu_ports
+        if isinstance(port, VIPERCoalescer)
+    ]
+    if len(token_ports) != args.num_compute_units:
+        fatal(
+            "expected one VIPER coalescer per compute unit: %d units but %d "
+            "coalescers"
+            % (args.num_compute_units, len(token_ports))
+        )
+    if gpu_port_idx < 0 or token_ports[0] is not (
+        system.ruby._cpu_ports[gpu_port_idx]
+    ):
+        fatal(
+            "GPU_VIPER sequencer order changed: expected the first VIPER "
+            "coalescer at index %d of %d cpu ports"
+            % (gpu_port_idx, len(system.ruby._cpu_ports))
+        )
+
+    for cu_id, compute_unit in enumerate(compute_units):
+        # Only the TCP coalescers use a token port for back pressure.
+        compute_unit.gmTokenPort = token_ports[cu_id].gmTokenPort
+
+    # One vector L1 per compute unit; the pipeline issues wf_size uncoalesced
+    # requests per issue cycle, hence 64 memory ports each.
+    for compute_unit in compute_units:
+        for lane in range(64):
+            compute_unit.memory_port[lane] = system.ruby._cpu_ports[
+                gpu_port_idx
+            ].in_ports[lane]
+        gpu_port_idx += 1
+
+    # cu_per_sqc compute units share one SQC, and likewise for the scalar
+    # cache: advance to the next sequencer only on a group boundary.
+    for cu_id, compute_unit in enumerate(compute_units):
+        if cu_id > 0 and not cu_id % args.cu_per_sqc:
+            gpu_port_idx += 1
+        compute_unit.sqc_port = system.ruby._cpu_ports[gpu_port_idx].in_ports
+    gpu_port_idx += 1
+    for cu_id, compute_unit in enumerate(compute_units):
+        if cu_id > 0 and not cu_id % args.cu_per_scalar_cache:
+            gpu_port_idx += 1
+        compute_unit.scalar_port = system.ruby._cpu_ports[
+            gpu_port_idx
+        ].in_ports
+    gpu_port_idx += 1
+    if gpu_port_idx != len(system.ruby._cpu_ports) - args.num_cp * 2:
+        fatal(
+            "GPU port wiring consumed %d of %d ruby cpu ports"
+            % (gpu_port_idx, len(system.ruby._cpu_ports))
+        )
+
+    shader.cpu_pointer = host_cpu
+    root = Root(system=system, full_system=False)
+    system.host_gpu_bridge = HostGPUBridge(
+        endpoint=args.endpoint,
+        daemon_uuid=args.daemon_uuid,
+        job_uuid=args.job_uuid,
+        epoch=args.epoch,
+        rank=args.rank,
+        world_size=args.world_size,
+        startup_timeout_ms=args.startup_timeout_ms,
+        handshake_timeout_ms=args.handshake_timeout_ms,
+        max_record=args.max_record,
+        system=system,
+        hsa_packet_processor=gpu_hsapp,
+        gpu_dispatcher=dispatcher,
+        shader=shader,
+        dispatch_trace_path=args.dispatch_trace_path,
+        bridge_tape_path=args.bridge_tape_path,
+        exit_on_dispatch_session_done=True,
+    )
+    return system
+
+
+args = parse_args()
+system = create_system(args)
+
+# Identity header. The simulation mode must be recoverable from the run's own
+# log: a functional-fast result may satisfy functional gates but may never be
+# cited for any timing, TPOT or performance claim.
+print(
+    "host-gpu-dispatch-mode timing_fidelity={} functional_fast={} "
+    "lds_bytes_per_cu={} compute_units={} wave_slots_per_simd={}".format(
+        "approximate" if args.functional_fast else "cycle-accurate",
+        int(args.functional_fast),
+        LDS_BYTES_PER_CU,
+        args.num_compute_units,
+        8,
+    ),
+    flush=True,
+)
+
+m5.ticks.setGlobalFrequency("1THz")
+m5.instantiate()
+
+deadline = time.monotonic() + args.run_timeout_ms / 1000.0
+exit_event = None
+while time.monotonic() < deadline:
+    exit_event = m5.simulate(args.service_tick_quantum)
+    if exit_event.getCause() != "simulate() limit reached":
+        break
+
+m5.stats.dump()

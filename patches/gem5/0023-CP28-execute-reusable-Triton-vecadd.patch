     auto *task = shader->dispatcher().hsaTask(gpuDynInst->kern_id);
     shader->dispatcher().notifyCuGlobalStoreCompleted(
         *task, cu_id, gpuDynInst->wg_id, gpuDynInst->addr, bytesPerLane,

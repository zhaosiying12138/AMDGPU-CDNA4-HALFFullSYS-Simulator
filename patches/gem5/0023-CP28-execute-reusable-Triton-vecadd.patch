--- a/src/dev/amdgpu/host_native_code_object_mapper.cc
+++ b/src/dev/amdgpu/host_native_code_object_mapper.cc
@@ -27,8 +27,10 @@
 
 #include "dev/amdgpu/host_gpu_code_object_image.hh"
 #include "dev/amdgpu/host_gpu_code_object_state.hh"
+#include "gpu-compute/kernel_code.hh"
 
 #include <algorithm>
+#include <cstring>
 #include <limits>
 #include <new>
 
@@ -423,7 +425,26 @@ HostNativeCodeObjectMapper::map(
         fail(Failure::InvalidSegment);
         return std::nullopt;
     }
-    result.entryGpuVa = entryVirtual;
+    AMDKernelCode descriptor = {};
+    static_assert(
+        sizeof(descriptor) == protocol::CodeObjectDescriptorBytes,
+        "AMDGPU kernel descriptor ABI size changed");
+    std::memcpy(
+        &descriptor, manifest.descriptor.data(), sizeof(descriptor));
+    const uint32_t preloadLength =
+        descriptor.kernarg_preload_spec_length;
+    if (preloadLength >
+        protocol::GenericDispatchMaximumDescriptorPreloadDwords ||
+        (preloadLength != 0 &&
+         (manifest.codeSize <= KernargPreloadPktSize ||
+          entryVirtual > std::numeric_limits<Addr>::max() -
+              KernargPreloadPktSize))) {
+        rollback(lease, allocation);
+        fail(Failure::InvalidSegment);
+        return std::nullopt;
+    }
+    result.entryGpuVa = preloadLength == 0 ? entryVirtual :
+        entryVirtual + KernargPreloadPktSize;
     return result;
 }
 

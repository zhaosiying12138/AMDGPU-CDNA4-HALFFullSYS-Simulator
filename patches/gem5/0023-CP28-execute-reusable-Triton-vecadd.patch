+protocol::CodeObjectManifest
+manifest()
+{
+    using namespace triton_vecadd_fixture;
+    protocol::CodeObjectManifest result;
+    result.imageSize = ImageBytes;
+    result.chunkCount = static_cast<uint32_t>(
+        (ImageBytes + protocol::CodeObjectChunkDataBytes - 1) /
+        protocol::CodeObjectChunkDataBytes);
+    result.segmentCount = LoadSegments.size();
+    result.imageSha256 = ImageSha256;
+    result.elfMachine = ElfMachine;
+    result.elfType = ElfType;
+    result.elfOsabi = ElfOsabi;
+    result.elfAbiVersion = ElfAbiVersion;
+    result.elfFlags = ElfFlags;
+    result.gfxTarget = GfxTarget;
+    result.codeObjectVersion = CodeObjectVersion;
+    result.metadataMajor = MetadataMajor;
+    result.metadataMinor = MetadataMinor;
+    result.kernargSegmentSize = KernargBytes;
+    result.kernargSegmentAlign = KernargAlignment;
+    result.maxFlatWorkgroupSize = MaxFlatWorkgroupSize;
+    result.wavefrontSize = WavefrontSize;
+    result.sgprCount = SgprCount;
+    result.vgprCount = VgprCount;
+    result.descriptorSize = Descriptor.size();
+    result.kernelCodeEntryByteOffset = KernelCodeEntryByteOffset;
+    result.codeVirtualAddress = CodeVirtualAddress;
+    result.codeFileOffset = CodeFileOffset;
+    result.codeSize = CodeBytes;
+    result.descriptorVirtualAddress = DescriptorVirtualAddress;
+    result.descriptorFileOffset = DescriptorFileOffset;
+    std::copy_n(
+        KernelName, std::strlen(KernelName), result.kernelName.begin());
+    std::copy_n(
+        DescriptorSymbol, std::strlen(DescriptorSymbol),
+        result.descriptorSymbol.begin());
+    result.descriptor = Descriptor;
+    for (size_t index = 0; index < LoadSegments.size(); ++index) {
+        const auto &source = LoadSegments[index];
+        result.segments[index] = {
+            1, source.flags, source.fileOffset, source.virtualAddress,
+            source.fileSize, source.memorySize, 0x1000};
+    }
+    return result;

+/**
+ * The predicate of V_CMP_CLASS_*: does `value` belong to any of the classes
+ * selected by `mask`?
+ *
+ * Bit assignments are the ISA's: 0 signalling NaN, 1 quiet NaN, 2 -infinity,
+ * 3 -normal, 4 -denormal, 5 -zero, 6 +zero, 7 +denormal, 8 +normal,
+ * 9 +infinity. Bits 0 and 1 are treated alike because the host float type
+ * carries no signalling/quiet distinction we can rely on; that matches what
+ * this model already did before the classes were factored out here.
+ */
+template<typename F>
+inline bool
+floatClassMatches(F value, uint32_t mask)
+{
+    const bool negative = std::signbit(value);
+
+    if ((mask & 0x3u) && std::isnan(value))
+        return true;
+    if ((mask & (1u << 2)) && std::isinf(value) && negative)
+        return true;
+    if ((mask & (1u << 3)) && std::isnormal(value) && negative)
+        return true;
+    if ((mask & (1u << 4)) && std::fpclassify(value) == FP_SUBNORMAL
+        && negative)
+        return true;
+    if ((mask & (1u << 5)) && std::fpclassify(value) == FP_ZERO && negative)
+        return true;
+    if ((mask & (1u << 6)) && std::fpclassify(value) == FP_ZERO && !negative)
+        return true;
+    if ((mask & (1u << 7)) && std::fpclassify(value) == FP_SUBNORMAL
+        && !negative)
+        return true;
+    if ((mask & (1u << 8)) && std::isnormal(value) && !negative)
+        return true;
+    if ((mask & (1u << 9)) && std::isinf(value) && !negative)
+        return true;
+
+    return false;
+}
+
+/**
+ * The 64-bit lane mask a VOPC compare commits.
+ *
+ * A compare writes one bit per lane and writes zero for every inactive lane;
+ * there is no per-lane preservation, and the SDWA encoding does not change
+ * that because it has no destination select at all (see Inst_VOPC).
+ */
+inline uint64_t
+vopcLaneMask(uint64_t results, uint64_t exec)
+{
+    return results & exec;
+}
+
+/**
+ * SDWA destination handling, which only the VOP1/VOP2 form of the encoding
+ * has. VOPC spends the same bits on SDST/SD (see Inst_VOPC), so everything
+ * below is reachable only from Inst_VOP1/Inst_VOP2.
+ *
+ *   DST_SEL[10:8]     which sub-dword field of the destination the result
+ *                     lands in, using the same 0..6 encoding as a source
+ *                     select
+ *   DST_UNUSED[12:11] what happens to the bits the result does not occupy
+ *   CLAMP[13]         clamp a floating-point result to [0.0, 1.0]
+ *   OMOD[15:14]       multiply a floating-point result by 2, 4 or 0.5

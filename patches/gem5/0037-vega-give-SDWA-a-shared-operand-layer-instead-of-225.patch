+/**
+ * SDWA (sub-dword addressing) source formation.
+ *
+ * A VOP1/VOP2/VOPC instruction whose SRC0 selector is REG_SRC_SWDA carries a
+ * second dword naming, per source, one sub-dword field of the source register
+ * plus its modifiers. The field is widened back to a full dword before the
+ * operation sees it, which is what lets one v_cmp opcode compare bytes, words
+ * or dwords.
+ *
+ * The select encoding is SDWASelVals in inst_util.hh; it is spelled out
+ * numerically here so this header stays free of instruction-class headers and
+ * can be unit tested on its own (inst_util.hh already includes this file, so
+ * including it back would be circular).
+ *
+ *   0..3  BYTE_0..BYTE_3   data[8n+7 : 8n]
+ *   4,5   WORD_0, WORD_1   data[16n+15 : 16n]
+ *   6     DWORD            data[31:0]
+ */
+
+/** Width in bits of the field named by an SDWA source select. */
+inline int
+sdwaSelectWidth(unsigned sel)
+{
+    if (sel <= 3)
+        return BITS_PER_BYTE;
+    if (sel <= 5)
+        return BITS_PER_WORD;
+    return 32;
+}
+
+/** Offset in bits of the field named by an SDWA source select. */
+inline int
+sdwaSelectOffset(unsigned sel)
+{
+    if (sel <= 3)
+        return static_cast<int>(sel) * BITS_PER_BYTE;
+    if (sel <= 5)
+        return static_cast<int>(sel - 4) * BITS_PER_WORD;
+    return 0;
+}
+
+/**
+ * The selected field widened to a full dword.
+ *
+ * Widening is part of forming the operand, so it happens before any modifier:
+ * an SDWA source is "the selected bits, widened", and ABS/NEG then act on that
+ * widened value rather than on the narrow field. `sext` sign-extends from the
+ * field's own most significant bit; otherwise the upper bits are zero. Note
+ * that this is independent of whether the *opcode* is signed --
+ * `v_cmp_lt_u32_sdwa vcc, sext(v1), v2 src0_sel:BYTE_0` is a legal encoding
+ * (checked with llvm-mc for gfx950), so sign extension must not be gated on
+ * the comparison's signedness.
+ */
+inline uint32_t
+sdwaExtendedSource(uint32_t dword, unsigned sel, bool sext)
+{
+    const int width = sdwaSelectWidth(sel);
+    if (width == 32)
+        return dword;
+
+    const uint32_t fieldMask = (1u << width) - 1;
+    uint32_t field = (dword >> sdwaSelectOffset(sel)) & fieldMask;
+    if (sext && ((field >> (width - 1)) & 1u))
+        field |= ~fieldMask;
+    return field;
+}
+
+/**
+ * ABS then NEG on a floating-point SDWA source, as sign-bit operations on the
+ * widened dword. The order matches VOP3's source modifiers, so a source
+ * carrying both reads as -|x|. `opBits` is the width of the operand the
+ * *operation* consumes (32 for an f32 compare, 16 for an f16 one), which is
+ * not in general the width of the selected field.
+ */
+inline uint32_t
+sdwaFloatModifiers(uint32_t bits, int opBits, bool abs, bool neg)
+{
+    const uint32_t signBit = 1u << (opBits - 1);
+    if (abs)
+        bits &= ~signBit;
+    if (neg)
+        bits ^= signBit;
+    return bits;
+}
+
+/** One SDWA source of an integer opcode. */
+inline uint32_t
+sdwaIntegerSource(uint32_t dword, unsigned sel, bool sext)
+{
+    return sdwaExtendedSource(dword, sel, sext);
+}
+
+/** One SDWA source of a floating-point opcode. */
+inline uint32_t
+sdwaFloatSource(uint32_t dword, unsigned sel, int opBits, bool abs, bool neg)
+{
+    return sdwaFloatModifiers(sdwaExtendedSource(dword, sel, false), opBits,
+                              abs, neg);
+}
+
+/**
+ * Reinterpret the low bits of an SDWA-formed dword as the operand type.
+ *
+ * SDWA produces bits, not a number: the dword that comes out of
+ * sdwaFloatSource holds an IEEE encoding and must reach the comparison
+ * unchanged. Converting instead of reinterpreting would turn 0x3f800000 into
+ * 1.06e9 rather than 1.0f, which no oracle downstream would catch because the
+ * comparison would still be internally consistent.
+ */
+template<typename T>
+inline T
+sdwaOperandBits(uint32_t bits)
+{
+    static_assert(sizeof(T) <= sizeof(uint32_t),
+                  "the Vega SDWA encoding has no 64-bit operand form");
+    T value{};
+    std::memcpy(&value, &bits, sizeof(T));
+    return value;
+}

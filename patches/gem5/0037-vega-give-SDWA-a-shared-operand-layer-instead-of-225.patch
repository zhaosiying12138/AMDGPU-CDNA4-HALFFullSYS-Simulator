+         0x261216f9u, 0x8402060au, "v_and_b32",
+         "v_and_b32_sdwa v9, v10, s11 dst_sel:DWORD "
+         "dst_unused:UNUSED_PAD src0_sel:BYTE_2 src1_sel:WORD_0",
+         10, 6, 0, 0, 0, 2, 0, 0, 0, 0, 4, 0, 1},
+        {"v_add_co_u32_sdwa v1, vcc, v2, v3 dst_sel:BYTE_2 "
+         "dst_unused:UNUSED_PRESERVE src0_sel:DWORD src1_sel:DWORD",
+         0x320206f9u, 0x06061202u, "v_add_co_u32",
+         "v_add_co_u32_sdwa v1, vcc, v2, v3 dst_sel:BYTE_2 "
+         "dst_unused:UNUSED_PRESERVE src0_sel:DWORD src1_sel:DWORD",
+         2, 2, 2, 0, 0, 6, 0, 0, 0, 0, 6, 0, 0},
+        {"v_cndmask_b32_sdwa v1, v2, v3, vcc dst_sel:DWORD "
+         "dst_unused:UNUSED_PRESERVE src0_sel:BYTE_1 src1_sel:BYTE_2",
+         0x000206f9u, 0x02011602u, "v_cndmask_b32",
+         "v_cndmask_b32_sdwa v1, v2, v3, vcc dst_sel:DWORD "
+         "dst_unused:UNUSED_PRESERVE src0_sel:BYTE_1 src1_sel:BYTE_2",
+         2, 6, 2, 0, 0, 1, 0, 0, 0, 0, 2, 0, 0},
+        {"v_min_i32_sdwa v6, sext(v7), sext(v8) dst_sel:DWORD "
+         "dst_unused:UNUSED_PRESERVE src0_sel:BYTE_3 src1_sel:BYTE_0",
+         0x180c10f9u, 0x080b1607u, "v_min_i32",
+         "v_min_i32_sdwa v6, sext(v7), sext(v8) dst_sel:DWORD "
+         "dst_unused:UNUSED_PRESERVE src0_sel:BYTE_3 src1_sel:BYTE_0",
+         7, 6, 2, 0, 0, 3, 1, 0, 0, 0, 0, 1, 0},
+    }};
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+
+    for (const auto &g : Golden) {
+        SCOPED_TRACE(g.asmText);
+        checkSdwaFields(g);
+
+        InFmt_VOP2 vop2;
+        std::memcpy(&vop2, &g.dword0, sizeof(vop2));
+        EXPECT_EQ(vop2.SRC0, REG_SRC_SWDA);
+
+        InstFormat words[2] = {};
+        words[0].imm_u32 = g.dword0;
+        words[1].imm_u32 = g.dword1;
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), g.mnemonic);
+        EXPECT_EQ(inst->instSize(), 8);
+        EXPECT_TRUE(inst->isSDWAInst());
+        EXPECT_FALSE(inst->isDPPInst());
+
+        inst->initOperandInfo();
+        ASSERT_GE(inst->srcOperands().size(), 2u);
+        EXPECT_TRUE(inst->srcOperands()[0].isVectorReg());
+        EXPECT_EQ(inst->srcOperands()[0].rawRegisterIndex(),
+                  REG_VGPR_MIN + int(g.src0));
+        // S1 redirects VSRC1 at a scalar operand; without it VSRC1 stays a
+        // plain VGPR index.
+        EXPECT_EQ(inst->srcOperands()[1].isScalarReg(), bool(g.s1));
+
+        EXPECT_EQ(inst->disassemble(), g.disassembly);
+    }
+}
+
 } // anonymous namespace
 } // namespace VegaISA
 } // namespace gem5

+
+/**
+ * The bits of an ALU result, for handing to sdwaDestMerge.
+ *
+ * This is a reinterpretation, not a conversion: the result of an f32 opcode
+ * has to reach the destination as its IEEE encoding. A narrow result occupies
+ * only the low bits and the rest are zero, which is all sdwaDestMerge looks
+ * at for a byte or word select.
+ */
+template<typename T>
+inline uint32_t
+sdwaResultBits(T value)
+{
+    static_assert(sizeof(T) <= sizeof(uint32_t),
+                  "the Vega SDWA encoding has no 64-bit operand form");
+    uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(T));
+    return bits;
+}

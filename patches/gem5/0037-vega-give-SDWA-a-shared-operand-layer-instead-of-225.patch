+
+#ifndef __ARCH_AMDGPU_VEGA_INSTS_FLAT_LDS_HH__
+#define __ARCH_AMDGPU_VEGA_INSTS_FLAT_LDS_HH__
+
+#include <cstdint>
+
+namespace gem5
+{
+
+namespace VegaISA
+{
+
+/**
+ * Placement rules shared by every "LDS DMA" load -- the loads that deliver
+ * global (or scratch) data straight into LDS instead of into VGPRs:
+ *
+ *   MUBUF: buffer_load_{ubyte,sbyte,ushort,sshort,dword,dwordx3,dwordx4}
+ *          with the LDS encoding bit set
+ *   FLAT:  global_load_lds_{ubyte,sbyte,ushort,sshort,dword,dwordx3,dwordx4}
+ *          and scratch_load_lds_{ubyte,sbyte,ushort,sshort,dword}
+ *          (SEG=2 and SEG=1; SEG=0 "flat_load_lds_*" is not a legal gfx950
+ *          encoding -- llvm-mc -mcpu=gfx950 rejects every spelling of it)
+ *
+ * These live in their own header so the address arithmetic can be unit
+ * tested without instantiating a ComputeUnit: see flat_lds.test.cc. A wrong
+ * destination address or lane stride here does not crash, it silently puts
+ * the right bytes in the wrong LDS slot, so it needs direct coverage.
+ */
+namespace flat_lds
+{
+
+/**
+ * The LDS destination address comes from M0, as a byte offset into the
+ * wavefront's own LDS allocation. gem5 models the workgroup's LDS base
+ * implicitly through Wavefront::ldsChunk, so no base is added here.
+ *
+ * All 32 bits of M0 are used: neither masking nor alignment rounding is
+ * applied. On GFX9 and later M0 is not a range-check register for LDS
+ * (llvm/docs/AMDGPUUsage.rst), LLVM copies the addrspace(3) pointer into it
+ * verbatim, and AMD's CDNA4 ISA XML types the implicit M0 input as 32 bits.
+ * A value that runs off the end of the chunk is dropped by
+ * LdsChunk::write(), which is what hardware does with an out-of-range LDS
+ * DMA -- so an unmasked wild address fails closed, whereas masking one would
+ * wrap it back into a valid slot and silently corrupt a neighbour.
+ *
+ * This wrapper exists so the rule has one definition shared by the MUBUF and
+ * FLAT encodings, and so it is visible to the unit test.
+ */
+inline constexpr uint32_t
+destAddr(uint32_t m0)
+{
+    return m0;
+}
+
+/**
+ * Lane N writes at destAddr + N * laneStrideBytes.
+ *
+ * The stride is a property of the opcode and is NOT the payload size. AMD's
+ * LDS-DMA slot is 4 bytes per lane for 1-, 2- and 4-byte loads and 16 bytes
+ * per lane for the 12- and 16-byte gfx950 loads:
+ * llvm/docs/AMDGPUDMAOperations.md -- "The LDS address is implicitly offset
+ * by 4 * lane_id bytes for sizes up to 4 bytes, and by 16 * lane_id bytes for
+ * larger sizes." Triton's AMD backend refuses to emit exactly the widths
+ * whose slot differs from their payload (8/16/96 bit) because it assumes a
+ * packed layout, which is corroborating evidence for the 4/16 rule.
+ *
+ * It is therefore passed in explicitly rather than derived from the payload.
+ */
+inline constexpr uint32_t
+laneAddr(uint32_t base, int lane, int lane_stride_bytes)
+{
+    return base + static_cast<uint32_t>(lane) *
+                  static_cast<uint32_t>(lane_stride_bytes);
+}
+
+/**
+ * Widen a packed array of NarrowT, one element per lane, into a packed array
+ * of 32-bit dwords in the same buffer.
+ *
+ * A sub-dword LDS DMA still occupies a whole 4-byte LDS slot per lane, with
+ * the value zero- or sign-extended to 32 bits ("Load 8 bits ... zero extend
+ * to 32 bits and store the result into a data share", AMD CDNA4 ISA XML,
+ * GLOBAL_LOAD_LDS_UBYTE). gem5's initMemRead<T> packs the returned data at
+ * ((T*)d_data)[lane], so for a 1- or 2-byte T lane N's datum sits at byte
+ * offset N*sizeof(T), not at N*4; reading it as a dword array would give
+ * every lane the wrong bytes and would run off the populated region entirely
+ * past lane 63/sizeof(T).
+ *
+ * Rewriting in place is safe descending, because a lane's destination
+ * (4*lane) is never below its source (sizeof(NarrowT)*lane).
+ */
+template <typename NarrowT>
+inline void
+widen(void *data, int num_lanes, uint64_t lane_mask)
+{
+    static_assert(sizeof(NarrowT) < sizeof(uint32_t));
+
+    auto *narrow = static_cast<NarrowT *>(data);
+    auto *wide = static_cast<uint32_t *>(data);
+
+    for (int lane = num_lanes - 1; lane >= 0; --lane) {
+        if ((lane_mask >> lane) & 1ULL) {
+            // Integer promotion of the narrow type does the work: an
+            // unsigned NarrowT zero-extends and a signed one sign-extends.
+            wide[lane] = static_cast<uint32_t>(
+                static_cast<int32_t>(narrow[lane]));
+        }
+    }
+}
+
+/** Sign extend the low sign_bit bits of value to 32 bits. */
+inline constexpr uint32_t
+signExtend(uint32_t value, int sign_bit)
+{
+    if (sign_bit <= 0 || sign_bit >= 32) {
+        return value;
+    }
+    const int shift = 32 - sign_bit;
+    return static_cast<uint32_t>(
+        (static_cast<int32_t>(value << shift)) >> shift);
+}
+
+/**
+ * Walk the LDS writes performed by one LDS-destination load and hand each
+ * (byte address, dword value) pair to @p sink.
+ *
+ * @param lds_base          destAddr() of the wave's M0.
+ * @param payload_dwords    dwords of returned data consumed per lane. Every
+ *                          sub-dword form returns one already-extended dword
+ *                          per lane, so this is 1 for ubyte/sbyte/ushort/
+ *                          sshort, 1/3/4 for dword/dwordx3/dwordx4.
+ * @param lane_stride_bytes LDS bytes advanced per lane.
+ * @param sign_bit          0 for no extension, else the payload's sign bit
+ *                          (8 for sbyte, 16 for sshort).
+ * @param d_data            returned data, laid out lane-major with
+ *                          payload_dwords dwords per lane.
+ * @param num_lanes         wavefront width.
+ * @param lane_mask         the instruction's snapshotted EXEC mask. Inactive
+ *                          lanes perform no LDS write at all -- they do not
+ *                          write zero and they do not shift the lanes after
+ *                          them, because the stride is positional.
+ */
+template <typename Sink>
+inline void
+scatter(uint32_t lds_base, int payload_dwords, int lane_stride_bytes,
+        int sign_bit, const uint32_t *d_data, int num_lanes,
+        uint64_t lane_mask, Sink &&sink)
+{
+    for (int lane = 0; lane < num_lanes; ++lane) {
+        if (!((lane_mask >> lane) & 1ULL)) {
+            continue;
+        }
+
+        const uint32_t chunk_addr = laneAddr(lds_base, lane,
+                                             lane_stride_bytes);
+
+        for (int i = 0; i < payload_dwords; ++i) {
+            uint32_t val = d_data[lane * payload_dwords + i];
+            val = signExtend(val, sign_bit);
+            sink(chunk_addr + static_cast<uint32_t>(i) * 4u, val);
+        }
+    }
+}
+

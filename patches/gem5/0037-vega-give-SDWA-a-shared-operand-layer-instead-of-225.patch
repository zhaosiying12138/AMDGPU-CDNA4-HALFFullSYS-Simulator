+/**
+ * Coverage for the gfx950 LDS-DMA load family:
+ *
+ *   global_load_lds_{ubyte,sbyte,ushort,sshort,dword,dwordx3,dwordx4}
+ *
+ * Two things are checked, because they fail in two very different ways.
+ *
+ * The decode/flag half fails loudly -- the vLLM TP1 lane aborted with
+ * "op idx 2 out of bounds" from generateGlobalScratchDisassembly(), reached
+ * through ScheduleStage::dispatchReady()'s panic() because the instruction
+ * carried no MemoryRef flag and matched none of its categories.
+ *
+ * The placement half fails silently. A wrong LDS destination address, a
+ * wrong per-lane slot pitch, or a lane mask applied as a prefix-compaction
+ * instead of positionally all produce a perfectly plausible LDS image that
+ * happens to be wrong. Those get an explicit CPU oracle here.
+ *
+ * Encodings below were produced by
+ *   llvm-mc -arch=amdgcn -mcpu=gfx950 -show-encoding
+ * and the expected disassembly strings are byte-for-byte what llvm-mc
+ * printed for the same input.
+ */
+
+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "arch/amdgpu/vega/gpu_decoder.hh"
+#include "arch/amdgpu/vega/insts/flat_lds.hh"
+#include "gpu-compute/gpu_static_inst.hh"
+
+namespace gem5
+{
+
+namespace VegaISA
+{
+
+namespace
+{
+
+constexpr int WfSize = 64;
+
+struct LdsWrite
+{
+    uint32_t addr;
+    uint32_t value;
+
+    bool
+    operator==(const LdsWrite &o) const
+    {
+        return addr == o.addr && value == o.value;
+    }
+};
+
+std::vector<LdsWrite>
+runScatter(uint32_t base, int payload_dwords, int lane_stride_bytes,
+           int sign_bit, const std::vector<uint32_t> &data, uint64_t mask)
+{
+    std::vector<LdsWrite> out;
+    flat_lds::scatter(base, payload_dwords, lane_stride_bytes, sign_bit,
+                      data.data(), WfSize, mask,
+                      [&out](uint32_t addr, uint32_t value) {
+                          out.push_back({addr, value});
+                      });
+    return out;
+}
+
+// Distinct, position-revealing payload: lane L dword D -> 0xL_D pattern.
+std::vector<uint32_t>
+makePayload(int payload_dwords)
+{
+    std::vector<uint32_t> data(WfSize * payload_dwords);
+    for (int lane = 0; lane < WfSize; ++lane) {
+        for (int d = 0; d < payload_dwords; ++d) {
+            data[lane * payload_dwords + d] =
+                0xa5000000u | (static_cast<uint32_t>(lane) << 8) |
+                static_cast<uint32_t>(d);
+        }
+    }
+    return data;
+}
+

+namespace
+{
+
+struct FlaggedInst
+{
+    uint32_t word0;
+    uint32_t word1;
+    const char *mnemonic;
+};
+
+// Golden gfx950 encodings from llvm-mc. Each of these was, or is adjacent
+// to, an instruction that shipped without MemoryRef.
+const FlaggedInst MemoryFlagFamily[] = {
+    // MUBUF, previously missing MemoryRef (and GlobalSegment).
+    {0xe0301000, 0x80020102, "buffer_store_format_d16_x"},
+    {0xe1481000, 0x80020102, "buffer_atomic_pk_add_bf16"},
+    {0xe1a41000, 0x80020201, "buffer_atomic_or_x2"},
+    // MUBUF controls that always had the flags.
+    {0xe0501000, 0x80020102, "buffer_load_dword"},
+    // FLAT SEG=0, previously missing MemoryRef. This one was silent: with
+    // isFlat() true it passed dispatchReady() and reserveResources(), so the
+    // only symptom was a reduction that never happened and a coalescer token
+    // that was never returned.
+    {0xdd480000, 0x00000102, "flat_atomic_pk_add_bf16"},
+    // The same opcode in the global segment.
+    {0xdd488000, 0x00000102, "flat_atomic_pk_add_bf16"},
+    // FLAT controls.
+    {0xdca88010, 0x00000002, "flat_load_lds_dword"},
+    {0xddf48010, 0x00000002, "flat_load_lds_dwordx4"},
+};
+
+} // namespace
+
+TEST(FlatLdsDecodeTest, EveryMemoryInstructionClassifiesExactlyOnce)
+{
+    // ScheduleStage::dispatchReady() and Wavefront::reserveResources() both
+    // classify a vector memory instruction with the same three predicates. An
+    // instruction that matches none of them reaches their final else and
+    // panics; an instruction that matches two would reserve the wrong
+    // resources. Both predicates need MemoryRef, so an omitted flag takes the
+    // instruction out of the taxonomy entirely -- which is how
+    // flat_load_lds_dwordx4 killed the vLLM TP1 lane.
+    for (const FlaggedInst &entry : MemoryFlagFamily) {
+        SCOPED_TRACE(entry.mnemonic);
+        auto inst = decodeGfx950(entry.word0, entry.word1);
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), entry.mnemonic);
+
+        ASSERT_TRUE(inst->isLoad() || inst->isStore() || inst->isAtomic());
+        EXPECT_TRUE(inst->isMemRef());
+        EXPECT_FALSE(inst->isScalar());
+
+        const int categories = int(inst->isGlobalMem()) +
+                               int(inst->isLocalMem()) + int(inst->isFlat());
+        EXPECT_EQ(categories, 1)
+            << "isGlobalMem=" << inst->isGlobalMem()
+            << " isLocalMem=" << inst->isLocalMem()
+            << " isFlat=" << inst->isFlat();
+
+        // And it must be able to describe itself: dispatchReady()'s panic
+        // and every DPRINTF call disassemble() first.
+        EXPECT_FALSE(inst->disassemble().empty());
+    }
+}
+
+TEST(FlatLdsDecodeTest, OrdinaryGlobalLoadStillPrintsItsDestination)
+{
+    // Guard against the disassembly fix suppressing a real VDST. Golden
+    // encoding from llvm-mc for
+    //   global_load_dword v3, v2, s[0:1] offset:16
+    auto inst = decodeGfx950(0xdc508010, 0x03000002);
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "flat_load_dword");
+    EXPECT_EQ(inst->numDstRegOperands(), 1);
+    EXPECT_EQ(inst->disassemble(),
+              "global_load_dword v3, v2, s[0:1] offset:16");
+}

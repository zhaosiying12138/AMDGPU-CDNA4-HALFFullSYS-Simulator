+/**
+ * Golden SDWA encodings, taken verbatim from llvm-mc -mcpu=gfx950
+ * -show-encoding. They pin our InFmt_VOP_SDWAB bitfield layout to the
+ * assembler's, which is the only part of SDWA a numerical oracle cannot
+ * check: a compare that reads the wrong field of the second dword still
+ * produces a self-consistent answer, just not the right one.
+ */
+struct SdwabGolden
+{
+    const char *asmText;
+    uint32_t dword0;
+    uint32_t dword1;
+    const char *mnemonic;
+    unsigned src0;      // SRC0[7:0]
+    unsigned sdst;      // SDST[14:8]
+    unsigned sd;        // SD[15]
+    unsigned src0Sel;   // SRC0_SEL[18:16]
+    unsigned src0Sext;  // SRC0_SEXT[19]
+    unsigned src0Neg;   // SRC0_NEG[20]
+    unsigned src0Abs;   // SRC0_ABS[21]
+    unsigned s0;        // S0[23]
+    unsigned vsrc1;     // VSRC1, in dword 0
+    unsigned src1Sel;   // SRC1_SEL[26:24]
+    unsigned src1Sext;  // SRC1_SEXT[27]
+    unsigned src1Neg;   // SRC1_NEG[28]
+    unsigned src1Abs;   // SRC1_ABS[29]
+    unsigned s1;        // S1[31]
+};
+
+TEST(GpuDecoderTest, VopcSdwabFieldsMatchAssemblerEncodings)
+{
+    static constexpr std::array<SdwabGolden, 8> Golden = {{
+        {"v_cmp_gt_u32_sdwa vcc, v1, v2 src0_sel:DWORD src1_sel:DWORD",
+         0x7d9804f9u, 0x06060001u, "v_cmp_gt_u32",
+         1, 0, 0, 6, 0, 0, 0, 0, 2, 6, 0, 0, 0, 0},
+        {"v_cmp_gt_u32_sdwa s[10:11], v3, v4 src0_sel:BYTE_1 src1_sel:WORD_1",
+         0x7d9808f9u, 0x05018a03u, "v_cmp_gt_u32",
+         3, 10, 1, 1, 0, 0, 0, 0, 4, 5, 0, 0, 0, 0},
+        {"v_cmp_lt_i32_sdwa vcc, sext(v5), sext(v6) src0_sel:BYTE_3 "
+         "src1_sel:BYTE_0",
+         0x7d820cf9u, 0x080b0005u, "v_cmp_lt_i32",
+         5, 0, 0, 3, 1, 0, 0, 0, 6, 0, 1, 0, 0, 0},
+        {"v_cmp_lt_f32_sdwa vcc, -|v7|, v8 src0_sel:DWORD src1_sel:WORD_0",
+         0x7c8210f9u, 0x04360007u, "v_cmp_lt_f32",
+         7, 0, 0, 6, 0, 1, 1, 0, 8, 4, 0, 0, 0, 0},
+        {"v_cmp_eq_u16_sdwa vcc, v9, v10 src0_sel:BYTE_2 src1_sel:BYTE_1",
+         0x7d5414f9u, 0x01020009u, "v_cmp_eq_u16",
+         9, 0, 0, 2, 0, 0, 0, 0, 10, 1, 0, 0, 0, 0},
+        {"v_cmpx_lt_u32_sdwa s[20:21], v11, s12 src0_sel:WORD_0 "
+         "src1_sel:DWORD",
+         0x7db218f9u, 0x8604940bu, "v_cmpx_lt_u32",
+         11, 20, 1, 4, 0, 0, 0, 0, 12, 6, 0, 0, 0, 1},
+        {"v_cmp_class_f32_sdwa vcc, -v13, sext(v14) src0_sel:DWORD "
+         "src1_sel:BYTE_0",
+         0x7c201cf9u, 0x0816000du, "v_cmp_class_f32",
+         13, 0, 0, 6, 0, 1, 0, 0, 14, 0, 1, 0, 0, 0},
+        {"v_cmp_gt_u32_sdwa vcc, s3, v2 src0_sel:DWORD src1_sel:DWORD",
+         0x7d9804f9u, 0x06860003u, "v_cmp_gt_u32",
+         3, 0, 0, 6, 0, 0, 0, 1, 2, 6, 0, 0, 0, 0},
+    }};
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+
+    for (const auto &g : Golden) {
+        SCOPED_TRACE(g.asmText);
+
+        InFmt_VOP_SDWAB sdwab;
+        std::memcpy(&sdwab, &g.dword1, sizeof(sdwab));
+        EXPECT_EQ(sdwab.SRC0, g.src0);
+        EXPECT_EQ(sdwab.SDST, g.sdst);
+        EXPECT_EQ(sdwab.SD, g.sd);
+        EXPECT_EQ(sdwab.SRC0_SEL, g.src0Sel);
+        EXPECT_EQ(sdwab.SRC0_SEXT, g.src0Sext);
+        EXPECT_EQ(sdwab.SRC0_NEG, g.src0Neg);
+        EXPECT_EQ(sdwab.SRC0_ABS, g.src0Abs);
+        EXPECT_EQ(sdwab.S0, g.s0);
+        EXPECT_EQ(sdwab.SRC1_SEL, g.src1Sel);
+        EXPECT_EQ(sdwab.SRC1_SEXT, g.src1Sext);
+        EXPECT_EQ(sdwab.SRC1_NEG, g.src1Neg);
+        EXPECT_EQ(sdwab.SRC1_ABS, g.src1Abs);
+        EXPECT_EQ(sdwab.S1, g.s1);
+
+        InFmt_VOPC vopc;
+        std::memcpy(&vopc, &g.dword0, sizeof(vopc));
+        EXPECT_EQ(vopc.SRC0, REG_SRC_SWDA);
+        EXPECT_EQ(vopc.VSRC1, g.vsrc1);
+
+        InstFormat words[2] = {};
+        words[0].imm_u32 = g.dword0;
+        words[1].imm_u32 = g.dword1;
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), g.mnemonic);
+        // The SDWA marker in SRC0 is what makes the instruction 64 bits and
+        // flags it; a decoder that missed either would silently execute the
+        // second dword as the next instruction.
+        EXPECT_EQ(inst->instSize(), 8);
+        EXPECT_TRUE(inst->isSDWAInst());
+        EXPECT_FALSE(inst->isDPPInst());
+        EXPECT_EQ(inst->numSrcRegOperands(), 2);
+        EXPECT_EQ(inst->numDstRegOperands(), 1);
+    }
+}

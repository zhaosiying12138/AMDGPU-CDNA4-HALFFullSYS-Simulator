+// The SDWA select encoding, spelled out so a test failure names the case.
+constexpr unsigned Byte0 = 0, Byte1 = 1, Byte2 = 2, Byte3 = 3;
+constexpr unsigned Word0 = 4, Word1 = 5, Dword = 6;
+
+// Four distinct bytes, each with its own high bit set or clear, so an
+// off-by-one in the select or a mixed-up sign-extension source is visible.
+constexpr uint32_t Pattern = 0x91a27f84u;
+
+TEST(VopSemanticsTest, SdwaSelectNamesOneFieldEach)
+{
+    EXPECT_EQ(sdwaSelectWidth(Byte0), 8);
+    EXPECT_EQ(sdwaSelectWidth(Byte3), 8);
+    EXPECT_EQ(sdwaSelectWidth(Word0), 16);
+    EXPECT_EQ(sdwaSelectWidth(Word1), 16);
+    EXPECT_EQ(sdwaSelectWidth(Dword), 32);
+
+    EXPECT_EQ(sdwaSelectOffset(Byte0), 0);
+    EXPECT_EQ(sdwaSelectOffset(Byte1), 8);
+    EXPECT_EQ(sdwaSelectOffset(Byte2), 16);
+    EXPECT_EQ(sdwaSelectOffset(Byte3), 24);
+    EXPECT_EQ(sdwaSelectOffset(Word0), 0);
+    EXPECT_EQ(sdwaSelectOffset(Word1), 16);
+    EXPECT_EQ(sdwaSelectOffset(Dword), 0);
+
+    // Every select picks a different value out of the same dword. Asserting
+    // all four bytes together is what makes an off-by-one fail rather than
+    // merely shift which case is wrong.
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte0, false), 0x84u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte1, false), 0x7fu);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte2, false), 0xa2u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte3, false), 0x91u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Word0, false), 0x7f84u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Word1, false), 0x91a2u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Dword, false), Pattern);
+}
+
+TEST(VopSemanticsTest, SdwaSignExtendsFromTheSelectedFieldsOwnMsb)
+{
+    // Fields whose top bit is set extend; the one whose top bit is clear
+    // must not, or "sign extension" has degenerated into "always fill".
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte0, true), 0xffffff84u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte1, true), 0x0000007fu);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte2, true), 0xffffffa2u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Byte3, true), 0xffffff91u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Word0, true), 0x00007f84u);
+    EXPECT_EQ(sdwaExtendedSource(Pattern, Word1, true), 0xffff91a2u);
+
+    // A whole-dword select has nothing to extend and must be an exact
+    // identity for either setting of the bit.
+    EXPECT_EQ(sdwaExtendedSource(0xffffffffu, Dword, true), 0xffffffffu);
+    EXPECT_EQ(sdwaExtendedSource(0x7fffffffu, Dword, true), 0x7fffffffu);
+    EXPECT_EQ(sdwaExtendedSource(0x80000000u, Dword, false), 0x80000000u);
+}
+
+TEST(VopSemanticsTest, SdwaFloatModifiersTouchTheOperandSignBit)
+{
+    constexpr uint32_t One = 0x3f800000u;       // 1.0f
+    constexpr uint32_t MinusOne = 0xbf800000u;  // -1.0f
+
+    EXPECT_EQ(sdwaFloatModifiers(One, 32, false, false), One);
+    EXPECT_EQ(sdwaFloatModifiers(One, 32, false, true), MinusOne);
+    EXPECT_EQ(sdwaFloatModifiers(MinusOne, 32, true, false), One);
+    // ABS is applied before NEG, so both set reads as -|x|.
+    EXPECT_EQ(sdwaFloatModifiers(One, 32, true, true), MinusOne);
+    EXPECT_EQ(sdwaFloatModifiers(MinusOne, 32, true, true), MinusOne);
+
+    // An f16 operand's sign bit is bit 15, not bit 31.
+    EXPECT_EQ(sdwaFloatModifiers(0x3c00u, 16, false, true), 0xbc00u);
+    EXPECT_EQ(sdwaFloatModifiers(0xbc00u, 16, true, false), 0x3c00u);
+}
+
+TEST(VopSemanticsTest, SdwaNegationFlipsOnlyTheSignBit)
+{
+    // Negating by XOR-ing the mantissa/exponent instead of the sign bit, or
+    // by flipping the sign bit of the *selected field* rather than of the
+    // widened operand, both produce a plausible-looking float. Pin down the
+    // exact bits so neither can pass.
+    EXPECT_EQ(sdwaFloatModifiers(0x3f800000u, 32, false, true), 0xbf800000u);
+    EXPECT_NE(sdwaFloatModifiers(0x3f800000u, 32, false, true), 0x407fffffu);
+
+    // WORD_1 of -1.0f widens to 0x0000bf80; negating an f32 operand must set
+    // bit 31 of that widened value and leave bit 15 alone.
+    const uint32_t widened = sdwaExtendedSource(0xbf800000u, Word1, false);
+    EXPECT_EQ(widened, 0x0000bf80u);
+    EXPECT_EQ(sdwaFloatSource(0xbf800000u, Word1, 32, false, true),
+              0x8000bf80u);
+    EXPECT_NE(sdwaFloatSource(0xbf800000u, Word1, 32, false, true),
+              0x00003f80u);
+    // Likewise ABS clears bit 31, which is already clear here, so the
+    // widened value is unchanged rather than having its bit 15 cleared.
+    EXPECT_EQ(sdwaFloatSource(0xbf800000u, Word1, 32, true, false),
+              0x0000bf80u);
+}
+
+TEST(VopSemanticsTest, SdwaOperandBitsReinterpretRatherThanConvert)
+{
+    // 0x3f800000 is the encoding of 1.0f. Converting the integer instead of
+    // reinterpreting it yields ~1.065e9, which still compares consistently
+    // against other converted values and so would not show up as a
+    // contradiction anywhere downstream.
+    EXPECT_FLOAT_EQ(sdwaOperandBits<float>(0x3f800000u), 1.0f);
+    EXPECT_FLOAT_EQ(sdwaOperandBits<float>(0xbf800000u), -1.0f);
+
+    EXPECT_EQ(sdwaOperandBits<uint32_t>(0x91a27f84u), 0x91a27f84u);
+    EXPECT_EQ(sdwaOperandBits<int32_t>(0xffffff84u), -124);
+
+    // A narrow operand keeps the low bits of the widened dword, so a sign
+    // extended byte still reads as a negative 16-bit value.
+    EXPECT_EQ(sdwaOperandBits<uint16_t>(0x0001b384u), 0xb384u);
+    EXPECT_EQ(sdwaOperandBits<int16_t>(0xffffff84u),
+              static_cast<int16_t>(-124));
+    EXPECT_EQ(sdwaOperandBits<uint16_t>(sdwaExtendedSource(Pattern, Byte0,
+                                                           false)),
+              0x0084u);
+    EXPECT_EQ(sdwaOperandBits<int16_t>(sdwaExtendedSource(Pattern, Byte0,
+                                                          true)),
+              static_cast<int16_t>(0xff84));
+}
+
+TEST(VopSemanticsTest, SdwaIntegerCompareSeesTheSelectedFieldOnly)
+{
+    // The case that started this: v_cmp_gt_u32_sdwa reading byte 1 of two
+    // registers must compare 0x7f against 0x02, not the whole dwords, whose
+    // order is the opposite.
+    const uint32_t lhs = 0x91a27f84u;
+    const uint32_t rhs = 0xffff0200u;
+
+    const uint32_t a = sdwaIntegerSource(lhs, Byte1, false);
+    const uint32_t b = sdwaIntegerSource(rhs, Byte1, false);
+    EXPECT_EQ(a, 0x7fu);
+    EXPECT_EQ(b, 0x02u);
+    EXPECT_TRUE(a > b);
+    EXPECT_FALSE(lhs > rhs);
+
+    // With sign extension the same two bytes compare the other way round
+    // when read as signed 32-bit values.
+    EXPECT_EQ(sdwaIntegerSource(lhs, Byte0, true), 0xffffff84u);
+    EXPECT_LT(sdwaOperandBits<int32_t>(sdwaIntegerSource(lhs, Byte0, true)),
+              sdwaOperandBits<int32_t>(sdwaIntegerSource(rhs, Byte1, true)));
+}
+
+// The SDWA DST_UNUSED encoding, spelled out for the same reason as the
+// selects above.
+constexpr unsigned Pad = 0, Sext = 1, Preserve = 2;
+
+// A destination whose four bytes are all different, so a merge that keeps or
+// clears the wrong one is visible rather than merely plausible.
+constexpr uint32_t OldDst = 0xdeadbeefu;
+
+TEST(VopSemanticsTest, SdwaDwordDestinationIsTheWholeResult)
+{
+    // DST_SEL:DWORD occupies every bit, so DST_UNUSED names nothing. llvm-mc
+    // emits exactly `dst_sel:DWORD dst_unused:UNUSED_PRESERVE` whenever SDWA
+    // is needed only for the sources, and that form has to be the plain
+    // instruction -- if PRESERVE were honoured here it would keep the old
+    // destination and the write would vanish.
+    for (unsigned unused : {Pad, Sext, Preserve}) {
+        SCOPED_TRACE(unused);
+        EXPECT_EQ(sdwaDestMerge(0x12345678u, OldDst, Dword, unused),
+                  0x12345678u);
+        EXPECT_EQ(sdwaDestMerge(0u, OldDst, Dword, unused), 0u);
+        EXPECT_FALSE(sdwaDestIsReadModifyWrite(Dword, unused));
+    }
+}
+
+TEST(VopSemanticsTest, SdwaPreserveLeavesTheUntouchedBitsIntact)
+{
+    // This is the whole difficulty of the VOP1/VOP2 form: a byte insert
+    // rewrites one byte of the destination VGPR and every other bit has to
+    // survive unchanged. Getting it wrong corrupts three bytes the
+    // instruction never mentions, and nothing faults.
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte0, Preserve),
+              0xdeadbea5u);
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte1, Preserve),
+              0xdeada5efu);
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte2, Preserve),
+              0xdea5beefu);
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte3, Preserve),
+              0xa5adbeefu);
+    EXPECT_EQ(sdwaDestMerge(0x0000c3d4u, OldDst, Word0, Preserve),
+              0xdeadc3d4u);
+    EXPECT_EQ(sdwaDestMerge(0x0000c3d4u, OldDst, Word1, Preserve),
+              0xc3d4beefu);
+
+    // Only the bits of the result that fit in the field are used; the rest of
+    // an ALU result that is wider than the field is dropped, not smeared into
+    // the neighbouring bytes.
+    EXPECT_EQ(sdwaDestMerge(0x11223344u, OldDst, Byte1, Preserve),
+              0xdead44efu);
+    EXPECT_EQ(sdwaDestMerge(0x11223344u, OldDst, Word1, Preserve),
+              0x3344beefu);
+
+    // A preserving sub-dword write is the only case that has to read the
+    // destination first.
+    for (unsigned sel : {Byte0, Byte1, Byte2, Byte3, Word0, Word1}) {
+        SCOPED_TRACE(sel);
+        EXPECT_TRUE(sdwaDestIsReadModifyWrite(sel, Preserve));
+        EXPECT_FALSE(sdwaDestIsReadModifyWrite(sel, Pad));
+        EXPECT_FALSE(sdwaDestIsReadModifyWrite(sel, Sext));
+    }
+}
+
+TEST(VopSemanticsTest, SdwaPadClearsEveryBitOutsideTheField)
+{
+    // PAD ignores the old destination entirely, so the same call with two
+    // different previous values has to give the same answer.
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte2, Pad), 0x00a50000u);
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, 0u, Byte2, Pad), 0x00a50000u);
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte0, Pad), 0x000000a5u);
+    EXPECT_EQ(sdwaDestMerge(0x0000c3d4u, OldDst, Word1, Pad), 0xc3d40000u);
+    EXPECT_EQ(sdwaDestMerge(0x11223344u, OldDst, Byte3, Pad), 0x44000000u);
+}
+
+TEST(VopSemanticsTest, SdwaSextFillsAboveTheFieldAndZeroesBelow)
+{
+    // "Sign-extend upper bits, pad lower bits with 0" is what UNUSED_SEXT
+    // means. Filling downwards instead would scale the result by a power of
+    // two, which stays a plausible number.
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte1, Sext), 0xffffa500u);
+    EXPECT_EQ(sdwaDestMerge(0x000000a5u, OldDst, Byte2, Sext), 0xffa50000u);
+    EXPECT_EQ(sdwaDestMerge(0x0000c3d4u, OldDst, Word0, Sext), 0xffffc3d4u);
+
+    // The fill is driven by the result's own sign bit within the field, not
+    // by the sign of the full ALU result.
+    EXPECT_EQ(sdwaDestMerge(0x0000007fu, OldDst, Byte1, Sext), 0x00007f00u);
+    EXPECT_EQ(sdwaDestMerge(0xffffff7fu, OldDst, Byte1, Sext), 0x00007f00u);
+    EXPECT_EQ(sdwaDestMerge(0x00000080u, OldDst, Byte1, Sext), 0xffff8000u);
+
+    // The top field has nothing above it to extend, so SEXT and PAD agree
+    // there. Computing the fill mask by shifting a 32-bit one by 32 would be
+    // undefined behaviour and could produce 0xffffffff instead.
+    EXPECT_EQ(sdwaDestMerge(0x00000080u, OldDst, Byte3, Sext), 0x80000000u);
+    EXPECT_EQ(sdwaDestMerge(0x00008000u, OldDst, Word1, Sext), 0x80000000u);
+    EXPECT_EQ(sdwaDestMerge(0x00000080u, OldDst, Byte3, Pad),
+              sdwaDestMerge(0x00000080u, OldDst, Byte3, Sext));
+}
+
+TEST(VopSemanticsTest, SdwaResultBitsReinterpretRatherThanConvert)
+{
+    // A float result reaches the destination as its IEEE encoding.
+    EXPECT_EQ(sdwaResultBits<float>(1.0f), 0x3f800000u);
+    EXPECT_EQ(sdwaResultBits<float>(-1.0f), 0xbf800000u);
+    EXPECT_EQ(sdwaResultBits<int32_t>(-124), 0xffffff84u);
+
+    // A narrow result occupies only the low bits and leaves the rest zero,
+    // which is all a byte or word select looks at.
+    EXPECT_EQ(sdwaResultBits<uint16_t>(0xb384u), 0x0000b384u);
+    EXPECT_EQ(sdwaResultBits<int16_t>(static_cast<int16_t>(-1)), 0x0000ffffu);
+    EXPECT_EQ(sdwaDestMerge(sdwaResultBits<int16_t>(static_cast<int16_t>(-1)),
+                            OldDst, Word1, Preserve),
+              0xffffbeefu);
+}
+
+TEST(VopSemanticsTest, VopcWritesZeroForEveryInactiveLane)
+{
+    // A compare rebuilds the whole 64-bit mask; an inactive lane contributes
+    // a zero rather than keeping whatever the destination held before.
+    EXPECT_EQ(vopcLaneMask(0xffffffffffffffffull, 0x00000000000000ffull),
+              0x00000000000000ffull);
+    EXPECT_EQ(vopcLaneMask(0xa5a5a5a5a5a5a5a5ull, 0x0f0f0f0f0f0f0f0full),
+              0x0505050505050505ull);
+    EXPECT_EQ(vopcLaneMask(0xffffffffffffffffull, 0ull), 0ull);
+}
+
+TEST(VopSemanticsTest, FloatClassMatchesEachIsaClassBit)
+{
+    const float qnan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    const float denorm = std::numeric_limits<float>::denorm_min();
+
+    // Each class bit accepts its own class and rejects a neighbouring one.
+    EXPECT_TRUE(floatClassMatches(qnan, 1u << 1));
+    EXPECT_FALSE(floatClassMatches(inf, 1u << 1));
+    EXPECT_TRUE(floatClassMatches(-inf, 1u << 2));
+    EXPECT_FALSE(floatClassMatches(inf, 1u << 2));
+    EXPECT_TRUE(floatClassMatches(-1.0f, 1u << 3));
+    EXPECT_FALSE(floatClassMatches(1.0f, 1u << 3));
+    EXPECT_TRUE(floatClassMatches(-denorm, 1u << 4));
+    EXPECT_FALSE(floatClassMatches(denorm, 1u << 4));
+    EXPECT_TRUE(floatClassMatches(-0.0f, 1u << 5));
+    EXPECT_FALSE(floatClassMatches(0.0f, 1u << 5));
+    EXPECT_TRUE(floatClassMatches(0.0f, 1u << 6));
+    EXPECT_FALSE(floatClassMatches(-0.0f, 1u << 6));
+    EXPECT_TRUE(floatClassMatches(denorm, 1u << 7));
+    EXPECT_FALSE(floatClassMatches(-denorm, 1u << 7));
+    EXPECT_TRUE(floatClassMatches(1.0f, 1u << 8));
+    EXPECT_FALSE(floatClassMatches(-1.0f, 1u << 8));
+    EXPECT_TRUE(floatClassMatches(inf, 1u << 9));
+    EXPECT_FALSE(floatClassMatches(-inf, 1u << 9));
+
+    EXPECT_FALSE(floatClassMatches(1.0f, 0u));
+    EXPECT_TRUE(floatClassMatches(1.0f, 0x3ffu));
+
+    // A NEG modifier on the tested value changes which class it lands in,
+    // which is the whole reason v_cmp_class accepts one.
+    const float negated = sdwaOperandBits<float>(
+        sdwaFloatSource(0x3f800000u, Dword, 32, false, true));
+    EXPECT_TRUE(floatClassMatches(negated, 1u << 3));
+    EXPECT_FALSE(floatClassMatches(negated, 1u << 8));
+}
+
+
+/**
+ * The trigonometric opcodes take revolutions, not radians.
+ *
+ * The defect these pin was silent: the implementation substituted the inline
+ * constant register REG_PI (which holds 1/(2*pi), not pi) for the mathematical
+ * constant in "sin(S0 * 2 * PI)", so it evaluated sin(S0/pi) -- off by a
+ * factor of about 19.7 with no error of any kind. The opcode carries RoPE.
+ */
+TEST(VopSemantics, TrigTakesRevolutionsNotRadians)
+{
+    // Half a revolution is pi radians, so sine is ~0 and cosine is -1. Under
+    // the old scale, sin(0.5) would have been sin(0.5/pi) = 0.157...
+    EXPECT_NEAR(vop_semantics::vegaSinRevolutions(0.5f), 0.0f, 1e-6f);
+    EXPECT_NEAR(vop_semantics::vegaCosRevolutions(0.5f), -1.0f, 1e-6f);
+
+    // A quarter revolution: sin = 1, cos = 0.
+    EXPECT_NEAR(vop_semantics::vegaSinRevolutions(0.25f), 1.0f, 1e-6f);
+    EXPECT_NEAR(vop_semantics::vegaCosRevolutions(0.25f), 0.0f, 1e-6f);
+
+    // A whole revolution returns to the start; the old scale did not.
+    EXPECT_NEAR(vop_semantics::vegaSinRevolutions(1.0f), 0.0f, 1e-6f);
+    EXPECT_NEAR(vop_semantics::vegaCosRevolutions(1.0f), 1.0f, 1e-6f);
+
+    // The compiler emits a 1/(2*pi) pre-scale, so a HIP sinf(x) must come back
+    // as sin(x). This is the end-to-end property that was broken.
+    const float reciprocal = 0.15915494309189535f;
+    EXPECT_NEAR(vop_semantics::vegaSinRevolutions(2.0f * reciprocal),
+                std::sin(2.0f), 1e-6f);
+    EXPECT_NEAR(vop_semantics::vegaCosRevolutions(3.0f * reciprocal),
+                std::cos(3.0f), 1e-6f);
+}
+
+/**
+ * Out of range, sine returns 0.0 and cosine returns 1.0. The VOP1 cosine
+ * returned 0.0 and neither VOP3 form clamped at all, so one opcode disagreed
+ * with itself depending on which encoding the compiler chose.
+ */
+TEST(VopSemantics, TrigOutOfRangeConstantsDiffer)
+{
+    EXPECT_FLOAT_EQ(vop_semantics::vegaSinRevolutions(256.5f), 0.0f);
+    EXPECT_FLOAT_EQ(vop_semantics::vegaSinRevolutions(-256.5f), 0.0f);
+    EXPECT_FLOAT_EQ(vop_semantics::vegaCosRevolutions(256.5f), 1.0f);
+    EXPECT_FLOAT_EQ(vop_semantics::vegaCosRevolutions(-256.5f), 1.0f);
+
+    // The boundary itself is in range and must still be computed.
+    EXPECT_NEAR(vop_semantics::vegaCosRevolutions(256.0f), 1.0f, 1e-4f);
+    EXPECT_NEAR(vop_semantics::vegaSinRevolutions(-256.0f), 0.0f, 1e-4f);
+}
+

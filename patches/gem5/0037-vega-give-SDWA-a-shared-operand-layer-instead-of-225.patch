+enum SdwaDstUnusedVals : unsigned
+{
+    SDWA_DST_UNUSED_PAD = 0,
+    SDWA_DST_UNUSED_SEXT = 1,
+    SDWA_DST_UNUSED_PRESERVE = 2
+};
+
+/**
+ * Place an ALU result into the field named by DST_SEL and fill the rest of
+ * the destination dword according to DST_UNUSED.
+ *
+ *   PAD       every bit outside the field becomes 0.
+ *   SEXT      the bits *above* the field copy the field's own sign bit; the
+ *             bits below it are still zeroed. "Sign-extend upper, pad lower"
+ *             is what the field name means, and getting it wrong in the
+ *             other direction produces a number that is merely scaled, which
+ *             no downstream check would flag.
+ *   PRESERVE  every bit outside the field keeps its previous value, so the
+ *             write is a read-modify-write of the destination VGPR. This is
+ *             the mode LLVM emits for a byte insert, and a wrong PRESERVE
+ *             silently corrupts three bytes the instruction never mentions.
+ *
+ * A DWORD select occupies the whole register, so DST_UNUSED cannot name any
+ * bits and is ignored -- llvm-mc still prints one, and the canonical
+ * `dst_sel:DWORD dst_unused:UNUSED_PRESERVE` pair it emits when SDWA is used
+ * only for the sources must be exactly the plain instruction.
+ *
+ * Matches AMD's generated reference model, rocm-systems/emulation/rocjitsu
+ * shared/dpp_sdwa_ops.h sdwa_dst_merge().
+ */
+inline uint32_t
+sdwaDestMerge(uint32_t result, uint32_t oldDst, unsigned dstSel,
+              unsigned dstUnused)
+{
+    const int width = sdwaSelectWidth(dstSel);
+    if (width == 32)
+        return result;
+
+    const int offset = sdwaSelectOffset(dstSel);
+    const uint32_t fieldMask = (1u << width) - 1;
+    const uint32_t placedMask = fieldMask << offset;
+    const uint32_t placed = (result & fieldMask) << offset;
+
+    uint32_t fill = 0;
+    if (dstUnused == SDWA_DST_UNUSED_PRESERVE) {
+        fill = oldDst & ~placedMask;
+    } else if (dstUnused == SDWA_DST_UNUSED_SEXT
+               && ((result >> (width - 1)) & 1u)) {
+        // The shift reaches 32 for BYTE_3 and WORD_1, which is undefined on a
+        // 32-bit type; widening first makes those cases fill nothing, which is
+        // correct because there is no bit above the field to fill.
+        fill = static_cast<uint32_t>(
+            ~((static_cast<uint64_t>(1) << (offset + width)) - 1));
+    }
+
+    return fill | placed;
+}
+
+/**
+ * Whether an SDWA destination write has to read the destination register
+ * first. Only PRESERVE with a real sub-dword field does; every other
+ * combination fully determines all 32 bits from the result alone, and reading
+ * the destination needlessly would add a dependency the hardware does not
+ * have.
+ */
+inline bool

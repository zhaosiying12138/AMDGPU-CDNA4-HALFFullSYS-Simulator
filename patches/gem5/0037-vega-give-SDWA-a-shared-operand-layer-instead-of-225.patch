+TEST(FlatLdsDecodeTest, NoRegisterDestination)
+{
+    for (const LdsOpcode &op : GlobalLdsOpcodes) {
+        SCOPED_TRACE(op.mnemonic);
+        auto inst = decodeGfx950(op.word0, GoldenWord1Saddr);
+        ASSERT_NE(inst, nullptr);
+
+        // The data goes to LDS, addressed by M0. There is no VDST.
+        EXPECT_EQ(inst->numDstRegOperands(), 0);
+        EXPECT_EQ(inst->numSrcRegOperands(), 2);
+        EXPECT_EQ(inst->getNumOperands(), 2);
+    }
+}
+
+TEST(FlatLdsDecodeTest, DisassemblyDoesNotIndexAMissingDestination)
+{
+    // This is the negative control for the vLLM TP1 abort. Before the fix,
+    // generateGlobalScratchDisassembly() asked for operand
+    // numSrcRegOperands() == 2 on an instruction with two operands, and
+    // Inst_FLAT__FLAT_LOAD_LDS_*::getOperandSize() called
+    //     fatal("op idx %i out of bounds\n", opIdx)
+    // killing the simulator before the caller's panic could even print.
+    for (const LdsOpcode &op : GlobalLdsOpcodes) {
+        SCOPED_TRACE(op.mnemonic);
+        auto inst = decodeGfx950(op.word0, GoldenWord1Saddr);
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->disassemble(), std::string(op.disassembly));
+    }
+}
+
+TEST(FlatLdsDecodeTest, DisassemblyWithoutSaddrUsesAVgprPair)
+{
+    auto inst = decodeGfx950(0xddf48010, GoldenWord1NoSaddr);
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "flat_load_lds_dwordx4");
+    EXPECT_EQ(inst->disassemble(),
+              "global_load_lds_dwordx4 v[2:3], off offset:16");
+    // vgprIsOffset() is false, so the address operand is a 64-bit pair.
+    EXPECT_EQ(inst->getOperandSize(0), 8);
+}

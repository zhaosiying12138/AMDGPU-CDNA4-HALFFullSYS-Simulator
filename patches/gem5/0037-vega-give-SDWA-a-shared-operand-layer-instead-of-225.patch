+ * the same thing: inline constant 248 is 1/(2*pi) = 0x3e22f983, so the model
+ * evaluated sin(S0 / pi) -- wrong by a factor of 2*pi^2, about 19.7. Nothing
+ * faults; the numbers are simply wrong, and this opcode carries RoPE, which
+ * measured about a third of one run's simulated execution.
+ *
+ * Confirmed against AMD's own generated reference emulator, which multiplies
+ * by TWO_PI and states "The AMD ISA computes cos(2*pi*x), NOT cos(x)"
+ * (projects/rocm-systems/emulation/rocjitsu,
+ * .../amdgpu/shared/transcendental.h).
+ */
+constexpr double VEGA_TRIG_REVOLUTION = 6.283185307179586476925286766559;
+
+/**
+ * Out-of-range results for the trigonometric opcodes.
+ *
+ * The valid input domain is [-256.0, +256.0] revolutions; outside it the
+ * hardware returns a fixed value rather than a computed one -- 0.0 for sine
+ * and, note, **1.0** for cosine. The VOP1 cosine returned 0.0 and neither VOP3
+ * form clamped at all, so the same opcode disagreed with itself depending on
+ * which encoding the compiler picked.
+ */
+inline float
+vegaSinRevolutions(float source)
+{
+    if (source < -256.0f || source > 256.0f) {
+        return 0.0f;
+    }
+    return std::sin(source * (float)VEGA_TRIG_REVOLUTION);
+}
+
+inline float
+vegaCosRevolutions(float source)
+{
+    if (source < -256.0f || source > 256.0f) {
+        return 1.0f;
+    }
+    return std::cos(source * (float)VEGA_TRIG_REVOLUTION);
+}
+
 } // namespace vop_semantics
 } // namespace VegaISA
 } // namespace gem5

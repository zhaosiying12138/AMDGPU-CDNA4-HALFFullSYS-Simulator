+// ---------------------------------------------------------------------
+// Destination address
+// ---------------------------------------------------------------------
+
+TEST(FlatLdsTest, M0IsUsedWholeAndUnrounded)
+{
+    // Regression: an earlier implementation computed
+    // bits(m0, 17, 2) * 4, which both truncated M0 to 18 bits and forced it
+    // to a dword boundary. Either one silently relocates data.
+    EXPECT_EQ(flat_lds::destAddr(0x00000000u), 0x00000000u);
+    EXPECT_EQ(flat_lds::destAddr(0x00000001u), 0x00000001u);
+    EXPECT_EQ(flat_lds::destAddr(0x00000002u), 0x00000002u);
+    EXPECT_EQ(flat_lds::destAddr(0x00000003u), 0x00000003u);
+    EXPECT_EQ(flat_lds::destAddr(0x00027ffcu), 0x00027ffcu);
+
+    // 160 KiB is the gfx950 per-workgroup LDS size; an address just inside
+    // it must survive intact rather than being masked into a lower slot.
+    EXPECT_EQ(flat_lds::destAddr(160u * 1024u - 4u), 160u * 1024u - 4u);
+
+    // A value wider than any LDS must NOT be folded back into range. It has
+    // to stay out of range so LdsChunk::write() can drop it.
+    EXPECT_EQ(flat_lds::destAddr(0x7fffffffu), 0x7fffffffu);
+    EXPECT_EQ(flat_lds::destAddr(0xdeadbeefu), 0xdeadbeefu);
+}
+
+TEST(FlatLdsTest, SignExtension)
+{
+    EXPECT_EQ(flat_lds::signExtend(0x000000ffu, 0), 0x000000ffu);
+    EXPECT_EQ(flat_lds::signExtend(0x0000007fu, 8), 0x0000007fu);
+    EXPECT_EQ(flat_lds::signExtend(0x00000080u, 8), 0xffffff80u);
+    EXPECT_EQ(flat_lds::signExtend(0x000000ffu, 8), 0xffffffffu);
+    EXPECT_EQ(flat_lds::signExtend(0x00007fffu, 16), 0x00007fffu);
+    EXPECT_EQ(flat_lds::signExtend(0x00008000u, 16), 0xffff8000u);
+    EXPECT_EQ(flat_lds::signExtend(0x0000ffffu, 16), 0xffffffffu);
+}
+
+TEST(FlatLdsTest, SubDwordPayloadWideningIsPerLaneAndExtends)
+{
+    // initMemRead<T> packs lane N's datum at byte offset N*sizeof(T). Reading
+    // that as a dword array gives lane N bytes [4N..4N+3] -- wrong for every
+    // lane but zero, and past the populated region entirely for lane >= 16.
+    {
+        std::vector<uint8_t> buf(WfSize * sizeof(uint32_t), 0);
+        for (int lane = 0; lane < WfSize; ++lane) {
+            buf[lane] = static_cast<uint8_t>(0x80 + lane);
+        }
+        flat_lds::widen<uint8_t>(buf.data(), WfSize, ~0ull);
+        auto *wide = reinterpret_cast<uint32_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            EXPECT_EQ(wide[lane],
+                      static_cast<uint32_t>((0x80 + lane) & 0xff))
+                << "ubyte lane " << lane;
+        }
+    }
+    {
+        std::vector<uint8_t> buf(WfSize * sizeof(uint32_t), 0);
+        auto *narrow = reinterpret_cast<int8_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            narrow[lane] = static_cast<int8_t>(-1 - lane);
+        }
+        flat_lds::widen<int8_t>(buf.data(), WfSize, ~0ull);
+        auto *wide = reinterpret_cast<uint32_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            EXPECT_EQ(wide[lane], static_cast<uint32_t>(
+                          static_cast<int32_t>(
+                              static_cast<int8_t>(-1 - lane))))
+                << "sbyte lane " << lane;
+        }
+    }
+    {
+        std::vector<uint8_t> buf(WfSize * sizeof(uint32_t), 0);
+        auto *narrow = reinterpret_cast<uint16_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            narrow[lane] = static_cast<uint16_t>(0x8000 + lane);
+        }
+        flat_lds::widen<uint16_t>(buf.data(), WfSize, ~0ull);
+        auto *wide = reinterpret_cast<uint32_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            EXPECT_EQ(wide[lane], static_cast<uint32_t>(0x8000 + lane));
+        }
+    }
+    {
+        std::vector<uint8_t> buf(WfSize * sizeof(uint32_t), 0);
+        auto *narrow = reinterpret_cast<int16_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            narrow[lane] = static_cast<int16_t>(-1 - lane);
+        }
+        flat_lds::widen<int16_t>(buf.data(), WfSize, ~0ull);
+        auto *wide = reinterpret_cast<uint32_t *>(buf.data());
+        for (int lane = 0; lane < WfSize; ++lane) {
+            EXPECT_EQ(wide[lane], static_cast<uint32_t>(
+                          static_cast<int32_t>(
+                              static_cast<int16_t>(-1 - lane))));
+        }
+    }
+}
+
+// ---------------------------------------------------------------------
+// Per-lane slot pitch
+// ---------------------------------------------------------------------
+
+TEST(FlatLdsTest, LaneSlotIsFourBytesForNarrowLoads)
+{
+    // ubyte / sbyte / ushort / sshort / dword all occupy one 4-byte slot.
+    for (int lane = 0; lane < WfSize; ++lane) {
+        EXPECT_EQ(flat_lds::laneAddr(0x1000u, lane, 4),
+                  0x1000u + 4u * lane);
+    }
+}
+
+TEST(FlatLdsTest, LaneSlotIsSixteenBytesForWideLoads)
+{
+    // dwordx3 and dwordx4 both occupy one 16-byte slot. dwordx3 is the trap:
+    // its payload is 12 bytes but its pitch is 16.
+    for (int lane = 0; lane < WfSize; ++lane) {
+        EXPECT_EQ(flat_lds::laneAddr(0x2000u, lane, 16),
+                  0x2000u + 16u * lane);
+    }
+
+    // The whole wave spans 64 * 16 = 1 KiB regardless of x3 vs x4.
+    EXPECT_EQ(flat_lds::laneAddr(0u, WfSize, 16), 1024u);
+}
+
+TEST(FlatLdsTest, DwordX4PlacementMatchesOracle)
+{
+    const uint32_t base = 0x400u;
+    const auto data = makePayload(4);
+    const auto writes = runScatter(base, 4, 16, 0, data, ~0ull);
+
+    ASSERT_EQ(writes.size(), static_cast<size_t>(WfSize * 4));
+    for (int lane = 0; lane < WfSize; ++lane) {
+        for (int d = 0; d < 4; ++d) {
+            const LdsWrite &w = writes[lane * 4 + d];
+            EXPECT_EQ(w.addr, base + 16u * lane + 4u * d)
+                << "lane " << lane << " dword " << d;
+            EXPECT_EQ(w.value, data[lane * 4 + d]);
+        }
+    }
+}
+
+TEST(FlatLdsTest, DwordX3UsesSixteenBytePitchAndLeavesTheFourthDword)
+{
+    // If the pitch were the 12-byte payload, lane 1 would start at base+12.
+    // Every lane but zero would be misplaced and the wave would overrun its
+    // 1 KiB region by nothing -- i.e. it would look entirely reasonable.
+    const uint32_t base = 0x800u;
+    const auto data = makePayload(3);
+    const auto writes = runScatter(base, 3, 16, 0, data, ~0ull);
+
+    ASSERT_EQ(writes.size(), static_cast<size_t>(WfSize * 3));
+
+    EXPECT_EQ(writes[0].addr, base + 0u);
+    EXPECT_EQ(writes[1].addr, base + 4u);
+    EXPECT_EQ(writes[2].addr, base + 8u);
+    // Lane 1 starts a fresh 16-byte slot, not at base+12.
+    EXPECT_EQ(writes[3].addr, base + 16u);
+    EXPECT_NE(writes[3].addr, base + 12u);
+
+    for (int lane = 0; lane < WfSize; ++lane) {
+        for (int d = 0; d < 3; ++d) {
+            EXPECT_EQ(writes[lane * 3 + d].addr, base + 16u * lane + 4u * d);
+            EXPECT_EQ(writes[lane * 3 + d].value, data[lane * 3 + d]);
+        }
+    }
+
+    // The fourth dword of every slot must never be written.
+    for (const LdsWrite &w : writes) {
+        EXPECT_NE((w.addr - base) % 16u, 12u)
+            << "wrote the reserved fourth dword at " << w.addr;
+    }
+}
+
+TEST(FlatLdsTest, DwordPlacementMatchesOracle)
+{
+    const uint32_t base = 0x40u;
+    const auto data = makePayload(1);
+    const auto writes = runScatter(base, 1, 4, 0, data, ~0ull);
+
+    ASSERT_EQ(writes.size(), static_cast<size_t>(WfSize));
+    for (int lane = 0; lane < WfSize; ++lane) {
+        EXPECT_EQ(writes[lane].addr, base + 4u * lane);
+        EXPECT_EQ(writes[lane].value, data[lane]);
+    }
+}
+
+// ---------------------------------------------------------------------
+// Lane masking
+// ---------------------------------------------------------------------
+
+TEST(FlatLdsTest, InactiveLanesLeaveHolesRatherThanCompacting)
+{
+    // Sparse mask: lanes 0, 5, 31, 63.
+    const uint64_t mask = (1ull << 0) | (1ull << 5) | (1ull << 31) |
+                          (1ull << 63);
+    const uint32_t base = 0x100u;
+    const auto data = makePayload(4);
+    const auto writes = runScatter(base, 4, 16, 0, data, mask);
+
+    ASSERT_EQ(writes.size(), 16u); // 4 lanes * 4 dwords
+
+    const int active[4] = {0, 5, 31, 63};
+    for (int i = 0; i < 4; ++i) {
+        const int lane = active[i];
+        for (int d = 0; d < 4; ++d) {
+            const LdsWrite &w = writes[i * 4 + d];
+            // Positional: lane 5 lands at base + 80, NOT at base + 16
+            // (which is where a prefix-compacted second active lane would
+            // go).
+            EXPECT_EQ(w.addr, base + 16u * lane + 4u * d);
+            EXPECT_EQ(w.value, data[lane * 4 + d]);
+        }
+    }
+
+    // Explicitly: nothing at all was written to any inactive lane's slot.
+    for (const LdsWrite &w : writes) {
+        const uint32_t slot = (w.addr - base) / 16u;
+        EXPECT_TRUE((mask >> slot) & 1ull)
+            << "wrote into inactive lane slot " << slot;
+    }
+}
+
+TEST(FlatLdsTest, EmptyExecMaskWritesNothing)
+{
+    const auto data = makePayload(4);
+    EXPECT_TRUE(runScatter(0x100u, 4, 16, 0, data, 0ull).empty());
+}
+
+TEST(FlatLdsTest, SingleLaneDoesNotDependOnItsIndexBeingZero)
+{
+    const uint32_t base = 0x300u;
+    const auto data = makePayload(1);
+    const auto writes = runScatter(base, 1, 4, 0, data, 1ull << 17);
+
+    ASSERT_EQ(writes.size(), 1u);
+    EXPECT_EQ(writes[0].addr, base + 4u * 17u);
+    EXPECT_EQ(writes[0].value, data[17]);
+}
+
+// ---------------------------------------------------------------------
+// Golden LDS image against an independent CPU oracle
+// ---------------------------------------------------------------------
+
+TEST(FlatLdsTest, GoldenLdsImageDwordX4)
+{
+    // Model a 4 KiB LDS chunk, apply the scatter, and compare against an
+    // image built by a separate, deliberately naive oracle.
+    constexpr uint32_t LdsBytes = 4096;
+    const uint32_t base = 0x200u;
+    const uint64_t mask = 0x0f0f0f0f0f0f0f0full;
+    const auto data = makePayload(4);
+
+    std::vector<uint8_t> image(LdsBytes, 0xcd);
+    flat_lds::scatter(base, 4, 16, 0, data.data(), WfSize, mask,
+                      [&image](uint32_t addr, uint32_t value) {
+                          if (addr + 4 <= LdsBytes) {
+                              image[addr + 0] = value & 0xff;
+                              image[addr + 1] = (value >> 8) & 0xff;
+                              image[addr + 2] = (value >> 16) & 0xff;
+                              image[addr + 3] = (value >> 24) & 0xff;
+                          }
+                      });
+
+    std::vector<uint8_t> oracle(LdsBytes, 0xcd);
+    for (int lane = 0; lane < WfSize; ++lane) {
+        if (!((mask >> lane) & 1ull)) {
+            continue;
+        }
+        for (int d = 0; d < 4; ++d) {
+            const uint32_t a = base + 16u * lane + 4u * d;
+            const uint32_t v = 0xa5000000u |
+                               (static_cast<uint32_t>(lane) << 8) |
+                               static_cast<uint32_t>(d);
+            if (a + 4 <= LdsBytes) {
+                oracle[a + 0] = v & 0xff;
+                oracle[a + 1] = (v >> 8) & 0xff;
+                oracle[a + 2] = (v >> 16) & 0xff;
+                oracle[a + 3] = (v >> 24) & 0xff;
+            }
+        }
+    }
+
+    EXPECT_EQ(image, oracle);
+
+    // And the untouched region really is untouched.
+    for (uint32_t a = 0; a < base; ++a) {
+        EXPECT_EQ(image[a], 0xcd) << "clobbered byte below base at " << a;
+    }
+}
+
+// ---------------------------------------------------------------------
+// Decode, flags and disassembly
+// ---------------------------------------------------------------------
+
+namespace
+{
+
+struct LdsOpcode
+{
+    uint32_t word0;
+    const char *mnemonic;
+    const char *disassembly;
+};
+
+// Golden gfx950 encodings from llvm-mc for
+//   <op> v2, s[0:1] offset:16
+// word1 is 0x00000002 in every case: ADDR=v2, DATA=0, SADDR=s0, VDST=0.
+constexpr uint32_t GoldenWord1Saddr = 0x00000002;
+
+// SADDR=0x7f ("off"), 64-bit vaddr in v[2:3].
+constexpr uint32_t GoldenWord1NoSaddr = 0x007f0002;
+
+const LdsOpcode GlobalLdsOpcodes[] = {
+    {0xdc988010, "flat_load_lds_ubyte",
+     "global_load_lds_ubyte v2, s[0:1] offset:16"},
+    {0xdc9c8010, "flat_load_lds_sbyte",
+     "global_load_lds_sbyte v2, s[0:1] offset:16"},
+    {0xdca08010, "flat_load_lds_ushort",
+     "global_load_lds_ushort v2, s[0:1] offset:16"},
+    {0xdca48010, "flat_load_lds_sshort",
+     "global_load_lds_sshort v2, s[0:1] offset:16"},
+    {0xdca88010, "flat_load_lds_dword",
+     "global_load_lds_dword v2, s[0:1] offset:16"},
+    {0xddf88010, "flat_load_lds_dwordx3",
+     "global_load_lds_dwordx3 v2, s[0:1] offset:16"},
+    {0xddf48010, "flat_load_lds_dwordx4",
+     "global_load_lds_dwordx4 v2, s[0:1] offset:16"},
+};
+
+std::unique_ptr<GPUStaticInst>
+decodeGfx950(uint32_t word0, uint32_t word1)
+{
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+
+    InstFormat words[2] = {};
+    words[0].imm_u32 = word0;
+    words[1].imm_u32 = word1;
+
+    return std::unique_ptr<GPUStaticInst>(decoder.decode(words));
+}
+
+} // namespace
+
+TEST(FlatLdsDecodeTest, EveryGlobalLdsOpcodeDecodes)
+{
+    for (const LdsOpcode &op : GlobalLdsOpcodes) {
+        SCOPED_TRACE(op.mnemonic);
+        auto inst = decodeGfx950(op.word0, GoldenWord1Saddr);
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), op.mnemonic);
+        EXPECT_EQ(inst->instSize(), 8);
+    }
+}
+
+TEST(FlatLdsDecodeTest, FlagsRouteToTheVectorGlobalMemoryPipe)
+{
+    for (const LdsOpcode &op : GlobalLdsOpcodes) {
+        SCOPED_TRACE(op.mnemonic);
+        auto inst = decodeGfx950(op.word0, GoldenWord1Saddr);
+        ASSERT_NE(inst, nullptr);
+
+        // MemoryRef gates the EXEC snapshot in ScheduleStage, the
+        // classification in dispatchReady()/reserveResources(), and the
+        // zero-EXEC cleanup in cancelZeroLaneMemoryInstruction().
+        EXPECT_TRUE(inst->isMemRef());
+        EXPECT_TRUE(inst->isLoad());
+        EXPECT_FALSE(inst->isStore());
+        EXPECT_FALSE(inst->isAtomic());
+        EXPECT_FALSE(inst->isScalar());
+
+        // SEG=2 -> FlatGlobal, and with MemoryRef that makes isGlobalMem()
+        // true, which is the branch dispatchReady() needs.
+        EXPECT_TRUE(inst->isFlatGlobal());
+        EXPECT_FALSE(inst->isFlatScratch());
+        EXPECT_FALSE(inst->isFlat());
+        EXPECT_TRUE(inst->isGlobalMem());
+
+        // GroupSegment must stay clear even though the destination is LDS:
+        // an LDS-DMA load is observed through vmcnt, not lgkmcnt
+        // (FLATInstructions.td sets LGKM_CNT = 0 for these pseudos). Setting
+        // it would send ScheduleStage down the LGKM branch and leave vmcnt
+        // to underflow when GlobalMemPipeline::exec() retires the
+        // instruction.
+        EXPECT_FALSE(inst->isGroupSeg());
+        EXPECT_FALSE(inst->isLocalMem());
+    }
+}

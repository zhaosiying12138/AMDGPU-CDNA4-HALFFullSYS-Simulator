+    if (success)
+        storeBytes(payload, 104, response.imageSha256);
+    store32(payload, 136, success ? 0 : response.errorCode);
+    store32(payload, 140, 0);
+    Header encoded = request;
+    encoded.messageType = MessageType::CodeObjectAck;
+    return encodeFrame(encoded, payload);
+}

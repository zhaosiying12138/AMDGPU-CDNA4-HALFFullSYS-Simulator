+
+    image = imageBytes();
+    put64(image, 0x680 + 32, 0x1610);
+    EXPECT_FALSE(validateCodeObjectImage(image, expected));
+
+    image = imageBytes();
+    image[0x214] = 0x80;
+    EXPECT_FALSE(validateCodeObjectImage(image, expected));
+
+    image = imageBytes();
+    image[0x500] ^= 1;
+    EXPECT_FALSE(validateCodeObjectImage(image, expected));
+
+    auto wrongKernel = expected;
+    wrongKernel.kernelIndex = 1;
+    EXPECT_FALSE(validateCodeObjectImage(imageBytes(), wrongKernel));
+
+    auto wrongVersion = expected;
+    wrongVersion.codeObjectVersion = 5;
+    EXPECT_FALSE(validateCodeObjectImage(imageBytes(), wrongVersion));
+}

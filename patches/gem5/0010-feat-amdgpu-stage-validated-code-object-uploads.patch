+void
+HostGPUBridge::processCodeObjectRecord(const PendingRecord &record)
+{
+    auto found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &client = *found->second;
+    const auto decoded = protocol::decodeCodeObjectRequestRecord(
+        record.bytes.data(), record.bytes.size(), maximumRecord);
+    if (decoded.action == protocol::DecodeAction::Drop) {
+        if (decoded.closeConnection)
+            closeClient(record.clientFd);
+        return;
+    }
+
+    protocol::Status sessionStatus = protocol::Status::Ok;
+    const bool codeObjectSelected =
+        (client.selectedCapabilities[
+             protocol::CodeObjectTransferCapabilityByte] &
+         protocol::CodeObjectTransferCapabilityMask) != 0;
+    if (decoded.header.daemonUuid != identity.daemonUuid) {
+        sessionStatus = protocol::Status::InstanceMismatch;
+    } else if (decoded.header.connectionId != client.connectionId) {
+        sessionStatus = protocol::Status::ProtocolState;
+    } else if (decoded.header.jobEpoch != identity.jobEpoch) {
+        sessionStatus = protocol::Status::ProtocolState;
+    } else if (!codeObjectSelected) {
+        sessionStatus = protocol::Status::UnsupportedCapability;
+    }
+    protocol::Status status = codeObjectRequestStatus(
+        decoded.status, sessionStatus);
+    if (status == protocol::Status::Ok &&
+        client.requestIds.observe(decoded.header.requestId) !=
+            RequestIdResult::Fresh) {
+        status = protocol::Status::ProtocolState;
+    }
+
+    protocol::CodeObjectResponse response =
+        HostGPUCodeObjectState::failureResponse(
+            decoded.request, status, curTick());
+    /* A correlated payload or request-ID failure poisons the mutable upload.
+     * Session identity/capability failures must not mutate a transaction. */
+    if (sessionStatus == protocol::Status::Ok) {
+        const HostGPUCodeObjectState::Owner owner{
+            record.clientFd, record.generation};
+        if (status == protocol::Status::Ok) {
+            response = codeObjectState.submit(
+                owner, decoded.request, curTick()).response;
+        } else if (decoded.status != protocol::Status::Ok ||
+                   status == protocol::Status::ProtocolState) {
+            codeObjectState.abortMutable(owner);
+        }
+    }
+
+    found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    found->second->state.finishEstablishedRecord();
+    const auto responseHeader = protocol::queueResponseHeader(
+        decoded.header, identity, found->second->connectionId);
+    auto encoded = protocol::encodeCodeObjectAck(responseHeader, response);
+    OutboundRecord outbound;
+    outbound.bytes = std::move(encoded);
+    outbound.kind = OutboundKind::CodeObjectAck;
+    outbound.status = response.status;
+    outbound.success = response.status == protocol::Status::Ok;
+    enqueueOutbound(record.clientFd, record.generation, std::move(outbound));
+}

+        }
+        const auto manifestStatus =
+            validateCodeObjectManifest(request.manifest);
+        if (manifestStatus != CodeObjectManifestValidation::Valid) {
+            return acknowledge(
+                manifestStatus == CodeObjectManifestValidation::UnsupportedVersion ?
+                    Status::UnsupportedVersion :
+                manifestStatus == CodeObjectManifestValidation::TopologyMismatch ?
+                    Status::TopologyMismatch : Status::Malformed,

+bool
+powerOfTwoOrZero(uint64_t value)
+{
+    return value == 0 || (value & (value - 1)) == 0;
+}
+
+bool
+rangeEnd(uint64_t start, uint64_t length, uint64_t &end)
+{
+    if (length > std::numeric_limits<uint64_t>::max() - start)
+        return false;
+    end = start + length;
+    return true;
+}
+
+bool
+rangeWithin(uint64_t start, uint64_t length, uint64_t containerStart,
+            uint64_t containerLength)
+{
+    uint64_t end = 0;
+    uint64_t containerEnd = 0;
+    return start >= containerStart && rangeEnd(start, length, end) &&
+        rangeEnd(containerStart, containerLength, containerEnd) &&
+        end <= containerEnd;
+}
+
+bool
+rangesOverlap(uint64_t leftStart, uint64_t leftLength,
+              uint64_t rightStart, uint64_t rightLength)
+{
+    uint64_t leftEnd = 0;
+    uint64_t rightEnd = 0;
+    if (!rangeEnd(leftStart, leftLength, leftEnd) ||
+        !rangeEnd(rightStart, rightLength, rightEnd)) {
+        return true;
+    }
+    return leftStart < rightEnd && rightStart < leftEnd;
+}
+
+template <size_t N>
+bool
+codeObjectNulPaddedAscii(const std::array<uint8_t, N> &text)
+{
+    const auto nul = std::find(text.begin(), text.end(), uint8_t(0));
+    if (nul == text.begin() || nul == text.end())
+        return false;
+    if (!std::all_of(text.begin(), nul,
+                     [](uint8_t byte) { return byte < 0x80; })) {
+        return false;
+    }
+    return std::all_of(nul + 1, text.end(),
+                       [](uint8_t byte) { return byte == 0; });
+}
+
+bool
+signedEntryRelationValid(const CodeObjectManifest &manifest)
+{
+    const int64_t offset = manifest.kernelCodeEntryByteOffset;
+    if (offset >= 0) {
+        const uint64_t positive = static_cast<uint64_t>(offset);
+        return manifest.descriptorVirtualAddress <=
+                std::numeric_limits<uint64_t>::max() - positive &&
+            manifest.descriptorVirtualAddress + positive ==
+                manifest.codeVirtualAddress;
+    }
+
+    /* -(INT64_MIN) is not representable; this form computes its magnitude
+     * without signed overflow. */
+    const uint64_t magnitude = static_cast<uint64_t>(-(offset + 1)) + 1;
+    return magnitude <= manifest.descriptorVirtualAddress &&
+        manifest.descriptorVirtualAddress - magnitude ==
+            manifest.codeVirtualAddress;
+}

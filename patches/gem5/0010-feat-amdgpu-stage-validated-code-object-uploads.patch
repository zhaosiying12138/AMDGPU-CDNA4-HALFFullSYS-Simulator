+    if (request.major != CodeObjectTransferMajor ||
+        request.minor != CodeObjectTransferMinor) {
+        return acknowledge(Status::UnsupportedVersion,
+                           "unsupported code-object transfer version");
+    }
+    return acknowledge(Status::Ok, "valid code-object request");
+}

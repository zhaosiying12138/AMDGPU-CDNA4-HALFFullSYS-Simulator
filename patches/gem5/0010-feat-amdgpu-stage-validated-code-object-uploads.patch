+    if (!validCodeObjectOpcode(rawOpcode) || request.flags != 0 ||
+        request.reserved != 0) {
+        return acknowledge(Status::Malformed,
+                           "invalid code-object request prefix");
+    }
+
+    switch (request.opcode) {
+      case CodeObjectOpcode::Begin: {
+        request.manifest.imageSize = load64(payload + 48);
+        request.manifest.chunkDataBytes = load32(payload + 56);
+        request.manifest.chunkCount = load32(payload + 60);
+        request.manifest.segmentCount = load32(payload + 64);
+        request.manifest.kernelIndex = load32(payload + 68);
+        request.manifest.imageSha256 = loadBytes<Sha256Bytes>(payload + 72);
+        request.manifest.elfMachine = load16(payload + 104);
+        request.manifest.elfType = load16(payload + 106);
+        request.manifest.elfOsabi = payload[108];
+        request.manifest.elfAbiVersion = payload[109];
+        request.manifest.elfReserved = load16(payload + 110);
+        request.manifest.elfFlags = load32(payload + 112);
+        request.manifest.gfxTarget = load32(payload + 116);
+        request.manifest.codeObjectVersion = load32(payload + 120);
+        request.manifest.metadataMajor = load32(payload + 124);
+        request.manifest.metadataMinor = load32(payload + 128);
+        request.manifest.relocationCount = load32(payload + 132);
+        request.manifest.kernargSegmentSize = load32(payload + 136);
+        request.manifest.kernargSegmentAlign = load32(payload + 140);
+        request.manifest.groupSegmentFixedSize = load32(payload + 144);
+        request.manifest.privateSegmentFixedSize = load32(payload + 148);
+        request.manifest.maxFlatWorkgroupSize = load32(payload + 152);
+        request.manifest.wavefrontSize = load32(payload + 156);
+        request.manifest.sgprCount = load32(payload + 160);
+        request.manifest.vgprCount = load32(payload + 164);
+        request.manifest.usesDynamicStack = load32(payload + 168);
+        request.manifest.descriptorSize = load32(payload + 172);
+        request.manifest.kernelCodeEntryByteOffset =
+            loadSigned64(payload + 176);
+        request.manifest.codeVirtualAddress = load64(payload + 184);
+        request.manifest.codeFileOffset = load64(payload + 192);
+        request.manifest.codeSize = load64(payload + 200);
+        request.manifest.descriptorVirtualAddress = load64(payload + 208);
+        request.manifest.descriptorFileOffset = load64(payload + 216);
+        std::copy_n(payload + 224, CodeObjectNameBytes,
+                    request.manifest.kernelName.begin());
+        std::copy_n(payload + 352, CodeObjectNameBytes,
+                    request.manifest.descriptorSymbol.begin());
+        std::copy_n(payload + 480, CodeObjectDescriptorBytes,
+                    request.manifest.descriptor.begin());
+        for (size_t index = 0; index < CodeObjectMaximumSegments; ++index) {
+            const size_t offset = 544 + index * 48;
+            auto &segment = request.manifest.segments[index];
+            segment.type = load32(payload + offset);
+            segment.flags = load32(payload + offset + 4);
+            segment.fileOffset = load64(payload + offset + 8);
+            segment.virtualAddress = load64(payload + offset + 16);
+            segment.fileSize = load64(payload + offset + 24);
+            segment.memorySize = load64(payload + offset + 32);
+            segment.alignment = load64(payload + offset + 40);
+        }
+
+        const bool prefixZero = request.objectId == 0 &&

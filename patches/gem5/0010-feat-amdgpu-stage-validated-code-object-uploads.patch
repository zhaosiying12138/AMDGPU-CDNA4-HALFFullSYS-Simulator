+#ifndef __DEV_AMDGPU_HOST_GPU_CODE_OBJECT_STATE_HH__
+#define __DEV_AMDGPU_HOST_GPU_CODE_OBJECT_STATE_HH__
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "dev/amdgpu/host_gpu_protocol.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Connection-owned code-object staging.
+ *
+ * A1 parses and validates code-object identity before an integrity-checked
+ * host-side commit. It does not map PT_LOAD ranges, apply relocations, publish
+ * executable memory, construct an AQL packet, or execute the image.
+ */
+class HostGPUCodeObjectState
+{
+  public:
+    static constexpr size_t MaximumObjects = 16;
+
+    struct Owner
+    {
+        int fd = -1;
+        uint64_t clientGeneration = 0;
+
+        bool operator==(const Owner &other) const
+        {
+            return fd == other.fd &&
+                clientGeneration == other.clientGeneration;
+        }
+    };
+
+    struct Decision
+    {
+        protocol::CodeObjectResponse response;
+        bool accepted = false;
+        bool committed = false;
+    };
+
+    Decision submit(const Owner &owner, const protocol::CodeObjectRequest &request,
+                    uint64_t now);
+    static protocol::CodeObjectResponse failureResponse(
+        const protocol::CodeObjectRequest &request, protocol::Status status,
+        uint64_t now);
+
+    bool readCommittedImage(const Owner &owner, uint64_t objectId,
+                            uint64_t generation,
+                            std::vector<uint8_t> &image) const;
+    std::optional<protocol::CodeObjectManifest> committedManifest(
+        const Owner &owner, uint64_t objectId, uint64_t generation) const;
+
+    void abortMutable(const Owner &owner);
+    void disconnect(const Owner &owner);
+    void clear();
+
+    size_t objectCount() const { return liveObjects; }
+    size_t committedCount() const;
+    size_t activeUploadCount() const;
+
+  private:
+    struct Object
+    {
+        Owner owner;
+        uint64_t generation = 0;
+        protocol::CodeObjectManifest manifest;
+        std::vector<uint8_t> image;
+        uint64_t acceptedOffset = 0;
+        uint32_t nextChunk = 0;
+        bool committed = false;
+    };
+
+    static protocol::CodeObjectResponse responseFor(
+        const protocol::CodeObjectRequest &request, protocol::Status status,
+        uint64_t now);
+    static bool manifestValid(const protocol::CodeObjectManifest &manifest);
+    static uint64_t expectedChunkCount(uint64_t imageSize);
+    static uint32_t expectedChunkBytes(const Object &object);
+    static protocol::Sha256 sha256(const std::vector<uint8_t> &image);
+    Object *resolve(const Owner &owner, uint64_t objectId,
+                    uint64_t generation);
+    const Object *resolve(const Owner &owner, uint64_t objectId,
+                          uint64_t generation) const;
+    Object *resolveOwned(const Owner &owner, uint64_t objectId);
+    void abortObject(uint64_t objectId);
+    bool takeGeneration(uint64_t &generation);
+
+    std::array<std::optional<Object>, MaximumObjects> objects;
+    uint64_t nextGeneration = 1;
+    bool generationExhausted = false;
+    size_t liveObjects = 0;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_CODE_OBJECT_STATE_HH__

+protocol::CodeObjectResponse
+HostGPUCodeObjectState::responseFor(
+    const protocol::CodeObjectRequest &request, protocol::Status status,
+    uint64_t now)
+{
+    protocol::CodeObjectResponse response;
+    response.status = status;
+    response.opcode = request.opcode;
+    response.simTick = now;
+    if (status != protocol::Status::Ok) {
+        response.errorCode = static_cast<uint32_t>(status);
+        return response;
+    }
+    response.objectId = request.objectId;
+    response.generation = request.generation;
+    response.acceptedOffset = request.imageOffset;
+    response.byteCount = request.byteCount;
+    response.chunkIndex = request.chunkIndex;
+    return response;
+}
+
+bool
+HostGPUCodeObjectState::manifestValid(
+    const protocol::CodeObjectManifest &manifest)
+{
+    return protocol::validateCodeObjectManifest(manifest) ==
+        protocol::CodeObjectManifestValidation::Valid;
+}
+
+uint64_t
+HostGPUCodeObjectState::expectedChunkCount(uint64_t imageSize)
+{
+    if (imageSize == 0)
+        return 0;
+    return (imageSize + protocol::CodeObjectChunkDataBytes - 1) /
+        protocol::CodeObjectChunkDataBytes;
+}
+
+uint32_t
+HostGPUCodeObjectState::expectedChunkBytes(const Object &object)
+{
+    const uint64_t remaining = object.manifest.imageSize -
+        object.acceptedOffset;
+    return static_cast<uint32_t>(std::min<uint64_t>(
+        remaining, protocol::CodeObjectChunkDataBytes));
+}
+
+bool
+HostGPUCodeObjectState::takeGeneration(uint64_t &generation)
+{
+    if (generationExhausted || nextGeneration == 0)
+        return false;
+    generation = nextGeneration;
+    if (nextGeneration == std::numeric_limits<uint64_t>::max())
+        generationExhausted = true;
+    else
+        ++nextGeneration;
+    return true;
+}
+
+HostGPUCodeObjectState::Object *
+HostGPUCodeObjectState::resolve(const Owner &owner, uint64_t objectId,
+                                uint64_t generation)
+{
+    if (objectId == 0 || objectId > objects.size())
+        return nullptr;
+    auto &slot = objects[objectId - 1];
+    if (!slot || !(slot->owner == owner) || slot->generation != generation)
+        return nullptr;
+    return &*slot;
+}
+
+const HostGPUCodeObjectState::Object *
+HostGPUCodeObjectState::resolve(const Owner &owner, uint64_t objectId,
+                                uint64_t generation) const
+{
+    if (objectId == 0 || objectId > objects.size())
+        return nullptr;
+    const auto &slot = objects[objectId - 1];
+    if (!slot || !(slot->owner == owner) || slot->generation != generation)
+        return nullptr;
+    return &*slot;
+}
+
+HostGPUCodeObjectState::Object *
+HostGPUCodeObjectState::resolveOwned(const Owner &owner, uint64_t objectId)
+{
+    if (objectId == 0 || objectId > objects.size())
+        return nullptr;
+    auto &slot = objects[objectId - 1];
+    if (!slot || !(slot->owner == owner))
+        return nullptr;
+    return &*slot;
+}
+
+void
+HostGPUCodeObjectState::abortObject(uint64_t objectId)
+{
+    if (objectId == 0 || objectId > objects.size())
+        return;
+    auto &slot = objects[objectId - 1];
+    if (!slot || slot->committed)
+        return;
+    std::fill(slot->image.begin(), slot->image.end(), uint8_t(0));
+    slot->image.clear();
+    slot.reset();
+    assert(liveObjects > 0);
+    --liveObjects;
+}
+
+protocol::Sha256
+HostGPUCodeObjectState::sha256(const std::vector<uint8_t> &image)
+{
+    std::array<uint32_t, 8> state = {
+        0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU,
+        0x510e527fU, 0x9b05688cU, 0x1f83d9abU, 0x5be0cd19U,
+    };
+    const uint64_t bitLength = static_cast<uint64_t>(image.size()) * 8;
+    const size_t paddedSize = ((image.size() + 9 + 63) / 64) * 64;
+    std::vector<uint8_t> padded(paddedSize, 0);
+    std::copy(image.begin(), image.end(), padded.begin());
+    padded[image.size()] = 0x80;
+    for (unsigned byte = 0; byte < 8; ++byte)
+        padded[paddedSize - byte - 1] =
+            static_cast<uint8_t>(bitLength >> (byte * 8));
+
+    for (size_t block = 0; block < paddedSize; block += 64) {
+        std::array<uint32_t, 64> words = {};
+        for (unsigned index = 0; index < 16; ++index) {
+            const size_t offset = block + index * 4;
+            words[index] = static_cast<uint32_t>(padded[offset]) << 24 |
+                static_cast<uint32_t>(padded[offset + 1]) << 16 |
+                static_cast<uint32_t>(padded[offset + 2]) << 8 |
+                padded[offset + 3];
+        }
+        for (unsigned index = 16; index < words.size(); ++index) {
+            const uint32_t s0 = rotateRight(words[index - 15], 7) ^
+                rotateRight(words[index - 15], 18) ^
+                (words[index - 15] >> 3);
+            const uint32_t s1 = rotateRight(words[index - 2], 17) ^
+                rotateRight(words[index - 2], 19) ^
+                (words[index - 2] >> 10);
+            words[index] = words[index - 16] + s0 + words[index - 7] + s1;
+        }
+
+        auto working = state;
+        for (unsigned index = 0; index < words.size(); ++index) {
+            const uint32_t s1 = rotateRight(working[4], 6) ^
+                rotateRight(working[4], 11) ^ rotateRight(working[4], 25);
+            const uint32_t choose =
+                (working[4] & working[5]) ^ (~working[4] & working[6]);
+            const uint32_t temp1 = working[7] + s1 + choose +
+                Sha256Constants[index] + words[index];
+            const uint32_t s0 = rotateRight(working[0], 2) ^
+                rotateRight(working[0], 13) ^ rotateRight(working[0], 22);
+            const uint32_t majority =
+                (working[0] & working[1]) ^
+                (working[0] & working[2]) ^ (working[1] & working[2]);
+            const uint32_t temp2 = s0 + majority;
+            working = {temp1 + temp2, working[0], working[1], working[2],
+                       working[3] + temp1, working[4], working[5], working[6]};
+        }
+        for (size_t index = 0; index < state.size(); ++index)
+            state[index] += working[index];
+    }
+
+    protocol::Sha256 result = {};
+    for (size_t index = 0; index < state.size(); ++index) {
+        result[index * 4] = static_cast<uint8_t>(state[index] >> 24);
+        result[index * 4 + 1] = static_cast<uint8_t>(state[index] >> 16);
+        result[index * 4 + 2] = static_cast<uint8_t>(state[index] >> 8);
+        result[index * 4 + 3] = static_cast<uint8_t>(state[index]);
+    }
+    return result;
+}
+
+HostGPUCodeObjectState::Decision
+HostGPUCodeObjectState::submit(
+    const Owner &owner, const protocol::CodeObjectRequest &request,
+    uint64_t now)
+{
+    Decision decision;
+    decision.response = responseFor(request, protocol::Status::ProtocolState,
+                                     now);
+
+    auto reject = [&](protocol::Status status, bool abort) {
+        if (abort)
+            abortMutable(owner);
+        decision.response = responseFor(request, status, now);
+        return decision;
+    };
+    auto ownedByAnother = [&]() {
+        if (request.objectId == 0 || request.objectId > objects.size())
+            return false;
+        const auto &slot = objects[request.objectId - 1];
+        return slot && !(slot->owner == owner);
+    };
+
+    const uint16_t rawOpcode = static_cast<uint16_t>(request.opcode);
+    if (request.major != protocol::CodeObjectTransferMajor ||
+        request.minor != protocol::CodeObjectTransferMinor) {
+        return reject(protocol::Status::UnsupportedVersion, true);
+    }
+    if (request.flags != 0 || request.reserved != 0 ||
+        rawOpcode < static_cast<uint16_t>(protocol::CodeObjectOpcode::Begin) ||
+        rawOpcode > static_cast<uint16_t>(protocol::CodeObjectOpcode::Commit)) {
+        return reject(protocol::Status::Malformed, true);
+    }
+
+    switch (request.opcode) {
+      case protocol::CodeObjectOpcode::Begin: {
+        if (request.objectId != 0 || request.generation != 0 ||
+            request.imageOffset != 0 || request.byteCount != 0 ||
+            request.chunkIndex != 0 || request.chunkCrc32c != 0) {
+            return reject(protocol::Status::Malformed, true);
+        }
+        const auto manifestStatus = protocol::validateCodeObjectManifest(
+            request.manifest);
+        if (manifestStatus !=
+            protocol::CodeObjectManifestValidation::Valid) {
+            return reject(
+                manifestStatus ==
+                        protocol::CodeObjectManifestValidation::UnsupportedVersion ?
+                    protocol::Status::UnsupportedVersion :
+                manifestStatus ==
+                        protocol::CodeObjectManifestValidation::TopologyMismatch ?
+                    protocol::Status::TopologyMismatch :
+                    protocol::Status::Malformed,
+                true);
+        }
+        for (const auto &slot : objects) {
+            if (slot && slot->owner == owner && !slot->committed)
+                return reject(protocol::Status::Busy, false);
+        }
+        if (liveObjects >= objects.size()) {
+            return reject(protocol::Status::ResourceExhausted, false);
+        }
+        size_t slot = 0;
+        while (slot < objects.size() && objects[slot])
+            ++slot;
+        uint64_t generation = 0;
+        if (slot == objects.size() || !takeGeneration(generation)) {
+            return reject(protocol::Status::ResourceExhausted, false);
+        }
+        try {
+            Object object;
+            object.owner = owner;
+            object.generation = generation;
+            object.manifest = request.manifest;
+            object.image.reserve(static_cast<size_t>(request.manifest.imageSize));
+            objects[slot].emplace(std::move(object));
+        } catch (const std::bad_alloc &) {
+            return reject(protocol::Status::Internal, false);
+        }
+        ++liveObjects;
+        decision.response.status = protocol::Status::Ok;
+        decision.response.objectId = slot + 1;
+        decision.response.generation = generation;
+        decision.response.acceptedOffset = 0;
+        decision.response.imageBytes = request.manifest.imageSize;
+        decision.response.kernelIndex = request.manifest.kernelIndex;
+        decision.response.segmentCount = request.manifest.segmentCount;
+        decision.response.imageSha256 = request.manifest.imageSha256;
+        decision.accepted = true;
+        return decision;
+      }
+
+      case protocol::CodeObjectOpcode::Chunk: {
+        if (ownedByAnother())
+            return reject(protocol::Status::Unauthorized, false);
+        Object *object = resolve(owner, request.objectId, request.generation);
+        if (object == nullptr || object->committed) {
+            const bool staleOwned = resolveOwned(owner, request.objectId) !=
+                nullptr;
+            return reject(protocol::Status::ProtocolState, staleOwned);
+        }
+        const uint32_t expectedBytes = expectedChunkBytes(*object);
+        const bool rangeValid = request.imageOffset == object->acceptedOffset &&
+            request.chunkIndex == object->nextChunk &&
+            request.byteCount == expectedBytes && request.byteCount != 0 &&
+            request.byteCount <= protocol::CodeObjectChunkDataBytes;
+        const bool paddingValid = request.byteCount <=
+            protocol::CodeObjectChunkDataBytes &&
+            std::all_of(request.chunkData.begin() + request.byteCount,
+                        request.chunkData.end(),
+                        [](uint8_t byte) { return byte == 0; });
+        const bool crcValid = rangeValid &&
+            protocol::crc32c(request.chunkData.data(), request.byteCount) ==
+                request.chunkCrc32c;
+        if (!rangeValid || !paddingValid || !crcValid)
+            return reject(protocol::Status::ProtocolState, true);
+        try {
+            object->image.insert(object->image.end(), request.chunkData.begin(),
+                                 request.chunkData.begin() + request.byteCount);
+        } catch (const std::bad_alloc &) {
+            return reject(protocol::Status::Internal, true);
+        }
+        object->acceptedOffset += request.byteCount;
+        ++object->nextChunk;
+        decision.response.status = protocol::Status::Ok;
+        decision.response.objectId = request.objectId;
+        decision.response.generation = request.generation;
+        decision.response.acceptedOffset = request.imageOffset;
+        decision.response.byteCount = request.byteCount;
+        decision.response.chunkIndex = request.chunkIndex;
+        decision.response.imageBytes = object->manifest.imageSize;
+        decision.response.kernelIndex = object->manifest.kernelIndex;
+        decision.response.segmentCount = object->manifest.segmentCount;
+        decision.response.imageSha256 = object->manifest.imageSha256;
+        decision.accepted = true;
+        return decision;
+      }
+
+      case protocol::CodeObjectOpcode::Commit: {
+        if (ownedByAnother())
+            return reject(protocol::Status::Unauthorized, false);
+        Object *object = resolve(owner, request.objectId, request.generation);
+        if (object == nullptr || object->committed) {
+            const bool staleOwned = resolveOwned(owner, request.objectId) !=
+                nullptr;
+            return reject(protocol::Status::ProtocolState, staleOwned);
+        }
+        if (request.imageOffset != 0 ||
+            request.byteCount != object->manifest.imageSize ||
+            request.chunkIndex != object->manifest.chunkCount ||
+            request.chunkCrc32c != 0 ||
+            request.commitSha256 != object->manifest.imageSha256 ||
+            object->acceptedOffset != object->manifest.imageSize ||
+            object->nextChunk != object->manifest.chunkCount ||
+            object->image.size() != object->manifest.imageSize) {
+            return reject(protocol::Status::ProtocolState, true);
+        }
+        const auto digest = sha256(object->image);
+        if (digest != object->manifest.imageSha256) {
+            return reject(protocol::Status::ProtocolState, true);
+        }
+        if (!validateCodeObjectImage(object->image, object->manifest)) {
+            return reject(protocol::Status::ProtocolState, true);
+        }
+        object->committed = true;
+        decision.response.status = protocol::Status::Ok;
+        decision.response.objectId = request.objectId;
+        decision.response.generation = request.generation;
+        decision.response.acceptedOffset = object->manifest.imageSize;
+        decision.response.byteCount = object->manifest.imageSize;
+        decision.response.chunkIndex = object->manifest.chunkCount;
+        decision.response.imageBytes = object->manifest.imageSize;
+        decision.response.kernelIndex = object->manifest.kernelIndex;
+        decision.response.segmentCount = object->manifest.segmentCount;
+        decision.response.imageSha256 = digest;
+        decision.accepted = true;
+        decision.committed = true;
+        return decision;
+      }
+    }
+
+    decision.response.status = protocol::Status::Malformed;
+    return decision;
+}
+
+protocol::CodeObjectResponse
+HostGPUCodeObjectState::failureResponse(
+    const protocol::CodeObjectRequest &request, protocol::Status status,
+    uint64_t now)
+{
+    return responseFor(request, status, now);
+}
+
+bool
+HostGPUCodeObjectState::readCommittedImage(
+    const Owner &owner, uint64_t objectId, uint64_t generation,
+    std::vector<uint8_t> &image) const
+{
+    const Object *object = resolve(owner, objectId, generation);
+    if (object == nullptr || !object->committed)
+        return false;
+    image = object->image;
+    return true;
+}
+
+std::optional<protocol::CodeObjectManifest>
+HostGPUCodeObjectState::committedManifest(
+    const Owner &owner, uint64_t objectId, uint64_t generation) const
+{
+    const Object *object = resolve(owner, objectId, generation);
+    if (object == nullptr || !object->committed)
+        return std::nullopt;
+    return object->manifest;
+}
+
+void
+HostGPUCodeObjectState::abortMutable(const Owner &owner)
+{
+    for (size_t index = 0; index < objects.size(); ++index) {
+        const auto &slot = objects[index];
+        if (slot && slot->owner == owner && !slot->committed)
+            abortObject(index + 1);
+    }
+}
+
+void
+HostGPUCodeObjectState::disconnect(const Owner &owner)
+{
+    for (auto &slot : objects) {
+        if (slot && slot->owner == owner) {
+            std::fill(slot->image.begin(), slot->image.end(), uint8_t(0));
+            slot->image.clear();
+            slot.reset();
+            assert(liveObjects > 0);
+            --liveObjects;
+        }
+    }
+}
+
+void
+HostGPUCodeObjectState::clear()
+{
+    for (auto &slot : objects) {
+        if (slot) {
+            std::fill(slot->image.begin(), slot->image.end(), uint8_t(0));
+            slot->image.clear();
+        }
+        slot.reset();
+    }
+    liveObjects = 0;
+}
+
+size_t
+HostGPUCodeObjectState::committedCount() const
+{
+    size_t count = 0;
+    for (const auto &slot : objects)
+        count += slot && slot->committed;
+    return count;
+}
+
+size_t
+HostGPUCodeObjectState::activeUploadCount() const
+{
+    size_t count = 0;
+    for (const auto &slot : objects)
+        count += slot && !slot->committed;
+    return count;
+}
+
+} // namespace hostgpu
+} // namespace gem5

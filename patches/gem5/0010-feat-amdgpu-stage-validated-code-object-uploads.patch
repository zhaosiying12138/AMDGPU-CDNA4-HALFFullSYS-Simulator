+TEST(HostGpuProtocol, CodeObjectRecordsAreFixedAndRoundTrip)
+{
+    CodeObjectRequest begin;
+    begin.opcode = CodeObjectOpcode::Begin;
+    begin.manifest = goldenCodeObjectManifest();
+    const auto header = goldenMemoryHeader(90);
+    auto frame = encodeCodeObjectRequest(header, begin);
+    ASSERT_EQ(frame.size(), CodeObjectRecordBytes);
+    auto decoded = decodeCodeObjectRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    ASSERT_EQ(decoded.action, DecodeAction::Acknowledge);
+    ASSERT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.header.messageType, MessageType::CodeObjectRequest);
+    EXPECT_EQ(decoded.request.manifest.imageSize, 128U);
+    EXPECT_EQ(decoded.request.manifest.segmentCount, 2U);
+    EXPECT_EQ(decoded.request.manifest.segments[0].alignment, 64U);
+
+    CodeObjectRequest chunk;
+    chunk.opcode = CodeObjectOpcode::Chunk;
+    chunk.objectId = 1;
+    chunk.generation = 2;
+    chunk.byteCount = 3;
+    chunk.chunkData[0] = 'a';
+    chunk.chunkData[1] = 'b';
+    chunk.chunkData[2] = 'c';
+    chunk.chunkCrc32c = crc32c(chunk.chunkData.data(), chunk.byteCount);
+    frame = encodeCodeObjectRequest(goldenMemoryHeader(91), chunk);
+    ASSERT_EQ(frame.size(), CodeObjectRecordBytes);
+    decoded = decodeCodeObjectRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    ASSERT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.request.chunkData[2], 'c');
+
+    CodeObjectRequest commit;
+    commit.opcode = CodeObjectOpcode::Commit;
+    commit.objectId = 1;
+    commit.generation = 2;
+    commit.byteCount = 128;
+    commit.chunkIndex = 1;
+    commit.commitSha256[0] = 0x42;
+    frame = encodeCodeObjectRequest(goldenMemoryHeader(92), commit);
+    ASSERT_EQ(frame.size(), CodeObjectRecordBytes);
+    decoded = decodeCodeObjectRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.request.commitSha256[0], 0x42);
+
+    commit.imageOffset = 1;
+    frame = encodeCodeObjectRequest(goldenMemoryHeader(95), commit);
+    decoded = decodeCodeObjectRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+
+    auto topology = begin;
+    topology.manifest.gfxTarget = 951;
+    frame = encodeCodeObjectRequest(goldenMemoryHeader(96), topology);
+    decoded = decodeCodeObjectRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.status, Status::TopologyMismatch);
+}

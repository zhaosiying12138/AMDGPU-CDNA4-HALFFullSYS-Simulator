+    const auto begin = state.submit(owner(), beginRequest(), 1);
+    ASSERT_TRUE(begin.accepted);
+    ASSERT_EQ(begin.response.status, protocol::Status::Ok);
+    EXPECT_EQ(begin.response.objectId, 1U);
+    EXPECT_EQ(begin.response.generation, 1U);
+
+    auto chunk = chunkRequest(begin.response.objectId, begin.response.generation);
+    const auto chunkResult = state.submit(owner(), chunk, 2);
+    ASSERT_TRUE(chunkResult.accepted);
+    EXPECT_EQ(chunkResult.response.acceptedOffset, 0U);
+    EXPECT_EQ(chunkResult.response.byteCount, imageBytes().size());
+    EXPECT_EQ(chunkResult.response.chunkIndex, 0U);
+
+    const auto commit = state.submit(
+        owner(), commitRequest(begin.response.objectId,
+                               begin.response.generation), 3);
+    ASSERT_TRUE(commit.accepted);
+    ASSERT_TRUE(commit.committed);
+    EXPECT_EQ(commit.response.status, protocol::Status::Ok);
+    EXPECT_EQ(commit.response.imageSha256, imageSha256());
+    EXPECT_EQ(state.committedCount(), 1U);
+
+    std::vector<uint8_t> image;
+    ASSERT_TRUE(state.readCommittedImage(
+        owner(), begin.response.objectId, begin.response.generation, image));
+    EXPECT_EQ(image, imageBytes());

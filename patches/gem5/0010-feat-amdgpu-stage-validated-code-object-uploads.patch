+            crc32c(request.chunkData.data(), request.byteCount) ==
+                request.chunkCrc32c;
+        if (request.objectId == 0 || request.generation == 0 ||
+            !rangeValid || !trailingZero || !crcValid) {
+            return acknowledge(Status::Malformed,
+                               "invalid code-object CHUNK fields");
+        }
+        break;
+      }
+      case CodeObjectOpcode::Commit: {
+        request.commitSha256 = loadBytes<Sha256Bytes>(payload + 48);
+        const bool digestNonzero = !std::all_of(
+            request.commitSha256.begin(), request.commitSha256.end(),
+            [](uint8_t byte) { return byte == 0; });
+        const bool tailZero = std::all_of(
+            payload + 80, payload + CodeObjectPayloadBytes,
+            [](uint8_t byte) { return byte == 0; });

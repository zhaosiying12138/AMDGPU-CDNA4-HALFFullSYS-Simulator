+constexpr uint16_t AmdgpuMachine = 224;
+constexpr uint8_t AmdgpuHsaOsabi = 64;
+constexpr uint32_t AmdgpuMetadataNoteType = 32;
+constexpr size_t MaximumMetadataKernels = 16;
+constexpr uint64_t MaximumContainerElements = 65536;
+constexpr unsigned MaximumMessageDepth = 32;
+
+class ElfHandle
+{
+  public:
+    explicit ElfHandle(Elf *value) : value(value) {}
+    ~ElfHandle()
+    {
+        if (value != nullptr)
+            elf_end(value);
+    }
+
+    Elf *get() const { return value; }
+
+  private:
+    Elf *value;
+};
+
+struct StringView
+{
+    const uint8_t *data = nullptr;
+    size_t size = 0;
+};
+
+class ByteCursor
+{
+  public:
+    ByteCursor(const uint8_t *data, size_t size) : current(data), remaining(size)
+    {}
+
+    bool take(size_t size, const uint8_t *&result)
+    {
+        if (size > remaining)
+            return false;
+        result = current;
+        current += size;
+        remaining -= size;
+        return true;
+    }
+
+    size_t bytesRemaining() const { return remaining; }
+
+  private:
+    const uint8_t *current;
+    size_t remaining;
+};
+
+enum class MessageKind
+{
+    Other,
+    Unsigned,
+    Signed,
+    String,
+    Array,
+    Map,
+};
+
+struct Message
+{
+    MessageKind kind = MessageKind::Other;
+    uint64_t value = 0;
+    int64_t signedValue = 0;
+    StringView string;
+};
+
+uint32_t
+loadLittle32(const uint8_t *data)
+{
+    return static_cast<uint32_t>(data[0]) |
+        static_cast<uint32_t>(data[1]) << 8 |
+        static_cast<uint32_t>(data[2]) << 16 |
+        static_cast<uint32_t>(data[3]) << 24;
+}
+
+uint64_t
+loadLittle64(const uint8_t *data)
+{
+    return static_cast<uint64_t>(loadLittle32(data)) |
+        static_cast<uint64_t>(loadLittle32(data + 4)) << 32;
+}
+
+int64_t
+loadLittleSigned64(const uint8_t *data)
+{
+    const uint64_t raw = loadLittle64(data);
+    if (raw <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max()))
+        return static_cast<int64_t>(raw);
+    return -1 - static_cast<int64_t>(
+        std::numeric_limits<uint64_t>::max() - raw);
+}
+
+bool
+readBigUnsigned(ByteCursor &cursor, size_t width, uint64_t &value)
+{
+    const uint8_t *bytes = nullptr;
+    if (width == 0 || width > sizeof(value) || !cursor.take(width, bytes))
+        return false;
+    value = 0;
+    for (size_t index = 0; index < width; ++index)
+        value = (value << 8) | bytes[index];
+    return true;
+}
+
+bool
+takeString(ByteCursor &cursor, uint64_t length, StringView &result)
+{
+    if (length > std::numeric_limits<size_t>::max())
+        return false;
+    const uint8_t *bytes = nullptr;
+    if (!cursor.take(static_cast<size_t>(length), bytes))
+        return false;
+    result = {bytes, static_cast<size_t>(length)};
+    return true;
+}
+
+bool
+readMessage(ByteCursor &cursor, Message &message)
+{
+    const uint8_t *raw = nullptr;
+    if (!cursor.take(1, raw))
+        return false;
+    const uint8_t tag = raw[0];
+    message = {};
+
+    if (tag <= 0x7f) {
+        message.kind = MessageKind::Unsigned;
+        message.value = tag;
+        return true;
+    }
+    if (tag >= 0xe0) {
+        message.kind = MessageKind::Signed;
+        message.signedValue = static_cast<int8_t>(tag);
+        return true;
+    }
+    if (tag >= 0x80 && tag <= 0x8f) {
+        message.kind = MessageKind::Map;
+        message.value = tag & 0x0f;
+        return true;
+    }
+    if (tag >= 0x90 && tag <= 0x9f) {
+        message.kind = MessageKind::Array;
+        message.value = tag & 0x0f;
+        return true;
+    }
+    if (tag >= 0xa0 && tag <= 0xbf) {
+        message.kind = MessageKind::String;
+        return takeString(cursor, tag & 0x1f, message.string);
+    }
+
+    uint64_t value = 0;
+    switch (tag) {
+      case 0xc0:
+        return true;
+      case 0xc2:
+      case 0xc3:
+        message.kind = MessageKind::Unsigned;
+        message.value = tag - 0xc2;
+        return true;
+      case 0xcc:
+      case 0xcd:
+      case 0xce:
+      case 0xcf: {
+        const size_t width = size_t(1) << (tag - 0xcc);
+        if (!readBigUnsigned(cursor, width, value))
+            return false;
+        message.kind = MessageKind::Unsigned;
+        message.value = value;
+        return true;
+      }
+      case 0xd0:
+      case 0xd1:
+      case 0xd2:
+      case 0xd3: {
+        const size_t width = size_t(1) << (tag - 0xd0);
+        if (!readBigUnsigned(cursor, width, value))
+            return false;
+        if (width < sizeof(value) && (value & (uint64_t(1) <<
+                (width * CHAR_BIT - 1)))) {
+            value |= std::numeric_limits<uint64_t>::max() <<
+                (width * CHAR_BIT);
+        }
+        message.kind = MessageKind::Signed;
+        std::memcpy(&message.signedValue, &value, sizeof(value));
+        return true;
+      }
+      case 0xd9:
+      case 0xda:
+      case 0xdb: {
+        const size_t width = size_t(1) << (tag - 0xd9);
+        if (!readBigUnsigned(cursor, width, value))
+            return false;
+        message.kind = MessageKind::String;
+        return takeString(cursor, value, message.string);
+      }
+      case 0xdc:
+      case 0xdd: {
+        const size_t width = tag == 0xdc ? 2 : 4;
+        if (!readBigUnsigned(cursor, width, value))
+            return false;
+        message.kind = MessageKind::Array;
+        message.value = value;
+        return true;
+      }
+      case 0xde:
+      case 0xdf: {
+        const size_t width = tag == 0xde ? 2 : 4;
+        if (!readBigUnsigned(cursor, width, value))
+            return false;
+        message.kind = MessageKind::Map;
+        message.value = value;
+        return true;
+      }
+      default:
+        break;
+    }
+
+    if (tag >= 0xc4 && tag <= 0xc6) {
+        const size_t width = size_t(1) << (tag - 0xc4);
+        if (!readBigUnsigned(cursor, width, value))
+            return false;
+        StringView ignored;
+        return takeString(cursor, value, ignored);
+    }
+    if (tag == 0xca || tag == 0xcb) {
+        const size_t width = tag == 0xca ? 4 : 8;
+        return cursor.take(width, raw);
+    }
+    if (tag >= 0xd4 && tag <= 0xd8) {
+        const size_t payload = size_t(1) << (tag - 0xd4);
+        return cursor.take(payload + 1, raw);
+    }
+    if (tag >= 0xc7 && tag <= 0xc9) {
+        const size_t width = size_t(1) << (tag - 0xc7);
+        if (!readBigUnsigned(cursor, width, value) ||
+            !cursor.take(1, raw) ||
+            value > std::numeric_limits<size_t>::max()) {
+            return false;
+        }
+        return cursor.take(static_cast<size_t>(value), raw);
+    }
+    return false;
+}
+
+bool skipMessage(ByteCursor &cursor, unsigned depth);
+
+bool
+skipMessageBody(ByteCursor &cursor, const Message &message, unsigned depth)
+{
+    if (depth > MaximumMessageDepth ||
+        message.value > MaximumContainerElements) {
+        return message.kind != MessageKind::Array &&
+            message.kind != MessageKind::Map;
+    }
+    if (message.kind == MessageKind::Array) {
+        for (uint64_t index = 0; index < message.value; ++index) {
+            if (!skipMessage(cursor, depth + 1))
+                return false;
+        }
+    } else if (message.kind == MessageKind::Map) {
+        for (uint64_t index = 0; index < message.value; ++index) {
+            if (!skipMessage(cursor, depth + 1) ||
+                !skipMessage(cursor, depth + 1)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool
+skipMessage(ByteCursor &cursor, unsigned depth)
+{
+    Message message;
+    return depth <= MaximumMessageDepth && readMessage(cursor, message) &&
+        skipMessageBody(cursor, message, depth);
+}
+
+bool
+stringIs(const Message &message, const char *text)
+{
+    const size_t length = std::strlen(text);
+    return message.kind == MessageKind::String &&
+        message.string.size == length &&
+        std::memcmp(message.string.data, text, length) == 0;
+}
+
+bool
+number(const Message &message, uint32_t &value)
+{
+    uint64_t raw = 0;
+    if (message.kind == MessageKind::Unsigned) {
+        raw = message.value;
+    } else if (message.kind == MessageKind::Signed &&
+               message.signedValue >= 0) {
+        raw = static_cast<uint64_t>(message.signedValue);
+    } else {
+        return false;
+    }
+    if (raw > std::numeric_limits<uint32_t>::max())
+        return false;
+    value = static_cast<uint32_t>(raw);
+    return true;
+}
+
+struct KernelMetadata
+{
+    StringView name;
+    StringView symbol;
+    uint32_t kernargSize = 0;
+    uint32_t kernargAlign = 0;
+    uint32_t groupSize = 0;
+    uint32_t privateSize = 0;
+    uint32_t maxWorkgroupSize = 0;
+    uint32_t wavefrontSize = 0;
+    uint32_t sgprCount = 0;
+    uint32_t vgprCount = 0;
+    uint32_t usesDynamicStack = 0;
+};
+
+bool
+parseKernel(ByteCursor &cursor, KernelMetadata &kernel)
+{
+    Message map;
+    if (!readMessage(cursor, map) || map.kind != MessageKind::Map ||
+        map.value > MaximumContainerElements) {
+        return false;
+    }
+    bool haveName = false;
+    bool haveSymbol = false;
+    bool haveKernargSize = false;
+    bool haveKernargAlign = false;
+    bool haveGroupSize = false;
+    bool havePrivateSize = false;
+    bool haveMaxWorkgroup = false;
+    bool haveWavefront = false;
+    bool haveSgpr = false;
+    bool haveVgpr = false;
+
+    for (uint64_t index = 0; index < map.value; ++index) {
+        Message key;
+        Message value;
+        if (!readMessage(cursor, key) || key.kind != MessageKind::String ||
+            !readMessage(cursor, value)) {
+            return false;
+        }
+        if (stringIs(key, ".name")) {
+            if (value.kind != MessageKind::String)
+                return false;
+            kernel.name = value.string;
+            haveName = true;
+        } else if (stringIs(key, ".symbol")) {
+            if (value.kind != MessageKind::String)
+                return false;
+            kernel.symbol = value.string;
+            haveSymbol = true;
+        } else if (stringIs(key, ".kernarg_segment_size")) {
+            haveKernargSize = number(value, kernel.kernargSize);
+            if (!haveKernargSize)
+                return false;
+        } else if (stringIs(key, ".kernarg_segment_align")) {
+            haveKernargAlign = number(value, kernel.kernargAlign);
+            if (!haveKernargAlign)
+                return false;
+        } else if (stringIs(key, ".group_segment_fixed_size")) {
+            haveGroupSize = number(value, kernel.groupSize);
+            if (!haveGroupSize)
+                return false;
+        } else if (stringIs(key, ".private_segment_fixed_size")) {
+            havePrivateSize = number(value, kernel.privateSize);
+            if (!havePrivateSize)
+                return false;
+        } else if (stringIs(key, ".max_flat_workgroup_size")) {
+            haveMaxWorkgroup = number(value, kernel.maxWorkgroupSize);
+            if (!haveMaxWorkgroup)
+                return false;
+        } else if (stringIs(key, ".wavefront_size")) {
+            haveWavefront = number(value, kernel.wavefrontSize);
+            if (!haveWavefront)
+                return false;
+        } else if (stringIs(key, ".sgpr_count")) {
+            haveSgpr = number(value, kernel.sgprCount);
+            if (!haveSgpr)
+                return false;
+        } else if (stringIs(key, ".vgpr_count")) {
+            haveVgpr = number(value, kernel.vgprCount);
+            if (!haveVgpr)
+                return false;
+        } else if (stringIs(key, ".uses_dynamic_stack")) {
+            if (!number(value, kernel.usesDynamicStack) ||
+                kernel.usesDynamicStack > 1) {
+                return false;
+            }
+        } else if (!skipMessageBody(cursor, value, 1)) {
+            return false;
+        }
+    }
+
+    return haveName && haveSymbol && haveKernargSize && haveKernargAlign &&
+        haveGroupSize && havePrivateSize && haveMaxWorkgroup && haveWavefront &&
+        haveSgpr && haveVgpr;
+}
+
+struct Metadata
+{
+    StringView target;
+    uint32_t major = 0;
+    uint32_t minor = 0;
+    uint32_t kernelCount = 0;
+    KernelMetadata selected;
+};
+
+bool
+parseMetadata(const uint8_t *data, size_t size, uint32_t selectedIndex,
+              Metadata &metadata)
+{
+    ByteCursor cursor(data, size);
+    Message root;
+    if (!readMessage(cursor, root) || root.kind != MessageKind::Map ||
+        root.value > MaximumContainerElements) {
+        return false;
+    }
+    bool haveTarget = false;
+    bool haveVersion = false;
+    bool haveKernels = false;
+
+    for (uint64_t index = 0; index < root.value; ++index) {
+        Message key;
+        Message value;
+        if (!readMessage(cursor, key) || key.kind != MessageKind::String ||
+            !readMessage(cursor, value)) {
+            return false;
+        }
+        if (stringIs(key, "amdhsa.target")) {
+            if (value.kind != MessageKind::String)
+                return false;
+            metadata.target = value.string;
+            haveTarget = true;
+        } else if (stringIs(key, "amdhsa.version")) {
+            Message major;
+            Message minor;
+            if (value.kind != MessageKind::Array || value.value != 2 ||
+                !readMessage(cursor, major) || !number(major, metadata.major) ||
+                !readMessage(cursor, minor) || !number(minor, metadata.minor)) {
+                return false;
+            }
+            haveVersion = true;
+        } else if (stringIs(key, "amdhsa.kernels")) {
+            if (value.kind != MessageKind::Array || value.value == 0 ||
+                value.value > MaximumMetadataKernels ||
+                selectedIndex >= value.value) {
+                return false;
+            }
+            metadata.kernelCount = static_cast<uint32_t>(value.value);
+            for (uint32_t kernelIndex = 0;
+                 kernelIndex < metadata.kernelCount; ++kernelIndex) {
+                KernelMetadata kernel;
+                if (!parseKernel(cursor, kernel))
+                    return false;
+                if (kernelIndex == selectedIndex)
+                    metadata.selected = kernel;
+            }
+            haveKernels = true;
+        } else if (!skipMessageBody(cursor, value, 1)) {
+            return false;
+        }
+    }
+    return haveTarget && haveVersion && haveKernels &&
+        cursor.bytesRemaining() == 0;
+}
+
+bool
+targetMatches(const StringView &target, uint32_t gfxTarget)
+{
+    constexpr char Target[] = "amdgcn-amd-amdhsa--gfx950";
+    return gfxTarget == 950 && target.size == sizeof(Target) - 1 &&
+        std::memcmp(target.data, Target, sizeof(Target) - 1) == 0;
+}
+
+template <size_t Size>
+bool
+metadataStringMatches(const StringView &value,
+                      const std::array<uint8_t, Size> &manifestValue)
+{
+    const auto end = std::find(manifestValue.begin(), manifestValue.end(), 0);
+    const size_t length = static_cast<size_t>(end - manifestValue.begin());
+    return end != manifestValue.end() && value.size == length &&
+        std::equal(value.data, value.data + value.size, manifestValue.begin());
+}
+
+bool
+metadataMatches(const Metadata &metadata,
+                const protocol::CodeObjectManifest &manifest)
+{
+    const auto &kernel = metadata.selected;
+    return targetMatches(metadata.target, manifest.gfxTarget) &&
+        metadata.major == manifest.metadataMajor &&
+        metadata.minor == manifest.metadataMinor &&
+        metadataStringMatches(kernel.name, manifest.kernelName) &&
+        metadataStringMatches(kernel.symbol, manifest.descriptorSymbol) &&
+        kernel.kernargSize == manifest.kernargSegmentSize &&
+        kernel.kernargAlign == manifest.kernargSegmentAlign &&
+        kernel.groupSize == manifest.groupSegmentFixedSize &&
+        kernel.privateSize == manifest.privateSegmentFixedSize &&
+        kernel.maxWorkgroupSize == manifest.maxFlatWorkgroupSize &&
+        kernel.wavefrontSize == manifest.wavefrontSize &&
+        kernel.sgprCount == manifest.sgprCount &&
+        kernel.vgprCount == manifest.vgprCount &&
+        kernel.usesDynamicStack == manifest.usesDynamicStack;
+}
+
+bool
+rangeWithinImage(uint64_t offset, uint64_t size,
+                 const std::vector<uint8_t> &image)
+{
+    return offset <= image.size() && size <= image.size() - offset;
+}
+
+bool
+findMetadataNote(const std::vector<uint8_t> &image, uint64_t offset,
+                 uint64_t size, const uint8_t *&metadata, size_t &metadataSize,
+                 bool &found)
+{
+    if (!rangeWithinImage(offset, size, image))
+        return false;
+    size_t cursor = static_cast<size_t>(offset);
+    const size_t end = cursor + static_cast<size_t>(size);
+    while (cursor < end) {
+        if (end - cursor < 12)
+            return false;
+        const uint32_t nameSize = loadLittle32(image.data() + cursor);
+        const uint32_t descriptionSize = loadLittle32(image.data() + cursor + 4);
+        const uint32_t type = loadLittle32(image.data() + cursor + 8);
+        cursor += 12;
+        if (nameSize > std::numeric_limits<size_t>::max() - 3 ||
+            descriptionSize > std::numeric_limits<size_t>::max() - 3) {
+            return false;
+        }
+        const size_t paddedName = (static_cast<size_t>(nameSize) + 3) & ~size_t(3);
+        const size_t paddedDescription =
+            (static_cast<size_t>(descriptionSize) + 3) & ~size_t(3);
+        if (paddedName > end - cursor)
+            return false;
+        const uint8_t *name = image.data() + cursor;
+        cursor += paddedName;
+        if (paddedDescription > end - cursor)
+            return false;
+        if (type == AmdgpuMetadataNoteType && nameSize == 7 &&
+            std::memcmp(name, "AMDGPU\0", 7) == 0) {
+            if (found)
+                return false;
+            found = true;
+            metadata = image.data() + cursor;
+            metadataSize = descriptionSize;
+        }
+        cursor += paddedDescription;
+    }
+    return cursor == end;
+}
+
+bool
+segmentTableMatches(Elf *elf, const std::vector<uint8_t> &image,
+                    const protocol::CodeObjectManifest &manifest)
+{
+    size_t programCount = 0;
+    if (elf_getphdrnum(elf, &programCount) != 0)
+        return false;
+    size_t loadIndex = 0;
+    for (size_t index = 0; index < programCount; ++index) {
+        if (index > static_cast<size_t>(INT_MAX))
+            return false;
+        GElf_Phdr header;
+        if (gelf_getphdr(elf, static_cast<int>(index), &header) == nullptr)
+            return false;
+        if (header.p_type != PT_LOAD)
+            continue;
+        if (loadIndex >= manifest.segmentCount ||
+            !rangeWithinImage(header.p_offset, header.p_filesz, image)) {
+            return false;
+        }
+        const auto &segment = manifest.segments[loadIndex++];
+        if (header.p_type != segment.type || header.p_flags != segment.flags ||
+            header.p_offset != segment.fileOffset ||
+            header.p_vaddr != segment.virtualAddress ||
+            header.p_filesz != segment.fileSize ||
+            header.p_memsz != segment.memorySize ||
+            header.p_align != segment.alignment) {
+            return false;
+        }
+    }
+    return loadIndex == manifest.segmentCount;
+}
+
+bool
+symbolFileOffset(Elf *elf, const GElf_Sym &symbol,
+                 const std::vector<uint8_t> &image, uint64_t &fileOffset,
+                 bool requireExecutable)
+{
+    if (symbol.st_shndx == SHN_UNDEF || symbol.st_shndx >= SHN_LORESERVE)
+        return false;
+    Elf_Scn *section = elf_getscn(elf, symbol.st_shndx);
+    GElf_Shdr header;
+    if (section == nullptr || gelf_getshdr(section, &header) == nullptr ||
+        header.sh_type == SHT_NOBITS ||
+        (requireExecutable && (header.sh_flags & SHF_EXECINSTR) == 0) ||
+        symbol.st_value < header.sh_addr) {
+        return false;
+    }
+    const uint64_t delta = symbol.st_value - header.sh_addr;
+    if (delta > header.sh_size || symbol.st_size > header.sh_size - delta ||
+        header.sh_offset > std::numeric_limits<uint64_t>::max() - delta) {
+        return false;
+    }
+    fileOffset = header.sh_offset + delta;
+    return rangeWithinImage(fileOffset, symbol.st_size, image);
+}
+
+bool
+scanSectionsAndSymbols(Elf *elf, const std::vector<uint8_t> &image,
+                       const protocol::CodeObjectManifest &manifest,
+                       const uint8_t *&metadata, size_t &metadataSize)
+{
+    bool foundMetadata = false;
+    uint64_t relocationCount = 0;
+    unsigned codeMatches = 0;
+    unsigned descriptorMatches = 0;
+    const char *kernelName =
+        reinterpret_cast<const char *>(manifest.kernelName.data());
+    const char *descriptorName =
+        reinterpret_cast<const char *>(manifest.descriptorSymbol.data());
+
+    size_t sectionCount = 0;
+    if (elf_getshdrnum(elf, &sectionCount) != 0 || sectionCount == 0)
+        return false;
+    size_t sectionNamesIndex = 0;
+    if (elf_getshdrstrndx(elf, &sectionNamesIndex) != 0 ||
+        sectionNamesIndex >= sectionCount) {
+        return false;
+    }
+    Elf_Scn *section = nullptr;
+    while ((section = elf_nextscn(elf, section)) != nullptr) {
+        GElf_Shdr header;
+        if (gelf_getshdr(section, &header) == nullptr)
+            return false;
+        const char *sectionName = elf_strptr(
+            elf, sectionNamesIndex, header.sh_name);
+        if (sectionName == nullptr ||
+            (header.sh_type == SHT_NOTE &&
+             std::strcmp(sectionName, ".note") != 0)) {
+            return false;
+        }
+        if (header.sh_type != SHT_NOBITS &&
+            !rangeWithinImage(header.sh_offset, header.sh_size, image)) {
+            return false;
+        }
+        if (header.sh_type == SHT_NOTE &&
+            !findMetadataNote(image, header.sh_offset, header.sh_size,
+                              metadata, metadataSize, foundMetadata)) {
+            return false;
+        }
+        if (header.sh_type == SHT_REL || header.sh_type == SHT_RELA) {
+            if (header.sh_size != 0 &&
+                (header.sh_entsize == 0 ||
+                 header.sh_size % header.sh_entsize != 0)) {
+                return false;
+            }
+            const uint64_t count = header.sh_size == 0 ? 0 :
+                header.sh_size / header.sh_entsize;
+            if (count > std::numeric_limits<uint64_t>::max() - relocationCount)
+                return false;
+            relocationCount += count;
+        }
+        if (header.sh_type != SHT_SYMTAB)
+            continue;
+        if (header.sh_entsize == 0 ||
+            header.sh_size % header.sh_entsize != 0)
+            return false;
+        const uint64_t count = header.sh_size / header.sh_entsize;
+        if (count > static_cast<uint64_t>(INT_MAX))
+            return false;
+        Elf_Data *data = elf_getdata(section, nullptr);
+        if (data == nullptr || elf_getdata(section, data) != nullptr)
+            return false;
+        for (uint64_t index = 0; index < count; ++index) {
+            GElf_Sym symbol;
+            if (gelf_getsym(data, static_cast<int>(index), &symbol) == nullptr)
+                return false;
+            const char *name = elf_strptr(elf, header.sh_link, symbol.st_name);
+            if (name == nullptr)
+                return false;
+            const bool isCode = std::strcmp(name, kernelName) == 0;
+            const bool isDescriptor = std::strcmp(name, descriptorName) == 0;
+            if (!isCode && !isDescriptor)
+                continue;
+            uint64_t fileOffset = 0;
+            if (GELF_ST_BIND(symbol.st_info) != STB_GLOBAL ||
+                (symbol.st_other & 0x3) != STV_PROTECTED ||
+                !symbolFileOffset(elf, symbol, image, fileOffset, isCode)) {
+                return false;
+            }
+            if (isCode) {
+                ++codeMatches;
+                if (GELF_ST_TYPE(symbol.st_info) != STT_FUNC ||
+                    symbol.st_value != manifest.codeVirtualAddress ||
+                    symbol.st_size != manifest.codeSize ||
+                    fileOffset != manifest.codeFileOffset) {
+                    return false;
+                }
+            }
+            if (isDescriptor) {
+                ++descriptorMatches;
+                if (GELF_ST_TYPE(symbol.st_info) != STT_OBJECT ||
+                    symbol.st_value != manifest.descriptorVirtualAddress ||
+                    symbol.st_size != manifest.descriptorSize ||
+                    fileOffset != manifest.descriptorFileOffset) {
+                    return false;
+                }
+            }
+        }
+    }
+    return foundMetadata && relocationCount == manifest.relocationCount &&
+        codeMatches == 1 && descriptorMatches == 1;
+}
+
+bool
+descriptorMatches(const std::vector<uint8_t> &image,
+                  const protocol::CodeObjectManifest &manifest)
+{
+    if (!rangeWithinImage(manifest.descriptorFileOffset,
+                          protocol::CodeObjectDescriptorBytes, image)) {
+        return false;
+    }
+    const uint8_t *descriptor =
+        image.data() + static_cast<size_t>(manifest.descriptorFileOffset);
+    return std::equal(manifest.descriptor.begin(), manifest.descriptor.end(),
+                      descriptor) &&
+        loadLittle32(descriptor) == manifest.groupSegmentFixedSize &&
+        loadLittle32(descriptor + 4) == manifest.privateSegmentFixedSize &&
+        loadLittle32(descriptor + 8) == manifest.kernargSegmentSize &&
+        loadLittleSigned64(descriptor + 16) ==
+            manifest.kernelCodeEntryByteOffset;
+}
+
+} // anonymous namespace
+
+bool
+validateCodeObjectImage(
+    const std::vector<uint8_t> &image,
+    const protocol::CodeObjectManifest &manifest)
+{
+    if (image.empty() || image.size() != manifest.imageSize ||
+        elf_version(EV_CURRENT) == EV_NONE) {
+        return false;
+    }
+    ElfHandle elf(elf_memory(
+        reinterpret_cast<char *>(const_cast<uint8_t *>(image.data())),
+        image.size()));
+    if (elf.get() == nullptr || elf_kind(elf.get()) != ELF_K_ELF ||
+        gelf_getclass(elf.get()) != ELFCLASS64) {
+        return false;
+    }
+    GElf_Ehdr header;
+    if (gelf_getehdr(elf.get(), &header) == nullptr ||
+        header.e_ident[EI_CLASS] != ELFCLASS64 ||
+        header.e_ident[EI_DATA] != ELFDATA2LSB ||
+        header.e_ident[EI_VERSION] != EV_CURRENT ||
+        header.e_ident[EI_OSABI] != AmdgpuHsaOsabi ||
+        header.e_ident[EI_OSABI] != manifest.elfOsabi ||
+        header.e_ident[EI_ABIVERSION] != manifest.elfAbiVersion ||
+        header.e_version != EV_CURRENT || header.e_type != ET_DYN ||
+        header.e_type != manifest.elfType ||
+        header.e_machine != AmdgpuMachine ||
+        header.e_machine != manifest.elfMachine ||
+        header.e_entry != 0 ||
+        header.e_flags != manifest.elfFlags ||
+        !segmentTableMatches(elf.get(), image, manifest)) {
+        return false;
+    }
+
+    const uint8_t *metadataBytes = nullptr;
+    size_t metadataSize = 0;
+    if (!scanSectionsAndSymbols(elf.get(), image, manifest,
+                                metadataBytes, metadataSize) ||
+        !descriptorMatches(image, manifest)) {
+        return false;
+    }
+    Metadata metadata;
+    if (!parseMetadata(metadataBytes, metadataSize, manifest.kernelIndex,
+                       metadata) || !metadataMatches(metadata, manifest)) {
+        return false;
+    }
+    const uint8_t abiVersion = header.e_ident[EI_ABIVERSION];
+    const uint32_t expectedCodeObjectVersion = abiVersion + 2;
+    const uint32_t expectedMetadataMinor = abiVersion == 2 ? 1 : 2;
+    return manifest.codeObjectVersion == expectedCodeObjectVersion &&
+        metadata.major == 1 && metadata.minor == expectedMetadataMinor;
+}

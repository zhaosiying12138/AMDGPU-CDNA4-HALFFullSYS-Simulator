+protocol::CodeObjectManifest
+manifest()
+{
+    protocol::CodeObjectManifest result;
+    result.imageSize = imageBytes().size();
+    result.chunkDataBytes = protocol::CodeObjectChunkDataBytes;
+    result.chunkCount = 1;
+    result.segmentCount = 2;
+    result.imageSha256 = imageSha256();
+    result.elfMachine = 224;
+    result.elfType = 3;
+    result.elfOsabi = 64;
+    result.elfAbiVersion = 4;
+    result.elfFlags = 0x54f;
+    result.gfxTarget = 950;
+    result.codeObjectVersion = 6;
+    result.metadataMajor = 1;
+    result.metadataMinor = 2;
+    result.kernargSegmentSize = 8;
+    result.kernargSegmentAlign = 8;
+    result.sgprCount = 12;
+    result.vgprCount = 8;
+    result.maxFlatWorkgroupSize = 64;
+    result.wavefrontSize = 64;
+    result.kernelCodeEntryByteOffset = 0x1100;
+    result.codeVirtualAddress = 0x1600;
+    result.codeFileOffset = 0x600;
+    result.codeSize = 0x80;
+    result.descriptorVirtualAddress = 0x500;
+    result.descriptorFileOffset = 0x500;
+    const auto image = imageBytes();
+    std::copy_n(image.begin() + result.descriptorFileOffset,
+                protocol::CodeObjectDescriptorBytes,
+                result.descriptor.begin());
+    result.segments[0].type = 1;
+    result.segments[0].flags = 4;
+    result.segments[0].fileOffset = 0;
+    result.segments[0].virtualAddress = 0;
+    result.segments[0].fileSize = 0x540;
+    result.segments[0].memorySize = 0x540;
+    result.segments[0].alignment = 0x100;
+    result.segments[1].type = 1;
+    result.segments[1].flags = 5;
+    result.segments[1].fileOffset = 0x600;
+    result.segments[1].virtualAddress = 0x1600;
+    result.segments[1].fileSize = 0x80;
+    result.segments[1].memorySize = 0x80;
+    result.segments[1].alignment = 0x100;
+    const char *kernel = "vecadd";
+    const char *descriptor = "vecadd.kd";
+    std::copy(kernel, kernel + std::strlen(kernel), result.kernelName.begin());
+    std::copy(descriptor, descriptor + std::strlen(descriptor),
+              result.descriptorSymbol.begin());
+    return result;
+}
+
+protocol::CodeObjectRequest
+beginRequest()
+{
+    protocol::CodeObjectRequest request;
+    request.opcode = CodeObjectOpcode::Begin;
+    request.manifest = manifest();
+    return request;
+}
+
+protocol::CodeObjectRequest
+chunkRequest(uint64_t objectId, uint64_t generation)
+{
+    protocol::CodeObjectRequest request;
+    request.opcode = CodeObjectOpcode::Chunk;
+    request.objectId = objectId;
+    request.generation = generation;
+    const auto image = imageBytes();
+    request.byteCount = image.size();
+    request.chunkIndex = 0;
+    std::copy(image.begin(), image.end(), request.chunkData.begin());
+    request.chunkCrc32c = protocol::crc32c(request.chunkData.data(),
+                                            request.byteCount);
+    return request;
+}
+
+protocol::CodeObjectRequest
+commitRequest(uint64_t objectId, uint64_t generation)
+{
+    protocol::CodeObjectRequest request;
+    request.opcode = CodeObjectOpcode::Commit;
+    request.objectId = objectId;
+    request.generation = generation;
+    request.byteCount = imageBytes().size();
+    request.chunkIndex = 1;
+    request.commitSha256 = imageSha256();
+    return request;
+}
+
+void
+expectCommitIdentityFailure(const protocol::CodeObjectManifest &badManifest)
+{
+    HostGPUCodeObjectState state;
+    auto request = beginRequest();
+    request.manifest = badManifest;
+    const auto begin = state.submit(owner(), request, 1);
+    ASSERT_TRUE(begin.accepted);
+    ASSERT_TRUE(state.submit(
+        owner(), chunkRequest(begin.response.objectId,
+                              begin.response.generation), 2).accepted);
+    const auto commit = state.submit(
+        owner(), commitRequest(begin.response.objectId,
+                               begin.response.generation), 3);
+    EXPECT_FALSE(commit.accepted);
+    EXPECT_EQ(commit.response.status, protocol::Status::ProtocolState);
+    EXPECT_EQ(state.activeUploadCount(), 0U);
+    EXPECT_EQ(state.objectCount(), 0U);
+}

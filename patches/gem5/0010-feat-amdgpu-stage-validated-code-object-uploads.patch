+TEST(HostGpuProtocol, CodeObjectChunkPaddingAndAckAddressesAreStrict)
+{
+    CodeObjectRequest chunk;
+    chunk.opcode = CodeObjectOpcode::Chunk;
+    chunk.objectId = 1;
+    chunk.generation = 2;
+    chunk.byteCount = 1;
+    chunk.chunkData[0] = 0xa5;
+    chunk.chunkCrc32c = crc32c(chunk.chunkData.data(), chunk.byteCount);
+    auto frame = encodeCodeObjectRequest(goldenMemoryHeader(93), chunk);
+    frame[HeaderBytes + CodeObjectChunkDataOffset + 1] = 1;
+    recomputeCrc(frame);
+    const auto decoded = decodeCodeObjectRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+
+    CodeObjectResponse response;
+    response.status = Status::Ok;
+    response.opcode = CodeObjectOpcode::Chunk;
+    response.objectId = 1;
+    response.generation = 2;
+    response.acceptedOffset = 3;
+    response.byteCount = 1;
+    response.chunkIndex = 7;
+    response.imageBytes = 128;
+    response.mappedGpuVa = response.descriptorGpuVa =
+        response.codeGpuVa = response.kernargGpuVa = 0xdeadbeef;
+    frame = encodeCodeObjectAck(goldenMemoryHeader(94), response);
+    ASSERT_EQ(frame.size(), CodeObjectRecordBytes);
+    const uint8_t *payload = frame.data() + HeaderBytes;
+    EXPECT_EQ(load64(payload + 32), 3U);
+    EXPECT_EQ(load32(payload + 40), 1U);
+    EXPECT_EQ(load32(payload + 44), 7U);
+    EXPECT_EQ(load64(payload + 48), 0U);
+    EXPECT_EQ(load64(payload + 56), 0U);
+    EXPECT_EQ(load64(payload + 64), 0U);
+    EXPECT_EQ(load64(payload + 72), 0U);
+    EXPECT_TRUE(std::all_of(payload + 141, payload + CodeObjectPayloadBytes,
+                            [](uint8_t byte) { return byte == 0; }));
+
+    response.status = Status::Malformed;
+    response.simTick = 99;
+    response.imageSha256.fill(0xa5);
+    response.errorCode = static_cast<uint32_t>(Status::Malformed);
+    frame = encodeCodeObjectAck(goldenMemoryHeader(97), response);
+    payload = frame.data() + HeaderBytes;
+    EXPECT_TRUE(std::all_of(payload + 16, payload + 96,
+                            [](uint8_t byte) { return byte == 0; }));
+    EXPECT_EQ(load64(payload + 96), 99U);
+    EXPECT_TRUE(std::all_of(payload + 104, payload + 136,
+                            [](uint8_t byte) { return byte == 0; }));
+    EXPECT_EQ(load32(payload + 136),
+              static_cast<uint32_t>(Status::Malformed));
+}

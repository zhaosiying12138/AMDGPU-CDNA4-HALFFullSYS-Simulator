+CodeObjectDecodeResult
+decodeCodeObjectRequestRecord(const uint8_t *record, size_t size,
+                              uint32_t configuredMaximum)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason)) {
+        CodeObjectDecodeResult result;
+        result.reason = reason;
+        return result;
+    }
+    if (header.messageType != MessageType::CodeObjectRequest) {
+        CodeObjectDecodeResult result;
+        result.reason = "expected CODE_OBJECT_REQUEST";
+        return result;
+    }
+    if (size - HeaderBytes != CodeObjectPayloadBytes) {
+        CodeObjectDecodeResult result;
+        result.reason = "code-object payload length";
+        return result;
+    }
+
+    CodeObjectRequest request;
+    request.major = load16(payload);
+    request.minor = load16(payload + 2);
+    const uint16_t rawOpcode = load16(payload + 4);
+    request.opcode = static_cast<CodeObjectOpcode>(rawOpcode);
+    request.flags = load16(payload + 6);
+    request.objectId = load64(payload + 8);
+    request.generation = load64(payload + 16);
+    request.imageOffset = load64(payload + 24);
+    request.byteCount = load32(payload + 32);
+    request.chunkIndex = load32(payload + 36);
+    request.chunkCrc32c = load32(payload + 40);
+    request.reserved = load32(payload + 44);
+
+    auto acknowledge = [&](Status status, const std::string &why) {
+        CodeObjectDecodeResult result;
+        result.action = DecodeAction::Acknowledge;
+        result.closeConnection = false;
+        result.status = status;
+        result.reason = why;
+        result.header = header;
+        result.request = request;
+        return result;
+    };

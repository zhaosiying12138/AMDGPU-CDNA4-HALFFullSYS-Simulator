+}
+
+TEST(HostGPUCodeObjectState, DescriptorMismatchAbortsCommit)
+{
+    HostGPUCodeObjectState state;
+    auto beginRequestWithWrongDescriptor = beginRequest();
+    beginRequestWithWrongDescriptor.manifest.descriptor[0] ^= 1;
+    const auto begin = state.submit(owner(), beginRequestWithWrongDescriptor, 1);
+    ASSERT_TRUE(begin.accepted);
+    auto chunk = chunkRequest(begin.response.objectId,
+                              begin.response.generation);
+    ASSERT_TRUE(state.submit(owner(), chunk, 2).accepted);
+    const auto commit = state.submit(
+        owner(), commitRequest(begin.response.objectId,
+                               begin.response.generation), 3);
+    EXPECT_EQ(commit.response.status, protocol::Status::ProtocolState);
+    EXPECT_EQ(state.activeUploadCount(), 0U);
+    EXPECT_EQ(state.committedCount(), 0U);
+}
+
+TEST(HostGPUCodeObjectState, GfxTargetMismatchIsNotAnAcceptedBegin)
+{
+    HostGPUCodeObjectState state;
+    auto request = beginRequest();
+    request.manifest.gfxTarget = 951;
+    const auto result = state.submit(owner(), request, 1);
+    EXPECT_FALSE(result.accepted);
+    EXPECT_FALSE(result.committed);
+    EXPECT_EQ(result.response.status, protocol::Status::TopologyMismatch);
+    EXPECT_EQ(result.response.objectId, 0U);
+    EXPECT_EQ(result.response.generation, 0U);
+    EXPECT_EQ(state.objectCount(), 0U);
+}

+TEST(HostGpuProtocol, CodeObjectCapabilityUsesBitSevenOnly)
+{
+    const auto capability = codeObjectTransferCapability();
+    EXPECT_EQ(capability[CodeObjectTransferCapabilityByte],
+              CodeObjectTransferCapabilityMask);
+    for (size_t index = 1; index < capability.size(); ++index)
+        EXPECT_EQ(capability[index], 0U);
+
+    auto server = goldenServer();
+    server.supported[0] |= CodeObjectTransferCapabilityMask;
+    auto hello = goldenHello();
+    hello.offered[0] |= CodeObjectTransferCapabilityMask;
+    auto negotiated = negotiate(goldenHeader(), hello, server);
+    ASSERT_EQ(negotiated.status, Status::Ok);
+    EXPECT_EQ(negotiated.selected[0] & CodeObjectTransferCapabilityMask, 0U);
+    hello.required[0] |= CodeObjectTransferCapabilityMask;
+    negotiated = negotiate(goldenHeader(), hello, server);
+    ASSERT_EQ(negotiated.status, Status::Ok);
+    EXPECT_EQ(negotiated.selected[0] & CodeObjectTransferCapabilityMask,
+              CodeObjectTransferCapabilityMask);
+}

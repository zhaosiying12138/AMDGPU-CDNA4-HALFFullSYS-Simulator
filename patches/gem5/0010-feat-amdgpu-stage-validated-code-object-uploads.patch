+
+#include "dev/amdgpu/host_gpu_code_object_state.hh"
+
+#include "dev/amdgpu/host_gpu_code_object_image.hh"
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+namespace gem5
+{
+namespace hostgpu
+{
+namespace
+{
+
+using protocol::CodeObjectOpcode;
+
+HostGPUCodeObjectState::Owner
+owner(int fd = 7, uint64_t generation = 9)
+{
+    return {fd, generation};
+}
+
+protocol::Sha256
+imageSha256()
+{
+    return {
+        0x7b, 0x55, 0xb7, 0xae, 0x2a, 0x2e, 0x2c, 0x2c,
+        0x27, 0x10, 0x57, 0xd0, 0xf0, 0xad, 0x6c, 0xaa,
+        0x46, 0x97, 0x6d, 0x69, 0xb8, 0x71, 0xed, 0xae,
+        0xd5, 0x79, 0xba, 0xd3, 0xac, 0x9a, 0x19, 0x41,
+    };
+}
+
+void
+put16(std::vector<uint8_t> &bytes, size_t offset, uint16_t value)
+{
+    bytes[offset] = static_cast<uint8_t>(value);
+    bytes[offset + 1] = static_cast<uint8_t>(value >> 8);
+}
+
+void
+put32(std::vector<uint8_t> &bytes, size_t offset, uint32_t value)
+{
+    for (unsigned index = 0; index < 4; ++index)
+        bytes[offset + index] = static_cast<uint8_t>(value >> (index * 8));
+}
+
+void
+put64(std::vector<uint8_t> &bytes, size_t offset, uint64_t value)
+{
+    for (unsigned index = 0; index < 8; ++index)
+        bytes[offset + index] = static_cast<uint8_t>(value >> (index * 8));
+}
+
+void
+appendMessageString(std::vector<uint8_t> &bytes, const char *text)
+{
+    const size_t size = std::strlen(text);
+    ASSERT_LE(size, 31U);
+    bytes.push_back(static_cast<uint8_t>(0xa0 | size));
+    bytes.insert(bytes.end(), text, text + size);
+}
+
+void
+appendMessageNumber(std::vector<uint8_t> &bytes, uint8_t value)
+{
+    ASSERT_LE(value, 0x7f);
+    bytes.push_back(value);
+}
+
+std::vector<uint8_t>
+imageBytes()
+{
+    constexpr size_t ImageSize = 0xa00;
+    constexpr size_t NoteOffset = 0x200;
+    constexpr size_t DescriptorOffset = 0x500;
+    constexpr size_t CodeOffset = 0x600;
+    constexpr size_t SymbolOffset = 0x680;
+    constexpr size_t StringOffset = 0x6d0;
+    constexpr size_t SectionStringOffset = 0x720;
+    constexpr size_t SectionHeaderOffset = 0x800;
+    std::vector<uint8_t> image(ImageSize, 0);
+
+    image[0] = 0x7f;
+    image[1] = 'E';
+    image[2] = 'L';
+    image[3] = 'F';
+    image[4] = 2;
+    image[5] = 1;
+    image[6] = 1;
+    image[7] = 64;
+    image[8] = 4;
+    put16(image, 16, 3);
+    put16(image, 18, 224);
+    put32(image, 20, 1);
+    put64(image, 32, 64);
+    put64(image, 40, SectionHeaderOffset);
+    put32(image, 48, 0x54f);
+    put16(image, 52, 64);
+    put16(image, 54, 56);
+    put16(image, 56, 2);
+    put16(image, 58, 64);
+    put16(image, 60, 7);
+    put16(image, 62, 6);
+
+    put32(image, 64, 1);
+    put32(image, 68, 4);
+    put64(image, 96, 0x540);
+    put64(image, 104, 0x540);
+    put64(image, 112, 0x100);
+    put32(image, 120, 1);
+    put32(image, 124, 5);
+    put64(image, 128, CodeOffset);
+    put64(image, 136, 0x1600);
+    put64(image, 144, 0x1600);
+    put64(image, 152, 0x80);
+    put64(image, 160, 0x80);
+    put64(image, 168, 0x100);
+
+    std::vector<uint8_t> metadata;
+    metadata.push_back(0x83);
+    appendMessageString(metadata, "amdhsa.kernels");
+    metadata.push_back(0x91);
+    metadata.push_back(0x8b);
+    appendMessageString(metadata, ".name");
+    appendMessageString(metadata, "vecadd");
+    appendMessageString(metadata, ".symbol");
+    appendMessageString(metadata, "vecadd.kd");
+    appendMessageString(metadata, ".kernarg_segment_size");
+    appendMessageNumber(metadata, 8);
+    appendMessageString(metadata, ".kernarg_segment_align");
+    appendMessageNumber(metadata, 8);
+    appendMessageString(metadata, ".group_segment_fixed_size");
+    appendMessageNumber(metadata, 0);
+    appendMessageString(metadata, ".private_segment_fixed_size");
+    appendMessageNumber(metadata, 0);
+    appendMessageString(metadata, ".max_flat_workgroup_size");
+    appendMessageNumber(metadata, 64);
+    appendMessageString(metadata, ".wavefront_size");
+    appendMessageNumber(metadata, 64);
+    appendMessageString(metadata, ".sgpr_count");
+    appendMessageNumber(metadata, 12);
+    appendMessageString(metadata, ".vgpr_count");
+    appendMessageNumber(metadata, 8);
+    appendMessageString(metadata, ".uses_dynamic_stack");
+    appendMessageNumber(metadata, 0);
+    appendMessageString(metadata, "amdhsa.target");
+    appendMessageString(metadata, "amdgcn-amd-amdhsa--gfx950");
+    appendMessageString(metadata, "amdhsa.version");
+    metadata.push_back(0x92);
+    appendMessageNumber(metadata, 1);
+    appendMessageNumber(metadata, 2);
+
+    const size_t paddedMetadataSize = (metadata.size() + 3) & ~size_t(3);
+    const size_t noteSize = 20 + paddedMetadataSize;
+    EXPECT_LT(NoteOffset + noteSize, DescriptorOffset);
+    put32(image, NoteOffset, 7);
+    put32(image, NoteOffset + 4, static_cast<uint32_t>(metadata.size()));
+    put32(image, NoteOffset + 8, 32);
+    std::copy_n(reinterpret_cast<const uint8_t *>("AMDGPU"), 7,
+                image.begin() + NoteOffset + 12);
+    std::copy(metadata.begin(), metadata.end(), image.begin() + NoteOffset + 20);
+
+    put32(image, DescriptorOffset, 0);
+    put32(image, DescriptorOffset + 4, 0);
+    put32(image, DescriptorOffset + 8, 8);
+    put64(image, DescriptorOffset + 16, 0x1100);
+    put32(image, DescriptorOffset + 48, 0x00af0080);
+    put32(image, DescriptorOffset + 52, 0x88);
+    for (size_t index = 0; index < 0x80; ++index)
+        image[CodeOffset + index] = static_cast<uint8_t>(0x80 + index);
+
+    const char strings[] = "\0vecadd\0vecadd.kd\0";
+    std::copy_n(reinterpret_cast<const uint8_t *>(strings), sizeof(strings),
+                image.begin() + StringOffset);
+    put32(image, SymbolOffset + 24, 1);
+    image[SymbolOffset + 28] = 0x12;
+    image[SymbolOffset + 29] = 3;
+    put16(image, SymbolOffset + 30, 3);
+    put64(image, SymbolOffset + 32, 0x1600);
+    put64(image, SymbolOffset + 40, 0x80);
+    put32(image, SymbolOffset + 48, 8);
+    image[SymbolOffset + 52] = 0x11;
+    image[SymbolOffset + 53] = 3;
+    put16(image, SymbolOffset + 54, 2);
+    put64(image, SymbolOffset + 56, 0x500);
+    put64(image, SymbolOffset + 64, 64);
+
+    std::vector<uint8_t> sectionStrings = {0};
+    auto addSectionName = [&sectionStrings](const char *name) {
+        const uint32_t offset = sectionStrings.size();
+        sectionStrings.insert(sectionStrings.end(), name,
+                              name + std::strlen(name) + 1);
+        return offset;
+    };
+    const uint32_t noteName = addSectionName(".note");
+    const uint32_t rodataName = addSectionName(".rodata");
+    const uint32_t textName = addSectionName(".text");
+    const uint32_t symtabName = addSectionName(".symtab");
+    const uint32_t strtabName = addSectionName(".strtab");
+    const uint32_t shstrtabName = addSectionName(".shstrtab");
+    std::copy(sectionStrings.begin(), sectionStrings.end(),
+              image.begin() + SectionStringOffset);
+
+    auto section = [&image](size_t index) {
+        return size_t(0x800 + index * 64);
+    };
+    put32(image, section(1), noteName);
+    put32(image, section(1) + 4, 7);
+    put64(image, section(1) + 8, 2);
+    put64(image, section(1) + 16, NoteOffset);
+    put64(image, section(1) + 24, NoteOffset);
+    put64(image, section(1) + 32, noteSize);
+    put64(image, section(1) + 48, 4);
+    put32(image, section(2), rodataName);
+    put32(image, section(2) + 4, 1);
+    put64(image, section(2) + 8, 2);
+    put64(image, section(2) + 16, 0x500);
+    put64(image, section(2) + 24, DescriptorOffset);
+    put64(image, section(2) + 32, 64);
+    put64(image, section(2) + 48, 64);
+    put32(image, section(3), textName);
+    put32(image, section(3) + 4, 1);
+    put64(image, section(3) + 8, 6);
+    put64(image, section(3) + 16, 0x1600);
+    put64(image, section(3) + 24, CodeOffset);
+    put64(image, section(3) + 32, 0x80);
+    put64(image, section(3) + 48, 0x100);
+    put32(image, section(4), symtabName);
+    put32(image, section(4) + 4, 2);
+    put64(image, section(4) + 24, SymbolOffset);
+    put64(image, section(4) + 32, 72);
+    put32(image, section(4) + 40, 5);
+    put32(image, section(4) + 44, 1);
+    put64(image, section(4) + 48, 8);
+    put64(image, section(4) + 56, 24);
+    put32(image, section(5), strtabName);
+    put32(image, section(5) + 4, 3);
+    put64(image, section(5) + 24, StringOffset);
+    put64(image, section(5) + 32, sizeof(strings));
+    put64(image, section(5) + 48, 1);
+    put32(image, section(6), shstrtabName);
+    put32(image, section(6) + 4, 3);
+    put64(image, section(6) + 24, SectionStringOffset);
+    put64(image, section(6) + 32, sectionStrings.size());
+    put64(image, section(6) + 48, 1);
+    return image;
+}

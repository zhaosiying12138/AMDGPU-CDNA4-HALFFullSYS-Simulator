+inline protocol::Status
+codeObjectRequestStatus(protocol::Status decodedStatus,
+                        protocol::Status sessionStatus)
+{
+    if (decodedStatus == protocol::Status::Malformed ||
+        decodedStatus == protocol::Status::UnsupportedVersion) {
+        return decodedStatus;
+    }
+    if (sessionStatus == protocol::Status::InstanceMismatch ||
+        sessionStatus == protocol::Status::ProtocolState) {
+        return sessionStatus;
+    }
+    if (decodedStatus == protocol::Status::TopologyMismatch)
+        return decodedStatus;
+    if (sessionStatus != protocol::Status::Ok)
+        return sessionStatus;
+    return decodedStatus;
+}

+TEST(HostGpuProtocol, CodeObjectManifestValidationCoversRangesAndVersions)
+{
+    const auto valid = goldenCodeObjectManifest();
+    EXPECT_EQ(validateCodeObjectManifest(valid),
+              CodeObjectManifestValidation::Valid);
+
+    auto malformed = valid;
+    malformed.segments[1].flags = 7;
+    EXPECT_EQ(validateCodeObjectManifest(malformed),
+              CodeObjectManifestValidation::Malformed);
+
+    malformed = valid;
+    malformed.segments[1].alignment = 3;
+    EXPECT_EQ(validateCodeObjectManifest(malformed),
+              CodeObjectManifestValidation::Malformed);
+
+    malformed = valid;
+    malformed.segments[1].fileOffset = 32;
+    EXPECT_EQ(validateCodeObjectManifest(malformed),
+              CodeObjectManifestValidation::Malformed);
+
+    malformed = valid;
+    malformed.descriptorVirtualAddress = 0x41;
+    malformed.kernelCodeEntryByteOffset = 0x3f;
+    EXPECT_EQ(validateCodeObjectManifest(malformed),
+              CodeObjectManifestValidation::Malformed);
+
+    auto unsupported = valid;
+    unsupported.elfAbiVersion = 9;
+    EXPECT_EQ(validateCodeObjectManifest(unsupported),
+              CodeObjectManifestValidation::UnsupportedVersion);
+
+    auto topology = valid;
+    topology.gfxTarget = 951;
+    EXPECT_EQ(validateCodeObjectManifest(topology),
+              CodeObjectManifestValidation::TopologyMismatch);
+
+    auto topologyWithUnsupportedVersion = topology;
+    topologyWithUnsupportedVersion.elfAbiVersion = 9;
+    EXPECT_EQ(validateCodeObjectManifest(topologyWithUnsupportedVersion),
+              CodeObjectManifestValidation::UnsupportedVersion);
+}

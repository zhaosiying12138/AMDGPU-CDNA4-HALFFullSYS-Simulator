+CodeObjectManifestValidation
+validateCodeObjectManifest(const CodeObjectManifest &manifest)
+{
+    if (manifest.imageSize == 0 ||
+        manifest.imageSize > CodeObjectMaximumImageBytes ||
+        manifest.chunkDataBytes != CodeObjectChunkDataBytes ||
+        manifest.segmentCount == 0 ||
+        manifest.segmentCount > CodeObjectMaximumSegments ||
+        manifest.chunkCount == 0 || !codeObjectNulPaddedAscii(manifest.kernelName) ||
+        !codeObjectNulPaddedAscii(manifest.descriptorSymbol) ||
+        std::all_of(manifest.imageSha256.begin(), manifest.imageSha256.end(),
+                    [](uint8_t byte) { return byte == 0; }) ||
+        manifest.elfMachine != 224 || manifest.elfType != 3 ||
+        manifest.elfOsabi != 64 || manifest.elfReserved != 0 ||
+        (manifest.elfFlags & 0xffU) != 0x4fU ||
+        manifest.relocationCount != 0 || manifest.kernargSegmentSize == 0 ||
+        manifest.kernargSegmentAlign == 0 ||
+        (manifest.kernargSegmentAlign &
+         (manifest.kernargSegmentAlign - 1U)) != 0 ||
+        manifest.maxFlatWorkgroupSize == 0 || manifest.wavefrontSize != 64 ||
+        manifest.usesDynamicStack != 0 ||
+        manifest.descriptorSize != CodeObjectDescriptorBytes ||
+        (manifest.descriptorVirtualAddress & 63U) != 0 ||
+        manifest.codeSize == 0 || !signedEntryRelationValid(manifest)) {
+        return CodeObjectManifestValidation::Malformed;
+    }
+
+    const uint64_t expectedChunks =
+        (manifest.imageSize + CodeObjectChunkDataBytes - 1) /
+        CodeObjectChunkDataBytes;
+    if (expectedChunks > std::numeric_limits<uint32_t>::max() ||
+        manifest.chunkCount != expectedChunks) {
+        return CodeObjectManifestValidation::Malformed;
+    }
+
+    bool executableCodeRange = false;
+    bool readOnlyDescriptorRange = false;
+    for (size_t index = 0; index < CodeObjectMaximumSegments; ++index) {
+        const auto &segment = manifest.segments[index];
+        if (index >= manifest.segmentCount) {
+            if (segment.type != 0 || segment.flags != 0 ||
+                segment.fileOffset != 0 || segment.virtualAddress != 0 ||
+                segment.fileSize != 0 || segment.memorySize != 0 ||
+                segment.alignment != 0) {
+                return CodeObjectManifestValidation::Malformed;
+            }
+            continue;
+        }
+
+        if (segment.type != 1 || segment.memorySize < segment.fileSize ||
+            !powerOfTwoOrZero(segment.alignment) ||
+            (segment.flags != 4 && segment.flags != 5 && segment.flags != 6) ||
+            !rangeWithin(segment.fileOffset, segment.fileSize, 0,
+                         manifest.imageSize)) {
+            return CodeObjectManifestValidation::Malformed;
+        }
+
+        uint64_t ignoredVirtualEnd = 0;
+        if (!rangeEnd(segment.virtualAddress, segment.memorySize,
+                      ignoredVirtualEnd)) {
+            return CodeObjectManifestValidation::Malformed;
+        }
+
+        if (segment.flags == 5 &&
+            rangeWithin(manifest.codeFileOffset, manifest.codeSize,
+                        segment.fileOffset, segment.fileSize) &&
+            rangeWithin(manifest.codeVirtualAddress, manifest.codeSize,
+                        segment.virtualAddress, segment.memorySize)) {
+            executableCodeRange = true;
+        }
+        if (segment.flags == 4 &&
+            rangeWithin(manifest.descriptorFileOffset,
+                        CodeObjectDescriptorBytes, segment.fileOffset,
+                        segment.fileSize) &&
+            rangeWithin(manifest.descriptorVirtualAddress,
+                        CodeObjectDescriptorBytes, segment.virtualAddress,
+                        segment.memorySize)) {
+            readOnlyDescriptorRange = true;
+        }
+
+        for (size_t other = index + 1; other < manifest.segmentCount;
+             ++other) {
+            const auto &right = manifest.segments[other];
+            if (rangesOverlap(segment.fileOffset, segment.fileSize,
+                              right.fileOffset, right.fileSize) ||
+                rangesOverlap(segment.virtualAddress, segment.memorySize,
+                              right.virtualAddress, right.memorySize)) {
+                return CodeObjectManifestValidation::Malformed;
+            }
+        }
+    }
+
+    if (!executableCodeRange || !readOnlyDescriptorRange)
+        return CodeObjectManifestValidation::Malformed;
+
+    /* Version fields are reported separately only after all structural
+     * fields have passed malformed checks, preserving the wire precedence. */
+    if (manifest.elfAbiVersion < 2 || manifest.elfAbiVersion > 4 ||
+        manifest.codeObjectVersion < 4 || manifest.codeObjectVersion > 6 ||
+        manifest.metadataMajor != 1 ||
+        (manifest.metadataMinor != 1 && manifest.metadataMinor != 2)) {
+        return CodeObjectManifestValidation::UnsupportedVersion;
+    }
+    if (manifest.gfxTarget != 950)
+        return CodeObjectManifestValidation::TopologyMismatch;
+    return CodeObjectManifestValidation::Valid;
+}

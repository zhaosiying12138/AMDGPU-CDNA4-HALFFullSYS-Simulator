+#!/usr/bin/env python3
+# Copyright (c) 2026 The Regents of the University of California
+# SPDX-License-Identifier: BSD-3-Clause
+"""Unit tests for the source-only host-native boundary inventory."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = Path(__file__).with_name("check_boundary.py")
+
+
+def load_checker():
+    spec = importlib.util.spec_from_file_location(
+        "host_native_boundary", SCRIPT
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError("unable to load boundary checker")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class HostNativeBoundaryTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.checker = load_checker()
+
+    def test_inventory_is_complete_and_explicitly_non_execution(self):
+        checker = self.checker
+        inventory = checker.build_inventory(ROOT)
+        self.assertEqual(checker.validate_manifest(ROOT), [])
+        self.assertEqual(inventory["schema"], "gem5.host-native-boundary.v1")
+        self.assertGreaterEqual(len(inventory["reusable"]), 8)
+        self.assertGreaterEqual(len(inventory["x86_blocked"]), 8)
+        self.assertTrue(all(item["present"] for item in inventory["reusable"]))
+        self.assertTrue(
+            all(item["present"] for item in inventory["x86_blocked"])
+        )
+        self.assertEqual(inventory["native_gate"]["status"], "inventory_only")
+        self.assertTrue(
+            any("Triton" in claim for claim in inventory["no_claim"]))
+
+    def test_rendering_is_stable_and_json_decodable(self):
+        checker = self.checker
+        first = checker.render_inventory(ROOT)
+        second = checker.render_inventory(ROOT)
+        self.assertEqual(first, second)
+        self.assertTrue(first.endswith("\n"))
+        decoded = json.loads(first)
+        self.assertEqual(decoded["scan"]["missing_paths"], [])
+        self.assertEqual(decoded["scan"]["marker_errors"], [])
+
+    def test_schema_rejects_duplicate_cross_boundary_path(self):
+        checker = self.checker
+        manifest = deepcopy(checker.BOUNDARY_MANIFEST)
+        manifest["x86_blocked"].append(deepcopy(manifest["reusable"][0]))
+        errors = checker.validate_manifest(ROOT, manifest)
+        self.assertTrue(
+            any("both reusable and x86_blocked" in error for error in errors)
+        )
+
+    def test_cli_check_has_no_build_or_execution_side_effect(self):
+        proc = subprocess.run(
+            [sys.executable, str(SCRIPT), "--check"],
+            cwd=ROOT,
+            check=False,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        output = json.loads(proc.stdout)
+        self.assertEqual(output["scope"], "gem5-source-architecture-only")
+        self.assertIn(

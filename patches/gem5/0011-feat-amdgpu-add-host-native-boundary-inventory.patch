+#!/usr/bin/env python3
+# Copyright (c) 2026 The Regents of the University of California
+# SPDX-License-Identifier: BSD-3-Clause
+"""Inventory the first host-native extraction boundary.
+
+The inventory is deliberately source-only.  It records the GPU/Vega modules
+which can be reused and the files which still bind the current path to x86,
+SE processes, or a simulated CPU context.  It does not build or execute gem5.
+
+The output is deterministic so it can be retained as a checkpoint artifact::
+
+    python3 util/host_native/check_boundary.py
+    python3 util/host_native/check_boundary.py --check
+
+``--check`` returns non-zero only when the manifest no longer describes the
+checked source tree (or when the manifest itself violates its schema).
+"""
+
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import json
+from pathlib import Path, PurePosixPath
+import sys
+from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence
+
+
+SCHEMA = "gem5.host-native-boundary.v1"
+DEFAULT_ROOT = Path(__file__).resolve().parents[2]
+
+
+# Keep this list small and source-grounded.  ``markers`` are intentionally
+# plain substrings: they make stale inventories fail loudly without requiring
+# a compiler or a gem5 build directory.

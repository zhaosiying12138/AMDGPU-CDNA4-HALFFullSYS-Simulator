+def _manifest_errors(manifest: Mapping[str, Any]) -> List[str]:
+    """Return schema errors without inspecting the source tree."""
+
+    errors: List[str] = []
+    if manifest.get("schema") != SCHEMA:
+        errors.append("schema must be %s" % SCHEMA)
+    for key in ("reusable", "x86_blocked"):
+        entries = manifest.get(key)
+        if not isinstance(entries, list) or not entries:
+            errors.append("%s must be a non-empty list" % key)
+            continue
+        seen: set[str] = set()
+        for index, entry in enumerate(entries):
+            label = "%s[%d]" % (key, index)
+            if not isinstance(entry, Mapping):
+                errors.append("%s must be an object" % label)
+                continue
+            path = entry.get("path")
+            if not isinstance(path, str) or not path:
+                errors.append("%s.path must be a non-empty string" % label)
+            else:
+                posix = PurePosixPath(path)
+                if posix.is_absolute() or ".." in posix.parts:
+                    errors.append("%s.path must be relative" % label)
+                if path in seen:
+                    errors.append("duplicate path in %s: %s" % (key, path))
+                seen.add(path)
+            if not isinstance(entry.get("reason"), str) or not entry["reason"]:
+                errors.append("%s.reason must be non-empty" % label)
+            evidence = entry.get("evidence")
+            if not isinstance(evidence, list) or not evidence or not all(
+                isinstance(item, str) and item for item in evidence
+            ):
+                errors.append(
+                    "%s.evidence must be a non-empty string list" % label)
+            markers = entry.get("markers")
+            if not isinstance(markers, list) or not markers or not all(
+                isinstance(item, str) and item for item in markers
+            ):
+                errors.append(
+                    "%s.markers must be a non-empty string list" % label)
+    paths = []
+    for key in ("reusable", "x86_blocked"):
+        for entry in manifest.get(key, []):
+            if isinstance(entry, Mapping) and isinstance(
+                entry.get("path"), str
+            ):
+                paths.append(entry["path"])
+    if len(paths) != len(set(paths)):
+        errors.append("a path cannot be both reusable and x86_blocked")
+    no_claim = manifest.get("no_claim")
+    if not isinstance(no_claim, list) or not no_claim or not all(
+        isinstance(item, str) and item for item in no_claim
+    ):
+        errors.append("no_claim must be a non-empty string list")
+    gate = manifest.get("native_gate")
+    if not isinstance(gate, Mapping) or gate.get("status") != "inventory_only":
+        errors.append("native_gate.status must be inventory_only")
+    return errors
+
+
+def _source_errors(root: Path, manifest: Mapping[str, Any]) -> List[str]:
+    """Return errors caused by a stale or incomplete source inventory."""
+
+    errors: List[str] = []
+    if not root.is_dir():
+        return ["scan root is not a directory: %s" % root]
+    for category in ("reusable", "x86_blocked"):
+        for entry in manifest.get(category, []):
+            if not isinstance(entry, Mapping) or not isinstance(
+                entry.get("path"), str
+            ):
+                continue
+            path = root / entry["path"]
+            if not path.is_file():
+                errors.append("missing source path: %s" % entry["path"])
+                continue
+            try:
+                text = path.read_text(encoding="utf-8", errors="replace")
+            except OSError as exc:
+                errors.append("cannot read %s: %s" % (entry["path"], exc))
+                continue
+            for marker in entry.get("markers", []):
+                if marker not in text:
+                    errors.append("marker %r missing from %s" %
+                                  (marker, entry["path"]))
+    return errors
+
+
+def validate_manifest(
+    root: Path, manifest: Optional[Mapping[str, Any]] = None
+) -> List[str]:
+    """Validate schema and source markers."""
+
+    selected = BOUNDARY_MANIFEST if manifest is None else manifest
+    return _manifest_errors(selected) + _source_errors(root, selected)
+
+
+def _inventory_entries(
+    root: Path, entries: Iterable[Mapping[str, Any]]
+) -> List[Dict[str, Any]]:
+    result: List[Dict[str, Any]] = []
+    for entry in entries:
+        path = root / entry["path"]
+        present = path.is_file()
+        found: List[str] = []
+        if present:
+            text = path.read_text(encoding="utf-8", errors="replace")
+            found = [marker for marker in entry["markers"] if marker in text]
+        result.append(
+            {
+                "path": entry["path"],
+                "reason": entry["reason"],
+                "evidence": list(entry["evidence"]),
+                "markers": list(entry["markers"]),
+                "present": present,
+                "markers_found": found,
+            }
+        )
+    return result
+
+
+def build_inventory(root: Path) -> Dict[str, Any]:
+    """Build a deterministic source inventory rooted at ``root``."""
+
+    errors = validate_manifest(root)
+    return {
+        "schema": SCHEMA,
+        "scope": "gem5-source-architecture-only",
+        "scan": {
+            "files_checked": len(BOUNDARY_MANIFEST["reusable"])
+            + len(BOUNDARY_MANIFEST["x86_blocked"]),
+            "missing_paths": sorted(
+                error.split(": ", 1)[1]
+                for error in errors
+                if error.startswith("missing source path: ")
+            ),
+            "marker_errors": sorted(
+                error for error in errors if error.startswith("marker ")
+            ),
+        },
+        "reusable": _inventory_entries(root, BOUNDARY_MANIFEST["reusable"]),
+        "x86_blocked": _inventory_entries(
+            root, BOUNDARY_MANIFEST["x86_blocked"]
+        ),
+        "native_gate": deepcopy(BOUNDARY_MANIFEST["native_gate"]),
+        "no_claim": list(BOUNDARY_MANIFEST["no_claim"]),
+    }
+
+
+def render_inventory(root: Path) -> str:
+    """Render inventory JSON with stable key and list ordering."""
+
+    return json.dumps(build_inventory(root), indent=2, sort_keys=True) + "\n"
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--root",
+        type=Path,
+        default=DEFAULT_ROOT,
+        help="gem5 source root (defaults to this checkout)",
+    )
+    parser.add_argument(
+        "--check",
+        action="store_true",
+        help="fail when the manifest schema or source markers are stale",
+    )
+    args = parser.parse_args(argv)
+    root = args.root.expanduser().resolve()
+    try:
+        output = render_inventory(root)
+        errors = validate_manifest(root)
+    except (OSError, KeyError, TypeError) as exc:
+        print("host-native boundary scan failed: %s" % exc, file=sys.stderr)
+        return 2
+    sys.stdout.write(output)
+    if args.check and errors:
+        for error in errors:
+            print("manifest error: %s" % error, file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+#include <algorithm>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+
+#include "dev/amdgpu/host_gpu_generic_dispatch_route.hh"
+
+namespace gem5::hostgpu
+{
+namespace
+{
+
+using namespace protocol;
+using generic_dispatch_route::sessionStatus;
+using generic_dispatch_route::stageStatus;
+
+void
+require(bool condition, const char *message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+Header
+header(uint64_t requestId)
+{
+    Header result;
+    result.requestId = requestId;
+    result.connectionId = 0xfeed;
+    result.jobEpoch = 7;
+    result.daemonUuid.fill(0x42);
+    return result;
+}
+
+Capabilities
+selectedCapabilities()
+{
+    Capabilities result = {};
+    /* GENERIC_DISPATCH_V2 is a compound capability: the negotiated session
+     * must also carry topology, queue, memory, signal, and code-object bits. */
+    result[0] = 0x01 | QueueControlCapabilityMask |
+        MemoryControlCapabilityMask | SignalEventCapabilityMask |
+        CodeObjectTransferCapabilityMask;
+    result[GenericDispatchCapabilityByte] |= GenericDispatchCapabilityMask;
+    return result;
+}
+
+GenericDispatchRequest
+mapRequest()
+{
+    GenericDispatchRequest result;
+    result.opcode = GenericDispatchOpcode::MapObject;
+    result.objectId = 7;
+    result.objectGeneration = 9;
+    result.map.kernargSegmentSize = 48;
+    result.map.kernargSegmentAlign = 8;
+    result.map.pageSize = GenericDispatchPageSize4K;
+    for (size_t index = 0; index < result.imageSha256.size(); ++index)
+        result.imageSha256[index] = static_cast<uint8_t>(index + 1);
+    std::copy_n("route-test", 10, result.kernelName.begin());
+    return result;
+}
+
+GenericDispatchRequest
+allocRequest()
+{
+    GenericDispatchRequest result = mapRequest();
+    result.opcode = GenericDispatchOpcode::AllocKernarg;
+    result.mappingId = 11;
+    result.mappingGeneration = 13;
+    result.imageSha256.fill(0);
+    result.kernelName.fill(0);
+    result.allocKernarg.sizeBytes = 48;
+    result.allocKernarg.alignmentBytes = 8;
+    return result;
+}
+
+GenericDispatchRequest
+submitRequest()
+{
+    GenericDispatchRequest result = mapRequest();
+    result.opcode = GenericDispatchOpcode::SubmitAql;
+    result.mappingId = 11;
+    result.mappingGeneration = 13;
+    result.queueId = 17;
+    result.queueGeneration = 19;
+    result.queueSequence = 23;
+    result.submit.kernargAllocationId = 29;
+    result.submit.kernargGeneration = 31;
+    result.submit.kernargSize = 48;
+    result.submit.signalId = 37;
+    result.submit.signalGeneration = 41;
+    result.submit.expectedSignalValueBits = 1;
+    result.submit.gridX = 64;
+    result.submit.gridY = 1;
+    result.submit.gridZ = 1;
+    result.submit.workgroupX = 64;
+    result.submit.workgroupY = 1;
+    result.submit.workgroupZ = 1;
+    result.submit.numWarps = 1;
+    result.submit.numCtas = 1;
+    result.submit.wavefrontSize = 64;
+    return result;
+}
+
+GenericDispatchRequest
+unmapRequest()
+{
+    GenericDispatchRequest result = mapRequest();
+    result.opcode = GenericDispatchOpcode::UnmapObject;
+    result.mappingId = 11;
+    result.mappingGeneration = 13;
+    result.imageSha256.fill(0);
+    result.kernelName.fill(0);
+    return result;
+}
+
+void
+run()
+{
+    const Uuid daemonUuid = [] {
+        Uuid value = {};
+        value.fill(0x42);
+        return value;
+    }();
+    const Header requestHeader = header(101);
+    const auto map = mapRequest();
+
+    /* Raw type-18 input is decodable without selected capabilities so the
+     * bridge can return a canonical UnsupportedCapability ACK. */
+    const auto rawFrame = encodeGenericDispatchRequest(requestHeader, map);
+    require(rawFrame.size() == GenericDispatchRecordBytes,
+            "raw type-18 frame was not encoded");
+    const auto raw = decodeGenericDispatchRequestRecord(
+        rawFrame.data(), rawFrame.size(), MaximumRecordBytes);
+    require(raw.action == DecodeAction::Acknowledge &&
+                raw.status == Status::Ok,
+            "raw type-18 frame did not decode");
+    const Capabilities absent = {};
+    require(sessionStatus(raw.header, absent, daemonUuid,
+                           requestHeader.connectionId,
+                           requestHeader.jobEpoch) ==
+                Status::UnsupportedCapability,
+            "unnegotiated type-18 was not rejected canonically");
+    uint32_t mutationCount = 0;
+    if (sessionStatus(raw.header, absent, daemonUuid,
+                      requestHeader.connectionId, requestHeader.jobEpoch) ==
+            Status::Ok) {
+        ++mutationCount;
+    }
+    require(mutationCount == 0, "unnegotiated route mutated state");
+
+    GenericDispatchResponse failure;
+    failure.status = Status::UnsupportedCapability;
+    failure.opcode = raw.request.opcode;
+    failure.objectId = raw.request.objectId;
+    failure.objectGeneration = raw.request.objectGeneration;
+    failure.mappingId = 99;
+    const auto ack = encodeGenericDispatchAck(raw.header, failure);
+    require(ack.size() == GenericDispatchRecordBytes,
+            "canonical unsupported ACK was not encoded");
+    const auto decodedAck = decodeGenericDispatchResponseRecord(
+        ack.data(), ack.size(), MaximumRecordBytes, raw.header.requestId,
+        MessageType::GenericDispatchAck);
+    require(decodedAck.action == DecodeAction::Acknowledge &&
+                decodedAck.status == Status::UnsupportedCapability,
+            "canonical unsupported ACK did not decode");
+    require(decodedAck.response.objectId == 0 &&
+                decodedAck.response.mappingId == 0 &&
+                decodedAck.response.mappedBaseVa == 0,
+            "unsupported ACK retained success fields");
+
+    const auto selected = selectedCapabilities();
+    require(sessionStatus(raw.header, selected, daemonUuid,
+                           requestHeader.connectionId,
+                           requestHeader.jobEpoch) == Status::Ok,
+            "selected generic capability was not accepted");
+
+    const auto alloc = allocRequest();
+    const auto allocFrame = encodeGenericDispatchRequest(
+        header(102), alloc, selected);
+    const auto allocDecoded = decodeGenericDispatchRequestRecord(
+        allocFrame.data(), allocFrame.size(), MaximumRecordBytes, selected);
+    require(allocDecoded.status == Status::Ok &&
+                stageStatus(allocDecoded.request) ==
+                    Status::UnsupportedCapability,
+            "logical ALLOC alignment was not rejected");
+    const auto submit = submitRequest();
+    const auto submitFrame = encodeGenericDispatchRequest(
+        header(103), submit, selected);
+    const auto submitDecoded = decodeGenericDispatchRequestRecord(
+        submitFrame.data(), submitFrame.size(), MaximumRecordBytes, selected);
+    require(submitDecoded.status == Status::Ok &&
+                stageStatus(submitDecoded.request) ==
+                    Status::UnsupportedCapability,
+            "SUBMIT was not rejected without queue/tick contracts");
+
+    require(stageStatus(map) == Status::Ok,
+            "selected MAP gate unexpectedly rejected 4K");
+    require(stageStatus(unmapRequest()) == Status::Ok,
+            "selected UNMAP gate unexpectedly rejected identity-only stage");
+    require(generic_dispatch_route::pageSizeSupported(
+                GenericDispatchPageSize64K),
+            "64K page policy was not recognized");
+}
+
+} // anonymous namespace
+} // namespace gem5::hostgpu
+
+int
+main()
+{
+    try {
+        gem5::hostgpu::run();
+    } catch (const std::exception &error) {
+        std::cerr << "host_gpu_generic_dispatch_route_core: "
+                  << error.what() << '\n';
+        return EXIT_FAILURE;
+    }
+    std::cout << "host_gpu_generic_dispatch_route_core: PASS\n";
+    return EXIT_SUCCESS;
+}

+/*
+ * The generic adapter is owner-bound and intentionally has one mapping and
+ * one kernarg lease.  Keep the complete dependency graph per client so a
+ * disconnect cannot accidentally reuse a lease or state record from another
+ * socket generation.  SUBMIT is deliberately not represented here yet: the
+ * wire route rejects it before native queue admission until packet/tick and
+ * completion ownership are fully wired.
+ */
+struct HostGPUBridge::GenericDispatchSession
+{
+    using Owner = HostGPUMemoryState::Owner;
+
+    Owner owner;
+    std::unique_ptr<HostNativeMemoryContext> context;
+    std::unique_ptr<HostNativeCodeObjectMapper> mapper;
+    std::unique_ptr<HostNativeCommandProcessorCore> commandProcessor;
+    std::unique_ptr<HostNativeDispatchStateV2> state;
+    protocol::GenericDispatchRequest mapRequest;
+    protocol::GenericDispatchRequest allocRequest;
+    protocol::GenericDispatchResponse mapResponse;
+    protocol::GenericDispatchResponse allocResponse;
+    bool mapped = false;
+    bool allocated = false;
+    bool kernargTombstone = false;
+
+    GenericDispatchSession(
+        HostGPUMemoryState &memory, const Owner &sessionOwner,
+        uint64_t pageBytes)
+        : owner(sessionOwner),
+          context(std::make_unique<HostNativeMemoryContext>(
+              memory, owner, pageBytes)),
+          mapper(std::make_unique<HostNativeCodeObjectMapper>(
+              memory, *context, owner)),
+          commandProcessor(std::make_unique<HostNativeCommandProcessorCore>()),
+          state(std::make_unique<HostNativeDispatchStateV2>(
+              memory, *context, *mapper, *commandProcessor, owner))
+    {
+    }
+
+    bool ownsKernarg(uint64_t allocationId, uint64_t generation) const
+    {
+        return allocated && allocResponse.status == protocol::Status::Ok &&
+            state && state->hasKernarg() &&
+            allocResponse.kernargAllocationId == allocationId &&
+            allocResponse.kernargGeneration == generation;
+    }
+
+    bool claimsKernarg(uint64_t allocationId, uint64_t generation) const
+    {
+        const bool active = ownsKernarg(allocationId, generation);
+        /* Keep a successful UNMAP identity as a tombstone so a late H2D
+         * cannot fall through to legacy memory mutation; failed/cleared
+         * allocations never set this bit. */
+        const bool stale = kernargTombstone && allocationId != 0 &&
+            generation != 0 &&
+            allocResponse.kernargAllocationId == allocationId &&
+            allocResponse.kernargGeneration == generation;
+        return active || stale;
+    }
+
+    bool publishKernarg(
+        uint64_t requestId, const protocol::MemoryRequest &memoryRequest,
+        const std::vector<uint8_t> &bytes)
+    {
+        if (!ownsKernarg(
+                memoryRequest.allocationId, memoryRequest.generation) ||
+            !state) {
+            return false;
+        }
+        return state->publishKernarg(
+            {owner, requestId}, allocRequest, memoryRequest.offset,
+            memoryRequest.allocationId, memoryRequest.generation, bytes);
+    }
+
+    bool clear()
+    {
+        return !state || state->clear();
+    }
+};

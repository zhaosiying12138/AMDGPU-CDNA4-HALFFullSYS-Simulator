+#include "dev/amdgpu/host_gpu_generic_dispatch_route.hh"
+
+#include <algorithm>
+
+namespace gem5::hostgpu::generic_dispatch_route
+{
+
+protocol::Status
+sessionStatus(const protocol::Header &header,
+              const protocol::Capabilities &selected,
+              const protocol::Uuid &daemonUuid,
+              uint64_t connectionId, uint64_t jobEpoch)
+{
+    if (header.daemonUuid != daemonUuid)
+        return protocol::Status::InstanceMismatch;
+    if (header.connectionId != connectionId)
+        return protocol::Status::ProtocolState;
+    if (header.jobEpoch != jobEpoch)
+        return protocol::Status::TopologyMismatch;
+    if (!protocol::genericDispatchCapabilitySelected(selected))
+        return protocol::Status::UnsupportedCapability;
+    return protocol::Status::Ok;
+}
+
+bool
+pageSizeSupported(uint32_t pageBytes)
+{
+    return pageBytes == protocol::GenericDispatchPageSize4K ||
+        pageBytes == protocol::GenericDispatchPageSize64K;
+}
+
+protocol::Status
+stageStatus(const protocol::GenericDispatchRequest &request)
+{
+    switch (request.opcode) {
+      case protocol::GenericDispatchOpcode::MapObject:
+        return pageSizeSupported(request.map.pageSize) ?
+            protocol::Status::Ok : protocol::Status::UnsupportedCapability;
+      case protocol::GenericDispatchOpcode::AllocKernarg:
+        /* The native response exposes backing alignment, so accepting the
+         * runtime's usual logical alignment (8) would produce a protocol
+         * mismatch after allocation. */
+        return request.allocKernarg.alignmentBytes ==
+                    protocol::GenericDispatchPageSize4K ||
+                request.allocKernarg.alignmentBytes ==
+                    protocol::GenericDispatchPageSize64K ?
+            protocol::Status::Ok : protocol::Status::UnsupportedCapability;
+      case protocol::GenericDispatchOpcode::SubmitAql:
+        return protocol::Status::UnsupportedCapability;
+      case protocol::GenericDispatchOpcode::UnmapObject:
+        return protocol::Status::Ok;
+    }
+    return protocol::Status::Malformed;
+}
+
+} // namespace gem5::hostgpu::generic_dispatch_route

+#ifndef __DEV_AMDGPU_HOST_GPU_GENERIC_DISPATCH_ROUTE_HH__
+#define __DEV_AMDGPU_HOST_GPU_GENERIC_DISPATCH_ROUTE_HH__
+
+#include "dev/amdgpu/host_gpu_protocol.hh"
+
+namespace gem5::hostgpu::generic_dispatch_route
+{
+
+/**
+ * Validate the immutable session tuple before a type-18 operation can touch
+ * native state.  Capability byte 1 bit 0 is intentionally supplied by the
+ * negotiated client rather than by the daemon identity; the bridge currently
+ * leaves that identity bit clear in production.
+ */
+protocol::Status
+sessionStatus(const protocol::Header &header,
+              const protocol::Capabilities &selected,
+              const protocol::Uuid &daemonUuid,
+              uint64_t connectionId, uint64_t jobEpoch);
+
+/** Return whether the native memory context can honor the requested page size. */
+bool
+pageSizeSupported(uint32_t pageBytes);
+
+/**
+ * Apply stage-level fail-closed gates that do not depend on mutable state.
+ * ALLOC is only honest for page-backed ABI alignments, and SUBMIT is withheld
+ * until queue/signal/tick contracts are implemented end to end.
+ */
+protocol::Status
+stageStatus(const protocol::GenericDispatchRequest &request);
+
+} // namespace gem5::hostgpu::generic_dispatch_route
+
+#endif // __DEV_AMDGPU_HOST_GPU_GENERIC_DISPATCH_ROUTE_HH__

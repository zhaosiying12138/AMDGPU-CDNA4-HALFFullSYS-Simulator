+void
+HostGPUBridge::processGenericDispatchRecord(const PendingRecord &record)
+{
+    auto found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &client = *found->second;
+    const auto decoded = protocol::decodeGenericDispatchRequestRecord(
+        record.bytes.data(), record.bytes.size(), maximumRecord);
+    if (decoded.action == protocol::DecodeAction::Drop) {
+        if (decoded.closeConnection)
+            closeClient(record.clientFd);
+        return;
+    }
+
+    /* A manually injected type-18 request must receive a canonical negative
+     * ACK; capability absence is not a framing error and must not mutate a
+     * per-client native session. */
+    const protocol::Status sessionStatus =
+        generic_dispatch_route::sessionStatus(
+            decoded.header, client.selectedCapabilities,
+            identity.daemonUuid, client.connectionId, identity.jobEpoch);
+    protocol::Status status = queueRequestStatus(
+        decoded.status, sessionStatus);
+    if (status == protocol::Status::Ok &&
+        client.requestIds.observe(decoded.header.requestId) !=
+            RequestIdResult::Fresh) {
+        status = protocol::Status::ProtocolState;
+    }
+
+    protocol::GenericDispatchResponse response;
+    response.status = status;
+    response.opcode = decoded.request.opcode;
+    bool routeSuccess = false;
+    if (status == protocol::Status::Ok) {
+        const HostGPUMemoryState::Owner owner{
+            record.clientFd, record.generation};
+        switch (decoded.request.opcode) {
+          case protocol::GenericDispatchOpcode::MapObject: {
+            if (generic_dispatch_route::stageStatus(decoded.request) !=
+                protocol::Status::Ok) {
+                response.status = generic_dispatch_route::stageStatus(
+                    decoded.request);
+                break;
+            }
+            if (client.genericDispatch && client.genericDispatch->context &&
+                client.genericDispatch->context->pageBytes() !=
+                    decoded.request.map.pageSize) {
+                /* The first MAP fixes this owner's native page policy. */
+                response.status = protocol::Status::UnsupportedCapability;
+                break;
+            }
+            const HostGPUCodeObjectState::Owner objectOwner{
+                owner.fd, owner.clientGeneration};
+            std::vector<uint8_t> image;
+            const auto manifest = codeObjectState.committedManifest(
+                objectOwner, decoded.request.objectId,
+                decoded.request.objectGeneration);
+            if (!manifest || !codeObjectState.readCommittedImage(
+                    objectOwner, decoded.request.objectId,
+                    decoded.request.objectGeneration, image)) {
+                response.status = protocol::Status::ProtocolState;
+                break;
+            }
+
+            const bool createdSession = !client.genericDispatch;
+            if (createdSession) {
+                try {
+                    client.genericDispatch =
+                        std::make_unique<GenericDispatchSession>(
+                            memoryState, owner, decoded.request.map.pageSize);
+                } catch (const std::exception &) {
+                    response.status = protocol::Status::ResourceExhausted;
+                    break;
+                }
+            }
+            if (!client.genericDispatch->state) {
+                response.status = protocol::Status::Internal;
+                break;
+            }
+            routeSuccess = client.genericDispatch->state->map(
+                {owner, decoded.header.requestId}, decoded.request, image,
+                *manifest, response);
+            if (routeSuccess && response.status == protocol::Status::Ok) {
+                client.genericDispatch->mapRequest = decoded.request;
+                client.genericDispatch->mapResponse = response;
+                client.genericDispatch->mapped = true;
+            } else if (createdSession &&
+                       !client.genericDispatch->state->hasMapping() &&
+                       !client.genericDispatch->state->hasKernarg()) {
+                /* Failed first MAP must not pin a page policy or empty native
+                 * leases for a later retry. */
+                client.genericDispatch.reset();
+            }
+            break;
+          }
+          case protocol::GenericDispatchOpcode::AllocKernarg:
+            if (generic_dispatch_route::stageStatus(decoded.request) !=
+                protocol::Status::Ok) {
+                response.status = generic_dispatch_route::stageStatus(
+                    decoded.request);
+                break;
+            }
+            if (!client.genericDispatch ||
+                !client.genericDispatch->state ||
+                !client.genericDispatch->state->hasMapping()) {
+                response.status = protocol::Status::ProtocolState;
+                break;
+            }
+            routeSuccess = client.genericDispatch->state->allocateKernarg(
+                {owner, decoded.header.requestId}, decoded.request, response);
+            if (routeSuccess && response.status == protocol::Status::Ok) {
+                client.genericDispatch->allocRequest = decoded.request;
+                client.genericDispatch->allocResponse = response;
+                client.genericDispatch->allocated = true;
+                client.genericDispatch->kernargTombstone = false;
+            }
+            break;
+          case protocol::GenericDispatchOpcode::SubmitAql:
+            response.status = generic_dispatch_route::stageStatus(
+                decoded.request);
+            break;
+          case protocol::GenericDispatchOpcode::UnmapObject:
+            if (!client.genericDispatch ||
+                !client.genericDispatch->state ||
+                !client.genericDispatch->state->hasMapping()) {
+                response.status = protocol::Status::ProtocolState;
+                break;
+            }
+            routeSuccess = client.genericDispatch->state->unmap(
+                {owner, decoded.header.requestId}, decoded.request, response);
+            if (routeSuccess && response.status == protocol::Status::Ok) {
+                client.genericDispatch->kernargTombstone =
+                    client.genericDispatch->allocResponse.status ==
+                        protocol::Status::Ok &&
+                    client.genericDispatch->allocResponse.kernargAllocationId != 0 &&
+                    client.genericDispatch->allocResponse.kernargGeneration !=
+                        0;
+                client.genericDispatch->mapped = false;
+                client.genericDispatch->allocated = false;
+                client.genericDispatch->mapRequest = {};
+                client.genericDispatch->allocRequest = {};
+                client.genericDispatch->mapResponse = {};
+            }
+            break;
+        }
+    }
+
+    found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &currentClient = *found->second;
+    currentClient.state.finishEstablishedRecord();
+    const auto responseHeader = protocol::queueResponseHeader(
+        decoded.header, identity, currentClient.connectionId);
+    auto encoded = protocol::encodeGenericDispatchAck(
+        responseHeader, response, currentClient.selectedCapabilities);
+    if (encoded.empty()) {
+        /* Invalid opcodes cannot be represented in the canonical response;
+         * close after consuming the record rather than emit a malformed ACK.
+         */
+        encoded = protocol::encodeGenericDispatchAck(responseHeader, response);
+    }
+    if (encoded.empty()) {
+        closeClient(record.clientFd);
+        return;
+    }
+    sendGenericDispatchResponse(
+        record.clientFd, record.generation, std::move(encoded),
+        OutboundKind::GenericDispatchAck, response.status,
+        routeSuccess && response.status == protocol::Status::Ok);
+}

diff --git a/src/arch/amdgpu/vega/gpu_decoder.test.cc b/src/arch/amdgpu/vega/gpu_decoder.test.cc
index 8cb08dcab..70e85f52b 100644
--- a/src/arch/amdgpu/vega/gpu_decoder.test.cc
+++ b/src/arch/amdgpu/vega/gpu_decoder.test.cc
@@ -399,6 +399,40 @@ TEST(GpuDecoderTest, Gfx950PackB32F16FromLiveQwenKernel)
     EXPECT_EQ(inst->getOperandSize(2), 4);
 }
 
+/**
+ * SMEM SBASE addresses an aligned SGPR pair, so the architectural register
+ * index is SBASE * 2. execute() and the disassembler both scale it; the
+ * registered operand info must agree, otherwise dependency tracking and
+ * register reads observe the wrong physical registers.
+ *
+ * This word is taken from a live gfx950 attention kernel:
+ * s_load_dwordx2 s[20:21], s[16:17], 0x0 encodes SBASE=8, SDATA=20.
+ */
+TEST(GpuDecoderTest, Gfx950SmemBaseOperandUsesRegisterPairIndex)
+{
+    InstFormat words[2] = {};
+    words[0].imm_u32 = 0xc0060508;
+    words[1].imm_u32 = 0x00000000;
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "s_load_dwordx2");
+    EXPECT_EQ(inst->disassemble(), "s_load_dwordx2 s[20:21], s[16:17], 0x00");
+
+    inst->initOperandInfo();
+    ASSERT_EQ(inst->numSrcRegOperands(), 2);
+    ASSERT_GE(inst->srcOperands().size(), 1UL);
+
+    /* The address base is the first source operand and is 8 bytes wide. */
+    const auto &base = inst->srcOperands()[0];
+    EXPECT_EQ(base.sizeInDWords(), 2);
+    EXPECT_TRUE(base.isScalarReg());
+    EXPECT_EQ(base.rawRegisterIndex(), 16)
+        << "SBASE=8 must resolve to architectural s[16:17], not s[8:9]";
+}
+
 } // anonymous namespace

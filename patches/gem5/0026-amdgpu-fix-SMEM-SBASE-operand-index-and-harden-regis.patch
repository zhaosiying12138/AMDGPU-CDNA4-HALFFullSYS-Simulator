 {
+    /**
+     * A pool manager reports an unsatisfiable request by returning an
+     * invalid start index without writing the reserved size. Detect that
+     * here instead of starting a wave with a zero-length register region,
+     * which would only fail later as an out-of-range register index and
+     * hide the real cause.
+     */

@@ -529,7 +529,14 @@ namespace VegaISA
                 opNum++;
             }
 
-            reg = instData.SBASE;
+            /**
+             * SBASE addresses an aligned SGPR pair, so it has an implied
+             * LSB of 0. execute() and the disassembler both scale it by two;
+             * the operand info must use the same architectural index or
+             * dependency tracking and register reads observe the wrong
+             * physical registers.
+             */
+            reg = instData.SBASE << 1;
             srcOps.emplace_back(reg, getOperandSize(opNum), true,
                                   true, false, false);
             opNum++;

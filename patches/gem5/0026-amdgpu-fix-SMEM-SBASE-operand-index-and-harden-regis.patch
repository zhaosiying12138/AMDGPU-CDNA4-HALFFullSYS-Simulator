+std::string
+ComputeUnit::hostNativeAccessContext(GPUDynInstPtr gpuDynInst) const
+{
+    if (!gpuDynInst) {
+        return "cu=" + std::to_string(cu_id) + " inst=<none>";
+    }
+
+    std::string context = "cu=" + std::to_string(cu_id) +
+        " kernel=" + std::to_string(gpuDynInst->kern_id) +
+        " wg=" + std::to_string(gpuDynInst->wg_id) +
+        " simd=" + std::to_string(gpuDynInst->simdId) +
+        " wfSlot=" + std::to_string(gpuDynInst->wfSlotId) +
+        " wfDynId=" + std::to_string(gpuDynInst->wfDynId);
+
+    Wavefront *wf = gpuDynInst->wavefront();
+    if (wf) {
+        context += " pc=" + csprintf("%#x", wf->pc()) +
+            " dispatch=" + std::to_string(wf->dispatchId);
+
+        HSAQueueEntry *task =
+            shader->dispatcher().findHsaTask(wf->dispatchId);
+        if (task) {
+            context += " name='" + task->kernelName() + "'" +
+                " codeVa=" + csprintf("%#x", task->codeAddr()) +
+                " kernargVa=" + csprintf("%#x", task->kernargAddr()) +
+                " ldsBytes=" + std::to_string(task->ldsSize()) +
+                " preloadDwords=" + std::to_string(task->preloadLength());
+
+            /*
+             * Distinguish a zeroed argument buffer from a misread scalar
+             * register: show the first kernarg dwords the wave could have
+             * loaded. This reads only the generic argument segment.
+             */
+            GPUNativeMemory *native = shader->nativeMemory();
+            if (native && task->kernargAddr()) {
+                std::array<uint32_t, 8> head = {};
+                if (native->read(task->kernargAddr(), head.data(),
+                                 sizeof(head), gpuDynInst->kern_id)) {
+                    context += " kernargHead=[";
+                    for (size_t i = 0; i < head.size(); ++i) {
+                        context += (i ? "," : "") + csprintf("%#x", head[i]);
+                    }
+                    context += "]";
+                }
+            }
+        }
+
+        /* Report the scalar registers this instruction actually sourced. */
+        std::string srcRegs;
+        for (const auto &srcOp : gpuDynInst->srcScalarRegOperands()) {
+            for (const auto &physIdx : srcOp.physIndices()) {
+                srcRegs += (srcRegs.empty() ? "" : ",") +
+                    csprintf("s%d=%#x", physIdx,
+                             srf[gpuDynInst->simdId]->read(physIdx));
+            }
+        }
+        if (!srcRegs.empty()) {
+            context += " srcScalar=[" + srcRegs + "]";
+        }
+    }
+
+    context += " inst='" + gpuDynInst->disassemble() + "'";
+    return context;
+}

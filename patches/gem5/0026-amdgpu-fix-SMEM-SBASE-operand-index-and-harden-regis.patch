+             "already reserved %d of %d); admission accepted a workgroup the "
+             "register file cannot hold\n",
+             w->simdId, vectorDemand, w->wfSlotId, allocatedSize,
+             cu->vectorRegsReserved[w->simdId], cu->numVecRegsPerSimd);
     w->reservedVectorRegs = allocatedSize;
     cu->vectorRegsReserved[w->simdId] += w->reservedVectorRegs;
     panic_if(cu->vectorRegsReserved[w->simdId] > cu->numVecRegsPerSimd,
@@ -123,8 +142,16 @@ StaticRegisterManagerPolicy::allocateRegisters(Wavefront *w, int vectorDemand,
              cu->numVecRegsPerSimd);
 

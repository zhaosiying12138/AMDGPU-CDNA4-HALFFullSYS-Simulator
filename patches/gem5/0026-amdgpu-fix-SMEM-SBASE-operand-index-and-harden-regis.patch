+    if (w->reservedScalarRegs) {
+        endIndex = w->startSgprIndex + w->reservedScalarRegs;
+        w->computeUnit->registerManager->srfPoolMgrs[w->simdId]->
+            freeRegion(w->startSgprIndex, endIndex);
+    }
 

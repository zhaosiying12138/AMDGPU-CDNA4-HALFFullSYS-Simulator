+        allocatedSize = 0;
         w->startSgprIndex = cu->registerManager->srfPoolMgrs[w->simdId]->
             allocateRegion(scalarDemand, &allocatedSize);
+        panic_if(w->startSgprIndex == InvalidRegionStart || !allocatedSize ||
+                 allocatedSize < static_cast<uint32_t>(scalarDemand),

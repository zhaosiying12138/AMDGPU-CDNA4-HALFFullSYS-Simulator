+                mqdAllocation->view.gpuVa, &mqd, sizeof(mqd), requestId)) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;
+        }
+        HostNativeQueueCore::FetchedPacket fetched;
+        if (!nativeQueue->fetch(fetched, nullptr, requestId)) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;
+        }
+        cpResult = std::make_unique<HostNativeCommandProcessorCore::Result>();
+        if (!state->submit(
+                {owner, requestId}, request, signalAllocation->view.gpuVa,
+                *nativeQueue, fetched, *cpResult, response)) {
+            if (nativeQueue->ownsPending(fetched))
+                nativeQueue->cancelFetch(fetched.ticket);
+            releasePrivateResources(now);
+            return false;
+        }
+        response.packetCrc32c = packetCrc;
+        response.simTick = now;
+        response.admissionTick = now;
+        nativeAdmitted = true;
+        return true;
+    }

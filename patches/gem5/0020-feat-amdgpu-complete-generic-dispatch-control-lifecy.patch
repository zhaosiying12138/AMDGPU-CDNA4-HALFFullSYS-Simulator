+TEST(HostGPUQueueState, GenericDispatchPinCancelsOrCommitsExternalSequence)
+{
+    HostGPUQueueState state;
+    const auto created = state.submit(owner(), header(), create(1), 0);
+    ASSERT_EQ(created.response.status, protocol::Status::Ok);
+    constexpr uint64_t FirstRequest = (uint64_t{1} << 40) + 1;
+    EXPECT_EQ(state.validatePinnedDispatch(
+                  owner(), created.response.queueId,
+                  created.response.generation, 1),
+              protocol::Status::Ok);
+    ASSERT_TRUE(state.pinPinnedDispatch(
+        owner(), created.response.queueId, created.response.generation, 1,
+        FirstRequest));
+    EXPECT_TRUE(state.pinnedDispatchOwned(
+        owner(), created.response.queueId, created.response.generation, 1,
+        FirstRequest));
+    EXPECT_EQ(state.validatePinnedDispatch(
+                  owner(), created.response.queueId,
+                  created.response.generation, 2),
+              protocol::Status::Busy);
+    ASSERT_TRUE(state.cancelPinnedDispatch(
+        owner(), created.response.queueId, created.response.generation, 1,
+        FirstRequest));
+    ASSERT_TRUE(state.pinPinnedDispatch(
+        owner(), created.response.queueId, created.response.generation, 1,
+        FirstRequest + 1));
+    ASSERT_TRUE(state.releasePinnedDispatch(
+        owner(), created.response.queueId, created.response.generation,
+        FirstRequest + 1));
+    EXPECT_EQ(state.validatePinnedDispatch(
+                  owner(), created.response.queueId,
+                  created.response.generation, 2),
+              protocol::Status::Ok);
+    EXPECT_EQ(state.validatePinnedDispatch(
+                  owner(8, 11), created.response.queueId,
+                  created.response.generation, 2),
+              protocol::Status::ProtocolState);
+}
+

+protocol::Status
+HostGPUSignalState::validateGenericDispatchSignalIdentity(
+    const Owner &owner, uint64_t signalId, uint64_t generation) const
+{
+    const Signal *signal = resolve(owner, signalId, generation);
+    if (signal == nullptr || signal->value != 1 || signal->wait)
+        return protocol::Status::ProtocolState;
+    return protocol::Status::Ok;
+}
+
+protocol::Status
+HostGPUSignalState::validateGenericDispatchSignal(
+    const Owner &owner, uint64_t signalId, uint64_t generation) const
+{
+    const auto status = validateGenericDispatchSignalIdentity(
+        owner, signalId, generation);
+    if (status != protocol::Status::Ok)
+        return status;
+    if (pinnedDispatchSignalBusy(owner, signalId, generation))
+        return protocol::Status::Busy;
+    return protocol::Status::Ok;
+}
+
+bool
+HostGPUSignalState::pinGenericDispatchSignal(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    uint64_t requestId)
+{
+    if (requestId == 0 ||
+        validateGenericDispatchSignal(owner, signalId, generation) !=
+            protocol::Status::Ok) {
+        return false;
+    }
+    signals[signalId - 1]->dispatchRequestId = requestId;
+    return true;
+}

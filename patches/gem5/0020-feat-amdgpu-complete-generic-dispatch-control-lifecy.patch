+    bool allocatePrivate(
+        std::optional<PrivateAllocation> &destination, uint64_t bytes,
+        uint64_t requestId, uint64_t now)
+    {
+        protocol::MemoryRequest request;
+        request.opcode = protocol::MemoryOpcode::Allocate;
+        request.byteCount = std::max<uint64_t>(bytes, context->pageBytes());
+        request.argument = context->pageBytes();
+        const auto allocated = memory.allocate(owner, request, now);
+        if (allocated.status != protocol::Status::Ok)
+            return false;
+        const auto view = memory.allocationView(
+            owner, allocated.allocationId, allocated.generation);
+        const auto lease = view ? context->map(view->gpuVa, view->size) :
+            std::nullopt;
+        if (!view || !lease || !memory.pinPinnedDispatchAllocation(
+                owner, view->allocationId, view->generation, requestId)) {
+            if (lease)
+                context->unmap(*lease);
+            protocol::MemoryRequest release;
+            release.opcode = protocol::MemoryOpcode::Free;
+            release.allocationId = allocated.allocationId;
+            release.generation = allocated.generation;
+            memory.free(owner, release, now);
+            return false;
+        }
+        destination.emplace(PrivateAllocation{*view, *lease});
+        return true;
+    }
+
+    bool releasePrivate(
+        std::optional<PrivateAllocation> &allocation, uint64_t requestId,
+        uint64_t now)
+    {
+        if (!allocation)
+            return true;
+        const auto value = *allocation;
+        if (!memory.releasePinnedDispatchAllocation(
+                owner, value.view.allocationId, value.view.generation,
+                requestId)) {
+            return false;
+        }
+        if (!context->unmap(value.lease))
+            return false;
+        protocol::MemoryRequest release;
+        release.opcode = protocol::MemoryOpcode::Free;
+        release.allocationId = value.view.allocationId;
+        release.generation = value.view.generation;
+        if (memory.free(owner, release, now).status != protocol::Status::Ok)
+            return false;
+        allocation.reset();
+        return true;
+    }
+
+    bool releasePrivateResources(uint64_t now)
+    {
+        bool ok = true;
+        cpResult.reset();
+        if (nativeQueue && nativeQueue->isRegistered() &&
+            !nativeQueue->unregisterQueue()) {
+            /* Pre-admission failures can leave a published but unaccepted
+             * private slot.  No external queue observes this object. */
+            nativeQueue->abandonQueue();
+        }
+        nativeQueue.reset();
+        if (privateRequestId != 0) {
+            ok = releasePrivate(mqdAllocation, privateRequestId, now) && ok;
+            ok = releasePrivate(signalAllocation, privateRequestId, now) && ok;
+            ok = releasePrivate(packetAllocation, privateRequestId, now) && ok;
+        } else if (mqdAllocation || signalAllocation || packetAllocation) {
+            ok = false;
+        }
+        if (!mqdAllocation && !signalAllocation && !packetAllocation)
+            privateRequestId = 0;
+        return ok;
+    }

+TEST(HostGPUSignalState, GenericDispatchPinsValueOneWithoutLegacyWait)
+{
+    HostGPUSignalState state;
+    const auto created = state.submit(owner(), header(), create(1), 0);
+    ASSERT_EQ(created.status, protocol::Status::Ok);
+    EXPECT_EQ(state.validateGenericDispatchSignal(
+                  owner(), created.signalId, created.generation),
+              protocol::Status::Ok);
+    EXPECT_EQ(state.validatePinnedDispatchSignal(
+                  owner(), created.signalId, created.generation, 1),
+              protocol::Status::ProtocolState);
+    constexpr uint64_t RequestId = (uint64_t{1} << 40) + 9;
+    ASSERT_TRUE(state.pinGenericDispatchSignal(
+        owner(), created.signalId, created.generation, RequestId));
+    EXPECT_TRUE(state.pinnedDispatchSignalOwned(
+        owner(), created.signalId, created.generation, RequestId));
+    EXPECT_EQ(state.validateGenericDispatchSignal(
+                  owner(), created.signalId, created.generation),
+              protocol::Status::Busy);
+    EXPECT_EQ(state.validateGenericDispatchSignal(
+                  owner(8, 11), created.signalId, created.generation),
+              protocol::Status::ProtocolState);
+    EXPECT_EQ(state.submit(owner(), header(2),
+                           operation(created, protocol::SignalOpcode::Destroy),
+                           1).status,
+              protocol::Status::Busy);
+    ASSERT_TRUE(state.releasePinnedDispatchSignal(
+        owner(), created.signalId, created.generation, RequestId));
+    EXPECT_EQ(state.value(owner(), created.signalId, created.generation), 1);
+
+    const auto zero = state.submit(owner(), header(3), create(0), 1);
+    EXPECT_EQ(state.validateGenericDispatchSignal(
+                  owner(), zero.signalId, zero.generation),
+              protocol::Status::ProtocolState);
+    auto waiting = waitFor(
+        created, 1, protocol::SignalCondition::Equal, 0);
+    ASSERT_EQ(state.submit(owner(), header(4), waiting, 2).status,
+              protocol::Status::Ok);
+    EXPECT_EQ(state.validateGenericDispatchSignal(
+                  owner(), created.signalId, created.generation),
+              protocol::Status::ProtocolState);
+}

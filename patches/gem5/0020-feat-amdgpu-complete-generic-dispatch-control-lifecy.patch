+            !allocatePrivate(
+                mqdAllocation, sizeof(_amd_queue_t), requestId, now)) {
+            response.status = protocol::Status::ResourceExhausted;
+            releasePrivateResources(now);
+            return false;
+        }
+
+        const uint64_t signalValue = 1;
+        if (!context->functionalWrite(
+                signalAllocation->view.gpuVa, &signalValue,
+                sizeof(signalValue), requestId)) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;
+        }
+
+        _amd_queue_t mqd = {};
+        mqd.hsa_queue.type = _HSA_QUEUE_TYPE_MULTI;
+        mqd.hsa_queue.base_address = reinterpret_cast<void *>(
+            packetAllocation->view.gpuVa);
+        mqd.hsa_queue.size =
+            GenericNativeQueueBytes / HostNativeQueueCore::PacketBytes;
+        mqd.hsa_queue.id = GenericNativeQueueId;
+        mqd.read_dispatch_id_field_base_byte_offset =
+            offsetof(_amd_queue_t, read_dispatch_id);
+        if (!context->functionalWrite(
+                mqdAllocation->view.gpuVa, &mqd, sizeof(mqd), requestId)) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;
+        }
+
+        nativeQueue = std::make_unique<HostNativeQueueCore>(*context);
+        HostNativeQueueCore::Config config;
+        config.baseVa = packetAllocation->view.gpuVa;
+        config.hostReadIndexVa = mqdAllocation->view.gpuVa +
+            offsetof(_amd_queue_t, read_dispatch_id);
+        config.activeQueueId = GenericNativeQueueId;
+        config.generation = owner.clientGeneration;
+        config.registeredIndex = 0;
+        config.queueBytes = GenericNativeQueueBytes;
+        config.doorbellBytes = GenericNativeDoorbellBytes;
+        if (!nativeQueue->registerQueue(config, requestId)) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;
+        }
+
+        _hsa_dispatch_packet_t packet = {};
+        packet.header = GenericDispatchHeader;
+        packet.setup = 1;
+        packet.workgroup_size_x = request.submit.workgroupX;
+        packet.workgroup_size_y = request.submit.workgroupY;
+        packet.workgroup_size_z = request.submit.workgroupZ;
+        packet.grid_size_x = request.submit.gridX;
+        packet.grid_size_y = request.submit.gridY;
+        packet.grid_size_z = request.submit.gridZ;
+        packet.private_segment_size = manifest.privateSegmentFixedSize;
+        packet.group_segment_size = manifest.groupSegmentFixedSize;
+        packet.kernel_object = mapResponse.descriptorVa;
+        packet.kernarg_address = allocResponse.kernargVa +
+            request.submit.kernargOffset;
+        packet.completion_signal = signalAllocation->view.gpuVa;
+        std::array<uint8_t, HostNativeQueueCore::PacketBytes> packetBytes = {};
+        std::memcpy(packetBytes.data(), &packet, packetBytes.size());
+        const uint32_t packetCrc = protocol::crc32c(
+            packetBytes.data(), packetBytes.size());
+        if (!nativeQueue->publish(
+                packetAllocation->view.gpuVa, packetBytes.data(),
+                packetBytes.size(), requestId)) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;
+        }
+        uint32_t registeredIndex = 0;
+        if (!nativeQueue->ring(1, registeredIndex) || registeredIndex != 0) {
+            response.status = protocol::Status::Internal;
+            releasePrivateResources(now);
+            return false;

+void
+HostGPUBridge::processGenericDispatchCompletion(int fd, uint64_t generation)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation ||
+        !found->second->genericDispatch) {
+        return;
+    }
+    GenericDispatchSession &session = *found->second->genericDispatch;
+    if (!session.ackSent || session.completionQueued ||
+        !session.nativeAdmitted || !session.state ||
+        !session.nativeQueue || !session.state->hasSubmission() ||
+        session.submitRequestId == 0 || curTick() == 0 ||
+        curTick() < session.submitResponse.admissionTick) {
+        closeClient(fd);
+        return;
+    }
+    if (!session.state->retire(
+            {session.owner, session.submitRequestId}, session.submitRequest,
+            *session.nativeQueue)) {
+        closeClient(fd);
+        return;

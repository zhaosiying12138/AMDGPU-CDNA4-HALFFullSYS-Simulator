+namespace
+{
+
+std::vector<uint8_t>
+encodeSignalResponse(MessageType type, const Header &request,
+                     const SignalResponse &response, uint16_t opcode)
+{
+    std::vector<uint8_t> payload(SignalPayloadBytes, 0);
+    store16(payload, 0, SignalEventMajor);
+    store16(payload, 2, SignalEventMinor);
+    store32(payload, 4, static_cast<uint32_t>(response.status));
+    store16(payload, 8, opcode);
+    store64(payload, 16, response.signalId);
+    store64(payload, 24, response.generation);
+    store64(payload, 32, response.sequence);
+    if (response.status == Status::Ok) {
+        storeSigned64(payload, 40, response.value);
+        store64(payload, 48, response.ready);
+        store64(payload, 56, response.simTick);
+    }
+    Header encoded = request;
+    encoded.messageType = type;
+    return encodeFrame(encoded, payload);
+}
+
+} // anonymous namespace
+
+std::vector<uint8_t>
+encodeSignalAck(const Header &request, const SignalResponse &response)
+{
+    const uint16_t opcode = static_cast<uint16_t>(response.opcode);
+    assert(validSignalOpcode(opcode));
+    return encodeSignalResponse(
+        MessageType::SignalAck, request, response, opcode);
+}
+
+std::vector<uint8_t>
+encodeSignalFailureAck(const Header &request,
+                       const SignalResponse &response,
+                       uint16_t requestOpcode)
+{
+    assert(response.status != Status::Ok);
+    return encodeSignalResponse(
+        MessageType::SignalAck, request, response, requestOpcode);
+}
+
+std::vector<uint8_t>
+encodeSignalCompletion(const Header &request,
+                       const SignalResponse &response)
+{
+    const uint16_t opcode = static_cast<uint16_t>(response.opcode);
+    assert(response.status == Status::Ok && validSignalOpcode(opcode));
+    return encodeSignalResponse(
+        MessageType::SignalCompletion, request, response, opcode);
+}

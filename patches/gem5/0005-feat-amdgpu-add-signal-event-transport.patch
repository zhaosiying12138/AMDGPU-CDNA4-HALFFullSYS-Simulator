+
+HostGPUSignalState::Owner
+owner(int fd = 7, uint64_t generation = 11)
+{
+    return {fd, generation};
+}
+
+protocol::Header
+header(uint64_t requestId = 1)
+{
+    protocol::Header value;
+    value.requestId = requestId;
+    value.connectionId = 17;
+    value.jobEpoch = 19;
+    value.daemonUuid[0] = 1;
+    return value;
+}
+
+protocol::SignalRequest
+create(int64_t initialValue)
+{
+    protocol::SignalRequest request;
+    request.opcode = protocol::SignalOpcode::Create;
+    request.value = initialValue;
+    return request;
+}
+
+protocol::SignalRequest
+operation(const protocol::SignalResponse &created,
+          protocol::SignalOpcode opcode)
+{
+    protocol::SignalRequest request;
+    request.opcode = opcode;
+    request.signalId = created.signalId;
+    request.generation = created.generation;
+    return request;
+}
+
+protocol::SignalRequest
+waitFor(const protocol::SignalResponse &created, uint64_t sequence,
+        protocol::SignalCondition condition, int64_t compareValue)
+{
+    auto request = operation(created, protocol::SignalOpcode::Wait);
+    request.sequence = sequence;
+    request.condition = condition;
+    request.value = compareValue;
+    return request;
+}
+
+TEST(HostGPUSignalState, CreatesLoadsStoresAndDestroysSignedSignal)
+{
+    HostGPUSignalState state;
+    const auto created = state.submit(owner(), header(), create(-7), 10);
+    EXPECT_EQ(created.status, protocol::Status::Ok);
+    EXPECT_EQ(created.signalId, 1U);
+    EXPECT_NE(created.generation, 0U);
+    EXPECT_EQ(created.value, -7);
+    EXPECT_EQ(created.simTick, 10U);
+    EXPECT_EQ(state.signalCount(), 1U);
+
+    const auto loaded = state.submit(
+        owner(), header(2), operation(created, protocol::SignalOpcode::Load),
+        11);
+    EXPECT_EQ(loaded.status, protocol::Status::Ok);
+    EXPECT_EQ(loaded.value, -7);
+
+    auto store = operation(created, protocol::SignalOpcode::Store);
+    store.value = std::numeric_limits<int64_t>::min();
+    const auto stored = state.submit(owner(), header(3), store, 12);
+    EXPECT_EQ(stored.status, protocol::Status::Ok);
+    EXPECT_EQ(stored.value, std::numeric_limits<int64_t>::min());
+
+    const auto destroyed = state.submit(
+        owner(), header(4),
+        operation(created, protocol::SignalOpcode::Destroy), 13);
+    EXPECT_EQ(destroyed.status, protocol::Status::Ok);
+    EXPECT_EQ(destroyed.value, 0);
+    EXPECT_EQ(state.signalCount(), 0U);
+}
+
+TEST(HostGPUSignalState, ConditionsUseSignedHsaComparisons)
+{
+    using Condition = protocol::SignalCondition;
+    EXPECT_TRUE(HostGPUSignalState::conditionSatisfied(-3, Condition::Equal,
+                                                       -3));
+    EXPECT_TRUE(HostGPUSignalState::conditionSatisfied(-3,
+                    Condition::NotEqual, 2));
+    EXPECT_TRUE(HostGPUSignalState::conditionSatisfied(
+        std::numeric_limits<int64_t>::min(), Condition::LessThan, 0));
+    EXPECT_TRUE(HostGPUSignalState::conditionSatisfied(
+        std::numeric_limits<int64_t>::max(),
+        Condition::GreaterThanOrEqual, -1));
+    EXPECT_FALSE(HostGPUSignalState::conditionSatisfied(
+        -1, Condition::GreaterThanOrEqual, 0));
+}
+
+TEST(HostGPUSignalState, BridgeFailurePreservesUnknownOpcodeBits)
+{
+    constexpr uint16_t UnknownOpcode = 0xbeef;
+    protocol::SignalRequest request;
+    request.opcode = static_cast<protocol::SignalOpcode>(UnknownOpcode);
+    request.signalId = 7;
+    request.generation = 8;
+    request.sequence = 9;
+    request.value = -1;
+    const auto response = HostGPUSignalState::failureResponse(
+        request, protocol::Status::Malformed);
+
+    EXPECT_EQ(response.status, protocol::Status::Malformed);
+    EXPECT_EQ(static_cast<uint16_t>(response.opcode), UnknownOpcode);
+    EXPECT_EQ(response.signalId, request.signalId);
+    EXPECT_EQ(response.generation, request.generation);
+    EXPECT_EQ(response.sequence, request.sequence);
+    EXPECT_EQ(response.value, 0);
+    EXPECT_EQ(response.ready, 0U);
+    EXPECT_EQ(response.simTick, 0U);
+}
+
+TEST(HostGPUSignalState, ImmediateWaitCompletesOneTickLaterAndOnSend)
+{
+    HostGPUSignalState state;
+    const auto created = state.submit(owner(), header(), create(-7), 0);
+    const auto request = waitFor(
+        created, 1, protocol::SignalCondition::LessThan, 0);
+    const auto accepted = state.submit(owner(), header(2), request, 20);
+    EXPECT_EQ(accepted.status, protocol::Status::Ok);
+    EXPECT_EQ(accepted.value, -7);
+    EXPECT_EQ(accepted.ready, 1U);
+    EXPECT_EQ(accepted.simTick, 20U);
+    EXPECT_EQ(state.waitCount(), 1U);
+    ASSERT_TRUE(state.nextReadyTick());
+    EXPECT_EQ(*state.nextReadyTick(), 21U);
+    EXPECT_FALSE(state.popReady(20));
+
+    const auto completion = state.popReady(21);
+    ASSERT_TRUE(completion);
+    EXPECT_EQ(completion->header.requestId, 2U);
+    EXPECT_EQ(completion->signalId, created.signalId);
+    EXPECT_EQ(completion->signalGeneration, created.generation);
+    EXPECT_EQ(completion->sequence, 1U);
+    EXPECT_EQ(completion->value, -7);
+    EXPECT_EQ(completion->readyTick, 21U);
+    EXPECT_TRUE(state.callbackPending(*completion));
+    EXPECT_EQ(state.waitCount(), 1U);
+    EXPECT_FALSE(state.nextReadyTick());
+    EXPECT_FALSE(state.popReady(21));
+
+    EXPECT_EQ(state.submit(owner(), header(3),
+                           operation(created,
+                                     protocol::SignalOpcode::Destroy), 21)
+                  .status,
+              protocol::Status::Busy);
+    EXPECT_TRUE(state.complete(*completion));
+    EXPECT_FALSE(state.callbackPending(*completion));
+    EXPECT_EQ(state.waitCount(), 0U);
+}
+
+TEST(HostGPUSignalState, ArmedWaitCapturesFirstSatisfyingStoreExactlyOnce)
+{
+    HostGPUSignalState state;
+    const auto created = state.submit(owner(), header(), create(-7), 0);
+    const auto waiting = waitFor(
+        created, 1, protocol::SignalCondition::GreaterThanOrEqual, 0);
+    const auto accepted = state.submit(owner(), header(2), waiting, 10);
+    EXPECT_EQ(accepted.status, protocol::Status::Ok);
+    EXPECT_EQ(accepted.value, -7);
+    EXPECT_EQ(accepted.ready, 0U);
+    EXPECT_FALSE(state.nextReadyTick());
+
+    auto store = operation(created, protocol::SignalOpcode::Store);
+    store.value = -1;
+    EXPECT_EQ(state.submit(owner(), header(3), store, 20).status,
+              protocol::Status::Ok);
+    EXPECT_FALSE(state.nextReadyTick());
+
+    store.value = 42;
+    EXPECT_EQ(state.submit(owner(), header(4), store, 30).status,
+              protocol::Status::Ok);
+    ASSERT_TRUE(state.nextReadyTick());
+    EXPECT_EQ(*state.nextReadyTick(), 31U);
+
+    store.value = 99;
+    EXPECT_EQ(state.submit(owner(), header(5), store, 30).status,
+              protocol::Status::Ok);
+    const auto completion = state.popReady(31);
+    ASSERT_TRUE(completion);
+    EXPECT_EQ(completion->value, 42);
+    EXPECT_EQ(completion->readyTick, 31U);
+
+    auto repeated = waitFor(
+        created, 1, protocol::SignalCondition::Equal, 99);
+    EXPECT_EQ(state.submit(owner(), header(6), repeated, 31).status,
+              protocol::Status::ProtocolState);
+    repeated.sequence = 2;
+    EXPECT_EQ(state.submit(owner(), header(7), repeated, 31).status,
+              protocol::Status::Busy);
+    EXPECT_TRUE(state.complete(*completion));
+    EXPECT_EQ(state.submit(owner(), header(8), repeated, 31).status,
+              protocol::Status::Ok);
+}
+
+TEST(HostGPUSignalState, PendingAndQueuedWaitsShareGlobalEightLimit)
+{
+    HostGPUSignalState state;
+    std::vector<protocol::SignalResponse> created;
+    for (size_t index = 0;
+         index <= HostGPUSignalState::MaximumWaits; ++index) {
+        created.push_back(state.submit(
+            owner(), header(index + 1), create(0), index));
+        ASSERT_EQ(created.back().status, protocol::Status::Ok);
+    }
+    for (size_t index = 0; index < HostGPUSignalState::MaximumWaits; ++index) {
+        EXPECT_EQ(state.submit(
+                      owner(), header(20 + index),
+                      waitFor(created[index], 1,
+                              protocol::SignalCondition::Equal, -1), 10)
+                      .status,
+                  protocol::Status::Ok);
+    }
+    EXPECT_EQ(state.waitCount(), HostGPUSignalState::MaximumWaits);
+    auto ninthWait = waitFor(
+        created.back(), 1, protocol::SignalCondition::Equal, -1);
+    EXPECT_EQ(state.submit(owner(), header(40), ninthWait, 10).status,
+              protocol::Status::ResourceExhausted);
+
+    for (size_t index = 0; index < HostGPUSignalState::MaximumWaits; ++index) {
+        auto store = operation(created[index], protocol::SignalOpcode::Store);
+        store.value = -1;
+        ASSERT_EQ(state.submit(owner(), header(50 + index), store, 20).status,
+                  protocol::Status::Ok);
+    }
+    std::vector<HostGPUSignalState::Completion> queued;
+    for (size_t index = 0; index < HostGPUSignalState::MaximumWaits; ++index) {
+        auto completion = state.popReady(21);
+        ASSERT_TRUE(completion);
+        queued.push_back(*completion);
+    }
+    EXPECT_EQ(state.waitCount(), HostGPUSignalState::MaximumWaits);
+    EXPECT_EQ(state.submit(owner(), header(70), ninthWait, 21).status,
+              protocol::Status::ResourceExhausted);
+
+    ASSERT_TRUE(state.complete(queued.front()));
+    EXPECT_EQ(state.waitCount(), HostGPUSignalState::MaximumWaits - 1);
+    EXPECT_EQ(state.submit(owner(), header(71), ninthWait, 21).status,
+              protocol::Status::Ok);
+}
+
+TEST(HostGPUSignalState, CombinedCompletionBacklogFitsBridgeHardCap)
+{
+    HostGPUQueueState queues;
+    const HostGPUQueueState::Owner queueOwner{7, 11};
+    protocol::QueueRequest createQueue;
+    createQueue.opcode = protocol::QueueOpcode::Create;
+    createQueue.arg0 = 64;
+    const auto queue = queues.submit(queueOwner, header(), createQueue, 0);
+    ASSERT_EQ(queue.response.status, protocol::Status::Ok);
+
+    auto doorbell = [&](uint64_t sequence, uint64_t requestId, uint64_t now) {
+        protocol::QueueRequest request;
+        request.opcode = protocol::QueueOpcode::Doorbell;
+        request.queueId = queue.response.queueId;
+        request.generation = queue.response.generation;
+        request.sequence = sequence;
+        return queues.submit(queueOwner, header(requestId), request, now);
+    };
+    for (size_t index = 0; index < HostGPUQueueState::MaximumInflight;
+         ++index) {
+        ASSERT_EQ(doorbell(index + 1, index + 2, 0).response.status,
+                  protocol::Status::Ok);
+    }
+    size_t queuedQueueCompletions = 0;
+    while (queues.popReady(1))
+        ++queuedQueueCompletions;
+    ASSERT_EQ(queuedQueueCompletions,
+              HostGPUQueueState::MaximumInflight);
+    for (size_t index = 0; index < HostGPUQueueState::MaximumInflight;
+         ++index) {
+        ASSERT_EQ(doorbell(index + 9, index + 20, 1).response.status,
+                  protocol::Status::Ok);
+    }
+    while (queues.popReady(2))
+        ++queuedQueueCompletions;
+    ASSERT_EQ(queuedQueueCompletions,
+              HostGPUQueueState::MaximumInflight * 2);
+
+    const size_t allAsyncBacklog = queuedQueueCompletions +
+        HostGPUSignalState::MaximumWaits;
+    EXPECT_EQ(allAsyncBacklog, 24U);
+    constexpr size_t maximumOutboundRecords =
+        HostGPUQueueState::MaximumInflight * 2 +
+        HostGPUSignalState::MaximumWaits + 1;
+    const auto canEnqueue = [=](size_t current) {
+        return current < maximumOutboundRecords;
+    };
+    EXPECT_TRUE(canEnqueue(allAsyncBacklog));
+    EXPECT_EQ(maximumOutboundRecords, 25U);
+    EXPECT_FALSE(canEnqueue(maximumOutboundRecords));
+}

+TEST(HostGPUSignalState, TickOverflowNeverMutatesWaitOrSatisfyingStore)
+{
+    HostGPUSignalState state;
+    const auto created = state.submit(owner(), header(), create(0), 0);
+    auto waiting = waitFor(
+        created, 1, protocol::SignalCondition::Equal, 1);
+    const uint64_t maximum = std::numeric_limits<uint64_t>::max();
+    EXPECT_EQ(state.submit(owner(), header(2), waiting, maximum).status,
+              protocol::Status::Internal);
+    EXPECT_EQ(state.waitCount(), 0U);
+    EXPECT_EQ(state.submit(owner(), header(3), waiting, maximum - 1).status,
+              protocol::Status::Ok);
+
+    auto store = operation(created, protocol::SignalOpcode::Store);
+    store.value = 1;
+    EXPECT_EQ(state.submit(owner(), header(4), store, maximum).status,
+              protocol::Status::Internal);
+    auto load = operation(created, protocol::SignalOpcode::Load);
+    EXPECT_EQ(state.submit(owner(), header(5), load, maximum).value, 0);
+
+    store.value = 2;
+    EXPECT_EQ(state.submit(owner(), header(6), store, maximum).status,
+              protocol::Status::Ok);
+    EXPECT_EQ(state.submit(owner(), header(7), load, maximum).value, 2);
+    EXPECT_FALSE(state.nextReadyTick());
+}

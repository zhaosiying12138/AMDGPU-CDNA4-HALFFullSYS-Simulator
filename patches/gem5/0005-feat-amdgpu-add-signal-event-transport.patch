+    constexpr uint16_t UnknownOpcode = 0xbeef;
+    auto requestFrame = fromHex(GoldenSignalWaitRequestHex);
+    store16(requestFrame, HeaderBytes + 4, UnknownOpcode);
+    recomputeCrc(requestFrame);
+    const auto decoded = decodeSignalRequestRecord(
+        requestFrame.data(), requestFrame.size(), MaximumRecordBytes);
+    ASSERT_EQ(decoded.action, DecodeAction::Acknowledge);
+    ASSERT_EQ(decoded.status, Status::Malformed);
+    EXPECT_EQ(static_cast<uint16_t>(decoded.request.opcode), UnknownOpcode);
+
+    SignalResponse response;
+    response.status = decoded.status;
+    response.opcode = decoded.request.opcode;
+    response.signalId = decoded.request.signalId;
+    response.generation = decoded.request.generation;
+    response.sequence = decoded.request.sequence;
+    response.value = -1;
+    response.ready = 1;
+    response.simTick = 1;
+    const auto responseHeader = queueResponseHeader(
+        decoded.header, goldenServer(), decoded.header.connectionId);
+    const auto ack = encodeSignalFailureAck(
+        responseHeader, response,
+        static_cast<uint16_t>(decoded.request.opcode));
+
+    ASSERT_EQ(ack.size(), HeaderBytes + SignalPayloadBytes);
+    EXPECT_EQ(load16(ack.data() + 14),
+              static_cast<uint16_t>(MessageType::SignalAck));
+    const uint8_t *payload = ack.data() + HeaderBytes;
+    EXPECT_EQ(load32(payload + 4), static_cast<uint32_t>(Status::Malformed));
+    EXPECT_EQ(load16(payload + 8), UnknownOpcode);
+    EXPECT_EQ(load64(payload + 16), decoded.request.signalId);
+    EXPECT_EQ(load64(payload + 24), decoded.request.generation);
+    EXPECT_EQ(load64(payload + 32), decoded.request.sequence);
+    EXPECT_EQ(load64(payload + 40), 0U);
+    EXPECT_EQ(load64(payload + 48), 0U);
+    EXPECT_EQ(load64(payload + 56), 0U);

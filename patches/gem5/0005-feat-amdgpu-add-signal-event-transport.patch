+TEST(HostGPUSignalState, ReusesLowestSlotWithNewDaemonLifetimeGeneration)
+{
+    HostGPUSignalState state;
+    const auto first = state.submit(owner(), header(), create(1), 0);
+    const auto second = state.submit(owner(), header(2), create(2), 0);
+    ASSERT_EQ(first.signalId, 1U);
+    ASSERT_EQ(second.signalId, 2U);
+    ASSERT_EQ(state.submit(owner(), header(3),
+                           operation(first,
+                                     protocol::SignalOpcode::Destroy), 1)
+                  .status,
+              protocol::Status::Ok);
+    const auto reused = state.submit(owner(), header(4), create(-9), 2);
+    EXPECT_EQ(reused.signalId, first.signalId);
+    EXPECT_NE(reused.generation, first.generation);
+    EXPECT_EQ(reused.value, -9);
+
+    state.clear();
+    const auto afterClear = state.submit(owner(), header(5), create(0), 3);
+    EXPECT_EQ(afterClear.signalId, 1U);
+    EXPECT_NE(afterClear.generation, reused.generation);
+}

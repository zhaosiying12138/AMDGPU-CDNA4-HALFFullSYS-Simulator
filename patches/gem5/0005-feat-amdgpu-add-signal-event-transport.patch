+TEST(HostGPUSignalState, EnforcesSignalLimitAndOwnerGeneration)
+{
+    HostGPUSignalState state;
+    protocol::SignalResponse first;
+    for (size_t index = 0; index < HostGPUSignalState::MaximumSignals;
+         ++index) {
+        const auto result = state.submit(
+            owner(), header(index + 1), create(0), index);
+        ASSERT_EQ(result.status, protocol::Status::Ok);
+        if (index == 0)
+            first = result;
+    }
+    EXPECT_EQ(state.submit(owner(), header(2000), create(0), 0).status,
+              protocol::Status::ResourceExhausted);
+
+    const auto reusedFd = owner(owner().fd, owner().clientGeneration + 1);
+    EXPECT_EQ(state.submit(reusedFd, header(2001),
+                           operation(first, protocol::SignalOpcode::Load), 0)
+                  .status,
+              protocol::Status::ProtocolState);
+    auto stale = operation(first, protocol::SignalOpcode::Load);
+    ++stale.generation;
+    EXPECT_EQ(state.submit(owner(), header(2002), stale, 0).status,
+              protocol::Status::ProtocolState);
+}

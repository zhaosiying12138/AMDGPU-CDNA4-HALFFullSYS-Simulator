+void
+HostGPUBridge::scheduleSignalService()
+{
+    const auto next = signalState.nextReadyTick();
+    if (next && !signalServiceEvent.scheduled())
+        schedule(signalServiceEvent, static_cast<Tick>(*next));
+}
+
+void
+HostGPUBridge::processSignalCompletions()
+{
+    while (const auto completion = signalState.popReady(curTick())) {
+        auto found = clients.find(completion->owner.fd);
+        if (found == clients.end() || found->second->generation !=
+                completion->owner.clientGeneration) {
+            signalState.complete(*completion);
+            continue;
+        }
+
+        protocol::SignalResponse response;
+        response.status = protocol::Status::Ok;
+        response.opcode = protocol::SignalOpcode::Wait;
+        response.signalId = completion->signalId;
+        response.generation = completion->signalGeneration;
+        response.sequence = completion->sequence;
+        response.value = completion->value;
+        response.simTick = completion->readyTick;
+        const auto responseHeader = protocol::queueResponseHeader(
+            completion->header, identity, found->second->connectionId);
+        auto encoded = protocol::encodeSignalCompletion(
+            responseHeader, response);
+        enqueueOutbound(
+            completion->owner.fd, completion->owner.clientGeneration,
+            OutboundRecord{std::move(encoded),
+                           OutboundKind::SignalCompletion,
+                           protocol::Status::Ok, true, *completion});
+    }
+    scheduleSignalService();
+}

+TEST(HostGpuProtocol, SignalRequestValidationIsStrict)
+{
+    auto expect = [](std::vector<uint8_t> frame, Status status) {
+        recomputeCrc(frame);
+        const auto decoded = decodeSignalRequestRecord(
+            frame.data(), frame.size(), MaximumRecordBytes);
+        EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+        EXPECT_EQ(decoded.status, status);
+        EXPECT_FALSE(decoded.closeConnection);
+    };
+
+    auto frame = fromHex(GoldenSignalWaitRequestHex);
+    store16(frame, HeaderBytes, 2);
+    expect(frame, Status::UnsupportedVersion);
+    store16(frame, HeaderBytes + 6, 1);
+    expect(frame, Status::Malformed);
+
+    frame = fromHex(GoldenSignalWaitRequestHex);
+    store16(frame, HeaderBytes + 4, 99);
+    expect(frame, Status::Malformed);
+    frame = fromHex(GoldenSignalWaitRequestHex);
+    store64(frame, HeaderBytes + 40, 4);
+    expect(frame, Status::Malformed);
+    frame = fromHex(GoldenSignalWaitRequestHex);
+    store64(frame, HeaderBytes + 48, 1);
+    expect(frame, Status::Malformed);
+    frame = fromHex(GoldenSignalWaitRequestHex);
+    store64(frame, HeaderBytes + 56, 1);
+    expect(frame, Status::Malformed);
+
+    SignalRequest request;
+    request.opcode = SignalOpcode::Destroy;
+    request.signalId = 1;
+    request.generation = 2;
+    for (const size_t offset : {size_t(24), size_t(32), size_t(40)}) {
+        frame = encodeSignalRequest(goldenMemoryHeader(30), request);
+        store64(frame, HeaderBytes + offset, 1);
+        expect(frame, Status::Malformed);
+    }
+    request.opcode = SignalOpcode::Load;
+    request.value = 1;
+    frame = encodeSignalRequest(goldenMemoryHeader(31), request);
+    expect(frame, Status::Malformed);
+    request = {};
+    request.opcode = SignalOpcode::Store;
+    request.signalId = 1;
+    request.generation = 2;
+    request.sequence = 1;
+    frame = encodeSignalRequest(goldenMemoryHeader(32), request);
+    expect(frame, Status::Malformed);
+    request = {};
+    request.opcode = SignalOpcode::Wait;
+    request.signalId = 1;
+    request.generation = 2;
+    frame = encodeSignalRequest(goldenMemoryHeader(33), request);
+    expect(frame, Status::Malformed);
+
+    frame = fromHex(GoldenSignalWaitRequestHex);
+    store16(frame, 14, static_cast<uint16_t>(MessageType::SignalAck));
+    recomputeCrc(frame);
+    EXPECT_EQ(decodeSignalRequestRecord(
+                  frame.data(), frame.size(), MaximumRecordBytes).action,
+              DecodeAction::Drop);
+    frame = fromHex(GoldenSignalWaitRequestHex);
+    frame.pop_back();

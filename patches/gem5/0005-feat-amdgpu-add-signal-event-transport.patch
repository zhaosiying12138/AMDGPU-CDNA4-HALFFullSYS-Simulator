+std::vector<uint8_t>
+encodeSignalRequest(const Header &header, const SignalRequest &request)
+{
+    std::vector<uint8_t> payload(SignalPayloadBytes, 0);
+    store16(payload, 0, request.major);
+    store16(payload, 2, request.minor);
+    store16(payload, 4, static_cast<uint16_t>(request.opcode));
+    store16(payload, 6, request.flags);
+    store64(payload, 8, request.signalId);
+    store64(payload, 16, request.generation);
+    store64(payload, 24, request.sequence);
+    storeSigned64(payload, 32, request.value);
+    store64(payload, 40, static_cast<uint64_t>(request.condition));
+    Header encoded = header;
+    encoded.messageType = MessageType::SignalRequest;
+    return encodeFrame(encoded, payload);
+}

+#ifndef __DEV_AMDGPU_HOST_GPU_SIGNAL_STATE_HH__
+#define __DEV_AMDGPU_HOST_GPU_SIGNAL_STATE_HH__
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+
+#include "dev/amdgpu/host_gpu_protocol.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/** Bounded bridge-private signed signals and one-shot wait completions. */
+class HostGPUSignalState
+{
+  public:
+    static constexpr size_t MaximumSignals = 1024;
+    static constexpr size_t MaximumWaits = 8;
+    static constexpr uint64_t CompletionDelay = 1;
+
+    struct Owner
+    {
+        int fd = -1;
+        uint64_t clientGeneration = 0;
+
+        bool operator==(const Owner &other) const
+        {
+            return fd == other.fd &&
+                   clientGeneration == other.clientGeneration;
+        }
+    };
+
+    struct Completion
+    {
+        Owner owner;
+        protocol::Header header;
+        uint64_t signalId = 0;
+        uint64_t signalGeneration = 0;
+        uint64_t sequence = 0;
+        int64_t value = 0;
+        uint64_t readyTick = 0;
+    };
+
+    protocol::SignalResponse submit(
+        const Owner &owner, const protocol::Header &header,
+        const protocol::SignalRequest &request, uint64_t now);
+    static protocol::SignalResponse failureResponse(
+        const protocol::SignalRequest &request, protocol::Status status);
+    static bool isNextSequence(uint64_t previous, uint64_t candidate);
+    static bool conditionSatisfied(
+        int64_t value, protocol::SignalCondition condition,
+        int64_t compareValue);
+    bool callbackPending(const Completion &completion) const;
+    std::optional<Completion> popReady(uint64_t now);
+    bool complete(const Completion &completion);
+    std::optional<uint64_t> nextReadyTick() const;
+    void disconnect(const Owner &owner);
+    void clear();
+
+    size_t signalCount() const { return liveSignals; }
+    size_t waitCount() const { return liveWaits; }
+
+  private:
+    struct Wait
+    {
+        protocol::Header header;
+        uint64_t sequence = 0;
+        protocol::SignalCondition condition =
+            protocol::SignalCondition::Equal;
+        int64_t compareValue = 0;
+        bool ready = false;
+        bool queued = false;
+        int64_t capturedValue = 0;
+        uint64_t readyTick = 0;
+    };
+
+    struct Signal
+    {
+        Owner owner;
+        uint64_t generation = 0;
+        int64_t value = 0;
+        uint64_t lastSequence = 0;
+        std::optional<Wait> wait;
+    };
+
+    Signal *resolve(
+        const Owner &owner, const protocol::SignalRequest &request);
+    const Signal *resolve(
+        const Owner &owner, uint64_t signalId, uint64_t generation) const;
+    bool takeGeneration(uint64_t &generation);
+
+    std::array<std::optional<Signal>, MaximumSignals> signals;
+    uint64_t nextGeneration = 1;
+    bool generationExhausted = false;
+    size_t liveSignals = 0;
+    size_t liveWaits = 0;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_SIGNAL_STATE_HH__

+SignalDecodeResult
+decodeSignalRequestRecord(const uint8_t *record, size_t size,
+                          uint32_t configuredMaximum)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason)) {
+        SignalDecodeResult result;
+        result.reason = reason;
+        return result;
+    }
+    if (header.messageType != MessageType::SignalRequest) {
+        SignalDecodeResult result;
+        result.reason = "expected SIGNAL_REQUEST";
+        return result;
+    }
+    if (size - HeaderBytes != SignalPayloadBytes) {
+        SignalDecodeResult result;
+        result.reason = "signal payload length";
+        return result;
+    }
+
+    SignalRequest request;
+    request.major = load16(payload);
+    request.minor = load16(payload + 2);
+    const uint16_t rawOpcode = load16(payload + 4);
+    request.opcode = static_cast<SignalOpcode>(rawOpcode);
+    request.flags = load16(payload + 6);
+    request.signalId = load64(payload + 8);
+    request.generation = load64(payload + 16);
+    request.sequence = load64(payload + 24);
+    request.value = loadSigned64(payload + 32);
+    const uint64_t rawCondition = load64(payload + 40);
+    request.condition = static_cast<SignalCondition>(rawCondition);
+    const uint64_t reserved0 = load64(payload + 48);
+    const uint64_t reserved1 = load64(payload + 56);
+
+    auto acknowledge = [&](Status status, const std::string &why) {
+        SignalDecodeResult result;
+        result.action = DecodeAction::Acknowledge;
+        result.closeConnection = false;
+        result.status = status;
+        result.reason = why;
+        result.header = header;
+        result.request = request;
+        return result;
+    };
+
+    if (!validSignalOpcode(rawOpcode) || request.flags != 0 ||
+        reserved0 != 0 || reserved1 != 0) {
+        return acknowledge(Status::Malformed, "invalid signal fields");
+    }
+
+    switch (request.opcode) {
+      case SignalOpcode::Create:
+        if (request.signalId != 0 || request.generation != 0 ||
+            request.sequence != 0 || rawCondition != 0) {
+            return acknowledge(Status::Malformed,
+                               "invalid signal create fields");
+        }
+        break;
+      case SignalOpcode::Destroy:
+      case SignalOpcode::Load:
+        if (request.signalId == 0 || request.generation == 0 ||
+            request.sequence != 0 || request.value != 0 ||
+            rawCondition != 0) {
+            return acknowledge(Status::Malformed,
+                               "invalid signal handle operation fields");
+        }
+        break;
+      case SignalOpcode::Store:
+        if (request.signalId == 0 || request.generation == 0 ||
+            request.sequence != 0 || rawCondition != 0) {
+            return acknowledge(Status::Malformed,
+                               "invalid signal store fields");
+        }
+        break;
+      case SignalOpcode::Wait:
+        if (request.signalId == 0 || request.generation == 0 ||
+            request.sequence == 0 || !validSignalCondition(rawCondition)) {
+            return acknowledge(Status::Malformed,
+                               "invalid signal wait fields");
+        }
+        break;
+    }
+    if (request.major != SignalEventMajor ||
+        request.minor != SignalEventMinor) {
+        return acknowledge(Status::UnsupportedVersion,
+                           "unsupported signal event version");
+    }
+    return acknowledge(Status::Ok, "valid signal request");
+}

+TEST(HostGPUSignalState, SequenceAdvancesOnlyOnAcceptedWaitWithoutWrap)
+{
+    EXPECT_TRUE(HostGPUSignalState::isNextSequence(0, 1));
+    EXPECT_FALSE(HostGPUSignalState::isNextSequence(1, 1));
+    EXPECT_FALSE(HostGPUSignalState::isNextSequence(1, 3));
+    EXPECT_FALSE(HostGPUSignalState::isNextSequence(
+        std::numeric_limits<uint64_t>::max(), 0));
+
+    HostGPUSignalState state;
+    const auto created = state.submit(owner(), header(), create(0), 0);
+    auto skipped = waitFor(
+        created, 2, protocol::SignalCondition::Equal, 1);
+    EXPECT_EQ(state.submit(owner(), header(2), skipped, 1).status,
+              protocol::Status::ProtocolState);
+    skipped.sequence = 1;
+    EXPECT_EQ(state.submit(owner(), header(3), skipped, 1).status,
+              protocol::Status::Ok);
+}

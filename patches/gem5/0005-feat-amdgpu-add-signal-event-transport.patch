+TEST(HostGPUSignalState, DisconnectCancelsOnlyMatchingOwnerAndQueuedWait)
+{
+    HostGPUSignalState state;
+    const auto firstOwner = owner(7, 1);
+    const auto secondOwner = owner(8, 2);
+    const auto first = state.submit(firstOwner, header(), create(0), 0);
+    const auto second = state.submit(secondOwner, header(2), create(0), 0);
+    ASSERT_EQ(state.submit(
+                  firstOwner, header(3),
+                  waitFor(first, 1, protocol::SignalCondition::Equal, 0), 10)
+                  .status,
+              protocol::Status::Ok);
+    ASSERT_EQ(state.submit(
+                  secondOwner, header(4),
+                  waitFor(second, 1, protocol::SignalCondition::Equal, 0), 10)
+                  .status,
+              protocol::Status::Ok);
+    const auto firstCompletion = state.popReady(11);
+    ASSERT_TRUE(firstCompletion);
+    state.disconnect(firstOwner);
+    EXPECT_EQ(state.signalCount(), 1U);
+    EXPECT_EQ(state.waitCount(), 1U);
+    EXPECT_FALSE(state.callbackPending(*firstCompletion));
+    const auto remaining = state.popReady(11);
+    ASSERT_TRUE(remaining);
+    EXPECT_EQ(remaining->owner, secondOwner);
+}

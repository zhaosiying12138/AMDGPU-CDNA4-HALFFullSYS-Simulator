+protocol::SignalResponse
+HostGPUSignalState::failureResponse(
+    const protocol::SignalRequest &request, protocol::Status status)
+{
+    protocol::SignalResponse response;
+    response.status = status;
+    response.opcode = request.opcode;
+    response.signalId = request.signalId;
+    response.generation = request.generation;
+    response.sequence = request.sequence;
+    return response;
+}
+
+bool
+HostGPUSignalState::takeGeneration(uint64_t &generation)
+{
+    if (generationExhausted || nextGeneration == 0)
+        return false;
+    generation = nextGeneration;
+    if (nextGeneration == std::numeric_limits<uint64_t>::max()) {
+        generationExhausted = true;
+    } else {
+        ++nextGeneration;
+    }
+    return true;
+}
+
+HostGPUSignalState::Signal *
+HostGPUSignalState::resolve(
+    const Owner &owner, const protocol::SignalRequest &request)
+{
+    if (request.signalId == 0 || request.signalId > signals.size())
+        return nullptr;
+    auto &slot = signals[request.signalId - 1];
+    if (!slot || !(slot->owner == owner) ||
+        slot->generation != request.generation) {
+        return nullptr;
+    }
+    return &*slot;
+}
+
+const HostGPUSignalState::Signal *
+HostGPUSignalState::resolve(
+    const Owner &owner, uint64_t signalId, uint64_t generation) const
+{
+    if (signalId == 0 || signalId > signals.size())
+        return nullptr;
+    const auto &slot = signals[signalId - 1];
+    if (!slot || !(slot->owner == owner) || slot->generation != generation)
+        return nullptr;
+    return &*slot;
+}
+
+bool
+HostGPUSignalState::isNextSequence(uint64_t previous, uint64_t candidate)
+{
+    return previous != std::numeric_limits<uint64_t>::max() &&
+           candidate == previous + 1;
+}
+
+bool
+HostGPUSignalState::conditionSatisfied(
+    int64_t value, protocol::SignalCondition condition, int64_t compareValue)
+{
+    switch (condition) {
+      case protocol::SignalCondition::Equal:
+        return value == compareValue;
+      case protocol::SignalCondition::NotEqual:
+        return value != compareValue;
+      case protocol::SignalCondition::LessThan:
+        return value < compareValue;
+      case protocol::SignalCondition::GreaterThanOrEqual:
+        return value >= compareValue;
+    }
+    return false;
+}
+
+protocol::SignalResponse
+HostGPUSignalState::submit(
+    const Owner &owner, const protocol::Header &header,
+    const protocol::SignalRequest &request, uint64_t now)
+{
+    auto response = failureResponse(
+        request, protocol::Status::ProtocolState);
+
+    if (request.opcode == protocol::SignalOpcode::Create) {
+        response.status = protocol::Status::ResourceExhausted;
+        if (liveSignals >= MaximumSignals)
+            return response;
+        size_t slot = 0;
+        while (slot < signals.size() && signals[slot])
+            ++slot;
+        if (slot == signals.size())
+            return response;
+        uint64_t generation = 0;
+        if (!takeGeneration(generation))
+            return response;
+        signals[slot].emplace(Signal{
+            owner, generation, request.value, 0, std::nullopt});
+        ++liveSignals;
+        response.status = protocol::Status::Ok;
+        response.signalId = slot + 1;
+        response.generation = generation;
+        response.value = request.value;
+        response.simTick = now;
+        return response;
+    }
+
+    Signal *signal = resolve(owner, request);
+    if (signal == nullptr)
+        return response;
+
+    switch (request.opcode) {
+      case protocol::SignalOpcode::Create:
+        break;
+      case protocol::SignalOpcode::Destroy:
+        if (signal->wait) {
+            response.status = protocol::Status::Busy;
+            return response;
+        }
+        signals[request.signalId - 1].reset();
+        --liveSignals;
+        response.status = protocol::Status::Ok;
+        response.simTick = now;
+        return response;
+      case protocol::SignalOpcode::Load:
+        response.status = protocol::Status::Ok;
+        response.value = signal->value;
+        response.simTick = now;
+        return response;
+      case protocol::SignalOpcode::Store: {
+        const bool wakesArmed = signal->wait && !signal->wait->ready &&
+            conditionSatisfied(request.value, signal->wait->condition,
+                               signal->wait->compareValue);
+        if (wakesArmed && now == std::numeric_limits<uint64_t>::max()) {
+            response.status = protocol::Status::Internal;
+            return response;
+        }
+        signal->value = request.value;
+        if (wakesArmed) {
+            signal->wait->ready = true;
+            signal->wait->capturedValue = request.value;
+            signal->wait->readyTick = now + CompletionDelay;
+        }
+        response.status = protocol::Status::Ok;
+        response.value = request.value;
+        response.simTick = now;
+        return response;
+      }
+      case protocol::SignalOpcode::Wait: {
+        if (!isNextSequence(signal->lastSequence, request.sequence))
+            return response;
+        if (signal->wait) {
+            response.status = protocol::Status::Busy;
+            return response;
+        }
+        if (liveWaits >= MaximumWaits) {
+            response.status = protocol::Status::ResourceExhausted;
+            return response;
+        }
+        if (now == std::numeric_limits<uint64_t>::max()) {
+            response.status = protocol::Status::Internal;
+            return response;
+        }
+        const bool ready = conditionSatisfied(
+            signal->value, request.condition, request.value);
+        signal->wait.emplace(Wait{
+            header, request.sequence, request.condition, request.value,
+            ready, false, ready ? signal->value : 0,
+            ready ? now + CompletionDelay : 0});
+        signal->lastSequence = request.sequence;
+        ++liveWaits;
+        response.status = protocol::Status::Ok;
+        response.value = signal->value;
+        response.ready = ready ? 1 : 0;
+        response.simTick = now;
+        return response;
+      }
+    }
+
+    response.status = protocol::Status::Malformed;
+    return response;
+}
+
+bool
+HostGPUSignalState::callbackPending(const Completion &completion) const
+{
+    const Signal *signal = resolve(
+        completion.owner, completion.signalId, completion.signalGeneration);
+    if (signal == nullptr || !signal->wait || !signal->wait->ready)
+        return false;
+    const Wait &wait = *signal->wait;
+    return completion.header.requestId != 0 &&
+        wait.header.requestId == completion.header.requestId &&
+        wait.sequence == completion.sequence &&
+        wait.capturedValue == completion.value &&
+        wait.readyTick == completion.readyTick;
+}
+
+std::optional<HostGPUSignalState::Completion>
+HostGPUSignalState::popReady(uint64_t now)
+{
+    size_t selected = signals.size();
+    uint64_t selectedTick = std::numeric_limits<uint64_t>::max();
+    for (size_t slot = 0; slot < signals.size(); ++slot) {
+        if (!signals[slot] || !signals[slot]->wait ||
+            !signals[slot]->wait->ready ||
+            signals[slot]->wait->queued ||
+            signals[slot]->wait->readyTick > now) {
+            continue;
+        }
+        if (selected == signals.size() ||
+            signals[slot]->wait->readyTick < selectedTick) {
+            selected = slot;
+            selectedTick = signals[slot]->wait->readyTick;
+        }
+    }
+    if (selected == signals.size())
+        return std::nullopt;
+
+    Signal &signal = *signals[selected];
+    const Wait &wait = *signal.wait;
+    Completion completion{
+        signal.owner, wait.header, selected + 1, signal.generation,
+        wait.sequence, wait.capturedValue, wait.readyTick};
+    signal.wait->queued = true;
+    return completion;
+}
+
+bool
+HostGPUSignalState::complete(const Completion &completion)
+{
+    Signal *signal = nullptr;
+    if (completion.signalId != 0 && completion.signalId <= signals.size()) {
+        auto &slot = signals[completion.signalId - 1];
+        if (slot && slot->owner == completion.owner &&
+            slot->generation == completion.signalGeneration) {
+            signal = &*slot;
+        }
+    }
+    if (signal == nullptr || !signal->wait || !signal->wait->queued ||
+        !callbackPending(completion)) {
+        return false;
+    }
+    signal->wait.reset();
+    --liveWaits;
+    return true;
+}
+
+std::optional<uint64_t>
+HostGPUSignalState::nextReadyTick() const
+{
+    std::optional<uint64_t> next;
+    for (const auto &signal : signals) {
+        if (!signal || !signal->wait || !signal->wait->ready ||
+            signal->wait->queued)
+            continue;
+        if (!next || signal->wait->readyTick < *next)
+            next = signal->wait->readyTick;
+    }
+    return next;
+}
+
+void
+HostGPUSignalState::disconnect(const Owner &owner)
+{
+    for (auto &signal : signals) {
+        if (signal && signal->owner == owner) {
+            if (signal->wait)
+                --liveWaits;
+            signal.reset();
+            --liveSignals;
+        }
+    }
+}
+
+void
+HostGPUSignalState::clear()
+{
+    for (auto &signal : signals)
+        signal.reset();
+    liveSignals = 0;
+    liveWaits = 0;
+}
+
+} // namespace hostgpu
+} // namespace gem5

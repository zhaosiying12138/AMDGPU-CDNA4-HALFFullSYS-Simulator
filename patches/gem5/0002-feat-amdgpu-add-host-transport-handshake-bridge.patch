+TEST(HostGPUAdmissionBudget, PreservesIndependentRegularAndLimitedCapacity)
+{
+    ClientAdmissionBudget budget(8, 8);
+    for (unsigned index = 0; index < 8; ++index)
+        EXPECT_EQ(budget.acquire(), ClientAdmission::Regular);
+    for (unsigned index = 0; index < 8; ++index)
+        EXPECT_EQ(budget.acquire(), ClientAdmission::ResourceLimited);
+    EXPECT_EQ(budget.acquire(), ClientAdmission::Rejected);
+    EXPECT_EQ(budget.regular(), 8U);
+    EXPECT_EQ(budget.limited(), 8U);
+
+    budget.release(ClientAdmission::Regular);
+    EXPECT_EQ(budget.acquire(), ClientAdmission::Regular);
+    budget.release(ClientAdmission::ResourceLimited);
+    EXPECT_EQ(budget.acquire(), ClientAdmission::ResourceLimited);
+    for (unsigned index = 0; index < 8; ++index) {
+        budget.release(ClientAdmission::Regular);
+        budget.release(ClientAdmission::ResourceLimited);
+    }
+    EXPECT_EQ(budget.regular(), 0U);
+    EXPECT_EQ(budget.limited(), 0U);
+}

+TEST(HostGPUSocketUtils, PinnedChmodNeverTouchesReplacement)
+{
+    const std::string directory = temporaryDirectory();
+    ASSERT_FALSE(directory.empty());
+    const int directoryFd = ::open(
+        directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    ASSERT_GE(directoryFd, 0);
+    const std::string name = "endpoint.sock";
+    const std::string path = directory + "/" + name;
+
+    const int original = bindSeqpacket(path);
+    ASSERT_GE(original, 0);
+    struct stat expected = {};
+    ASSERT_EQ(::lstat(path.c_str(), &expected), 0);
+    const int pinned = pinSocketAtNoFollow(directoryFd, name, expected);
+    ASSERT_GE(pinned, 0);
+
+    ASSERT_EQ(::unlink(path.c_str()), 0);
+    const int replacement = bindSeqpacket(path);
+    ASSERT_GE(replacement, 0);
+    ASSERT_EQ(::chmod(path.c_str(), 0660), 0);
+    ASSERT_TRUE(chmodPinnedSocket(pinned, expected, 0600));
+
+    struct stat pinnedStatus = {};
+    struct stat replacementStatus = {};
+    ASSERT_EQ(::fstat(pinned, &pinnedStatus), 0);
+    ASSERT_EQ(::lstat(path.c_str(), &replacementStatus), 0);
+    EXPECT_EQ(pinnedStatus.st_mode & 0777, 0600);
+    EXPECT_EQ(replacementStatus.st_mode & 0777, 0660);
+    errno = 0;
+    EXPECT_EQ(pinSocketAtNoFollow(directoryFd, name, expected), -1);
+    EXPECT_EQ(errno, ESTALE);
+
+    ::close(pinned);
+    ::close(original);
+    ::close(replacement);
+    ASSERT_EQ(::unlink(path.c_str()), 0);
+    ::close(directoryFd);
+    ASSERT_EQ(::rmdir(directory.c_str()), 0);
+}
+
+TEST(HostGPUSocketUtils, PublishesBoundSocketWithoutReplacement)
+{
+    const std::string directory = temporaryDirectory();
+    ASSERT_FALSE(directory.empty());
+    const int directoryFd = ::open(
+        directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    ASSERT_GE(directoryFd, 0);
+    const std::string temporaryName = "temporary.sock";
+    const std::string endpointName = "endpoint.sock";
+    const std::string temporaryPath = directory + "/" + temporaryName;
+    const std::string endpointPath = directory + "/" + endpointName;
+
+    const int listener = bindSeqpacket(temporaryPath);
+    ASSERT_GE(listener, 0);
+    struct stat expected = {};
+    ASSERT_EQ(::lstat(temporaryPath.c_str(), &expected), 0);
+    const int pinned = pinSocketAtNoFollow(
+        directoryFd, temporaryName, expected);
+    ASSERT_GE(pinned, 0);
+    ASSERT_TRUE(chmodPinnedSocket(pinned, expected, 0600));
+    ASSERT_EQ(::listen(listener, 1), 0);
+    const SocketPublicationResult publication = publishSocketAtNoReplace(
+        directoryFd, temporaryName, endpointName, expected);
+    ASSERT_TRUE(publication.complete());
+    EXPECT_TRUE(publication.endpointMayExist);
+    EXPECT_FALSE(publication.temporaryMayExist);
+    EXPECT_EQ(publication.error, 0);
+
+    struct stat published = {};
+    ASSERT_EQ(::lstat(endpointPath.c_str(), &published), 0);
+    EXPECT_EQ(published.st_dev, expected.st_dev);
+    EXPECT_EQ(published.st_ino, expected.st_ino);
+    EXPECT_EQ(published.st_mode & 0777, 0600);
+    errno = 0;
+    EXPECT_EQ(::lstat(temporaryPath.c_str(), &published), -1);
+    EXPECT_EQ(errno, ENOENT);
+
+    const int client = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    ASSERT_GE(client, 0);
+    sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, endpointPath.c_str(), endpointPath.size() + 1);
+    ASSERT_EQ(::connect(client, reinterpret_cast<sockaddr *>(&address),
+                        sizeof(address)), 0);
+    const int accepted = ::accept4(listener, nullptr, nullptr, SOCK_CLOEXEC);
+    ASSERT_GE(accepted, 0);
+
+    ::close(accepted);
+    ::close(client);
+    ::close(pinned);
+    ::close(listener);
+    ASSERT_EQ(::unlink(endpointPath.c_str()), 0);
+    ::close(directoryFd);
+    ASSERT_EQ(::rmdir(directory.c_str()), 0);
+}
+
+TEST(HostGPUSocketUtils, PublicationPreservesExistingEndpoint)
+{
+    const std::string directory = temporaryDirectory();
+    ASSERT_FALSE(directory.empty());
+    const int directoryFd = ::open(
+        directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    ASSERT_GE(directoryFd, 0);
+    const std::string temporaryName = "temporary.sock";
+    const std::string endpointName = "endpoint.sock";
+    const std::string temporaryPath = directory + "/" + temporaryName;
+    const std::string endpointPath = directory + "/" + endpointName;
+
+    const int temporary = bindSeqpacket(temporaryPath);
+    const int existing = bindSeqpacket(endpointPath);
+    ASSERT_GE(temporary, 0);
+    ASSERT_GE(existing, 0);
+    struct stat expected = {};
+    struct stat existingStatus = {};
+    ASSERT_EQ(::lstat(temporaryPath.c_str(), &expected), 0);
+    ASSERT_EQ(::lstat(endpointPath.c_str(), &existingStatus), 0);
+    errno = 0;
+    const SocketPublicationResult publication = publishSocketAtNoReplace(
+        directoryFd, temporaryName, endpointName, expected);
+    EXPECT_FALSE(publication.complete());
+    EXPECT_FALSE(publication.endpointMayExist);
+    EXPECT_TRUE(publication.temporaryMayExist);
+    EXPECT_EQ(publication.error, EEXIST);
+    struct stat after = {};
+    ASSERT_EQ(::lstat(endpointPath.c_str(), &after), 0);
+    EXPECT_EQ(after.st_dev, existingStatus.st_dev);
+    EXPECT_EQ(after.st_ino, existingStatus.st_ino);
+    EXPECT_EQ(::lstat(temporaryPath.c_str(), &after), 0);
+
+    ::close(temporary);
+    ::close(existing);
+    ASSERT_EQ(::unlink(temporaryPath.c_str()), 0);
+    ASSERT_EQ(::unlink(endpointPath.c_str()), 0);
+    ::close(directoryFd);
+    ASSERT_EQ(::rmdir(directory.c_str()), 0);
+}
+
+TEST(HostGPUSocketUtils, PublicationPreservesStatError)
+{
+    struct stat expected = {};
+    const SocketPublicationResult publication = publishSocketAtNoReplace(
+        -1, "temporary.sock", "endpoint.sock", expected);
+    EXPECT_FALSE(publication.complete());
+    EXPECT_TRUE(publication.temporaryMayExist);
+    EXPECT_EQ(publication.error, EBADF);
+}
+
+TEST(HostGPUSocketUtils, AliasCleanupRetainsErrorAndCanRetry)
+{
+    const std::string directory = temporaryDirectory();
+    ASSERT_FALSE(directory.empty());
+    const int directoryFd = ::open(
+        directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    ASSERT_GE(directoryFd, 0);
+    const std::string name = "endpoint.sock";
+    const std::string path = directory + "/" + name;
+    const int listener = bindSeqpacket(path);
+    ASSERT_GE(listener, 0);
+    struct stat expected = {};
+    ASSERT_EQ(::lstat(path.c_str(), &expected), 0);
+
+    ASSERT_EQ(::chmod(directory.c_str(), 0500), 0);
+    size_t blockedAttempts = 0;
+    const SocketAliasCleanupResult blocked = retrySocketAliasCleanup(
+        4, [&]() {
+            ++blockedAttempts;
+            return unlinkSocketAtIfMatches(directoryFd, name, expected);
+        });
+    EXPECT_EQ(blocked.status, SocketAliasCleanupStatus::Error);
+    EXPECT_EQ(blocked.error, EACCES);
+    EXPECT_EQ(blockedAttempts, 4U);
+    EXPECT_EQ(::lstat(path.c_str(), &expected), 0);
+
+    ASSERT_EQ(::chmod(directory.c_str(), 0700), 0);
+    size_t successfulAttempts = 0;
+    const SocketAliasCleanupResult retried = retrySocketAliasCleanup(
+        4, [&]() {
+            ++successfulAttempts;
+            return unlinkSocketAtIfMatches(directoryFd, name, expected);
+        });
+    EXPECT_EQ(retried.status, SocketAliasCleanupStatus::Removed);
+    EXPECT_EQ(retried.error, 0);
+    EXPECT_EQ(successfulAttempts, 1U);
+    errno = 0;
+    EXPECT_EQ(::lstat(path.c_str(), &expected), -1);
+    EXPECT_EQ(errno, ENOENT);
+
+    ::close(listener);
+    ::close(directoryFd);
+    ASSERT_EQ(::rmdir(directory.c_str()), 0);
+}
+
+TEST(HostGPUSocketUtils, AliasCleanupRetryStopsAtTerminalResult)
+{
+    size_t attempts = 0;
+    const SocketAliasCleanupResult result = retrySocketAliasCleanup(
+        4, [&]() {
+            ++attempts;
+            if (attempts == 1) {
+                return SocketAliasCleanupResult{
+                    SocketAliasCleanupStatus::Error, EINTR};
+            }
+            return SocketAliasCleanupResult{
+                SocketAliasCleanupStatus::IdentityMismatch, ESTALE};
+        });
+    EXPECT_EQ(attempts, 2U);
+    EXPECT_EQ(result.status, SocketAliasCleanupStatus::IdentityMismatch);
+    EXPECT_EQ(result.error, ESTALE);
+}

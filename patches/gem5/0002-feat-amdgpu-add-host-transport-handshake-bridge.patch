+bool
+sameFile(const struct stat &left, const struct stat &right)
+{
+    return left.st_dev == right.st_dev && left.st_ino == right.st_ino &&
+           left.st_uid == right.st_uid &&
+           (left.st_mode & S_IFMT) == (right.st_mode & S_IFMT);
+}
+
+int
+openDirectoryNoSymlinks(const std::string &path)
+{
+    if (path.empty() || path[0] != '/' || path.find("//") != std::string::npos) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    int current = ::open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (current < 0)
+        return -1;
+    size_t begin = 1;
+    while (begin < path.size()) {
+        const size_t end = path.find('/', begin);
+        const std::string component = path.substr(
+            begin, end == std::string::npos ? std::string::npos : end - begin);
+        if (component.empty() || component == "." || component == "..") {
+            ::close(current);
+            errno = EINVAL;
+            return -1;
+        }
+        const int next = ::openat(current, component.c_str(),
+            O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        const int savedErrno = errno;
+        ::close(current);
+        if (next < 0) {
+            errno = savedErrno;
+            return -1;
+        }
+        current = next;
+        if (end == std::string::npos)
+            break;
+        begin = end + 1;
+    }
+    return current;
+}
+
+bool
+makeUnixAddress(const std::string &path, sockaddr_un &address,
+                socklen_t &addressSize)
+{
+    if (path.empty() || path.size() >= sizeof(address.sun_path))
+        return false;
+    std::memset(&address, 0, sizeof(address));
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, path.data(), path.size());
+    addressSize = static_cast<socklen_t>(
+        offsetof(sockaddr_un, sun_path) + path.size() + 1);
+    return true;
+}
+
+timespec monotonicDeadline(uint32_t milliseconds);
+int millisecondsRemaining(const timespec &deadline);
+
+int
+probeEndpoint(const std::string &path)
+{
+    const timespec deadline = monotonicDeadline(StaleProbeTimeoutMs);
+    const int fd = ::socket(AF_UNIX,
+        SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return errno;
+
+    sockaddr_un address;
+    socklen_t addressSize = 0;
+    if (!makeUnixAddress(path, address, addressSize)) {
+        ::close(fd);
+        return ENAMETOOLONG;
+    }
+
+    int result = -1;
+    while (millisecondsRemaining(deadline) != 0) {
+        result = ::connect(fd, reinterpret_cast<sockaddr *>(&address),
+                           addressSize);
+        if (result == 0 || errno != EINTR)
+            break;
+    }
+    if (result == 0) {
+        ::close(fd);
+        return 0;
+    }
+
+    int error = errno;
+    if (result < 0 && error == EINTR)
+        error = ETIMEDOUT;
+    if (error == EINPROGRESS) {
+        pollfd descriptor = {fd, POLLOUT, 0};
+        while (true) {
+            const int remaining = millisecondsRemaining(deadline);
+            if (remaining == 0) {
+                error = ETIMEDOUT;
+                break;
+            }
+            result = ::poll(&descriptor, 1, remaining);
+            if (result < 0 && errno == EINTR)
+                continue;
+            if (result == 0) {
+                error = ETIMEDOUT;
+            } else if (result < 0) {
+                error = errno;
+            } else {
+                socklen_t size = sizeof(error);
+                if (::getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) < 0 ||
+                    size != sizeof(error)) {
+                    error = errno != 0 ? errno : EIO;
+                }
+            }
+            break;
+        }
+    }
+    ::close(fd);
+    return error;
+}
+
+timespec
+monotonicDeadline(uint32_t milliseconds)
+{
+    timespec deadline = {};
+    fatal_if(::clock_gettime(CLOCK_MONOTONIC, &deadline) != 0,
+             "HostGPUBridge: clock_gettime failed: %s", std::strerror(errno));
+    deadline.tv_sec += milliseconds / 1000;
+    deadline.tv_nsec += static_cast<long>(milliseconds % 1000) * 1000000L;
+    if (deadline.tv_nsec >= 1000000000L) {
+        ++deadline.tv_sec;
+        deadline.tv_nsec -= 1000000000L;
+    }
+    return deadline;
+}
+
+int
+millisecondsRemaining(const timespec &deadline)
+{
+    timespec now = {};
+    if (::clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return 0;
+    int64_t nanoseconds =
+        static_cast<int64_t>(deadline.tv_sec - now.tv_sec) * 1000000000LL +
+        deadline.tv_nsec - now.tv_nsec;
+    if (nanoseconds <= 0)
+        return 0;
+    const int64_t rounded = (nanoseconds + 999999) / 1000000;
+    return static_cast<int>(std::min<int64_t>(
+        rounded, std::numeric_limits<int>::max()));
+}

+TEST(HostGPUSocketUtils, AliasCleanupPreservesReplacement)
+{
+    const std::string directory = temporaryDirectory();
+    ASSERT_FALSE(directory.empty());
+    const int directoryFd = ::open(
+        directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    ASSERT_GE(directoryFd, 0);
+    const std::string name = "endpoint.sock";
+    const std::string path = directory + "/" + name;
+    const int original = bindSeqpacket(path);
+    ASSERT_GE(original, 0);
+    struct stat expected = {};
+    ASSERT_EQ(::lstat(path.c_str(), &expected), 0);
+    ASSERT_EQ(::unlink(path.c_str()), 0);
+    const int replacement = bindSeqpacket(path);
+    ASSERT_GE(replacement, 0);
+
+    const SocketAliasCleanupResult result =
+        unlinkSocketAtIfMatches(directoryFd, name, expected);
+    EXPECT_EQ(result.status, SocketAliasCleanupStatus::IdentityMismatch);
+    EXPECT_EQ(result.error, ESTALE);
+    struct stat current = {};
+    ASSERT_EQ(::lstat(path.c_str(), &current), 0);
+    EXPECT_NE(current.st_ino, expected.st_ino);
+
+    ::close(original);
+    ::close(replacement);
+    ASSERT_EQ(::unlink(path.c_str()), 0);
+    ::close(directoryFd);
+    ASSERT_EQ(::rmdir(directory.c_str()), 0);
+}

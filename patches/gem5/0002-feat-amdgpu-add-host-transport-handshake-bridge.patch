+bool
+sameFile(const struct stat &left, const struct stat &right)
+{
+    return left.st_dev == right.st_dev && left.st_ino == right.st_ino &&
+           left.st_uid == right.st_uid &&
+           (left.st_mode & S_IFMT) == (right.st_mode & S_IFMT);
+}
+
+void
+closeWithErrno(int fd, int error)
+{
+    ::close(fd);
+    errno = error;
+}
+
+} // anonymous namespace
+
+size_t
+closeReceivedFileDescriptors(const msghdr &message)
+{
+    msghdr view = message;
+    size_t closed = 0;
+    for (cmsghdr *control = CMSG_FIRSTHDR(&view); control != nullptr;
+         control = CMSG_NXTHDR(&view, control)) {
+        if (control->cmsg_len < CMSG_LEN(0))
+            break;
+        if (control->cmsg_level != SOL_SOCKET ||
+            control->cmsg_type != SCM_RIGHTS) {
+            continue;
+        }
+
+        const size_t payloadBytes = control->cmsg_len - CMSG_LEN(0);
+        const size_t descriptorCount = payloadBytes / sizeof(int);
+        for (size_t index = 0; index < descriptorCount; ++index) {
+            int fd = -1;
+            std::memcpy(&fd, CMSG_DATA(control) + index * sizeof(fd),
+                        sizeof(fd));
+            if (fd >= 0) {
+                ::close(fd);
+                ++closed;
+            }
+        }
+    }
+    return closed;
+}
+
+int
+pinSocketAtNoFollow(int directoryFd, const std::string &name,
+                    const struct stat &expected)
+{
+    const int pinned = ::openat(
+        directoryFd, name.c_str(), O_PATH | O_NOFOLLOW | O_CLOEXEC);
+    if (pinned < 0)
+        return -1;
+
+    struct stat before = {};
+    if (::fstat(pinned, &before) != 0) {
+        closeWithErrno(pinned, errno);
+        return -1;
+    }
+    if (!S_ISSOCK(before.st_mode) || !sameFile(before, expected)) {
+        closeWithErrno(pinned, ESTALE);
+        return -1;
+    }
+    return pinned;
+}
+
+bool
+chmodPinnedSocket(int pinnedFd, const struct stat &expected, mode_t mode)
+{
+    struct stat before = {};
+    if (::fstat(pinnedFd, &before) != 0)
+        return false;
+    if (!S_ISSOCK(before.st_mode) || !sameFile(before, expected)) {
+        errno = ESTALE;
+        return false;
+    }
+
+    const std::string pinnedPath = "/proc/self/fd/" +
+        std::to_string(pinnedFd);
+    if (::chmod(pinnedPath.c_str(), mode) != 0)
+        return false;
+
+    struct stat after = {};
+    if (::fstat(pinnedFd, &after) != 0)
+        return false;
+    if (!sameFile(before, after) || (after.st_mode & 0777) != mode) {
+        errno = ESTALE;
+        return false;
+    }
+    return true;
+}
+
+SocketAliasCleanupResult
+unlinkSocketAtIfMatches(int directoryFd, const std::string &name,
+                       const struct stat &expected)
+{
+    struct stat current = {};
+    if (::fstatat(directoryFd, name.c_str(), &current,
+                  AT_SYMLINK_NOFOLLOW) != 0) {
+        if (errno == ENOENT)
+            return {SocketAliasCleanupStatus::Missing, 0};
+        return {SocketAliasCleanupStatus::Error, errno};
+    }
+    if (!S_ISSOCK(current.st_mode) || !sameFile(current, expected)) {
+        return {SocketAliasCleanupStatus::IdentityMismatch, ESTALE};
+    }
+    if (::unlinkat(directoryFd, name.c_str(), 0) == 0)
+        return {SocketAliasCleanupStatus::Removed, 0};
+    if (errno == ENOENT)
+        return {SocketAliasCleanupStatus::Missing, 0};
+    return {SocketAliasCleanupStatus::Error, errno};
+}
+
+SocketAliasCleanupResult
+retrySocketAliasCleanup(
+    size_t maximumAttempts,
+    const std::function<SocketAliasCleanupResult()> &cleanup)
+{
+    if (maximumAttempts == 0 || !cleanup)
+        return {SocketAliasCleanupStatus::Error, EINVAL};
+
+    SocketAliasCleanupResult result;
+    for (size_t attempt = 0; attempt < maximumAttempts; ++attempt) {
+        result = cleanup();
+        if (result.status != SocketAliasCleanupStatus::Error)
+            break;
+    }
+    return result;
+}
+
+SocketPublicationResult
+publishSocketAtNoReplace(int directoryFd,
+                         const std::string &temporaryName,
+                         const std::string &endpointName,
+                         const struct stat &expected)
+{
+    SocketPublicationResult result;
+    struct stat temporary = {};
+    if (::fstatat(directoryFd, temporaryName.c_str(), &temporary,
+                  AT_SYMLINK_NOFOLLOW) != 0) {
+        const int error = errno;
+        result.temporaryMayExist = error != ENOENT;
+        result.error = error;
+        return result;
+    }
+    if (!S_ISSOCK(temporary.st_mode) || !sameFile(temporary, expected)) {
+        result.error = ESTALE;
+        return result;
+    }
+
+    if (::linkat(directoryFd, temporaryName.c_str(), directoryFd,
+                 endpointName.c_str(), 0) != 0) {
+        const int linkError = errno;
+        struct stat published = {};
+        if (::fstatat(directoryFd, endpointName.c_str(), &published,
+                      AT_SYMLINK_NOFOLLOW) == 0) {
+            result.endpointMayExist =
+                S_ISSOCK(published.st_mode) && sameFile(published, expected);
+        } else if (errno != ENOENT) {
+            // A failed network-filesystem link can still have taken effect.
+            result.endpointMayExist = true;
+        }
+        result.error = linkError;
+        return result;
+    }
+    result.endpointMayExist = true;
+
+    struct stat published = {};
+    if (::fstatat(directoryFd, endpointName.c_str(), &published,
+                  AT_SYMLINK_NOFOLLOW) != 0) {
+        result.error = errno;
+        return result;
+    }
+    if (!S_ISSOCK(published.st_mode) || !sameFile(published, expected)) {
+        result.error = ESTALE;
+        return result;
+    }
+
+    if (::unlinkat(directoryFd, temporaryName.c_str(), 0) == 0 ||
+        errno == ENOENT) {
+        result.temporaryMayExist = false;
+        return result;
+    }
+    result.error = errno;
+    return result;
+}
+
+} // namespace hostgpu
+} // namespace gem5

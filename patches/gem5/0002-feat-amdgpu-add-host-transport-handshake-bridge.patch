+TEST(HostGpuProtocol, Crc32cCheckVector)
+{
+    constexpr std::array<uint8_t, 9> check = {
+        '1', '2', '3', '4', '5', '6', '7', '8', '9'
+    };
+    EXPECT_EQ(crc32c(check.data(), check.size()), 0xe3069283U);
+}
+
+TEST(HostGpuProtocol, GoldenHelloIsByteExact)
+{
+    const auto expected = fromHex(GoldenHelloHex);
+    const auto actual = encodeHello(goldenHeader(), goldenHello());
+    EXPECT_EQ(actual, expected);
+    ASSERT_EQ(actual.size(), size_t(208));
+    EXPECT_EQ(actual[64], 0x50);
+    EXPECT_EQ(actual[65], 0x8a);
+    EXPECT_EQ(actual[66], 0xe0);
+    EXPECT_EQ(actual[67], 0x12);
+
+    const auto decoded = decodeHelloRecord(
+        actual.data(), actual.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    ASSERT_TRUE(decoded.hasHello);
+    EXPECT_EQ(decoded.header.requestId, 0x0123456789abcdefULL);
+    EXPECT_EQ(decoded.hello.topology.rank, 3U);
+    EXPECT_EQ(decoded.hello.topology.worldSize, 8U);
+    EXPECT_EQ(negotiate(decoded.header, decoded.hello, goldenServer()).status,
+              Status::Ok);
+}
+
+TEST(HostGpuProtocol, GoldenAckIsByteExact)
+{
+    Ack ack;
+    ack.status = Status::Ok;
+    ack.selectedMajor = 1;
+    ack.selectedMinor = 0;
+    ack.clientNonce = uuid("000102030405060708090a0b0c0d0e0f");
+    ack.serverNonce = uuid("f0e0d0c0b0a090807060504030201001");
+    ack.selected = topologyCapability();
+    ack.maximumRecord = MaximumRecordBytes;
+    ack.topology.jobUuid = uuid("102132435465768798a9bacbdcedfe0f");
+    ack.topology.rank = 3;
+    ack.topology.worldSize = 8;
+    const auto actual = encodeAck(
+        goldenHeader(), ack, goldenServer(), 0x1122334455667788ULL);
+    EXPECT_EQ(actual, fromHex(GoldenAckHex));
+    ASSERT_EQ(actual.size(), size_t(192));
+    EXPECT_EQ(actual[64], 0xc0);
+    EXPECT_EQ(actual[65], 0x9c);
+    EXPECT_EQ(actual[66], 0x26);
+    EXPECT_EQ(actual[67], 0x12);
+}
+
+TEST(HostGpuProtocol, InvalidEnvelopeDropsWithoutAck)
+{
+    const auto golden = fromHex(GoldenHelloHex);
+    std::vector<std::vector<uint8_t>> cases;
+    cases.emplace_back(golden.begin(), golden.begin() + 7);
+    cases.push_back(golden);
+    cases.back()[0] ^= 1;
+    cases.push_back(golden);
+    store16(cases.back(), 8, 0x0100);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store32(cases.back(), 20, 127);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    cases.back().back() ^= 1;
+    cases.push_back(golden);
+    store64(cases.back(), 24, 0);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store64(cases.back(), 48, 1);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store32(cases.back(), 68, 1);
+    recomputeCrc(cases.back());
+    cases.push_back(golden);
+    store16(cases.back(), 14, 99);
+    recomputeCrc(cases.back());
+
+    for (const auto &frame : cases) {
+        EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(),
+                                    MaximumRecordBytes).action,
+                  DecodeAction::Drop);
+    }
+}
+
+TEST(HostGpuProtocol, MalformedPayloadGetsDeterministicAck)
+{
+    auto expectMalformed = [](std::vector<uint8_t> frame) {
+        recomputeCrc(frame);
+        const auto decoded = decodeHelloRecord(
+            frame.data(), frame.size(), MaximumRecordBytes);
+        EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+        EXPECT_EQ(decoded.status, Status::Malformed);
+    };
+    auto frame = fromHex(GoldenHelloHex);
+    store32(frame, HeaderBytes + 88, 4095);
+    expectMalformed(frame);
+
+    frame = fromHex(GoldenHelloHex);
+    store16(frame, HeaderBytes + 92, DaemonRole);
+    expectMalformed(frame);
+
+    frame = fromHex(GoldenHelloHex);
+    store16(frame, HeaderBytes + 96 + 2, 2);
+    expectMalformed(frame);
+
+    frame = fromHex(GoldenHelloHex);
+    store32(frame, HeaderBytes + 96 + 4, 25);
+    expectMalformed(frame);
+}
+
+TEST(HostGpuProtocol, ShortPayloadAndZeroNonceDropSilently)
+{
+    Header header = goldenHeader();
+    for (size_t payloadSize : {size_t(0), size_t(23), size_t(24), size_t(95)}) {
+        Hello hello = goldenHello();
+        auto frame = encodeHello(header, hello);
+        frame.resize(HeaderBytes + payloadSize);
+        store32(frame, 20, static_cast<uint32_t>(payloadSize));
+        recomputeCrc(frame);
+        EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(),
+                                    MaximumRecordBytes).action,
+                  DecodeAction::Drop);
+    }
+
+    auto frame = fromHex(GoldenHelloHex);
+    std::fill(frame.begin() + HeaderBytes + 8,
+              frame.begin() + HeaderBytes + 24, 0);
+    recomputeCrc(frame);
+    EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(),
+                                MaximumRecordBytes).action,
+              DecodeAction::Drop);
+
+    frame = fromHex(GoldenAckHex);
+    const auto ack = decodeHelloRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(ack.action, DecodeAction::Drop);
+    EXPECT_TRUE(ack.closeConnection);
+}
+
+TEST(HostGpuProtocol, TlvPaddingDuplicateAndCriticalHandling)
+{
+    auto frame = fromHex(GoldenHelloHex);
+    frame.insert(frame.end(), frame.begin() + HeaderBytes + HelloFixedBytes,
+                 frame.begin() + HeaderBytes + HelloFixedBytes + 32);
+    store32(frame, 20, static_cast<uint32_t>(frame.size() - HeaderBytes));
+    recomputeCrc(frame);
+    EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(),
+                                MaximumRecordBytes).status,
+              Status::Malformed);
+
+    frame = fromHex(GoldenHelloHex);
+    frame.insert(frame.end(), {0, 99, 0, 0, 0, 0, 0, 1, 'x', 0, 0, 0, 0, 0, 0, 1});
+    store32(frame, 20, static_cast<uint32_t>(frame.size() - HeaderBytes));
+    recomputeCrc(frame);
+    EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(),
+                                MaximumRecordBytes).status,
+              Status::Malformed);
+
+    frame = fromHex(GoldenHelloHex);
+    frame.insert(frame.end(), {0, 99, 0, 1, 0, 0, 0, 6,
+                               'f', 'u', 't', 'u', 'r', 'e', 0, 0});
+    store32(frame, 20, static_cast<uint32_t>(frame.size() - HeaderBytes));
+    recomputeCrc(frame);
+    const auto decoded = decodeHelloRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(negotiate(decoded.header, decoded.hello, goldenServer()).status,
+              Status::UnsupportedCapability);
+}
+
+TEST(HostGpuProtocol, NegotiationPrecedenceAndIdentity)
+{
+    Header header = goldenHeader();
+    Hello hello = goldenHello();
+    auto server = goldenServer();
+
+    hello.required[1] = 1;
+    EXPECT_EQ(negotiate(header, hello, server).status, Status::Malformed);
+    hello = goldenHello();
+    hello.minimumMinor = 1;
+    hello.maximumMinor = 1;
+    EXPECT_EQ(negotiate(header, hello, server).status,
+              Status::UnsupportedVersion);
+    hello = goldenHello();
+    hello.maximumMinor = 1;
+    EXPECT_EQ(negotiate(header, hello, server).status, Status::Ok);
+    hello = goldenHello();
+    hello.offered = {};
+    hello.required = {};
+    EXPECT_EQ(negotiate(header, hello, server).status,
+              Status::UnsupportedCapability);
+    hello = goldenHello();
+    header.daemonUuid = uuid("11112233445566778899aabbccddeeff");
+    EXPECT_EQ(negotiate(header, hello, server).status,
+              Status::InstanceMismatch);
+    header = goldenHeader();
+    hello.topology.rank = 4;
+    EXPECT_EQ(negotiate(header, hello, server).status,
+              Status::TopologyMismatch);
+    hello = goldenHello();
+    NegotiationContext context;
+    context.busy = true;
+    context.resourceExhausted = true;
+    EXPECT_EQ(negotiate(header, hello, server, context).status, Status::Busy);
+    context.busy = false;
+    EXPECT_EQ(negotiate(header, hello, server, context).status,
+              Status::ResourceExhausted);
+}
+
+TEST(HostGpuProtocol, TopologyCapabilityAndTlvAreCoupled)
+{
+    auto header = goldenHeader();
+    auto hello = goldenHello();
+    hello.hasTopology = false;
+    auto frame = encodeHello(header, hello);
+    EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(), MaximumRecordBytes)
+                  .status,
+              Status::Malformed);
+
+    hello = goldenHello();
+    hello.offered = {};
+    hello.required = {};
+    frame = encodeHello(header, hello);
+    EXPECT_EQ(decodeHelloRecord(frame.data(), frame.size(), MaximumRecordBytes)
+                  .status,
+              Status::Malformed);
+
+    hello.hasTopology = false;
+    frame = encodeHello(header, hello);
+    const auto decoded = decodeHelloRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(negotiate(decoded.header, decoded.hello, goldenServer()).status,
+              Status::UnsupportedCapability);
+
+    hello = goldenHello();
+    hello.required = {};
+    frame = encodeHello(header, hello);
+    const auto required = decodeHelloRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    EXPECT_EQ(required.status, Status::Ok);
+    EXPECT_EQ(negotiate(required.header, required.hello, goldenServer()).status,
+              Status::UnsupportedCapability);
+}
+
+TEST(HostGpuProtocol, IdentityWildcardsAreAllOrNothing)
+{
+    auto header = goldenHeader();
+    auto hello = goldenHello();
+    header.daemonUuid = {};
+    header.jobEpoch = 0;
+    hello.topology.jobUuid = {};
+    hello.topology.rank = std::numeric_limits<uint32_t>::max();
+    hello.topology.worldSize = 0;
+    EXPECT_EQ(negotiate(header, hello, goldenServer()).status, Status::Ok);
+    hello.topology.rank = 3;
+    EXPECT_EQ(negotiate(header, hello, goldenServer()).status,
+              Status::TopologyMismatch);
+}
+
+TEST(HostGpuProtocol, UuidParsingIsStrict)
+{
+    Uuid value;
+    EXPECT_TRUE(parseUuid("00112233445566778899aabbccddeeff", value));
+    EXPECT_EQ(formatUuid(value), "00112233445566778899aabbccddeeff");
+    EXPECT_TRUE(parseUuid("00112233-4455-6677-8899-aabbccddeeff", value));
+    EXPECT_FALSE(parseUuid("00112233-4455-6677-8899-aabbccddeezz", value));
+    EXPECT_FALSE(parseUuid("0011223344556677", value));
+}
+
+TEST(HostGpuProtocol, FailedAckHasNoSessionMaterial)
+{
+    Ack ack;
+    ack.status = Status::Busy;
+    ack.clientNonce = goldenHello().clientNonce;
+    ack.serverNonce.fill(0xff);
+    ack.selected.fill(0xff);
+    ack.maximumRecord = MinimumRecordBytes;
+    auto server = goldenServer();
+    server.maximumRecord = 32768;
+    const auto frame = encodeAck(
+        goldenHeader(), ack, server, 0x1122334455667788ULL);
+    ASSERT_EQ(frame.size(), HeaderBytes + AckFixedBytes);
+    EXPECT_TRUE(std::all_of(frame.begin() + 48, frame.begin() + 56,
+                            [](uint8_t byte) { return byte == 0; }));
+    EXPECT_TRUE(std::all_of(frame.begin() + HeaderBytes + 24,
+                            frame.begin() + HeaderBytes + 72,
+                            [](uint8_t byte) { return byte == 0; }));
+    EXPECT_EQ(frame[HeaderBytes + 72], 0);
+    EXPECT_EQ(frame[HeaderBytes + 73], 0);
+    EXPECT_EQ(frame[HeaderBytes + 74], 0x80);
+    EXPECT_EQ(frame[HeaderBytes + 75], 0);
+}
+
+TEST(HostGpuProtocol, EstablishedUnknownCriticalIsProtocolState)
+{
+    auto hello = goldenHello();
+    hello.optionalTlvs.push_back({99, CriticalTlvFlag, {'x'}});
+    const auto frame = encodeHello(goldenHeader(), hello);
+    const auto decoded = decodeHelloRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    ASSERT_EQ(decoded.status, Status::Ok);
+    ASSERT_TRUE(decoded.hello.unknownCriticalTlv);
+
+    HostGPUConnectionState state;
+    state.noteRecordReceived();
+    state.beginAck(true);
+    state.noteAckSent();
+    EXPECT_EQ(preNegotiationStatus(state, false, decoded.status),
+              Status::ProtocolState);
+}

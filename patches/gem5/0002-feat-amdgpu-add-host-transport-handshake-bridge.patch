+/** Close every complete SCM_RIGHTS descriptor visible in a recvmsg result. */
+size_t closeReceivedFileDescriptors(const msghdr &message);
+
+/** Open and verify a socket inode without following the published path. */
+int pinSocketAtNoFollow(int directoryFd, const std::string &name,
+                        const struct stat &expected);
+
+/** Restrict a socket through an already verified O_PATH descriptor. */
+bool chmodPinnedSocket(int pinnedFd, const struct stat &expected, mode_t mode);
+
+enum class SocketAliasCleanupStatus
+{
+    Removed,
+    Missing,
+    IdentityMismatch,
+    Error,
+};
+
+struct SocketAliasCleanupResult
+{
+    SocketAliasCleanupStatus status = SocketAliasCleanupStatus::Error;
+    int error = 0;
+};
+
+/** Remove a socket name only when it still identifies the expected inode. */
+SocketAliasCleanupResult unlinkSocketAtIfMatches(
+    int directoryFd, const std::string &name, const struct stat &expected);
+
+/** Retry an alias operation while it reports a non-terminal system error. */
+SocketAliasCleanupResult retrySocketAliasCleanup(
+    size_t maximumAttempts,
+    const std::function<SocketAliasCleanupResult()> &cleanup);
+
+struct SocketPublicationResult
+{
+    // Conservative cleanup state after any successful or ambiguous operation.
+    bool endpointMayExist = false;
+    bool temporaryMayExist = true;
+    int error = 0;
+
+    bool complete() const
+    {
+        return endpointMayExist && !temporaryMayExist && error == 0;
+    }
+};
+
+/** Publish a bound temporary socket without replacing an existing endpoint. */
+SocketPublicationResult publishSocketAtNoReplace(
+    int directoryFd, const std::string &temporaryName,
+    const std::string &endpointName, const struct stat &expected);
+

+
+namespace gem5
+{
+namespace hostgpu
+{
+
+enum class ConnectionPhase
+{
+    AwaitHello,
+    AckPending,
+    Established,
+    Closing,
+};
+
+enum class ClientAdmission
+{
+    Regular,
+    ResourceLimited,
+    Rejected,
+};
+
+class ClientAdmissionBudget
+{
+  public:
+    ClientAdmissionBudget(size_t maximumRegular, size_t maximumLimited)
+        : maximumRegular(maximumRegular), maximumLimited(maximumLimited)
+    {
+        assert(maximumRegular > 0);
+        assert(maximumLimited > 0);
+    }
+
+    ClientAdmission acquire()
+    {
+        if (regularCount < maximumRegular) {
+            ++regularCount;
+            return ClientAdmission::Regular;
+        }
+        if (limitedCount < maximumLimited) {
+            ++limitedCount;
+            return ClientAdmission::ResourceLimited;
+        }
+        return ClientAdmission::Rejected;
+    }
+
+    void release(ClientAdmission admission)
+    {
+        if (admission == ClientAdmission::Regular) {
+            assert(regularCount > 0);
+            --regularCount;
+        } else if (admission == ClientAdmission::ResourceLimited) {
+            assert(limitedCount > 0);
+            --limitedCount;
+        } else {
+            assert(false);
+        }
+    }
+
+    void reset()
+    {
+        regularCount = 0;
+        limitedCount = 0;
+    }
+
+    size_t regular() const { return regularCount; }
+    size_t limited() const { return limitedCount; }
+
+  private:
+    const size_t maximumRegular;
+    const size_t maximumLimited;
+    size_t regularCount = 0;
+    size_t limitedCount = 0;
+};
+
+class HostGPUConnectionState
+{
+  public:
+    ConnectionPhase phase() const { return currentPhase; }
+    bool committed() const { return sessionCommitted; }
+    bool recordPending() const { return pendingRecord; }
+    bool canReceive() const
+    {
+        return !pendingRecord &&
+            (currentPhase == ConnectionPhase::AwaitHello ||
+             currentPhase == ConnectionPhase::Established);
+    }
+    bool handshakeDeadlineApplies() const
+    {
+        return currentPhase == ConnectionPhase::AwaitHello;
+    }
+
+    void noteRecordReceived()
+    {
+        assert(canReceive());
+        pendingRecord = true;
+    }
+
+    void beginAck(bool success)
+    {
+        assert(pendingRecord);
+        pendingRecord = false;
+        successfulAck = success;
+        currentPhase = ConnectionPhase::AckPending;
+    }
+
+    void noteAckSent()
+    {
+        assert(currentPhase == ConnectionPhase::AckPending);
+        if (successfulAck) {
+            sessionCommitted = true;
+            currentPhase = ConnectionPhase::Established;
+        } else {
+            currentPhase = ConnectionPhase::Closing;
+        }
+    }
+
+    void close()
+    {
+        pendingRecord = false;
+        currentPhase = ConnectionPhase::Closing;
+    }
+
+  private:
+    ConnectionPhase currentPhase = ConnectionPhase::AwaitHello;
+    bool pendingRecord = false;
+    bool successfulAck = false;
+    bool sessionCommitted = false;
+};
+
+inline protocol::Status
+preNegotiationStatus(const HostGPUConnectionState &state,
+                     bool disconnectedSession,
+                     protocol::Status decodedStatus)
+{
+    if ((state.phase() != ConnectionPhase::AwaitHello || disconnectedSession) &&
+        decodedStatus != protocol::Status::Malformed) {
+        return protocol::Status::ProtocolState;
+    }
+    return decodedStatus;
+}

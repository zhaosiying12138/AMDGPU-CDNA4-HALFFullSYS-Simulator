+}
+
+HostGPUBridge::HostGPUBridge(const HostGPUBridgeParams &params)
+    : SimObject(params), endpoint(params.endpoint),
+      configuredDaemonUuid(params.daemon_uuid),
+      configuredJobUuid(params.job_uuid), epoch(params.epoch), rank(params.rank),
+      worldSize(params.world_size), startupTimeoutMs(params.startup_timeout_ms),
+      handshakeTimeoutMs(params.handshake_timeout_ms),
+      maximumRecord(params.max_record), exitOnHandshake(params.exit_on_handshake),
+      recordServiceEvent([this]() { processRecords(); },
+                         name() + ".host_gpu_records")
+{
+    validateConfiguration();
+
+    if (configuredDaemonUuid.empty()) {
+        fatal_if(!randomNonzeroUuid(identity.daemonUuid),
+                 "%s: nonblocking getrandom unavailable for daemon_uuid",
+                 name());
+    } else {
+        fatal_if(!protocol::parseUuid(configuredDaemonUuid,
+                                      identity.daemonUuid) ||
+                     protocol::isZero(identity.daemonUuid),
+                 "%s: daemon_uuid must be a nonzero canonical UUID or 32 hex "
+                 "digits", name());
+    }
+    if (configuredJobUuid.empty()) {
+        fatal_if(!randomNonzeroUuid(identity.jobUuid),
+                 "%s: nonblocking getrandom unavailable for job_uuid", name());
+    } else {
+        fatal_if(!protocol::parseUuid(configuredJobUuid, identity.jobUuid) ||
+                     protocol::isZero(identity.jobUuid),
+                 "%s: job_uuid must be a nonzero canonical UUID or 32 hex "
+                 "digits", name());
+    }
+    identity.jobEpoch = epoch;
+    identity.rank = rank;
+    identity.worldSize = worldSize;
+    identity.maximumRecord = maximumRecord;
+    identity.supported = protocol::topologyCapability();
+}
+
+HostGPUBridge::~HostGPUBridge()
+{
+    shutdown();
+}
+
+void
+HostGPUBridge::validateConfiguration()
+{
+    fatal_if(endpoint.empty() || endpoint[0] != '/' || endpoint.back() == '/',
+             "%s: endpoint must be an absolute socket pathname", name());
+    fatal_if(endpoint.find("//") != std::string::npos,
+             "%s: endpoint must not contain empty path components", name());
+    sockaddr_un address = {};
+    socklen_t addressSize = 0;
+    fatal_if(!makeUnixAddress(endpoint, address, addressSize),
+             "%s: endpoint is too long for an AF_UNIX pathname", name());
+    fatal_if(epoch == 0, "%s: epoch must be nonzero", name());
+    fatal_if(worldSize == 0, "%s: world_size must be at least one", name());
+    fatal_if(rank >= worldSize, "%s: rank must be less than world_size", name());
+    fatal_if(handshakeTimeoutMs == 0,
+             "%s: handshake_timeout_ms must be nonzero", name());
+    fatal_if(maximumRecord < protocol::MinimumRecordBytes ||
+                 maximumRecord > protocol::MaximumRecordBytes,
+             "%s: max_record must be in [%u, %u]", name(),
+             protocol::MinimumRecordBytes, protocol::MaximumRecordBytes);
+}
+
+void
+HostGPUBridge::init()
+{
+    SimObject::init();
+    fatal_if(ListenSocket::allDisabled(),
+             "%s: host GPU bridge requires --listener-mode=on", name());
+    if (!exitCallbackRegistered) {
+        registerExitCallback([this]() { shutdown(); });
+        exitCallbackRegistered = true;
+    }
+    prepareEndpoint();
+    listenEvent = std::make_unique<ListenEvent>(*this, listenerFd);
+    pollQueue.schedule(listenEvent.get());
+    inform("host-gpu-ready endpoint=%s daemon_uuid=%s job_uuid=%s epoch=%llu "
+           "rank=%u world=%u max_record=%u",
+           endpoint, protocol::formatUuid(identity.daemonUuid),
+           protocol::formatUuid(identity.jobUuid),
+           static_cast<unsigned long long>(identity.jobEpoch), identity.rank,
+           identity.worldSize, identity.maximumRecord);
+}
+
+void
+HostGPUBridge::startup()
+{
+    SimObject::startup();
+    boundedStartupWait();
+}
+
+void
+HostGPUBridge::prepareEndpoint()
+{
+    const size_t separator = endpoint.rfind('/');
+    parentPath = separator == 0 ? "/" : endpoint.substr(0, separator);
+    endpointName = endpoint.substr(separator + 1);
+    fatal_if(endpointName.empty() || endpointName == "." ||
+                 endpointName == "..",
+             "%s: invalid endpoint basename", name());
+    lockName = endpointName + ".lock";
+    temporaryName.clear();
+    endpointAliasPending = false;
+    temporaryAliasPending = false;
+    endpointCleanupError = 0;
+    temporaryCleanupError = 0;
+
+    directoryFd = openDirectoryNoSymlinks(parentPath);
+    fatal_if(directoryFd < 0, "%s: cannot securely open endpoint parent %s: %s",
+             name(), parentPath, std::strerror(errno));
+    struct stat directory = {};
+    fatal_if(::fstat(directoryFd, &directory) != 0 ||
+                 !S_ISDIR(directory.st_mode),
+             "%s: endpoint parent is not a directory", name());
+    fatal_if(directory.st_uid != ::geteuid() ||
+                 (directory.st_mode & (S_IRWXG | S_IRWXO)) != 0,
+             "%s: endpoint parent must be owned by euid %u with no group or "
+             "other permissions", name(), static_cast<unsigned>(::geteuid()));
+
+    lockFd = ::openat(directoryFd, lockName.c_str(),
+        O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600);
+    fatal_if(lockFd < 0, "%s: cannot open endpoint lock %s: %s", name(),
+             lockName, std::strerror(errno));
+    struct stat lock = {};
+    fatal_if(::fstat(lockFd, &lock) != 0 || !S_ISREG(lock.st_mode) ||
+                 lock.st_uid != ::geteuid() || (lock.st_mode & 0777) != 0600,
+             "%s: endpoint lock must be a same-euid 0600 regular file", name());
+    fatal_if(::flock(lockFd, LOCK_EX | LOCK_NB) != 0,
+             "%s: endpoint lock is held by another process", name());
+    struct stat lockPath = {};
+    fatal_if(::fstatat(directoryFd, lockName.c_str(), &lockPath,
+                      AT_SYMLINK_NOFOLLOW) != 0 ||
+                 !sameFile(lock, lockPath),
+             "%s: endpoint lock identity changed after acquisition", name());
+
+    const std::string trustedPath = "/proc/self/fd/" +
+        std::to_string(directoryFd) + "/" + endpointName;
+    sockaddr_un address;
+    socklen_t addressSize = 0;
+    fatal_if(!makeUnixAddress(trustedPath, address, addressSize),
+             "%s: endpoint basename is too long for secure AF_UNIX bind", name());
+
+    struct stat existing = {};
+    if (::fstatat(directoryFd, endpointName.c_str(), &existing,
+                  AT_SYMLINK_NOFOLLOW) == 0) {
+        fatal_if(!S_ISSOCK(existing.st_mode),
+                 "%s: existing endpoint is not a socket", name());
+        fatal_if(existing.st_uid != ::geteuid(),
+                 "%s: existing endpoint has a different owner", name());
+        const int probe = probeEndpoint(trustedPath);
+        fatal_if(probe != ECONNREFUSED,
+                 "%s: existing endpoint is live or cannot be proven stale: %s",
+                 name(), probe == 0 ? "live listener" : std::strerror(probe));
+        struct stat fresh = {};
+        fatal_if(::fstatat(directoryFd, endpointName.c_str(), &fresh,
+                          AT_SYMLINK_NOFOLLOW) != 0 ||
+                     !sameFile(existing, fresh),
+                 "%s: stale endpoint identity changed before removal", name());
+        fatal_if(::unlinkat(directoryFd, endpointName.c_str(), 0) != 0,
+                 "%s: cannot remove verified stale endpoint: %s", name(),
+                 std::strerror(errno));
+    } else {
+        fatal_if(errno != ENOENT, "%s: cannot inspect endpoint: %s", name(),
+                 std::strerror(errno));
+    }
+
+    int bindError = EADDRINUSE;
+    for (unsigned attempt = 0; attempt < 16; ++attempt) {
+        uint64_t nonce = 0;
+        fatal_if(!randomNonzero64(nonce),
+                 "%s: nonblocking getrandom unavailable for endpoint "
+                 "publication", name());
+        temporaryName = ".sagr-hostgpu-" + std::to_string(::getpid()) + "-" +
+            std::to_string(nonce);
+        const std::string temporaryPath = "/proc/self/fd/" +
+            std::to_string(directoryFd) + "/" + temporaryName;
+        fatal_if(!makeUnixAddress(temporaryPath, address, addressSize),
+                 "%s: temporary endpoint path exceeds AF_UNIX limits", name());
+
+        listenerFd = ::socket(AF_UNIX,
+            SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        fatal_if(listenerFd < 0,
+                 "%s: cannot create SOCK_SEQPACKET listener: %s", name(),
+                 std::strerror(errno));
+        if (::bind(listenerFd, reinterpret_cast<sockaddr *>(&address),
+                   addressSize) == 0) {
+            bindError = 0;
+            break;
+        }
+        bindError = errno;
+        ::close(listenerFd);
+        listenerFd = -1;
+        if (bindError != EADDRINUSE)
+            break;
+    }
+    fatal_if(bindError != 0,
+             "%s: cannot bind a private temporary endpoint: %s", name(),
+             std::strerror(bindError));
+    temporaryAliasPending = true;
+
+    struct stat boundBeforeChmod = {};
+    int validationError = 0;
+    if (::fstatat(directoryFd, temporaryName.c_str(), &boundBeforeChmod,
+                  AT_SYMLINK_NOFOLLOW) != 0) {
+        validationError = errno;
+    } else if (!S_ISSOCK(boundBeforeChmod.st_mode) ||
+               boundBeforeChmod.st_uid != ::geteuid()) {
+        validationError = ESTALE;
+    }
+    if (validationError != 0) {
+        abandonEndpointPreparation();
+        fatal("%s: temporary endpoint identity validation failed: %s", name(),
+              std::strerror(validationError));
+    }
+    endpointDevice = boundBeforeChmod.st_dev;
+    endpointInode = boundBeforeChmod.st_ino;
+    endpointPinFd = pinSocketAtNoFollow(
+        directoryFd, temporaryName, boundBeforeChmod);
+    if (endpointPinFd < 0) {
+        const int error = errno;
+        abandonEndpointPreparation();
+        fatal("%s: cannot pin bound endpoint identity: %s", name(),
+              std::strerror(error));
+    }
+    if (!chmodPinnedSocket(endpointPinFd, boundBeforeChmod, 0600)) {
+        const int error = errno;
+        abandonEndpointPreparation();
+        fatal("%s: cannot safely restrict endpoint permissions: %s", name(),
+              std::strerror(error));
+    }
+
+    struct stat bound = {};
+    if (::fstatat(directoryFd, temporaryName.c_str(), &bound,
+                  AT_SYMLINK_NOFOLLOW) != 0 ||
+        !sameFile(boundBeforeChmod, bound) || !S_ISSOCK(bound.st_mode) ||
+        bound.st_uid != ::geteuid() || (bound.st_mode & 0777) != 0600) {
+        abandonEndpointPreparation();
+        fatal("%s: bound endpoint failed identity validation", name());
+    }
+    endpointDevice = bound.st_dev;
+    endpointInode = bound.st_ino;
+
+    if (::listen(listenerFd,
+                 static_cast<int>(MaximumRegularClients +
+                                  MaximumExcessClients)) != 0) {
+        const int error = errno;
+        abandonEndpointPreparation();
+        fatal("%s: cannot listen on endpoint: %s", name(),
+              std::strerror(error));
+    }
+
+    struct stat freshLockPath = {};
+    if (::fstatat(directoryFd, lockName.c_str(), &freshLockPath,
+                  AT_SYMLINK_NOFOLLOW) != 0 ||
+        !sameFile(lock, freshLockPath)) {
+        abandonEndpointPreparation();
+        fatal("%s: endpoint lock identity changed before publication", name());
+    }
+
+    const SocketPublicationResult publication = publishSocketAtNoReplace(
+        directoryFd, temporaryName, endpointName, bound);
+    endpointAliasPending = publication.endpointMayExist;
+    temporaryAliasPending = publication.temporaryMayExist;
+    if (!temporaryAliasPending)
+        temporaryName.clear();
+    if (!publication.complete()) {
+        const int error = publication.error != 0 ? publication.error : EIO;
+        abandonEndpointPreparation();
+        fatal("%s: cannot atomically publish endpoint without replacement: %s",
+              name(), std::strerror(error));
+    }
+
+    struct stat published = {};
+    int publishedError = 0;
+    if (::fstatat(directoryFd, endpointName.c_str(), &published,
+                  AT_SYMLINK_NOFOLLOW) != 0) {
+        publishedError = errno;
+    } else if (!sameFile(bound, published) || !S_ISSOCK(published.st_mode) ||
+               published.st_uid != ::geteuid() ||
+               (published.st_mode & 0777) != 0600) {
+        publishedError = ESTALE;
+    }
+    if (publishedError != 0) {
+        abandonEndpointPreparation();
+        fatal("%s: published endpoint failed identity validation: %s", name(),
+              std::strerror(publishedError));
+    }
+
+    const int verificationFd = openDirectoryNoSymlinks(parentPath);
+    const int verificationOpenError = verificationFd < 0 ? errno : 0;
+    struct stat originalDirectory = {};
+    struct stat verificationDirectory = {};
+    int directoryError = verificationOpenError;
+    if (directoryError == 0 &&
+        ::fstat(directoryFd, &originalDirectory) != 0) {
+        directoryError = errno;
+    }
+    if (directoryError == 0 &&
+        ::fstat(verificationFd, &verificationDirectory) != 0) {
+        directoryError = errno;
+    }
+    if (verificationFd >= 0)
+        ::close(verificationFd);
+    if (directoryError == 0 &&
+        (originalDirectory.st_dev != verificationDirectory.st_dev ||
+         originalDirectory.st_ino != verificationDirectory.st_ino)) {
+        directoryError = ESTALE;
+    }
+    if (directoryError != 0) {
+        abandonEndpointPreparation();
+        fatal("%s: absolute endpoint parent changed before readiness: %s",
+              name(), std::strerror(directoryError));
+    }
+}
+
+void
+HostGPUBridge::abandonEndpointPreparation()
+{
+    if (listenerFd >= 0) {
+        ::close(listenerFd);
+        listenerFd = -1;
+    }
+    cleanupEndpointAliases();
+    if (!endpointAliasPending && !temporaryAliasPending) {
+        if (endpointPinFd >= 0) {
+            ::close(endpointPinFd);
+            endpointPinFd = -1;
+        }
+        endpointDevice = 0;
+        endpointInode = 0;
+    }
+}
+
+bool
+HostGPUBridge::cleanupEndpointAliases()
+{
+    if (!endpointAliasPending && !temporaryAliasPending)
+        return true;
+
+    if (directoryFd < 0) {
+        const int error = EBADF;
+        if (endpointAliasPending)
+            endpointCleanupError = error;
+        if (temporaryAliasPending)
+            temporaryCleanupError = error;
+        warn("%s: endpoint alias cleanup has no trusted directory: %s", name(),
+             std::strerror(error));
+        return false;
+    }
+
+    struct stat expected = {};
+    bool haveExpected = false;
+    if (endpointPinFd >= 0) {
+        if (::fstat(endpointPinFd, &expected) != 0) {
+            const int error = errno;
+            if (endpointAliasPending)
+                endpointCleanupError = error;
+            if (temporaryAliasPending)
+                temporaryCleanupError = error;
+            warn("%s: cannot inspect pinned endpoint during alias cleanup: %s",
+                 name(), std::strerror(error));
+            return false;
+        }
+        if (!S_ISSOCK(expected.st_mode) ||
+            (endpointInode != 0 &&
+             (expected.st_dev != endpointDevice ||
+              expected.st_ino != endpointInode))) {
+            if (endpointAliasPending)
+                endpointCleanupError = ESTALE;
+            if (temporaryAliasPending)
+                temporaryCleanupError = ESTALE;
+            warn("%s: pinned endpoint identity changed before alias cleanup",
+                 name());
+            return false;
+        }
+        haveExpected = true;
+    } else if (endpointInode != 0) {
+        expected.st_dev = endpointDevice;
+        expected.st_ino = endpointInode;
+        expected.st_uid = ::geteuid();
+        expected.st_mode = S_IFSOCK;
+        haveExpected = true;
+    }
+
+    const auto cleanupKnownAlias =
+        [this, &expected](const std::string &alias, bool &pending,
+                          int &lastError, const char *description) {
+            if (!pending)
+                return;
+            const SocketAliasCleanupResult result = retrySocketAliasCleanup(
+                MaximumAliasCleanupAttempts,
+                [this, &alias, &expected]() {
+                    return unlinkSocketAtIfMatches(
+                        directoryFd, alias, expected);
+                });
+            switch (result.status) {
+              case SocketAliasCleanupStatus::Removed:
+              case SocketAliasCleanupStatus::Missing:
+                pending = false;
+                lastError = 0;
+                break;
+              case SocketAliasCleanupStatus::IdentityMismatch:
+                pending = false;
+                lastError = result.error;
+                warn("%s: %s identity changed before cleanup; leaving pathname "
+                     "untouched", name(), description);
+                break;
+              case SocketAliasCleanupStatus::Error:
+                lastError = result.error;
+                warn("%s: could not remove %s during cleanup: %s", name(),
+                     description, std::strerror(result.error));
+                break;
+            }
+        };
+
+    if (endpointAliasPending) {
+        if (haveExpected) {
+            cleanupKnownAlias(endpointName, endpointAliasPending,
+                              endpointCleanupError, "published endpoint");
+        } else {
+            endpointCleanupError = EBADF;
+            warn("%s: cannot identify published endpoint during cleanup", name());
+        }
+    }
+
+    if (temporaryAliasPending) {
+        if (haveExpected) {
+            cleanupKnownAlias(temporaryName, temporaryAliasPending,
+                              temporaryCleanupError, "temporary endpoint");
+        } else {
+            const SocketAliasCleanupResult result = retrySocketAliasCleanup(
+                MaximumAliasCleanupAttempts,
+                [this]() {
+                    if (::unlinkat(
+                            directoryFd, temporaryName.c_str(), 0) == 0) {
+                        return SocketAliasCleanupResult{
+                            SocketAliasCleanupStatus::Removed, 0};
+                    }
+                    if (errno == ENOENT) {
+                        return SocketAliasCleanupResult{
+                            SocketAliasCleanupStatus::Missing, 0};
+                    }
+                    return SocketAliasCleanupResult{
+                        SocketAliasCleanupStatus::Error, errno};
+                });
+            if (result.status == SocketAliasCleanupStatus::Removed ||
+                result.status == SocketAliasCleanupStatus::Missing) {
+                temporaryAliasPending = false;
+                temporaryCleanupError = 0;
+            } else {
+                temporaryCleanupError = result.error;
+                warn("%s: could not remove unpinned temporary endpoint during "
+                     "cleanup: %s", name(),
+                     std::strerror(temporaryCleanupError));
+            }
+        }
+    }
+    if (!temporaryAliasPending)
+        temporaryName.clear();
+    return !endpointAliasPending && !temporaryAliasPending;
+}
+
+void
+HostGPUBridge::shutdown()
+{
+    if (shutdownDone && endpointCleanupDone)
+        return;
+    if (!shutdownDone) {
+        shutdownDone = true;
+        if (recordServiceEvent.scheduled())
+            deschedule(recordServiceEvent);
+        listenEvent.reset();
+        clients.clear();
+        admissionBudget.reset();
+        pendingRecords.clear();
+    }
+    endpointCleanupDone = cleanupEndpoint();
+}
+
+bool
+HostGPUBridge::cleanupEndpoint()
+{
+    if (listenerFd >= 0) {
+        ::close(listenerFd);
+        listenerFd = -1;
+    }
+    if (!cleanupEndpointAliases()) {
+        warn("%s: endpoint alias cleanup remains pending; retaining the inode "
+             "pin, trusted directory, and endpoint lock for a later retry",
+             name());
+        return false;
+    }
+    if (endpointPinFd >= 0) {
+        ::close(endpointPinFd);
+        endpointPinFd = -1;
+    }
+    endpointDevice = 0;
+    endpointInode = 0;
+    if (lockFd >= 0) {
+        ::close(lockFd);
+        lockFd = -1;
+    }
+    if (directoryFd >= 0) {
+        ::close(directoryFd);
+        directoryFd = -1;
+    }
+    return true;
+}
+
+void
+HostGPUBridge::scheduleListenerService(int revents)
+{
+    auto *event = new EventFunctionWrapper(
+        [this, revents]() { serviceListener(revents); },
+        name() + ".host_gpu_listener_service", true);
+    schedule(event, curTick());
+}
+
+void
+HostGPUBridge::serviceListener(int revents)
+{
+    if (shutdownDone)
+        return;
+    if (revents & (POLLERR | POLLHUP | POLLNVAL))
+        fatal("%s: host GPU listener failed", name());
+    if (revents & POLLIN)
+        acceptClients();
+}
+
+void
+HostGPUBridge::scheduleClientService(
+    int fd, uint64_t generation, int revents)
+{
+    auto *event = new EventFunctionWrapper(
+        [this, fd, generation, revents]() {
+            serviceClient(fd, generation, revents);
+        },
+        name() + ".host_gpu_client_service", true);
+    schedule(event, curTick());
+}
+
+void
+HostGPUBridge::serviceClient(int fd, uint64_t generation, int revents)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
+        return;
+
+    if (revents & POLLIN) {
+        receiveRecords(fd);
+        processRecords();
+    }
+    found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
+        return;
+    if (revents & POLLOUT)
+        flushClient(fd);
+    found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
+        return;
+    if ((revents & (POLLERR | POLLHUP | POLLNVAL)) &&
+        !found->second->state.recordPending() &&
+        found->second->outbound.empty()) {
+        closeClient(fd);
+    }
+}
+
+void
+HostGPUBridge::scheduleDeadlineService(
+    int fd, uint64_t generation, int revents)
+{
+    auto *event = new EventFunctionWrapper(
+        [this, fd, generation, revents]() {
+            serviceDeadline(fd, generation, revents);
+        },
+        name() + ".host_gpu_deadline_service", true, Event::Minimum_Pri);
+    schedule(event, curTick());
+}
+
+void
+HostGPUBridge::serviceDeadline(
+    int fd, uint64_t generation, int revents)
+{
+    if (revents & (POLLIN | POLLERR | POLLHUP | POLLNVAL))
+        expireClient(fd, generation);
+}
+
+void
+HostGPUBridge::acceptClients()
+{
+    for (size_t accepted = 0; accepted < MaximumAcceptsPerWakeup; ++accepted) {
+        const int fd = ::accept4(listenerFd, nullptr, nullptr,
+                                 SOCK_NONBLOCK | SOCK_CLOEXEC);
+        if (fd < 0) {
+            if (errno == EINTR)
+                continue;
+            if (errno == EAGAIN || errno == EWOULDBLOCK)
+                return;
+            fatal("%s: accept4 failed: %s", name(), std::strerror(errno));
+        }
+        struct ucred credentials = {};
+        socklen_t credentialSize = sizeof(credentials);
+        if (::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials,
+                         &credentialSize) != 0 ||
+            credentialSize != sizeof(credentials) ||
+            credentials.uid != ::geteuid()) {
+            ::close(fd);
+            continue;
+        }
+
+        const ClientAdmission admission = admissionBudget.acquire();
+        if (admission == ClientAdmission::Rejected) {
+            ::close(fd);
+            continue;
+        }
+
+        const int timerFd = ::timerfd_create(
+            CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC);
+        if (timerFd < 0) {
+            warn("%s: timerfd_create failed for accepted host GPU client: %s",
+                 name(), std::strerror(errno));
+            admissionBudget.release(admission);
+            ::close(fd);
+            continue;
+        }
+        itimerspec timer = {};
+        timer.it_value = monotonicDeadline(handshakeTimeoutMs);
+        if (::timerfd_settime(timerFd, TFD_TIMER_ABSTIME, &timer, nullptr) != 0) {
+            warn("%s: timerfd_settime failed for accepted host GPU client: %s",
+                 name(), std::strerror(errno));
+            admissionBudget.release(admission);
+            ::close(timerFd);
+            ::close(fd);
+            continue;
+        }
+
+        auto client = std::make_unique<Client>();
+        client->fd = fd;
+        client->timerFd = timerFd;
+        client->generation = nextClientGeneration++;
+        if (nextClientGeneration == 0)
+            ++nextClientGeneration;
+        client->uid = credentials.uid;
+        client->gid = credentials.gid;
+        client->pid = credentials.pid;
+        client->admission = admission;
+        client->socketEvent = std::make_unique<ClientEvent>(
+            *this, fd, client->generation);
+        client->deadlineEvent = std::make_unique<DeadlineEvent>(
+            *this, timerFd, fd, client->generation);
+        Client *clientPointer = client.get();
+        clients.emplace(fd, std::move(client));
+        pollQueue.schedule(clientPointer->socketEvent.get());
+        pollQueue.schedule(clientPointer->deadlineEvent.get());
+    }
+}
+
+void
+HostGPUBridge::receiveRecords(int fd)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || !found->second->state.canReceive())
+        return;
+    const uint64_t generation = found->second->generation;
+
+    for (size_t attempt = 0; attempt < MaximumRecordsPerWakeup; ++attempt) {
+        std::vector<uint8_t> bytes(maximumRecord);
+        std::array<uint8_t, CMSG_SPACE(sizeof(int) * 4)> control = {};
+        iovec vector = {bytes.data(), bytes.size()};
+        msghdr message = {};
+        message.msg_iov = &vector;
+        message.msg_iovlen = 1;
+        message.msg_control = control.data();
+        message.msg_controllen = control.size();
+        const ssize_t received = ::recvmsg(
+            fd, &message, MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+        if (received < 0) {
+            if (errno == EINTR)
+                continue;
+            if (errno == EAGAIN || errno == EWOULDBLOCK)
+                return;
+            scheduleClientClose(fd, generation);
+            return;
+        }
+        closeReceivedFileDescriptors(message);
+        if (received == 0 || (message.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) ||
+            message.msg_controllen != 0) {
+            scheduleClientClose(fd, generation);
+            return;
+        }
+        if (pendingRecords.size() >= MaximumPendingRecords) {
+            scheduleClientClose(fd, generation);
+            return;
+        }
+        bytes.resize(static_cast<size_t>(received));
+        found = clients.find(fd);
+        if (found == clients.end() || found->second->generation != generation ||
+            !found->second->state.canReceive()) {
+            return;
+        }
+        found->second->state.noteRecordReceived();
+        pendingRecords.push_back({fd, generation, std::move(bytes)});
+        scheduleRecordService();
+        return;
+    }
+    scheduleClientClose(fd, generation);
+}
+
+void
+HostGPUBridge::expireClient(int fd, uint64_t generation)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation ||
+        !found->second->state.handshakeDeadlineApplies()) {
+        return;
+    }
+    inform("host-gpu-timeout fd=%d generation=%llu", fd,
+           static_cast<unsigned long long>(generation));
+    closeClient(fd);
+}
+
+void
+HostGPUBridge::scheduleClientClose(int fd, uint64_t generation)
+{
+    auto *event = new EventFunctionWrapper(
+        [this, fd, generation]() {
+            auto found = clients.find(fd);
+            if (found != clients.end() &&
+                found->second->generation == generation) {
+                closeClient(fd);
+            }
+        },
+        name() + ".host_gpu_close", true);
+    schedule(event, curTick());
+}
+
+void
+HostGPUBridge::closeClient(int fd)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end())
+        return;
+    found->second->state.close();
+    if (activeClientFd == fd)
+        activeClientFd = -1;
+    admissionBudget.release(found->second->admission);
+    clients.erase(found);
+    pendingRecords.erase(std::remove_if(
+        pendingRecords.begin(), pendingRecords.end(),
+        [fd](const PendingRecord &record) { return record.clientFd == fd; }),
+        pendingRecords.end());
+}
+
+void
+HostGPUBridge::scheduleRecordService()
+{
+    if (!recordServiceEvent.scheduled())
+        schedule(recordServiceEvent, curTick());
+}
+
+void
+HostGPUBridge::processRecords()
+{
+    size_t processed = 0;
+    while (!pendingRecords.empty() && processed++ < MaximumPendingRecords) {
+        PendingRecord record = std::move(pendingRecords.front());
+        pendingRecords.pop_front();
+
+        auto found = clients.find(record.clientFd);
+        if (found == clients.end() ||
+            found->second->generation != record.generation) {
+            continue;
+        }
+        Client &client = *found->second;
+        const auto decoded = protocol::decodeHelloRecord(
+            record.bytes.data(), record.bytes.size(), maximumRecord);
+        if (decoded.action == protocol::DecodeAction::Drop) {
+            if (decoded.closeConnection)
+                closeClient(record.clientFd);
+            continue;
+        } else {
+            protocol::Status status = preNegotiationStatus(
+                client.state, sessionEstablished && activeClientFd < 0,
+                decoded.status);
+            protocol::NegotiationResult negotiation;
+            if (status == protocol::Status::Ok) {
+                protocol::NegotiationContext context;
+                context.busy = activeClientFd >= 0 &&
+                    activeClientFd != record.clientFd;
+                context.resourceExhausted =
+                    client.admission == ClientAdmission::ResourceLimited;
+                negotiation = protocol::negotiate(
+                    decoded.header, decoded.hello, identity, context);
+                status = negotiation.status;
+            }
+
+            protocol::Ack ack;
+            ack.status = status;
+            ack.clientNonce = decoded.hello.clientNonce;
+            uint64_t connectionId = 0;
+            if (status == protocol::Status::Ok) {
+                protocol::Nonce serverNonce = {};
+                bool randomReady = randomNonzeroUuid(serverNonce);
+                for (unsigned attempt = 0;
+                     randomReady && attempt < 16; ++attempt) {
+                    randomReady = randomNonzero64(connectionId);
+                    if (!randomReady ||
+                        usedConnectionIds.insert(connectionId).second) {
+                        break;
+                    }
+                    connectionId = 0;
+                }
+                if (connectionId == 0)
+                    randomReady = false;
+                if (!randomReady) {
+                    status = protocol::Status::Internal;
+                    ack.status = status;
+                } else {
+                    ack.selectedMajor = negotiation.selectedMajor;
+                    ack.selectedMinor = negotiation.selectedMinor;
+                    ack.serverNonce = serverNonce;
+                    ack.selected = negotiation.selected;
+                    ack.maximumRecord = negotiation.maximumRecord;
+                    ack.topology.jobUuid = identity.jobUuid;
+                    ack.topology.rank = identity.rank;
+                    ack.topology.worldSize = identity.worldSize;
+                }
+            }
+            const auto response = protocol::encodeAck(
+                decoded.header, ack, identity, connectionId);
+            const bool success = status == protocol::Status::Ok;
+            client.state.beginAck(success);
+            cancelDeadline(client);
+            client.socketEvent->setReadable(false);
+            if (success)
+                activeClientFd = record.clientFd;
+            sendAck(record.clientFd, record.generation, response, status,
+                    success);
+        }
+    }
+    if (!pendingRecords.empty())
+        scheduleRecordService();
+}
+
+void
+HostGPUBridge::sendAck(int fd, uint64_t generation,
+                       std::vector<uint8_t> record,
+                       protocol::Status status, bool success)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
+        return;
+    Client &client = *found->second;
+    if (!client.outbound.empty()) {
+        closeClient(fd);
+        return;
+    }
+    client.outbound = std::move(record);
+    client.outboundStatus = status;
+    client.outboundSuccess = success;
+    flushClient(fd);
+}
+
+void
+HostGPUBridge::flushClient(int fd)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end())
+        return;
+    Client &client = *found->second;
+    if (client.outbound.empty())
+        return;
+    const ssize_t sent = ::send(fd, client.outbound.data(),
+                                client.outbound.size(), MSG_NOSIGNAL);
+    if (sent < 0) {
+        if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) {
+            client.socketEvent->setWritable(true);
+            return;
+        }
+        closeClient(fd);
+        return;
+    }
+    if (static_cast<size_t>(sent) != client.outbound.size()) {
+        closeClient(fd);
+        return;
+    }
+
+    client.outbound.clear();
+    client.socketEvent->setWritable(false);
+    completeAck(fd, client.generation);
+}
+
+void
+HostGPUBridge::completeAck(int fd, uint64_t generation)
+{
+    auto found = clients.find(fd);
+    if (found == clients.end() || found->second->generation != generation)
+        return;
+    Client &client = *found->second;
+    const protocol::Status status = client.outboundStatus;
+    const bool success = client.outboundSuccess;
+    client.state.noteAckSent();
+    inform("host-gpu-handshake status=%s fd=%d generation=%llu",
+           protocol::statusName(status), fd,
+           static_cast<unsigned long long>(generation));
+    if (!success) {
+        closeClient(fd);
+        return;
+    }
+    sessionEstablished = true;
+    activeClientFd = fd;
+    client.socketEvent->setReadable(true);
+    if (exitOnHandshake)
+        exitSimLoop("host GPU transport handshake complete");
+}
+
+void
+HostGPUBridge::cancelDeadline(Client &client)
+{
+    client.deadlineEvent.reset();
+    if (client.timerFd >= 0) {
+        ::close(client.timerFd);
+        client.timerFd = -1;
+    }
+}
+
+void
+HostGPUBridge::boundedStartupWait()
+{
+    if (startupTimeoutMs == 0)
+        return;
+    const timespec deadline = monotonicDeadline(startupTimeoutMs);
+    while (pendingRecords.empty()) {
+        std::vector<pollfd> descriptors;
+        descriptors.push_back({listenerFd, POLLIN, 0});
+        struct StartupDescriptor
+        {
+            int fd;
+            uint64_t generation;
+            bool deadline;
+        };
+        std::vector<StartupDescriptor> clientDescriptors;
+        for (const auto &[fd, client] : clients) {
+            descriptors.push_back({fd, POLLIN, 0});
+            clientDescriptors.push_back({fd, client->generation, false});
+            descriptors.push_back({client->timerFd, POLLIN, 0});
+            clientDescriptors.push_back({fd, client->generation, true});
+        }
+        int ready = -1;
+        while (ready < 0) {
+            const int remaining = millisecondsRemaining(deadline);
+            fatal_if(remaining == 0,
+                     "%s: startup_timeout_ms expired before a complete host "
+                     "GPU record arrived", name());
+            ready = ::poll(descriptors.data(), descriptors.size(), remaining);
+            if (ready < 0 && errno == EINTR)
+                continue;
+            break;
+        }
+        fatal_if(ready == 0,
+                 "%s: startup_timeout_ms expired before a complete host GPU "
+                 "record arrived", name());
+        fatal_if(ready < 0, "%s: startup poll failed: %s", name(),
+                 std::strerror(errno));
+
+        if (descriptors[0].revents & POLLIN)
+            acceptClients();
+        for (size_t index = 1; index < descriptors.size(); ++index) {
+            const auto [fd, generation, deadlineReady] =
+                clientDescriptors[index - 1];
+            if (deadlineReady && descriptors[index].revents != 0)
+                expireClient(fd, generation);
+        }
+        for (size_t index = 1; index < descriptors.size(); ++index) {
+            const auto [fd, generation, deadlineReady] =
+                clientDescriptors[index - 1];
+            if (descriptors[index].revents == 0)
+                continue;
+            if (!deadlineReady) {
+                if (descriptors[index].revents & POLLIN)
+                    receiveRecords(fd);
+                if (descriptors[index].revents &
+                    (POLLERR | POLLHUP | POLLNVAL)) {
+                    auto found = clients.find(fd);
+                    if (found != clients.end() &&
+                        found->second->generation == generation) {
+                        closeClient(fd);
+                    }
+                }
+            }
+        }
+    }
+}
+
+bool
+HostGPUBridge::randomNonzero64(uint64_t &value)
+{
+    for (unsigned attempt = 0; attempt < 8; ++attempt) {
+        value = 0;
+        size_t offset = 0;
+        unsigned interruptions = 0;
+        while (offset < sizeof(value)) {
+            const ssize_t result = ::getrandom(
+                reinterpret_cast<uint8_t *>(&value) + offset,
+                sizeof(value) - offset, GRND_NONBLOCK);
+            if (result < 0 && errno == EINTR && interruptions++ < 16)
+                continue;
+            if (result <= 0)
+                return false;
+            offset += static_cast<size_t>(result);
+        }
+        if (value != 0)
+            return true;
+    }
+    return false;
+}
+
+bool
+HostGPUBridge::randomNonzeroUuid(protocol::Uuid &value)
+{
+    for (unsigned attempt = 0; attempt < 8; ++attempt) {
+        value.fill(0);
+        size_t offset = 0;
+        unsigned interruptions = 0;
+        while (offset < value.size()) {
+            const ssize_t result = ::getrandom(
+                value.data() + offset, value.size() - offset, GRND_NONBLOCK);
+            if (result < 0 && errno == EINTR && interruptions++ < 16)
+                continue;
+            if (result <= 0)
+                return false;
+            offset += static_cast<size_t>(result);
+        }
+        if (!protocol::isZero(value))
+            return true;
+    }
+    return false;
+}
+
+} // namespace hostgpu
+} // namespace gem5

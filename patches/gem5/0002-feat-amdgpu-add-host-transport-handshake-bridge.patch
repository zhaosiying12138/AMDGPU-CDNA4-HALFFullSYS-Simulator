+
+constexpr std::array<uint8_t, 8> Magic = {
+    'G', 'S', 'I', 'M', 'R', 'P', 'C', 0
+};
+constexpr size_t CrcOffset = 64;
+constexpr size_t TopologyValueBytes = 24;
+
+uint16_t
+load16(const uint8_t *data)
+{
+    return (static_cast<uint16_t>(data[0]) << 8) |
+           static_cast<uint16_t>(data[1]);
+}
+
+uint32_t
+load32(const uint8_t *data)
+{
+    return (static_cast<uint32_t>(data[0]) << 24) |
+           (static_cast<uint32_t>(data[1]) << 16) |
+           (static_cast<uint32_t>(data[2]) << 8) |
+           static_cast<uint32_t>(data[3]);
+}
+
+uint64_t
+load64(const uint8_t *data)
+{
+    uint64_t value = 0;
+    for (size_t index = 0; index < sizeof(value); ++index)
+        value = (value << 8) | data[index];
+    return value;
+}
+
+void
+store16(std::vector<uint8_t> &data, size_t offset, uint16_t value)
+{
+    data[offset] = static_cast<uint8_t>(value >> 8);
+    data[offset + 1] = static_cast<uint8_t>(value);
+}
+
+void
+store32(std::vector<uint8_t> &data, size_t offset, uint32_t value)
+{
+    data[offset] = static_cast<uint8_t>(value >> 24);
+    data[offset + 1] = static_cast<uint8_t>(value >> 16);
+    data[offset + 2] = static_cast<uint8_t>(value >> 8);
+    data[offset + 3] = static_cast<uint8_t>(value);
+}
+
+void
+store64(std::vector<uint8_t> &data, size_t offset, uint64_t value)
+{
+    for (size_t index = 0; index < sizeof(value); ++index) {
+        data[offset + sizeof(value) - index - 1] =
+            static_cast<uint8_t>(value);
+        value >>= 8;
+    }
+}
+
+template <size_t N>
+void
+storeBytes(std::vector<uint8_t> &data, size_t offset,
+           const std::array<uint8_t, N> &value)
+{
+    std::copy(value.begin(), value.end(), data.begin() + offset);
+}
+
+template <size_t N>
+std::array<uint8_t, N>
+loadBytes(const uint8_t *data)
+{
+    std::array<uint8_t, N> value;
+    std::copy(data, data + N, value.begin());
+    return value;
+}
+
+bool
+versionOrdered(const Hello &hello)
+{
+    return std::make_pair(hello.minimumMajor, hello.minimumMinor) <=
+           std::make_pair(hello.maximumMajor, hello.maximumMinor);
+}
+
+void
+appendTlv(std::vector<uint8_t> &payload, uint16_t type, uint16_t flags,
+          const uint8_t *value, size_t valueSize)
+{
+    const size_t start = payload.size();
+    const size_t unpadded = 8 + valueSize;
+    const size_t padded = (unpadded + 7) & ~size_t(7);
+    payload.resize(start + padded, 0);
+    store16(payload, start, type);
+    store16(payload, start + 2, flags);
+    store32(payload, start + 4, static_cast<uint32_t>(valueSize));
+    if (valueSize != 0)
+        std::copy(value, value + valueSize, payload.begin() + start + 8);
+}
+
+void
+appendTopology(std::vector<uint8_t> &payload, const Topology &topology)
+{
+    std::array<uint8_t, TopologyValueBytes> value = {};
+    std::copy(topology.jobUuid.begin(), topology.jobUuid.end(), value.begin());
+    std::vector<uint8_t> encoded(value.begin(), value.end());
+    store32(encoded, 16, topology.rank);
+    store32(encoded, 20, topology.worldSize);
+    appendTlv(payload, TopologyTlvType, CriticalTlvFlag,
+              encoded.data(), encoded.size());
+}
+
+std::vector<uint8_t>
+encodeFrame(const Header &header, const std::vector<uint8_t> &payload)
+{
+    std::vector<uint8_t> frame(HeaderBytes + payload.size(), 0);
+    std::copy(Magic.begin(), Magic.end(), frame.begin());
+    store16(frame, 8, 1);
+    store16(frame, 10, 0);
+    store16(frame, 12, HeaderBytes);
+    store16(frame, 14, static_cast<uint16_t>(header.messageType));
+    store32(frame, 16, 0);
+    store32(frame, 20, static_cast<uint32_t>(payload.size()));
+    store64(frame, 24, header.requestId);
+    storeBytes(frame, 32, header.daemonUuid);
+    store64(frame, 48, header.connectionId);
+    store64(frame, 56, header.jobEpoch);
+    std::copy(payload.begin(), payload.end(), frame.begin() + HeaderBytes);
+    store32(frame, CrcOffset, crc32c(frame.data(), frame.size()));
+    return frame;
+}
+
+DecodeResult
+drop(const std::string &reason, bool closeConnection = true)
+{
+    DecodeResult result;
+    result.action = DecodeAction::Drop;
+    result.closeConnection = closeConnection;
+    result.reason = reason;
+    return result;
+}
+
+DecodeResult
+acknowledge(Status status, const std::string &reason,
+            const Header &header, const Hello &hello, bool hasHello = true)
+{
+    DecodeResult result;
+    result.action = DecodeAction::Acknowledge;
+    result.status = status;
+    result.reason = reason;
+    result.header = header;
+    result.hello = hello;
+    result.hasHello = hasHello;
+    return result;
+}
+
+bool
+parseTlvs(const uint8_t *data, size_t size, Hello &hello,
+          Status &failure, std::string &reason)
+{
+    std::set<uint16_t> seen;
+    size_t offset = 0;
+    hello.hasTopology = false;
+
+    while (offset < size) {
+        if (size - offset < 8) {
+            failure = Status::Malformed;
+            reason = "truncated TLV header";
+            return false;
+        }
+
+        const uint16_t type = load16(data + offset);
+        const uint16_t flags = load16(data + offset + 2);
+        const uint32_t valueSize = load32(data + offset + 4);
+        if ((flags & ~CriticalTlvFlag) != 0) {
+            failure = Status::Malformed;
+            reason = "invalid TLV flags";
+            return false;
+        }
+        if (!seen.insert(type).second) {
+            failure = Status::Malformed;
+            reason = "duplicate TLV type";
+            return false;
+        }
+
+        const size_t valueOffset = offset + 8;
+        if (valueSize > size - valueOffset) {
+            failure = Status::Malformed;
+            reason = "truncated TLV value";
+            return false;
+        }
+        const size_t valueEnd = valueOffset + valueSize;
+        if (valueEnd > std::numeric_limits<size_t>::max() - 7) {
+            failure = Status::Malformed;
+            reason = "TLV length overflow";
+            return false;
+        }
+        const size_t paddedEnd = (valueEnd + 7) & ~size_t(7);
+        if (paddedEnd > size) {
+            failure = Status::Malformed;
+            reason = "truncated TLV padding";
+            return false;
+        }
+        if (std::any_of(data + valueEnd, data + paddedEnd,
+                        [](uint8_t byte) { return byte != 0; })) {
+            failure = Status::Malformed;
+            reason = "nonzero TLV padding";
+            return false;
+        }
+
+        if (type == TopologyTlvType) {
+            if (flags != CriticalTlvFlag || valueSize != TopologyValueBytes) {
+                failure = Status::Malformed;
+                reason = "malformed topology TLV";
+                return false;
+            }
+            hello.topology.jobUuid = loadBytes<UuidBytes>(data + valueOffset);
+            hello.topology.rank = load32(data + valueOffset + 16);
+            hello.topology.worldSize = load32(data + valueOffset + 20);
+            hello.hasTopology = true;
+        } else if ((flags & CriticalTlvFlag) != 0) {
+            hello.unknownCriticalTlv = true;
+        } else {
+            Tlv tlv;
+            tlv.type = type;
+            tlv.flags = flags;
+            tlv.value.assign(data + valueOffset, data + valueEnd);
+            hello.optionalTlvs.push_back(std::move(tlv));
+        }
+        offset = paddedEnd;
+    }
+
+    return true;
+}
+
+} // anonymous namespace
+
+bool
+isZero(const Uuid &value)
+{
+    return std::all_of(value.begin(), value.end(),
+                       [](uint8_t byte) { return byte == 0; });
+}
+
+bool
+parseUuid(const std::string &text, Uuid &value)
+{
+    std::string hex;
+    if (text.size() == 32) {
+        hex = text;
+    } else if (text.size() == 36) {
+        constexpr std::array<size_t, 4> hyphens = {8, 13, 18, 23};
+        for (size_t index = 0; index < text.size(); ++index) {
+            if (std::find(hyphens.begin(), hyphens.end(), index) !=
+                    hyphens.end()) {
+                if (text[index] != '-')
+                    return false;
+            } else {
+                hex.push_back(text[index]);
+            }
+        }
+    } else {
+        return false;
+    }
+
+    auto digit = [](char character) -> int {
+        if (character >= '0' && character <= '9')
+            return character - '0';
+        if (character >= 'a' && character <= 'f')
+            return character - 'a' + 10;
+        if (character >= 'A' && character <= 'F')
+            return character - 'A' + 10;
+        return -1;
+    };
+    for (size_t index = 0; index < value.size(); ++index) {
+        const int high = digit(hex[index * 2]);
+        const int low = digit(hex[index * 2 + 1]);
+        if (high < 0 || low < 0)
+            return false;
+        value[index] = static_cast<uint8_t>((high << 4) | low);
+    }
+    return true;
+}
+
+std::string
+formatUuid(const Uuid &value)
+{
+    std::ostringstream stream;
+    stream << std::hex << std::setfill('0');
+    for (uint8_t byte : value)
+        stream << std::setw(2) << static_cast<unsigned>(byte);
+    return stream.str();
+}
+
+Capabilities
+topologyCapability()
+{
+    Capabilities capabilities = {};
+    capabilities[0] = 1;
+    return capabilities;
+}
+
+bool
+capabilitySubset(const Capabilities &subset, const Capabilities &superset)
+{
+    for (size_t index = 0; index < subset.size(); ++index) {
+        if ((subset[index] & ~superset[index]) != 0)
+            return false;
+    }
+    return true;
+}
+
+uint32_t
+crc32c(const uint8_t *data, size_t size)
+{
+    uint32_t crc = 0xffffffffU;
+    for (size_t index = 0; index < size; ++index) {
+        uint8_t byte = data[index];
+        if (index >= CrcOffset && index < CrcOffset + sizeof(uint32_t))
+            byte = 0;
+        crc ^= byte;
+        for (unsigned bit = 0; bit < 8; ++bit) {
+            const uint32_t mask = 0U - (crc & 1U);
+            crc = (crc >> 1) ^ (0x82f63b78U & mask);
+        }
+    }
+    return crc ^ 0xffffffffU;
+}
+
+DecodeResult
+decodeHelloRecord(const uint8_t *record, size_t size,
+                  uint32_t configuredMaximum)
+{
+    if (record == nullptr || size < HeaderBytes ||
+        size > MaximumRecordBytes || size > MaximumHandshakeBytes ||
+        size > configuredMaximum) {
+        return drop("record size");
+    }
+    if (!std::equal(Magic.begin(), Magic.end(), record) ||
+        load16(record + 8) != 1 || load16(record + 10) != 0) {
+        return drop("framing");
+    }
+    if (load16(record + 12) != HeaderBytes ||
+        load32(record + 20) != size - HeaderBytes) {
+        return drop("record length");
+    }
+
+    const uint16_t rawType = load16(record + 14);
+    if ((rawType != static_cast<uint16_t>(MessageType::Hello) &&
+         rawType != static_cast<uint16_t>(MessageType::HelloAck)) ||
+        load32(record + 16) != 0) {
+        return drop("message type or flags");
+    }
+
+    Header header;
+    header.messageType = static_cast<MessageType>(rawType);
+    header.requestId = load64(record + 24);
+    header.daemonUuid = loadBytes<UuidBytes>(record + 32);
+    header.connectionId = load64(record + 48);
+    header.jobEpoch = load64(record + 56);
+    if (header.requestId == 0 || load32(record + 68) != 0 ||
+        load64(record + 72) != 0) {
+        return drop("request or reserved field");
+    }
+    if (crc32c(record, size) != load32(record + CrcOffset))
+        return drop("CRC32C");
+
+    const uint8_t *payload = record + HeaderBytes;
+    const size_t payloadSize = size - HeaderBytes;
+    if (header.messageType != MessageType::Hello)
+        return drop("expected HELLO");
+    if (header.connectionId != 0)
+        return drop("HELLO connection ID");
+    if (payloadSize < HelloFixedBytes)
+        return drop("uncorrelatable short HELLO");
+
+    Hello hello;
+    hello.minimumMajor = load16(payload);
+    hello.minimumMinor = load16(payload + 2);
+    hello.maximumMajor = load16(payload + 4);
+    hello.maximumMinor = load16(payload + 6);
+    hello.clientNonce = loadBytes<UuidBytes>(payload + 8);
+    hello.offered = loadBytes<CapabilityBytes>(payload + 24);
+    hello.required = loadBytes<CapabilityBytes>(payload + 56);
+    hello.receiveMaximum = load32(payload + 88);
+    const uint16_t role = load16(payload + 92);
+    const uint16_t reserved = load16(payload + 94);
+
+    if (isZero(hello.clientNonce))
+        return drop("zero client nonce");
+
+    if (role != RuntimeRole || reserved != 0 ||
+        hello.receiveMaximum < MinimumRecordBytes ||
+        hello.receiveMaximum > MaximumRecordBytes || !versionOrdered(hello) ||
+        !capabilitySubset(hello.required, hello.offered)) {
+        return acknowledge(Status::Malformed, "invalid HELLO fixed fields",
+                           header, hello);
+    }
+
+    Status tlvStatus = Status::Malformed;
+    std::string tlvReason;
+    if (!parseTlvs(payload + HelloFixedBytes,
+                   payloadSize - HelloFixedBytes, hello,
+                   tlvStatus, tlvReason)) {
+        return acknowledge(tlvStatus, tlvReason, header, hello);
+    }
+    const bool topologyOffered = (hello.offered[0] & 1) != 0;
+    if (hello.hasTopology != topologyOffered) {
+        return acknowledge(Status::Malformed,
+                           "topology TLV/capability mismatch", header, hello);
+    }
+    return acknowledge(Status::Ok, "valid HELLO", header, hello);
+}
+
+NegotiationResult
+negotiate(const Header &header, const Hello &hello,
+          const ServerIdentity &server, const NegotiationContext &context)
+{
+    NegotiationResult result;
+    result.maximumRecord = std::min(server.maximumRecord,
+                                    hello.receiveMaximum);
+    if (result.maximumRecord < MinimumRecordBytes ||
+        result.maximumRecord > MaximumRecordBytes) {
+        result.maximumRecord = MinimumRecordBytes;
+    }
+
+    if (!capabilitySubset(hello.required, hello.offered)) {
+        result.status = Status::Malformed;
+        return result;
+    }
+    constexpr auto implemented = std::make_pair(uint16_t(1), uint16_t(0));
+    if (std::make_pair(hello.minimumMajor, hello.minimumMinor) > implemented ||
+        implemented >
+            std::make_pair(hello.maximumMajor, hello.maximumMinor)) {
+        result.status = Status::UnsupportedVersion;
+        return result;
+    }
+
+    for (size_t index = 0; index < result.selected.size(); ++index)
+        result.selected[index] = hello.offered[index] & server.supported[index];
+    if (hello.unknownCriticalTlv ||
+        !capabilitySubset(hello.required, result.selected) ||
+        (hello.offered[0] & 1) == 0 ||
+        (hello.required[0] & 1) == 0 ||
+        (result.selected[0] & 1) == 0) {
+        result.selected.fill(0);
+        result.status = Status::UnsupportedCapability;
+        return result;
+    }
+    if (!isZero(header.daemonUuid) && header.daemonUuid != server.daemonUuid) {
+        result.selected.fill(0);
+        result.status = Status::InstanceMismatch;
+        return result;
+    }
+
+    const bool topologyWildcard = isZero(hello.topology.jobUuid) &&
+        hello.topology.rank == std::numeric_limits<uint32_t>::max() &&
+        hello.topology.worldSize == 0;
+    const bool topologyExact = hello.topology.jobUuid == server.jobUuid &&
+        hello.topology.rank == server.rank &&
+        hello.topology.worldSize == server.worldSize;
+    if ((!topologyWildcard && !topologyExact) ||
+        (header.jobEpoch != 0 && header.jobEpoch != server.jobEpoch)) {
+        result.selected.fill(0);
+        result.status = Status::TopologyMismatch;
+        return result;
+    }
+    if (context.busy) {
+        result.selected.fill(0);
+        result.status = Status::Busy;
+        return result;
+    }
+    if (context.resourceExhausted) {
+        result.selected.fill(0);
+        result.status = Status::ResourceExhausted;
+        return result;
+    }
+    result.status = Status::Ok;
+    result.selectedMajor = 1;
+    result.selectedMinor = 0;
+    return result;
+}
+
+std::vector<uint8_t>
+encodeHello(const Header &header, const Hello &hello)
+{
+    std::vector<uint8_t> payload(HelloFixedBytes, 0);
+    store16(payload, 0, hello.minimumMajor);
+    store16(payload, 2, hello.minimumMinor);
+    store16(payload, 4, hello.maximumMajor);
+    store16(payload, 6, hello.maximumMinor);
+    storeBytes(payload, 8, hello.clientNonce);
+    storeBytes(payload, 24, hello.offered);
+    storeBytes(payload, 56, hello.required);
+    store32(payload, 88, hello.receiveMaximum);
+    store16(payload, 92, RuntimeRole);
+    if (hello.hasTopology)
+        appendTopology(payload, hello.topology);
+    for (const auto &tlv : hello.optionalTlvs) {
+        appendTlv(payload, tlv.type, tlv.flags,
+                  tlv.value.data(), tlv.value.size());
+    }
+    Header encodedHeader = header;
+    encodedHeader.messageType = MessageType::Hello;
+    encodedHeader.connectionId = 0;
+    return encodeFrame(encodedHeader, payload);
+}
+
+std::vector<uint8_t>
+encodeAck(const Header &request, const Ack &ack,
+          const ServerIdentity &server, uint64_t connectionId)
+{
+    std::vector<uint8_t> payload(AckFixedBytes, 0);
+    const bool success = ack.status == Status::Ok;
+    store16(payload, 0, success ? ack.selectedMajor : 0);
+    store16(payload, 2, success ? ack.selectedMinor : 0);
+    store32(payload, 4, static_cast<uint32_t>(ack.status));
+    storeBytes(payload, 8, ack.clientNonce);
+    if (success)
+        storeBytes(payload, 24, ack.serverNonce);
+    if (success)
+        storeBytes(payload, 40, ack.selected);
+    store32(payload, 72, success ? ack.maximumRecord : server.maximumRecord);
+    store16(payload, 76, DaemonRole);
+    if (success)
+        appendTopology(payload, ack.topology);
+
+    Header header;
+    header.messageType = MessageType::HelloAck;
+    header.requestId = request.requestId;
+    header.daemonUuid = server.daemonUuid;
+    header.connectionId = success ? connectionId : 0;
+    header.jobEpoch = server.jobEpoch;
+    return encodeFrame(header, payload);
+}
+
+const char *
+statusName(Status status)
+{
+    switch (status) {
+      case Status::Ok: return "OK";
+      case Status::Malformed: return "MALFORMED";
+      case Status::UnsupportedVersion: return "UNSUPPORTED_VERSION";
+      case Status::UnsupportedCapability: return "UNSUPPORTED_CAPABILITY";
+      case Status::InstanceMismatch: return "INSTANCE_MISMATCH";
+      case Status::TopologyMismatch: return "TOPOLOGY_MISMATCH";
+      case Status::Unauthorized: return "UNAUTHORIZED";
+      case Status::Busy: return "BUSY";
+      case Status::ResourceExhausted: return "RESOURCE_EXHAUSTED";
+      case Status::ProtocolState: return "PROTOCOL_STATE";
+      case Status::Internal: return "INTERNAL";
+    }
+    return "UNKNOWN";
+}

+std::vector<uint8_t>
+fromHex(const std::string &text)
+{
+    auto digit = [](char character) -> uint8_t {
+        if (character >= '0' && character <= '9')
+            return character - '0';
+        if (character >= 'a' && character <= 'f')
+            return character - 'a' + 10;
+        if (character >= 'A' && character <= 'F')
+            return character - 'A' + 10;
+        throw std::invalid_argument("invalid hex digit");
+    };
+    if ((text.size() & 1) != 0)
+        throw std::invalid_argument("odd hex string");
+    std::vector<uint8_t> result(text.size() / 2);
+    for (size_t index = 0; index < result.size(); ++index) {
+        result[index] = static_cast<uint8_t>(
+            digit(text[index * 2]) << 4 | digit(text[index * 2 + 1]));
+    }
+    return result;
+}
+
+void
+store16(std::vector<uint8_t> &data, size_t offset, uint16_t value)
+{
+    data[offset] = static_cast<uint8_t>(value >> 8);
+    data[offset + 1] = static_cast<uint8_t>(value);
+}
+
+void
+store32(std::vector<uint8_t> &data, size_t offset, uint32_t value)
+{
+    data[offset] = static_cast<uint8_t>(value >> 24);
+    data[offset + 1] = static_cast<uint8_t>(value >> 16);
+    data[offset + 2] = static_cast<uint8_t>(value >> 8);
+    data[offset + 3] = static_cast<uint8_t>(value);
+}
+
+void
+store64(std::vector<uint8_t> &data, size_t offset, uint64_t value)
+{
+    for (size_t index = 0; index < 8; ++index) {
+        data[offset + 7 - index] = static_cast<uint8_t>(value);
+        value >>= 8;
+    }
+}
+
+void
+recomputeCrc(std::vector<uint8_t> &frame)
+{
+    ASSERT_GE(frame.size(), 68U);
+    frame[64] = 0;
+    frame[65] = 0;
+    frame[66] = 0;
+    frame[67] = 0;
+    store32(frame, 64, crc32c(frame.data(), frame.size()));
+}
+
+Uuid
+uuid(const char *text)
+{
+    Uuid value;
+    EXPECT_TRUE(parseUuid(text, value));
+    return value;
+}
+
+Hello
+goldenHello()
+{
+    Hello hello;
+    hello.clientNonce = uuid("000102030405060708090a0b0c0d0e0f");
+    hello.offered = topologyCapability();
+    hello.required = topologyCapability();
+    hello.receiveMaximum = MaximumRecordBytes;
+    hello.topology.jobUuid = uuid("102132435465768798a9bacbdcedfe0f");
+    hello.topology.rank = 3;
+    hello.topology.worldSize = 8;
+    return hello;
+}
+
+Header
+goldenHeader()
+{
+    Header header;
+    header.requestId = 0x0123456789abcdefULL;
+    header.daemonUuid = uuid("00112233445566778899aabbccddeeff");
+    header.jobEpoch = 0x0102030405060708ULL;
+    return header;
+}
+
+ServerIdentity
+goldenServer()
+{
+    ServerIdentity server;
+    server.daemonUuid = uuid("00112233445566778899aabbccddeeff");
+    server.jobUuid = uuid("102132435465768798a9bacbdcedfe0f");
+    server.jobEpoch = 0x0102030405060708ULL;
+    server.rank = 3;
+    server.worldSize = 8;
+    server.supported = topologyCapability();
+    return server;
+}

+import argparse
+import time
+
+import m5
+from m5.objects import HostGPUBridge, Root
+
+
+def parse_args():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--endpoint", required=True)
+    parser.add_argument("--daemon-uuid", default="")
+    parser.add_argument("--job-uuid", default="")
+    parser.add_argument(
+        "--epoch", type=lambda value: int(value, 0), required=True
+    )
+    parser.add_argument("--rank", type=int, default=0)
+    parser.add_argument("--world-size", type=int, default=1)
+    parser.add_argument("--startup-timeout-ms", type=int, default=5000)
+    parser.add_argument("--handshake-timeout-ms", type=int, default=5000)
+    parser.add_argument("--max-record", type=int, default=65536)
+    parser.add_argument(
+        "--run-timeout-ms",
+        type=int,
+        default=10000,
+        help="Host wall-clock service window after startup",
+    )
+    parser.add_argument("--exit-on-handshake", action="store_true")
+    return parser.parse_args()
+
+
+args = parse_args()
+root = Root(full_system=False)
+root.host_gpu_bridge = HostGPUBridge(
+    endpoint=args.endpoint,
+    daemon_uuid=args.daemon_uuid,
+    job_uuid=args.job_uuid,
+    epoch=args.epoch,
+    rank=args.rank,
+    world_size=args.world_size,
+    startup_timeout_ms=args.startup_timeout_ms,
+    handshake_timeout_ms=args.handshake_timeout_ms,
+    max_record=args.max_record,
+    exit_on_handshake=args.exit_on_handshake,
+)
+
+m5.instantiate()
+deadline = time.monotonic() + args.run_timeout_ms / 1000.0
+while True:
+    exit_event = m5.simulate(1)
+    if exit_event.getCause() != "simulate() limit reached":
+        break
+    if time.monotonic() >= deadline:
+        break
+    time.sleep(0.001)
+print(
+    "host-gpu-sim-exit cause={} code={}".format(
+        exit_event.getCause(), exit_event.getCode()
+    )
+)

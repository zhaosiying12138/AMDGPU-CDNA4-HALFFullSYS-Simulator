+TEST(HostGPUConnectionState, SuccessfulAckCommitCannotBeRolledBack)
+{
+    HostGPUConnectionState state;
+    EXPECT_EQ(state.phase(), ConnectionPhase::AwaitHello);
+    state.noteRecordReceived();
+    state.beginAck(true);
+    EXPECT_EQ(state.phase(), ConnectionPhase::AckPending);
+    state.noteAckSent();
+    EXPECT_EQ(state.phase(), ConnectionPhase::Established);
+    EXPECT_TRUE(state.committed());
+    state.noteRecordReceived();
+    state.close();
+    EXPECT_EQ(state.phase(), ConnectionPhase::Closing);
+    EXPECT_TRUE(state.committed());
+}
+
+TEST(HostGPUConnectionState, FailureAckClosesAndStopsReading)
+{
+    HostGPUConnectionState state;
+    state.noteRecordReceived();
+    state.beginAck(false);
+    EXPECT_FALSE(state.canReceive());
+    state.noteAckSent();
+    EXPECT_EQ(state.phase(), ConnectionPhase::Closing);
+    EXPECT_FALSE(state.committed());
+}
+
+TEST(HostGPUConnectionState, EstablishedPreservesMalformedOnly)
+{
+    HostGPUConnectionState state;
+    state.noteRecordReceived();
+    state.beginAck(true);
+    state.noteAckSent();
+    EXPECT_EQ(preNegotiationStatus(
+                  state, false, protocol::Status::UnsupportedCapability),
+              protocol::Status::ProtocolState);
+    EXPECT_EQ(preNegotiationStatus(
+                  state, false, protocol::Status::Malformed),
+              protocol::Status::Malformed);
+}
+
+TEST(HostGPUConnectionState, PipelinedHelloWaitsForOkCommit)
+{
+    HostGPUConnectionState state;
+    state.noteRecordReceived();
+    state.beginAck(true);
+    EXPECT_FALSE(state.canReceive());
+    state.noteAckSent();
+    EXPECT_TRUE(state.committed());
+    ASSERT_TRUE(state.canReceive());
+    state.noteRecordReceived();
+    EXPECT_EQ(preNegotiationStatus(state, false, protocol::Status::Ok),
+              protocol::Status::ProtocolState);
+    state.beginAck(false);
+    state.noteAckSent();
+    EXPECT_EQ(state.phase(), ConnectionPhase::Closing);
+    EXPECT_TRUE(state.committed());
+}
+
+TEST(HostGPUConnectionState, DeadlineWinsUntilHelloBeginsAck)
+{
+    HostGPUConnectionState state;
+    state.noteRecordReceived();
+    EXPECT_TRUE(state.handshakeDeadlineApplies());
+    state.beginAck(true);
+    EXPECT_FALSE(state.handshakeDeadlineApplies());
+}

+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace gem5
+{
+namespace hostgpu
+{
+namespace protocol
+{
+
+constexpr size_t HeaderBytes = 80;
+constexpr size_t HelloFixedBytes = 96;
+constexpr size_t AckFixedBytes = 80;
+constexpr size_t CapabilityBytes = 32;
+constexpr size_t UuidBytes = 16;
+constexpr uint32_t MinimumRecordBytes = 4096;
+constexpr uint32_t MaximumRecordBytes = 65536;
+constexpr uint32_t MaximumHandshakeBytes = 4096;
+constexpr uint16_t TopologyTlvType = 1;
+constexpr uint16_t CriticalTlvFlag = 1;
+constexpr uint16_t RuntimeRole = 1;
+constexpr uint16_t DaemonRole = 2;
+
+using Uuid = std::array<uint8_t, UuidBytes>;
+using Capabilities = std::array<uint8_t, CapabilityBytes>;
+using Nonce = std::array<uint8_t, UuidBytes>;
+
+enum class MessageType : uint16_t
+{
+    Hello = 1,
+    HelloAck = 2,
+};
+
+enum class Status : uint32_t
+{
+    Ok = 0,
+    Malformed = 1,
+    UnsupportedVersion = 2,
+    UnsupportedCapability = 3,
+    InstanceMismatch = 4,
+    TopologyMismatch = 5,
+    Unauthorized = 6,
+    Busy = 7,
+    ResourceExhausted = 8,
+    ProtocolState = 9,
+    Internal = 10,
+};
+
+enum class DecodeAction
+{
+    Drop,
+    Acknowledge,
+};
+
+struct Header
+{
+    MessageType messageType = MessageType::Hello;
+    uint64_t requestId = 0;
+    Uuid daemonUuid = {};
+    uint64_t connectionId = 0;
+    uint64_t jobEpoch = 0;
+};
+
+struct Topology
+{
+    Uuid jobUuid = {};
+    uint32_t rank = 0;
+    uint32_t worldSize = 0;
+};
+
+struct Tlv
+{
+    uint16_t type = 0;
+    uint16_t flags = 0;
+    std::vector<uint8_t> value;
+};
+
+struct Hello
+{
+    uint16_t minimumMajor = 1;
+    uint16_t minimumMinor = 0;
+    uint16_t maximumMajor = 1;
+    uint16_t maximumMinor = 0;
+    Nonce clientNonce = {};
+    Capabilities offered = {};
+    Capabilities required = {};
+    uint32_t receiveMaximum = MaximumRecordBytes;
+    Topology topology;
+    bool hasTopology = true;
+    std::vector<Tlv> optionalTlvs;
+    bool unknownCriticalTlv = false;
+};
+
+struct DecodeResult
+{
+    DecodeAction action = DecodeAction::Drop;
+    bool closeConnection = true;
+    Status status = Status::Malformed;
+    std::string reason;
+    Header header;
+    Hello hello;
+    bool hasHello = false;
+};
+
+struct ServerIdentity
+{
+    Uuid daemonUuid = {};
+    Uuid jobUuid = {};
+    uint64_t jobEpoch = 0;
+    uint32_t rank = 0;
+    uint32_t worldSize = 1;
+    uint32_t maximumRecord = MaximumRecordBytes;
+    Capabilities supported = {};
+};
+
+struct NegotiationContext
+{
+    bool busy = false;
+    bool resourceExhausted = false;
+};
+
+struct NegotiationResult
+{
+    Status status = Status::Internal;
+    uint16_t selectedMajor = 0;
+    uint16_t selectedMinor = 0;
+    Capabilities selected = {};
+    uint32_t maximumRecord = MinimumRecordBytes;
+};
+
+struct Ack
+{
+    Status status = Status::Internal;
+    uint16_t selectedMajor = 0;
+    uint16_t selectedMinor = 0;
+    Nonce clientNonce = {};
+    Nonce serverNonce = {};
+    Capabilities selected = {};
+    uint32_t maximumRecord = MinimumRecordBytes;
+    Topology topology;
+};
+
+bool isZero(const Uuid &value);
+bool parseUuid(const std::string &text, Uuid &value);
+std::string formatUuid(const Uuid &value);
+
+Capabilities topologyCapability();
+bool capabilitySubset(const Capabilities &subset,
+                      const Capabilities &superset);
+
+uint32_t crc32c(const uint8_t *data, size_t size);
+
+DecodeResult decodeHelloRecord(const uint8_t *record, size_t size,
+                               uint32_t configuredMaximum);
+NegotiationResult negotiate(const Header &header, const Hello &hello,
+                            const ServerIdentity &server,
+                            const NegotiationContext &context = {});
+
+std::vector<uint8_t> encodeHello(const Header &header, const Hello &hello);
+std::vector<uint8_t> encodeAck(const Header &request, const Ack &ack,
+                               const ServerIdentity &server,
+                               uint64_t connectionId);

+TEST(HostGPUSocketUtils, ClosesRightsWithZeroPayload)
+{
+    int sockets[2] = {-1, -1};
+    ASSERT_EQ(::socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets),
+              0);
+    int pipeFds[2] = {-1, -1};
+    ASSERT_EQ(::pipe2(pipeFds, O_CLOEXEC), 0);
+    ASSERT_GE(sendRights(sockets[0], pipeFds, 2, false), 0);
+
+    std::array<uint8_t, 1> payload = {0};
+    std::array<uint8_t, CMSG_SPACE(sizeof(int) * 2)> control = {};
+    msghdr message = {};
+    iovec vector = {payload.data(), payload.size()};
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.data();
+    message.msg_controllen = control.size();
+    const size_t beforeReceive = openFileDescriptorCount();
+    ASSERT_EQ(::recvmsg(sockets[1], &message, 0), 0);
+    int received[2] = {-1, -1};
+    cmsghdr *header = CMSG_FIRSTHDR(&message);
+    ASSERT_NE(header, nullptr);
+    std::memcpy(received, CMSG_DATA(header), sizeof(received));
+    EXPECT_EQ(openFileDescriptorCount(), beforeReceive + 2);
+    EXPECT_EQ(closeReceivedFileDescriptors(message), 2U);
+    EXPECT_EQ(openFileDescriptorCount(), beforeReceive);
+    for (const int fd : received) {
+        errno = 0;
+        EXPECT_EQ(::fcntl(fd, F_GETFD), -1);
+        EXPECT_EQ(errno, EBADF);
+    }
+    ::close(pipeFds[0]);
+    ::close(pipeFds[1]);
+    ::close(sockets[0]);
+    ::close(sockets[1]);
+}
+
+TEST(HostGPUSocketUtils, ClosesVisibleRightsWhenControlIsTruncated)
+{
+    int sockets[2] = {-1, -1};
+    ASSERT_EQ(::socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets),
+              0);
+    int pipeFds[4] = {-1, -1, -1, -1};
+    ASSERT_EQ(::pipe2(pipeFds, O_CLOEXEC), 0);
+    ASSERT_EQ(::pipe2(pipeFds + 2, O_CLOEXEC), 0);
+    ASSERT_GT(sendRights(sockets[0], pipeFds, 4, true), 0);
+
+    std::array<uint8_t, 1> payload = {0};
+    std::array<uint8_t, CMSG_SPACE(sizeof(int))> control = {};
+    msghdr message = {};
+    iovec vector = {payload.data(), payload.size()};
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.data();
+    message.msg_controllen = control.size();
+    const size_t beforeReceive = openFileDescriptorCount();
+    ASSERT_EQ(::recvmsg(sockets[1], &message, 0), 1);
+    ASSERT_NE(message.msg_flags & MSG_CTRUNC, 0);
+    cmsghdr *header = CMSG_FIRSTHDR(&message);
+    ASSERT_NE(header, nullptr);
+    const size_t visible =
+        (header->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+    ASSERT_GT(visible, 0U);
+    ASSERT_LT(visible, 4U);
+    std::vector<int> received(visible, -1);
+    std::memcpy(received.data(), CMSG_DATA(header), visible * sizeof(int));
+    EXPECT_EQ(openFileDescriptorCount(), beforeReceive + visible);
+    EXPECT_EQ(closeReceivedFileDescriptors(message), visible);
+    EXPECT_EQ(openFileDescriptorCount(), beforeReceive);
+    for (const int fd : received) {
+        errno = 0;
+        EXPECT_EQ(::fcntl(fd, F_GETFD), -1);
+        EXPECT_EQ(errno, EBADF);
+    }
+    for (const int fd : pipeFds)
+        ::close(fd);
+    ::close(sockets[0]);
+    ::close(sockets[1]);
+}

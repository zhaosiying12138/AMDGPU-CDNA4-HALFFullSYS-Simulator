+    HostGPUMemoryState memory;
+    const HostGPUMemoryState::Owner owner;
+    HostNativeMemoryContext context;
+    HostNativeCodeObjectMapper mapper;
+    HostNativeQueueCore queue;
+    HostNativeCommandProcessorCore commandProcessor;
+    std::optional<HostNativeCodeObjectMapper::Mapping> mapping;
+    AllocationLease input;
+    AllocationLease output;
+    AllocationLease result;
+    AllocationLease kernarg;
+    AllocationLease packet;
+    AllocationLease signal;
+    AllocationLease mqd;
+    std::vector<int32_t> expectedInput;
+    CompletionRecord completion;
+
+    bool executionActive = false;
+    bool completionCommitted = false;
+    bool pinsReleased = false;
+    mutable uint64_t scalarReads = 0;
+    mutable uint64_t globalReads = 0;
+    mutable std::bitset<ElementCount> inputReadCoverage;
+    uint64_t globalWrites = 0;
+    std::bitset<ElementCount> outputWriteCoverage;
+    std::bitset<ElementCount> resultWriteCoverage;
+    uint64_t fetchedCount = 0;
+    uint64_t submittedCount = 0;
+    uint64_t dispatcherStartedCount = 0;
+    uint64_t waveStartedCount = 0;
+    uint32_t waveStartMask = 0;
+    uint64_t instructionStartedCount = 0;
+    std::unordered_map<uint64_t, uint32_t> instructionsPerWave;
+    std::unordered_map<uint64_t, std::vector<uint32_t>>
+        instructionOffsetsPerWave;
+    std::unordered_map<uint64_t, int> workgroupPerWave;
+    std::unordered_map<uint64_t, uint64_t> lastSequencePerWave;
+    std::unordered_set<uint64_t> instructionSequences;
+    uint64_t globalStoreEventCount = 0;
+    uint64_t globalStoreLaneCount = 0;
+    std::bitset<ExpectedWaves> outputStoreChunks;
+    std::bitset<ExpectedWaves> resultStoreChunks;
+    uint64_t workgroupCompletedCount = 0;
+    std::bitset<ExpectedWorkgroups> completedWorkgroups;
+    uint64_t retiredCount = 0;
+};

+constexpr uint16_t SourceDispatchHeader = 0x1502;
+constexpr std::array<uint32_t, 19> InstructionOffsets = {
+    0, 8, 16, 20, 24, 32, 36, 40, 48, 52,
+    56, 64, 72, 80, 88, 96, 100, 108, 116,
+};

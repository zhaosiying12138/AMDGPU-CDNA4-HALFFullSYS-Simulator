+# Copyright (c) 2026 The gem5 Project
+# All rights reserved.
+
+import argparse
+import os
+
+import m5
+from m5.defines import buildEnv
+from m5.objects import *
+from m5.util import fatal
+
+
+def create_compute_unit(shader):
+    cu = ComputeUnit(
+        cu_id=0,
+        perLaneTLB=False,
+        num_SIMDs=4,
+        wf_size=64,
+        n_wf=shader.n_wf,
+        localDataStore=LdsState(
+            banks=32,
+            bankConflictPenalty=1,
+            size=65536,
+        ),
+    )
+
+    wavefronts = []
+    vector_register_files = []
+    scalar_register_files = []
+    register_file_caches = []
+    vector_pool_managers = []
+    scalar_pool_managers = []
+    for simd_id in range(cu.num_SIMDs):
+        for slot_id in range(shader.n_wf):
+            wavefronts.append(
+                Wavefront(simdId=simd_id, wf_slot_id=slot_id, wf_size=64)
+            )
+        vector_register_files.append(
+            VectorRegisterFile(simd_id=simd_id, wf_size=64, num_regs=2048)
+        )
+        scalar_register_files.append(
+            ScalarRegisterFile(simd_id=simd_id, num_regs=2048)
+        )
+        register_file_caches.append(
+            RegisterFileCache(simd_id=simd_id, cache_size=0)
+        )
+        vector_pool_managers.append(
+            DynPoolManager(pool_size=2048, min_alloc=4)
+        )
+        scalar_pool_managers.append(
+            DynPoolManager(pool_size=2048, min_alloc=4)
+        )
+
+    cu.wavefronts = wavefronts
+    cu.vector_register_file = vector_register_files
+    cu.scalar_register_file = scalar_register_files
+    cu.register_file_cache = register_file_caches
+    cu.register_manager = RegisterManager(
+        policy="static",
+        vrf_pool_managers=vector_pool_managers,
+        srf_pool_managers=scalar_pool_managers,
+    )
+    cu.ldsPort = cu.ldsBus.cpu_side_port
+    cu.ldsBus.mem_side_port = cu.localDataStore.cuPort
+    return cu
+
+
+def default_fixture():
+    return os.path.abspath(
+        os.path.join(
+            os.path.dirname(__file__),
+            "../../../../rocm-systems/projects/rdc/rdc_libs/rdc_modules/"
+            "kernels/hsaco/gfx950/gpuReadWrite_kernels.hsaco",
+        )
+    )
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(
+        description="CPU-less native gfx950 gpuReadWrite B2 execution"
+    )
+    parser.add_argument("--fixture", default=default_fixture())
+    parser.add_argument("--max-ticks", type=int, default=10_000_000_000)
+    args = parser.parse_args()
+    if args.max_ticks <= 0:
+        fatal("--max-ticks must be positive")
+    if not os.path.isfile(args.fixture):
+        fatal("locked gpuReadWrite fixture is missing: %s", args.fixture)
+    if buildEnv["USE_X86_ISA"]:
+        fatal("host_native_b2.py requires a BUILD_ISA=n binary")
+    if not buildEnv["BUILD_GPU"] or not buildEnv["VEGA_GPU_ISA"]:
+        fatal("host_native_b2.py requires BUILD_GPU=y and VEGA_GPU_ISA=y")
+    return args
+
+
+def create_system(args):
+    system = System(
+        cache_line_size=64,
+        mem_mode="atomic",
+        workload=StubWorkload(),
+    )
+    system.voltage_domain = VoltageDomain(voltage="1.0V")
+    system.clk_domain = SrcClockDomain(
+        clock="1GHz", voltage_domain=system.voltage_domain
+    )
+
+    gpu_clock = SrcClockDomain(
+        clock="1GHz", voltage_domain=VoltageDomain(voltage="1.0V")
+    )
+    system.dispatcher = GPUDispatcher(kernel_exit_events=False)
+    system.shader = Shader(
+        n_wf=10,
+        cu_per_sqc=1,
+        dispatcher=system.dispatcher,
+        impl_kern_launch_acq=False,
+        impl_kern_end_rel=False,
+        timing=False,
+        clk_domain=gpu_clock,
+    )
+    system.compute_unit = create_compute_unit(system.shader)
+    system.shader.CUs = [system.compute_unit]
+    system.executor = HostNativeGPUExecutor(
+        shader=system.shader,
+        dispatcher=system.dispatcher,
+        fixture_path=os.path.abspath(args.fixture),
+    )
+    return system
+
+
+args = parse_args()
+system = create_system(args)
+root = Root(full_system=False, system=system)
+
+m5.ticks.setGlobalFrequency("1THz")
+m5.instantiate()
+exit_event = m5.simulate(args.max_ticks)
+m5.stats.dump()
+print(
+    "host-native-b2-exit cause={} code={} tick={} cpu_objects=0".format(
+        exit_event.getCause(), exit_event.getCode(), m5.curTick()
+    )
+)
+if (
+    exit_event.getCause() != "host-native gpuReadWrite B2 complete"
+    or exit_event.getCode() != 0
+):
+    raise SystemExit(exit_event.getCode() or 1)

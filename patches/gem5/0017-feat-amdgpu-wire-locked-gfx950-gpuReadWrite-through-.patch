+bool
+HostNativeQueueCore::retire(uint64_t queueIndex, uint64_t requestId)
+{
+    failureReason = "none";
+    if (!registered || queueIndex != readIdx || readIdx >= dispatchIdx)
+        return fail("queue retirement is out of order");
+    Slot &slot = slots[readIdx % slots.size()];
+    if (!slot.published || !slot.fetched || slot.hostPacketVa == 0)
+        return fail("queue retirement slot state");
+
+    uint64_t next = 0;
+    if (!nextIndex(readIdx, next))
+        return fail("queue read index exhausted");
+    if (!context.functionalWrite(
+            queueConfig.hostReadIndexVa, &next, sizeof(next), requestId)) {
+        return fail("queue read-index functional write");
+    }
+    slot = {};
+    readIdx = next;
+    readIndexWritten = true;
+    return true;
+}

+HostNativeGPUExecutor::HostNativeGPUExecutor(
+    const HostNativeGPUExecutorParams &params)
+    : SimObject(params), shader(params.shader), dispatcher(params.dispatcher),
+      fixturePath(params.fixture_path), owner{37, 1}, context(memory, owner),
+      mapper(memory, context, owner), queue(context)
+{
+    fatal_if(!shader || !dispatcher,
+             "%s: shader and dispatcher are required", name());
+    shader->setNativeMemory(this);
+    dispatcher->setLifecycleListener(this);
+    dispatcher->setCompletionSink(this);
+}
+
+void
+HostNativeGPUExecutor::startup()
+{
+    SimObject::startup();
+    fatal_if(!setupDispatch(), "%s: failed to set up locked B2 dispatch",
+             name());
+}
+
+bool
+HostNativeGPUExecutor::inRange(
+    Addr address, size_t byteCount, Addr base, uint64_t rangeBytes)
+{
+    if (base == 0 || byteCount == 0 || address < base)
+        return false;
+    const uint64_t offset = address - base;
+    return offset <= rangeBytes && byteCount <= rangeBytes - offset;
+}
+
+bool
+HostNativeGPUExecutor::read(
+    Addr address, void *destination, size_t byteCount, uint64_t requestId) const
+{
+    const bool packetRead =
+        address == packet.gpuVa + 4 && byteCount == sizeof(uint32_t);
+    const bool kernargRead =
+        address == kernarg.gpuVa && byteCount == 32;
+    const bool inputRead =
+        inRange(address, byteCount, input.gpuVa, AllocationBytes);
+    const bool codeRead = mapping && byteCount == 64 && address % 64 == 0 &&
+        (address == mapping->entryGpuVa ||
+         address == mapping->entryGpuVa + 64);
+    size_t inputIndex = 0;
+    if (executionActive) {
+        panic_if(!packetRead && !kernargRead && !inputRead && !codeRead,
+                 "unexpected B2 execution read at %#x/%llu", address,
+                 static_cast<unsigned long long>(byteCount));
+        if (inputRead) {
+            panic_if(byteCount != sizeof(int32_t) ||
+                         address % sizeof(int32_t) != 0,
+                     "unexpected B2 global read at %#x/%llu", address,
+                     static_cast<unsigned long long>(byteCount));
+            inputIndex = static_cast<size_t>(
+                (address - input.gpuVa) / sizeof(int32_t));
+            panic_if(inputReadCoverage.test(inputIndex),
+                     "duplicate B2 execution read at %#x", address);
+        }
+    }
+    const bool success =
+        context.functionalRead(address, destination, byteCount, requestId);
+    if (!success || !executionActive)
+        return success;
+    if (packetRead) {
+        ++scalarReads;
+    } else if (kernargRead) {
+        ++scalarReads;
+    } else if (inputRead) {
+        inputReadCoverage.set(inputIndex);
+        ++globalReads;
+    }
+    return true;
+}
+
+bool
+HostNativeGPUExecutor::write(
+    Addr address, const void *source, size_t byteCount, uint64_t requestId)
+{
+    const bool outputWrite =
+        inRange(address, byteCount, output.gpuVa, AllocationBytes);
+    const bool resultWrite =
+        inRange(address, byteCount, result.gpuVa, AllocationBytes);
+    size_t elementIndex = 0;
+    if (executionActive) {
+        panic_if(byteCount != sizeof(int32_t) ||
+                     address % sizeof(int32_t) != 0 ||
+                     (outputWrite == resultWrite),
+                 "unexpected B2 execution write at %#x/%llu", address,
+                 static_cast<unsigned long long>(byteCount));
+        elementIndex = static_cast<size_t>(
+            (address - (outputWrite ? output.gpuVa : result.gpuVa)) /
+            sizeof(int32_t));
+        panic_if((outputWrite ? outputWriteCoverage : resultWriteCoverage)
+                     .test(elementIndex),
+                 "duplicate B2 execution write at %#x", address);
+    }
+    const bool success =
+        context.functionalWrite(address, source, byteCount, requestId);
+    if (success && executionActive) {
+        (outputWrite ? outputWriteCoverage : resultWriteCoverage)
+            .set(elementIndex);
+        ++globalWrites;
+    }
+    return success;
+}
+
+HostNativeGPUExecutor::AllocationLease
+HostNativeGPUExecutor::allocate(uint64_t bytes, uint64_t now)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Allocate;
+    request.byteCount = bytes;
+    request.argument = 4096;
+    const auto response = memory.allocate(owner, request, now);
+    if (response.status != protocol::Status::Ok)
+        return {};
+    const auto lease = context.map(response.value0, bytes);
+    if (!lease)
+        return {};
+    return {response.allocationId, response.generation, response.value0,
+            *lease};
+}
+
+bool
+HostNativeGPUExecutor::pin(const AllocationLease &allocation)
+{
+    return allocation.valid() && memory.pinPinnedDispatchAllocation(
+        owner, allocation.id, allocation.generation, RequestId);
+}
+
+bool
+HostNativeGPUExecutor::pinCodeMapping()
+{
+    return mapping && mapping->valid() &&
+        memory.pinPinnedDispatchAllocation(
+            owner, mapping->allocation.allocationId,
+            mapping->allocation.generation, RequestId);
+}
+
+bool
+HostNativeGPUExecutor::releasePins()
+{
+    if (pinsReleased)
+        return false;
+    bool success = true;
+    const std::array<const AllocationLease *, 7> allocations = {
+        &input, &output, &result, &kernarg, &packet, &signal, &mqd};
+    for (const auto *allocation : allocations) {
+        success = memory.releasePinnedDispatchAllocation(
+                      owner, allocation->id, allocation->generation,
+                      RequestId) && success;
+    }
+    success = mapping && memory.releasePinnedDispatchAllocation(
+                  owner, mapping->allocation.allocationId,
+                  mapping->allocation.generation, RequestId) && success;
+    pinsReleased = success;
+    return success;
+}
+
+bool
+HostNativeGPUExecutor::setupDispatch()
+{
+    const auto image = readFixture(fixturePath);
+    if (image.size() != 5528)
+        return false;
+    const auto manifest = fixtureManifest(image);
+    if (HostGPUCodeObjectState::imageSha256(image) != manifest.imageSha256)
+        return false;
+    mapping = mapper.map(image, manifest);
+    if (!mapping || !mapping->valid())
+        return false;
+
+    input = allocate(AllocationBytes, 10);
+    output = allocate(AllocationBytes, 11);
+    result = allocate(AllocationBytes, 12);
+    kernarg = allocate(AllocationBytes, 13);
+    packet = allocate(QueueBytes, 14);
+    signal = allocate(AllocationBytes, 15);
+    mqd = allocate(AllocationBytes, 16);
+    if (!input.valid() || !output.valid() || !result.valid() ||
+        !kernarg.valid() || !packet.valid() || !signal.valid() ||
+        !mqd.valid() || input.gpuVa == output.gpuVa ||
+        input.gpuVa == result.gpuVa || output.gpuVa == result.gpuVa) {
+        return false;
+    }
+
+    expectedInput.resize(ElementCount);
+    for (uint32_t index = 0; index < ElementCount; ++index)
+        expectedInput[index] = static_cast<int32_t>(0x51000000U ^ index);
+    std::vector<int32_t> outputSentinels(ElementCount);
+    std::vector<int32_t> resultSentinels(ElementCount);
+    for (uint32_t index = 0; index < ElementCount; ++index) {
+        outputSentinels[index] =
+            static_cast<int32_t>(0x6b000000U ^ index);
+        resultSentinels[index] =
+            static_cast<int32_t>(0x7c000000U ^ index);
+    }
+    if (!context.functionalWrite(input.gpuVa, expectedInput.data(),
+                                 AllocationBytes) ||
+        !context.functionalWrite(output.gpuVa, outputSentinels.data(),
+                                 AllocationBytes) ||
+        !context.functionalWrite(result.gpuVa, resultSentinels.data(),
+                                 AllocationBytes)) {
+        return false;
+    }
+
+    const uint64_t signalValue = 1;
+    if (!context.functionalWrite(signal.gpuVa, &signalValue,
+                                 sizeof(signalValue))) {
+        return false;
+    }
+
+    HostNativeDispatchAdmission admission;
+    HostNativeDispatchAdmission::Result admitted;
+    if (!admission.materialize(
+            *mapping, manifest, context, packet.gpuVa, kernarg.gpuVa,
+            signal.gpuVa, input.gpuVa, output.gpuVa, result.gpuVa, QueueId,
+            QueueGeneration, 1, admitted)) {
+        return false;
+    }
+
+    // The locked bytes use the device-library OLD_ABI global offsets at
+    // kernarg +24/+32/+40.  The original RDC caller provides only 24 explicit
+    // bytes, so the bounded compatibility fixture keeps all three offsets zero.
+    std::fill(admitted.kernarg.begin() + 0x18,
+              admitted.kernarg.begin() + 0x30, 0);
+    if (!context.functionalWrite(kernarg.gpuVa, admitted.kernarg.data(),
+                                 admitted.kernarg.size())) {
+        return false;
+    }
+    std::array<uint8_t, HostNativeDispatchAdmission::KernargBytes>
+        kernargReadback = {};
+    if (!context.functionalRead(kernarg.gpuVa, kernargReadback.data(),
+                                kernargReadback.size()) ||
+        kernargReadback != admitted.kernarg ||
+        !std::all_of(kernargReadback.begin() + 0x18,
+                     kernargReadback.begin() + 0x30,
+                     [](uint8_t value) { return value == 0; })) {
+        return false;
+    }
+
+    // Match the locked RDC producer: barrier bit and system acquire/release
+    // scopes.  B1's 0x1402 remains accepted for its standalone regression.
+    admitted.packet.header = SourceDispatchHeader;
+    std::memcpy(admitted.aqlBytes.data(), &admitted.packet,
+                admitted.aqlBytes.size());
+
+    _amd_queue_t queueDescriptor = {};
+    queueDescriptor.hsa_queue.type = _HSA_QUEUE_TYPE_MULTI;
+    queueDescriptor.hsa_queue.base_address =
+        reinterpret_cast<void *>(packet.gpuVa);
+    queueDescriptor.hsa_queue.size =
+        QueueBytes / HostNativeQueueCore::PacketBytes;
+    queueDescriptor.hsa_queue.id = QueueId;
+    queueDescriptor.read_dispatch_id = 0;
+    queueDescriptor.write_dispatch_id = 0;
+    queueDescriptor.read_dispatch_id_field_base_byte_offset =
+        offsetof(_amd_queue_t, read_dispatch_id);
+    static_assert(sizeof(queueDescriptor) == 256);
+    if (!context.functionalWrite(mqd.gpuVa, &queueDescriptor,
+                                 sizeof(queueDescriptor))) {
+        return false;
+    }
+
+    HostNativeQueueCore::Config queueConfig;
+    queueConfig.baseVa = packet.gpuVa;
+    queueConfig.hostReadIndexVa =
+        mqd.gpuVa + offsetof(_amd_queue_t, read_dispatch_id);
+    queueConfig.activeQueueId = QueueId;
+    queueConfig.generation = QueueGeneration;
+    queueConfig.registeredIndex = 0;
+    queueConfig.queueBytes = QueueBytes;
+    queueConfig.doorbellBytes = 8;
+    queueConfig.readIndex = 0;
+    if (!queue.registerQueue(queueConfig))
+        return false;
+
+    if (!pinCodeMapping() || !pin(input) || !pin(output) || !pin(result) ||
+        !pin(kernarg) || !pin(packet) || !pin(signal) || !pin(mqd)) {
+        return false;
+    }
+
+    if (!queue.publish(packet.gpuVa, admitted.aqlBytes.data(),
+                       admitted.aqlBytes.size(), RequestId)) {
+        return false;
+    }
+    uint32_t registeredIndex = std::numeric_limits<uint32_t>::max();
+    if (!queue.ring(1, registeredIndex) || registeredIndex != 0)
+        return false;
+    queueDescriptor.write_dispatch_id = 1;
+    if (!context.functionalWrite(mqd.gpuVa, &queueDescriptor,
+                                 sizeof(queueDescriptor), RequestId)) {
+        return false;
+    }
+
+    HostNativeQueueCore::FetchedPacket fetched;
+    if (!queue.fetch(fetched, this, RequestId) ||
+        fetched.queueIndex != 0 || fetched.registeredIndex != 0) {
+        return false;
+    }
+    HostNativeCommandProcessorCore::Result submitted;
+    if (!commandProcessor.submit(
+            fetched, queue, *mapping, manifest, context, DispatchId,
+            submitted, this, RequestId) || !submitted.taskValid ||
+        !submitted.task || submitted.task->numWgTotal() != ExpectedWorkgroups ||
+        submitted.task->wgSize(0) != 256 ||
+        submitted.task->gridSize(0) != ElementCount) {
+        return false;
+    }
+
+    completion.queue = &queue;
+    completion.queueIndex = fetched.queueIndex;
+    completion.signalVa = signal.gpuVa;
+    completion.requestId = RequestId;
+    completion.dispatchId = submitted.task->dispatchId();
+    completion.activeQueueId = fetched.activeQueueId;
+    completion.queueGeneration = fetched.queueGeneration;
+    completion.registeredIndex = fetched.registeredIndex;
+    completion.hostPacketVa = fetched.hostPacketVa;
+    completion.ticket = fetched.ticket;
+    completion.valid = true;
+    dispatcher->dispatch(submitted.releaseTask().release());
+    return true;
+}

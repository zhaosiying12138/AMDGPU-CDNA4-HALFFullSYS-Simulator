+void
+HostNativeGPUExecutor::gpuDispatcherStarted(const HSAQueueEntry &task)
+{
+    panic_if(task.dispatchId() != DispatchId || dispatcherStartedCount != 0,
+             "B2 dispatcher start identity mismatch");
+    ++dispatcherStartedCount;
+    executionActive = true;
+}
+
+void
+HostNativeGPUExecutor::cuWaveStarted(
+    const HSAQueueEntry &task, int cuId, int waveId, uint32_t workgroupX,
+    uint32_t workgroupY, uint32_t workgroupZ, uint64_t laneMask)
+{
+    panic_if(task.dispatchId() != DispatchId || cuId != 0 || waveId < 0 ||
+                 waveId >= 4 || workgroupX >= ExpectedWorkgroups ||
+                 workgroupY != 0 || workgroupZ != 0 ||
+                 laneMask != std::numeric_limits<uint64_t>::max(),
+             "B2 CU wave-start geometry mismatch");
+    const uint32_t identity = workgroupX * 4 + waveId;
+    panic_if(waveStartMask & (1U << identity),
+             "duplicate B2 CU wave-start identity");
+    waveStartMask |= 1U << identity;
+    ++waveStartedCount;
+}
+
+void
+HostNativeGPUExecutor::cuInstructionStarted(
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    uint64_t dynamicWaveId, Addr pc, uint64_t sequence)
+{
+    panic_if(task.dispatchId() != DispatchId || cuId != 0 ||
+                 workgroupId < 0 || workgroupId >= ExpectedWorkgroups ||
+                 dynamicWaveId >= ExpectedWaves || pc < task.codeAddr() ||
+                 pc >= task.codeAddr() + 0x78,
+             "B2 CU instruction-start identity mismatch");
+    auto [workgroup, inserted] =
+        workgroupPerWave.emplace(dynamicWaveId, workgroupId);
+    panic_if(!inserted && workgroup->second != workgroupId,
+             "B2 dynamic wave changed workgroup identity");
+    auto &offsets = instructionOffsetsPerWave[dynamicWaveId];
+    panic_if(offsets.size() >= InstructionOffsets.size() ||
+                 pc - task.codeAddr() != InstructionOffsets[offsets.size()],
+             "B2 dynamic wave instruction PC sequence mismatch");
+    offsets.push_back(static_cast<uint32_t>(pc - task.codeAddr()));
+    panic_if(!instructionSequences.insert(sequence).second,
+             "duplicate B2 dynamic instruction sequence");
+    auto previous = lastSequencePerWave.find(dynamicWaveId);
+    panic_if(previous != lastSequencePerWave.end() &&
+                 sequence <= previous->second,
+             "B2 per-wave instruction sequence did not increase");
+    lastSequencePerWave[dynamicWaveId] = sequence;
+    auto &perWave = instructionsPerWave[dynamicWaveId];
+    ++perWave;
+    panic_if(perWave > InstructionsPerWave,
+             "B2 dynamic wave exceeded locked instruction count");
+    ++instructionStartedCount;
+}
+
+void
+HostNativeGPUExecutor::cuGlobalStoreCompleted(
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    const std::vector<Addr> &addresses, uint32_t bytesPerLane,
+    uint64_t laneMask)
+{
+    panic_if(task.dispatchId() != DispatchId || cuId != 0 ||
+                 workgroupId < 0 || workgroupId >= ExpectedWorkgroups ||
+                 bytesPerLane != sizeof(int32_t) || addresses.size() != 64 ||
+                 laneMask != std::numeric_limits<uint64_t>::max(),
+             "B2 global-store lifecycle geometry mismatch");
+    const bool outputStore = inRange(
+        addresses.front(), bytesPerLane, output.gpuVa, AllocationBytes);
+    const bool resultStore = inRange(
+        addresses.front(), bytesPerLane, result.gpuVa, AllocationBytes);
+    panic_if(outputStore == resultStore,
+             "B2 global-store address outside a unique B/C range");
+    const Addr base = outputStore ? output.gpuVa : result.gpuVa;
+    const Addr offset = addresses.front() - base;
+    panic_if(offset % (64 * sizeof(int32_t)) != 0,
+             "B2 global-store chunk is not 64-lane aligned");
+    const size_t chunk = offset / (64 * sizeof(int32_t));
+    panic_if(chunk >= ExpectedWaves ||
+                 chunk / 4 != static_cast<size_t>(workgroupId),
+             "B2 global-store chunk/workgroup mismatch");
+    for (size_t lane = 0; lane < addresses.size(); ++lane) {
+        panic_if(addresses[lane] !=
+                     base + (chunk * 64 + lane) * sizeof(int32_t),
+                 "B2 global-store lane address sequence mismatch");
+    }
+    auto &chunks = outputStore ? outputStoreChunks : resultStoreChunks;
+    panic_if(chunks.test(chunk), "duplicate B2 global-store chunk");
+    panic_if(outputStore && !resultStoreChunks.test(chunk),
+             "B2 output store completed before matching result store");
+    chunks.set(chunk);
+    ++globalStoreEventCount;
+    globalStoreLaneCount += std::bitset<64>(laneMask).count();
+}
+
+void
+HostNativeGPUExecutor::gpuWorkgroupCompleted(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    panic_if(task.dispatchId() != DispatchId || cuId != 0 ||
+                 workgroupId < 0 || workgroupId >= ExpectedWorkgroups,
+             "B2 workgroup completion identity mismatch");
+    panic_if(completedWorkgroups.test(workgroupId),
+             "duplicate B2 workgroup completion");
+    completedWorkgroups.set(workgroupId);
+    ++workgroupCompletedCount;
+}
+
+bool
+HostNativeGPUExecutor::validateOutput() const
+{
+    std::vector<uint8_t> inputBytes;
+    std::vector<uint8_t> outputBytes;
+    std::vector<uint8_t> resultBytes;
+    if (!context.functionalRead(input.gpuVa, AllocationBytes, inputBytes,
+                                RequestId) ||
+        !context.functionalRead(output.gpuVa, AllocationBytes, outputBytes,
+                                RequestId) ||
+        !context.functionalRead(result.gpuVa, AllocationBytes, resultBytes,
+                                RequestId) ||
+        inputBytes.size() != AllocationBytes ||
+        outputBytes.size() != AllocationBytes ||
+        resultBytes.size() != AllocationBytes) {
+        return false;
+    }
+    for (uint32_t index = 0; index < ElementCount; ++index) {
+        int32_t inputValue = 0;
+        int32_t outputValue = 0;
+        int32_t resultValue = 0;
+        std::memcpy(&inputValue,
+                    inputBytes.data() + index * sizeof(inputValue),
+                    sizeof(inputValue));
+        std::memcpy(&outputValue,
+                    outputBytes.data() + index * sizeof(outputValue),
+                    sizeof(outputValue));
+        std::memcpy(&resultValue,
+                    resultBytes.data() + index * sizeof(resultValue),
+                    sizeof(resultValue));
+        if (inputValue != expectedInput[index] ||
+            outputValue != static_cast<int32_t>(index) ||
+            resultValue != expectedInput[index]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool
+HostNativeGPUExecutor::validateCompletionIdentity(
+    const HSAQueueEntry &task, int cuId, int workgroupId) const
+{
+    return completion.valid && completion.queue == &queue &&
+        completion.queueIndex == 0 && completion.signalVa == signal.gpuVa &&
+        completion.requestId == RequestId &&
+        completion.dispatchId == task.dispatchId() &&
+        completion.activeQueueId == QueueId &&
+        completion.queueGeneration == QueueGeneration &&
+        completion.registeredIndex == 0 &&
+        completion.hostPacketVa == packet.gpuVa && completion.ticket != 0 &&
+        task.hostDispPktAddr() == completion.hostPacketVa &&
+        task.dispatchId() == DispatchId && task.queueId() == 0 && cuId == 0 &&
+        workgroupId >= 0 && workgroupId < ExpectedWorkgroups &&
+        task.numWgTotal() == ExpectedWorkgroups &&
+        task.numWgCompleted() == ExpectedWorkgroups;
+}
+
+bool
+HostNativeGPUExecutor::completeKernel(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    executionActive = false;
+    if (completionCommitted ||
+        !validateCompletionIdentity(task, cuId, workgroupId) ||
+        fetchedCount != 1 || submittedCount != 1 ||
+        dispatcherStartedCount != 1 || waveStartedCount != ExpectedWaves ||
+        waveStartMask != 0xffffU ||
+        instructionStartedCount != ExpectedWaves * InstructionsPerWave ||
+        instructionsPerWave.size() != ExpectedWaves ||
+        instructionOffsetsPerWave.size() != ExpectedWaves ||
+        workgroupPerWave.size() != ExpectedWaves ||
+        lastSequencePerWave.size() != ExpectedWaves ||
+        instructionSequences.size() !=
+            ExpectedWaves * InstructionsPerWave ||
+        scalarReads != 32 || globalReads != ElementCount ||
+        inputReadCoverage.count() != ElementCount ||
+        globalWrites != ElementCount * 2 || globalStoreEventCount != 32 ||
+        globalStoreLaneCount != ElementCount * 2 ||
+        outputStoreChunks.count() != ExpectedWaves ||
+        resultStoreChunks.count() != ExpectedWaves ||
+        outputWriteCoverage.count() != ElementCount ||
+        resultWriteCoverage.count() != ElementCount ||
+        workgroupCompletedCount != ExpectedWorkgroups ||
+        completedWorkgroups.count() != ExpectedWorkgroups ||
+        !validateOutput()) {
+        return false;
+    }
+    for (const auto &[dynamicWaveId, count] : instructionsPerWave) {
+        if (dynamicWaveId >= ExpectedWaves || count != InstructionsPerWave ||
+            instructionOffsetsPerWave.at(dynamicWaveId) !=
+                std::vector<uint32_t>(InstructionOffsets.begin(),
+                                      InstructionOffsets.end()) ||
+            workgroupPerWave.at(dynamicWaveId) !=
+                static_cast<int>(dynamicWaveId / 4)) {
+            return false;
+        }
+    }
+
+    uint64_t signalBefore = 0;
+    _amd_queue_t mqdBefore = {};
+    if (!context.functionalRead(signal.gpuVa, &signalBefore,
+                                sizeof(signalBefore), RequestId) ||
+        !context.functionalRead(mqd.gpuVa, &mqdBefore, sizeof(mqdBefore),
+                                RequestId) ||
+        signalBefore != 1 || mqdBefore.read_dispatch_id != 0 ||
+        mqdBefore.write_dispatch_id != 1 || queue.readIndex() != 0 ||
+        queue.dispatchIndex() != 1 || queue.fetchIndex() != 1 ||
+        queue.writeIndex() != 1 ||
+        !memory.pinnedDispatchAllocationOwned(
+            owner, signal.id, signal.generation, RequestId) ||
+        !memory.pinnedDispatchAllocationOwned(
+            owner, mqd.id, mqd.generation, RequestId)) {
+        return false;
+    }
+
+    if (!queue.retire(completion.queueIndex, completion.requestId))
+        return false;
+    _amd_queue_t mqdAfter = {};
+    if (!context.functionalRead(mqd.gpuVa, &mqdAfter, sizeof(mqdAfter),
+                                RequestId) ||
+        mqdAfter.read_dispatch_id != 1 || queue.readIndex() != 1 ||
+        !queue.hostReadIndexUpdated()) {
+        return false;
+    }
+
+    const uint64_t signalAfter = 0;
+    if (!context.functionalWrite(signal.gpuVa, &signalAfter,
+                                 sizeof(signalAfter), RequestId)) {
+        return false;
+    }
+    uint64_t signalReadback = 1;
+    if (!context.functionalRead(signal.gpuVa, &signalReadback,
+                                sizeof(signalReadback), RequestId) ||
+        signalReadback != 0) {
+        return false;
+    }
+    completionCommitted = true;
+    return true;
+}
+
+void
+HostNativeGPUExecutor::hsaPacketRetired(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    panic_if(!completionCommitted ||
+                 !validateCompletionIdentity(task, cuId, workgroupId) ||
+                 retiredCount != 0,
+             "B2 packet retirement identity mismatch");
+    ++retiredCount;
+    panic_if(!releasePins(), "B2 pinned-allocation release failed");
+    emitResultAndExit();
+}
+
+void
+HostNativeGPUExecutor::emitResultAndExit()
+{
+    std::cout
+        << "{\"schema\":\"gem5.host-native.dispatch-b2.v1\","
+           "\"kernel\":\"gpuReadWrite\",\"gfx_target\":950,"
+           "\"aql_header\":\"0x1502\",\"workgroup_size_x\":256,"
+           "\"grid_size_x\":1024,\"workgroup_count\":"
+        << workgroupCompletedCount
+        << ",\"wave_count\":" << waveStartedCount
+        << ",\"instruction_started_count\":" << instructionStartedCount
+        << ",\"scalar_memory_requests\":" << scalarReads
+        << ",\"global_read_lanes\":" << globalReads
+        << ",\"global_write_lanes\":" << globalWrites
+        << ",\"global_store_events\":" << globalStoreEventCount
+        << ",\"hsa_packet_fetched_count\":" << fetchedCount
+        << ",\"command_processor_submitted_count\":" << submittedCount
+        << ",\"gpu_dispatcher_started_count\":" << dispatcherStartedCount
+        << ",\"hsa_packet_retired_count\":" << retiredCount
+        << ",\"separate_abc_4k\":true,"
+           "\"old_abi_global_offsets_zero\":true,"
+           "\"output_b_is_gid\":true,\"output_c_is_a\":true,"
+           "\"output_address_coverage\":1024,"
+           "\"result_address_coverage\":1024,"
+           "\"host_read_index_before\":0,\"host_read_index_after\":1,"
+           "\"native_signal_layout\":\"direct_u64\","
+           "\"signal_before\":1,\"signal_after\":0,"
+           "\"pins_released\":true,\"gpu_dispatcher_instantiated\":true,"
+           "\"compute_unit_executed\":true,\"cpu_objects\":0,"
+           "\"process_instantiated\":false,\"ruby_instantiated\":false,"
+           "\"tlb_instantiated\":false,\"hsapp_instantiated\":false,"
+           "\"gpu_command_processor_simobject_instantiated\":false,"
+           "\"cpu_fallback\":false,\"nvidia_fallback\":false}"
+        << std::endl;
+    exitSimLoop("host-native gpuReadWrite B2 complete", 0);
+}
+
+} // namespace hostgpu
+} // namespace gem5

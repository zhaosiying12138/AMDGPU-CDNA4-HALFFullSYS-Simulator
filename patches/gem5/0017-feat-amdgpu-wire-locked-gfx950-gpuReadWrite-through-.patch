+    void cuGlobalStoreCompleted(
+        const HSAQueueEntry &task, int cuId, int workgroupId,
+        const std::vector<Addr> &addresses, uint32_t bytesPerLane,
+        uint64_t laneMask) override;
+    void gpuWorkgroupCompleted(
+        const HSAQueueEntry &task, int cuId, int workgroupId) override;
+    void hsaPacketRetired(
+        const HSAQueueEntry &task, int cuId, int workgroupId) override;
+
+    bool completeKernel(

+bool
+geometryFitsSignedTaskCounters(const _hsa_dispatch_packet_t &packet)
+{
+    const std::array<uint32_t, 3> grid = {
+        packet.grid_size_x, packet.grid_size_y, packet.grid_size_z};
+    const std::array<uint32_t, 3> workgroup = {
+        packet.workgroup_size_x,
+        packet.workgroup_size_y,
+        packet.workgroup_size_z};
+    uint64_t totalWorkgroups = 1;
+
+    for (size_t dimension = 0; dimension < grid.size(); ++dimension) {
+        if (grid[dimension] == 0 || workgroup[dimension] == 0)
+            return false;
+        const uint64_t roundedExtent =
+            static_cast<uint64_t>(grid[dimension]) +
+            workgroup[dimension] - 1;
+        if (roundedExtent > INT_MAX)
+            return false;
+        const uint64_t groups = roundedExtent / workgroup[dimension];
+        if (groups > static_cast<uint64_t>(INT_MAX) / totalWorkgroups)
+            return false;
+        totalWorkgroups *= groups;
+    }
+    return true;
+}

+              protocol::KmtStatus::Success);
+
+    auto exportBacking = request(protocol::KmtOperation::ExportBacking, 3);
+    exportBacking.ownerId = opened.response.ownerId;
+    exportBacking.ownerGeneration = opened.response.ownerGeneration;
+    setWords(exportBacking.argumentWords, 0, 1, BackingBytes);
+    exportBacking.argumentWords[2] = 4096;

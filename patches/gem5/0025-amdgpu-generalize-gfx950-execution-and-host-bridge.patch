+    auto gpu = request(protocol::KmtOperation::AllocateMemoryOfGpu, 4);
+    gpu.ownerId = opened.response.ownerId;
+    gpu.ownerGeneration = opened.response.ownerGeneration;
+    setWords(gpu.argumentWords, 0, 1, 0x1000000000ULL);
+    setWords(gpu.argumentWords, 2, 3, LargeAllocationBytes);
+    setWords(gpu.argumentWords, 4, 5, 0);
+    gpu.argumentWords[6] = Kmt::VisibleGpuId;
+    const auto large = state.submit(owner, header(), gpu);
+    ASSERT_EQ(large.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(state.totalAllocatedBytes(), LargeAllocationBytes);
+
+    gpu.operationSequence = 5;
+    setWords(gpu.argumentWords, 0, 1,
+             0x1000000000ULL + LargeAllocationBytes);
+    setWords(gpu.argumentWords, 2, 3, 4096);
+    setWords(gpu.argumentWords, 4, 5, LargeAllocationBytes);
+    const auto highOffset = state.submit(owner, header(), gpu);
+    ASSERT_EQ(highOffset.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(getWords(highOffset.response.resultWords, 0, 1),

+/** One validated process-owned KMT backing shared with the bridge. */
+class HostKmtSharedBacking
+{
+  public:
+    static std::unique_ptr<HostKmtSharedBacking> adopt(
+        OwnedFileDescriptor descriptor, uid_t owner, uint64_t byteCount,
+        uint32_t pageBytes);
+
+    HostKmtSharedBacking(const HostKmtSharedBacking &) = delete;
+    HostKmtSharedBacking &operator=(const HostKmtSharedBacking &) = delete;
+    HostKmtSharedBacking(HostKmtSharedBacking &&) = delete;
+    HostKmtSharedBacking &operator=(HostKmtSharedBacking &&) = delete;
+
+    bool read(uint64_t offset, void *destination, size_t byteCount) const;
+    bool write(uint64_t offset, const void *source, size_t byteCount);
+    bool initializeQueueControl();
+
+    int fd() const { return descriptor.get(); }
+    uint64_t size() const { return byteCount; }
+    uint32_t pageSize() const { return pageBytes; }
+    dev_t device() const { return deviceId; }
+    ino_t inode() const { return inodeId; }
+
+  private:
+    HostKmtSharedBacking(OwnedFileDescriptor descriptor, uint64_t byteCount,
+                         uint32_t pageBytes, dev_t deviceId, ino_t inodeId)
+        : descriptor(std::move(descriptor)), byteCount(byteCount),
+          pageBytes(pageBytes), deviceId(deviceId), inodeId(inodeId)
+    {}
+
+    OwnedFileDescriptor descriptor;
+    uint64_t byteCount = 0;
+    uint32_t pageBytes = 0;
+    dev_t deviceId = 0;
+    ino_t inodeId = 0;
+};
+
+/**
+ * Generic native-memory view over one authenticated KMT session.
+ *
+ * The view intentionally exposes only byte reads/writes by GPU virtual
+ * address.  Allocation lookup, bounds, owner identity, and generation checks
+ * remain in HostGPUKmtState; no queue or operator semantics belong here.
+ */
+class HostKmtNativeMemory final : public GPUNativeMemory
+{
+  public:
+    HostKmtNativeMemory(HostGPUKmtState &state,
+                        const HostGPUKmtState::Owner &transportOwner,
+                        uint64_t ownerId, uint64_t ownerGeneration,
+                        HostKmtSharedBacking *backing = nullptr,
+                        pid_t processPid = -1)
+        : state(state), transportOwner(transportOwner), ownerId(ownerId),
+          ownerGeneration(ownerGeneration), backing(backing),
+          processPid(processPid)
+    {}
+
+    bool read(Addr address, void *destination, size_t byteCount,
+              uint64_t requestId = 0) const override;
+    bool write(Addr address, const void *source, size_t byteCount,
+               uint64_t requestId = 0) override;
+
+    std::optional<domain::ResidentKernelView> residentKernel(
+        Addr descriptorVa, uint32_t gfxTarget,
+        std::string diagnosticName = {}) const;
+
+    const HostGPUKmtState::Owner &transportOwnerKey() const
+    {
+        return transportOwner;
+    }
+    uint64_t ownerIdValue() const { return ownerId; }
+    uint64_t ownerGenerationValue() const { return ownerGeneration; }
+
+  private:
+    HostGPUKmtState &state;
+    HostGPUKmtState::Owner transportOwner;
+    uint64_t ownerId = 0;
+    uint64_t ownerGeneration = 0;
+    HostKmtSharedBacking *backing = nullptr;
+    pid_t processPid = -1;
+};
+
+/** Translate one upstream host read-index address to its shared shadow slot. */
+class HostKmtQueueMemory final : public GPUNativeMemory
+{
+  public:
+    HostKmtQueueMemory(GPUNativeMemory &memory,
+                       HostKmtSharedBacking &backing,
+                       Addr readIndexAddress, uint64_t completionOffset)
+        : memory(memory), backing(backing),
+          readIndexAddress(readIndexAddress),
+          completionOffset(completionOffset)
+    {}
+
+    bool read(Addr address, void *destination, size_t byteCount,
+              uint64_t requestId = 0) const override;
+    bool write(Addr address, const void *source, size_t byteCount,
+               uint64_t requestId = 0) override;
+
+  private:
+    bool overlapsReadIndex(Addr address, size_t byteCount) const;
+
+    GPUNativeMemory &memory;
+    HostKmtSharedBacking &backing;
+    Addr readIndexAddress = 0;
+    uint64_t completionOffset = 0;
+};
+
+/**
+ * Observe the standard ROCr AQL publication boundary for one KMT queue.
+ *
+ * The bridge owns no producer state: ROCr writes packets and the write index,
+ * then publishes the last packet index through the shared doorbell.  This
+ * adapter validates that ordering and forwards only complete packet batches
+ * into the generic HostNativeQueueCore.
+ */
+class HostKmtAqlQueueObserver
+{
+  public:
+    enum class PollStatus
+    {
+        Idle,
+        Advanced,
+        Failed,
+    };
+
+    HostKmtAqlQueueObserver(
+        GPUNativeMemory &memory, HostKmtSharedBacking &backing,
+        const HostGPUKmtState::QueueInfo &queueInfo)
+        : memory(memory), backing(backing), queueInfo(queueInfo),
+          queueMemory(memory, backing, queueInfo.readPointer,
+                      queueInfo.completionOffset),
+          queueCore(queueMemory)
+    {}
+
+    bool initialize(uint64_t requestId = 0);
+    PollStatus poll(uint64_t requestId = 0);
+    void abandon();
+
+    bool isInitialized() const { return initialized; }
+    bool hasObservedThrough(uint64_t writeIndex) const
+    {
+        return initialized && queueCore.writeIndex() >= writeIndex;
+    }
+    HostNativeQueueCore &queue() { return queueCore; }
+    const HostNativeQueueCore &queue() const { return queueCore; }
+    const char *failure() const { return failureReason.c_str(); }
+
+  private:
+    PollStatus fail(const char *reason);
+
+    GPUNativeMemory &memory;
+    HostKmtSharedBacking &backing;
+    HostGPUKmtState::QueueInfo queueInfo;
+    HostKmtQueueMemory queueMemory;
+    HostNativeQueueCore queueCore;
+    std::string failureReason = "none";
+    bool initialized = false;
+    bool observedDoorbell = false;
+};
+
+} // namespace gem5::hostgpu
+
+#endif // __DEV_AMDGPU_HOST_GPU_KMT_MEMORY_HH__

+using Kmt = HostGPUKmtState;
+
+protocol::KmtRequest
+request(protocol::KmtOperation operation, uint64_t sequence)
+{
+    protocol::KmtRequest value;
+    value.operation = operation;
+    value.operationSequence = sequence;
+    return value;
+}
+
+void
+setWords(std::array<uint32_t, protocol::KmtArgumentWordCount> &words,
+         size_t high, size_t low, uint64_t value)
+{
+    words[high] = static_cast<uint32_t>(value >> 32);
+    words[low] = static_cast<uint32_t>(value);
+}
+
+void
+storeBigEndian64(uint8_t *destination, uint64_t value)
+{
+    for (size_t byte = 0; byte < sizeof(value); ++byte) {
+        destination[byte] = static_cast<uint8_t>(
+            value >> (56 - byte * 8));
+    }
+}
+
+class Notifications final : public HostKmtNativeDispatch::Notifications
+{
+  public:
+    void kmtDispatchRetired(HostKmtNativeDispatch &) override
+    {
+        ++retired;
+    }
+
+    uint64_t retired = 0;
+};
+
+class KmtNativeDispatchTest : public testing::Test
+{
+  protected:
+    static constexpr Addr AllocationBase = 0x0000400000000000ULL;
+    static constexpr uint64_t AllocationBytes = 0x10000;
+    static constexpr Addr Descriptor = AllocationBase + 0x100;
+    static constexpr Addr Code = AllocationBase + 0x200;
+    static constexpr Addr Ring = AllocationBase + 0x1000;
+    static constexpr Addr Mqd = AllocationBase + 0x3000;
+    static constexpr Addr ReadPointer =
+        Mqd + offsetof(_amd_queue_t, read_dispatch_id);
+    static constexpr Addr WritePointer =
+        Mqd + offsetof(_amd_queue_t, write_dispatch_id);
+    static constexpr Addr Kernarg = AllocationBase + 0x5000;
+    static constexpr Addr Signal = AllocationBase + 0x6000;
+    static constexpr Addr InactiveSignal = AllocationBase + 0x6100;
+    static constexpr Addr Scratch = AllocationBase + AllocationBytes;
+    static constexpr uint64_t DispatchRequestId = 91;
+    static constexpr uint64_t DoorbellRequestId = 71;
+
+    void SetUp() override
+    {
+        header.connectionId = 19;
+        header.jobEpoch = 7;
+        const auto opened = state.submit(
+            owner, header, request(protocol::KmtOperation::OpenKfd, 1));
+        ASSERT_EQ(opened.response.status, protocol::KmtStatus::Success);
+        ownerId = opened.response.ownerId;
+        ownerGeneration = opened.response.ownerGeneration;
+
+        auto exported = request(protocol::KmtOperation::ExportBacking, 2);
+        bindOwner(exported);
+        setWords(exported.argumentWords, 0, 1, Kmt::MaximumTotalBytes);
+        exported.argumentWords[2] = 4096;
+        ASSERT_EQ(state.submit(owner, header, exported).response.status,
+                  protocol::KmtStatus::Success);
+
+        auto acquired = request(protocol::KmtOperation::AcquireVm, 3);
+        bindOwner(acquired);
+        acquired.argumentWords[0] = Kmt::VisibleGpuId;
+        acquired.argumentWords[1] = 128;
+        ASSERT_EQ(state.submit(owner, header, acquired).response.status,
+                  protocol::KmtStatus::Success);
+
+        auto allocation = request(
+            protocol::KmtOperation::AllocateMemoryOfGpu, 4);
+        bindOwner(allocation);
+        setWords(allocation.argumentWords, 0, 1, AllocationBase);
+        setWords(allocation.argumentWords, 2, 3, AllocationBytes);
+        setWords(allocation.argumentWords, 4, 5, 0);
+        allocation.argumentWords[6] = Kmt::VisibleGpuId;
+        const auto allocated = state.submit(owner, header, allocation);
+        ASSERT_EQ(allocated.response.status, protocol::KmtStatus::Success);
+        auto createQueue = request(protocol::KmtOperation::QueueCreate, 5);
+        bindOwner(createQueue);
+        createQueue.argumentWords[0] = 1;
+        createQueue.argumentWords[2] = 64;
+        setWords(createQueue.argumentWords, 3, 4, Ring);
+        createQueue.copiedBytes = 24;
+        storeBigEndian64(createQueue.copiedBuffer.data(), 4096);
+        storeBigEndian64(createQueue.copiedBuffer.data() + 8, ReadPointer);
+        storeBigEndian64(createQueue.copiedBuffer.data() + 16, WritePointer);
+        createQueue.copiedCrc32c = protocol::crc32c(
+            createQueue.copiedBuffer.data(), createQueue.copiedBytes);
+        const auto created = state.submit(owner, header, createQueue);
+        ASSERT_EQ(created.response.status, protocol::KmtStatus::Success);
+        queueObjectId = created.response.objectId;
+        queueGeneration = created.response.objectGeneration;
+        const auto info = state.queueInfo(
+            owner, ownerId, ownerGeneration, queueObjectId, queueGeneration);
+        ASSERT_TRUE(info);
+
+        memory = std::make_unique<HostKmtNativeMemory>(
+            state, owner, ownerId, ownerGeneration);
+        queue = std::make_unique<HostNativeQueueCore>(*memory);
+        HostNativeQueueCore::Config config;
+        config.baseVa = Ring;
+        config.hostReadIndexVa = ReadPointer;
+        config.activeQueueId = info->clientQueueId;
+        config.generation = info->generation;
+        config.registeredIndex = info->registeredIndex;
+        config.queueBytes = 4096;
+        config.doorbellBytes = 8;
+        ASSERT_TRUE(queue->registerQueue(config));
+
+        descriptor.kernarg_size = 16;
+        descriptor.kernel_code_entry_byte_offset = Code - Descriptor;
+        ASSERT_TRUE(memory->write(
+            Descriptor, &descriptor, sizeof(descriptor)));
+        std::array<uint8_t, 16> kernarg = {};
+        ASSERT_TRUE(memory->write(Kernarg, kernarg.data(), kernarg.size()));
+        const int64_t signalKind = 1;
+        const int64_t signalValue = 1;
+        const amd_event_t staleTimestamps = {17, 23};
+        ASSERT_TRUE(memory->write(
+            Signal, &signalKind, sizeof(signalKind)));
+        ASSERT_TRUE(memory->write(
+            Signal + 8, &signalValue, sizeof(signalValue)));
+        ASSERT_TRUE(memory->write(
+            Signal + offsetof(amd_signal_t, start_ts), &staleTimestamps,
+            sizeof(staleTimestamps)));
+
+        mqd.hsa_queue.type = _HSA_QUEUE_TYPE_MULTI;
+        mqd.hsa_queue.id = info->clientQueueId;
+        mqd.hsa_queue.base_address = reinterpret_cast<void *>(Ring);
+        mqd.hsa_queue.size = 64;
+        mqd.read_dispatch_id = 0;
+        mqd.read_dispatch_id_field_base_byte_offset =
+            offsetof(_amd_queue_t, read_dispatch_id);
+        mqd.write_dispatch_id = 1;
+        ASSERT_TRUE(memory->write(Mqd, &mqd, sizeof(mqd)));
+
+        packet.header = 0x1502;
+        packet.setup = 1;
+        packet.workgroup_size_x = 1;
+        packet.workgroup_size_y = 1;
+        packet.workgroup_size_z = 1;
+        packet.grid_size_x = 1;
+        packet.grid_size_y = 1;
+        packet.grid_size_z = 1;
+        packet.kernel_object = Descriptor;
+        packet.kernarg_address = Kernarg;
+        packet.completion_signal = Signal;
+        std::array<uint8_t, HostNativeQueueCore::PacketBytes> bytes = {};
+        std::memcpy(bytes.data(), &packet, sizeof(packet));
+        ASSERT_TRUE(queue->publish(Ring, bytes.data(), bytes.size()));
+        uint32_t registered = 0;
+        ASSERT_TRUE(queue->ring(1, registered));
+        ASSERT_EQ(registered, info->registeredIndex);
+
+        dispatch = std::make_unique<HostKmtNativeDispatch>(
+            state, *memory, *queue, owner, ownerId, ownerGeneration,
+            queueObjectId, queueGeneration, notifications);
+    }
+
+    void bindOwner(protocol::KmtRequest &value)
+    {
+        value.ownerId = ownerId;
+        value.ownerGeneration = ownerGeneration;
+    }
+
+    HostKmtNativeDispatch::Config dispatchConfig(
+        uint64_t executionTicket = DispatchRequestId,
+        uint64_t sourceRequestId = DoorbellRequestId) const
+    {
+        return {32, executionTicket, sourceRequestId, 950};
+    }
+
+    void
+    overwritePacket()
+    {
+        std::array<uint8_t, HostNativeQueueCore::PacketBytes> bytes = {};
+        std::memcpy(bytes.data(), &packet, sizeof(packet));
+        ASSERT_TRUE(memory->write(Ring, bytes.data(), bytes.size()));
+    }
+
+    Kmt state;
+    Kmt::Owner owner{17, 3};
+    protocol::Header header;
+    uint64_t ownerId = 0;
+    uint64_t ownerGeneration = 0;
+    uint64_t queueObjectId = 0;
+    uint64_t queueGeneration = 0;
+    std::unique_ptr<HostKmtNativeMemory> memory;
+    std::unique_ptr<HostNativeQueueCore> queue;
+    Notifications notifications;
+    std::unique_ptr<HostKmtNativeDispatch> dispatch;
+    GTestTickHandler tickHandler;
+    AMDKernelCode descriptor = {};
+    _amd_queue_t mqd = {};
+    _hsa_dispatch_packet_t packet = {};
+};
+
+TEST_F(KmtNativeDispatchTest, RetiresStandardResidentPacketAndResourcePins)
+{
+    ASSERT_TRUE(dispatch->prepare(
+        dispatchConfig(), dispatch->lifecycle()));
+    EXPECT_TRUE(state.ownerHasDispatchPins(owner));
+    auto task = dispatch->releaseTask();
+    ASSERT_TRUE(task);
+    dispatch->lifecycle().gpuDispatcherStarted(*task);
+    task->notifyWgCompleted();
+    dispatch->lifecycle().gpuWorkgroupCompleted(*task, 0, 0);
+    ASSERT_TRUE(dispatch->lifecycle().completeKernel(*task, 0, 0));
+    dispatch->lifecycle().hsaPacketRetired(*task, 0, 0);
+
+    int64_t signalKind = 0;
+    int64_t signalValue = -1;
+    amd_event_t timestamps = {};
+    ASSERT_TRUE(memory->read(Signal, &signalKind, sizeof(signalKind)));
+    ASSERT_TRUE(memory->read(Signal + 8, &signalValue, sizeof(signalValue)));
+    ASSERT_TRUE(memory->read(
+        Signal + offsetof(amd_signal_t, start_ts), &timestamps,
+        sizeof(timestamps)));
+    EXPECT_EQ(signalKind, 1);
+    EXPECT_EQ(signalValue, 0);
+    EXPECT_GT(timestamps.start_ts, 0U);
+    EXPECT_GT(timestamps.end_ts, timestamps.start_ts);
+    EXPECT_NE(timestamps.start_ts, 17U);
+    EXPECT_NE(timestamps.end_ts, 23U);
+    EXPECT_EQ(queue->readIndex(), 1U);
+    EXPECT_FALSE(state.ownerHasDispatchPins(owner));
+    EXPECT_EQ(notifications.retired, 1U);
+    EXPECT_TRUE(dispatch->reset());
+}
+
+TEST_F(KmtNativeDispatchTest, RequiresTheWholeCompletionSignalAllocation)
+{
+    packet.completion_signal =
+        AllocationBase + AllocationBytes - sizeof(int64_t);
+    const int64_t signalKind = 1;
+    ASSERT_TRUE(memory->write(
+        packet.completion_signal, &signalKind, sizeof(signalKind)));
+    overwritePacket();
+
+    EXPECT_FALSE(dispatch->prepare(
+        dispatchConfig(), dispatch->lifecycle()));
+    EXPECT_STREQ(dispatch->failure(),
+                 "KMT dispatch resource identity lookup failed");
+    EXPECT_FALSE(dispatch->isPrepared());
+    EXPECT_FALSE(dispatch->resourcesPinned());
+    EXPECT_FALSE(state.ownerHasDispatchPins(owner));
+}
+
+TEST_F(KmtNativeDispatchTest, FailedAdmissionRollsBackFetchAndPins)
+{
+    descriptor.wgp_mode = 1;
+    ASSERT_TRUE(memory->write(
+        Descriptor, &descriptor, sizeof(descriptor)));
+    EXPECT_FALSE(dispatch->prepare(
+        dispatchConfig(), dispatch->lifecycle()));
+    EXPECT_FALSE(dispatch->isPrepared());
+    EXPECT_FALSE(dispatch->resourcesPinned());
+    EXPECT_FALSE(dispatch->lifecycle().armed());
+    EXPECT_EQ(queue->fetchIndex(), 0U);
+    EXPECT_EQ(queue->dispatchIndex(), 0U);
+    EXPECT_FALSE(state.ownerHasDispatchPins(owner));
+
+    descriptor.wgp_mode = 0;
+    ASSERT_TRUE(memory->write(
+        Descriptor, &descriptor, sizeof(descriptor)));
+    EXPECT_TRUE(dispatch->prepare(
+        dispatchConfig(), dispatch->lifecycle()));
+}
+
+TEST_F(KmtNativeDispatchTest, AcceptsNullKernargForEmptySegment)
+{
+    descriptor.group_segment_fixed_size = 64;
+    descriptor.kernarg_size = 0;
+    ASSERT_TRUE(memory->write(
+        Descriptor, &descriptor, sizeof(descriptor)));
+    packet.kernarg_address = 0;
+    overwritePacket();
+
+    ASSERT_TRUE(dispatch->prepare(
+        dispatchConfig(), dispatch->lifecycle())) << dispatch->failure();
+    EXPECT_TRUE(dispatch->resourcesPinned());
+    EXPECT_TRUE(dispatch->cancel());
+    EXPECT_FALSE(state.ownerHasDispatchPins(owner));
+}
+
+TEST_F(KmtNativeDispatchTest,
+       RequestsRuntimeScratchThenPinsTheMappedAllocation)
+{
+    descriptor.private_segment_fixed_size = 84;
+    ASSERT_TRUE(memory->write(
+        Descriptor, &descriptor, sizeof(descriptor)));
+    packet.private_segment_size = 84;
+    overwritePacket();
+
+    amd_signal_t inactive = {};
+    inactive.kind = AMD_SIGNAL_KIND_USER;
+    inactive.value = 0;
+    ASSERT_TRUE(memory->write(
+        InactiveSignal, &inactive, sizeof(inactive)));
+    mqd.queue_inactive_signal.handle = InactiveSignal;
+    ASSERT_TRUE(memory->write(Mqd, &mqd, sizeof(mqd)));
+
+    EXPECT_FALSE(dispatch->prepare(
+        dispatchConfig(), dispatch->lifecycle()));
+    EXPECT_TRUE(dispatch->scratchAllocationPending());
+    EXPECT_FALSE(dispatch->isPrepared());
+    EXPECT_FALSE(dispatch->resourcesPinned());
+    EXPECT_FALSE(state.ownerHasDispatchPins(owner));
+    EXPECT_EQ(queue->dispatchIndex(), 0U);
+    int64_t requestValue = 0;
+    ASSERT_TRUE(memory->read(
+        InactiveSignal + offsetof(amd_signal_t, value),
+        &requestValue, sizeof(requestValue)));
+    EXPECT_EQ(requestValue, 1);
+
+    auto allocation = request(
+        protocol::KmtOperation::AllocateMemoryOfGpu, 6);
+    bindOwner(allocation);
+    setWords(allocation.argumentWords, 0, 1, Scratch);
+    setWords(allocation.argumentWords, 2, 3, AllocationBytes);
+    setWords(allocation.argumentWords, 4, 5, AllocationBytes);
+    allocation.argumentWords[6] = Kmt::VisibleGpuId;
+    const auto allocated = state.submit(owner, header, allocation);
+    ASSERT_EQ(allocated.response.status, protocol::KmtStatus::Success);
+
+    auto map = request(protocol::KmtOperation::MapMemoryToGpu, 7);
+    bindOwner(map);
+    map.objectId = allocated.response.objectId;
+    map.objectGeneration = allocated.response.objectGeneration;
+    map.argumentWords[0] = 1;
+    map.copiedBytes = 4;
+    map.copiedBuffer[0] = static_cast<uint8_t>(Kmt::VisibleGpuId >> 24);
+    map.copiedBuffer[1] = static_cast<uint8_t>(Kmt::VisibleGpuId >> 16);
+    map.copiedBuffer[2] = static_cast<uint8_t>(Kmt::VisibleGpuId >> 8);
+    map.copiedBuffer[3] = static_cast<uint8_t>(Kmt::VisibleGpuId);
+    map.copiedCrc32c = protocol::crc32c(
+        map.copiedBuffer.data(), map.copiedBytes);
+    ASSERT_EQ(state.submit(owner, header, map).response.status,
+              protocol::KmtStatus::Success);
+
+    mqd.scratch_backing_memory_location = Scratch;
+    mqd.scratch_workitem_byte_size = 96;
+    mqd.compute_tmpring_size_wavesize = 6;
+    inactive.value = 0;
+    ASSERT_TRUE(memory->write(
+        InactiveSignal, &inactive, sizeof(inactive)));
+    ASSERT_TRUE(memory->write(Mqd, &mqd, sizeof(mqd)));
+
+    ASSERT_TRUE(dispatch->prepare(
+        dispatchConfig(92), dispatch->lifecycle())) << dispatch->failure();
+    EXPECT_FALSE(dispatch->scratchAllocationPending());
+    EXPECT_TRUE(dispatch->resourcesPinned());
+
+    auto free = request(protocol::KmtOperation::FreeMemoryOfGpu, 8);
+    bindOwner(free);
+    free.objectId = allocated.response.objectId;
+    free.objectGeneration = allocated.response.objectGeneration;
+    EXPECT_EQ(state.submit(owner, header, free).response.status,
+              protocol::KmtStatus::Unavailable);
+
+    ASSERT_TRUE(dispatch->cancel());
+    free.operationSequence = 9;
+    EXPECT_EQ(state.submit(owner, header, free).response.status,
+              protocol::KmtStatus::Success);
+}
+
+TEST_F(KmtNativeDispatchTest,
+       ReusesOneDoorbellBatchWithDistinctPacketExecutionTickets)
+{
+    ASSERT_TRUE(dispatch->prepare(
+        dispatchConfig(91, DoorbellRequestId), dispatch->lifecycle()));

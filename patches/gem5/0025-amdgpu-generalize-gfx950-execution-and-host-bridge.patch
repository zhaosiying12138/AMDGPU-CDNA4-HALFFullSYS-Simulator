+bool
+Wavefront::cancelZeroLaneMemoryInstruction(GPUDynInstPtr ii)
+{
+    if (ii->isScalar() || !ii->isMemRef() || !ii->exec_mask.none()) {
+        return false;
+    }
+
+    const bool reserved_flat = ii->isFlat();
+    const bool reserved_global = ii->isGlobalMem() || ii->isPrivateSeg();
+    const bool reserved_local = ii->isLocalMem();
+
+    if (!reserved_flat && !reserved_global && !reserved_local) {
+        return false;
+    }
+
+    // Mirror ScheduleStage's issued-instruction accounting.
+    if (ii->isGroupSeg()) {
+        decLGKMInstsIssued();
+        untrackLGKMInst(ii);
+    } else {
+        decVMemInstsIssued();
+        untrackVMemInst(ii);
+        if (reserved_flat) {
+            decLGKMInstsIssued();
+            untrackLGKMInst(ii);
+        }
+    }
+    if (ii->isStore() && ii->isGlobalSeg()) {
+        decExpInstsIssued();
+        untrackExpInst(ii);
+    }
+
+    const auto release_global = [&]() {
+        if (ii->isLoad()) {
+            --rdGmReqsInPipe;
+        } else if (ii->isStore()) {
+            --wrGmReqsInPipe;
+        } else if (ii->isAtomic() || ii->isMemSync()) {
+            --rdGmReqsInPipe;
+            --wrGmReqsInPipe;
+        } else {
+            panic("Invalid zero-lane global memory operation!\n");
+        }
+    };
+    const auto release_local = [&]() {
+        if (ii->isLoad()) {
+            --rdLmReqsInPipe;
+        } else if (ii->isStore()) {
+            --wrLmReqsInPipe;
+        } else if (ii->isAtomic() || ii->isMemSync()) {
+            --rdLmReqsInPipe;
+            --wrLmReqsInPipe;
+        } else {
+            panic("Invalid zero-lane local memory operation!\n");
+        }
+    };
+
+    if (reserved_flat) {
+        release_local();
+        release_global();
+    } else if (reserved_global) {
+        release_global();
+    } else {
+        release_local();
+    }
+
+    validateRequestCounters();
+    return true;
+}

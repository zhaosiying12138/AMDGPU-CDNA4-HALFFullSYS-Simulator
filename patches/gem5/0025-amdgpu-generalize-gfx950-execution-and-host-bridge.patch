+domain::CodeObjectMetadata
+codeObjectMetadata(const protocol::CodeObjectManifest &manifest)
+{
+    domain::CodeObjectMetadata metadata;
+    metadata.imageSize = manifest.imageSize;
+    metadata.kernel.index = manifest.kernelIndex;
+    metadata.kernel.imageSha256 = manifest.imageSha256;
+    metadata.kernel.name = decodeString(manifest.kernelName);
+    metadata.elfMachine = manifest.elfMachine;
+    metadata.elfType = manifest.elfType;
+    metadata.elfOsabi = manifest.elfOsabi;
+    metadata.elfAbiVersion = manifest.elfAbiVersion;
+    metadata.elfFlags = manifest.elfFlags;
+    metadata.gfxTarget = manifest.gfxTarget;
+    metadata.codeObjectVersion = manifest.codeObjectVersion;
+    metadata.metadataMajor = manifest.metadataMajor;
+    metadata.metadataMinor = manifest.metadataMinor;
+    metadata.relocationCount = manifest.relocationCount;
+    metadata.kernargSize = manifest.kernargSegmentSize;
+    metadata.kernargAlignment = manifest.kernargSegmentAlign;
+    metadata.groupSegmentBytes = manifest.groupSegmentFixedSize;
+    metadata.privateSegmentBytes = manifest.privateSegmentFixedSize;
+    metadata.maximumWorkgroupSize = manifest.maxFlatWorkgroupSize;
+    metadata.wavefrontSize = manifest.wavefrontSize;
+    metadata.sgprCount = manifest.sgprCount;
+    metadata.vgprCount = manifest.vgprCount;
+    metadata.usesDynamicStack = manifest.usesDynamicStack != 0;
+    metadata.kernelEntryOffset = manifest.kernelCodeEntryByteOffset;
+    metadata.codeVirtualAddress = manifest.codeVirtualAddress;
+    metadata.codeFileOffset = manifest.codeFileOffset;
+    metadata.codeSize = manifest.codeSize;
+    metadata.descriptorVirtualAddress = manifest.descriptorVirtualAddress;
+    metadata.descriptorFileOffset = manifest.descriptorFileOffset;
+    metadata.descriptorSymbol = decodeString(manifest.descriptorSymbol);
+    metadata.descriptor = manifest.descriptor;
+    metadata.segments.reserve(manifest.segmentCount);
+    for (uint32_t index = 0; index < manifest.segmentCount; ++index) {
+        const auto &wire = manifest.segments[index];
+        metadata.segments.push_back({wire.type, wire.flags, wire.fileOffset,
+                                     wire.virtualAddress, wire.fileSize,
+                                     wire.memorySize, wire.alignment});
+    }
+    return metadata;
+}
+
+std::optional<protocol::CodeObjectManifest>
+codeObjectManifest(const domain::CodeObjectMetadata &metadata)
+{
+    if (metadata.imageSize == 0 ||
+        metadata.imageSize > protocol::CodeObjectMaximumImageBytes ||
+        metadata.segments.empty() ||
+        metadata.segments.size() > protocol::CodeObjectMaximumSegments ||
+        metadata.imageSize > std::numeric_limits<uint64_t>::max() -
+            (protocol::CodeObjectChunkDataBytes - 1)) {
+        return std::nullopt;
+    }
+    const uint64_t chunks =
+        (metadata.imageSize + protocol::CodeObjectChunkDataBytes - 1) /
+        protocol::CodeObjectChunkDataBytes;
+    if (chunks == 0 || chunks > std::numeric_limits<uint32_t>::max())
+        return std::nullopt;
+
+    protocol::CodeObjectManifest manifest;
+    manifest.imageSize = metadata.imageSize;
+    manifest.chunkCount = static_cast<uint32_t>(chunks);
+    manifest.segmentCount = static_cast<uint32_t>(metadata.segments.size());
+    manifest.kernelIndex = metadata.kernel.index;
+    manifest.imageSha256 = metadata.kernel.imageSha256;
+    if (!encodeString(metadata.kernel.name, manifest.kernelName) ||
+        !encodeString(metadata.descriptorSymbol, manifest.descriptorSymbol)) {
+        return std::nullopt;
+    }
+    manifest.elfMachine = metadata.elfMachine;
+    manifest.elfType = metadata.elfType;
+    manifest.elfOsabi = metadata.elfOsabi;
+    manifest.elfAbiVersion = metadata.elfAbiVersion;
+    manifest.elfFlags = metadata.elfFlags;
+    manifest.gfxTarget = metadata.gfxTarget;
+    manifest.codeObjectVersion = metadata.codeObjectVersion;
+    manifest.metadataMajor = metadata.metadataMajor;
+    manifest.metadataMinor = metadata.metadataMinor;
+    manifest.relocationCount = metadata.relocationCount;
+    manifest.kernargSegmentSize = metadata.kernargSize;
+    manifest.kernargSegmentAlign = metadata.kernargAlignment;
+    manifest.groupSegmentFixedSize = metadata.groupSegmentBytes;
+    manifest.privateSegmentFixedSize = metadata.privateSegmentBytes;
+    manifest.maxFlatWorkgroupSize = metadata.maximumWorkgroupSize;
+    manifest.wavefrontSize = metadata.wavefrontSize;
+    manifest.sgprCount = metadata.sgprCount;
+    manifest.vgprCount = metadata.vgprCount;
+    manifest.usesDynamicStack = metadata.usesDynamicStack ? 1 : 0;
+    manifest.kernelCodeEntryByteOffset = metadata.kernelEntryOffset;
+    manifest.codeVirtualAddress = metadata.codeVirtualAddress;
+    manifest.codeFileOffset = metadata.codeFileOffset;
+    manifest.codeSize = metadata.codeSize;
+    manifest.descriptorVirtualAddress = metadata.descriptorVirtualAddress;
+    manifest.descriptorFileOffset = metadata.descriptorFileOffset;
+    manifest.descriptor = metadata.descriptor;
+    for (size_t index = 0; index < metadata.segments.size(); ++index) {
+        const auto &value = metadata.segments[index];
+        manifest.segments[index] = {
+            value.type, value.flags, value.fileOffset, value.virtualAddress,
+            value.fileSize, value.memorySize, value.alignment};
+    }
+    return manifest;
+}
+
+domain::BeginUpload
+beginUpload(const protocol::CodeObjectRequest &request)
+{
+    return {codeObjectMetadata(request.manifest)};
+}
+
+domain::AppendUpload
+appendUpload(const protocol::CodeObjectRequest &request)
+{
+    return {{request.objectId, request.generation}, request.imageOffset,
+            request.chunkIndex,
+            std::vector<uint8_t>(request.chunkData.begin(),
+                                 request.chunkData.begin() + request.byteCount)};
+}
+
+domain::CommitUpload
+commitUpload(const protocol::CodeObjectRequest &request)
+{
+    return {{request.objectId, request.generation}, request.byteCount,
+            request.chunkIndex, request.commitSha256};
+}
+
+protocol::CodeObjectResponse
+codeObjectResponse(
+    const protocol::CodeObjectRequest &request,
+    const domain::UploadResult &upload, uint64_t now)
+{
+    protocol::CodeObjectResponse response;
+    response.opcode = request.opcode;
+    response.status = toProtocol(upload.result.status);
+    response.simTick = now;
+    if (!upload.result.ok()) {
+        response.errorCode = static_cast<uint32_t>(response.status);
+        return response;
+    }
+    const auto &value = upload.result.value;
+    response.objectId = value.object.id;
+    response.generation = value.object.generation;
+    response.acceptedOffset = value.acceptedOffset;
+    response.byteCount = static_cast<uint32_t>(value.acceptedBytes);
+    response.chunkIndex = value.chunkIndex;
+    response.imageBytes = value.imageBytes;
+    response.kernelIndex = value.kernelIndex;
+    response.segmentCount = value.segmentCount;
+    response.imageSha256 = value.imageSha256;
+    return response;
+}
+
+protocol::CodeObjectResponse
+codeObjectFailure(
+    const protocol::CodeObjectRequest &request, protocol::Status status,
+    uint64_t now)
+{
+    domain::UploadResult result;
+    result.result.status = toDomain(status);
+    return codeObjectResponse(request, result, now);
+}
+
+domain::MapKernel
+mapKernel(const protocol::GenericDispatchRequest &request)
+{
+    return {{request.objectId, request.objectGeneration},
+            {request.kernelIndex, request.imageSha256,
+             decodeString(request.kernelName)},
+            request.map.gfxTarget, request.map.relocationCount,
+            request.map.kernargSegmentSize,
+            request.map.kernargSegmentAlign,
+            request.map.descriptorPreloadDwords, request.map.pageSize};
+}
+
+domain::AllocateKernarg
+allocateKernarg(const protocol::GenericDispatchRequest &request)
+{
+    return {{request.objectId, request.objectGeneration},
+            {request.mappingId, request.mappingGeneration},
+            request.allocKernarg.sizeBytes,
+            request.allocKernarg.alignmentBytes};
+}
+
+domain::PublishKernarg
+publishKernarg(
+    const protocol::GenericDispatchRequest &request, uint64_t offset,
+    uint64_t allocationId, uint64_t allocationGeneration,
+    std::vector<uint8_t> bytes)
+{
+    return {{request.objectId, request.objectGeneration},
+            {request.mappingId, request.mappingGeneration},
+            {allocationId, allocationGeneration}, offset, std::move(bytes)};
+}
+
+domain::SubmitKernel
+submitKernel(const protocol::GenericDispatchRequest &request)
+{
+    const auto &body = request.submit;
+    return {{request.objectId, request.objectGeneration},
+            {request.mappingId, request.mappingGeneration},
+            {body.kernargAllocationId, body.kernargGeneration},
+            {request.queueId, request.queueGeneration, request.queueSequence},
+            {body.signalId, body.signalGeneration},
+            {request.kernelIndex, request.imageSha256,
+             decodeString(request.kernelName)},
+            body.kernargOffset, body.kernargSize,
+            body.expectedSignalValueBits,
+            {{body.gridX, body.gridY, body.gridZ},
+             {body.workgroupX, body.workgroupY, body.workgroupZ},
+             body.numWarps, body.numCtas, body.sharedMemoryBytes,
+             body.wavefrontSize}};
+}
+
+domain::UnmapKernel
+unmapKernel(const protocol::GenericDispatchRequest &request)
+{
+    return {{request.objectId, request.objectGeneration},
+            {request.mappingId, request.mappingGeneration}};
+}
+
+protocol::GenericDispatchResponse
+genericMapResponse(const domain::Result<domain::MappingInfo> &result)
+{
+    if (!result.ok())
+        return genericFailure(
+            protocol::GenericDispatchOpcode::MapObject, result.status,
+            result.reason);
+    protocol::GenericDispatchResponse response;
+    response.opcode = protocol::GenericDispatchOpcode::MapObject;
+    response.status = protocol::Status::Ok;
+    fillObject(response, result.value.object, result.value.mapping);
+    response.mappedBaseVa = result.value.mappedBaseVa;
+    response.mappedEndVa = result.value.mappedEndVa;
+    response.descriptorVa = result.value.descriptorVa;
+    response.codeVa = result.value.codeVa;
+    response.entryVa = result.value.entryVa;
+    response.mappedBytes = result.value.mappedBytes;
+    response.kernelIndex = result.value.kernelIndex;
+    response.segmentCount = result.value.segmentCount;
+    response.descriptorPreloadDwords =
+        result.value.descriptorPreloadDwords;
+    response.imageSha256 = result.value.imageSha256;
+    return response;
+}
+
+protocol::GenericDispatchResponse
+genericKernargResponse(const domain::Result<domain::KernargInfo> &result)
+{
+    if (!result.ok())
+        return genericFailure(
+            protocol::GenericDispatchOpcode::AllocKernarg, result.status,
+            result.reason);
+    protocol::GenericDispatchResponse response;
+    response.opcode = protocol::GenericDispatchOpcode::AllocKernarg;
+    response.status = protocol::Status::Ok;
+    fillObject(response, result.value.object, result.value.mapping);
+    response.kernargAllocationId = result.value.allocation.id;
+    response.kernargGeneration = result.value.allocation.generation;
+    response.kernargVa = result.value.gpuVa;
+    response.kernargSize = result.value.size;
+    response.kernargAlignment = result.value.alignment;
+    response.imageSha256 = result.value.imageSha256;
+    return response;
+}
+
+protocol::GenericDispatchResponse
+genericSubmitResponse(const domain::Result<domain::DispatchAdmission> &result)
+{
+    if (!result.ok())
+        return genericFailure(
+            protocol::GenericDispatchOpcode::SubmitAql, result.status,
+            result.reason);
+    protocol::GenericDispatchResponse response;
+    response.opcode = protocol::GenericDispatchOpcode::SubmitAql;
+    response.status = protocol::Status::Ok;
+    fillObject(response, result.value.object, result.value.mapping);
+    response.kernargAllocationId = result.value.kernarg.id;
+    response.kernargGeneration = result.value.kernarg.generation;
+    response.kernargVa = result.value.kernargVa;
+    response.kernargSize = result.value.kernargBytes;
+    response.kernargAlignment = result.value.kernargAlignment;
+    response.ticketId = result.value.ticket;
+    response.traceId = result.value.trace;
+    response.queueId = result.value.queue.id;
+    response.queueGeneration = result.value.queue.generation;
+    response.queueSequence = result.value.queue.sequence;
+    response.signalId = result.value.signal.id;
+    response.signalGeneration = result.value.signal.generation;
+    response.signalValueBits = result.value.expectedSignalValue;
+    response.packetVa = result.value.packetVa;
+    response.kernelIndex = result.value.kernelIndex;
+    response.descriptorPreloadDwords =
+        result.value.descriptorPreloadDwords;
+    response.imageSha256 = result.value.imageSha256;
+    return response;
+}
+
+protocol::GenericDispatchResponse
+genericUnmapResponse(const domain::Result<domain::UnmapInfo> &result)
+{
+    if (!result.ok())
+        return genericFailure(
+            protocol::GenericDispatchOpcode::UnmapObject, result.status,
+            result.reason);
+    protocol::GenericDispatchResponse response;
+    response.opcode = protocol::GenericDispatchOpcode::UnmapObject;
+    response.status = protocol::Status::Ok;
+    fillObject(response, result.value.object, result.value.mapping);
+    response.imageSha256 = result.value.imageSha256;
+    return response;
+}
+
+} // namespace gem5::hostgpu::protocol_adapter

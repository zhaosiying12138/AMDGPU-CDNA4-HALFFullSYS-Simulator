+domain::Result<domain::Unit>
+validateCodeObjectMetadata(const domain::CodeObjectMetadata &metadata)
+{
+    domain::Result<domain::Unit> result;
+    result.reason = domain::FailureReason::InvalidRequest;
+
+    if (metadata.imageSize == 0 ||
+        metadata.imageSize > MaximumCodeObjectImageBytes ||
+        metadata.segments.empty() ||
+        metadata.segments.size() > domain::MaximumLoadSegments ||
+        !validIdentityString(metadata.kernel.name) ||
+        !validIdentityString(metadata.descriptorSymbol) ||
+        std::all_of(metadata.kernel.imageSha256.begin(),
+                    metadata.kernel.imageSha256.end(),
+                    [](uint8_t byte) { return byte == 0; }) ||
+        metadata.kernargAlignment == 0 ||
+        !powerOfTwoOrZero(metadata.kernargAlignment) ||
+        metadata.maximumWorkgroupSize == 0 ||
+        (metadata.descriptorVirtualAddress & 63U) != 0 ||
+        metadata.codeSize == 0 || !signedEntryRelationValid(metadata)) {
+        result.status = domain::Status::InvalidArgument;
+        return result;
+    }
+    if (metadata.elfMachine != AmdgpuMachine || metadata.elfType != 3 ||
+        metadata.elfOsabi != AmdgpuHsaOsabi ||
+        (metadata.elfFlags & 0xffU) != 0x4fU ||
+        metadata.elfAbiVersion < 2 || metadata.elfAbiVersion > 4 ||
+        metadata.codeObjectVersion < 4 || metadata.codeObjectVersion > 6 ||
+        metadata.metadataMajor != 1 ||
+        (metadata.metadataMinor != 1 && metadata.metadataMinor != 2)) {
+        result.status = domain::Status::UnsupportedFormat;
+        return result;
+    }
+    if (metadata.gfxTarget != 950) {
+        result.status = domain::Status::TargetMismatch;
+        return result;
+    }
+    if (metadata.relocationCount != 0 || metadata.wavefrontSize != 64 ||
+        metadata.usesDynamicStack) {
+        result.status = domain::Status::UnsupportedFeature;
+        return result;
+    }
+
+    bool executableCodeRange = false;
+    bool readOnlyDescriptorRange = false;
+    for (size_t index = 0; index < metadata.segments.size(); ++index) {
+        const auto &segment = metadata.segments[index];
+        if (segment.type != 1 || segment.memorySize < segment.fileSize ||
+            !powerOfTwoOrZero(segment.alignment) ||
+            (segment.flags != 4 && segment.flags != 5 && segment.flags != 6) ||
+            !rangeWithin(segment.fileOffset, segment.fileSize, 0,
+                         metadata.imageSize)) {
+            result.status = domain::Status::InvalidArgument;
+            return result;
+        }
+        uint64_t ignoredVirtualEnd = 0;
+        if (!rangeEnd(segment.virtualAddress, segment.memorySize,
+                      ignoredVirtualEnd)) {
+            result.status = domain::Status::InvalidArgument;
+            return result;
+        }
+        if (segment.flags == 5 &&
+            rangeWithin(metadata.codeFileOffset, metadata.codeSize,
+                        segment.fileOffset, segment.fileSize) &&
+            rangeWithin(metadata.codeVirtualAddress, metadata.codeSize,
+                        segment.virtualAddress, segment.memorySize)) {
+            executableCodeRange = true;
+        }
+        if (segment.flags == 4 &&
+            rangeWithin(metadata.descriptorFileOffset,
+                        domain::KernelDescriptorBytes,
+                        segment.fileOffset, segment.fileSize) &&
+            rangeWithin(metadata.descriptorVirtualAddress,
+                        domain::KernelDescriptorBytes,
+                        segment.virtualAddress, segment.memorySize)) {
+            readOnlyDescriptorRange = true;
+        }
+        for (size_t other = index + 1;
+             other < metadata.segments.size(); ++other) {

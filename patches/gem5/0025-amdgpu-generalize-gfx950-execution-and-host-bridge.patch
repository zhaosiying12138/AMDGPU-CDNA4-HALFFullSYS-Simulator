+ * All rights reserved.
+ */
+
+#include <gtest/gtest.h>
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+#include "dev/amdgpu/host_gpu_native_aql_control.hh"
+#include "dev/amdgpu/host_gpu_native_queue_core.hh"
+#include "dev/hsa/hsa_signal.hh"
+#include "gpu-compute/gpu_native_memory.hh"
+
+namespace gem5::hostgpu
+{
+namespace
+{
+
+class Memory final : public GPUNativeMemory
+{
+  public:
+    struct Fault
+    {
+        Addr address = 0;
+        size_t bytes = 0;
+
+        bool matches(Addr candidate, size_t candidateBytes) const
+        {
+            return address == candidate && bytes == candidateBytes;
+        }
+    };
+
+    bool read(Addr address, void *destination, size_t bytes,
+              uint64_t) const override
+    {
+        if (destination == nullptr || bytes == 0)
+            return false;
+        if (readFault && readFault->matches(address, bytes)) {
+            readFault.reset();
+            return false;
+        }
+        auto *output = static_cast<uint8_t *>(destination);
+        for (size_t index = 0; index < bytes; ++index) {
+            const auto found = values.find(address + index);
+            output[index] = found == values.end() ? 0 : found->second;
+        }
+        return true;
+    }
+
+    bool write(Addr address, const void *source, size_t bytes,
+               uint64_t) override
+    {
+        if (source == nullptr || bytes == 0)
+            return false;
+        if (writeFault && writeFault->matches(address, bytes)) {
+            writeFault.reset();
+            return false;
+        }
+        writeAddresses.push_back(address);
+        const auto *input = static_cast<const uint8_t *>(source);
+        for (size_t index = 0; index < bytes; ++index)
+            values[address + index] = input[index];
+        return true;
+    }
+
+    template <typename T>
+    void store(Addr address, T value)
+    {
+        ASSERT_TRUE(write(address, &value, sizeof(value), 1));
+    }
+
+    template <typename T>
+    T load(Addr address) const
+    {
+        T value = {};
+        EXPECT_TRUE(read(address, &value, sizeof(value), 1));
+        return value;
+    }
+
+    const std::vector<Addr> &writes() const { return writeAddresses; }
+
+    void failNextRead(Addr address, size_t bytes)
+    {
+        readFault = Fault{address, bytes};
+    }
+
+    void failNextWrite(Addr address, size_t bytes)
+    {
+        writeFault = Fault{address, bytes};
+    }
+
+  private:
+    std::unordered_map<Addr, uint8_t> values;
+    std::vector<Addr> writeAddresses;
+    mutable std::optional<Fault> readFault;
+    std::optional<Fault> writeFault;
+};
+
+class Clock
+{
+  public:
+    uint64_t sample()
+    {
+        ++sampleCount;
+        return next++;
+    }
+
+    uint64_t samples() const { return sampleCount; }
+
+  private:
+    uint64_t next = 101;
+    uint64_t sampleCount = 0;
+};
+
+template <typename T>
+void
+store(std::array<uint8_t, HostNativeQueueCore::PacketBytes> &packet,
+      size_t offset, T value)
+{
+    ASSERT_LE(offset + sizeof(value), packet.size());
+    std::memcpy(packet.data() + offset, &value, sizeof(value));
+}
+
+HostNativeQueueCore::Config
+config()
+{
+    HostNativeQueueCore::Config value;
+    value.baseVa = 0x10000;
+    value.hostReadIndexVa = 0x20000;
+    value.activeQueueId = 3;
+    value.generation = 9;
+    value.registeredIndex = 1;
+    value.queueBytes = 256;
+    value.doorbellBytes = 8;
+    return value;
+}
+
+void
+publish(HostNativeQueueCore &queue,
+        const std::array<uint8_t, HostNativeQueueCore::PacketBytes> &packet,
+        uint64_t index = 0)
+{
+    Addr address = 0;
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, index, 4, address));
+    ASSERT_TRUE(queue.publishAt(
+        index, address, packet.data(), packet.size(), index + 1));
+    uint32_t registeredIndex = 0;
+    ASSERT_TRUE(queue.ring(index + 1, registeredIndex));
+    ASSERT_EQ(registeredIndex, config().registeredIndex);
+}
+
+std::array<uint8_t, HostNativeQueueCore::PacketBytes>
+pm4Packet(Addr ibAddress, Addr completionSignal)
+{
+    std::array<uint8_t, HostNativeQueueCore::PacketBytes> packet = {};
+    store<uint16_t>(packet, 0, 0x0100);
+    store<uint16_t>(packet, 2, 1);
+    store<uint32_t>(packet, 4,
+        (3U << 30) | (2U << 16) | (0x3fU << 8));
+    store<uint32_t>(packet, 8, static_cast<uint32_t>(ibAddress));
+    store<uint32_t>(packet, 12,
+        static_cast<uint32_t>(ibAddress >> 32));
+    store<uint32_t>(packet, 16, 8U | (1U << 23));
+    store<uint32_t>(packet, 20, 0xaU);
+    store<uint64_t>(packet, 56, completionSignal);
+    return packet;
+}
+
+void
+storePm4(Memory &memory, Addr address, uint8_t opcode)
+{
+    std::array<uint32_t, 8> command = {};
+    command[0] = (3U << 30) | (6U << 16) |
+        (static_cast<uint32_t>(opcode) << 8);
+    ASSERT_TRUE(memory.write(
+        address, command.data(), command.size() * sizeof(uint32_t), 1));
+}
+
+void
+storeCompletionSignal(Memory &memory, Addr address, int64_t value = 1,
+                      int64_t kind = AMD_SIGNAL_KIND_USER)
+{
+    memory.store<int64_t>(address + offsetof(amd_signal_t, kind), kind);
+    memory.store<int64_t>(address + offsetof(amd_signal_t, value), value);
+}
+
+void
+expectNotConsumed(const HostNativeQueueCore &queue)
+{
+    EXPECT_EQ(queue.fetchIndex(), 0U);
+    EXPECT_EQ(queue.dispatchIndex(), 0U);
+    EXPECT_EQ(queue.readIndex(), 0U);
+}
+
+TEST(HostNativeAqlControl, CompletesMaintenancePm4AndSignal)
+{
+    constexpr Addr IbAddress = 0x30000;
+    constexpr Addr CompletionSignal = 0x40000;
+    Memory memory;
+    HostNativeQueueCore queue(memory);
+    Clock clock;
+    HostNativeAqlControl control([&clock]() { return clock.sample(); });
+    ASSERT_TRUE(queue.registerQueue(config(), 1));
+    storePm4(memory, IbAddress, 0x58);
+    storeCompletionSignal(memory, CompletionSignal);
+    const amd_event_t staleTimestamps = {17, 23};
+    ASSERT_TRUE(memory.write(
+        CompletionSignal + offsetof(amd_signal_t, start_ts),
+        &staleTimestamps, sizeof(staleTimestamps), 1));
+    publish(queue, pm4Packet(IbAddress, CompletionSignal));
+    const size_t writesBeforeProcess = memory.writes().size();
+
+    const auto result = control.process(queue, memory, 7);
+    EXPECT_EQ(result.status, HostNativeAqlControl::Status::Completed);
+    EXPECT_EQ(result.packetType, 0U);
+    EXPECT_EQ(result.queueIndex, 0U);
+    EXPECT_EQ(result.completionSignal, CompletionSignal);
+    EXPECT_EQ(queue.dispatchIndex(), 1U);
+    EXPECT_EQ(queue.readIndex(), 1U);
+    EXPECT_EQ(memory.load<int64_t>(CompletionSignal + 8), 0);
+    const auto timestamps = memory.load<amd_event_t>(
+        CompletionSignal + offsetof(amd_signal_t, start_ts));
+    EXPECT_EQ(timestamps.start_ts, 101U);
+    EXPECT_EQ(timestamps.end_ts, 102U);
+    EXPECT_EQ(clock.samples(), 2U);
+    ASSERT_EQ(memory.writes().size(), writesBeforeProcess + 3);
+    EXPECT_EQ(memory.writes()[writesBeforeProcess],
+              CompletionSignal + offsetof(amd_signal_t, start_ts));
+    EXPECT_EQ(memory.writes()[writesBeforeProcess + 1],
+              config().hostReadIndexVa);
+    EXPECT_EQ(memory.writes().back(),
+              CompletionSignal + offsetof(amd_signal_t, value));
+}
+
+TEST(HostNativeAqlControl, BarrierBlocksThenCompletes)
+{
+    constexpr Addr Dependency = 0x50000;
+    constexpr Addr CompletionSignal = 0x51000;
+    Memory memory;
+    HostNativeQueueCore queue(memory);
+    Clock clock;
+    HostNativeAqlControl control([&clock]() { return clock.sample(); });
+    ASSERT_TRUE(queue.registerQueue(config(), 1));
+
+    std::array<uint8_t, HostNativeQueueCore::PacketBytes> packet = {};
+    store<uint16_t>(packet, 0, 3);
+    store<uint64_t>(packet, 8, Dependency);
+    store<uint64_t>(packet, 56, CompletionSignal);
+    memory.store<uint64_t>(Dependency + 8, 1);
+    storeCompletionSignal(memory, CompletionSignal);
+    const amd_event_t staleTimestamps = {31, 37};
+    ASSERT_TRUE(memory.write(
+        CompletionSignal + offsetof(amd_signal_t, start_ts),
+        &staleTimestamps, sizeof(staleTimestamps), 1));
+    publish(queue, packet);
+
+    auto result = control.process(queue, memory, 8);
+    EXPECT_EQ(result.status, HostNativeAqlControl::Status::Blocked);
+    EXPECT_EQ(queue.fetchIndex(), 0U);
+    EXPECT_EQ(queue.dispatchIndex(), 0U);
+    EXPECT_EQ(memory.load<uint64_t>(CompletionSignal + 8), 1U);
+    EXPECT_EQ(clock.samples(), 0U);
+    auto timestamps = memory.load<amd_event_t>(
+        CompletionSignal + offsetof(amd_signal_t, start_ts));
+    EXPECT_EQ(timestamps.start_ts, staleTimestamps.start_ts);
+    EXPECT_EQ(timestamps.end_ts, staleTimestamps.end_ts);
+
+    memory.store<uint64_t>(Dependency + 8, 0);
+    result = control.process(queue, memory, 9);
+    EXPECT_EQ(result.status, HostNativeAqlControl::Status::Completed);
+    EXPECT_EQ(queue.dispatchIndex(), 1U);
+    EXPECT_EQ(memory.load<uint64_t>(CompletionSignal + 8), 0U);
+    EXPECT_EQ(clock.samples(), 2U);

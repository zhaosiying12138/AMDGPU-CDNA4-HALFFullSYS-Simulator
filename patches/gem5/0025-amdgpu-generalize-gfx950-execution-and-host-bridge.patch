+
+HostNativeAqlControl::HostNativeAqlControl(ClockSampler sampler)
+    : clockSampler(std::move(sampler))
+{}
+
+bool
+HostNativeAqlControl::validHeader(
+    uint16_t header, uint8_t expectedType) const
+{
+    const uint8_t type = static_cast<uint8_t>(header & 0xffU);
+    const uint8_t acquire = static_cast<uint8_t>((header >> 9) & 0x3U);
+    const uint8_t release = static_cast<uint8_t>((header >> 11) & 0x3U);
+    return type == expectedType && acquire <= 2 && release <= 2 &&
+        (header & 0xe000U) == 0;
+}
+
+bool
+HostNativeAqlControl::readSignal(
+    GPUNativeMemory &memory, Addr handle, uint64_t requestId,
+    uint64_t &valueBits)
+{
+    if (handle == 0) {
+        valueBits = 0;
+        return true;
+    }
+    if (handle > std::numeric_limits<Addr>::max() - SignalValueOffset ||
+        !memory.read(handle + SignalValueOffset, &valueBits,
+                     sizeof(valueBits), requestId)) {
+        failureReason = "AQL signal value is outside owner memory";
+        return false;
+    }
+    return true;
+}
+
+bool
+HostNativeAqlControl::prepareCompletionSignal(
+    GPUNativeMemory &memory, Addr handle, uint64_t requestId,
+    int64_t &value)
+{
+    value = 0;
+    if (handle == 0)
+        return true;
+
+    if (handle % alignof(amd_signal_t) != 0) {
+        failureReason = "AQL completion signal is not 64-byte aligned";
+        return false;
+    }
+    if (handle > std::numeric_limits<Addr>::max() -
+            (sizeof(amd_signal_t) - 1)) {
+        failureReason = "AQL completion signal is outside owner memory";
+        return false;
+    }
+    amd_signal_t snapshot = {};
+    if (!memory.read(handle, &snapshot, sizeof(snapshot), requestId)) {
+        failureReason = "AQL completion signal is outside owner memory";
+        return false;
+    }
+    if (snapshot.kind != AMD_SIGNAL_KIND_USER) {
+        failureReason = "AQL completion signal kind is not user";
+        return false;
+    }
+    value = snapshot.value;
+    if (value == std::numeric_limits<int64_t>::min()) {
+        failureReason = "AQL completion signal value cannot be decremented";
+        return false;
+    }
+    if (!clockSampler) {
+        failureReason = "AQL completion signal timestamp is unavailable";
+        return false;
+    }
+    const amd_event_t timestamps = {clockSampler(), clockSampler()};
+    if (timestamps.start_ts == 0 || timestamps.end_ts <= timestamps.start_ts ||
+        !memory.write(handle + SignalTimestampOffset, &timestamps,
+                      sizeof(timestamps), requestId)) {
+        failureReason = "AQL completion signal timestamp write failed";
+        return false;
+    }
+    amd_event_t readback = {};
+    if (!memory.read(handle + SignalTimestampOffset, &readback,
+                     sizeof(readback), requestId) ||
+        readback.start_ts != timestamps.start_ts ||
+        readback.end_ts != timestamps.end_ts) {
+        failureReason = "AQL completion signal timestamp readback failed";
+        return false;
+    }
+    return true;
+}
+
+bool
+HostNativeAqlControl::commitCompletionSignal(
+    GPUNativeMemory &memory, Addr handle, uint64_t requestId, int64_t value)
+{
+    if (handle == 0)
+        return true;
+    if (value == std::numeric_limits<int64_t>::min()) {
+        failureReason = "AQL completion signal value cannot be decremented";
+        return false;
+    }
+    const int64_t completed = value - 1;
+    if (handle > std::numeric_limits<Addr>::max() - SignalValueOffset ||
+        !memory.write(handle + SignalValueOffset, &completed,
+                      sizeof(completed), requestId)) {
+        failureReason =
+            "AQL completion signal final write failed after retirement";
+        return false;
+    }
+    return true;
+}
+
+bool
+HostNativeAqlControl::maintenancePm4IbValid(
+    const uint8_t *packet, GPUNativeMemory &memory, uint64_t requestId)
+{
+    const uint16_t vendorHeader = load<uint16_t>(packet, 2);
+    const uint32_t indirectHeader = load<uint32_t>(packet, 4);
+    const uint32_t indirectBaseLow = load<uint32_t>(packet, 8);
+    const uint32_t indirectBaseHigh = load<uint32_t>(packet, 12);
+    const uint32_t indirectControl = load<uint32_t>(packet, 16);
+    const uint32_t remainingDwords = load<uint32_t>(packet, 20);
+    const uint8_t type = static_cast<uint8_t>(indirectHeader >> 30);
+    const uint8_t opcode = static_cast<uint8_t>(indirectHeader >> 8);
+    const uint16_t count = static_cast<uint16_t>(
+        (indirectHeader >> 16) & 0x3fffU);
+    const uint32_t ibDwords = indirectControl & 0xfffffU;
+    const bool valid = (indirectControl & (1U << 23)) != 0;
+    const uint64_t ibAddress = static_cast<uint64_t>(indirectBaseLow) |
+        (static_cast<uint64_t>(indirectBaseHigh & 0xffffU) << 32);
+
+    if (vendorHeader != AmdPm4Ib || type != Pm4Type3 ||
+        opcode != Pm4IndirectBuffer || count != 2 ||
+        (indirectHeader & 0xffU) != 0 ||
+        (indirectBaseLow & 0x3U) != 0 || ibAddress == 0 || ibDwords == 0 ||
+        ibDwords > MaximumPm4IbBytes / sizeof(uint32_t) || !valid ||
+        (indirectControl & ~(0xfffffU | (1U << 23))) != 0 ||
+        remainingDwords != 0xaU || !allZero(packet + 24, packet + 56)) {
+        failureReason = "malformed AMD PM4 maintenance packet";
+        return false;
+    }
+
+    std::vector<uint32_t> commands;
+    try {
+        commands.resize(ibDwords);
+    } catch (const std::bad_alloc &) {
+        failureReason = "AMD PM4 maintenance staging allocation";
+        return false;
+    }
+    if (!memory.read(ibAddress, commands.data(),
+                     commands.size() * sizeof(uint32_t), requestId)) {
+        failureReason = "AMD PM4 maintenance IB is outside owner memory";
+        return false;
+    }
+
+    size_t cursor = 0;
+    while (cursor < commands.size()) {
+        const uint32_t header = commands[cursor];
+        const uint8_t commandType = static_cast<uint8_t>(header >> 30);
+        const uint8_t commandOpcode = static_cast<uint8_t>(header >> 8);
+        const uint16_t commandCount = static_cast<uint16_t>(
+            (header >> 16) & 0x3fffU);
+        const size_t commandDwords = static_cast<size_t>(commandCount) + 2;
+        if (commandType != Pm4Type3 || (header & 0xffU) != 0 ||
+            commandDwords > commands.size() - cursor) {
+            failureReason = "malformed AMD PM4 maintenance command";
+            return false;
+        }
+        if (commandOpcode == Pm4AcquireMemory) {
+            if (commandDwords != 7 && commandDwords != 8) {
+                failureReason = "unsupported AMD ACQUIRE_MEM layout";
+                return false;
+            }
+        } else if (commandOpcode != Pm4Nop) {
+            failureReason = "unsupported AMD PM4 maintenance opcode";
+            return false;
+        }
+        cursor += commandDwords;
+    }
+    return true;
+}
+
+bool
+HostNativeAqlControl::standardBarrierReady(
+    const uint8_t *packet, uint8_t packetType, GPUNativeMemory &memory,
+    uint64_t requestId, bool &ready)
+{
+    if (!validHeader(load<uint16_t>(packet, 0), packetType) ||
+        !allZero(packet + 2, packet + 8) ||
+        !allZero(packet + 48, packet + 56)) {
+        failureReason = "malformed standard AQL barrier packet";
+        return false;
+    }
+
+    ready = packetType == BarrierAnd;
+    bool hasDependency = false;
+    for (size_t index = 0; index < 5; ++index) {
+        const Addr signal = load<uint64_t>(packet, 8 + index * 8);
+        if (signal == 0)
+            continue;
+        hasDependency = true;
+        uint64_t value = 0;
+        if (!readSignal(memory, signal, requestId, value))
+            return false;
+        if (packetType == BarrierAnd && value != 0)
+            ready = false;
+        if (packetType == BarrierOr && value == 0)
+            ready = true;
+    }
+    if (!hasDependency)
+        ready = true;
+    return true;
+}
+
+bool
+HostNativeAqlControl::amdBarrierValueReady(
+    const uint8_t *packet, GPUNativeMemory &memory, uint64_t requestId,
+    bool &ready)
+{
+    const uint16_t header = load<uint16_t>(packet, 0);
+    const Addr signal = load<uint64_t>(packet, 8);
+    const uint64_t expectedBits = load<uint64_t>(packet, 16);
+    const uint64_t maskBits = load<uint64_t>(packet, 24);
+    const uint32_t condition = load<uint32_t>(packet, 32);
+    if (!validHeader(header, VendorSpecific) || packet[2] != AmdBarrierValue ||
+        packet[3] != 0 || !allZero(packet + 4, packet + 8) ||
+        !allZero(packet + 36, packet + 56) || condition > 3) {
+        failureReason = "malformed AMD barrier-value packet";
+        return false;
+    }
+    if (signal == 0) {
+        ready = true;
+        return true;
+    }
+    uint64_t valueBits = 0;
+    if (!readSignal(memory, signal, requestId, valueBits))
+        return false;
+    valueBits &= maskBits;
+    if (condition == 0) {
+        ready = valueBits == expectedBits;
+    } else if (condition == 1) {
+        ready = valueBits != expectedBits;
+    } else {
+        int64_t value = 0;
+        int64_t expected = 0;
+        std::memcpy(&value, &valueBits, sizeof(value));
+        std::memcpy(&expected, &expectedBits, sizeof(expected));
+        ready = condition == 2 ? value < expected : value >= expected;
+    }
+    return true;
+}
+
+HostNativeAqlControl::Result
+HostNativeAqlControl::failFetched(
+    HostNativeQueueCore &queue, uint64_t ticket, uint8_t packetType,
+    uint64_t queueIndex, const char *reason)
+{
+    failureReason = reason;
+    if (!queue.cancelFetch(ticket))
+        failureReason += "; queue fetch rollback failed";
+    return {Status::Failed, packetType, queueIndex, 0};
+}
+
+HostNativeAqlControl::Result
+HostNativeAqlControl::process(
+    HostNativeQueueCore &queue, GPUNativeMemory &memory, uint64_t requestId)
+{
+    failureReason = "none";
+    HostNativeQueueCore::FetchedPacket fetched;
+    if (requestId == 0 || !queue.fetch(fetched, nullptr, requestId)) {
+        failureReason = requestId == 0 ?
+            "invalid AQL control request identity" : queue.failure();
+        return {};
+    }
+
+    const uint8_t *packet = fetched.bytes.data();
+    const uint8_t packetType = packet[0];
+    if (packetType == KernelDispatch || packetType == AgentDispatch ||
+        (packetType == VendorSpecific &&
+         packet[2] == AmdExtendedKernelDispatch)) {
+        if (!queue.cancelFetch(fetched.ticket)) {
+            failureReason = "AQL dispatch packet fetch rollback failed";
+            return {Status::Failed, packetType, fetched.queueIndex, 0};
+        }
+        return {Status::NotControl, packetType, fetched.queueIndex, 0};
+    }
+    if (packetType == Invalid) {
+        if (!queue.cancelFetch(fetched.ticket)) {
+            failureReason = "invalid AQL packet fetch rollback failed";
+            return {Status::Failed, packetType, fetched.queueIndex, 0};
+        }
+        return {Status::Blocked, packetType, fetched.queueIndex, 0};
+    }
+
+    bool ready = true;
+    if (packetType == BarrierAnd || packetType == BarrierOr) {
+        if (!standardBarrierReady(
+                packet, packetType, memory, requestId, ready)) {
+            const std::string reason = failureReason;
+            return failFetched(queue, fetched.ticket, packetType,
+                               fetched.queueIndex, reason.c_str());
+        }
+    } else if (packetType == VendorSpecific && packet[2] == AmdPm4Ib) {
+        if (!validHeader(load<uint16_t>(packet, 0), VendorSpecific) ||
+            !maintenancePm4IbValid(packet, memory, requestId)) {
+            const std::string reason = failureReason == "none" ?
+                "malformed AMD PM4 maintenance header" : failureReason;
+            return failFetched(queue, fetched.ticket, packetType,
+                               fetched.queueIndex, reason.c_str());
+        }
+    } else if (packetType == VendorSpecific &&
+               packet[2] == AmdBarrierValue) {
+        if (!amdBarrierValueReady(packet, memory, requestId, ready)) {
+            const std::string reason = failureReason;
+            return failFetched(queue, fetched.ticket, packetType,
+                               fetched.queueIndex, reason.c_str());
+        }
+    } else {
+        return failFetched(queue, fetched.ticket, packetType,
+                           fetched.queueIndex,
+                           "unsupported AQL control packet type or format");
+    }
+
+    if (!ready) {
+        if (!queue.cancelFetch(fetched.ticket)) {
+            failureReason = "blocked AQL control fetch rollback failed";
+            return {Status::Failed, packetType, fetched.queueIndex, 0};
+        }
+        return {Status::Blocked, packetType, fetched.queueIndex, 0};
+    }
+
+    const Addr completionSignal =
+        load<uint64_t>(packet, CompletionSignalOffset);
+    int64_t completionValue = 0;
+    if (!prepareCompletionSignal(
+            memory, completionSignal, requestId, completionValue)) {
+        const std::string reason = failureReason;
+        return failFetched(queue, fetched.ticket, packetType,
+                           fetched.queueIndex, reason.c_str());
+    }
+    if (!queue.acceptDispatch(fetched.ticket) ||
+        !queue.retire(fetched.queueIndex, requestId)) {
+        failureReason = queue.failure();
+        return {Status::Failed, packetType, fetched.queueIndex,
+                completionSignal};
+    }
+    // Queue retirement is irreversible; a final value failure is fail-stop.
+    if (!commitCompletionSignal(
+            memory, completionSignal, requestId, completionValue)) {
+        return {Status::Failed, packetType, fetched.queueIndex,
+                completionSignal};
+    }
+    return {Status::Completed, packetType, fetched.queueIndex,
+            completionSignal};
+}
+
+} // namespace gem5::hostgpu

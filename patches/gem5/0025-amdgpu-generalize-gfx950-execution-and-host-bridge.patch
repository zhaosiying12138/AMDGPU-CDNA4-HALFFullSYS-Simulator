+namespace gem5
+{
+
+class HSAQueueEntry;
+
+namespace hostgpu
+{
+
+/**
+ * Source-neutral lifecycle for one host-native AQL dispatch.
+ *
+ * Code-object upload, wire responses, KMT handles, and framework identities do
+ * not enter this object.  A source arms it with an already registered queue,
+ * an owner-scoped memory view, and an immutable dispatch identity.  The object
+ * then enforces the common fetch -> CP -> GPU -> completion -> retirement
+ * order.  Source-specific pin release and durable notification remain behind
+ * Callbacks::retire and Callbacks::retired.
+ */
+class HostNativeExecutionLifecycle final
+    : public GPUDispatchLifecycleListener,
+      public GPUDispatchCompletionSink
+{
+  public:
+    struct Config
+    {
+        int dispatchId = 0;
+        uint64_t requestId = 0;
+        uint64_t queueIndex = 0;
+        Addr hostPacketVa = 0;
+        uint32_t registeredQueueId = 0;
+        uint64_t queueGeneration = 0;
+        /** Signal handle stored in the AQL packet. */
+        std::optional<Addr> completionSignalHandle;
+        /** Address of the signed 64-bit value decremented on completion. */
+        std::optional<Addr> completionSignalValueVa;
+        std::optional<int64_t> expectedSignalValue;
+    };
+
+    class Callbacks
+    {
+      public:
+        virtual ~Callbacks() = default;
+
+        virtual void dispatcherStarted(const HSAQueueEntry &) {}
+        virtual void waveStarted(
+            const HSAQueueEntry &, int, int, uint32_t, uint32_t, uint32_t,
+            uint64_t) {}
+        virtual void instructionStarted(
+            const HSAQueueEntry &, int, int, uint64_t, Addr, uint64_t) {}
+        virtual void globalStoreCompleted(
+            const HSAQueueEntry &, int, int, const std::vector<Addr> &,
+            uint32_t, uint64_t) {}
+        virtual void workgroupCompleted(
+            const HSAQueueEntry &, int, int) {}
+
+        /** Validate source-specific output/trace state before signal commit. */
+        virtual bool validateCompletion(
+            const HSAQueueEntry &, int, int)
+        {
+            return true;
+        }
+
+        /** Retire the source queue slot and release source-owned dispatch pins. */
+        virtual bool retire(
+            const HSAQueueEntry &, uint64_t, uint64_t) = 0;
+
+        /** Called after retirement has committed and the lifecycle is stable. */
+        virtual void retired(const HSAQueueEntry &, int, int) {}
+    };
+
+    bool arm(const Config &config, GPUNativeMemory &memory,
+             HostNativeQueueCore &queue, Callbacks &callbacks);
+
+    /** Bind a fetched packet's completion object before CP admission. */
+    bool bindCompletionSignal(
+        std::optional<Addr> handle, std::optional<Addr> valueAddress,
+        std::optional<int64_t> expectedValue = std::nullopt);
+
+    /** Clear a pre-dispatch arm after the source has rolled back its queue. */
+    bool cancel();
+
+    /** Reuse is legal only after a fully retired task. */
+    bool reset();
+
+    bool armed() const { return isArmed; }
+    bool started() const { return dispatchStarted; }
+    bool completed() const { return kernelCompleted; }
+    bool retired() const { return packetRetired; }
+    bool active() const { return dispatchActive; }
+    Tick startTick() const { return dispatchStartTick; }
+    Tick endTick() const { return dispatchEndTick; }
+    Tick retireTick() const { return dispatchRetireTick; }
+    int64_t signalBefore() const { return completionSignalBefore; }
+    int64_t signalAfter() const { return completionSignalAfter; }
+    uint64_t fetchedCount() const { return packetFetches; }
+    uint64_t submittedCount() const { return cpSubmissions; }
+    uint64_t dispatcherStartedCount() const { return dispatcherStarts; }
+    uint64_t workgroupCompletedCount() const { return workgroupCompletions; }
+    const char *failure() const { return failureReason.c_str(); }
+
+    void hsaPacketFetched(Addr hostPacketAddr, uint32_t queueId) override;
+    void commandProcessorSubmitted(const HSAQueueEntry &task) override;
+    void gpuDispatcherStarted(const HSAQueueEntry &task) override;
+    void cuWaveStarted(
+        const HSAQueueEntry &task, int cuId, int waveId,
+        uint32_t workgroupX, uint32_t workgroupY, uint32_t workgroupZ,
+        uint64_t laneMask) override;
+    void cuInstructionStarted(
+        const HSAQueueEntry &task, int cuId, int workgroupId,
+        uint64_t dynamicWaveId, Addr pc, uint64_t sequence) override;
+    void cuGlobalStoreCompleted(
+        const HSAQueueEntry &task, int cuId, int workgroupId,
+        const std::vector<Addr> &addresses, uint32_t bytesPerLane,
+        uint64_t laneMask) override;
+    void gpuWorkgroupCompleted(
+        const HSAQueueEntry &task, int cuId, int workgroupId) override;
+    bool completeKernel(
+        const HSAQueueEntry &task, int cuId, int workgroupId) override;
+    void hsaPacketRetired(
+        const HSAQueueEntry &task, int cuId, int workgroupId) override;
+
+  private:
+    struct TaskIdentity
+    {
+        Addr completionSignal = 0;
+        Addr code = 0;
+        Addr kernarg = 0;
+        std::array<int, 3> grid = {};
+        std::array<int, 3> workgroup = {};
+        int totalWorkgroups = 0;
+        bool valid = false;
+    };
+
+    bool fail(const char *reason);
+    static bool validSignalBinding(const Config &config);
+    bool taskMatches(const HSAQueueEntry &task) const;
+    bool commitSignal(const HSAQueueEntry &task);
+    void clear();
+
+    Config identity;
+    TaskIdentity taskIdentity;
+    GPUNativeMemory *addressSpace = nullptr;
+    HostNativeQueueCore *queueCore = nullptr;
+    Callbacks *sourceCallbacks = nullptr;
+    std::unordered_set<int> completedWorkgroups;
+    std::string failureReason = "none";
+    uint64_t packetFetches = 0;
+    uint64_t cpSubmissions = 0;
+    uint64_t dispatcherStarts = 0;
+    uint64_t workgroupCompletions = 0;
+    Tick dispatchStartTick = 0;
+    Tick dispatchEndTick = 0;
+    Tick dispatchRetireTick = 0;
+    int64_t completionSignalBefore = 0;
+    int64_t completionSignalAfter = 0;
+    bool isArmed = false;
+    bool dispatchActive = false;
+    bool dispatchStarted = false;
+    bool kernelCompleted = false;
+    bool packetRetired = false;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_NATIVE_EXECUTION_LIFECYCLE_HH__

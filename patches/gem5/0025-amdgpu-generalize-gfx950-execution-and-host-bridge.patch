+bool
+HostGPUKmtState::readMemory(const Owner &transportOwner, uint64_t ownerId,
+                            uint64_t ownerGeneration, uint64_t gpuVa,
+                            void *destination, uint64_t byteCount,
+                            uint64_t requestId) const
+{
+    (void)requestId;
+    if (destination == nullptr || byteCount == 0 ||
+        byteCount > std::numeric_limits<size_t>::max()) {
+        return false;
+    }
+    const auto info = memoryInfo(transportOwner, ownerId, ownerGeneration,
+                                 gpuVa, byteCount);
+    if (!info)
+        return false;
+    const size_t slot = idSlot(info->objectId);
+    if (slot >= allocations.size() || !allocations[slot] ||
+        allocations[slot]->generation != info->objectGeneration) {
+        return false;
+    }
+    const uint64_t offset = gpuVa - info->gpuVa;
+    auto *output = static_cast<uint8_t *>(destination);
+    for (uint64_t index = 0; index < byteCount; ++index) {
+        const auto found = allocations[slot]->bytes.find(offset + index);
+        output[static_cast<size_t>(index)] =
+            found == allocations[slot]->bytes.end() ? 0 : found->second;
+    }
+    return true;
+}

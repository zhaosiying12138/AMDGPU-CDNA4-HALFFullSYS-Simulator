+    // --- Inst_SOP2__S_LSHL_ADD_U32 class methods ---
+
+    Inst_SOP2__S_LSHL_ADD_U32::Inst_SOP2__S_LSHL_ADD_U32(
+        InFmt_SOP2 *iFmt, unsigned shift, const char *opcode)
+        : Inst_SOP2(iFmt, opcode), shiftAmount(shift)
+    {
+        setFlag(ALU);
+    } // Inst_SOP2__S_LSHL_ADD_U32
+
+    Inst_SOP2__S_LSHL_ADD_U32::~Inst_SOP2__S_LSHL_ADD_U32()
+    {
+    } // ~Inst_SOP2__S_LSHL_ADD_U32
+
+    // D.u = (S0.u << shiftAmount) + S1.u; SCC is the unsigned carry-out.
+    void
+    Inst_SOP2__S_LSHL_ADD_U32::execute(GPUDynInstPtr gpuDynInst)
+    {
+        ConstScalarOperandU32 src0(gpuDynInst, instData.SSRC0);
+        ConstScalarOperandU32 src1(gpuDynInst, instData.SSRC1);
+        ScalarOperandU32 sdst(gpuDynInst, instData.SDST);
+        ScalarOperandU32 scc(gpuDynInst, REG_SCC);
+
+        src0.read();
+        src1.read();
+
+        const ScalarRegU64 shifted =
+            (ScalarRegU64)src0.rawData() << shiftAmount;
+        const ScalarRegU64 result = shifted + src1.rawData();
+        sdst = (ScalarRegU32)result;
+        scc = result >> 32 ? 1 : 0;
+
+        sdst.write();
+        scc.write();
+    } // execute
+
+    // --- Inst_SOP2__S_PACK_B32_B16 class methods ---
+
+    Inst_SOP2__S_PACK_B32_B16::Inst_SOP2__S_PACK_B32_B16(
+        InFmt_SOP2 *iFmt, SourceHalf src0_half, SourceHalf src1_half,
+        const char *opcode)
+        : Inst_SOP2(iFmt, opcode), src0Half(src0_half), src1Half(src1_half)
+    {
+        setFlag(ALU);
+    } // Inst_SOP2__S_PACK_B32_B16
+
+    Inst_SOP2__S_PACK_B32_B16::~Inst_SOP2__S_PACK_B32_B16()
+    {
+    } // ~Inst_SOP2__S_PACK_B32_B16
+
+    // Select one half from each source. The src0 half forms bits [15:0] and
+    // the src1 half forms bits [31:16]. These instructions do not update SCC.
+    void
+    Inst_SOP2__S_PACK_B32_B16::execute(GPUDynInstPtr gpuDynInst)
+    {
+        ConstScalarOperandU32 src0(gpuDynInst, instData.SSRC0);
+        ConstScalarOperandU32 src1(gpuDynInst, instData.SSRC1);
+        ScalarOperandU32 sdst(gpuDynInst, instData.SDST);
+
+        src0.read();
+        src1.read();
+
+        const auto selectHalf = [](ScalarRegU32 value, SourceHalf half) {
+            const unsigned shift = half == SourceHalf::High ? 16 : 0;
+            return (value >> shift) & 0xffffu;
+        };
+        sdst = selectHalf(src0.rawData(), src0Half) |
+               (selectHalf(src1.rawData(), src1Half) << 16);
+
+        sdst.write();
+    } // execute

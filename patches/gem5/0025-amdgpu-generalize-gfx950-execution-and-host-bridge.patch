+{
+namespace
+{
+
+class Memory final : public GPUNativeMemory
+{
+  public:
+    bool read(Addr address, void *destination, size_t bytes,
+              uint64_t) const override
+    {
+        if (destination == nullptr || bytes == 0)
+            return false;
+        auto *output = static_cast<uint8_t *>(destination);
+        for (size_t index = 0; index < bytes; ++index) {
+            const auto found = values.find(address + index);
+            output[index] = found == values.end() ? 0 : found->second;
+        }
+        return true;
+    }
+
+    bool write(Addr address, const void *source, size_t bytes,
+               uint64_t) override
+    {
+        if (source == nullptr || bytes == 0)
+            return false;
+        const auto *input = static_cast<const uint8_t *>(source);
+        for (size_t index = 0; index < bytes; ++index)
+            values[address + index] = input[index];
+        return true;
+    }
+
+  private:
+    std::unordered_map<Addr, uint8_t> values;
+};
+
+std::array<uint8_t, HostNativeQueueCore::PacketBytes>
+packet(uint8_t tag)
+{
+    std::array<uint8_t, HostNativeQueueCore::PacketBytes> bytes = {};
+    bytes[0] = 2;
+    bytes[1] = tag;
+    return bytes;
+}
+
+HostNativeQueueCore::Config
+config()
+{
+    HostNativeQueueCore::Config value;
+    value.baseVa = 0x10000;
+    value.hostReadIndexVa = 0x20000;
+    value.activeQueueId = 3;
+    value.generation = 9;
+    value.registeredIndex = 1;
+    value.queueBytes = 256;
+    value.doorbellBytes = 8;
+    return value;
+}
+
+TEST(HostNativeQueueCore, RepeatedDoorbellAndBatchedPublication)
+{
+    Memory memory;
+    HostNativeQueueCore queue(memory);
+    ASSERT_TRUE(queue.registerQueue(config()));
+
+    const auto first = packet(0x11);
+    const auto second = packet(0x22);
+    Addr firstAddress = 0;
+    Addr secondAddress = 0;
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 0, 4, firstAddress));
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 1, 4, secondAddress));
+    ASSERT_TRUE(queue.publishAt(
+        0, firstAddress, first.data(), first.size()));
+    ASSERT_TRUE(queue.publishAt(
+        1, secondAddress, second.data(), second.size()));
+    uint32_t registeredIndex = 0;
+    ASSERT_TRUE(queue.ring(2, registeredIndex));
+    EXPECT_EQ(registeredIndex, 1U);
+    EXPECT_TRUE(queue.ring(2, registeredIndex));
+    EXPECT_EQ(queue.writeIndex(), 2U);
+
+    HostNativeQueueCore::FetchedPacket fetched;
+    EXPECT_FALSE(queue.ownsRetirement(0));
+    ASSERT_TRUE(queue.fetch(fetched));
+    EXPECT_EQ(fetched.queueIndex, 0U);
+    EXPECT_EQ(fetched.bytes[1], 0x11U);
+    EXPECT_FALSE(queue.ownsRetirement(fetched.queueIndex));
+    ASSERT_TRUE(queue.acceptDispatch(fetched.ticket));
+    EXPECT_TRUE(queue.ownsRetirement(fetched.queueIndex));
+    EXPECT_FALSE(queue.ownsRetirement(fetched.queueIndex + 1));
+    ASSERT_TRUE(queue.retire(0));
+    EXPECT_FALSE(queue.ownsRetirement(0));
+
+    ASSERT_TRUE(queue.fetch(fetched));
+    EXPECT_EQ(fetched.queueIndex, 1U);
+    EXPECT_EQ(fetched.bytes[1], 0x22U);
+    ASSERT_TRUE(queue.acceptDispatch(fetched.ticket));
+    EXPECT_TRUE(queue.ownsRetirement(fetched.queueIndex));
+    ASSERT_TRUE(queue.retire(1));
+    EXPECT_FALSE(queue.ownsRetirement(1));
+    EXPECT_EQ(queue.readIndex(), 2U);
+    EXPECT_TRUE(queue.unregisterQueue());
+}
+
+TEST(HostNativeQueueCore, PublicationAndRingRemainFailClosed)
+{
+    Memory memory;
+    HostNativeQueueCore queue(memory);
+    ASSERT_TRUE(queue.registerQueue(config()));
+    const auto bytes = packet(0x33);
+    Addr address = 0;
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 0, 4, address));
+    uint32_t registeredIndex = 0;
+    EXPECT_FALSE(queue.ring(1, registeredIndex));
+    EXPECT_FALSE(queue.publishAt(2, address, bytes.data(), bytes.size()));
+    ASSERT_TRUE(queue.publishAt(0, address, bytes.data(), bytes.size()));
+    EXPECT_FALSE(queue.ring(2, registeredIndex));
+    EXPECT_TRUE(queue.ring(1, registeredIndex));
+    EXPECT_FALSE(queue.ring(0, registeredIndex));
+}
+
+TEST(HostNativeQueueCore, ObservesExternallyPublishedPacketsAtomically)
+{
+    Memory memory;
+    HostNativeQueueCore queue(memory);
+    ASSERT_TRUE(queue.registerQueue(config()));
+    const auto first = packet(0x41);
+    const auto second = packet(0x42);
+    Addr firstAddress = 0;
+    Addr secondAddress = 0;
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 0, 4, firstAddress));
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 1, 4, secondAddress));
+    ASSERT_TRUE(memory.write(
+        firstAddress, first.data(), first.size(), 1));
+    ASSERT_TRUE(memory.write(
+        secondAddress, second.data(), second.size(), 2));
+
+    uint32_t registeredIndex = 0;
+    ASSERT_TRUE(queue.observe(2, registeredIndex, 3));
+    EXPECT_EQ(registeredIndex, 1U);
+    EXPECT_EQ(queue.writeIndex(), 2U);
+    EXPECT_TRUE(queue.observe(2, registeredIndex, 4));
+
+    HostNativeQueueCore::FetchedPacket fetched;
+    ASSERT_TRUE(queue.fetch(fetched));
+    EXPECT_EQ(fetched.queueIndex, 0U);
+    EXPECT_EQ(fetched.bytes[1], 0x41U);
+    ASSERT_TRUE(queue.acceptDispatch(fetched.ticket));
+    ASSERT_TRUE(queue.retire(0));
+    ASSERT_TRUE(queue.fetch(fetched));
+    EXPECT_EQ(fetched.queueIndex, 1U);
+    EXPECT_EQ(fetched.bytes[1], 0x42U);
+    ASSERT_TRUE(queue.acceptDispatch(fetched.ticket));
+    ASSERT_TRUE(queue.retire(1));
+    EXPECT_TRUE(queue.unregisterQueue());
+}
+
+TEST(HostNativeQueueCore, ObservationIsPacketTypeNeutral)
+{
+    Memory memory;
+    HostNativeQueueCore queue(memory);
+    ASSERT_TRUE(queue.registerQueue(config()));
+    const auto first = packet(0x51);
+    auto vendor = packet(0x52);
+    vendor[0] = 0;
+    Addr firstAddress = 0;
+    Addr secondAddress = 0;
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 0, 4, firstAddress));
+    ASSERT_TRUE(HostNativeQueueCore::packetAddress(
+        config().baseVa, 1, 4, secondAddress));
+    ASSERT_TRUE(memory.write(
+        firstAddress, first.data(), first.size(), 1));
+    ASSERT_TRUE(memory.write(
+        secondAddress, vendor.data(), vendor.size(), 2));
+    uint32_t registeredIndex = 0;
+    ASSERT_TRUE(queue.observe(2, registeredIndex, 3));
+    EXPECT_EQ(queue.writeIndex(), 2U);
+
+    HostNativeQueueCore::FetchedPacket fetched;
+    ASSERT_TRUE(queue.fetch(fetched));
+    EXPECT_EQ(fetched.bytes[0], 2U);
+    ASSERT_TRUE(queue.acceptDispatch(fetched.ticket));
+    ASSERT_TRUE(queue.retire(0));
+    ASSERT_TRUE(queue.fetch(fetched));
+    EXPECT_EQ(fetched.bytes[0], 0U);
+    ASSERT_TRUE(queue.acceptDispatch(fetched.ticket));
+    ASSERT_TRUE(queue.retire(1));
+}

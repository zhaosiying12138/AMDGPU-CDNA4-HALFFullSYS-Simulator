+template <size_t N>
+std::string
+decodeString(const std::array<uint8_t, N> &value)
+{
+    const auto end = std::find(value.begin(), value.end(), uint8_t(0));
+    return std::string(value.begin(), end);
+}
+
+template <size_t N>
+bool
+encodeString(const std::string &value, std::array<uint8_t, N> &output)
+{
+    if (value.empty() || value.size() >= output.size())
+        return false;
+    output = {};
+    std::copy(value.begin(), value.end(), output.begin());
+    return true;
+}
+
+protocol::GenericDispatchResponse
+genericFailure(
+    protocol::GenericDispatchOpcode opcode, domain::Status status,
+    domain::FailureReason reason)
+{
+    protocol::GenericDispatchResponse response;
+    response.opcode = opcode;
+    response.status = toProtocol(status);
+    response.errorCode = failureCode(reason);
+    return response;
+}
+
+void
+fillObject(
+    protocol::GenericDispatchResponse &response,
+    const domain::ObjectHandle &object,
+    const domain::MappingHandle &mapping)
+{
+    response.objectId = object.id;
+    response.objectGeneration = object.generation;
+    response.mappingId = mapping.id;
+    response.mappingGeneration = mapping.generation;
+}
+
+} // anonymous namespace
+
+domain::Status
+toDomain(protocol::Status status)
+{
+    switch (status) {
+      case protocol::Status::Ok:
+        return domain::Status::Ok;
+      case protocol::Status::Malformed:
+        return domain::Status::InvalidArgument;
+      case protocol::Status::UnsupportedVersion:
+        return domain::Status::UnsupportedFormat;
+      case protocol::Status::UnsupportedCapability:
+        return domain::Status::UnsupportedFeature;
+      case protocol::Status::InstanceMismatch:
+        return domain::Status::InstanceMismatch;
+      case protocol::Status::TopologyMismatch:
+        return domain::Status::TargetMismatch;
+      case protocol::Status::Unauthorized:
+        return domain::Status::OwnerMismatch;
+      case protocol::Status::Busy:
+        return domain::Status::Busy;
+      case protocol::Status::ResourceExhausted:
+        return domain::Status::ResourceExhausted;
+      case protocol::Status::ProtocolState:
+        return domain::Status::StaleState;
+      case protocol::Status::Internal:
+        return domain::Status::Internal;
+    }
+    return domain::Status::Internal;
+}
+
+protocol::Status
+toProtocol(domain::Status status)
+{
+    switch (status) {
+      case domain::Status::Ok:
+        return protocol::Status::Ok;
+      case domain::Status::InvalidArgument:
+        return protocol::Status::Malformed;
+      case domain::Status::UnsupportedFormat:
+        return protocol::Status::UnsupportedVersion;
+      case domain::Status::UnsupportedFeature:
+        return protocol::Status::UnsupportedCapability;
+      case domain::Status::InstanceMismatch:
+        return protocol::Status::InstanceMismatch;
+      case domain::Status::TargetMismatch:
+        return protocol::Status::TopologyMismatch;
+      case domain::Status::OwnerMismatch:
+        return protocol::Status::Unauthorized;
+      case domain::Status::Busy:
+        return protocol::Status::Busy;
+      case domain::Status::ResourceExhausted:
+        return protocol::Status::ResourceExhausted;
+      case domain::Status::StaleState:
+        return protocol::Status::ProtocolState;
+      case domain::Status::Internal:
+        return protocol::Status::Internal;
+    }
+    return protocol::Status::Internal;
+}
+
+uint32_t
+failureCode(domain::FailureReason reason)
+{
+    return static_cast<uint32_t>(reason);
+}
+
+domain::OwnerKey
+owner(uint64_t scope, uint64_t generation)
+{
+    return {scope, generation};
+}
+
+domain::OperationContext
+context(uint64_t scope, uint64_t generation, uint64_t leaseToken)
+{
+    return {owner(scope, generation), leaseToken};
+}
+
+domain::AllocationRequest
+allocationRequest(const protocol::MemoryRequest &request)
+{
+    return {request.byteCount, request.argument};
+}
+
+domain::MemoryRange
+memoryRange(const protocol::MemoryRequest &request)
+{
+    return {{request.allocationId, request.generation}, request.offset,
+            request.byteCount};
+}
+
+domain::Transfer
+hostTransfer(
+    const protocol::MemoryRequest &request, std::vector<uint8_t> bytes)
+{
+    return {memoryRange(request), std::move(bytes)};
+}
+
+protocol::MemoryResponse
+memoryAllocationResponse(
+    const protocol::MemoryRequest &request,
+    const domain::Result<domain::AllocationInfo> &result, uint64_t now)
+{
+    protocol::MemoryResponse response;
+    response.opcode = request.opcode;
+    response.status = toProtocol(result.status);
+    response.allocationId = result.value.allocation.id;
+    response.generation = result.value.allocation.generation;
+    if (result.ok()) {
+        response.value0 = result.value.gpuVa;
+        response.value1 = result.value.size;
+        response.value2 = result.value.alignment;
+        response.simTick = now;
+    }
+    return response;
+}
+
+protocol::MemoryResponse
+memoryUnitResponse(
+    const protocol::MemoryRequest &request,
+    const domain::Result<domain::Unit> &result, uint64_t now,
+    uint64_t checksum)
+{
+    protocol::MemoryResponse response;
+    response.opcode = request.opcode;
+    response.status = toProtocol(result.status);
+    response.allocationId = request.allocationId;
+    response.generation = request.generation;
+    if (result.ok()) {
+        if (request.opcode == protocol::MemoryOpcode::CopyH2D ||
+            request.opcode == protocol::MemoryOpcode::CopyD2H) {
+            response.value0 = request.offset;
+            response.value1 = request.byteCount;
+            response.value2 = checksum;
+        }
+        response.simTick = now;
+    }
+    return response;
+}
+
+protocol::MemoryResponse
+memoryTransferResponse(
+    const protocol::MemoryRequest &request,
+    const domain::Result<domain::Transfer> &result, uint64_t now,
+    uint64_t checksum)
+{
+    domain::Result<domain::Unit> unit;
+    unit.status = result.status;
+    unit.reason = result.reason;
+    return memoryUnitResponse(request, unit, now, checksum);
+}

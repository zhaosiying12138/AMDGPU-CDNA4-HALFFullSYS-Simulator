+
+bool
+HostKmtNativeDispatch::fail(const char *reason)
+{
+    failureReason = reason ? reason : "KMT native dispatch failure";
+    return false;
+}
+
+bool
+HostKmtNativeDispatch::rollbackFailedPrepare()
+{
+    bool ok = true;
+    if (fetched.valid() && queue.ownsPending(fetched))
+        ok = queue.cancelFetch(fetched.ticket) && ok;
+    if (executionLifecycle.armed())
+        ok = executionLifecycle.cancel() && ok;
+    if (pinned) {
+        const bool released = state.releaseDispatch(
+            transportOwner, ownerId, ownerGeneration, queueObjectId,
+            queueGeneration, activeConfig.executionTicket);
+        ok = released && ok;
+        if (released)
+            pinned = false;
+    }
+    cpResult.reset();
+    fetched = {};
+    activeConfig = {};
+    activeQueueIndex = 0;
+    profilingStartNanoseconds = 0;
+    prepared = false;
+    taskReleased = false;
+    return ok;
+}
+
+bool
+HostKmtNativeDispatch::prepare(
+    const Config &config, GPUDispatchLifecycleListener &listener)
+{
+    failureReason = "none";
+    scratchPending = false;
+    if (prepared || pinned || fetched.valid() || executionLifecycle.armed() ||
+        cpResult.task || config.dispatchId <= 0 ||
+        config.executionTicket == 0 || config.sourceRequestId == 0 ||
+        config.gfxTarget != 950 || !queue.isRegistered() ||
+        queue.config().generation != queueGeneration ||
+        queue.dispatchIndex() >= queue.writeIndex() ||
+        !(memory.transportOwnerKey() == transportOwner) ||
+        memory.ownerIdValue() != ownerId ||
+        memory.ownerGenerationValue() != ownerGeneration) {
+        return fail("invalid KMT native dispatch preparation state");
+    }
+
+    activeConfig = config;
+    activeQueueIndex = queue.dispatchIndex();
+    if (!state.pinDispatch(
+            transportOwner, ownerId, ownerGeneration, queueObjectId,
+            queueGeneration, config.executionTicket)) {
+        activeConfig = {};
+        activeQueueIndex = 0;
+        return fail("KMT dispatch resource pin failed");
+    }
+    pinned = true;
+
+    Addr packetVa = 0;
+    const uint32_t depth =
+        queue.config().queueBytes / HostNativeQueueCore::PacketBytes;
+    HostNativeExecutionLifecycle::Config lifecycleConfig;
+    lifecycleConfig.dispatchId = config.dispatchId;
+    lifecycleConfig.requestId = config.executionTicket;
+    lifecycleConfig.queueIndex = activeQueueIndex;
+    lifecycleConfig.registeredQueueId = queue.registeredIndex();
+    lifecycleConfig.queueGeneration = queue.config().generation;
+    if (!HostNativeQueueCore::packetAddress(
+            queue.config().baseVa, activeQueueIndex, depth, packetVa)) {
+        fail("KMT dispatch packet address overflow");
+        rollbackFailedPrepare();
+        return false;
+    }
+    lifecycleConfig.hostPacketVa = packetVa;
+    if (!executionLifecycle.arm(
+            lifecycleConfig, memory, queue, *this) ||
+        !queue.fetch(fetched, &listener, config.executionTicket)) {
+        fail("KMT dispatch packet fetch failed");
+        rollbackFailedPrepare();
+        return false;
+    }
+
+    _hsa_dispatch_packet_t packet = {};
+    std::memcpy(&packet, fetched.bytes.data(), sizeof(packet));
+    if (packet.completion_signal != 0) {
+        if (packet.completion_signal >
+            std::numeric_limits<Addr>::max() -
+                (sizeof(amd_signal_t) - 1)) {
+            fail("KMT completion signal address overflow");
+            rollbackFailedPrepare();
+            return false;
+        }
+        if (!executionLifecycle.bindCompletionSignal(
+                packet.completion_signal,
+                packet.completion_signal + SignalValueOffset)) {
+            fail("KMT completion signal binding failed");
+            rollbackFailedPrepare();
+            return false;
+        }
+    }
+
+    const auto resident = memory.residentKernel(
+        packet.kernel_object, config.gfxTarget);
+    if (!resident) {
+        fail("KMT resident kernel lookup failed");
+        rollbackFailedPrepare();
+        return false;
+    }
+    if (!commandProcessor.submitResident(
+            fetched, queue, *resident, memory, config.dispatchId, cpResult,
+            &listener, config.executionTicket)) {
+        const auto admission = cpResult.admission;
+        if (admission == HostNativeCommandProcessorCore::Admission::ScratchRequired ||
+            admission == HostNativeCommandProcessorCore::Admission::QueueInactive) {
+            const Addr signalHandle = cpResult.queueInactiveSignalHandle;
+            const int64_t signalValue = cpResult.queueInactiveSignalValue;
+            const bool interruptible =
+                cpResult.queueInactiveEventMailbox != 0;
+            bool waiting = signalHandle != 0 &&
+                !interruptible;
+            if (waiting && signalHandle >
+                    std::numeric_limits<Addr>::max() -
+                        offsetof(amd_signal_t, value)) {
+                waiting = false;
+            }
+            const Addr valueAddress = waiting ?
+                signalHandle + offsetof(amd_signal_t, value) : 0;
+            if (waiting && admission ==
+                    HostNativeCommandProcessorCore::Admission::ScratchRequired) {
+                waiting = signalValue == 0;
+                const int64_t scratchRequest = 1;
+                int64_t readback = 0;
+                if (waiting &&
+                    (!memory.write(
+                         valueAddress, &scratchRequest, sizeof(scratchRequest),
+                         config.executionTicket) ||
+                     !memory.read(
+                         valueAddress, &readback, sizeof(readback),
+                         config.executionTicket) ||
+                     readback != scratchRequest)) {
+                    waiting = false;
+                }
+            } else if (waiting) {
+                waiting = signalValue == 1;
+            }
+
+            const bool rolledBack = rollbackFailedPrepare();
+            if (waiting && rolledBack) {
+                scratchPending = true;
+                failureReason = "KMT queue scratch allocation pending";
+                return false;
+            }
+            return fail(!rolledBack ?
+                "KMT queue scratch rollback failed" : interruptible ?
+                "interruptible queue inactive signal is unsupported" :
+                "KMT queue scratch request failed");
+        }
+        fail(commandProcessor.failure());
+        rollbackFailedPrepare();
+        return false;
+    }
+    if (!cpResult.taskValid || !cpResult.task) {
+        fail("KMT resident command processor returned no task");
+        rollbackFailedPrepare();
+        return false;
+    }
+
+    /*
+     * The queue pin protects the ring/control object.  The packet itself may
+     * reference allocations that are unrelated to every other allocation in
+     * the owner session; pin only those exact handles so ordinary KMT frees
+     * and unmaps can proceed while this dispatch is in flight.
+     */
+    std::vector<HostGPUKmtState::AllocationRef> resources;
+    const auto addResource = [&resources](
+        const HostGPUKmtState::MemoryInfo &info) {
+        const HostGPUKmtState::AllocationRef resource{
+            info.objectId, info.objectGeneration};
+        if (std::find(resources.begin(), resources.end(), resource) ==
+            resources.end()) {
+            resources.push_back(resource);
+        }
+    };
+    const auto addRange = [&](Addr address, uint64_t bytes) {
+        const auto info = state.memoryInfo(
+            transportOwner, ownerId, ownerGeneration, address, bytes);
+        if (!info)
+            return false;
+        addResource(*info);
+        return true;
+    };
+    const auto addScratch = [&]() {
+        if (packet.private_segment_size == 0)
+            return true;
+        const uint64_t laneBytes = cpResult.mqd.scratch_workitem_byte_size;
+        if (laneBytes < packet.private_segment_size ||
+            laneBytes > std::numeric_limits<uint64_t>::max() / 64 ||
+            cpResult.mqd.scratch_backing_memory_location == 0) {
+            return false;
+        }
+        const auto info = state.memoryInfo(
+            transportOwner, ownerId, ownerGeneration,
+            cpResult.mqd.scratch_backing_memory_location, laneBytes * 64);
+        if (!info || !info->mappedToVisibleGpu)
+            return false;
+        addResource(*info);
+        return true;
+    };
+    if (!resident->allocation.id || !resident->allocation.generation) {
+        fail("KMT resident allocation identity missing");
+        rollbackFailedPrepare();
+        return false;
+    }
+    resources.push_back({
+        resident->allocation.id, resident->allocation.generation});
+    if (!addRange(queue.config().baseVa, queue.config().queueBytes) ||
+        !addRange(cpResult.mqdBaseVa, sizeof(cpResult.mqd)) ||
+        (cpResult.kernargBytesRead != 0 &&
+         !addRange(packet.kernarg_address, cpResult.kernargBytesRead)) ||
+        (packet.completion_signal != 0 &&
+         !addRange(packet.completion_signal, sizeof(amd_signal_t))) ||
+        !addScratch()) {
+        fail("KMT dispatch resource identity lookup failed");
+        rollbackFailedPrepare();
+        return false;
+    }
+    if (!state.pinDispatchResources(
+            transportOwner, ownerId, ownerGeneration, queueObjectId,
+            queueGeneration, config.executionTicket, resources)) {
+        fail("KMT dispatch resource pin failed");
+        rollbackFailedPrepare();
+        return false;
+    }
+    prepared = true;
+    scratchPending = false;
+    return true;
+}
+
+std::unique_ptr<HSAQueueEntry>
+HostKmtNativeDispatch::releaseTask()
+{
+    if (!prepared || taskReleased || !cpResult.taskValid || !cpResult.task) {
+        fail("KMT dispatch task is not releasable");
+        return nullptr;
+    }
+    taskReleased = true;
+    return cpResult.releaseTask();
+}
+
+bool
+HostKmtNativeDispatch::cancel()
+{
+    failureReason = "none";
+    if (!prepared || taskReleased || executionLifecycle.started() ||
+        executionLifecycle.active() || executionLifecycle.completed() ||
+        executionLifecycle.retired()) {
+        return fail("KMT dispatch cannot be cancelled");
+    }
+    cpResult.reset();
+    queue.abandonQueue();
+    const bool lifecycleCancelled = executionLifecycle.cancel();
+    const bool pinsReleased = pinned && state.releaseDispatch(
+        transportOwner, ownerId, ownerGeneration, queueObjectId,
+        queueGeneration, activeConfig.executionTicket);
+    if (pinsReleased)
+        pinned = false;
+    fetched = {};
+    activeConfig = {};
+    activeQueueIndex = 0;
+    profilingStartNanoseconds = 0;
+    prepared = false;
+    taskReleased = false;
+    scratchPending = false;
+    return lifecycleCancelled && pinsReleased;
+}
+
+bool
+HostKmtNativeDispatch::reset()
+{
+    failureReason = "none";
+    if (!prepared || !taskReleased || pinned ||
+        !executionLifecycle.completed() || !executionLifecycle.retired() ||
+        executionLifecycle.active() || cpResult.task) {
+        return fail("KMT dispatch is not reusable");
+    }
+    if (!executionLifecycle.reset())
+        return fail("KMT execution lifecycle reset failed");
+    cpResult.reset();
+    fetched = {};
+    activeConfig = {};
+    activeQueueIndex = 0;
+    profilingStartNanoseconds = 0;
+    prepared = false;
+    taskReleased = false;
+    scratchPending = false;
+    return true;
+}
+
+void
+HostKmtNativeDispatch::dispatcherStarted(const HSAQueueEntry &task)
+{
+    profilingStartNanoseconds = task.completionSignal() == 0 ?
+        0 : state.sampleClockNanoseconds();
+}
+
+bool
+HostKmtNativeDispatch::validateCompletion(
+    const HSAQueueEntry &task, int, int)
+{
+    const Addr signalHandle = task.completionSignal();
+    if (signalHandle == 0)
+        return profilingStartNanoseconds == 0;
+    if (profilingStartNanoseconds == 0 ||
+        signalHandle > std::numeric_limits<Addr>::max() -
+            SignalTimestampOffset) {
+        return fail("KMT completion signal profiling state mismatch");
+    }
+
+    amd_event_t timestamps = {
+        profilingStartNanoseconds, state.sampleClockNanoseconds()};
+    if (timestamps.end_ts <= timestamps.start_ts ||
+        !memory.write(signalHandle + SignalTimestampOffset, &timestamps,
+                      sizeof(timestamps), activeConfig.executionTicket)) {
+        return fail("KMT completion signal timestamp write failed");
+    }
+    amd_event_t readback = {};
+    if (!memory.read(signalHandle + SignalTimestampOffset, &readback,
+                     sizeof(readback), activeConfig.executionTicket) ||
+        readback.start_ts != timestamps.start_ts ||
+        readback.end_ts != timestamps.end_ts) {
+        return fail("KMT completion signal timestamp readback failed");
+    }
+    return true;
+}
+
+bool
+HostKmtNativeDispatch::retire(
+    const HSAQueueEntry &, uint64_t queueIndex, uint64_t requestId)
+{
+    if (!prepared || !taskReleased || !pinned ||
+        queueIndex != activeQueueIndex ||
+        requestId != activeConfig.executionTicket ||
+        !queue.retire(queueIndex, requestId) ||
+        !state.releaseDispatch(
+            transportOwner, ownerId, ownerGeneration, queueObjectId,
+            queueGeneration, requestId)) {
+        return false;
+    }
+    pinned = false;
+    return true;
+}
+
+void
+HostKmtNativeDispatch::retired(const HSAQueueEntry &, int, int)
+{
+    notifications.kmtDispatchRetired(*this);
+}
+
+} // namespace gem5::hostgpu

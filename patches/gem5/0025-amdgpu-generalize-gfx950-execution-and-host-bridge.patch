+void
+HostGPUBridge::serviceKmtDispatches()
+{
+    constexpr Tick ScratchRetryDelay = 1000000000;
+    if (activeKmtDispatch || !executionAdapter || executionAdapter->active()) {
+        return;
+    }
+    for (auto &[fd, client] : clients) {
+        if (!client)
+            continue;
+        for (auto &queue : client->kmtQueues) {
+            if (!queue || !queue->observer || !queue->control ||
+                !queue->dispatch || !client->kmtMemory) {
+                continue;
+            }
+            while (!queue->durableBatches.empty() &&
+                   queue->durableBatches.front().writeIndex <=
+                       queue->observer->queue().dispatchIndex()) {
+                queue->durableBatches.pop_front();
+            }
+            if (queue->durableBatches.empty())
+                continue;
+
+            bool controlBlocked = false;
+            while (!queue->durableBatches.empty() &&
+                   queue->durableBatches.front().writeIndex >
+                       queue->observer->queue().dispatchIndex()) {
+                const auto result = queue->control->process(
+                    queue->observer->queue(), *client->kmtMemory,
+                    queue->durableBatches.front().requestId);
+                if (result.status ==
+                        HostNativeAqlControl::Status::Completed) {
+                    while (!queue->durableBatches.empty() &&
+                           queue->durableBatches.front().writeIndex <=
+                               queue->observer->queue().dispatchIndex()) {
+                        queue->durableBatches.pop_front();
+                    }
+                    continue;
+                }
+                if (result.status == HostNativeAqlControl::Status::Blocked) {
+                    controlBlocked = true;
+                    break;
+                }
+                if (result.status ==
+                        HostNativeAqlControl::Status::NotControl) {
+                    break;
+                }
+
+                warn("%s: standard KMT AQL control admission failed: "
+                     "packet_type=%u queue_index=%llu control=%s",
+                     name(), static_cast<unsigned>(result.packetType),
+                     static_cast<unsigned long long>(result.queueIndex),
+                     queue->control->failure());
+                const uint64_t generation = client->generation;
+                const int clientFd = fd;
+                auto *event = new EventFunctionWrapper(
+                    [this, clientFd, generation]() {
+                        auto found = clients.find(clientFd);
+                        if (found != clients.end() &&
+                            found->second->generation == generation) {
+                            closeClient(clientFd);
+                        }
+                    }, name() + ".host_gpu_kmt_control_failure", true);
+                schedule(event, curTick());
+                return;
+            }
+            if (controlBlocked || queue->durableBatches.empty())
+                continue;
+            const auto start = startKmtDispatch(*client, *queue);
+            if (start == KmtDispatchStart::DeferredForScratch) {
+                if (!kmtScratchRetryEvent.scheduled()) {
+                    fatal_if(curTick() > MaxTick - ScratchRetryDelay,
+                             "%s: KMT scratch retry tick overflow", name());
+                    schedule(
+                        kmtScratchRetryEvent, curTick() + ScratchRetryDelay);
+                }
+                continue;
+            }
+            if (start == KmtDispatchStart::Failed) {
+                warn("%s: standard KMT AQL dispatch admission failed: "
+                     "observer=%s dispatch=%s adapter=%s",
+                     name(), queue->observer->failure(),
+                     queue->dispatch->failure(),
+                     executionAdapter ?
+                         executionAdapter->failureReason() : "unavailable");
+                const uint64_t generation = client->generation;
+                const int clientFd = fd;
+                auto *event = new EventFunctionWrapper(
+                    [this, clientFd, generation]() {
+                        auto found = clients.find(clientFd);
+                        if (found != clients.end() &&
+                            found->second->generation == generation) {
+                            closeClient(clientFd);
+                        }
+                    }, name() + ".host_gpu_kmt_dispatch_failure", true);
+                schedule(event, curTick());
+            }
+            return;
+        }
+    }
+}

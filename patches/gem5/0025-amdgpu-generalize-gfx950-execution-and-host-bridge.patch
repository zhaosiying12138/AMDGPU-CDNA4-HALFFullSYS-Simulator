+class ResidentKernelAdmissionTest : public testing::Test
+{
+  protected:
+    static constexpr Addr ResidentBase = 0x100000;
+    static constexpr uint64_t ResidentBytes = 0x1000;
+    static constexpr Addr Descriptor = ResidentBase + 0x100;
+    static constexpr Addr Code = ResidentBase + 0x200;
+    static constexpr Addr Ring = 0x200000;
+    static constexpr Addr Mqd = 0x300000;
+    static constexpr Addr ReadIndex = Mqd +
+        offsetof(_amd_queue_t, read_dispatch_id);
+    static constexpr Addr Kernarg = 0x400000;
+    static constexpr Addr Signal = 0x500000;
+    static constexpr Addr InactiveSignal = 0x510000;
+
+    void SetUp() override
+    {
+        memory.map(ResidentBase, ResidentBytes);
+        memory.map(Ring, 4 * HostNativeQueueCore::PacketBytes);
+        memory.map(Mqd, sizeof(_amd_queue_t));
+        memory.map(Kernarg, 16);
+        memory.map(Signal, sizeof(uint64_t));
+        memory.map(InactiveSignal, sizeof(amd_signal_t));
+
+        descriptor.kernarg_size = 16;
+        descriptor.kernel_code_entry_byte_offset = Code - Descriptor;
+        ASSERT_TRUE(memory.store(Descriptor, descriptor));
+        const uint64_t signalValue = 1;
+        ASSERT_TRUE(memory.store(Signal, signalValue));
+
+        config.baseVa = Ring;
+        config.hostReadIndexVa = ReadIndex;
+        config.activeQueueId = 7;
+        config.generation = 11;
+        config.registeredIndex = 3;
+        config.queueBytes = 4 * HostNativeQueueCore::PacketBytes;
+        config.doorbellBytes = 8;
+        ASSERT_TRUE(queue.registerQueue(config));
+
+        mqd.hsa_queue.type = _HSA_QUEUE_TYPE_MULTI;
+        mqd.hsa_queue.id = 41;
+        mqd.hsa_queue.base_address = reinterpret_cast<void *>(Ring);
+        mqd.hsa_queue.size = 4;
+        mqd.read_dispatch_id = 0;
+        mqd.read_dispatch_id_field_base_byte_offset =
+            offsetof(_amd_queue_t, read_dispatch_id);
+        mqd.write_dispatch_id = 1;
+        ASSERT_TRUE(memory.store(Mqd, mqd));
+
+        packet.header = 0x1502;
+        packet.setup = 1;
+        packet.workgroup_size_x = 1;
+        packet.workgroup_size_y = 1;
+        packet.workgroup_size_z = 1;
+        packet.grid_size_x = 1;
+        packet.grid_size_y = 1;
+        packet.grid_size_z = 1;
+        packet.kernel_object = Descriptor;
+        packet.kernarg_address = Kernarg;
+        packet.completion_signal = Signal;
+        std::array<uint8_t, HostNativeQueueCore::PacketBytes> bytes = {};
+        std::memcpy(bytes.data(), &packet, sizeof(packet));
+        ASSERT_TRUE(queue.publish(Ring, bytes.data(), bytes.size()));
+        uint32_t registeredIndex = 0;
+        ASSERT_TRUE(queue.ring(1, registeredIndex));
+        ASSERT_EQ(registeredIndex, config.registeredIndex);
+        ASSERT_TRUE(queue.fetch(fetched));
+    }
+
+    domain::ResidentKernelView resident(uint64_t bytes = ResidentBytes) const
+    {
+        domain::ResidentKernelView value;
+        value.allocation = {41, 5};
+        value.allocationBaseVa = ResidentBase;
+        value.allocationBytes = bytes;
+        value.descriptorVa = Descriptor;
+        value.expectedCodeVa = 0;
+        value.expectedEntryVa = 0;
+        value.gfxTarget = 950;
+        return value;
+    }
+
+    void
+    refetchPacket()
+    {
+        ASSERT_TRUE(queue.cancelFetch(fetched.ticket));
+        std::array<uint8_t, HostNativeQueueCore::PacketBytes> bytes = {};
+        std::memcpy(bytes.data(), &packet, sizeof(packet));
+        ASSERT_TRUE(memory.write(Ring, bytes.data(), bytes.size()));
+        ASSERT_TRUE(queue.fetch(fetched));
+    }
+
+    Memory memory;
+    HostNativeQueueCore queue{memory};
+    HostNativeQueueCore::Config config;
+    AMDKernelCode descriptor = {};
+    _amd_queue_t mqd = {};
+    _hsa_dispatch_packet_t packet = {};
+    HostNativeQueueCore::FetchedPacket fetched;
+};
+
+TEST_F(ResidentKernelAdmissionTest, DerivesDescriptorAbiFromResidentMemory)
+{
+    HostNativeCommandProcessorCore processor;
+    HostNativeCommandProcessorCore::Result result;
+    ASSERT_TRUE(processor.submitResident(
+        fetched, queue, resident(), memory, 13, result));
+    ASSERT_TRUE(result.task);
+    EXPECT_TRUE(result.descriptorRead);
+    EXPECT_TRUE(result.kernargRead);
+    EXPECT_TRUE(result.completionSignalObjectRead);
+    EXPECT_TRUE(result.mqdRead);
+    EXPECT_TRUE(result.descriptorEntryRelation);
+    EXPECT_EQ(result.descriptorAbi,
+              HostNativeCommandProcessorCore::DescriptorAbi::CodeObjectV3);
+    EXPECT_EQ(result.machineCodeVa, Code);
+    EXPECT_EQ(result.task->codeAddr(), Code);
+    EXPECT_EQ(result.task->kernelName(),
+              "resident-kernel@" + std::to_string(Descriptor));
+    EXPECT_EQ(result.task->amdQueue.hsa_queue.id, 41U);
+    EXPECT_EQ(queue.dispatchIndex(), 1U);
+    ASSERT_TRUE(queue.retire(0));
+    EXPECT_EQ(queue.readIndex(), 1U);
+}

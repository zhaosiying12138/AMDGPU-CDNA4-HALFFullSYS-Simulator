+std::unique_ptr<HostKmtSharedBacking>
+HostKmtSharedBacking::adopt(OwnedFileDescriptor descriptor, uid_t owner,
+                            uint64_t byteCount, uint32_t pageBytes)
+{
+    if (!descriptor || byteCount == 0 || pageBytes < 4096 ||
+        (pageBytes & (pageBytes - 1)) != 0 || byteCount % pageBytes != 0 ||
+        byteCount > static_cast<uint64_t>(
+            std::numeric_limits<off_t>::max())) {
+        return nullptr;
+    }
+    const int fd = descriptor.get();
+    const int descriptorFlags = ::fcntl(fd, F_GETFD);
+    const int statusFlags = ::fcntl(fd, F_GETFL);
+    const int seals = ::fcntl(fd, F_GET_SEALS);
+    struct stat metadata = {};
+    if (descriptorFlags < 0 || (descriptorFlags & FD_CLOEXEC) == 0 ||
+        statusFlags < 0 || (statusFlags & O_ACCMODE) != O_RDWR ||
+        seals < 0 ||
+        (seals & (F_SEAL_SHRINK | F_SEAL_GROW)) !=
+            (F_SEAL_SHRINK | F_SEAL_GROW) ||
+        ::fstat(fd, &metadata) != 0 || !S_ISREG(metadata.st_mode) ||
+        metadata.st_uid != owner || metadata.st_size < 0 ||
+        static_cast<uint64_t>(metadata.st_size) != byteCount) {
+        return nullptr;
+    }
+    try {
+        return std::unique_ptr<HostKmtSharedBacking>(
+            new HostKmtSharedBacking(std::move(descriptor), byteCount,
+                                     pageBytes, metadata.st_dev,
+                                     metadata.st_ino));
+    } catch (const std::bad_alloc &) {
+        return nullptr;
+    }
+}
+
+bool
+HostKmtSharedBacking::read(uint64_t offset, void *destination,
+                           size_t bytes) const
+{
+    if (destination == nullptr || bytes == 0 || offset > byteCount ||
+        bytes > byteCount - offset)
+        return false;
+    size_t completed = 0;
+    while (completed < bytes) {
+        const ssize_t result = ::pread(
+            descriptor.get(), static_cast<uint8_t *>(destination) + completed,
+            bytes - completed, static_cast<off_t>(offset + completed));
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            return false;
+        completed += static_cast<size_t>(result);
+    }
+    return true;
+}
+
+bool
+HostKmtSharedBacking::write(uint64_t offset, const void *source, size_t bytes)
+{
+    if (source == nullptr || bytes == 0 || offset > byteCount ||
+        bytes > byteCount - offset)
+        return false;
+    size_t completed = 0;
+    while (completed < bytes) {
+        const ssize_t result = ::pwrite(
+            descriptor.get(), static_cast<const uint8_t *>(source) + completed,
+            bytes - completed, static_cast<off_t>(offset + completed));
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            return false;
+        completed += static_cast<size_t>(result);
+    }
+    return true;
+}
+
+bool
+HostKmtSharedBacking::initializeQueueControl()
+{
+    if (byteCount < protocol::KmtSharedBackingDoorbellRegionBytes)
+        return false;
+    const uint64_t base =
+        byteCount - protocol::KmtSharedBackingDoorbellRegionBytes;
+    for (uint64_t slot = 0;
+         slot < protocol::KmtSharedBackingMaximumDoorbellSlots; ++slot) {
+        const uint64_t doorbellOffset = base +
+            protocol::KmtSharedBackingDoorbellRegionBaseBytes +
+            slot * protocol::KmtSharedBackingDoorbellSlotBytes;
+        const uint64_t completionOffset = base +
+            protocol::KmtSharedBackingCompletionRegionBaseBytes +
+            slot * protocol::KmtSharedBackingCompletionSlotBytes;
+        const uint64_t doorbell =
+            protocol::KmtSharedBackingDoorbellInitialValue;
+        const uint64_t completion =
+            protocol::KmtSharedBackingCompletionInitialValue;
+        if (!write(doorbellOffset, &doorbell, sizeof(doorbell)) ||
+            !write(completionOffset, &completion, sizeof(completion))) {
+            return false;
+        }
+    }
+    return true;
+}

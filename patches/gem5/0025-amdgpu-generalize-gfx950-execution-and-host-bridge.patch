+TEST(HostKmtAqlQueueObserver, PublishesStandardDoorbellBatches)
+{
+    constexpr uint64_t BackingBytes = 65536;
+    constexpr Addr RingBase = 0x400000000000ULL;
+    constexpr Addr ReadPointer = 0x500000000000ULL;
+    constexpr Addr WritePointer = ReadPointer + 8;
+    const int descriptor = ::memfd_create(
+        "gem5-kmt-aql-observer", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    ASSERT_GE(descriptor, 0);
+    ASSERT_EQ(::ftruncate(descriptor, static_cast<off_t>(BackingBytes)), 0);
+    ASSERT_EQ(::fcntl(descriptor, F_ADD_SEALS,
+                      F_SEAL_SHRINK | F_SEAL_GROW), 0);
+    auto backing = HostKmtSharedBacking::adopt(
+        OwnedFileDescriptor(descriptor), ::geteuid(), BackingBytes, 4096);
+    ASSERT_NE(backing, nullptr);
+    ASSERT_TRUE(backing->initializeQueueControl());
+
+    const uint64_t controlBase =
+        BackingBytes - protocol::KmtSharedBackingDoorbellRegionBytes;
+    HostGPUKmtState::QueueInfo info;
+    info.clientQueueId = 1;
+    info.registeredIndex = 7;
+    info.generation = 9;
+    info.ringBase = RingBase;
+    info.ringBytes = 256;
+    info.readPointer = ReadPointer;
+    info.writePointer = WritePointer;
+    info.depth = 4;
+    info.doorbellOffset = controlBase +
+        protocol::KmtSharedBackingDoorbellRegionBaseBytes;
+    info.completionOffset = controlBase +
+        protocol::KmtSharedBackingCompletionRegionBaseBytes;
+
+    Memory memory;
+    uint64_t writeIndex = 0;
+    ASSERT_TRUE(memory.write(
+        WritePointer, &writeIndex, sizeof(writeIndex), 1));
+    HostKmtAqlQueueObserver observer(memory, *backing, info);
+    ASSERT_TRUE(observer.initialize(2)) << observer.failure();
+    EXPECT_EQ(observer.poll(3),
+              HostKmtAqlQueueObserver::PollStatus::Idle);
+
+    std::array<uint8_t, HostNativeQueueCore::PacketBytes> first = {};
+    std::array<uint8_t, HostNativeQueueCore::PacketBytes> second = {};
+    first[0] = 2;
+    first[1] = 0x31;
+    second[0] = 2;
+    second[1] = 0x32;
+    ASSERT_TRUE(memory.write(RingBase, first.data(), first.size(), 4));
+    ASSERT_TRUE(memory.write(
+        RingBase + first.size(), second.data(), second.size(), 5));
+    writeIndex = 2;
+    ASSERT_TRUE(memory.write(
+        WritePointer, &writeIndex, sizeof(writeIndex), 6));
+    const uint64_t doorbell = 1;
+    ASSERT_TRUE(backing->write(
+        info.doorbellOffset, &doorbell, sizeof(doorbell)));
+    ASSERT_EQ(observer.poll(7),
+              HostKmtAqlQueueObserver::PollStatus::Advanced)
+        << observer.failure();
+    EXPECT_EQ(observer.queue().writeIndex(), 2U);
+    // A producer may publish and ring a later packet before the transport has
+    // delivered an earlier doorbell notification.  The earlier notification
+    // is satisfied once the observer has advanced beyond it.
+    EXPECT_TRUE(observer.hasObservedThrough(1));
+    EXPECT_TRUE(observer.hasObservedThrough(2));
+    EXPECT_FALSE(observer.hasObservedThrough(3));
+    EXPECT_EQ(observer.queue().config().activeQueueId, 1U);
+    EXPECT_EQ(observer.queue().registeredIndex(), 7U);
+    EXPECT_EQ(observer.poll(8),
+              HostKmtAqlQueueObserver::PollStatus::Idle);
+    EXPECT_TRUE(observer.hasObservedThrough(1));
+
+    HostNativeQueueCore::FetchedPacket fetched;
+    ASSERT_TRUE(observer.queue().fetch(fetched));
+    EXPECT_EQ(fetched.bytes[1], 0x31U);
+    ASSERT_TRUE(observer.queue().acceptDispatch(fetched.ticket));
+    ASSERT_TRUE(observer.queue().retire(0));
+    ASSERT_TRUE(observer.queue().fetch(fetched));
+    EXPECT_EQ(fetched.bytes[1], 0x32U);
+    ASSERT_TRUE(observer.queue().acceptDispatch(fetched.ticket));
+    ASSERT_TRUE(observer.queue().retire(1));
+    uint64_t completion = 0;
+    ASSERT_TRUE(backing->read(
+        info.completionOffset, &completion, sizeof(completion)));
+    EXPECT_EQ(completion, 2U);
+
+    const uint64_t reset =
+        protocol::KmtSharedBackingDoorbellInitialValue;
+    ASSERT_TRUE(backing->write(
+        info.doorbellOffset, &reset, sizeof(reset)));
+    EXPECT_EQ(observer.poll(9),
+              HostKmtAqlQueueObserver::PollStatus::Failed);
+    EXPECT_STREQ(observer.failure(),
+                 "KMT queue doorbell returned to its initial value");
+    observer.abandon();
+    EXPECT_FALSE(observer.isInitialized());
+}
+
+TEST(HostKmtAqlQueueObserver, RejectsNonemptyInitialQueue)
+{
+    constexpr uint64_t BackingBytes = 65536;
+    const int descriptor = ::memfd_create(
+        "gem5-kmt-aql-nonempty", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    ASSERT_GE(descriptor, 0);
+    ASSERT_EQ(::ftruncate(descriptor, static_cast<off_t>(BackingBytes)), 0);
+    ASSERT_EQ(::fcntl(descriptor, F_ADD_SEALS,
+                      F_SEAL_SHRINK | F_SEAL_GROW), 0);
+    auto backing = HostKmtSharedBacking::adopt(
+        OwnedFileDescriptor(descriptor), ::geteuid(), BackingBytes, 4096);
+    ASSERT_NE(backing, nullptr);
+    ASSERT_TRUE(backing->initializeQueueControl());
+
+    HostGPUKmtState::QueueInfo info;
+    info.clientQueueId = 1;
+    info.generation = 1;
+    info.ringBase = 0x600000000000ULL;
+    info.ringBytes = 64;
+    info.readPointer = 0x610000000000ULL;
+    info.writePointer = info.readPointer + 8;
+    info.depth = 1;
+    info.doorbellOffset = BackingBytes -
+        protocol::KmtSharedBackingDoorbellRegionBytes;
+    info.completionOffset = info.doorbellOffset +
+        protocol::KmtSharedBackingCompletionRegionBaseBytes;
+    Memory memory;
+    const uint64_t writeIndex = 1;
+    ASSERT_TRUE(memory.write(
+        info.writePointer, &writeIndex, sizeof(writeIndex), 1));
+    HostKmtAqlQueueObserver observer(memory, *backing, info);
+    EXPECT_FALSE(observer.initialize(2));
+    EXPECT_STREQ(observer.failure(), "KMT queue is not initially empty");
+}

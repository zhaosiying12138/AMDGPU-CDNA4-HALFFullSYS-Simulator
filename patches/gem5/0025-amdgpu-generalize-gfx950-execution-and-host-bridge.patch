+TEST_F(ResidentKernelAdmissionTest,
+       DefersScratchUntilRuntimeRewritesMqdAndClearsSignal)
+{
+    descriptor.private_segment_fixed_size = 84;
+    ASSERT_TRUE(memory.store(Descriptor, descriptor));
+    packet.private_segment_size = 84;
+    refetchPacket();
+
+    amd_signal_t inactive = {};
+    inactive.kind = AMD_SIGNAL_KIND_USER;
+    inactive.value = 0;
+    ASSERT_TRUE(memory.store(InactiveSignal, inactive));
+    mqd.queue_inactive_signal.handle = InactiveSignal;
+    ASSERT_TRUE(memory.store(Mqd, mqd));
+
+    HostNativeCommandProcessorCore processor;
+    HostNativeCommandProcessorCore::Result required;
+    EXPECT_FALSE(processor.submitResident(
+        fetched, queue, resident(), memory, 13, required));
+    EXPECT_EQ(required.admission,
+              HostNativeCommandProcessorCore::Admission::ScratchRequired);
+    EXPECT_EQ(required.queueInactiveSignalHandle, InactiveSignal);
+    EXPECT_EQ(queue.dispatchIndex(), 0U);
+    EXPECT_TRUE(queue.ownsPending(fetched));
+
+    inactive.value = 1;
+    ASSERT_TRUE(memory.store(InactiveSignal, inactive));
+    HostNativeCommandProcessorCore::Result inactiveResult;
+    EXPECT_FALSE(processor.submitResident(
+        fetched, queue, resident(), memory, 14, inactiveResult));
+    EXPECT_EQ(inactiveResult.admission,
+              HostNativeCommandProcessorCore::Admission::QueueInactive);
+    EXPECT_EQ(queue.dispatchIndex(), 0U);
+    EXPECT_TRUE(queue.ownsPending(fetched));
+
+    inactive.value = 0;
+    ASSERT_TRUE(memory.store(InactiveSignal, inactive));
+    mqd.scratch_backing_memory_location = 0x700000;
+    mqd.scratch_workitem_byte_size = 96;
+    mqd.compute_tmpring_size_wavesize = 6;
+    ASSERT_TRUE(memory.store(Mqd, mqd));
+    HostNativeCommandProcessorCore::Result ready;
+    ASSERT_TRUE(processor.submitResident(
+        fetched, queue, resident(), memory, 15, ready)) << processor.failure();
+    EXPECT_EQ(ready.admission,
+              HostNativeCommandProcessorCore::Admission::Ready);
+    EXPECT_EQ(queue.dispatchIndex(), 1U);
+    ASSERT_TRUE(queue.retire(0));
+}

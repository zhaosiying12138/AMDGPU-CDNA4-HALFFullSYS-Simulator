+inline uint32_t
+true16FloatConstant(unsigned selector, uint32_t raw)
+{
+    switch (selector) {
+      case REG_POS_HALF:
+        return 0x3800u;
+      case REG_NEG_HALF:
+        return 0xb800u;
+      case REG_POS_ONE:
+        return 0x3c00u;
+      case REG_NEG_ONE:
+        return 0xbc00u;
+      case REG_POS_TWO:
+        return 0x4000u;
+      case REG_NEG_TWO:
+        return 0xc000u;
+      case REG_POS_FOUR:
+        return 0x4400u;
+      case REG_NEG_FOUR:
+        return 0xc400u;
+      case REG_PI:
+        return 0x3118u;
+      default:
+        return raw;
+    }
+}
+
+inline uint16_t
+selectTrue16Source(uint32_t raw, unsigned selector, bool high,
+                   bool absolute, bool negate)
+{
+    raw = true16FloatConstant(selector, raw);
+    uint16_t value = static_cast<uint16_t>(raw >> (high ? 16 : 0));
+    if (absolute)
+        value &= 0x7fffu;
+    if (negate)
+        value ^= 0x8000u;
+    return value;
+}
+
+inline uint32_t
+packB32F16(uint32_t raw0, unsigned selector0, uint32_t raw1,
+           unsigned selector1, unsigned opsel, unsigned abs, unsigned neg)
+{
+    const uint32_t lower = selectTrue16Source(
+        raw0, selector0, opsel & 0x1u, abs & 0x1u, neg & 0x1u);
+    const uint32_t upper = selectTrue16Source(
+        raw1, selector1, opsel & 0x2u, abs & 0x2u, neg & 0x2u);
+    return lower | (upper << 16);
+}
+

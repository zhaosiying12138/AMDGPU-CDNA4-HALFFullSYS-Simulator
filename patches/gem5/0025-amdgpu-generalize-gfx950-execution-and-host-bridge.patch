+#include <cmath>
+#include <cstdint>
+#include <limits>
+
 #include <gtest/gtest.h>
 
 #include "arch/amdgpu/common/dtype/mxfp_types.hh"
 
+namespace
+{
+
+uint16_t
+bf16Bits(float value)
+{
+    return static_cast<uint16_t>(gem5::AMDGPU::mxbfloat16(value).data >> 16);
+}
+
+} // anonymous namespace
+
 template<typename T>
 bool test_raw_mxfp(T raw_mxfp, int bits)
 {
@@ -87,6 +102,66 @@ TEST(MxfpTest, MxBf16PackedStorageOrder)
     EXPECT_EQ(upper.data | (lower.data >> 16), 0xc0003f80u);
 }
 
+TEST(MxfpTest, MxBf16RoundTiesToEven)
+{
+    // Halfway above an odd retained mantissa must increment to the even value.
+    EXPECT_EQ(bf16Bits(0.521484375f), 0x3f06u);
+    EXPECT_EQ(bf16Bits(-0.662109375f), 0xbf2au);
+
+    // Halfway above an even retained mantissa must remain unchanged.
+    EXPECT_EQ(bf16Bits(1.00390625f), 0x3f80u);
+    EXPECT_EQ(bf16Bits(-1.00390625f), 0xbf80u);
+}
+
+TEST(MxfpTest, MxBf16RoundNonTies)
+{
+    constexpr float even_halfway = 1.00390625f;
+    const float below = std::nextafter(even_halfway, 0.0f);
+    const float above = std::nextafter(
+        even_halfway, std::numeric_limits<float>::infinity());
+
+    EXPECT_EQ(bf16Bits(below), 0x3f80u);
+    EXPECT_EQ(bf16Bits(above), 0x3f81u);
+    EXPECT_EQ(bf16Bits(-below), 0xbf80u);
+    EXPECT_EQ(bf16Bits(-above), 0xbf81u);
+
+    // Values adjacent to a tie with an odd lower result must not be mistaken
+    // for the tie itself.
+    constexpr float odd_halfway = 0.521484375f;
+    const float odd_below = std::nextafter(odd_halfway, 0.0f);
+    const float odd_above = std::nextafter(
+        odd_halfway, std::numeric_limits<float>::infinity());
+    EXPECT_EQ(bf16Bits(odd_below), 0x3f05u);
+    EXPECT_EQ(bf16Bits(odd_above), 0x3f06u);
+    EXPECT_EQ(bf16Bits(-odd_below), 0xbf05u);
+    EXPECT_EQ(bf16Bits(-odd_above), 0xbf06u);
+}
+
+TEST(MxfpTest, MxBf16AssignmentUsesRoundTiesToEven)
+{
+    gem5::AMDGPU::mxbfloat16 value;
+    value = -0.662109375f;
+    EXPECT_EQ(value.data >> 16, 0xbf2au);
+}
+
+TEST(MxfpTest, MxBf16NaNAndInfinity)
+{
+    const float inf = std::numeric_limits<float>::infinity();
+    EXPECT_EQ(bf16Bits(inf), 0x7f80u);
+    EXPECT_EQ(bf16Bits(-inf), 0xff80u);
+
+    const uint16_t positive_nan =
+        bf16Bits(std::numeric_limits<float>::quiet_NaN());
+    const uint16_t negative_nan =
+        bf16Bits(-std::numeric_limits<float>::quiet_NaN());
+    EXPECT_EQ(positive_nan & 0x7f80u, 0x7f80u);
+    EXPECT_NE(positive_nan & 0x007fu, 0u);
+    EXPECT_EQ(positive_nan & 0x8000u, 0u);
+    EXPECT_EQ(negative_nan & 0x7f80u, 0x7f80u);
+    EXPECT_NE(negative_nan & 0x007fu, 0u);
+    EXPECT_EQ(negative_nan & 0x8000u, 0x8000u);
+}
+
 TEST(MxfpTest, MxFp16Test)
 {
     using T = gem5::AMDGPU::mxfloat16;

+TEST(HostGPUKmtState, QueueControlIdentityIsPerOwnerAndReusable)
+{
+    Kmt state;
+    const auto ownerA = transport(17, 31);
+    const auto ownerB = transport(18, 32);
+    const auto headerA = header(5, 41);
+    const auto headerB = header(5, 42);
+    const auto openedA = state.submit(
+        ownerA, headerA, request(protocol::KmtOperation::OpenKfd, 1));
+    const auto openedB = state.submit(
+        ownerB, headerB, request(protocol::KmtOperation::OpenKfd, 1));
+    ASSERT_EQ(openedA.response.status, protocol::KmtStatus::Success);
+    ASSERT_EQ(openedB.response.status, protocol::KmtStatus::Success);
+
+    auto exportFor = [](const protocol::KmtResponse &opened,
+                        uint64_t sequence) {
+        auto value = request(protocol::KmtOperation::ExportBacking, sequence);
+        value.ownerId = opened.ownerId;
+        value.ownerGeneration = opened.ownerGeneration;
+        setWords(value.argumentWords, 0, 1, Kmt::MaximumTotalBytes);
+        value.argumentWords[2] = 4096;
+        return value;
+    };
+    ASSERT_EQ(state.submit(ownerA, headerA, exportFor(openedA.response, 2))
+                  .response.status,
+              protocol::KmtStatus::Success);
+    ASSERT_EQ(state.submit(ownerB, headerB, exportFor(openedB.response, 2))
+                  .response.status,
+              protocol::KmtStatus::Success);
+
+    auto createFor = [](const protocol::KmtResponse &opened,
+                        uint64_t sequence, uint64_t ringBase) {
+        auto value = request(protocol::KmtOperation::QueueCreate, sequence);
+        value.ownerId = opened.ownerId;
+        value.ownerGeneration = opened.ownerGeneration;
+        value.argumentWords[0] = 1;
+        value.argumentWords[2] = 64;
+        setWords(value.argumentWords, 3, 4, ringBase);
+        value.copiedBytes = 24;
+        const std::array<uint64_t, 3> fields = {
+            4096, ringBase + 0x2000, ringBase + 0x2008};
+        for (size_t field = 0; field < fields.size(); ++field) {
+            for (size_t byte = 0; byte < 8; ++byte) {
+                value.copiedBuffer[field * 8 + byte] =
+                    static_cast<uint8_t>(fields[field] >>
+                                         (56 - byte * 8));
+            }
+        }
+        value.copiedCrc32c = protocol::crc32c(
+            value.copiedBuffer.data(), value.copiedBytes);
+        return value;
+    };
+
+    const auto firstA = state.submit(
+        ownerA, headerA,
+        createFor(openedA.response, 3, 0x0000400000000000ULL));
+    const auto firstB = state.submit(
+        ownerB, headerB,
+        createFor(openedB.response, 3, 0x0000410000000000ULL));
+    const auto secondA = state.submit(
+        ownerA, headerA,
+        createFor(openedA.response, 4, 0x0000420000000000ULL));
+    ASSERT_EQ(firstA.response.status, protocol::KmtStatus::Success);
+    ASSERT_EQ(firstB.response.status, protocol::KmtStatus::Success);
+    ASSERT_EQ(secondA.response.status, protocol::KmtStatus::Success);
+
+    const auto infoA = state.queueInfo(
+        ownerA, openedA.response.ownerId, openedA.response.ownerGeneration,
+        firstA.response.objectId, firstA.response.objectGeneration);
+    const auto infoB = state.queueInfo(
+        ownerB, openedB.response.ownerId, openedB.response.ownerGeneration,
+        firstB.response.objectId, firstB.response.objectGeneration);
+    const auto infoA2 = state.queueInfo(
+        ownerA, openedA.response.ownerId, openedA.response.ownerGeneration,
+        secondA.response.objectId, secondA.response.objectGeneration);
+    ASSERT_TRUE(infoA);
+    ASSERT_TRUE(infoB);
+    ASSERT_TRUE(infoA2);
+    EXPECT_EQ(infoA->clientQueueId, 1U);
+    EXPECT_EQ(infoB->clientQueueId, 1U);
+    EXPECT_EQ(infoA2->clientQueueId, 2U);
+    EXPECT_EQ(infoA->registeredIndex, 0U);
+    EXPECT_EQ(infoB->registeredIndex, 1U);
+    EXPECT_EQ(infoA2->registeredIndex, 2U);
+    EXPECT_EQ(infoA->doorbellOffset, infoB->doorbellOffset);
+    EXPECT_EQ(infoA2->doorbellOffset,
+              infoA->doorbellOffset +
+                  protocol::KmtSharedBackingDoorbellSlotBytes);
+
+    auto destroyA = request(protocol::KmtOperation::QueueDestroy, 5);
+    destroyA.ownerId = openedA.response.ownerId;
+    destroyA.ownerGeneration = openedA.response.ownerGeneration;
+    destroyA.objectId = firstA.response.objectId;
+    destroyA.objectGeneration = firstA.response.objectGeneration;
+    ASSERT_EQ(state.submit(ownerA, headerA, destroyA).response.status,
+              protocol::KmtStatus::Success);
+    const auto replacementA = state.submit(
+        ownerA, headerA,
+        createFor(openedA.response, 6, 0x0000430000000000ULL));
+    ASSERT_EQ(replacementA.response.status, protocol::KmtStatus::Success);
+    const auto replacementInfo = state.queueInfo(
+        ownerA, openedA.response.ownerId, openedA.response.ownerGeneration,
+        replacementA.response.objectId,
+        replacementA.response.objectGeneration);
+    ASSERT_TRUE(replacementInfo);
+    EXPECT_EQ(replacementInfo->clientQueueId, 1U);
+    EXPECT_EQ(replacementInfo->registeredIndex, 0U);
+    EXPECT_EQ(replacementInfo->doorbellOffset, infoA->doorbellOffset);
+}

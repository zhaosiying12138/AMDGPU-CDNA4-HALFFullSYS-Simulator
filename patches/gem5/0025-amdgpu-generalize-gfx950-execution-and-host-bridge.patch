+bool
+HostGPUKmtState::pinDispatch(
+    const Owner &transportOwner, uint64_t ownerId, uint64_t ownerGeneration,
+    uint64_t queueObjectId, uint64_t queueGeneration, uint64_t requestId)
+{
+    Session *session = findSession(
+        transportOwner, ownerId, ownerGeneration);
+    if (!session || requestId == 0 ||
+        !idHasPrefix(queueObjectId, QueuePrefix)) {
+        return false;
+    }
+    const size_t queueSlot = idSlot(queueObjectId);
+    if (queueSlot >= queues.size() || !queues[queueSlot])
+        return false;
+    Queue &queue = *queues[queueSlot];
+    if (queue.ownerId != ownerId ||
+        queue.ownerGeneration != ownerGeneration ||
+        queue.generation != queueGeneration ||
+        queue.dispatchPins.count(requestId) != 0) {
+        return false;
+    }

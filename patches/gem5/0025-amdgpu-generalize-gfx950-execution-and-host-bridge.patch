+HostGPUBridge::KmtDispatchStart
+HostGPUBridge::startKmtDispatch(
+    Client &client, Client::KmtQueueSession &queueSession)
+{
+    if (!executionEnabled || !executionAdapter || !gpuDispatcher || !shader ||
+        activeKmtDispatch || executionAdapter->active() ||
+        queueSession.durableBatches.empty() || !queueSession.observer ||
+        !queueSession.dispatch || !client.kmtMemory ||
+        shader->getGfxVersion() != GfxVersion::gfx950) {
+        return KmtDispatchStart::Failed;
+    }
+    auto &queue = queueSession.observer->queue();
+    const auto &batch = queueSession.durableBatches.front();
+    if (batch.requestId == 0 || batch.writeIndex <= queue.dispatchIndex() ||
+        batch.writeIndex > queue.writeIndex() || nextKmtExecutionTicket == 0) {
+        return KmtDispatchStart::Failed;
+    }
+
+    const uint64_t executionTicket = nextKmtExecutionTicket;
+
+    if (!executionAdapter->attach(*gpuDispatcher, *shader) ||
+        !executionAdapter->bind(
+            KmtExecutionDispatchId, executionTicket, *client.kmtMemory)) {
+        if (executionAdapter->active())
+            fatal_if(!executionAdapter->release(KmtExecutionDispatchId),
+                     "%s: KMT adapter bind rollback failed", name());
+        if (executionAdapter->attached())
+            fatal_if(!executionAdapter->detach(),
+                     "%s: KMT adapter attach rollback failed", name());
+        return KmtDispatchStart::Failed;
+    }
+    executionAdapter->setLifecycleSink(&queueSession.dispatch->lifecycle());
+    executionAdapter->setCompletionSink(&queueSession.dispatch->lifecycle());
+    const HostKmtNativeDispatch::Config config{
+        KmtExecutionDispatchId, executionTicket, batch.requestId, 950};
+    if (!queueSession.dispatch->prepare(config, *executionAdapter)) {
+        const bool scratchPending =
+            queueSession.dispatch->scratchAllocationPending();
+        executionAdapter->setLifecycleSink(nullptr);
+        executionAdapter->setCompletionSink(nullptr);
+        fatal_if(!executionAdapter->release(KmtExecutionDispatchId) ||
+                     !executionAdapter->detach(),
+                 "%s: KMT preparation rollback failed", name());
+        return scratchPending ? KmtDispatchStart::DeferredForScratch :
+            KmtDispatchStart::Failed;
+    }
+    nextKmtExecutionTicket = executionTicket ==
+            std::numeric_limits<uint64_t>::max() ?
+        0 : executionTicket + 1;
+    auto task = queueSession.dispatch->releaseTask();
+    if (!task) {
+        fatal_if(!queueSession.dispatch->cancel() ||
+                     !executionAdapter->release(KmtExecutionDispatchId) ||
+                     !executionAdapter->detach(),
+                 "%s: KMT task release rollback failed", name());
+        executionAdapter->setLifecycleSink(nullptr);
+        executionAdapter->setCompletionSink(nullptr);
+        return KmtDispatchStart::Failed;
+    }
+    activeKmtDispatch = queueSession.dispatch.get();
+    fatal_if(!executionAdapter->submit(std::move(task)),
+             "%s: admitted KMT task submission failed", name());
+    return KmtDispatchStart::Started;
+}

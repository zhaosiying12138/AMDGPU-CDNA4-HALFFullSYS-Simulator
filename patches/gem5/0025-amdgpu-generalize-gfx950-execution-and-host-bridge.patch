+class Memory final : public GPUNativeMemory
+{
+  public:
+    void map(Addr base, uint64_t bytes)
+    {
+        ranges.emplace_back(base, bytes);
+    }
+
+    bool read(Addr address, void *destination, size_t bytes,
+              uint64_t = 0) const override
+    {
+        if (!contains(address, bytes) || destination == nullptr)
+            return false;
+        auto *output = static_cast<uint8_t *>(destination);
+        for (size_t index = 0; index < bytes; ++index) {
+            const auto found = values.find(address + index);
+            output[index] = found == values.end() ? 0 : found->second;
+        }
+        return true;
+    }
+
+    bool write(Addr address, const void *source, size_t bytes,
+               uint64_t = 0) override
+    {
+        if (!contains(address, bytes) || source == nullptr)
+            return false;
+        const auto *input = static_cast<const uint8_t *>(source);
+        for (size_t index = 0; index < bytes; ++index)
+            values[address + index] = input[index];
+        return true;
+    }
+
+    template <class T>
+    bool store(Addr address, const T &value)
+    {
+        return write(address, &value, sizeof(value));
+    }
+
+    template <class T>
+    T load(Addr address) const
+    {
+        T value = {};
+        EXPECT_TRUE(read(address, &value, sizeof(value)));
+        return value;
+    }
+
+  private:
+    bool contains(Addr address, size_t bytes) const
+    {
+        if (bytes == 0 || address >
+                std::numeric_limits<Addr>::max() - (bytes - 1)) {
+            return false;
+        }
+        for (const auto &[base, size] : ranges) {
+            if (address >= base && address - base <= size &&
+                bytes <= size - (address - base)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    std::vector<std::pair<Addr, uint64_t>> ranges;
+    mutable std::map<Addr, uint8_t> values;
+};
+
+class Callbacks final : public HostNativeExecutionLifecycle::Callbacks
+{
+  public:
+    explicit Callbacks(HostNativeQueueCore &queue) : queue(queue) {}
+
+    void dispatcherStarted(const HSAQueueEntry &) override
+    {
+        ++starts;
+    }
+
+    void workgroupCompleted(
+        const HSAQueueEntry &, int, int) override
+    {
+        ++workgroups;
+    }
+
+    bool validateCompletion(
+        const HSAQueueEntry &, int, int) override
+    {
+        ++validations;
+        return completionValid;
+    }
+
+    bool retire(
+        const HSAQueueEntry &, uint64_t queueIndex,
+        uint64_t requestId) override
+    {
+        ++retireCalls;
+        return retirementValid && queue.retire(queueIndex, requestId);
+    }
+
+    void retired(const HSAQueueEntry &, int, int) override
+    {
+        ++retiredNotifications;
+    }
+
+    HostNativeQueueCore &queue;
+    uint64_t starts = 0;
+    uint64_t workgroups = 0;
+    uint64_t validations = 0;
+    uint64_t retireCalls = 0;
+    uint64_t retiredNotifications = 0;
+    bool completionValid = true;
+    bool retirementValid = true;
+};
+
+class NativeExecutionLifecycleTest : public testing::Test
+{
+  protected:
+    static constexpr Addr ResidentBase = 0x100000;
+    static constexpr uint64_t ResidentBytes = 0x1000;
+    static constexpr Addr Descriptor = ResidentBase + 0x100;
+    static constexpr Addr Code = ResidentBase + 0x200;
+    static constexpr Addr Ring = 0x200000;
+    static constexpr Addr Mqd = 0x300000;
+    static constexpr Addr ReadIndex =
+        Mqd + offsetof(_amd_queue_t, read_dispatch_id);
+    static constexpr Addr Kernarg = 0x400000;
+    static constexpr Addr Signal = 0x500000;
+    static constexpr uint64_t RequestId = 17;
+    static constexpr int DispatchId = 23;
+
+    void SetUp() override
+    {
+        memory.map(ResidentBase, ResidentBytes);
+        memory.map(Ring, 4 * HostNativeQueueCore::PacketBytes);
+        memory.map(Mqd, sizeof(_amd_queue_t));
+        memory.map(Kernarg, 16);
+        memory.map(Signal, 64);
+
+        descriptor.kernarg_size = 16;
+        descriptor.kernel_code_entry_byte_offset = Code - Descriptor;
+        ASSERT_TRUE(memory.store(Descriptor, descriptor));
+        const int64_t signalKind = 1;
+        const int64_t signalValue = 1;
+        ASSERT_TRUE(memory.store(Signal, signalKind));
+        ASSERT_TRUE(memory.store(Signal + 8, signalValue));
+
+        config.baseVa = Ring;
+        config.hostReadIndexVa = ReadIndex;
+        config.activeQueueId = 7;
+        config.generation = 11;
+        config.registeredIndex = 3;
+        config.queueBytes = 4 * HostNativeQueueCore::PacketBytes;
+        config.doorbellBytes = 8;
+        ASSERT_TRUE(queue.registerQueue(config));
+
+        mqd.hsa_queue.type = _HSA_QUEUE_TYPE_MULTI;
+        mqd.hsa_queue.id = config.activeQueueId;
+        mqd.hsa_queue.base_address = reinterpret_cast<void *>(Ring);
+        mqd.hsa_queue.size = 4;
+        mqd.read_dispatch_id = 0;
+        mqd.read_dispatch_id_field_base_byte_offset =
+            offsetof(_amd_queue_t, read_dispatch_id);
+        mqd.write_dispatch_id = 1;
+        ASSERT_TRUE(memory.store(Mqd, mqd));
+
+        packet.header = 0x1502;
+        packet.setup = 1;
+        packet.workgroup_size_x = 1;
+        packet.workgroup_size_y = 1;
+        packet.workgroup_size_z = 1;
+        packet.grid_size_x = 1;
+        packet.grid_size_y = 1;
+        packet.grid_size_z = 1;
+        packet.kernel_object = Descriptor;
+        packet.kernarg_address = Kernarg;
+        packet.completion_signal = Signal;
+        std::array<uint8_t, HostNativeQueueCore::PacketBytes> bytes = {};
+        std::memcpy(bytes.data(), &packet, sizeof(packet));
+        ASSERT_TRUE(queue.publish(Ring, bytes.data(), bytes.size()));
+        uint32_t registeredIndex = 0;
+        ASSERT_TRUE(queue.ring(1, registeredIndex));
+        ASSERT_EQ(registeredIndex, config.registeredIndex);
+    }
+
+    HostNativeExecutionLifecycle::Config lifecycleConfig() const
+    {
+        HostNativeExecutionLifecycle::Config value;
+        value.dispatchId = DispatchId;
+        value.requestId = RequestId;
+        value.queueIndex = 0;
+        value.hostPacketVa = Ring;
+        value.registeredQueueId = config.registeredIndex;
+        value.queueGeneration = config.generation;
+        value.completionSignalHandle = Signal;
+        value.completionSignalValueVa = Signal + 8;
+        value.expectedSignalValue = 1;
+        return value;
+    }
+
+    domain::ResidentKernelView resident() const
+    {
+        domain::ResidentKernelView value;
+        value.allocation = {41, 5};
+        value.allocationBaseVa = ResidentBase;
+        value.allocationBytes = ResidentBytes;
+        value.descriptorVa = Descriptor;
+        value.gfxTarget = 950;
+        return value;
+    }
+
+    std::unique_ptr<HSAQueueEntry> admit()
+    {
+        EXPECT_TRUE(lifecycle.arm(
+            lifecycleConfig(), memory, queue, callbacks));
+        HostNativeQueueCore::FetchedPacket fetched;
+        EXPECT_TRUE(queue.fetch(fetched, &lifecycle, RequestId));
+        EXPECT_TRUE(processor.submitResident(
+            fetched, queue, resident(), memory, DispatchId, result,
+            &lifecycle, RequestId));
+        EXPECT_TRUE(result.taskValid);
+        return result.releaseTask();
+    }
+
+    Memory memory;
+    GTestTickHandler tickHandler;
+    HostNativeQueueCore queue{memory};
+    Callbacks callbacks{queue};
+    HostNativeExecutionLifecycle lifecycle;
+    HostNativeCommandProcessorCore processor;
+    HostNativeCommandProcessorCore::Result result;
+    HostNativeQueueCore::Config config;
+    AMDKernelCode descriptor = {};
+    _amd_queue_t mqd = {};
+    _hsa_dispatch_packet_t packet = {};
+};
+
+TEST_F(NativeExecutionLifecycleTest, CommitsSignalAndRetiresSourceQueue)
+{
+    auto task = admit();
+    ASSERT_TRUE(task);
+    lifecycle.gpuDispatcherStarted(*task);
+    task->notifyWgCompleted();
+    lifecycle.gpuWorkgroupCompleted(*task, 0, 0);
+    ASSERT_TRUE(lifecycle.completeKernel(*task, 0, 0));
+    EXPECT_EQ(memory.load<int64_t>(Signal), 1);
+    EXPECT_EQ(memory.load<int64_t>(Signal + 8), 0);
+    EXPECT_EQ(lifecycle.signalBefore(), 1);
+    EXPECT_EQ(lifecycle.signalAfter(), 0);
+    lifecycle.hsaPacketRetired(*task, 0, 0);
+
+    EXPECT_TRUE(lifecycle.completed());
+    EXPECT_TRUE(lifecycle.retired());
+    EXPECT_FALSE(lifecycle.active());
+    EXPECT_EQ(lifecycle.fetchedCount(), 1U);
+    EXPECT_EQ(lifecycle.submittedCount(), 1U);
+    EXPECT_EQ(lifecycle.dispatcherStartedCount(), 1U);
+    EXPECT_EQ(lifecycle.workgroupCompletedCount(), 1U);
+    EXPECT_EQ(queue.readIndex(), 1U);
+    EXPECT_EQ(callbacks.starts, 1U);
+    EXPECT_EQ(callbacks.workgroups, 1U);
+    EXPECT_EQ(callbacks.validations, 1U);
+    EXPECT_EQ(callbacks.retireCalls, 1U);
+    EXPECT_EQ(callbacks.retiredNotifications, 1U);
+    EXPECT_TRUE(lifecycle.reset());
+    EXPECT_FALSE(lifecycle.armed());
+}
+
+TEST_F(NativeExecutionLifecycleTest, CompletionFailureDoesNotRetireOrSignal)
+{
+    auto task = admit();
+    ASSERT_TRUE(task);
+    lifecycle.gpuDispatcherStarted(*task);
+    task->notifyWgCompleted();
+    lifecycle.gpuWorkgroupCompleted(*task, 0, 0);
+    callbacks.completionValid = false;
+    EXPECT_FALSE(lifecycle.completeKernel(*task, 0, 0));
+    EXPECT_EQ(memory.load<int64_t>(Signal + 8), 1);
+    EXPECT_FALSE(lifecycle.completed());
+    EXPECT_FALSE(lifecycle.retired());
+    EXPECT_EQ(queue.readIndex(), 0U);
+    EXPECT_EQ(callbacks.retireCalls, 0U);
+}
+
+TEST_F(NativeExecutionLifecycleTest, SignalMismatchFailsBeforeMutation)
+{
+    const int64_t unexpected = 2;
+    ASSERT_TRUE(memory.store(Signal + 8, unexpected));
+    auto task = admit();
+    ASSERT_TRUE(task);
+    lifecycle.gpuDispatcherStarted(*task);
+    task->notifyWgCompleted();
+    lifecycle.gpuWorkgroupCompleted(*task, 0, 0);
+    EXPECT_FALSE(lifecycle.completeKernel(*task, 0, 0));
+    EXPECT_EQ(memory.load<int64_t>(Signal + 8), unexpected);
+    EXPECT_EQ(queue.readIndex(), 0U);
+}
+
+TEST_F(NativeExecutionLifecycleTest, RejectsWrongQueueIdentityBeforeFetch)
+{
+    auto invalid = lifecycleConfig();
+    invalid.queueIndex = 1;
+    EXPECT_FALSE(lifecycle.arm(invalid, memory, queue, callbacks));
+    EXPECT_FALSE(lifecycle.armed());
+    EXPECT_EQ(queue.fetchIndex(), 0U);
+    EXPECT_EQ(queue.dispatchIndex(), 0U);
+}
+
+TEST_F(NativeExecutionLifecycleTest, SupportsDirectSignalValueAddress)
+{
+    packet.completion_signal = Signal + 8;
+    ASSERT_TRUE(memory.store(Ring, packet));
+    auto config = lifecycleConfig();
+    config.completionSignalHandle = Signal + 8;
+    config.completionSignalValueVa = Signal + 8;
+    ASSERT_TRUE(lifecycle.arm(config, memory, queue, callbacks));
+    HostNativeQueueCore::FetchedPacket fetched;
+    ASSERT_TRUE(queue.fetch(fetched, &lifecycle, RequestId));
+    ASSERT_TRUE(processor.submitResident(
+        fetched, queue, resident(), memory, DispatchId, result,
+        &lifecycle, RequestId));
+    auto task = result.releaseTask();
+    ASSERT_TRUE(task);
+    lifecycle.gpuDispatcherStarted(*task);
+    task->notifyWgCompleted();
+    lifecycle.gpuWorkgroupCompleted(*task, 0, 0);
+    ASSERT_TRUE(lifecycle.completeKernel(*task, 0, 0));
+    EXPECT_EQ(memory.load<int64_t>(Signal + 8), 0);
+}
+
+TEST_F(NativeExecutionLifecycleTest, BindsSignalFromFetchedPacket)
+{
+    auto config = lifecycleConfig();
+    config.completionSignalHandle.reset();
+    config.completionSignalValueVa.reset();
+    config.expectedSignalValue.reset();
+    ASSERT_TRUE(lifecycle.arm(config, memory, queue, callbacks));
+    HostNativeQueueCore::FetchedPacket fetched;
+    ASSERT_TRUE(queue.fetch(fetched, &lifecycle, RequestId));
+    ASSERT_TRUE(lifecycle.bindCompletionSignal(Signal, Signal + 8, 1));
+    ASSERT_TRUE(processor.submitResident(
+        fetched, queue, resident(), memory, DispatchId, result,
+        &lifecycle, RequestId));
+    auto task = result.releaseTask();
+    ASSERT_TRUE(task);
+    lifecycle.gpuDispatcherStarted(*task);
+    task->notifyWgCompleted();
+    lifecycle.gpuWorkgroupCompleted(*task, 0, 0);
+    ASSERT_TRUE(lifecycle.completeKernel(*task, 0, 0));
+    EXPECT_EQ(memory.load<int64_t>(Signal + 8), 0);
+}

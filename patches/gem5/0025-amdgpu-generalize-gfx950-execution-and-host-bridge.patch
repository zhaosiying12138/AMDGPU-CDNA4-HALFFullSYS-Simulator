+/*
+ * Code Object V2's amd_kernel_code_t prefix.  ROCr still uses this standard
+ * descriptor ABI for runtime-assembled resident shaders.  Its entry and
+ * resource words deliberately line up with the corresponding V3 fields, but
+ * the segment sizes live at different offsets.
+ */
+struct LegacyAmdKernelCodeV2Prefix
+{
+    uint32_t versionMajor;
+    uint32_t versionMinor;
+    uint16_t machineKind;
+    uint16_t machineVersionMajor;
+    uint16_t machineVersionMinor;
+    uint16_t machineVersionStepping;
+    int64_t kernelCodeEntryByteOffset;
+    int64_t kernelCodePrefetchByteOffset;
+    uint64_t kernelCodePrefetchByteSize;
+    uint64_t maximumScratchBackingMemoryBytes;
+    uint32_t computePgmRsrc1;
+    uint32_t computePgmRsrc2;
+    uint32_t kernelCodeProperties;
+    uint32_t privateSegmentBytes;
+    uint32_t groupSegmentBytes;
+    uint32_t gdsSegmentBytes;
+    uint64_t kernargSegmentBytes;
+};
+
+static_assert(sizeof(LegacyAmdKernelCodeV2Prefix) == 80);
+static_assert(offsetof(LegacyAmdKernelCodeV2Prefix,
+                       kernelCodeEntryByteOffset) == 16);
+static_assert(offsetof(LegacyAmdKernelCodeV2Prefix, computePgmRsrc1) == 48);
+static_assert(offsetof(LegacyAmdKernelCodeV2Prefix, privateSegmentBytes) == 60);
+static_assert(offsetof(LegacyAmdKernelCodeV2Prefix, kernargSegmentBytes) == 72);
+
+constexpr uint64_t LegacyAmdKernelCodeV2Bytes = 256;
+
+bool
+commonZeroHeader(const LegacyAmdKernelCodeV2Prefix &legacy)
+{
+    return legacy.versionMajor == 0 && legacy.versionMinor == 0 &&
+        legacy.machineKind == 0 &&
+        legacy.machineVersionMajor == 0 &&
+        legacy.machineVersionMinor == 0 &&
+        legacy.machineVersionStepping == 0 &&
+        legacy.kernelCodeEntryByteOffset ==
+            static_cast<int64_t>(LegacyAmdKernelCodeV2Bytes);
+}
+
+bool
+versionedAmdKernelCodeV2Header(const LegacyAmdKernelCodeV2Prefix &legacy)
+{
+    return legacy.versionMajor == 1 &&
+        legacy.versionMinor <= 2 && legacy.machineKind == 1 &&
+        legacy.machineVersionMajor == 9 &&
+        legacy.machineVersionMinor == 5 &&
+        legacy.machineVersionStepping == 0;
+}
+
+bool
+validVersionedAmdKernelCodeV2(const LegacyAmdKernelCodeV2Prefix &legacy)
+{
+    return versionedAmdKernelCodeV2Header(legacy) &&
+        legacy.kernelCodeEntryByteOffset >=
+            static_cast<int64_t>(LegacyAmdKernelCodeV2Bytes) &&
+        (legacy.kernelCodeEntryByteOffset & 255) == 0 &&
+        legacy.gdsSegmentBytes == 0 &&
+        legacy.kernargSegmentBytes <=
+            std::numeric_limits<uint32_t>::max();
+}
+

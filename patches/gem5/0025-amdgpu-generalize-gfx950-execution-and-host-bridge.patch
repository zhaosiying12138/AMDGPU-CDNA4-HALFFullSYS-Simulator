+
+bool
+HostGPUKmtState::pinDispatchResources(
+    const Owner &transportOwner, uint64_t ownerId, uint64_t ownerGeneration,
+    uint64_t queueObjectId, uint64_t queueGeneration, uint64_t requestId,
+    const std::vector<AllocationRef> &resources)
+{
+    Session *session = findSession(
+        transportOwner, ownerId, ownerGeneration);
+    if (!session || requestId == 0 || !idHasPrefix(queueObjectId, QueuePrefix))
+        return false;
+    const size_t queueSlot = idSlot(queueObjectId);
+    if (queueSlot >= queues.size() || !queues[queueSlot])
+        return false;
+    Queue &queue = *queues[queueSlot];
+    const auto queuePin = queue.dispatchPins.find(requestId);
+    if (queue.ownerId != ownerId ||
+        queue.ownerGeneration != ownerGeneration ||
+        queue.generation != queueGeneration || queuePin == queue.dispatchPins.end()) {
+        return false;
+    }
+
+    std::vector<Allocation *> newlyPinned;
+    try {
+        newlyPinned.reserve(resources.size());
+        for (const AllocationRef &resource : resources) {
+            if (!idHasPrefix(resource.objectId, AllocationPrefix) ||
+                resource.objectGeneration == 0) {
+                for (Allocation *allocation : newlyPinned)
+                    allocation->dispatchPins.erase(requestId);
+                return false;
+            }
+            const size_t allocationSlot = idSlot(resource.objectId);
+            if (allocationSlot >= allocations.size() ||
+                !allocations[allocationSlot]) {
+                for (Allocation *allocation : newlyPinned)
+                    allocation->dispatchPins.erase(requestId);
+                return false;
+            }
+            Allocation &allocation = *allocations[allocationSlot];
+            if (allocation.ownerId != ownerId ||
+                allocation.ownerGeneration != ownerGeneration ||
+                allocation.generation != resource.objectGeneration) {
+                for (Allocation *entry : newlyPinned)
+                    entry->dispatchPins.erase(requestId);
+                return false;
+            }
+            if (allocation.dispatchPins.count(requestId) != 0)
+                continue;
+            if (!allocation.dispatchPins.insert(requestId).second) {
+                for (Allocation *entry : newlyPinned)
+                    entry->dispatchPins.erase(requestId);
+                return false;
+            }
+            newlyPinned.push_back(&allocation);
+        }
+    } catch (const std::bad_alloc &) {
+        for (Allocation *allocation : newlyPinned)
+            allocation->dispatchPins.erase(requestId);
+        return false;
+    }
+    if (newlyPinned.size() >
+        std::numeric_limits<size_t>::max() - queuePin->second) {
+        for (Allocation *allocation : newlyPinned)
+            allocation->dispatchPins.erase(requestId);
+        return false;
+    }
+    queue.dispatchPins[requestId] += newlyPinned.size();
+    return true;
+}

+    EXPECT_EQ(result.descriptor.kernel_code_entry_byte_offset, entryOffset);
+    EXPECT_EQ(result.descriptor.group_segment_fixed_size, 0U);
+    EXPECT_EQ(result.descriptor.private_segment_fixed_size, 0U);
+    EXPECT_EQ(result.descriptor.kernarg_size, 0U);
+    EXPECT_TRUE(result.descriptor.enable_sgpr_kernarg_segment_ptr);
+    EXPECT_TRUE(result.kernargRead);

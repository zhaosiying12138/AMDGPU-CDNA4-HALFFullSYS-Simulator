+bool
+processReadExact(pid_t pid, uint64_t address, void *destination, size_t bytes)
+{
+    if (pid <= 0 || address == 0 || destination == nullptr || bytes == 0 ||
+        address > std::numeric_limits<uintptr_t>::max() ||
+        bytes - 1 > std::numeric_limits<uintptr_t>::max() - address) {
+        return false;
+    }
+    size_t completed = 0;
+    while (completed < bytes) {
+        iovec local{
+            static_cast<uint8_t *>(destination) + completed,
+            bytes - completed};
+        iovec remote{
+            reinterpret_cast<void *>(
+                static_cast<uintptr_t>(address + completed)),
+            bytes - completed};
+        const ssize_t result = ::process_vm_readv(
+            pid, &local, 1, &remote, 1, 0);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            return false;
+        completed += static_cast<size_t>(result);
+    }
+    return true;
+}
+
+bool
+processWriteExact(pid_t pid, uint64_t address, const void *source,
+                  size_t bytes)
+{
+    if (pid <= 0 || address == 0 || source == nullptr || bytes == 0 ||
+        address > std::numeric_limits<uintptr_t>::max() ||
+        bytes - 1 > std::numeric_limits<uintptr_t>::max() - address) {
+        return false;
+    }
+    size_t completed = 0;
+    while (completed < bytes) {
+        iovec local{
+            const_cast<uint8_t *>(
+                static_cast<const uint8_t *>(source) + completed),
+            bytes - completed};
+        iovec remote{
+            reinterpret_cast<void *>(
+                static_cast<uintptr_t>(address + completed)),
+            bytes - completed};
+        const ssize_t result = ::process_vm_writev(
+            pid, &local, 1, &remote, 1, 0);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+            return false;
+        completed += static_cast<size_t>(result);
+    }
+    return true;
+}

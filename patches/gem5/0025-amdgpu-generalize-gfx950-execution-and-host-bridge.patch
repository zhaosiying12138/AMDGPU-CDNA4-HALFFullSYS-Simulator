+
+/**
+ * CDNA4/gfx950 DS_READ_TR payload layouts.
+ *
+ * The four instructions all read lane-major LDS payloads, but use different
+ * cross-lane tile shapes.  Keeping the byte-level implementation here makes
+ * the ISA classes marshal the same operation instead of carrying four subtly
+ * different permutations.  This is intentionally the CDNA4 layout: the
+ * B16 layout introduced for gfx1250 is not valid for gfx950.
+ */
+enum class Kind : uint8_t
+{
+    B4,
+    B6,
+    B8,
+    B16,
+};
+
+inline unsigned
+dwordsPerLane(Kind kind)
+{
+    return kind == Kind::B6 ? 3 : 2;
+}
+
+inline bool
+validDestinationVgpr(Kind kind, unsigned vdst)
+{
+    constexpr unsigned NumVgprs = 256;
+    const unsigned dwords = dwordsPerLane(kind);
+    if (vdst > NumVgprs - dwords)
+        return false;
+
+    // The 64-bit transpose destinations are aligned register pairs. CDNA4
+    // explicitly permits the B96_TR_B6 destination to start at any VGPR.
+    return kind == Kind::B6 || (vdst % 2 == 0);
+}
+
+inline uint16_t
+loadU16(const uint8_t *data, std::size_t offset)
+{
+    return static_cast<uint16_t>(data[offset]) |
+           (static_cast<uint16_t>(data[offset + 1]) << 8);
+}
+
+inline uint32_t
+loadU32(const uint8_t *data, std::size_t offset)
+{
+    return static_cast<uint32_t>(data[offset]) |
+           (static_cast<uint32_t>(data[offset + 1]) << 8) |
+           (static_cast<uint32_t>(data[offset + 2]) << 16) |
+           (static_cast<uint32_t>(data[offset + 3]) << 24);
+}
+
+inline void
+storeU32(std::vector<uint8_t> &data, std::size_t offset, uint32_t value)
+{
+    data[offset] = static_cast<uint8_t>(value);
+    data[offset + 1] = static_cast<uint8_t>(value >> 8);
+    data[offset + 2] = static_cast<uint8_t>(value >> 16);
+    data[offset + 3] = static_cast<uint8_t>(value >> 24);
+}
+
+inline uint32_t
+readB6(const uint32_t words[3], unsigned bit)
+{
+    assert(bit < 96 && bit + 6 <= 96);
+    const unsigned dword = bit / 32;
+    const unsigned shift = bit % 32;
+    uint64_t value = words[dword];
+    if (shift > 26)
+        value |= static_cast<uint64_t>(words[dword + 1]) << 32;
+    return static_cast<uint32_t>((value >> shift) & 0x3f);
+}
+
+inline void
+writeB6(uint32_t words[3], unsigned bit, uint32_t value)
+{
+    assert(bit < 96 && bit + 6 <= 96);
+    const unsigned dword = bit / 32;
+    const unsigned shift = bit % 32;
+    value &= 0x3f;
+    words[dword] |= value << shift;
+    if (shift > 26)
+        words[dword + 1] |= value >> (32 - shift);
+}
+
+inline void
+transposeB4(const uint8_t *input, std::vector<uint8_t> &output,
+            unsigned waveSize)
+{
+    constexpr unsigned BytesPerLane = 8;
+    constexpr unsigned LanesPerHalf = 32;
+
+    for (unsigned half = 0; half < waveSize / LanesPerHalf; ++half) {
+        const unsigned laneBase = half * LanesPerHalf;
+        for (unsigned group = 0; group < LanesPerHalf; group += 8) {
+            for (unsigned nibble = 0; nibble < 16; ++nibble) {
+                uint32_t packed = 0;
+                const unsigned sourceByte = nibble / 2;
+                const unsigned sourceShift = (nibble & 1) * 4;
+                for (unsigned lane = 0; lane < 8; ++lane) {
+                    const std::size_t sourceOffset =
+                        (laneBase + group + lane) * BytesPerLane +
+                        sourceByte;
+                    const uint32_t value =
+                        (input[sourceOffset] >> sourceShift) & 0xf;
+                    packed |= value << (lane * 4);
+                }
+
+                const unsigned destVgpr = (group / 16) & 1;
+                const unsigned destLane =
+                    laneBase + (group & 8) * 2 + nibble;
+                storeU32(output, destLane * BytesPerLane + destVgpr * 4,
+                         packed);
+            }
+        }
+    }
+}
+
+inline void
+transposeB8(const uint8_t *input, std::vector<uint8_t> &output,
+            unsigned waveSize)
+{
+    constexpr unsigned BytesPerLane = 8;
+    constexpr unsigned LanesPerHalf = 32;
+
+    for (unsigned half = 0; half < waveSize / LanesPerHalf; ++half) {
+        const unsigned laneBase = half * LanesPerHalf;
+        for (unsigned group = 0; group < LanesPerHalf; group += 4) {
+            for (unsigned byte = 0; byte < BytesPerLane; ++byte) {
+                uint32_t packed = 0;
+                for (unsigned lane = 0; lane < 4; ++lane) {
+                    const std::size_t sourceOffset =
+                        (laneBase + group + lane) * BytesPerLane + byte;
+                    packed |= static_cast<uint32_t>(input[sourceOffset])
+                              << (lane * 8);
+                }
+
+                const unsigned destVgpr = (group % 16) / 8;
+                const unsigned destLane =
+                    laneBase + (group / 16) * 16 +
+                    ((group / 4) % 2) * 8 + byte;
+                storeU32(output, destLane * BytesPerLane + destVgpr * 4,
+                         packed);
+            }
+        }
+    }
+}
+
+inline void
+transposeB16(const uint8_t *input, std::vector<uint8_t> &output,
+             unsigned waveSize)
+{
+    constexpr unsigned BytesPerLane = 8;
+    constexpr unsigned LanesPerHalf = 32;
+
+    for (unsigned half = 0; half < waveSize / LanesPerHalf; ++half) {
+        const unsigned laneBase = half * LanesPerHalf;
+        for (unsigned group = 0; group < LanesPerHalf; group += 8) {
+            for (unsigned lane = 0; lane < 4; ++lane) {
+                const unsigned sourceLo = laneBase + group + lane;
+                const unsigned sourceHi = sourceLo + 4;
+                for (unsigned halfword = 0; halfword < 4; ++halfword) {
+                    const uint16_t lo = loadU16(
+                        input, sourceLo * BytesPerLane + halfword * 2);
+                    const uint16_t hi = loadU16(
+                        input, sourceHi * BytesPerLane + halfword * 2);
+                    const uint32_t packed =
+                        static_cast<uint32_t>(lo) |
+                        (static_cast<uint32_t>(hi) << 16);
+
+                    const unsigned destVgpr = (group / 8) & 1;
+                    const unsigned destLane =
+                        laneBase + (group / 16) * 16 + lane * 4 +
+                        halfword;
+                    storeU32(output, destLane * BytesPerLane + destVgpr * 4,
+                             packed);
+                }
+            }
+        }
+    }
+}
+
+inline void
+transposeB6(const uint8_t *input, std::vector<uint8_t> &output,
+            unsigned waveSize)
+{
+    constexpr unsigned BytesPerLane = 12;
+    constexpr unsigned LanesPerHalf = 32;
+
+    for (unsigned half = 0; half < waveSize / LanesPerHalf; ++half) {
+        const unsigned laneBase = half * LanesPerHalf;
+        for (unsigned pass = 0; pass < 2; ++pass) {
+            uint32_t source[16][3] = {};
+            for (unsigned inputLane = 0; inputLane < 16; ++inputLane) {
+                const unsigned sourceLane =
+                    8 * (inputLane / 4) + (inputLane % 4) + pass * 4;
+                const std::size_t sourceOffset =
+                    (laneBase + sourceLane) * BytesPerLane;
+                for (unsigned dword = 0; dword < 3; ++dword)
+                    source[inputLane][dword] =
+                        loadU32(input, sourceOffset + dword * 4);
+            }
+
+            for (unsigned outputLane = 0; outputLane < 16; ++outputLane) {
+                uint32_t packed[3] = {};
+                for (unsigned inputLane = 0; inputLane < 16; ++inputLane) {
+                    const uint32_t value = readB6(
+                        source[inputLane], outputLane * 6);
+                    writeB6(packed, inputLane * 6, value);
+                }
+
+                const unsigned destLane = laneBase + pass * 16 + outputLane;
+                const std::size_t destOffset = destLane * BytesPerLane;
+                for (unsigned dword = 0; dword < 3; ++dword)
+                    storeU32(output, destOffset + dword * 4,
+                             packed[dword]);
+            }
+        }
+    }
+}
+
+/**
+ * Return the CDNA4 transpose result for one lane-major DS response.
+ *
+ * The response is little-endian and contains dwordsPerLane(kind) dwords for
+ * every lane. gfx950 DS transpose instructions are wave64-only.
+ */
+inline std::vector<uint8_t>
+transposeCdna4(const uint8_t *input, std::size_t inputSize, Kind kind,
+              unsigned waveSize)
+{
+    assert(waveSize == 64);
+    const std::size_t expectedSize =
+        static_cast<std::size_t>(waveSize) * dwordsPerLane(kind) * 4;
+    assert(inputSize == expectedSize);
+
+    std::vector<uint8_t> output(expectedSize, 0);
+    switch (kind) {
+      case Kind::B4:
+        transposeB4(input, output, waveSize);
+        break;
+      case Kind::B6:
+        transposeB6(input, output, waveSize);
+        break;
+      case Kind::B8:
+        transposeB8(input, output, waveSize);
+        break;
+      case Kind::B16:
+        transposeB16(input, output, waveSize);
+        break;
+    }
+    return output;
+}
+

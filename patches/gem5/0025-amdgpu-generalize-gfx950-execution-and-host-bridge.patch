+
+bool
+HostNativeExecutionLifecycle::fail(const char *reason)
+{
+    failureReason = reason ? reason : "native execution lifecycle failure";
+    return false;
+}
+
+bool
+HostNativeExecutionLifecycle::validSignalBinding(const Config &config)
+{
+    const bool hasSignalHandle = config.completionSignalHandle.has_value();
+    const bool hasSignalValue = config.completionSignalValueVa.has_value();
+    return hasSignalHandle == hasSignalValue &&
+        (!hasSignalHandle || (*config.completionSignalHandle != 0 &&
+                              *config.completionSignalValueVa != 0)) &&
+        (!config.expectedSignalValue || hasSignalValue);
+}
+
+void
+HostNativeExecutionLifecycle::clear()
+{
+    identity = {};
+    taskIdentity = {};
+    addressSpace = nullptr;
+    queueCore = nullptr;
+    sourceCallbacks = nullptr;
+    completedWorkgroups.clear();
+    packetFetches = 0;
+    cpSubmissions = 0;
+    dispatcherStarts = 0;
+    workgroupCompletions = 0;
+    dispatchStartTick = 0;
+    dispatchEndTick = 0;
+    dispatchRetireTick = 0;
+    completionSignalBefore = 0;
+    completionSignalAfter = 0;
+    isArmed = false;
+    dispatchActive = false;
+    dispatchStarted = false;
+    kernelCompleted = false;
+    packetRetired = false;
+    failureReason = "none";
+}
+
+bool
+HostNativeExecutionLifecycle::arm(
+    const Config &config, GPUNativeMemory &memory,
+    HostNativeQueueCore &queue, Callbacks &callbacks)
+{
+    failureReason = "none";
+    if (isArmed)
+        return fail("execution lifecycle is already armed");
+    if (!queue.isRegistered() || config.dispatchId <= 0 ||
+        config.requestId == 0 || config.queueGeneration == 0 ||
+        config.queueIndex != queue.dispatchIndex() ||
+        config.registeredQueueId != queue.registeredIndex() ||
+        config.queueGeneration != queue.config().generation) {
+        return fail("invalid execution lifecycle identity");
+    }
+    Addr expectedPacket = 0;
+    const uint32_t depth =
+        queue.config().queueBytes / HostNativeQueueCore::PacketBytes;
+    if (!HostNativeQueueCore::packetAddress(
+            queue.config().baseVa, config.queueIndex, depth,
+            expectedPacket) || expectedPacket != config.hostPacketVa) {
+        return fail("execution lifecycle packet identity");
+    }
+    if (!validSignalBinding(config)) {
+        return fail("invalid completion signal binding");
+    }
+
+    identity = config;
+    addressSpace = &memory;
+    queueCore = &queue;
+    sourceCallbacks = &callbacks;
+    isArmed = true;
+    return true;
+}
+
+bool
+HostNativeExecutionLifecycle::bindCompletionSignal(
+    std::optional<Addr> handle, std::optional<Addr> valueAddress,
+    std::optional<int64_t> expectedValue)
+{
+    Config candidate = identity;
+    candidate.completionSignalHandle = handle;
+    candidate.completionSignalValueVa = valueAddress;
+    candidate.expectedSignalValue = expectedValue;
+    if (!isArmed || packetFetches != 1 || cpSubmissions != 0 ||
+        taskIdentity.valid || identity.completionSignalHandle ||
+        identity.completionSignalValueVa || identity.expectedSignalValue ||
+        !validSignalBinding(candidate)) {
+        return fail("invalid fetched completion signal binding");
+    }
+    identity = candidate;
+    return true;
+}
+
+bool
+HostNativeExecutionLifecycle::cancel()
+{
+    if (!isArmed)
+        return true;
+    if (dispatchStarted || dispatchActive || kernelCompleted || packetRetired)
+        return fail("cannot cancel an executing lifecycle");
+    clear();
+    return true;
+}
+
+bool
+HostNativeExecutionLifecycle::reset()
+{
+    if (!isArmed || !kernelCompleted || !packetRetired || dispatchActive)
+        return fail("execution lifecycle is not reusable");
+    clear();
+    return true;
+}
+
+bool
+HostNativeExecutionLifecycle::taskMatches(const HSAQueueEntry &task) const
+{
+    if (!isArmed || !taskIdentity.valid || task.dispatchId() != identity.dispatchId ||
+        task.queueId() != identity.registeredQueueId ||
+        task.hostDispPktAddr() != identity.hostPacketVa ||
+        task.completionSignal() != taskIdentity.completionSignal ||
+        task.codeAddr() != taskIdentity.code ||
+        task.kernargAddr() != taskIdentity.kernarg ||
+        task.numWgTotal() != taskIdentity.totalWorkgroups) {
+        return false;
+    }
+    for (int dimension = 0; dimension < 3; ++dimension) {
+        if (task.gridSize(dimension) != taskIdentity.grid[dimension] ||
+            task.wgSize(dimension) != taskIdentity.workgroup[dimension]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void
+HostNativeExecutionLifecycle::hsaPacketFetched(
+    Addr hostPacketAddr, uint32_t queueId)
+{
+    panic_if(!isArmed || hostPacketAddr != identity.hostPacketVa ||
+                 queueId != identity.registeredQueueId || packetFetches != 0 ||
+                 cpSubmissions != 0,
+             "native execution fetched-packet identity mismatch");
+    ++packetFetches;
+}
+
+void
+HostNativeExecutionLifecycle::commandProcessorSubmitted(
+    const HSAQueueEntry &task)
+{
+    panic_if(!isArmed || packetFetches != 1 || cpSubmissions != 0 ||
+                 task.dispatchId() != identity.dispatchId ||
+                 task.queueId() != identity.registeredQueueId ||
+                 task.hostDispPktAddr() != identity.hostPacketVa ||
+                 task.numWgTotal() <= 0 ||
+                 task.completionSignal() !=
+                     identity.completionSignalHandle.value_or(0),
+             "native execution command-processor identity mismatch");
+    taskIdentity.completionSignal = task.completionSignal();
+    taskIdentity.code = task.codeAddr();
+    taskIdentity.kernarg = task.kernargAddr();
+    for (int dimension = 0; dimension < 3; ++dimension) {
+        taskIdentity.grid[dimension] = task.gridSize(dimension);
+        taskIdentity.workgroup[dimension] = task.wgSize(dimension);
+    }
+    taskIdentity.totalWorkgroups = task.numWgTotal();
+    taskIdentity.valid = true;
+    ++cpSubmissions;
+}
+
+void
+HostNativeExecutionLifecycle::gpuDispatcherStarted(
+    const HSAQueueEntry &task)
+{
+    panic_if(!taskMatches(task) || packetFetches != 1 || cpSubmissions != 1 ||
+                 dispatchStarted || dispatcherStarts != 0,
+             "native execution dispatcher identity mismatch");
+    dispatchStarted = true;
+    dispatchActive = true;
+    dispatchStartTick = curTick();
+    ++dispatcherStarts;
+    sourceCallbacks->dispatcherStarted(task);
+}
+
+void
+HostNativeExecutionLifecycle::cuWaveStarted(
+    const HSAQueueEntry &task, int cuId, int waveId, uint32_t workgroupX,
+    uint32_t workgroupY, uint32_t workgroupZ, uint64_t laneMask)
+{
+    panic_if(!taskMatches(task) || !dispatchActive,
+             "native execution wave identity mismatch");
+    sourceCallbacks->waveStarted(
+        task, cuId, waveId, workgroupX, workgroupY, workgroupZ, laneMask);
+}
+
+void
+HostNativeExecutionLifecycle::cuInstructionStarted(
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    uint64_t dynamicWaveId, Addr pc, uint64_t sequence)
+{
+    panic_if(!taskMatches(task) || !dispatchActive,
+             "native execution instruction identity mismatch");
+    sourceCallbacks->instructionStarted(
+        task, cuId, workgroupId, dynamicWaveId, pc, sequence);
+}
+
+void
+HostNativeExecutionLifecycle::cuGlobalStoreCompleted(
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    const std::vector<Addr> &addresses, uint32_t bytesPerLane,
+    uint64_t laneMask)
+{
+    panic_if(!taskMatches(task) || !dispatchActive,
+             "native execution store identity mismatch");
+    sourceCallbacks->globalStoreCompleted(
+        task, cuId, workgroupId, addresses, bytesPerLane, laneMask);
+}
+
+void
+HostNativeExecutionLifecycle::gpuWorkgroupCompleted(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    panic_if(!taskMatches(task) || !dispatchActive || workgroupId < 0 ||
+                 workgroupId >= task.numWgTotal() ||
+                 !completedWorkgroups.insert(workgroupId).second,
+             "native execution workgroup identity mismatch");
+    ++workgroupCompletions;
+    sourceCallbacks->workgroupCompleted(task, cuId, workgroupId);
+}
+
+bool
+HostNativeExecutionLifecycle::commitSignal(const HSAQueueEntry &task)
+{
+    const Addr signalHandle = task.completionSignal();
+    if (signalHandle == 0) {
+        if (identity.expectedSignalValue)
+            return fail("missing expected completion signal");
+        completionSignalBefore = 0;
+        completionSignalAfter = 0;
+        return true;
+    }
+    if (!identity.completionSignalValueVa)
+        return fail("missing completion signal value address");
+    const Addr signalValue = *identity.completionSignalValueVa;
+    int64_t before = 0;
+    if (!addressSpace->read(
+            signalValue, &before, sizeof(before), identity.requestId)) {
+        return fail("completion signal read failed");
+    }
+    if ((identity.expectedSignalValue &&
+         before != *identity.expectedSignalValue) ||
+        before == std::numeric_limits<int64_t>::min()) {
+        return fail("completion signal value mismatch");
+    }
+    const int64_t after = before - 1;
+    if (!addressSpace->write(
+            signalValue, &after, sizeof(after), identity.requestId)) {
+        return fail("completion signal write failed");
+    }
+    int64_t readback = 0;
+    if (!addressSpace->read(
+            signalValue, &readback, sizeof(readback), identity.requestId) ||
+        readback != after) {
+        return fail("completion signal readback failed");
+    }
+    completionSignalBefore = before;
+    completionSignalAfter = after;
+    return true;
+}
+
+bool
+HostNativeExecutionLifecycle::completeKernel(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    if (!taskMatches(task) || !dispatchStarted || !dispatchActive ||
+        kernelCompleted || packetRetired || packetFetches != 1 ||
+        cpSubmissions != 1 || dispatcherStarts != 1 ||
+        task.numWgCompleted() != task.numWgTotal() ||
+        workgroupCompletions != static_cast<uint64_t>(task.numWgTotal()) ||
+        completedWorkgroups.size() !=
+            static_cast<size_t>(task.numWgTotal())) {
+        return fail("execution completion state mismatch");
+    }
+    if (!sourceCallbacks->validateCompletion(task, cuId, workgroupId))
+        return fail("source completion validation failed");
+    if (!commitSignal(task))
+        return false;
+    dispatchActive = false;
+    kernelCompleted = true;
+    dispatchEndTick = curTick();
+    return true;
+}
+
+void
+HostNativeExecutionLifecycle::hsaPacketRetired(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    panic_if(!taskMatches(task) || dispatchActive || !kernelCompleted ||
+                 packetRetired || !sourceCallbacks->retire(
+                     task, identity.queueIndex, identity.requestId),
+             "native execution packet retirement failed");
+    packetRetired = true;
+    dispatchRetireTick = curTick();
+    sourceCallbacks->retired(task, cuId, workgroupId);
+}
+

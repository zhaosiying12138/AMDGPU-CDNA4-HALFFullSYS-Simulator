+#ifndef __DEV_AMDGPU_HOST_GPU_KMT_NATIVE_DISPATCH_HH__
+#define __DEV_AMDGPU_HOST_GPU_KMT_NATIVE_DISPATCH_HH__
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "dev/amdgpu/host_gpu_kmt_memory.hh"
+#include "dev/amdgpu/host_gpu_native_command_processor_core.hh"
+#include "dev/amdgpu/host_gpu_native_execution_lifecycle.hh"
+
+namespace gem5::hostgpu
+{
+
+/**
+ * Owner-bound bridge from a standard KMT AQL queue to the native GPU core.
+ *
+ * This object contains no wire codec, runtime API, kernel name, or framework
+ * policy.  The caller makes a doorbell ACK durable, binds the common execution
+ * adapter, and then asks this source adapter to admit exactly the next queue
+ * packet.  KMT allocations and the queue remain pinned until the shared GPU
+ * lifecycle retires that packet.
+ */
+class HostKmtNativeDispatch final
+    : private HostNativeExecutionLifecycle::Callbacks
+{
+  public:
+    struct Config
+    {
+        int dispatchId = 0;
+        /** Bridge-owned identity for exactly one AQL packet execution. */
+        uint64_t executionTicket = 0;
+        /** Transport request that made the containing doorbell batch durable. */
+        uint64_t sourceRequestId = 0;
+        uint32_t gfxTarget = 0;
+    };
+
+    class Notifications
+    {
+      public:
+        virtual ~Notifications() = default;
+        virtual void kmtDispatchRetired(HostKmtNativeDispatch &) = 0;
+    };
+
+    HostKmtNativeDispatch(
+        HostGPUKmtState &state, HostKmtNativeMemory &memory,
+        HostNativeQueueCore &queue,
+        const HostGPUKmtState::Owner &transportOwner,
+        uint64_t ownerId, uint64_t ownerGeneration,
+        uint64_t queueObjectId, uint64_t queueGeneration,
+        Notifications &notifications)
+        : state(state), memory(memory), queue(queue),
+          transportOwner(transportOwner), ownerId(ownerId),
+          ownerGeneration(ownerGeneration), queueObjectId(queueObjectId),
+          queueGeneration(queueGeneration), notifications(notifications)
+    {}
+
+    bool prepare(const Config &config,
+                 GPUDispatchLifecycleListener &listener);
+    std::unique_ptr<HSAQueueEntry> releaseTask();
+
+    /** Roll back an admitted but not submitted packet and abandon its queue. */
+    bool cancel();
+
+    /** Re-arm the same KMT queue after a completely retired packet. */
+    bool reset();
+
+    HostNativeExecutionLifecycle &lifecycle() { return executionLifecycle; }
+    const HostNativeExecutionLifecycle &lifecycle() const
+    {
+        return executionLifecycle;
+    }
+    bool isPrepared() const { return prepared; }
+    bool taskWasReleased() const { return taskReleased; }
+    bool resourcesPinned() const { return pinned; }
+    bool scratchAllocationPending() const { return scratchPending; }
+    uint64_t executionTicket() const
+    {
+        return activeConfig.executionTicket;
+    }
+    uint64_t sourceRequestId() const
+    {
+        return activeConfig.sourceRequestId;
+    }
+    uint64_t queueIndex() const { return activeQueueIndex; }
+    const HostGPUKmtState::Owner &owner() const { return transportOwner; }
+    uint64_t ownerIdValue() const { return ownerId; }
+    uint64_t ownerGenerationValue() const { return ownerGeneration; }
+    uint64_t queueObjectIdValue() const { return queueObjectId; }
+    uint64_t queueGenerationValue() const { return queueGeneration; }
+    const HostNativeCommandProcessorCore::Result &commandProcessorResult() const
+    {
+        return cpResult;
+    }
+    const char *failure() const { return failureReason.c_str(); }
+
+  private:
+    bool fail(const char *reason);
+    bool rollbackFailedPrepare();
+
+    void dispatcherStarted(const HSAQueueEntry &) override;
+    bool validateCompletion(const HSAQueueEntry &, int, int) override;
+    bool retire(const HSAQueueEntry &, uint64_t queueIndex,
+                uint64_t requestId) override;
+    void retired(const HSAQueueEntry &, int, int) override;
+
+    HostGPUKmtState &state;
+    HostKmtNativeMemory &memory;
+    HostNativeQueueCore &queue;
+    HostGPUKmtState::Owner transportOwner;
+    uint64_t ownerId = 0;
+    uint64_t ownerGeneration = 0;
+    uint64_t queueObjectId = 0;
+    uint64_t queueGeneration = 0;
+    Notifications &notifications;
+    HostNativeCommandProcessorCore commandProcessor;
+    HostNativeExecutionLifecycle executionLifecycle;
+    HostNativeCommandProcessorCore::Result cpResult;
+    HostNativeQueueCore::FetchedPacket fetched;
+    Config activeConfig;
+    std::string failureReason = "none";
+    uint64_t activeQueueIndex = 0;
+    uint64_t profilingStartNanoseconds = 0;
+    bool pinned = false;
+    bool prepared = false;
+    bool taskReleased = false;
+    bool scratchPending = false;
+};
+
+} // namespace gem5::hostgpu
+
+#endif // __DEV_AMDGPU_HOST_GPU_KMT_NATIVE_DISPATCH_HH__

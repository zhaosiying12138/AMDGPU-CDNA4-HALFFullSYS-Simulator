+    std::memcpy(legacy.data() + 12, &machineMinor, sizeof(machineMinor));
+    std::memcpy(legacy.data() + 16, &entryOffset, sizeof(entryOffset));
+    std::memcpy(legacy.data() + 48, &resource1, sizeof(resource1));
+    std::memcpy(legacy.data() + 52, &resource2, sizeof(resource2));
+    std::memcpy(legacy.data() + 56, &properties, sizeof(properties));

+bool
+HostGPUKmtState::writeMemory(const Owner &transportOwner, uint64_t ownerId,
+                             uint64_t ownerGeneration, uint64_t gpuVa,
+                             const void *source, uint64_t byteCount,
+                             uint64_t requestId)
+{
+    (void)requestId;
+    if (source == nullptr || byteCount == 0 ||
+        byteCount > std::numeric_limits<size_t>::max()) {
+        return false;
+    }
+    const auto info = memoryInfo(transportOwner, ownerId, ownerGeneration,
+                                 gpuVa, byteCount);
+    if (!info)
+        return false;
+    const size_t slot = idSlot(info->objectId);
+    if (slot >= allocations.size() || !allocations[slot] ||
+        allocations[slot]->generation != info->objectGeneration) {
+        return false;
+    }
+    const uint64_t offset = gpuVa - info->gpuVa;
+    const auto *input = static_cast<const uint8_t *>(source);
+    for (uint64_t index = 0; index < byteCount; ++index) {
+        const uint8_t value = input[static_cast<size_t>(index)];
+        if (value == 0)
+            allocations[slot]->bytes.erase(offset + index);
+        else
+            allocations[slot]->bytes[offset + index] = value;
+    }
+    return true;
+}

+std::optional<HostGPUKmtState::QueueInfo>
+HostGPUKmtState::queueInfo(const Owner &transportOwner, uint64_t ownerId,
+                           uint64_t ownerGeneration, uint64_t objectId,
+                           uint64_t objectGeneration) const
+{
+    const Session *session = findSession(transportOwner, ownerId,
+                                         ownerGeneration);
+    if (session == nullptr || !idHasPrefix(objectId, QueuePrefix))
+        return std::nullopt;
+    const size_t slot = idSlot(objectId);
+    if (slot >= queues.size() || !queues[slot])
+        return std::nullopt;
+    const Queue &queue = *queues[slot];
+    if (queue.ownerId != session->ownerId ||
+        queue.ownerGeneration != session->ownerGeneration ||
+        queue.generation != objectGeneration)
+        return std::nullopt;
+    return QueueInfo{queue.clientQueueId, queue.registeredIndex,
+                     queue.generation,
+                     queue.ringBase, queue.ringBytes, queue.readPointer,
+                     queue.writePointer, queue.depth, queue.queueType,
+                     queue.doorbellOffset, queue.completionOffset,

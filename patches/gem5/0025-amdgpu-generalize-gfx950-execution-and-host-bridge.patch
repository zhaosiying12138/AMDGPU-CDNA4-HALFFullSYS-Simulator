+
+#ifndef __DEV_AMDGPU_HOST_GPU_NATIVE_AQL_CONTROL_HH__
+#define __DEV_AMDGPU_HOST_GPU_NATIVE_AQL_CONTROL_HH__
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+class GPUNativeMemory;
+
+namespace hostgpu
+{
+
+class HostNativeQueueCore;
+
+/** Execute non-kernel packets from a standard, host-visible AQL queue. */
+class HostNativeAqlControl
+{
+  public:
+    using ClockSampler = std::function<uint64_t()>;
+
+    enum class Status
+    {
+        NotControl,
+        Blocked,
+        Completed,
+        Failed,
+    };
+
+    struct Result
+    {
+        Status status = Status::Failed;
+        uint8_t packetType = 0xff;
+        uint64_t queueIndex = 0;
+        Addr completionSignal = 0;
+    };
+
+    explicit HostNativeAqlControl(ClockSampler clockSampler);
+
+    Result process(HostNativeQueueCore &queue, GPUNativeMemory &memory,
+                   uint64_t requestId);
+
+    const char *failure() const { return failureReason.c_str(); }
+
+  private:
+    bool validHeader(uint16_t header, uint8_t expectedType) const;
+    bool maintenancePm4IbValid(const uint8_t *packet,
+                               GPUNativeMemory &memory,
+                               uint64_t requestId);
+    bool standardBarrierReady(const uint8_t *packet, uint8_t packetType,
+                              GPUNativeMemory &memory, uint64_t requestId,
+                              bool &ready);
+    bool amdBarrierValueReady(const uint8_t *packet,
+                              GPUNativeMemory &memory, uint64_t requestId,
+                              bool &ready);
+    bool readSignal(GPUNativeMemory &memory, Addr handle, uint64_t requestId,
+                    uint64_t &valueBits);
+    bool prepareCompletionSignal(GPUNativeMemory &memory, Addr handle,
+                                 uint64_t requestId, int64_t &value);
+    bool commitCompletionSignal(GPUNativeMemory &memory, Addr handle,
+                                uint64_t requestId, int64_t value);
+    Result failFetched(HostNativeQueueCore &queue, uint64_t ticket,
+                       uint8_t packetType, uint64_t queueIndex,
+                       const char *reason);
+
+    ClockSampler clockSampler;
+    std::string failureReason = "none";
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_NATIVE_AQL_CONTROL_HH__

+{
+    const auto found = std::find_if(
+        genericDispatches.begin(), genericDispatches.end(),
+        [session](const auto &candidate) { return candidate.get() == session; });
+    if (!session || found == genericDispatches.end())
+        return false;
+    genericDispatches.erase(found);
+    return true;
+}
+
+HostGPUBridge::Client::KmtQueueSession *
+HostGPUBridge::Client::findKmtQueue(
+    uint64_t objectId, uint64_t objectGeneration) const
+{
+    KmtQueueSession *result = nullptr;
+    for (const auto &candidate : kmtQueues) {
+        if (!candidate || candidate->objectId != objectId ||
+            candidate->objectGeneration != objectGeneration) {
+            continue;
+        }
+        if (result)
+            return nullptr;
+        result = candidate.get();
+    }
+    return result;
+}
+
+bool
+HostGPUBridge::Client::eraseKmtQueue(const KmtQueueSession *session)
+{
+    const auto found = std::find_if(
+        kmtQueues.begin(), kmtQueues.end(),
+        [session](const auto &candidate) { return candidate.get() == session; });
+    if (!session || found == kmtQueues.end())
+        return false;
+    kmtQueues.erase(found);
+    return true;
+}
+
+bool
+HostGPUBridge::genericInfrastructureAllocation(
+    const domain::OwnerKey &owner,
+    const domain::AllocationInfo &allocation) const
+{
+    if (owner.scope > static_cast<uint64_t>(std::numeric_limits<int>::max()))
+        return false;
+    const auto found = clients.find(static_cast<int>(owner.scope));
+    if (found == clients.end() ||
+        found->second->generation != owner.generation) {
+        return false;
+    }
+    return std::any_of(
+        found->second->genericDispatches.begin(),
+        found->second->genericDispatches.end(),
+        [&allocation](const auto &session) {
+            return session && session->ownsInfrastructureAllocation(allocation);
+        });
+}

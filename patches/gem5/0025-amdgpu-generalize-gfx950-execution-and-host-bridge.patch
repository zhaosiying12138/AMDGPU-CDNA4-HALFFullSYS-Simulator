+using ds_transpose::Kind;
+
+void
+storeU16(std::vector<uint8_t> &data, std::size_t offset, uint16_t value)
+{
+    data[offset] = static_cast<uint8_t>(value);
+    data[offset + 1] = static_cast<uint8_t>(value >> 8);
+}
+
+uint16_t
+loadU16(const std::vector<uint8_t> &data, std::size_t offset)
+{
+    return static_cast<uint16_t>(data[offset]) |
+           (static_cast<uint16_t>(data[offset + 1]) << 8);
+}
+
+uint64_t
+loadU64(const std::vector<uint8_t> &data, std::size_t offset)
+{
+    uint64_t value = 0;
+    for (unsigned byte = 0; byte < 8; ++byte)
+        value |= static_cast<uint64_t>(data[offset + byte]) << (byte * 8);
+    return value;
+}
+
+void
+setB6(std::vector<uint8_t> &data, unsigned lane, unsigned element,
+      uint32_t value)
+{
+    const unsigned bit = element * 6;
+    const unsigned dword = bit / 32;
+    const unsigned shift = bit % 32;
+    uint32_t words[3] = {};
+    for (unsigned i = 0; i < 3; ++i)
+        words[i] = static_cast<uint32_t>(data[lane * 12 + i * 4]) |
+                   (static_cast<uint32_t>(data[lane * 12 + i * 4 + 1]) << 8) |
+                   (static_cast<uint32_t>(data[lane * 12 + i * 4 + 2]) << 16) |
+                   (static_cast<uint32_t>(data[lane * 12 + i * 4 + 3]) << 24);
+    const uint64_t packed = static_cast<uint64_t>(value & 0x3f) << shift;
+    words[dword] |= static_cast<uint32_t>(packed);
+    if (shift > 26)
+        words[dword + 1] |= static_cast<uint32_t>(packed >> 32);
+    for (unsigned i = 0; i < 3; ++i) {
+        data[lane * 12 + i * 4] = static_cast<uint8_t>(words[i]);
+        data[lane * 12 + i * 4 + 1] = static_cast<uint8_t>(words[i] >> 8);
+        data[lane * 12 + i * 4 + 2] = static_cast<uint8_t>(words[i] >> 16);
+        data[lane * 12 + i * 4 + 3] = static_cast<uint8_t>(words[i] >> 24);
+    }
+}
+
+uint32_t
+getB6(const std::vector<uint8_t> &data, unsigned lane, unsigned element)
+{
+    const unsigned bit = element * 6;
+    const unsigned dword = bit / 32;
+    const unsigned shift = bit % 32;
+    uint64_t value =
+        static_cast<uint64_t>(data[lane * 12 + dword * 4]) |
+        (static_cast<uint64_t>(data[lane * 12 + dword * 4 + 1]) << 8) |
+        (static_cast<uint64_t>(data[lane * 12 + dword * 4 + 2]) << 16) |
+        (static_cast<uint64_t>(data[lane * 12 + dword * 4 + 3]) << 24);
+    if (shift > 26) {
+        const unsigned next = dword + 1;
+        value |=
+            static_cast<uint64_t>(data[lane * 12 + next * 4]) << 32;
+        value |=
+            static_cast<uint64_t>(data[lane * 12 + next * 4 + 1]) << 40;
+        value |=
+            static_cast<uint64_t>(data[lane * 12 + next * 4 + 2]) << 48;
+        value |=
+            static_cast<uint64_t>(data[lane * 12 + next * 4 + 3]) << 56;
+    }
+    return static_cast<uint32_t>((value >> shift) & 0x3f);
+}
+
+void
+expectEqual(const std::vector<uint8_t> &actual,
+            const std::vector<uint8_t> &expected)
+{
+    ASSERT_EQ(actual.size(), expected.size());
+    for (std::size_t i = 0; i < actual.size(); ++i) {
+        SCOPED_TRACE(testing::Message() << "byte=" << i);
+        EXPECT_EQ(actual[i], expected[i]);
+    }
+}
+
+TEST(DsTransposeTest, B4Cdna4LaneAndNibbleOrder)
+{
+    std::vector<uint8_t> input(64 * 8, 0);
+    for (unsigned lane = 0; lane < 64; ++lane) {
+        for (unsigned nibble = 0; nibble < 16; ++nibble) {
+            const uint8_t value =
+                static_cast<uint8_t>((lane * 5 + nibble * 3 + 1) & 0xf);
+            uint8_t &byte = input[lane * 8 + nibble / 2];
+            if (nibble & 1)
+                byte = static_cast<uint8_t>(byte | (value << 4));
+            else
+                byte = static_cast<uint8_t>(byte | value);
+        }
+    }
+
+    const auto actual = ds_transpose::transposeCdna4(
+        input.data(), input.size(), Kind::B4, 64);
+    std::vector<uint8_t> expected(64 * 8, 0);
+    for (unsigned half = 0; half < 2; ++half) {
+        const unsigned base = half * 32;
+        for (unsigned destLane = 0; destLane < 32; ++destLane) {
+            const unsigned nibble = destLane % 16;
+            const unsigned group = (destLane / 16) * 8;
+            for (unsigned destVgpr = 0; destVgpr < 2; ++destVgpr) {
+                const unsigned sourceGroup = destVgpr * 16 + group;
+                uint32_t packed = 0;
+                for (unsigned sourceLane = 0; sourceLane < 8;
+                     ++sourceLane) {
+                    const unsigned source = base + sourceGroup + sourceLane;
+                    const uint8_t byte = input[source * 8 + nibble / 2];
+                    const uint32_t value =
+                        (byte >> ((nibble & 1) * 4)) & 0xf;
+                    packed |= value << (sourceLane * 4);
+                }
+                for (unsigned byte = 0; byte < 4; ++byte)
+                    expected[(base + destLane) * 8 + destVgpr * 4 + byte] =
+                        static_cast<uint8_t>(packed >> (byte * 8));
+            }
+        }
+    }
+    expectEqual(actual, expected);
+}
+
+TEST(DsTransposeTest, B6Cdna4CrossDwordElementOrder)
+{
+    std::vector<uint8_t> input(64 * 12, 0);
+    for (unsigned lane = 0; lane < 64; ++lane)
+        for (unsigned element = 0; element < 16; ++element)
+            setB6(input, lane, element,
+                  (lane * 11 + element * 13 + 5) & 0x3f);
+
+    const auto actual = ds_transpose::transposeCdna4(
+        input.data(), input.size(), Kind::B6, 64);
+    std::vector<uint8_t> expected(64 * 12, 0);
+    for (unsigned half = 0; half < 2; ++half) {
+        const unsigned base = half * 32;
+        for (unsigned pass = 0; pass < 2; ++pass) {
+            for (unsigned outputLane = 0; outputLane < 16; ++outputLane) {
+                const unsigned dest = base + pass * 16 + outputLane;
+                for (unsigned inputLane = 0; inputLane < 16; ++inputLane) {
+                    const unsigned source =
+                        base + 8 * (inputLane / 4) + inputLane % 4 + pass * 4;
+                    setB6(expected, dest, inputLane,
+                          getB6(input, source, outputLane));
+                }
+            }
+        }
+    }
+    expectEqual(actual, expected);
+}
+
+TEST(DsTransposeTest, B8Cdna4LaneAndByteOrder)
+{
+    std::vector<uint8_t> input(64 * 8, 0);
+    for (unsigned lane = 0; lane < 64; ++lane)
+        for (unsigned byte = 0; byte < 8; ++byte)
+            input[lane * 8 + byte] =
+                static_cast<uint8_t>((lane * 17 + byte * 29 + 7) & 0xff);
+
+    const auto actual = ds_transpose::transposeCdna4(
+        input.data(), input.size(), Kind::B8, 64);
+    std::vector<uint8_t> expected(64 * 8, 0);
+    for (unsigned half = 0; half < 2; ++half) {
+        const unsigned base = half * 32;
+        for (unsigned group = 0; group < 32; group += 4) {
+            const unsigned destVgpr = (group % 16) / 8;
+            const unsigned destBase =
+                base + (group / 16) * 16 + ((group / 4) % 2) * 8;
+            for (unsigned byte = 0; byte < 8; ++byte) {
+                uint32_t packed = 0;
+                for (unsigned sourceLane = 0; sourceLane < 4;
+                     ++sourceLane)
+                    packed |= static_cast<uint32_t>(
+                                  input[(base + group + sourceLane) * 8 + byte])
+                              << (sourceLane * 8);
+                for (unsigned outByte = 0; outByte < 4; ++outByte)
+                    expected[(destBase + byte) * 8 + destVgpr * 4 + outByte] =
+                        static_cast<uint8_t>(packed >> (outByte * 8));
+            }
+        }
+    }
+    expectEqual(actual, expected);
+}
+
+TEST(DsTransposeTest, B16Cdna4LaneAndHalfwordOrder)
+{
+    std::vector<uint8_t> input(64 * 8, 0);
+    for (unsigned lane = 0; lane < 64; ++lane)
+        for (unsigned halfword = 0; halfword < 4; ++halfword)
+            storeU16(input, lane * 8 + halfword * 2,
+                     static_cast<uint16_t>(0x1000 + lane * 0x31 +
+                                           halfword * 7));
+
+    const auto actual = ds_transpose::transposeCdna4(
+        input.data(), input.size(), Kind::B16, 64);
+    std::vector<uint8_t> expected(64 * 8, 0);
+    for (unsigned half = 0; half < 2; ++half) {
+        const unsigned base = half * 32;
+        for (unsigned group = 0; group < 32; group += 8) {
+            for (unsigned lane = 0; lane < 4; ++lane) {
+                for (unsigned halfword = 0; halfword < 4; ++halfword) {
+                    const unsigned destVgpr = (group / 8) & 1;
+                    const unsigned destLane =
+                        base + (group / 16) * 16 + lane * 4 + halfword;
+                    const unsigned sourceLo = base + group + lane;
+                    const unsigned sourceHi = sourceLo + 4;
+                    storeU16(expected,
+                             destLane * 8 + destVgpr * 4,
+                             loadU16(input, sourceLo * 8 + halfword * 2));
+                    storeU16(expected,
+                             destLane * 8 + destVgpr * 4 + 2,
+                             loadU16(input, sourceHi * 8 + halfword * 2));
+                }
+            }
+        }
+    }
+    expectEqual(actual, expected);
+}
+
+TEST(DsTransposeTest, Cdna4KnownAsymmetricVectors)
+{
+    std::vector<uint8_t> b4(64 * 8, 0);
+    b4[0] = 0x1;
+    b4[7 * 8 + 7] = 0x20;
+    b4[16 * 8] = 0x3;
+    b4[31 * 8 + 7] = 0x40;
+    const auto b4Output = ds_transpose::transposeCdna4(
+        b4.data(), b4.size(), Kind::B4, 64);
+    EXPECT_EQ(ds_transpose::loadU32(b4Output.data(), 0), 0x00000001);
+    EXPECT_EQ(ds_transpose::loadU32(b4Output.data(), 4), 0x00000003);
+    EXPECT_EQ(ds_transpose::loadU32(b4Output.data(), 15 * 8),
+              0x20000000);
+    EXPECT_EQ(ds_transpose::loadU32(b4Output.data(), 31 * 8 + 4),
+              0x40000000);
+
+    std::vector<uint8_t> b8(64 * 8, 0);
+    for (unsigned lane = 0; lane < 64; ++lane)
+        for (unsigned byte = 0; byte < 8; ++byte)
+            b8[lane * 8 + byte] = static_cast<uint8_t>(lane * 8 + byte);
+    const auto b8Output = ds_transpose::transposeCdna4(
+        b8.data(), b8.size(), Kind::B8, 64);
+    EXPECT_EQ(loadU64(b8Output, 0 * 8), 0x5850484018100800ULL);
+    EXPECT_EQ(loadU64(b8Output, 1 * 8), 0x5951494119110901ULL);
+    EXPECT_EQ(loadU64(b8Output, 8 * 8), 0x7870686038302820ULL);
+
+    std::vector<uint8_t> b16(64 * 8, 0);
+    for (unsigned lane = 0; lane < 64; ++lane) {
+        for (unsigned halfword = 0; halfword < 4; ++halfword) {
+            storeU16(b16, lane * 8 + halfword * 2,
+                     static_cast<uint16_t>(lane * 16 + halfword));
+        }
+    }
+    const auto b16Output = ds_transpose::transposeCdna4(
+        b16.data(), b16.size(), Kind::B16, 64);
+    EXPECT_EQ(loadU64(b16Output, 0 * 8), 0x00c0008000400000ULL);
+    EXPECT_EQ(loadU64(b16Output, 1 * 8), 0x00c1008100410001ULL);
+    EXPECT_EQ(loadU64(b16Output, 4 * 8), 0x00d0009000500010ULL);
+
+    std::vector<uint8_t> b6(64 * 12, 0);
+    for (unsigned lane = 0; lane < 64; ++lane) {
+        for (unsigned element = 0; element < 16; ++element)
+            setB6(b6, lane, element, (lane + 17 * element) & 0x3f);
+    }
+    const auto b6Output = ds_transpose::transposeCdna4(
+        b6.data(), b6.size(), Kind::B6, 64);
+    EXPECT_EQ(ds_transpose::loadU32(b6Output.data(), 0 * 12 + 0),
+              0x480c2040);
+    EXPECT_EQ(ds_transpose::loadU32(b6Output.data(), 0 * 12 + 4),
+              0x24502ca2);
+    EXPECT_EQ(ds_transpose::loadU32(b6Output.data(), 0 * 12 + 8),
+              0x6da6584d);
+    EXPECT_EQ(ds_transpose::loadU32(b6Output.data(), 16 * 12 + 0),
+              0x4c1c6144);
+    EXPECT_EQ(ds_transpose::loadU32(b6Output.data(), 16 * 12 + 4),
+              0x65543ce3);
+    EXPECT_EQ(ds_transpose::loadU32(b6Output.data(), 16 * 12 + 8),
+              0x7de75c5d);
+}
+
+TEST(DsTransposeTest, DestinationVgprContracts)
+{
+    EXPECT_TRUE(ds_transpose::validDestinationVgpr(Kind::B4, 0));
+    EXPECT_TRUE(ds_transpose::validDestinationVgpr(Kind::B8, 254));
+    EXPECT_TRUE(ds_transpose::validDestinationVgpr(Kind::B16, 2));
+    EXPECT_FALSE(ds_transpose::validDestinationVgpr(Kind::B4, 1));
+    EXPECT_FALSE(ds_transpose::validDestinationVgpr(Kind::B8, 255));
+    EXPECT_FALSE(ds_transpose::validDestinationVgpr(Kind::B16, 253));
+
+    EXPECT_TRUE(ds_transpose::validDestinationVgpr(Kind::B6, 1));
+    EXPECT_TRUE(ds_transpose::validDestinationVgpr(Kind::B6, 253));
+    EXPECT_FALSE(ds_transpose::validDestinationVgpr(Kind::B6, 254));
+}

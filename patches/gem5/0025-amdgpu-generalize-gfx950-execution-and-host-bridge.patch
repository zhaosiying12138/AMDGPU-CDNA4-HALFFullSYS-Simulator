+bool
+HostGPUKmtState::releaseDispatch(
+    const Owner &transportOwner, uint64_t ownerId, uint64_t ownerGeneration,
+    uint64_t queueObjectId, uint64_t queueGeneration, uint64_t requestId)
+{
+    const Session *session = findSession(
+        transportOwner, ownerId, ownerGeneration);
+    if (!session || requestId == 0 ||
+        !idHasPrefix(queueObjectId, QueuePrefix)) {
+        return false;
+    }
+    const size_t queueSlot = idSlot(queueObjectId);
+    if (queueSlot >= queues.size() || !queues[queueSlot])
+        return false;
+    Queue &queue = *queues[queueSlot];
+    const auto expected = queue.dispatchPins.find(requestId);
+    if (queue.ownerId != ownerId ||
+        queue.ownerGeneration != ownerGeneration ||
+        queue.generation != queueGeneration ||
+        expected == queue.dispatchPins.end()) {
+        return false;
+    }
+
+    size_t pinnedCount = 0;
+    for (const auto &slot : allocations) {
+        if (slot && slot->ownerId == ownerId &&
+            slot->ownerGeneration == ownerGeneration &&
+            slot->dispatchPins.count(requestId) != 0) {
+            ++pinnedCount;
+        }
+    }
+    if (pinnedCount != expected->second)
+        return false;
+    for (auto &slot : allocations) {
+        if (slot && slot->ownerId == ownerId &&
+            slot->ownerGeneration == ownerGeneration) {
+            slot->dispatchPins.erase(requestId);
+        }
+    }
+    queue.dispatchPins.erase(expected);
+    return true;
+}
+
+bool
+HostGPUKmtState::ownerHasDispatchPins(const Owner &transportOwner) const
+{
+    const Session *session = findSession(transportOwner);
+    if (!session)
+        return false;
+    for (const auto &slot : allocations) {
+        if (slot && slot->ownerId == session->ownerId &&
+            slot->ownerGeneration == session->ownerGeneration &&
+            !slot->dispatchPins.empty()) {
+            return true;
+        }
+    }
+    for (const auto &slot : queues) {
+        if (slot && slot->ownerId == session->ownerId &&
+            slot->ownerGeneration == session->ownerGeneration &&
+            !slot->dispatchPins.empty()) {
+            return true;
+        }
+    }
+    return false;
+}

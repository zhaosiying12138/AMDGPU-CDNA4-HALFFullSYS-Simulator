+constexpr size_t SignalValueOffset = offsetof(amd_signal_t, value);
+constexpr size_t SignalTimestampOffset = offsetof(amd_signal_t, start_ts);
+constexpr size_t CompletionSignalOffset = 56;
+constexpr uint64_t MaximumPm4IbBytes = 16ULL << 20;
+constexpr uint8_t Pm4Type3 = 3;
+constexpr uint8_t Pm4Nop = 0x10;
+constexpr uint8_t Pm4IndirectBuffer = 0x3f;
+constexpr uint8_t Pm4AcquireMemory = 0x58;
+
+static_assert(SignalValueOffset == 8);
+static_assert(SignalTimestampOffset == 32);
+static_assert(offsetof(amd_signal_t, end_ts) == 40);
+static_assert(sizeof(amd_signal_t) == 64);
+static_assert(alignof(amd_signal_t) == 64);
+
+template <typename T>
+T
+load(const uint8_t *bytes, size_t offset)
+{
+    T value = {};
+    std::memcpy(&value, bytes + offset, sizeof(value));
+    return value;
+}
+
+bool
+allZero(const uint8_t *begin, const uint8_t *end)
+{
+    while (begin != end) {
+        if (*begin++ != 0)
+            return false;
+    }
+    return true;
+}

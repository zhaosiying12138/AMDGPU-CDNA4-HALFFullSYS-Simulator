+    setWords(crossingTail.argumentWords, 2, 3, 8192);
+    setWords(crossingTail.argumentWords, 4, 5, LocalMemoryBytes - 4096);
+    EXPECT_EQ(state.submit(owner, header(), crossingTail).response.status,
+              protocol::KmtStatus::InvalidParameter);
+
+    auto freeGpu = request(protocol::KmtOperation::FreeMemoryOfGpu, 8);
+    freeGpu.ownerId = opened.response.ownerId;
+    freeGpu.ownerGeneration = opened.response.ownerGeneration;
+    freeGpu.objectId = large.response.objectId;
+    freeGpu.objectGeneration = large.response.objectGeneration;
+    EXPECT_EQ(state.submit(owner, header(), freeGpu).response.status,
+              protocol::KmtStatus::Success);
+    freeGpu.operationSequence = 9;
+    freeGpu.objectId = highOffset.response.objectId;
+    freeGpu.objectGeneration = highOffset.response.objectGeneration;
+    EXPECT_EQ(state.submit(owner, header(), freeGpu).response.status,
+              protocol::KmtStatus::Success);
+
+    auto freeLegacy = request(protocol::KmtOperation::FreeMemory, 10);
+    freeLegacy.ownerId = opened.response.ownerId;
+    freeLegacy.ownerGeneration = opened.response.ownerGeneration;

+TEST(HostGPUProtocolAdapter, StatusMappingIsExhaustiveAndSymmetric)
+{
+    const std::array<std::pair<protocol::Status, domain::Status>, 11> cases = {{
+        {protocol::Status::Ok, domain::Status::Ok},
+        {protocol::Status::Malformed, domain::Status::InvalidArgument},
+        {protocol::Status::UnsupportedVersion,
+         domain::Status::UnsupportedFormat},
+        {protocol::Status::UnsupportedCapability,
+         domain::Status::UnsupportedFeature},
+        {protocol::Status::InstanceMismatch,
+         domain::Status::InstanceMismatch},
+        {protocol::Status::TopologyMismatch,
+         domain::Status::TargetMismatch},
+        {protocol::Status::Unauthorized, domain::Status::OwnerMismatch},
+        {protocol::Status::Busy, domain::Status::Busy},
+        {protocol::Status::ResourceExhausted,
+         domain::Status::ResourceExhausted},
+        {protocol::Status::ProtocolState, domain::Status::StaleState},
+        {protocol::Status::Internal, domain::Status::Internal},
+    }};
+    for (const auto &[wire, core] : cases) {
+        EXPECT_EQ(toDomain(wire), core);
+        EXPECT_EQ(toProtocol(core), wire);
+    }
+}
+
+TEST(HostGPUProtocolAdapter, MemoryCommandsAndResponsesPreserveIdentity)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::CopyH2D;
+    request.allocationId = 7;
+    request.generation = 9;
+    request.offset = 13;
+    request.byteCount = 4;
+    request.argument = 0x1234;
+
+    const auto transfer = hostTransfer(request, {1, 2, 3, 4});
+    EXPECT_EQ(transfer.range.allocation.id, 7);
+    EXPECT_EQ(transfer.range.allocation.generation, 9);
+    EXPECT_EQ(transfer.range.offset, 13);
+    EXPECT_EQ(transfer.range.bytes, 4);
+    EXPECT_EQ(transfer.bytes, (std::vector<uint8_t>{1, 2, 3, 4}));
+
+    domain::Result<domain::Unit> result;
+    result.status = domain::Status::Ok;
+    const auto response = memoryUnitResponse(request, result, 41, 0x1234);
+    EXPECT_EQ(response.status, protocol::Status::Ok);
+    EXPECT_EQ(response.allocationId, 7);
+    EXPECT_EQ(response.generation, 9);
+    EXPECT_EQ(response.value0, 13);
+    EXPECT_EQ(response.value1, 4);
+    EXPECT_EQ(response.value2, 0x1234);
+    EXPECT_EQ(response.simTick, 41);
+}
+
+TEST(HostGPUProtocolAdapter, CodeObjectMetadataRoundTrips)
+{
+    protocol::CodeObjectManifest wire;
+    wire.imageSize = 8192;
+    wire.chunkCount = 3;
+    wire.segmentCount = 1;
+    wire.kernelIndex = 2;
+    wire.imageSha256[0] = 0xa5;
+    wire.gfxTarget = protocol::GenericDispatchGfxTarget;
+    wire.kernargSegmentSize = 32;
+    wire.kernargSegmentAlign = 16;
+    wire.wavefrontSize = 64;
+    wire.descriptorSize = protocol::CodeObjectDescriptorBytes;
+    std::copy_n("kernel", 6, wire.kernelName.begin());
+    std::copy_n("kernel.kd", 9, wire.descriptorSymbol.begin());
+    wire.segments[0] = {1, 5, 0x100, 0x200, 0x300, 0x400, 0x1000};
+
+    const auto core = codeObjectMetadata(wire);
+    ASSERT_EQ(core.segments.size(), 1);
+    EXPECT_EQ(core.kernel.name, "kernel");
+    EXPECT_EQ(core.descriptorSymbol, "kernel.kd");
+    EXPECT_EQ(core.segments[0].virtualAddress, 0x200);
+
+    const auto rebuilt = codeObjectManifest(core);
+    ASSERT_TRUE(rebuilt.has_value());
+    EXPECT_EQ(rebuilt->imageSize, wire.imageSize);
+    EXPECT_EQ(rebuilt->kernelIndex, wire.kernelIndex);
+    EXPECT_EQ(rebuilt->imageSha256, wire.imageSha256);
+    EXPECT_EQ(rebuilt->kernargSegmentSize, wire.kernargSegmentSize);
+    EXPECT_EQ(rebuilt->segments[0].memorySize,
+              wire.segments[0].memorySize);
+}
+
+TEST(HostGPUProtocolAdapter, GenericDispatchConversionPreservesSemantics)
+{
+    protocol::GenericDispatchRequest wire;
+    wire.objectId = 11;
+    wire.objectGeneration = 12;
+    wire.mappingId = 13;
+    wire.mappingGeneration = 14;
+    wire.kernelIndex = 3;
+    wire.imageSha256[0] = 0x5a;
+    std::copy_n("generic", 7, wire.kernelName.begin());
+    wire.queueId = 21;
+    wire.queueGeneration = 22;
+    wire.queueSequence = 23;
+    wire.submit.kernargAllocationId = 31;
+    wire.submit.kernargGeneration = 32;
+    wire.submit.signalId = 41;
+    wire.submit.signalGeneration = 42;
+    wire.submit.kernargOffset = 8;
+    wire.submit.kernargSize = 24;
+    wire.submit.gridX = 256;
+    wire.submit.gridY = 2;
+    wire.submit.gridZ = 1;
+    wire.submit.workgroupX = 64;
+    wire.submit.workgroupY = 1;
+    wire.submit.workgroupZ = 1;
+    wire.submit.numWarps = 4;
+    wire.submit.numCtas = 1;
+    wire.submit.wavefrontSize = 64;
+
+    const auto command = submitKernel(wire);
+    EXPECT_EQ(command.object.id, 11);
+    EXPECT_EQ(command.mapping.id, 13);
+    EXPECT_EQ(command.kernarg.id, 31);
+    EXPECT_EQ(command.queue.id, 21);
+    EXPECT_EQ(command.signal.id, 41);
+    EXPECT_EQ(command.kernel.name, "generic");
+    EXPECT_EQ(command.geometry.grid[0], 256);
+    EXPECT_EQ(command.geometry.workgroup[0], 64);
+
+    domain::Result<domain::DispatchAdmission> result;
+    result.status = domain::Status::Ok;
+    result.value.object = command.object;
+    result.value.mapping = command.mapping;
+    result.value.kernarg = command.kernarg;
+    result.value.queue = command.queue;
+    result.value.signal = command.signal;
+    result.value.ticket = 51;
+    result.value.trace = 52;
+    result.value.kernelIndex = command.kernel.index;
+    result.value.imageSha256 = command.kernel.imageSha256;
+    const auto response = genericSubmitResponse(result);
+    EXPECT_EQ(response.status, protocol::Status::Ok);
+    EXPECT_EQ(response.objectId, 11);
+    EXPECT_EQ(response.mappingId, 13);
+    EXPECT_EQ(response.kernargAllocationId, 31);
+    EXPECT_EQ(response.queueId, 21);
+    EXPECT_EQ(response.signalId, 41);
+    EXPECT_EQ(response.ticketId, 51);
+    EXPECT_EQ(response.traceId, 52);
+}
+

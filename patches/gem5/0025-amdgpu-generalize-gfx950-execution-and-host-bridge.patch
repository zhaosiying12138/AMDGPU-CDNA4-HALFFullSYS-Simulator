+TEST(GpuDecoderTest, Gfx950MfmaF32_16x16x32Bf16)
+{
+    InstFormat words[2] = {};
+    words[0].imm_u32 = 0xd3b50002;
+    words[1].imm_u32 = 0x040a2106;
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "v_mfma_f32_16x16x32_bf16");
+    EXPECT_EQ(inst->instSize(), 8);
+    EXPECT_TRUE(inst->isMFMA());
+    EXPECT_EQ(inst->getNumOperands(), 4);
+    EXPECT_EQ(inst->getOperandSize(0), 16);
+    EXPECT_EQ(inst->getOperandSize(1), 16);
+    EXPECT_EQ(inst->getOperandSize(2), 16);
+    EXPECT_EQ(inst->getOperandSize(3), 16);
+}
+
+TEST(GpuDecoderTest, Gfx950MfmaExpandedFamily)
+{
+    struct Encoding
+    {
+        uint32_t word0;
+        const char *mnemonic;
+        std::array<int, 4> operandSizes;
+    };
+
+    // Raw encodings from LLVM's gfx950_mai.txt.  These opcode slots are
+    // gfx950-only overrides of older VOP3P table entries.
+    static constexpr std::array<Encoding, 5> Encodings = {{
+        {0xd3b60000, "v_mfma_i32_16x16x64_i8", {16, 16, 16, 16}},
+        {0xd3b70000, "v_mfma_f32_32x32x16_bf16", {16, 16, 64, 64}},
+        {0xd3b80000, "v_mfma_i32_32x32x32_i8", {16, 16, 64, 64}},
+        {0xd3d40000, "v_mfma_f32_16x16x32_f16", {16, 16, 16, 16}},
+        {0xd3d50000, "v_mfma_f32_32x32x16_f16", {16, 16, 64, 64}},
+    }};
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    for (const auto &encoding : Encodings) {
+        InstFormat words[2] = {};
+        words[0].imm_u32 = encoding.word0;
+        words[1].imm_u32 = 0x04020100;
+        SCOPED_TRACE(encoding.mnemonic);
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), encoding.mnemonic);
+        EXPECT_EQ(inst->instSize(), 8);
+        EXPECT_TRUE(inst->isALU());
+        EXPECT_TRUE(inst->isMFMA());
+        EXPECT_EQ(inst->getNumOperands(), 4);
+        for (int operand = 0; operand < 4; ++operand)
+            EXPECT_EQ(inst->getOperandSize(operand),
+                      encoding.operandSizes[operand]);
+    }
+}

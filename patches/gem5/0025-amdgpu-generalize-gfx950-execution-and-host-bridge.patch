+std::optional<HostGPUKmtState::MemoryInfo>
+HostGPUKmtState::memoryInfo(const Owner &transportOwner, uint64_t ownerId,
+                            uint64_t ownerGeneration, uint64_t gpuVa,
+                            uint64_t byteCount) const
+{
+    const Session *session = findSession(transportOwner, ownerId,
+                                         ownerGeneration);
+    if (session == nullptr || byteCount == 0 ||
+        gpuVa > std::numeric_limits<uint64_t>::max() - (byteCount - 1)) {
+        return std::nullopt;
+    }
+
+    const uint64_t end = gpuVa + byteCount;
+    std::optional<MemoryInfo> result;
+    for (size_t slot = 0; slot < allocations.size(); ++slot) {
+        if (!allocations[slot])
+            continue;
+        const Allocation &allocation = *allocations[slot];
+        if (allocation.ownerId != session->ownerId ||
+            allocation.ownerGeneration != session->ownerGeneration ||
+            allocation.virtualAddress == 0 ||
+            allocation.virtualAddress >
+                std::numeric_limits<uint64_t>::max() - allocation.size) {
+            continue;
+        }
+        const uint64_t allocationEnd =
+            allocation.virtualAddress + allocation.size;
+        if (gpuVa < allocation.virtualAddress || end > allocationEnd)
+            continue;
+        /* Overlapping live mappings make a VA lookup ambiguous.  Refuse the
+         * access instead of selecting an allocation by array order. */
+        if (result)
+            return std::nullopt;
+        const bool mappedToVisibleGpu = std::find(
+            allocation.mappedGpuIds.begin(),
+            allocation.mappedGpuIds.begin() + allocation.mappedGpuCount,
+            VisibleGpuId) !=
+            allocation.mappedGpuIds.begin() + allocation.mappedGpuCount;
+        result = MemoryInfo{
+            makeId(AllocationPrefix, slot), allocation.generation,
+            allocation.virtualAddress, allocation.size,
+            allocation.mmapOffset, allocation.gpuId, allocation.memoryFlags,
+            mappedToVisibleGpu};
+    }
+    return result;
+}

+bool
+HostKmtNativeMemory::read(Addr address, void *destination, size_t byteCount,
+                          uint64_t requestId) const
+{
+    if (backing != nullptr) {
+        const auto info = state.memoryInfo(
+            transportOwner, ownerId, ownerGeneration, address,
+            static_cast<uint64_t>(byteCount));
+        if (!info)
+            return false;
+        const uint64_t relative = address - info->gpuVa;
+        if (info->mmapOffset > std::numeric_limits<uint64_t>::max() - relative)
+            return false;
+        if ((info->flags &
+             protocol::KmtSharedBackingUserptrMemoryFlagMask) != 0) {
+            return processReadExact(
+                processPid, info->mmapOffset + relative, destination,
+                byteCount);
+        }
+        return backing->read(info->mmapOffset + relative, destination,
+                             byteCount);
+    }
+    return state.readMemory(transportOwner, ownerId, ownerGeneration,
+                            address, destination,
+                            static_cast<uint64_t>(byteCount), requestId);
+}
+
+bool
+HostKmtNativeMemory::write(Addr address, const void *source, size_t byteCount,
+                           uint64_t requestId)
+{
+    if (backing != nullptr) {
+        const auto info = state.memoryInfo(
+            transportOwner, ownerId, ownerGeneration, address,
+            static_cast<uint64_t>(byteCount));
+        if (!info)
+            return false;
+        const uint64_t relative = address - info->gpuVa;
+        if (info->mmapOffset > std::numeric_limits<uint64_t>::max() - relative)
+            return false;
+        if ((info->flags &
+             protocol::KmtSharedBackingUserptrMemoryFlagMask) != 0) {
+            return processWriteExact(
+                processPid, info->mmapOffset + relative, source, byteCount);
+        }
+        return backing->write(info->mmapOffset + relative, source, byteCount);
+    }
+    return state.writeMemory(transportOwner, ownerId, ownerGeneration,
+                             address, source,
+                             static_cast<uint64_t>(byteCount), requestId);
+}
+
+std::optional<domain::ResidentKernelView>
+HostKmtNativeMemory::residentKernel(
+    Addr descriptorVa, uint32_t gfxTarget, std::string diagnosticName) const
+{
+    const auto info = state.memoryInfo(
+        transportOwner, ownerId, ownerGeneration, descriptorVa,
+        domain::KernelDescriptorBytes);
+    if (!info || info->objectId == 0 || info->objectGeneration == 0 ||
+        info->gpuVa == 0 || info->size == 0 || gfxTarget == 0) {
+        return std::nullopt;
+    }
+    domain::ResidentKernelView resident;
+    resident.allocation = {info->objectId, info->objectGeneration};
+    resident.allocationBaseVa = info->gpuVa;
+    resident.allocationBytes = info->size;
+    resident.descriptorVa = descriptorVa;
+    resident.gfxTarget = gfxTarget;
+    resident.diagnosticName = std::move(diagnosticName);
+    return resident;
+}
+
+bool
+HostKmtQueueMemory::overlapsReadIndex(Addr address, size_t byteCount) const
+{
+    if (byteCount == 0 || readIndexAddress == 0 ||
+        readIndexAddress > std::numeric_limits<Addr>::max() -
+                               sizeof(uint64_t) ||
+        address > std::numeric_limits<Addr>::max() - (byteCount - 1)) {
+        return false;
+    }
+    const Addr last = address + byteCount - 1;
+    const Addr readIndexLast = readIndexAddress + sizeof(uint64_t) - 1;
+    return address <= readIndexLast && readIndexAddress <= last;
+}
+
+bool
+HostKmtQueueMemory::read(Addr address, void *destination, size_t byteCount,
+                         uint64_t requestId) const
+{
+    if (readIndexAddress == 0 ||
+        readIndexAddress > std::numeric_limits<Addr>::max() -
+                               sizeof(uint64_t)) {
+        return false;
+    }
+    if (overlapsReadIndex(address, byteCount)) {
+        return address == readIndexAddress && byteCount == sizeof(uint64_t) &&
+            backing.read(completionOffset, destination, byteCount);
+    }
+    return memory.read(address, destination, byteCount, requestId);
+}
+
+bool
+HostKmtQueueMemory::write(Addr address, const void *source, size_t byteCount,
+                          uint64_t requestId)
+{
+    if (readIndexAddress == 0 ||
+        readIndexAddress > std::numeric_limits<Addr>::max() -
+                               sizeof(uint64_t)) {
+        return false;
+    }
+    if (overlapsReadIndex(address, byteCount)) {
+        return address == readIndexAddress && byteCount == sizeof(uint64_t) &&
+            backing.write(completionOffset, source, byteCount);
+    }
+    return memory.write(address, source, byteCount, requestId);
+}
+
+HostKmtAqlQueueObserver::PollStatus
+HostKmtAqlQueueObserver::fail(const char *reason)
+{
+    failureReason = reason;
+    return PollStatus::Failed;
+}
+
+bool
+HostKmtAqlQueueObserver::initialize(uint64_t requestId)
+{
+    failureReason = "none";
+    if (initialized || queueInfo.clientQueueId == 0 ||
+        queueInfo.clientQueueId >= HostNativeQueueCore::MaxQueueId ||
+        queueInfo.registeredIndex >= HostNativeQueueCore::MaxQueueId ||
+        queueInfo.ringBytes == 0 ||
+        queueInfo.ringBytes > std::numeric_limits<uint32_t>::max() ||
+        queueInfo.ringBytes != static_cast<uint64_t>(queueInfo.depth) *
+                                   HostNativeQueueCore::PacketBytes ||
+        queueInfo.readPointer == 0 || queueInfo.writePointer == 0) {
+        failureReason = "invalid KMT queue observation metadata";
+        return false;
+    }
+
+    uint64_t readIndex = 0;
+    uint64_t writeIndex = 0;
+    uint64_t doorbell = 0;
+    if (!queueMemory.read(queueInfo.readPointer, &readIndex,
+                          sizeof(readIndex), requestId) ||
+        !memory.read(queueInfo.writePointer, &writeIndex,
+                     sizeof(writeIndex), requestId) ||
+        !backing.read(queueInfo.doorbellOffset, &doorbell,
+                      sizeof(doorbell))) {
+        failureReason = "KMT queue initial state read";
+        return false;
+    }
+    if (readIndex != writeIndex ||
+        doorbell != protocol::KmtSharedBackingDoorbellInitialValue) {
+        failureReason = "KMT queue is not initially empty";
+        return false;
+    }
+
+    HostNativeQueueCore::Config config;
+    config.baseVa = queueInfo.ringBase;
+    config.hostReadIndexVa = queueInfo.readPointer;
+    config.activeQueueId = queueInfo.clientQueueId;
+    config.generation = queueInfo.generation;
+    config.registeredIndex = queueInfo.registeredIndex;
+    config.queueBytes = static_cast<uint32_t>(queueInfo.ringBytes);
+    config.doorbellBytes = sizeof(uint64_t);
+    config.readIndex = readIndex;
+    if (!queueCore.registerQueue(config, requestId)) {
+        failureReason = queueCore.failure();
+        return false;
+    }
+    initialized = true;
+    observedDoorbell = false;
+    return true;
+}
+
+HostKmtAqlQueueObserver::PollStatus
+HostKmtAqlQueueObserver::poll(uint64_t requestId)
+{
+    failureReason = "none";
+    if (!initialized)
+        return fail("KMT queue observer is not initialized");
+
+    uint64_t doorbell = 0;
+    if (!backing.read(queueInfo.doorbellOffset, &doorbell,
+                      sizeof(doorbell))) {
+        return fail("KMT queue doorbell read");
+    }
+    if (doorbell == protocol::KmtSharedBackingDoorbellInitialValue) {
+        return observedDoorbell ?
+            fail("KMT queue doorbell returned to its initial value") :
+            PollStatus::Idle;
+    }
+
+    const uint64_t newWriteIndex = doorbell + 1;
+    uint64_t publishedWriteIndex = 0;
+    if (!memory.read(queueInfo.writePointer, &publishedWriteIndex,
+                     sizeof(publishedWriteIndex), requestId)) {
+        return fail("KMT queue write-index read");
+    }
+    if (publishedWriteIndex < newWriteIndex)
+        return fail("KMT doorbell precedes the published write index");
+
+    const uint64_t previous = queueCore.writeIndex();
+    uint32_t registeredIndex = 0;
+    if (!queueCore.observe(newWriteIndex, registeredIndex, requestId))
+        return fail(queueCore.failure());
+    if (registeredIndex != queueInfo.registeredIndex)
+        return fail("KMT queue registration identity changed");
+    observedDoorbell = true;
+    return queueCore.writeIndex() == previous ? PollStatus::Idle :
+                                               PollStatus::Advanced;
+}
+
+void
+HostKmtAqlQueueObserver::abandon()
+{
+    queueCore.abandonQueue();
+    initialized = false;
+    observedDoorbell = false;
+    failureReason = "none";
+}
+
+} // namespace gem5::hostgpu

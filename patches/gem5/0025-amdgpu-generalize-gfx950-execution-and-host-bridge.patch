+namespace gem5::hostgpu::domain
+{
+
+inline constexpr size_t Sha256Bytes = 32;
+inline constexpr size_t KernelDescriptorBytes = 64;
+inline constexpr size_t MaximumLoadSegments = 16;
+inline constexpr size_t MaximumUploadChunkBytes = 16ULL << 20;
+inline constexpr uint64_t MaximumTransferBytes = 16ULL << 20;
+inline constexpr uint32_t MaximumDescriptorPreloadDwords = 64;
+inline constexpr uint32_t MaximumSharedMemoryBytes = 65536;
+inline constexpr uint32_t MaximumWorkgroupDimension = 1024;
+inline constexpr uint32_t MaximumWarps = 32;
+inline constexpr uint32_t MaximumCtas = 8;
+inline constexpr uint32_t MaximumKernels = 16;
+
+using Sha256 = std::array<uint8_t, Sha256Bytes>;
+
+enum class Status
+{
+    Ok,
+    InvalidArgument,
+    UnsupportedFormat,
+    UnsupportedFeature,
+    InstanceMismatch,
+    TargetMismatch,
+    OwnerMismatch,
+    Busy,
+    ResourceExhausted,
+    StaleState,
+    Internal,
+};
+
+enum class FailureReason
+{
+    None,
+    InvalidOwner,
+    InvalidRequest,
+    Busy,
+    UnsupportedPreload,
+    Mapping,
+    Allocation,
+    PageMap,
+    Publication,
+    Queue,
+    CommandProcessor,
+    State,
+    Overflow,
+};
+
+struct Unit
+{};
+
+template <class T>
+struct Result
+{
+    Status status = Status::Internal;
+    FailureReason reason = FailureReason::None;
+    T value = {};
+
+    bool ok() const { return status == Status::Ok; }
+};
+
+struct OwnerKey
+{
+    uint64_t scope = 0;
+    uint64_t generation = 0;
+
+    bool operator==(const OwnerKey &other) const
+    {
+        return scope == other.scope && generation == other.generation;
+    }
+};
+
+struct OperationContext
+{
+    OwnerKey owner;
+    uint64_t leaseToken = 0;
+};
+
+struct ObjectHandle
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+};
+
+struct MappingHandle
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+};
+
+struct AllocationHandle
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+};
+
+struct QueueLease
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+    uint64_t sequence = 0;
+};
+
+struct SignalHandle
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+};
+
+struct DispatchIdentitySequence
+{
+    uint64_t nextMapping = 1;
+    uint64_t nextTrace = 1;
+};
+
+struct AllocationRequest
+{
+    uint64_t size = 0;
+    uint64_t alignment = 0;
+};
+
+struct AllocationInfo
+{
+    AllocationHandle allocation;
+    Addr gpuVa = 0;
+    uint64_t size = 0;
+    uint64_t alignment = 0;
+};
+
+struct MemoryRange
+{
+    AllocationHandle allocation;
+    uint64_t offset = 0;
+    uint64_t bytes = 0;
+};
+
+struct Transfer
+{
+    MemoryRange range;
+    std::vector<uint8_t> bytes;
+};
+
+struct KernelIdentity
+{
+    uint32_t index = 0;
+    Sha256 imageSha256 = {};
+    std::string name;
+};
+
+struct LoadSegment
+{
+    uint32_t type = 0;
+    uint32_t flags = 0;
+    uint64_t fileOffset = 0;
+    uint64_t virtualAddress = 0;
+    uint64_t fileSize = 0;
+    uint64_t memorySize = 0;
+    uint64_t alignment = 0;
+};
+
+struct CodeObjectMetadata
+{
+    uint64_t imageSize = 0;
+    KernelIdentity kernel;
+    uint16_t elfMachine = 0;
+    uint16_t elfType = 0;
+    uint8_t elfOsabi = 0;
+    uint8_t elfAbiVersion = 0;
+    uint32_t elfFlags = 0;
+    uint32_t gfxTarget = 0;
+    uint32_t codeObjectVersion = 0;
+    uint32_t metadataMajor = 0;
+    uint32_t metadataMinor = 0;
+    uint32_t relocationCount = 0;
+    uint32_t kernargSize = 0;
+    uint32_t kernargAlignment = 0;
+    uint32_t groupSegmentBytes = 0;
+    uint32_t privateSegmentBytes = 0;
+    uint32_t maximumWorkgroupSize = 0;
+    uint32_t wavefrontSize = 0;
+    uint32_t sgprCount = 0;
+    uint32_t vgprCount = 0;
+    bool usesDynamicStack = false;
+    int64_t kernelEntryOffset = 0;
+    uint64_t codeVirtualAddress = 0;
+    uint64_t codeFileOffset = 0;
+    uint64_t codeSize = 0;
+    uint64_t descriptorVirtualAddress = 0;
+    uint64_t descriptorFileOffset = 0;
+    std::string descriptorSymbol;
+    std::array<uint8_t, KernelDescriptorBytes> descriptor = {};
+    std::vector<LoadSegment> segments;
+};
+
+/**
+ * Owner-bound view of a kernel descriptor already resident in GPU memory.
+ *
+ * This is intentionally independent of an ELF/code-object loader.  Standard
+ * ROCr queues publish a descriptor GPU VA in the AQL packet, while explicit
+ * bridge uploads have already produced the same resident state through the
+ * code-object mapper.  The command processor consumes this common view and
+ * derives the executable entry and kernarg ABI from the descriptor bytes.
+ */
+struct ResidentKernelView
+{
+    AllocationHandle allocation;
+    Addr allocationBaseVa = 0;
+    uint64_t allocationBytes = 0;
+    Addr descriptorVa = 0;
+    /* Optional mapped-code expectations; both zero for descriptor-only views. */
+    Addr expectedCodeVa = 0;
+    Addr expectedEntryVa = 0;
+    uint32_t gfxTarget = 0;
+    std::string diagnosticName;
+};
+
+struct BeginUpload
+{
+    CodeObjectMetadata metadata;
+};
+
+struct AppendUpload
+{
+    ObjectHandle object;
+    uint64_t offset = 0;
+    uint32_t chunkIndex = 0;
+    std::vector<uint8_t> bytes;
+};
+
+struct CommitUpload
+{
+    ObjectHandle object;
+    uint64_t imageBytes = 0;
+    uint32_t chunkCount = 0;
+    Sha256 imageSha256 = {};
+};
+
+enum class MutationDisposition
+{
+    Keep,
+    AbortMutable,
+};
+
+struct UploadProgress
+{
+    ObjectHandle object;
+    uint64_t acceptedOffset = 0;
+    uint64_t acceptedBytes = 0;
+    uint32_t chunkIndex = 0;
+    uint64_t imageBytes = 0;
+    uint32_t kernelIndex = 0;
+    uint32_t segmentCount = 0;
+    Sha256 imageSha256 = {};
+    bool committed = false;
+};
+
+struct UploadResult
+{
+    Result<UploadProgress> result;
+    MutationDisposition disposition = MutationDisposition::Keep;
+};
+
+struct CommittedCodeObject
+{
+    ObjectHandle object;
+    CodeObjectMetadata metadata;
+    std::vector<uint8_t> image;
+};
+
+struct MapKernel
+{
+    ObjectHandle object;
+    KernelIdentity kernel;
+    uint32_t gfxTarget = 0;
+    uint32_t relocationCount = 0;
+    uint32_t kernargSize = 0;
+    uint32_t kernargAlignment = 0;
+    uint32_t descriptorPreloadDwords = 0;
+    uint32_t pageBytes = 0;
+};
+
+struct MappingInfo
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    Addr mappedBaseVa = 0;
+    Addr mappedEndVa = 0;
+    Addr descriptorVa = 0;
+    Addr codeVa = 0;
+    Addr entryVa = 0;
+    uint64_t mappedBytes = 0;
+    uint32_t kernelIndex = 0;
+    uint32_t segmentCount = 0;
+    uint32_t descriptorPreloadDwords = 0;
+    Sha256 imageSha256 = {};
+};
+
+struct AllocateKernarg
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    uint64_t size = 0;
+    uint64_t alignment = 0;
+};
+
+struct KernargInfo
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    AllocationHandle allocation;
+    Addr gpuVa = 0;
+    uint64_t size = 0;
+    uint64_t alignment = 0;
+    Sha256 imageSha256 = {};
+};
+
+struct PublishKernarg
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    AllocationHandle allocation;
+    uint64_t offset = 0;
+    std::vector<uint8_t> bytes;
+};
+
+struct LaunchGeometry
+{
+    std::array<uint32_t, 3> grid = {};
+    std::array<uint32_t, 3> workgroup = {};
+    uint32_t numWarps = 0;
+    uint32_t numCtas = 0;
+    uint32_t sharedMemoryBytes = 0;
+    uint32_t wavefrontSize = 0;
+};
+
+struct SubmitKernel
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    AllocationHandle kernarg;
+    QueueLease queue;
+    SignalHandle signal;
+    KernelIdentity kernel;
+    uint64_t kernargOffset = 0;
+    uint64_t kernargBytes = 0;
+    uint64_t expectedSignalValue = 0;
+    LaunchGeometry geometry;
+};
+
+struct DispatchAdmission
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    AllocationHandle kernarg;
+    QueueLease queue;
+    SignalHandle signal;
+    uint64_t expectedSignalValue = 0;
+    Addr kernargVa = 0;
+    uint64_t kernargBytes = 0;
+    uint64_t kernargAlignment = 0;
+    uint64_t ticket = 0;
+    uint64_t trace = 0;
+    Addr packetVa = 0;
+    uint32_t kernelIndex = 0;
+    uint32_t descriptorPreloadDwords = 0;
+    Sha256 imageSha256 = {};
+};
+
+struct UnmapKernel
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+};
+
+struct UnmapInfo
+{
+    ObjectHandle object;
+    MappingHandle mapping;
+    Sha256 imageSha256 = {};
+};
+
+} // namespace gem5::hostgpu::domain
+
+#endif // __DEV_AMDGPU_HOST_GPU_DOMAIN_TYPES_HH__

+                 {session.owner, session.submitRequestId},
+                 session.submitRequest, *session.nativeQueue),
+             "%s: quarantined generic native retirement failed", name());
+    session.nativeAdmitted = false;
+
+    const HostGPUQueueState::Owner queueOwner{
+        session.owner.fd, session.owner.clientGeneration};
+    fatal_if(!session.queuePinned || !queueState.releasePinnedDispatch(
+                 queueOwner, session.submitRequest.queueId,
+                 session.submitRequest.queueGeneration,
+                 session.submitRequestId),
+             "%s: quarantined generic queue release failed", name());
+    session.queuePinned = false;
+    const HostGPUSignalState::Owner signalOwner{
+        session.owner.fd, session.owner.clientGeneration};
+    fatal_if(!session.signalPinned ||
+                 !signalState.releasePinnedDispatchSignal(
+                     signalOwner, session.submitRequest.submit.signalId,
+                     session.submitRequest.submit.signalGeneration,
+                     session.submitRequestId),
+             "%s: quarantined generic signal release failed", name());
+    session.signalPinned = false;
+    fatal_if(!session.finishExecutionBinding() ||
+                 !session.releaseExecutionBuffers(session.executionRequestId),
+             "%s: quarantined generic adapter release failed", name());
+    session.executionRequestId = 0;
+    fatal_if(!session.releasePrivateResources(curTick()) ||
+                 !session.state->clear(),
+             "%s: quarantined generic private cleanup failed", name());
+
+    const HostGPUMemoryState::Owner memoryOwner{
+        session.owner.fd, session.owner.clientGeneration};
+    queueState.disconnect(queueOwner);
+    signalState.disconnect(signalOwner);
+    codeObjectState.disconnect({memoryOwner.fd, memoryOwner.clientGeneration});
+    kmtState.disconnect({memoryOwner.fd, memoryOwner.clientGeneration});
+    memoryState.disconnect(memoryOwner);

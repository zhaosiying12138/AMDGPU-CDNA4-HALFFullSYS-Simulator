+TEST(HostGpuProtocol, GenericExecutionCompletionCrcIsCapabilityBound)
+{
+    const auto control = genericSelectedCapabilities();
+    auto execution = control;
+    execution[GenericExecutionCapabilityByte] |=
+        GenericExecutionCapabilityMask;
+    const Header header = goldenMemoryHeader(404);
+
+    GenericDispatchResponse submit;
+    submit.status = Status::Ok;
+    submit.opcode = GenericDispatchOpcode::SubmitAql;
+    submit.objectId = 7;
+    submit.objectGeneration = 9;
+    submit.mappingId = 11;
+    submit.mappingGeneration = 13;
+    submit.queueId = 17;
+    submit.queueGeneration = 19;
+    submit.queueSequence = 23;
+    submit.signalId = 37;
+    submit.signalGeneration = 41;
+    submit.signalValueBits = 1;
+    submit.kernargAllocationId = 29;
+    submit.kernargGeneration = 31;
+    submit.kernargVa = 0x100000004000ULL;
+    submit.kernargSize = 280;
+    submit.kernargAlignment = 8;
+    submit.ticketId = 59;
+    submit.traceId = 67;
+    submit.packetVa = 0x100000005000ULL;
+    submit.imageSha256.fill(0xa5);
+
+    EXPECT_FALSE(encodeGenericDispatchAck(header, submit, control).empty());
+    EXPECT_FALSE(encodeGenericDispatchAck(header, submit, execution).empty());
+    submit.outputCrc32c = 0x6f67026fU;
+    EXPECT_TRUE(encodeGenericDispatchAck(header, submit, control).empty());
+    EXPECT_TRUE(encodeGenericDispatchAck(header, submit, execution).empty());
+
+    submit.outputCrc32c = 0;
+    EXPECT_FALSE(
+        encodeGenericDispatchCompletion(header, submit, control).empty());
+    EXPECT_TRUE(
+        encodeGenericDispatchCompletion(header, submit, execution).empty());
+    submit.outputCrc32c = 0x6f67026fU;
+    EXPECT_TRUE(
+        encodeGenericDispatchCompletion(header, submit, control).empty());
+    auto frame = encodeGenericDispatchCompletion(header, submit, execution);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    auto decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, execution,
+        header.requestId, MessageType::GenericDispatchCompletion);
+    EXPECT_EQ(decoded.status, Status::Ok);
+
+    store32(frame, HeaderBytes + 228, 0);
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, execution,
+        header.requestId, MessageType::GenericDispatchCompletion);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+}

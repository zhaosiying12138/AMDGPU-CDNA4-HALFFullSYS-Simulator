+void
+HostGPUBridge::genericExecutionRetired(GenericDispatchSession &session)
+{
+    if (quarantinedGenericDispatch.get() == &session) {
+        if (session.completionScheduled)
+            return;
+        session.completionScheduled = true;
+        auto *event = new EventFunctionWrapper(
+            [this]() { cleanupQuarantinedGenericExecution(); },
+            name() + ".host_gpu_quarantined_generic_cleanup", true);
+        schedule(event, curTick());
+        return;
+    }
+    auto found = clients.find(session.owner.fd);
+    if (found == clients.end() ||
+        found->second->generation != session.owner.clientGeneration ||
+        found->second->genericDispatch.get() != &session ||
+        !session.ackSent || session.completionScheduled ||
+        session.completionQueued) {
+        return;
+    }
+    session.completionScheduled = true;
+    const int fd = session.owner.fd;
+    const uint64_t generation = session.owner.clientGeneration;
+    auto *event = new EventFunctionWrapper(
+        [this, fd, generation]() {
+            processGenericDispatchCompletion(fd, generation);
+        }, name() + ".host_gpu_generic_execution_completion", true);
+    schedule(event, curTick());
+}
+
+void
+HostGPUBridge::cleanupQuarantinedGenericExecution()
+{
+    if (!quarantinedGenericDispatch)
+        return;
+    GenericDispatchSession &session = *quarantinedGenericDispatch;
+    session.completionScheduled = false;
+    fatal_if(!session.executionMode || !session.executionRetired ||
+                 !session.executionCompleted || !session.state ||
+                 !session.nativeQueue || !session.state->hasSubmission() ||
+                 !executionAdapter || !executionAdapter->packetRetired(),
+             "%s: invalid quarantined generic retirement state", name());

+#include "dev/amdgpu/host_gpu_native_execution_adapter.hh"
+
+#include <utility>
+
+#include "base/logging.hh"
+#include "gpu-compute/dispatcher.hh"
+#include "gpu-compute/hsa_queue_entry.hh"
+#include "gpu-compute/shader.hh"
+#include "sim/core.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+HostNativeExecutionAdapter::~HostNativeExecutionAdapter()
+{
+    /* The dispatcher and shader are SimObjects owned by the configuration.
+     * They outlive this value member, so restore their hooks while the
+     * delegate pointers are still valid.  An in-flight task is intentionally
+     * left untouched; callers must quarantine and retire it before teardown. */
+    fatal_if(tokenMux.active(),
+             "native execution adapter destroyed with an active binding");
+    if (attached())
+        fatal_if(!detach(), "native execution adapter detach failed");
+}
+
+bool
+HostNativeExecutionAdapter::fail(const char *reason)
+{
+    failure = reason ? reason : "adapter failure";
+    return false;
+}
+
+bool
+HostNativeExecutionAdapter::attach(GPUDispatcher &newDispatcher, Shader &newShader)
+{
+    if (tokenMux.active() && attached())
+        return fail("cannot attach with an active binding");
+    if (attached() && (dispatcher != &newDispatcher || shader != &newShader))
+        return fail("adapter is already attached to another pipeline");
+    if (attached())
+        return true;
+
+    dispatcher = &newDispatcher;
+    shader = &newShader;
+    previousNativeMemory = shader->nativeMemory();
+    shader->setNativeMemory(this);
+    previousLifecycleSink = dispatcher->lifecycleListenerPtr();
+    dispatcher->setLifecycleListener(this);
+    if (tokenMux.active()) {
+        previousCompletionSink = dispatcher->completionSinkPtr();
+        dispatcher->setCompletionSink(this);
+        completionEngaged = true;
+    }
+    failure.clear();
+    return true;
+}
+
+bool
+HostNativeExecutionAdapter::detach()
+{
+    if (tokenMux.active())
+        return fail("cannot detach with an active binding");
+    if (!attached())
+        return true;
+
+    if (shader->nativeMemory() == this)
+        shader->setNativeMemory(previousNativeMemory);
+    dispatcher->setLifecycleListener(previousLifecycleSink);
+    if (completionEngaged)
+        dispatcher->setCompletionSink(previousCompletionSink);
+    dispatcher = nullptr;
+    shader = nullptr;
+    previousNativeMemory = nullptr;
+    previousLifecycleSink = nullptr;
+    return true;
+}
+
+bool
+HostNativeExecutionAdapter::bind(
+    int newDispatchId, uint64_t newWireRequestId, GPUNativeMemory &newBacking)
+{
+    if (&newBacking == this)
+        return fail("adapter cannot back itself");
+    if (!tokenMux.bind(newDispatchId, newWireRequestId, newBacking)) {
+        failure = tokenMux.failureReason();
+        return false;
+    }
+    commandProcessorSeen = false;
+    dispatchStartTick = 0;
+    dispatchEndTick = 0;
+    dispatchRetireTick = 0;
+    if (attached()) {
+        previousCompletionSink = dispatcher->completionSinkPtr();
+        dispatcher->setCompletionSink(this);
+        completionEngaged = true;
+    }
+    failure.clear();
+    return true;
+}
+
+bool
+HostNativeExecutionAdapter::submit(std::unique_ptr<HSAQueueEntry> task)
+{
+    if (!attached())
+        return fail("cannot submit before attach");
+    if (!tokenMux.active())
+        return fail("cannot submit without a binding");
+    if (tokenMux.dispatchSubmitted())
+        return fail("binding already submitted");
+    if (!task)
+        return fail("null task");
+    if (!task->ownsDispatchPacket())
+        return fail("task does not own its dispatch packet");
+    if (task->dispatchId() != tokenMux.dispatchId())
+        return fail("task dispatch ID does not match binding");
+    if (attached() && !completionEngaged)
+        return fail("completion sink is not engaged for the binding");
+
+    if (!tokenMux.markSubmitted(tokenMux.dispatchId())) {
+        failure = tokenMux.failureReason();
+        return false;
+    }
+    dispatcher->dispatch(task.release());
+    return true;
+}
+
+bool
+HostNativeExecutionAdapter::quarantine(int expectedDispatchId)
+{
+    if (!tokenMux.active())
+        return fail("cannot quarantine without a binding");
+    if (!tokenMux.quarantine(expectedDispatchId)) {
+        failure = tokenMux.failureReason();
+        return false;
+    }
+    return true;
+}
+
+bool
+HostNativeExecutionAdapter::release(int expectedDispatchId)
+{
+    if (!tokenMux.active())
+        return fail("cannot release without a binding");
+    if (!tokenMux.release(expectedDispatchId)) {
+        failure = tokenMux.failureReason();
+        return false;
+    }
+    clearBinding();
+    return true;
+}
+
+void
+HostNativeExecutionAdapter::clearBinding()
+{
+    if (completionEngaged && dispatcher)
+        dispatcher->setCompletionSink(previousCompletionSink);
+    completionEngaged = false;
+    previousCompletionSink = nullptr;
+    commandProcessorSeen = false;
+    dispatchStartTick = 0;
+    dispatchEndTick = 0;
+    dispatchRetireTick = 0;
+}
+
+bool
+HostNativeExecutionAdapter::read(
+    Addr address, void *destination, size_t byteCount, uint64_t requestId) const
+{
+    const bool success = tokenMux.read(
+        address, destination, byteCount, requestId);
+    if (!success)
+        failure = tokenMux.failureReason();
+    return success;
+}
+
+bool
+HostNativeExecutionAdapter::write(
+    Addr address, const void *source, size_t byteCount, uint64_t requestId)
+{
+    const bool success = tokenMux.write(
+        address, source, byteCount, requestId);
+    if (!success)
+        failure = tokenMux.failureReason();
+    return success;
+}
+
+bool
+HostNativeExecutionAdapter::taskMatches(const HSAQueueEntry &task) const
+{
+    return tokenMux.active() && task.dispatchId() == tokenMux.dispatchId();
+}
+
+void
+HostNativeExecutionAdapter::hsaPacketFetched(
+    Addr hostPacketAddr, uint32_t queueId)
+{
+    if (tokenMux.active()) {
+        panic_if(!lifecycleSink,
+                 "native execution adapter has no lifecycle sink");
+        lifecycleSink->hsaPacketFetched(hostPacketAddr, queueId);
+    } else if (lifecycleSink) {
+        lifecycleSink->hsaPacketFetched(hostPacketAddr, queueId);
+    }
+}
+
+void
+HostNativeExecutionAdapter::commandProcessorSubmitted(
+    const HSAQueueEntry &task)
+{
+    if (tokenMux.active()) {
+        panic_if(!taskMatches(task),
+                 "native execution adapter command-processor identity mismatch");
+        commandProcessorSeen = true;
+    }
+    if (lifecycleSink)
+        lifecycleSink->commandProcessorSubmitted(task);
+}
+
+void
+HostNativeExecutionAdapter::gpuDispatcherStarted(const HSAQueueEntry &task)
+{
+    if (tokenMux.active()) {
+        panic_if(!taskMatches(task) || !tokenMux.dispatchSubmitted(),
+                 "native execution adapter dispatcher identity mismatch");
+        dispatchStartTick = curTick();
+    }
+    if (lifecycleSink)
+        lifecycleSink->gpuDispatcherStarted(task);
+}
+
+void
+HostNativeExecutionAdapter::cuWaveStarted(
+    const HSAQueueEntry &task, int cuId, int waveId, uint32_t workgroupX,
+    uint32_t workgroupY, uint32_t workgroupZ, uint64_t laneMask)
+{
+    if (tokenMux.active())
+        panic_if(!taskMatches(task),
+                 "native execution adapter wave identity mismatch");
+    if (lifecycleSink)
+        lifecycleSink->cuWaveStarted(
+            task, cuId, waveId, workgroupX, workgroupY, workgroupZ, laneMask);
+}
+
+void
+HostNativeExecutionAdapter::cuInstructionStarted(
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    uint64_t dynamicWaveId, Addr pc, uint64_t sequence)
+{
+    if (tokenMux.active())
+        panic_if(!taskMatches(task),
+                 "native execution adapter instruction identity mismatch");
+    if (lifecycleSink)
+        lifecycleSink->cuInstructionStarted(
+            task, cuId, workgroupId, dynamicWaveId, pc, sequence);
+}
+
+void
+HostNativeExecutionAdapter::cuGlobalStoreCompleted(
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    const std::vector<Addr> &addresses, uint32_t bytesPerLane,
+    uint64_t laneMask)
+{
+    if (tokenMux.active())
+        panic_if(!taskMatches(task),
+                 "native execution adapter global-store identity mismatch");
+    if (lifecycleSink)
+        lifecycleSink->cuGlobalStoreCompleted(
+            task, cuId, workgroupId, addresses, bytesPerLane, laneMask);
+}
+
+void
+HostNativeExecutionAdapter::gpuWorkgroupCompleted(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    if (tokenMux.active())
+        panic_if(!taskMatches(task),
+                 "native execution adapter workgroup identity mismatch");
+    if (lifecycleSink)
+        lifecycleSink->gpuWorkgroupCompleted(task, cuId, workgroupId);
+}
+
+void
+HostNativeExecutionAdapter::hsaPacketRetired(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    if (tokenMux.active()) {
+        panic_if(!taskMatches(task) || !tokenMux.kernelCompleted(),
+                 "native execution adapter retirement identity mismatch");
+        panic_if(!tokenMux.markPacketRetired(tokenMux.dispatchId()),
+                 "native execution adapter packet-retire state mismatch");
+        dispatchRetireTick = curTick();
+    }
+    if (lifecycleSink)
+        lifecycleSink->hsaPacketRetired(task, cuId, workgroupId);
+}
+
+bool
+HostNativeExecutionAdapter::completeKernel(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    if (tokenMux.active()) {
+        if (!taskMatches(task) || tokenMux.kernelCompleted())
+            return fail("native execution adapter completion identity mismatch");
+        if (!completionSink)
+            return fail("native execution adapter has no completion sink");
+        const bool success = completionSink->completeKernel(
+            task, cuId, workgroupId);
+        if (success) {
+            if (!tokenMux.markKernelCompleted(tokenMux.dispatchId())) {
+                failure = tokenMux.failureReason();
+                return false;
+            }
+            dispatchEndTick = curTick();
+        }
+        return success;
+    }
+    return completionSink && completionSink->completeKernel(
+        task, cuId, workgroupId);
+}
+
+} // namespace hostgpu
+} // namespace gem5

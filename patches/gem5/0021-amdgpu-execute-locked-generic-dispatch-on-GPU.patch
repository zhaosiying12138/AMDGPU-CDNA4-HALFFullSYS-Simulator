+/*
+ * Copyright (c) 2026 The gem5 Project
+ * All rights reserved.
+ */
+
+#include "dev/amdgpu/host_gpu_native_dispatch_token_mux.hh"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+#include <gtest/gtest.h>
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+namespace
+{
+
+class RecordingMemory final : public GPUNativeMemory
+{
+  public:
+    bool read(Addr, void *destination, size_t byteCount,
+              uint64_t requestId) const override
+    {
+        lastReadToken = requestId;
+        ++readCalls;
+        std::memset(destination, 0xa5, byteCount);
+        return true;
+    }
+
+    bool write(Addr, const void *, size_t,
+               uint64_t requestId) override
+    {
+        lastWriteToken = requestId;
+        ++writeCalls;
+        return true;
+    }
+
+    mutable uint64_t lastReadToken = 0;
+    uint64_t lastWriteToken = 0;
+    mutable uint64_t readCalls = 0;
+    uint64_t writeCalls = 0;
+};
+
+} // anonymous namespace
+
+TEST(HostNativeDispatchTokenMuxTest, TranslationAndQuarantine)
+{
+    constexpr int dispatchId = 17;
+    constexpr uint64_t wireToken = 0x100000001ULL;
+    RecordingMemory memory;
+    HostNativeDispatchTokenMux mux;
+    std::array<uint8_t, 8> bytes = {};
+    const uint8_t source = 0x3c;
+
+    ASSERT_TRUE(mux.bind(dispatchId, wireToken, memory));
+    EXPECT_TRUE(mux.read(0x4000, bytes.data(), bytes.size(), dispatchId));
+    EXPECT_FALSE(mux.read(0x4000, bytes.data(), bytes.size(), dispatchId + 1));
+    EXPECT_TRUE(mux.write(0x4000, &source, sizeof(source), dispatchId));
+    EXPECT_FALSE(mux.bind(dispatchId + 1, wireToken + 1, memory));
+    ASSERT_TRUE(mux.markSubmitted(dispatchId));
+    ASSERT_TRUE(mux.quarantine(dispatchId));
+    EXPECT_FALSE(mux.release(dispatchId));
+    ASSERT_TRUE(mux.markKernelCompleted(dispatchId));
+    ASSERT_TRUE(mux.markPacketRetired(dispatchId));
+    ASSERT_TRUE(mux.release(dispatchId));
+
+    EXPECT_EQ(bytes[0], 0xa5);
+    EXPECT_EQ(memory.lastReadToken, wireToken);
+    EXPECT_EQ(memory.lastWriteToken, wireToken);
+    EXPECT_EQ(memory.readCalls, 1U);
+    EXPECT_EQ(memory.writeCalls, 1U);
+    EXPECT_TRUE(mux.lastQuarantined());
+    EXPECT_TRUE(mux.lastPacketRetired());
+    EXPECT_TRUE(mux.tokenTranslated());
+    EXPECT_FALSE(mux.active());
+}
+
+TEST(HostNativeDispatchTokenMuxTest, RejectsInvalidBindings)
+{
+    RecordingMemory memory;
+    HostNativeDispatchTokenMux mux;
+    EXPECT_FALSE(mux.bind(0, 1, memory));
+    EXPECT_FALSE(mux.bind(17, 0, memory));
+}
+
+} // namespace hostgpu
+} // namespace gem5

+ * All rights reserved.
+ */
+
+#include "dev/amdgpu/host_gpu_native_dispatch_token_mux.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+bool
+HostNativeDispatchTokenMux::fail(const char *reason)
+{
+    failure = reason ? reason : "token mux failure";
+    return false;
+}
+
+bool
+HostNativeDispatchTokenMux::bind(
+    int dispatchId, uint64_t wireRequestId, GPUNativeMemory &newBacking)
+{
+    if (bound)
+        return fail("one-in-flight binding is busy");
+    if (dispatchId <= 0)
+        return fail("dispatch ID must be positive");
+    if (wireRequestId == 0)
+        return fail("wire request token must be nonzero");
+    backing = &newBacking;
+    currentDispatchId = dispatchId;
+    currentWireRequestId = wireRequestId;
+    bound = true;
+    submitted = false;
+    ownerQuarantined = false;
+    kernelDone = false;
+    packetDone = false;
+    historicalDispatchId = static_cast<uint64_t>(dispatchId);
+    historicalWireRequestId = wireRequestId;
+    historicalQuarantine = false;
+    historicalRetire = false;
+    historicalTranslation = false;
+    failure.clear();
+    return true;
+}
+
+bool
+HostNativeDispatchTokenMux::markSubmitted(int dispatchId)
+{
+    if (!bound || dispatchId != currentDispatchId)
+        return fail("submission dispatch ID mismatch");
+    if (submitted)
+        return fail("binding already submitted");
+    submitted = true;
+    return true;
+}
+
+bool
+HostNativeDispatchTokenMux::quarantine(int dispatchId)
+{
+    if (!bound || dispatchId != currentDispatchId)
+        return fail("quarantine dispatch ID mismatch");
+    if (packetDone)
+        return fail("cannot quarantine a retired packet");
+    ownerQuarantined = true;
+    historicalQuarantine = true;
+    return true;
+}
+
+bool
+HostNativeDispatchTokenMux::markKernelCompleted(int dispatchId)
+{
+    if (!bound || dispatchId != currentDispatchId || !submitted || kernelDone)
+        return fail("kernel completion lifecycle mismatch");
+    kernelDone = true;
+    return true;
+}
+
+bool
+HostNativeDispatchTokenMux::markPacketRetired(int dispatchId)
+{
+    if (!bound || dispatchId != currentDispatchId || !kernelDone || packetDone)
+        return fail("packet retirement lifecycle mismatch");
+    packetDone = true;
+    historicalRetire = true;
+    return true;
+}
+
+bool
+HostNativeDispatchTokenMux::release(int dispatchId)
+{
+    if (!bound || dispatchId != currentDispatchId)
+        return fail("release dispatch ID mismatch");
+    if (submitted && !packetDone)
+        return fail("submitted binding is retained until packet retirement");
+    historicalQuarantine = historicalQuarantine || ownerQuarantined;
+    historicalRetire = historicalRetire || packetDone;
+    clearBinding();
+    return true;
+}
+
+void
+HostNativeDispatchTokenMux::clearBinding()
+{
+    backing = nullptr;
+    currentDispatchId = 0;
+    currentWireRequestId = 0;
+    bound = false;
+    submitted = false;
+    ownerQuarantined = false;
+    kernelDone = false;
+    packetDone = false;
+}
+
+bool
+HostNativeDispatchTokenMux::read(
+    Addr address, void *destination, size_t byteCount,
+    uint64_t dispatchRequestId) const
+{
+    if (!bound || !backing || dispatchRequestId == 0 ||
+        dispatchRequestId != static_cast<uint64_t>(currentDispatchId)) {
+        failure = "native read request token does not match dispatch binding";
+        return false;
+    }
+    const bool success = backing->read(
+        address, destination, byteCount, currentWireRequestId);
+    if (success) {
+        ++readCount;
+        historicalTranslation = true;
+    }
+    return success;
+}
+
+bool
+HostNativeDispatchTokenMux::write(
+    Addr address, const void *source, size_t byteCount,
+    uint64_t dispatchRequestId)
+{
+    if (!bound || !backing || dispatchRequestId == 0 ||
+        dispatchRequestId != static_cast<uint64_t>(currentDispatchId)) {
+        return fail("native write request token does not match dispatch binding");
+    }
+    const bool success = backing->write(
+        address, source, byteCount, currentWireRequestId);
+    if (success) {
+        ++writeCount;
+        historicalTranslation = true;
+    }
+    return success;
+}
+
+} // namespace hostgpu
+} // namespace gem5

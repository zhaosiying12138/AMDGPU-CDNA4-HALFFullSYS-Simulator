+    bool read(Addr address, void *destination, size_t byteCount,
+              uint64_t requestId = 0) const override
+    {
+        const bool packetRead = packetAllocation &&
+            address == packetAllocation->view.gpuVa + 4 &&
+            byteCount == sizeof(uint32_t);
+        const bool kernargRead =
+            address == submitResponse.kernargVa && byteCount == 32;
+        const bool inputRead = executionBuffers[0] &&
+            rangeContains(executionBuffers[0]->address,
+                          GenericExecutionBufferBytes, address, byteCount);
+        const bool codeRead = byteCount == 64 && address % 64 == 0 &&
+            (address == mapResponse.entryVa ||
+             address == mapResponse.entryVa + 64);
+        size_t inputIndex = 0;
+        if (executionActive) {
+            panic_if(!packetRead && !kernargRead && !inputRead && !codeRead,
+                     "unexpected generic execution read at %#x/%llu", address,
+                     static_cast<unsigned long long>(byteCount));
+            if (inputRead) {
+                panic_if(byteCount != sizeof(uint32_t) ||
+                             address % sizeof(uint32_t) != 0,
+                         "generic execution global-read shape mismatch");
+                inputIndex = static_cast<size_t>(
+                    (address - executionBuffers[0]->address) /
+                    sizeof(uint32_t));
+                panic_if(inputReadCoverage.test(inputIndex),
+                         "duplicate generic execution input read");
+            }
+        }
+        const bool success = context && context->functionalRead(
+            address, destination, byteCount, requestId);
+        if (!success || !executionActive)
+            return success;
+        if (packetRead || kernargRead) {
+            ++const_cast<GenericDispatchSession *>(this)->scalarReads;
+        } else if (inputRead) {
+            const_cast<GenericDispatchSession *>(this)->inputReadCoverage.set(
+                inputIndex);
+            ++const_cast<GenericDispatchSession *>(this)->globalReads;
+        }
+        return true;
+    }
+
+    bool write(Addr address, const void *source, size_t byteCount,
+               uint64_t requestId = 0) override
+    {
+        const bool outputWrite = executionBuffers[1] &&
+            rangeContains(executionBuffers[1]->address,
+                          GenericExecutionBufferBytes, address, byteCount);
+        const bool resultWrite = executionBuffers[2] &&
+            rangeContains(executionBuffers[2]->address,
+                          GenericExecutionBufferBytes, address, byteCount);
+        size_t index = 0;
+        if (executionActive) {
+            panic_if(byteCount != sizeof(uint32_t) ||
+                         address % sizeof(uint32_t) != 0 ||
+                         outputWrite == resultWrite,
+                     "unexpected generic execution write at %#x/%llu", address,
+                     static_cast<unsigned long long>(byteCount));
+            const Addr base = outputWrite ? executionBuffers[1]->address :
+                executionBuffers[2]->address;
+            index = static_cast<size_t>((address - base) / sizeof(uint32_t));
+            panic_if((outputWrite ? outputWriteCoverage : resultWriteCoverage)
+                         .test(index),
+                     "duplicate generic execution output write");
+        }
+        const bool success = context && context->functionalWrite(
+            address, source, byteCount, requestId);
+        if (!success || !executionActive)
+            return success;
+        (outputWrite ? outputWriteCoverage : resultWriteCoverage).set(index);
+        ++globalWrites;
+        return true;
+    }
+
+    static bool rangeContains(
+        Addr base, uint64_t bytes, Addr address, size_t byteCount)
+    {
+        if (base == 0 || byteCount == 0 || address < base)
+            return false;
+        const uint64_t offset = address - base;
+        return offset <= bytes && byteCount <= bytes - offset;
+    }
+
+    static bool validPointer(Addr value)
+    {
+        return value != 0 && (value & 3) == 0;
+    }
+
+    bool prepareExecutionBuffers(const protocol::GenericDispatchRequest &request,
+                                 uint64_t requestId)
+    {
+        if (!executionMode || !executionAdapter || executionAdapter->active() ||
+            requestId == 0 || !allocResponse.kernargVa ||
+            request.submit.kernargOffset >
+                std::numeric_limits<Addr>::max() - allocResponse.kernargVa)
+            return false;
+        const Addr kernargVa = allocResponse.kernargVa +
+            request.submit.kernargOffset;
+        std::vector<uint8_t> kernarg;
+        if (request.submit.kernargSize != 280 ||
+            !context->functionalRead(
+                kernargVa, request.submit.kernargSize, kernarg, requestId) ||
+            kernarg.size() != request.submit.kernargSize ||
+            kernarg[88] != 1)
+            return false;
+        for (size_t offset = 24; offset < kernarg.size(); ++offset) {
+            if (offset != 88 && kernarg[offset] != 0)
+                return false;
+        }
+        std::array<uint64_t, 3> pointers = {};
+        std::memcpy(pointers.data(), kernarg.data(), sizeof(pointers));
+        std::array<uint64_t, 3> seen = {};
+        for (size_t index = 0; index < pointers.size(); ++index) {
+            if (!validPointer(pointers[index]))
+                return false;
+            for (size_t prior = 0; prior < index; ++prior) {
+                if (seen[prior] == pointers[index])
+                    return false;
+            }
+            seen[index] = pointers[index];
+            const auto allocation = [&]() -> std::optional<HostGPUMemoryState::AllocationView> {
+                for (const auto &candidate : memory.allocationsForOwner(owner)) {
+                    if (pointers[index] == candidate.gpuVa &&
+                        candidate.size == GenericExecutionBufferBytes &&
+                        candidate.alignment == GenericExecutionBufferBytes)
+                        return candidate;
+                }
+                return std::nullopt;
+            }();
+            if (!allocation)
+                return false;
+            const auto lease = context->map(
+                pointers[index], GenericExecutionBufferBytes);
+            if (!lease || !memory.pinPinnedDispatchAllocation(
+                    owner, allocation->allocationId, allocation->generation,
+                    requestId)) {
+                if (lease)
+                    context->unmap(*lease);
+                releaseExecutionBuffers(requestId);
+                return false;
+            }
+            executionBuffers[index].emplace(
+                ExecutionAllocation{*allocation, *lease, pointers[index]});
+            executionAllocationViews[index] = *allocation;
+        }
+        for (size_t index = 0; index < executionBefore.size(); ++index) {
+            if (!context->functionalRead(
+                    executionBuffers[index]->address,
+                    GenericExecutionBufferBytes, executionBefore[index],
+                    requestId)) {
+                releaseExecutionBuffers(requestId);
+                return false;
+            }
+        }
+        for (uint32_t index = 0;
+             index < GenericExecutionBufferBytes / sizeof(uint32_t); ++index) {
+            std::array<uint32_t, 3> values = {};
+            for (size_t buffer = 0; buffer < values.size(); ++buffer) {
+                std::memcpy(&values[buffer],
+                            executionBefore[buffer].data() +
+                                index * sizeof(uint32_t),
+                            sizeof(uint32_t));
+            }
+            if (values[0] != (0x51000000U ^ index) ||
+                values[1] != (0x6b000000U ^ index) ||
+                values[2] != (0x7c000000U ^ index)) {
+                releaseExecutionBuffers(requestId);
+                return false;
+            }
+        }
+        executionRequestId = requestId;
+        if (!executionAdapter->bind(
+                GenericExecutionDispatchId, requestId, *this)) {
+            releaseExecutionBuffers(requestId);
+            executionRequestId = 0;
+            return false;
+        }
+        executionBound = true;
+        executionAdapter->setLifecycleSink(this);
+        executionAdapter->setCompletionSink(this);
+        return true;
+    }
+
+    bool releaseExecutionBuffers(uint64_t requestId)
+    {
+        bool ok = true;
+        for (auto &entry : executionBuffers) {
+            if (!entry)
+                continue;
+            ok = memory.releasePinnedDispatchAllocation(
+                     owner, entry->view.allocationId, entry->view.generation,
+                     requestId) && ok;
+            ok = context->unmap(entry->lease) && ok;
+            entry.reset();
+        }
+        if (ok) {
+            for (auto &snapshot : executionBefore)
+                snapshot.clear();
+        }
+        return ok;
+    }
+
+    bool finishExecutionBinding()
+    {
+        if (!executionBound || !executionAdapter)
+            return !executionMode;
+        if (!executionAdapter->release(GenericExecutionDispatchId))
+            return false;
+        executionBound = false;
+        if (executionAdapter->attached() && !executionAdapter->detach())
+            return false;
+        executionAdapter->setLifecycleSink(&bridge);
+        executionAdapter->setCompletionSink(nullptr);
+        return true;
+    }
+
+    bool claimsExecutionAllocation(

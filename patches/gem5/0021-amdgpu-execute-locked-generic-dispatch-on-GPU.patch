+    bool validateExecutionOutput()
+    {
+        if (executionBefore[0].size() != GenericExecutionBufferBytes ||
+            !executionBuffers[0] || !executionBuffers[1] ||
+            !executionBuffers[2])
+            return false;
+        std::vector<uint8_t> input;
+        std::vector<uint8_t> output;
+        std::vector<uint8_t> result;
+        if (!context->functionalRead(
+                executionBuffers[0]->address, GenericExecutionBufferBytes,
+                input, executionRequestId) ||
+            !context->functionalRead(
+                executionBuffers[1]->address, GenericExecutionBufferBytes,
+                output, executionRequestId) ||
+            !context->functionalRead(
+                executionBuffers[2]->address, GenericExecutionBufferBytes,
+                result, executionRequestId) ||
+            input != executionBefore[0] || output.size() != input.size() ||
+            result.size() != input.size()) {
+            return false;
+        }
+        for (uint32_t index = 0;
+             index < GenericExecutionBufferBytes / sizeof(uint32_t); ++index) {
+            uint32_t inputValue = 0;
+            uint32_t outputValue = 0;
+            uint32_t resultValue = 0;
+            std::memcpy(&inputValue, input.data() + index * sizeof(uint32_t),
+                        sizeof(inputValue));
+            std::memcpy(&outputValue, output.data() + index * sizeof(uint32_t),
+                        sizeof(outputValue));
+            std::memcpy(&resultValue, result.data() + index * sizeof(uint32_t),
+                        sizeof(resultValue));
+            if (inputValue != (0x51000000U ^ index) ||
+                outputValue != index || resultValue != inputValue)
+                return false;
+        }
+        std::vector<uint8_t> combined;
+        try {
+            combined.reserve(output.size() + result.size());
+            combined.insert(combined.end(), output.begin(), output.end());
+            combined.insert(combined.end(), result.begin(), result.end());
+        } catch (const std::bad_alloc &) {
+            return false;
+        }

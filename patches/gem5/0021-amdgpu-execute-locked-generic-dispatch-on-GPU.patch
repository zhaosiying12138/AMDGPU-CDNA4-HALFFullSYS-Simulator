+TEST(HostGpuProtocol, GenericExecutionRequiresGenericDependencies)
+{
+    auto selected = genericSelectedCapabilities();
+    selected[GenericExecutionCapabilityByte] |=
+        GenericExecutionCapabilityMask;
+    auto server = goldenServer();
+    auto hello = goldenHello();
+    server.supported = selected;
+    hello.offered = selected;
+    hello.required = selected;
+    auto negotiated = negotiate(goldenHeader(), hello, server);
+    ASSERT_EQ(negotiated.status, Status::Ok);
+    EXPECT_TRUE(genericExecutionCapabilitySelected(negotiated.selected));
+    EXPECT_EQ(negotiated.selected[GenericExecutionCapabilityByte], 0x03U);
+
+    hello = goldenHello();
+    hello.offered = selected;
+    hello.required = topologyCapability();
+    hello.required[GenericExecutionCapabilityByte] |=
+        GenericExecutionCapabilityMask;
+    negotiated = negotiate(goldenHeader(), hello, server);
+    EXPECT_EQ(negotiated.status, Status::UnsupportedCapability);
+
+    hello = goldenHello();
+    hello.offered = selected;
+    hello.required = genericSelectedCapabilities();
+    negotiated = negotiate(goldenHeader(), hello, server);
+    ASSERT_EQ(negotiated.status, Status::Ok);
+    EXPECT_TRUE(genericDispatchCapabilitySelected(negotiated.selected));
+    EXPECT_FALSE(genericExecutionCapabilitySelected(negotiated.selected));
+    EXPECT_EQ(negotiated.selected[GenericExecutionCapabilityByte], 0x01U);

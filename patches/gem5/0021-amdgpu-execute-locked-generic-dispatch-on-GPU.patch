+#ifndef __DEV_AMDGPU_HOST_GPU_NATIVE_EXECUTION_ADAPTER_HH__
+#define __DEV_AMDGPU_HOST_GPU_NATIVE_EXECUTION_ADAPTER_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/types.hh"
+#include "dev/amdgpu/host_gpu_native_dispatch_token_mux.hh"
+#include "gpu-compute/dispatch_lifecycle.hh"
+#include "gpu-compute/gpu_dispatch_completion.hh"
+#include "gpu-compute/gpu_native_memory.hh"
+
+namespace gem5
+{
+
+class GPUDispatcher;
+class HSAQueueEntry;
+class Shader;
+
+namespace hostgpu
+{
+
+/**
+ * One-in-flight adapter for a host-owned native dispatch.
+ *
+ * The GPU pipeline identifies a task with a bounded signed dispatch ID.  The
+ * transport and memory leases use the wider wire request token instead.  This
+ * object is the only place where the two identifiers are joined: CU memory
+ * traffic must present the dispatch ID and is forwarded to the backing memory
+ * with the wire token.  A disconnected owner is quarantined until the
+ * dispatcher retires its packet; no cancellation is implied by quarantine.
+ */
+class HostNativeExecutionAdapter final : public GPUNativeMemory,
+                                          public GPUDispatchLifecycleListener,
+                                          public GPUDispatchCompletionSink
+{
+  public:
+    HostNativeExecutionAdapter() = default;
+    ~HostNativeExecutionAdapter() override;
+
+    /** Install this adapter as the dispatcher's listener/sink and shader
+     * native-memory provider.  The delegates receive all lifecycle callbacks
+     * (including callbacks for non-adapted legacy work). */
+    bool attach(GPUDispatcher &dispatcher, Shader &shader);
+    bool detach();
+
+    void setLifecycleSink(GPUDispatchLifecycleListener *sink)
+    {
+        lifecycleSink = sink;
+    }
+
+    GPUDispatchLifecycleListener *lifecycleSinkPtr() const
+    {
+        return lifecycleSink;
+    }
+
+    void setCompletionSink(GPUDispatchCompletionSink *sink)
+    {
+        completionSink = sink;
+    }
+
+    /** Bind the sole in-flight task to a backing GPUNativeMemory object.
+     * Binding is allowed before attach so the token mux can be tested without
+     * constructing SimObjects; submit still requires an attached dispatcher. */
+    bool bind(int dispatchId, uint64_t wireRequestId,
+              GPUNativeMemory &backing);
+
+    /** Transfer ownership of an admitted task to GPUDispatcher. */
+    bool submit(std::unique_ptr<HSAQueueEntry> task);
+
+    /** Mark the client owner disconnected while retaining the task binding. */
+    bool quarantine(int dispatchId);
+
+    /** Release the binding only before submission or after packet retirement. */
+    bool release(int dispatchId);
+
+    bool attached() const { return dispatcher != nullptr && shader != nullptr; }
+    bool active() const { return tokenMux.active(); }
+    bool dispatchSubmitted() const { return tokenMux.dispatchSubmitted(); }
+    bool commandProcessorObserved() const { return commandProcessorSeen; }
+    bool quarantined() const { return tokenMux.quarantined(); }
+    bool kernelCompleted() const { return tokenMux.kernelCompleted(); }
+    bool packetRetired() const { return tokenMux.packetRetired(); }
+
+    bool lastQuarantined() const { return tokenMux.lastQuarantined(); }
+    bool lastPacketRetired() const { return tokenMux.lastPacketRetired(); }
+    bool tokenTranslated() const { return tokenMux.tokenTranslated(); }
+    uint64_t lastDispatchId() const { return tokenMux.lastDispatchId(); }
+    uint64_t lastWireRequestId() const
+    {
+        return tokenMux.lastWireRequestId();
+    }
+    uint64_t forwardedReadCount() const
+    {
+        return tokenMux.forwardedReadCount();
+    }
+    uint64_t forwardedWriteCount() const
+    {
+        return tokenMux.forwardedWriteCount();
+    }
+    Tick startTick() const { return dispatchStartTick; }
+    Tick endTick() const { return dispatchEndTick; }
+    Tick retireTick() const { return dispatchRetireTick; }
+    const std::string &failureReason() const { return failure; }
+
+    bool read(Addr address, void *destination, size_t byteCount,

+/*
+ * Copyright (c) 2026 The gem5 Project
+ * All rights reserved.
+ */
+
+#ifndef __DEV_AMDGPU_HOST_GPU_NATIVE_DISPATCH_TOKEN_MUX_HH__
+#define __DEV_AMDGPU_HOST_GPU_NATIVE_DISPATCH_TOKEN_MUX_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include "base/types.hh"
+#include "gpu-compute/gpu_native_memory.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Dependency-free state core for the one-in-flight native dispatch adapter.
+ *
+ * GPU-facing callers use a bounded signed dispatch ID; host memory leases use
+ * the full-width wire request token.  This class translates the former to the
+ * latter and retains the binding through owner quarantine until packet
+ * retirement.  Dispatcher and Shader hooks are intentionally kept in
+ * HostNativeExecutionAdapter.
+ */
+class HostNativeDispatchTokenMux final
+{
+  public:
+    bool bind(int dispatchId, uint64_t wireRequestId,
+              GPUNativeMemory &backing);
+    bool markSubmitted(int dispatchId);
+    bool quarantine(int dispatchId);
+    bool markKernelCompleted(int dispatchId);
+    bool markPacketRetired(int dispatchId);
+    bool release(int dispatchId);
+
+    bool read(Addr address, void *destination, size_t byteCount,
+              uint64_t dispatchRequestId = 0) const;
+    bool write(Addr address, const void *source, size_t byteCount,
+               uint64_t dispatchRequestId = 0);
+
+    bool active() const { return bound; }
+    bool dispatchSubmitted() const { return submitted; }
+    bool quarantined() const { return ownerQuarantined; }
+    bool kernelCompleted() const { return kernelDone; }
+    bool packetRetired() const { return packetDone; }
+    bool lastQuarantined() const { return historicalQuarantine; }
+    bool lastPacketRetired() const { return historicalRetire; }
+    bool tokenTranslated() const { return historicalTranslation; }
+    int dispatchId() const { return currentDispatchId; }
+    uint64_t wireRequestId() const { return currentWireRequestId; }
+    uint64_t lastDispatchId() const { return historicalDispatchId; }
+    uint64_t lastWireRequestId() const { return historicalWireRequestId; }
+    uint64_t forwardedReadCount() const { return readCount; }
+    uint64_t forwardedWriteCount() const { return writeCount; }
+    const std::string &failureReason() const { return failure; }
+
+  private:
+    bool fail(const char *reason);
+    void clearBinding();
+
+    GPUNativeMemory *backing = nullptr;
+    int currentDispatchId = 0;
+    uint64_t currentWireRequestId = 0;
+    bool bound = false;
+    bool submitted = false;
+    bool ownerQuarantined = false;
+    bool kernelDone = false;
+    bool packetDone = false;
+
+    bool historicalQuarantine = false;
+    bool historicalRetire = false;
+    mutable bool historicalTranslation = false;
+    uint64_t historicalDispatchId = 0;
+    uint64_t historicalWireRequestId = 0;
+    mutable uint64_t readCount = 0;
+    uint64_t writeCount = 0;
+    mutable std::string failure;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_NATIVE_DISPATCH_TOKEN_MUX_HH__

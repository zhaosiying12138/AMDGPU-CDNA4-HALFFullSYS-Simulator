+TEST(VopSemanticsTest, DppRowAndBankMasksGateWholeLaneGroups)
+{
+    // Full masks enable every lane; a cleared bank bit disables exactly its
+    // four lanes in every row; a cleared row bit disables its sixteen.
+    for (int lane = 0; lane < 64; ++lane) {
+        EXPECT_TRUE(dppLaneWriteEnabled(lane, 0xf, 0xf));
+        EXPECT_FALSE(dppLaneWriteEnabled(lane, 0, 0xf));
+        EXPECT_FALSE(dppLaneWriteEnabled(lane, 0xf, 0));
+
+        const int row = lane / 16;
+        const int bank = (lane % 16) / 4;
+        EXPECT_EQ(dppLaneWriteEnabled(lane, 0xf, 0xf & ~(1 << bank)), false);
+        EXPECT_EQ(dppLaneWriteEnabled(lane, 0xf & ~(1 << row), 0xf), false);
+        EXPECT_EQ(dppLaneWriteEnabled(lane, 1 << row, 1 << bank), true);
+    }
+
+    // The compiler's butterfly reduction pairing: row_shr:8 under
+    // bank_mask:0xc writes lanes 8-15 of each row, row_shl:8 under
+    // bank_mask:0x3 writes lanes 0-7. Together they cover each row once.
+    for (int lane = 0; lane < 64; ++lane) {
+        const bool upperHalf = (lane % 16) >= 8;
+        EXPECT_EQ(dppLaneWriteEnabled(lane, 0xf, 0xc), upperHalf);
+        EXPECT_EQ(dppLaneWriteEnabled(lane, 0xf, 0x3), !upperHalf);
+    }
+}
+
+TEST(VopSemanticsTest, DppSourceLanesFollowRowGeometry)
+{
+    for (int lane = 0; lane < 64; ++lane) {
+        const int rowBase = lane & ~0xf;
+        const int offset = lane & 0xf;
+
+        // quad_perm:[2,3,0,1] swaps pairs inside each quad.
+        EXPECT_EQ(dppSourceLane(0x4e, lane), (lane & ~3) | ((lane + 2) & 3));
+        // quad_perm:[1,0,3,2] swaps neighbours inside each quad.
+        EXPECT_EQ(dppSourceLane(0xb1, lane), lane ^ 1);
+
+        // row_shr:N reads lane-N inside the row and has no source before
+        // the row's first lane. row_shl:N mirrors it upward.
+        const int shr4 = dppSourceLane(SQ_DPP_ROW_SR1 + 3, lane);
+        EXPECT_EQ(shr4, offset >= 4 ? rowBase + offset - 4 : -1);
+        const int shl4 = dppSourceLane(SQ_DPP_ROW_SL1 + 3, lane);
+        EXPECT_EQ(shl4, offset + 4 < 16 ? rowBase + offset + 4 : -1);
+
+        // row rotate always has a source.
+        const int rr3 = dppSourceLane(SQ_DPP_ROW_RR1 + 2, lane);
+        EXPECT_EQ(rr3, rowBase + (offset + 16 - 3) % 16);
+
+        // Broadcasts read the previous group's last lane; the first group
+        // has no source.
+        const int bcast15 = dppSourceLane(SQ_DPP_ROW_BCAST15, lane);
+        EXPECT_EQ(bcast15, lane > 15 ? (lane & 0x30) - 1 : -1);
+        const int bcast31 = dppSourceLane(SQ_DPP_ROW_BCAST31, lane);
+        EXPECT_EQ(bcast31, lane > 31 ? (lane & 0x20) - 1 : -1);
+
+        // Wavefront shifts stop at the wave edge; rotates wrap.
+        EXPECT_EQ(dppSourceLane(SQ_DPP_WF_SL1, lane),
+                  lane < 63 ? lane + 1 : -1);
+        EXPECT_EQ(dppSourceLane(SQ_DPP_WF_SR1, lane),
+                  lane > 0 ? lane - 1 : -1);
+        EXPECT_EQ(dppSourceLane(SQ_DPP_WF_RL1, lane), (lane + 1) % 64);
+        EXPECT_EQ(dppSourceLane(SQ_DPP_WF_RR1, lane), (lane + 63) % 64);
+    }
+}
+
+/**
+ * The exact failure that produced a wrong Qwen3.5 q/k L2 norm: the
+ * compiler's wave sum pairs `v_mov_b32_dpp v5, v5 row_shr:8 bank_mask:0xc`
+ * with `v_mov_b32_dpp v5, v4 row_shl:8 bank_mask:0x3`. The second mov must
+ * not disturb the upper banks the first mov just wrote: a masked-off lane
+ * keeps the destination's old value, it does not receive the source's own
+ * unpermuted value.
+ */
+TEST(VopSemanticsTest, DppButterflyPairWritesEachLaneExactlyOnce)
+{
+    float v4[64], v5[64];
+    for (int lane = 0; lane < 64; ++lane) {
+        v4[lane] = 1000.0f + lane;
+        v5[lane] = v4[lane];
+    }
+
+    // v_mov_b32_dpp v5, v5 row_shr:8 row_mask:0xf bank_mask:0xc
+    float before[64];
+    std::copy(std::begin(v5), std::end(v5), std::begin(before));
+    for (int lane = 0; lane < 64; ++lane) {
+        if (!dppLaneWriteEnabled(lane, 0xf, 0xc))
+            continue;
+        const int src = dppSourceLane(SQ_DPP_ROW_SR1 + 7, lane);
+        ASSERT_GE(src, 0);
+        v5[lane] = before[src];
+    }
+
+    // v_mov_b32_dpp v5, v4 row_shl:8 row_mask:0xf bank_mask:0x3
+    for (int lane = 0; lane < 64; ++lane) {
+        if (!dppLaneWriteEnabled(lane, 0xf, 0x3))
+            continue;
+        const int src = dppSourceLane(SQ_DPP_ROW_SL1 + 7, lane);
+        ASSERT_GE(src, 0);
+        v5[lane] = v4[src];
+    }
+
+    // Every lane now holds its butterfly partner's value: lane ^ 8 within
+    // the row.
+    for (int lane = 0; lane < 64; ++lane) {
+        EXPECT_EQ(v5[lane], v4[(lane & ~0xf) | ((lane & 0xf) ^ 8)])
+            << "lane " << lane;
+    }
+}

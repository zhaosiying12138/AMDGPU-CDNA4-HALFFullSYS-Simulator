+/**
+ * A DPP-encoded VALU op writes its destination under gates the plain
+ * encoding does not have. ROW_MASK and BANK_MASK disable the *write* for
+ * whole 16-lane rows and 4-lane banks: a disabled lane's destination
+ * register keeps its previous contents. The compiler's canonical wave
+ * reduction depends on exactly that -- it pairs a row_shr:N with a
+ * row_shl:N into the same destination, each masked to the banks whose
+ * shifted source stays inside the row, so between them every lane is
+ * written exactly once with its butterfly partner and the masked halves
+ * must not be disturbed.
+ */
+inline bool
+dppLaneWriteEnabled(int lane, unsigned rowMask, unsigned bankMask)
+{
+    const int row = lane / DppRowSize;
+    const int bank = (lane % DppRowSize) / DppBankSize;
+    return ((rowMask >> row) & 1) && ((bankMask >> bank) & 1);
+}
+
+/**
+ * The source lane DPP_CTRL selects for a destination lane, or -1 when the
+ * selection has no source (it leaves the row or wavefront, or names a
+ * broadcast's own input group). For a -1 source, BOUND_CTRL arbitrates:
+ * 1 reads the source as zero, 0 suppresses the write like a mask bit.
+ *
+ * Shift/rotate left moves data toward lane 0 (lane n's value reaches lane
+ * n-1), so a left shift/rotate *reads* from lane+count and a right one
+ * from lane-count. Reserved and unimplemented control values fail closed.
+ */
+inline int
+dppSourceLane(unsigned dppCtrl, int lane)
+{
+    if (dppCtrl <= SQ_DPP_QUAD_PERM_MAX) {
+        return (lane & ~3) | ((dppCtrl >> (2 * (lane & 3))) & 3);
+    } else if (dppCtrl >= SQ_DPP_ROW_SL1 && dppCtrl <= SQ_DPP_ROW_SL15) {
+        const int count = static_cast<int>(dppCtrl - SQ_DPP_ROW_SL1) + 1;
+        const int offset = lane % DppRowSize + count;
+        return offset < DppRowSize ? (lane & ~(DppRowSize - 1)) + offset : -1;
+    } else if (dppCtrl >= SQ_DPP_ROW_SR1 && dppCtrl <= SQ_DPP_ROW_SR15) {
+        const int count = static_cast<int>(dppCtrl - SQ_DPP_ROW_SR1) + 1;
+        const int offset = lane % DppRowSize - count;
+        return offset >= 0 ? (lane & ~(DppRowSize - 1)) + offset : -1;
+    } else if (dppCtrl >= SQ_DPP_ROW_RR1 && dppCtrl <= SQ_DPP_ROW_RR15) {
+        const int count = static_cast<int>(dppCtrl - SQ_DPP_ROW_RR1) + 1;
+        const int offset =
+            (lane % DppRowSize - count + DppRowSize) % DppRowSize;
+        return (lane & ~(DppRowSize - 1)) + offset;
+    } else if (dppCtrl == SQ_DPP_WF_SL1) {
+        return lane + 1 < NumVecElemPerVecReg ? lane + 1 : -1;
+    } else if (dppCtrl == SQ_DPP_WF_RL1) {
+        return (lane + 1) % NumVecElemPerVecReg;
+    } else if (dppCtrl == SQ_DPP_WF_SR1) {
+        return lane >= 1 ? lane - 1 : -1;
+    } else if (dppCtrl == SQ_DPP_WF_RR1) {
+        return (lane + NumVecElemPerVecReg - 1) % NumVecElemPerVecReg;
+    } else if (dppCtrl == SQ_DPP_ROW_MIRROR) {
+        return dppRowMirrorLane(lane);
+    } else if (dppCtrl == SQ_DPP_ROW_HALF_MIRROR) {
+        return dppRowHalfMirrorLane(lane);
+    } else if (dppCtrl == SQ_DPP_ROW_BCAST15) {
+        return lane > 15 ? (lane & 0x30) - 1 : -1;
+    } else if (dppCtrl == SQ_DPP_ROW_BCAST31) {
+        return lane > 31 ? (lane & 0x20) - 1 : -1;
+    }
+
+    std::abort();
+}

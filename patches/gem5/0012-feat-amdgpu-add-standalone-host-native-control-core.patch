+#include "dev/amdgpu/host_gpu_memory_state.hh"
+#include "dev/amdgpu/host_gpu_protocol.hh"
+#include "dev/amdgpu/host_gpu_queue_state.hh"
+#include "dev/amdgpu/host_gpu_signal_state.hh"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <exception>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace gem5::hostgpu
+{
+namespace
+{
+
+void
+require(bool condition, const char *message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+protocol::Header
+controlHeader(uint64_t requestId)
+{
+    protocol::Header header;
+    header.requestId = requestId;
+    header.connectionId = 0x1020304050607080ULL;
+    header.jobEpoch = 0x0102030405060708ULL;
+    for (size_t index = 0; index < header.daemonUuid.size(); ++index)
+        header.daemonUuid[index] = static_cast<uint8_t>(index + 1);
+    return header;
+}
+
+protocol::Capabilities
+controlCapabilities()
+{
+    auto capabilities = protocol::topologyCapability();
+    capabilities[0] |= protocol::QueueControlCapabilityMask |
+        protocol::MemoryControlCapabilityMask |
+        protocol::SignalEventCapabilityMask;
+    return capabilities;
+}
+
+protocol::ServerIdentity
+controlServer()
+{
+    protocol::ServerIdentity server;
+    server.daemonUuid = controlHeader(0).daemonUuid;
+    server.jobEpoch = controlHeader(0).jobEpoch;
+    server.rank = 0;
+    server.worldSize = 1;
+    server.supported = controlCapabilities();
+    return server;
+}
+
+protocol::Hello
+controlHello(const protocol::ServerIdentity &server)
+{
+    protocol::Hello hello;
+    hello.offered = controlCapabilities();
+    hello.required = hello.offered;
+    hello.receiveMaximum = protocol::MaximumHandshakeBytes;
+    hello.topology.jobUuid = server.jobUuid;
+    hello.topology.rank = server.rank;
+    hello.topology.worldSize = server.worldSize;
+    for (size_t index = 0; index < hello.clientNonce.size(); ++index)
+        hello.clientNonce[index] = static_cast<uint8_t>(0xa0 + index);
+    return hello;
+}
+
+void
+runProtocolSelfTest()
+{
+    const auto server = controlServer();
+    const auto header = controlHeader(1);
+    const auto hello = controlHello(server);
+    const auto frame = protocol::encodeHello(header, hello);
+    require(frame.size() == protocol::HeaderBytes +
+                protocol::HelloFixedBytes + 32,
+            "HELLO frame size");
+    const auto decoded = protocol::decodeHelloRecord(
+        frame.data(), frame.size(), protocol::MaximumHandshakeBytes);
+    require(decoded.action == protocol::DecodeAction::Acknowledge &&
+                decoded.status == protocol::Status::Ok && decoded.hasHello,
+            "HELLO decode");
+    const auto negotiated = protocol::negotiate(
+        decoded.header, decoded.hello, server);
+    require(negotiated.status == protocol::Status::Ok &&
+                negotiated.selected == hello.required,
+            "HELLO negotiation");
+    const std::array<uint8_t, 9> vector = {
+        '1', '2', '3', '4', '5', '6', '7', '8', '9'};
+    require(protocol::crc32c(vector.data(), vector.size()) == 0xe3069283U,
+            "CRC32C vector");
+}
+
+void
+runMemorySelfTest()
+{
+    HostGPUMemoryState state;
+    const HostGPUMemoryState::Owner owner{1, 1};
+    protocol::MemoryRequest allocationRequest;
+    allocationRequest.opcode = protocol::MemoryOpcode::Allocate;
+    allocationRequest.byteCount = 256;
+    allocationRequest.argument = 4096;
+    const auto allocation = state.allocate(owner, allocationRequest, 1);
+    require(allocation.status == protocol::Status::Ok &&
+                allocation.allocationId != 0 && allocation.generation != 0,
+            "memory allocation");
+
+    std::vector<uint8_t> source(64);
+    for (size_t index = 0; index < source.size(); ++index)
+        source[index] = static_cast<uint8_t>(index * 3 + 1);
+    protocol::MemoryRequest write;
+    write.opcode = protocol::MemoryOpcode::CopyH2D;
+    write.allocationId = allocation.allocationId;
+    write.generation = allocation.generation;
+    write.byteCount = source.size();
+    write.argument = protocol::crc32c(source.data(), source.size());
+    require(state.copyFromHost(owner, write, source, 2).status ==
+                protocol::Status::Ok,
+            "memory copy to device");
+
+    protocol::MemoryRequest read = write;
+    read.opcode = protocol::MemoryOpcode::CopyD2H;
+    std::vector<uint8_t> destination;
+    const auto readResponse = state.copyToHost(owner, read, destination, 3);
+    require(readResponse.status == protocol::Status::Ok &&
+                destination == source &&
+                readResponse.value2 == protocol::crc32c(
+                    destination.data(), destination.size()),
+            "memory copy from device");
+
+    protocol::MemoryRequest freeRequest;
+    freeRequest.opcode = protocol::MemoryOpcode::Free;
+    freeRequest.allocationId = allocation.allocationId;
+    freeRequest.generation = allocation.generation;
+    require(state.free(owner, freeRequest, 4).status == protocol::Status::Ok &&
+                state.allocationCount() == 0,
+            "memory free");
+}
+
+void
+runQueueSelfTest()
+{
+    HostGPUQueueState state;
+    const HostGPUQueueState::Owner owner{1, 1};
+    const auto header = controlHeader(2);
+    protocol::QueueRequest create;
+    create.opcode = protocol::QueueOpcode::Create;
+    create.arg0 = 2;
+    const auto created = state.submit(owner, header, create, 10);
+    require(created.response.status == protocol::Status::Ok,
+            "queue create");
+
+    protocol::QueueRequest bell;
+    bell.opcode = protocol::QueueOpcode::Doorbell;
+    bell.queueId = created.response.queueId;
+    bell.generation = created.response.generation;
+    bell.sequence = 1;
+    bell.arg0 = static_cast<uint64_t>(protocol::QueueCommandKind::ControlTest);
+    const auto accepted = state.submit(owner, controlHeader(3), bell, 20);
+    require(accepted.response.status == protocol::Status::Ok &&
+                accepted.commandAccepted && !state.popReady(20),
+            "queue doorbell");
+    const auto command = state.popReady(21);
+    require(command && command->sequence == 1 && command->readyTick == 21,
+            "queue completion scheduling");
+    require(HostGPUQueueState::completionResponse(*command, 21).status ==
+                protocol::Status::Ok,
+            "queue completion");
+
+    protocol::QueueRequest destroy;
+    destroy.opcode = protocol::QueueOpcode::Destroy;
+    destroy.queueId = created.response.queueId;
+    destroy.generation = created.response.generation;
+    const auto destroyed = state.submit(
+        owner, controlHeader(4), destroy, 22);
+    require(destroyed.response.status == protocol::Status::Ok &&
+                state.queueCount() == 0,
+            "queue destroy");
+}
+
+void
+runSignalSelfTest()
+{
+    HostGPUSignalState state;
+    const HostGPUSignalState::Owner owner{1, 1};
+    protocol::SignalRequest create;
+    create.opcode = protocol::SignalOpcode::Create;
+    create.value = -1;
+    const auto created = state.submit(owner, controlHeader(5), create, 30);
+    require(created.status == protocol::Status::Ok,
+            "signal create");
+
+    protocol::SignalRequest store;
+    store.opcode = protocol::SignalOpcode::Store;
+    store.signalId = created.signalId;
+    store.generation = created.generation;
+    store.value = 7;
+    require(state.submit(owner, controlHeader(6), store, 31).status ==
+                protocol::Status::Ok,
+            "signal store");
+
+    protocol::SignalRequest wait;
+    wait.opcode = protocol::SignalOpcode::Wait;
+    wait.signalId = created.signalId;
+    wait.generation = created.generation;
+    wait.sequence = 1;
+    wait.condition = protocol::SignalCondition::GreaterThanOrEqual;
+    wait.value = 7;
+    const auto waiting = state.submit(owner, controlHeader(7), wait, 32);
+    require(waiting.status == protocol::Status::Ok && waiting.ready == 1,
+            "signal wait");
+    const auto completion = state.popReady(33);
+    require(completion && completion->value == 7 &&
+                state.complete(*completion),
+            "signal completion");
+
+    protocol::SignalRequest destroy;
+    destroy.opcode = protocol::SignalOpcode::Destroy;
+    destroy.signalId = created.signalId;
+    destroy.generation = created.generation;
+    require(state.submit(owner, controlHeader(8), destroy, 34).status ==
+                protocol::Status::Ok && state.signalCount() == 0,
+            "signal destroy");
+}
+
+} // namespace
+} // namespace gem5::hostgpu
+
+int
+main()
+{
+    try {
+        gem5::hostgpu::runProtocolSelfTest();
+        gem5::hostgpu::runMemorySelfTest();
+        gem5::hostgpu::runQueueSelfTest();
+        gem5::hostgpu::runSignalSelfTest();
+    } catch (const std::exception &error) {
+        std::cerr << "host_gpu_control_core self-test failed: "
+                  << error.what() << '\n';
+        return 1;
+    }
+
+    constexpr char output[] =
+        "{\"schema\":\"gem5.host-native.control-core.v1\","
+        "\"protocol_self_test\":true,\"memory_self_test\":true,"
+        "\"queue_self_test\":true,\"signal_self_test\":true,"
+        "\"kernel_executed\":false,\"cpu_fallback\":false,"
+        "\"vega_x86\":false}";
+    std::cout << output << '\n';
+    return 0;
+}

--- /dev/null
+++ b/util/host_native/check_control_core.py
@@ -0,0 +1,207 @@
+#!/usr/bin/env python3
+"""Audit and run the standalone host-native control-core executable.
+
+The audit intentionally inspects defined/undefined symbols and dynamic
+dependencies, not every string in the binary.  The host itself may be x86-64;
+the property under test is that the executable does not depend on gem5's
+simulated x86 CPU or its process/translation path.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import subprocess
+from pathlib import Path
+
+
+SCHEMA = "gem5.host-native.control-core.v1"
+AUDIT_SCHEMA = "gem5.host-native.control-core.audit.v1"
+DEFAULT_BUILD_OPTS = (
+    Path(__file__).resolve().parents[2] / "build_opts/HOSTGPU_NATIVE_CONTROL"
+)
+EXPECTED_BUILD_OPTS = {
+    "BUILD_ISA": "n",
+    "USE_X86_ISA": "n",
+    "BUILD_GPU": "y",
+}
+
+# Match complete type/namespace components.  In particular, do not match
+# ``gem5::hostgpu`` or ordinary names such as ``processParameters``.
+FORBIDDEN_SYMBOL = re.compile(
+    r"(?:\bX86ISA(?:::|$)|\bBaseCPU(?:::|$)|\bThreadContext(?:::|$)|"
+    r"\bSETranslatingPortProxy(?:::|$)|\bAMDGPUDevice(?:::|$)|"
+    r"\bGPUDispatcher(?:::|$)|\bHSAPacketProcessor(?:::|$)|"
+    r"\bComputeUnit(?:::|$)|\bgem5::(?:System|Process|X86ISA|"
+    r"BaseCPU|ThreadContext)(?:::|$))"
+)
+
+ALLOWED_DYNAMIC_LIBS = (
+    "linux-vdso.so.1",
+    "libstdc++.so",
+    "libgcc_s.so",
+    "libc.so",
+    "libm.so",
+    "ld-linux",
+)
+
+
+def run(*command: str) -> str:
+    result = subprocess.run(
+        command, check=True, text=True, stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    return result.stdout
+
+
+def parse_build_opts(path: Path) -> dict[str, str]:
+    """Read simple KEY=VALUE entries from a gem5 build-options file."""
+
+    if not path.is_file():
+        raise SystemExit(f"missing build options: {path}")
+    values: dict[str, str] = {}
+    for lineno, raw_line in enumerate(path.read_text().splitlines(), 1):
+        line = raw_line.split("#", 1)[0].strip()
+        if not line:
+            continue
+        if "=" not in line:
+            raise SystemExit(f"invalid build option at {path}:{lineno}")
+        key, value = line.split("=", 1)
+        key, value = key.strip(), value.strip()
+        if not key or key in values:
+            raise SystemExit(f"duplicate/empty build option at {path}:{lineno}")
+        values[key] = value
+    mismatches = {
+        key: {"actual": values.get(key), "expected": expected}
+        for key, expected in EXPECTED_BUILD_OPTS.items()
+        if values.get(key) != expected
+    }
+    if mismatches:
+        raise SystemExit(
+            "host-native build-options policy failure: "
+            + json.dumps(mismatches, sort_keys=True)
+        )
+    return values
+
+
+def parse_dependencies(ldd_output: str) -> list[str]:
+    """Extract stable sonames from ldd output without matching addresses."""
+
+    dependencies: list[str] = []
+    for line in ldd_output.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("statically linked"):
+            continue
+        if "=>" in stripped:
+            library, target = stripped.split("=>", 1)
+            target = target.strip().split()
+            if not target or target[0] == "not":
+                candidate = f"{library.strip()} => not found"
+            else:
+                candidate = target[0]
+        else:
+            candidate = stripped.split()[0]
+        dependencies.append(Path(candidate).name
+                            if candidate.startswith("/") else candidate)
+    return dependencies
+
+
+def forbidden_lines(output: str) -> list[str]:
+    return [line for line in output.splitlines()
+            if FORBIDDEN_SYMBOL.search(line)]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("executable", type=Path)
+    parser.add_argument(
+        "--build-opts", type=Path, default=DEFAULT_BUILD_OPTS,
+        help=("build-options file to validate (default: %(default)s)"),
+    )
+    args = parser.parse_args()
+    executable = args.executable.resolve()
+    if not executable.is_file():
+        raise SystemExit(f"missing executable: {executable}")
+    if not os.access(executable, os.X_OK):
+        raise SystemExit(f"executable is not executable: {executable}")
+
+    build_opts = args.build_opts.resolve()
+    parsed_opts = parse_build_opts(build_opts)
+
+    file_output = run("file", str(executable)).strip()
+    if "ELF" not in file_output or "executable" not in file_output:
+        raise SystemExit(f"not an executable ELF: {file_output}")
+
+    ldd_output = run("ldd", str(executable))
+    dependencies = parse_dependencies(ldd_output)
+    unexpected_dependencies = [
+        name for name in dependencies
+        if "=> not found" in name or
+        not any(Path(name).name.startswith(prefix)
+                for prefix in ALLOWED_DYNAMIC_LIBS)
+    ]
+    if unexpected_dependencies:
+        raise SystemExit(
+            "unexpected dynamic dependencies: "
+            + ", ".join(unexpected_dependencies)
+        )
+
+    undefined = run("nm", "-C", "--undefined-only", str(executable))
+    forbidden_undefined = forbidden_lines(undefined)
+    if forbidden_undefined:
+        raise SystemExit(
+            "forbidden undefined symbols:\n" + "\n".join(forbidden_undefined)
+        )
+
+    defined = run("nm", "-C", "--defined-only", str(executable))
+    forbidden_defined = forbidden_lines(defined)
+    if forbidden_defined:
+        raise SystemExit(
+            "forbidden defined symbols:\n" + "\n".join(forbidden_defined)
+        )
+
+    self_test = subprocess.run(
+        [str(executable)], check=True, text=True,
+        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+    )
+    try:
+        result = json.loads(self_test.stdout)
+    except json.JSONDecodeError as error:
+        raise SystemExit(f"self-test did not emit JSON: {error}") from error
+    if not isinstance(result, dict) or result.get("schema") != SCHEMA:
+        raise SystemExit(f"self-test schema mismatch: {result!r}")
+    expected_false = ("kernel_executed", "cpu_fallback", "vega_x86")
+    if any(result.get(key) is not False for key in expected_false):
+        raise SystemExit("self-test scope flags are not explicit false")
+    for key in ("protocol_self_test", "memory_self_test",
+                "queue_self_test", "signal_self_test"):
+        if result.get(key) is not True:
+            raise SystemExit(f"self-test flag is not true: {key}")
+
+    print(json.dumps({
+        "schema": AUDIT_SCHEMA,
+        "executable": str(executable),
+        "build_opts": str(build_opts),
+        "build_options": parsed_opts,
+        "file": file_output,
+        "dynamic_dependencies": dependencies,
+        "forbidden_undefined_symbols": [],
+        "forbidden_defined_symbols": [],
+        "self_test": result,
+        "strace": "unavailable",
+    }, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except subprocess.CalledProcessError as error:
+        command = " ".join(error.cmd)
+        detail = error.stderr.strip() if error.stderr else ""
+        message = f"command failed ({error.returncode}): {command}"
+        if detail:
+            message += f": {detail}"
+        raise SystemExit(message) from error
-- 

+TEST(HostGpuProtocol, KmtDecodeRejectsPaddingCrcAndSplitPairs)
+{
+    KmtRequest request;
+    request.operation = KmtOperation::GetVersion;
+    request.operationSequence = 2;
+    request.ownerId = 1;
+    request.ownerGeneration = 2;
+    auto frame = encodeKmtRequest(goldenMemoryHeader(81), request);
+
+    auto expectMalformed = [](std::vector<uint8_t> mutated) {
+        recomputeCrc(mutated);
+        const auto decoded = decodeKmtRequestRecord(
+            mutated.data(), mutated.size(), MaximumRecordBytes);
+        EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+        EXPECT_EQ(decoded.status, Status::Malformed);
+    };
+
+    request.ownerGeneration = 0;
+    auto mutated = encodeKmtRequest(goldenMemoryHeader(81), request);
+    expectMalformed(mutated);
+    request.ownerGeneration = 2;
+    mutated = frame;
+    mutated[HeaderBytes + 232] = 1;
+    expectMalformed(mutated);
+    mutated = frame;
+    store32(mutated, HeaderBytes + 96, 1);
+    store32(mutated, HeaderBytes + 100, 0);
+    expectMalformed(mutated);
+    mutated = frame;
+    store16(mutated, HeaderBytes, 2);
+    recomputeCrc(mutated);
+    EXPECT_EQ(decodeKmtRequestRecord(
+                  mutated.data(), mutated.size(), MaximumRecordBytes).status,
+              Status::UnsupportedVersion);
+
+    mutated = frame;
+    mutated.pop_back();
+    store32(mutated, 20, KmtPayloadBytes - 1);
+    recomputeCrc(mutated);
+    EXPECT_EQ(decodeKmtRequestRecord(
+                  mutated.data(), mutated.size(), MaximumRecordBytes).action,
+              DecodeAction::Drop);
+}

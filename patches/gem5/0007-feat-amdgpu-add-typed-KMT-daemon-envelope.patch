+/** Fixed-width KFD/DRM operation request; no host pointer or FD appears. */
+struct KmtRequest
+{
+    uint16_t major = KmtOperationMajor;
+    uint16_t minor = KmtOperationMinor;
+    KmtOperation operation = KmtOperation::OpenKfd;
+    uint16_t flags = 0;
+    uint64_t operationSequence = 0;
+    uint64_t ownerId = 0;
+    uint64_t ownerGeneration = 0;
+    uint64_t objectId = 0;
+    uint64_t objectGeneration = 0;
+    uint64_t auxId = 0;
+    uint64_t auxGeneration = 0;
+    std::array<uint32_t, KmtArgumentWordCount> argumentWords = {};
+    uint32_t copiedBytes = 0;
+    uint32_t copiedCrc32c = 0;
+    std::array<uint8_t, KmtCopiedBufferBytes> copiedBuffer = {};
+};
+
+/** Canonical KMT ACK payload with separate provider and wire status. */
+struct KmtResponse
+{
+    uint16_t major = KmtOperationMajor;
+    uint16_t minor = KmtOperationMinor;
+    KmtOperation operation = KmtOperation::OpenKfd;
+    uint16_t flags = 0;
+    KmtStatus status = KmtStatus::Success;
+    int32_t wireStatus = static_cast<int32_t>(Status::Ok);
+    uint64_t operationSequence = 0;
+    uint64_t ownerId = 0;
+    uint64_t ownerGeneration = 0;
+    uint64_t objectId = 0;
+    uint64_t objectGeneration = 0;
+    uint64_t auxId = 0;
+    uint64_t auxGeneration = 0;
+    std::array<uint32_t, KmtArgumentWordCount> resultWords = {};
+    uint32_t resultBytes = 0;
+    uint32_t resultCrc32c = 0;
+    std::array<uint8_t, KmtCopiedBufferBytes> copiedResult = {};
+};
+
+struct KmtDecodeResult
+{
+    DecodeAction action = DecodeAction::Drop;
+    bool closeConnection = true;
+    Status status = Status::Malformed;
+    std::string reason;
+    Header header;

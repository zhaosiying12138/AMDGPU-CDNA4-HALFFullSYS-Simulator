+void
+HostGPUBridge::processKmtRecord(const PendingRecord &record)
+{
+    auto found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &client = *found->second;
+    const auto decoded = protocol::decodeKmtRequestRecord(
+        record.bytes.data(), record.bytes.size(), maximumRecord);
+    if (decoded.action == protocol::DecodeAction::Drop) {
+        if (decoded.closeConnection)
+            closeClient(record.clientFd);
+        return;
+    }
+
+    protocol::Status sessionStatus = protocol::Status::Ok;
+    const bool kmtSelected =
+        (client.selectedCapabilities[protocol::KmtOperationCapabilityByte] &
+         protocol::KmtOperationCapabilityMask) != 0;
+    if (decoded.header.daemonUuid != identity.daemonUuid) {
+        sessionStatus = protocol::Status::InstanceMismatch;
+    } else if (decoded.header.connectionId != client.connectionId) {
+        sessionStatus = protocol::Status::ProtocolState;
+    } else if (decoded.header.jobEpoch != identity.jobEpoch) {
+        sessionStatus = protocol::Status::TopologyMismatch;
+    } else if (!kmtSelected) {
+        sessionStatus = protocol::Status::UnsupportedCapability;
+    }
+    protocol::Status status = queueRequestStatus(
+        decoded.status, sessionStatus);
+    if (status == protocol::Status::Ok &&
+        client.requestIds.observe(decoded.header.requestId) !=
+            RequestIdResult::Fresh) {
+        status = protocol::Status::ProtocolState;
+    }
+
+    protocol::KmtResponse response;
+    response.operation = decoded.request.operation;
+    response.flags = decoded.request.flags;
+    response.operationSequence = decoded.request.operationSequence;
+    response.ownerId = decoded.request.ownerId;
+    response.ownerGeneration = decoded.request.ownerGeneration;
+    response.objectId = decoded.request.objectId;
+    response.objectGeneration = decoded.request.objectGeneration;
+    response.auxId = decoded.request.auxId;
+    response.auxGeneration = decoded.request.auxGeneration;
+    if (status != protocol::Status::Ok) {
+        response.status = protocol::KmtStatus::Success;
+        response.wireStatus = static_cast<int32_t>(status);
+    } else {
+        const HostGPUKmtState::Owner owner{
+            record.clientFd, record.generation};
+        response = kmtState.submit(owner, decoded.header,
+                                   decoded.request).response;
+    }
+
+    client.state.finishEstablishedRecord();
+    const auto responseHeader = protocol::queueResponseHeader(
+        decoded.header, identity, client.connectionId);
+    const auto encoded = protocol::encodeKmtAck(responseHeader, response);
+    OutboundRecord outbound;
+    outbound.bytes = encoded;
+    outbound.kind = OutboundKind::KmtAck;
+    outbound.status = status;
+    outbound.success = response.wireStatus ==
+            static_cast<int32_t>(protocol::Status::Ok) &&
+        response.status == protocol::KmtStatus::Success;
+    enqueueOutbound(record.clientFd, record.generation, std::move(outbound));
+}

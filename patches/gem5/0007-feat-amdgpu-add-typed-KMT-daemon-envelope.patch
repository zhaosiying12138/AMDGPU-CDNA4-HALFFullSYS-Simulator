+std::vector<uint8_t>
+encodeKmtAck(const Header &request, const KmtResponse &response)
+{
+    std::vector<uint8_t> payload(KmtPayloadBytes, 0);
+    store16(payload, 0, KmtOperationMajor);
+    store16(payload, 2, KmtOperationMinor);
+    store16(payload, 4, static_cast<uint16_t>(response.operation));
+    store16(payload, 6, response.flags);
+    store32(payload, 8, static_cast<uint32_t>(response.status));
+    store32(payload, 12, static_cast<uint32_t>(response.wireStatus));
+    store64(payload, 16, response.operationSequence);
+    store64(payload, 24, response.ownerId);
+    store64(payload, 32, response.ownerGeneration);
+    store64(payload, 40, response.objectId);
+    store64(payload, 48, response.objectGeneration);
+    store64(payload, 56, response.auxId);
+    store64(payload, 64, response.auxGeneration);
+    const bool providerSuccess =
+        response.wireStatus == static_cast<int32_t>(Status::Ok) &&
+        response.status == KmtStatus::Success;
+    if (providerSuccess) {
+        for (size_t index = 0; index < response.resultWords.size(); ++index)
+            store32(payload, 72 + index * 4, response.resultWords[index]);
+        store32(payload, 104, response.resultBytes);
+        store32(payload, 108, response.resultCrc32c);
+        std::copy(response.copiedResult.begin(),
+                  response.copiedResult.end(), payload.begin() + 112);
+    }
+    Header encoded = request;
+    encoded.messageType = MessageType::KmtAck;
+    return encodeFrame(encoded, payload);
+}

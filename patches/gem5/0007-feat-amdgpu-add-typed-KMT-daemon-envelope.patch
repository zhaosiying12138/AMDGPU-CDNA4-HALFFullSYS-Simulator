+std::vector<uint8_t>
+encodeKmtRequest(const Header &header, const KmtRequest &request)
+{
+    std::vector<uint8_t> payload(KmtPayloadBytes, 0);
+    store16(payload, 0, request.major);
+    store16(payload, 2, request.minor);
+    store16(payload, 4, static_cast<uint16_t>(request.operation));
+    store16(payload, 6, request.flags);
+    store64(payload, 8, request.operationSequence);
+    store64(payload, 16, request.ownerId);
+    store64(payload, 24, request.ownerGeneration);
+    store64(payload, 32, request.objectId);
+    store64(payload, 40, request.objectGeneration);
+    store64(payload, 48, request.auxId);
+    store64(payload, 56, request.auxGeneration);
+    for (size_t index = 0; index < request.argumentWords.size(); ++index)
+        store32(payload, 64 + index * 4, request.argumentWords[index]);
+    store32(payload, 96, request.copiedBytes);
+    store32(payload, 100, request.copiedCrc32c);
+    std::copy(request.copiedBuffer.begin(), request.copiedBuffer.end(),
+              payload.begin() + 104);
+    Header encoded = header;
+    encoded.messageType = MessageType::KmtRequest;
+    return encodeFrame(encoded, payload);
+}

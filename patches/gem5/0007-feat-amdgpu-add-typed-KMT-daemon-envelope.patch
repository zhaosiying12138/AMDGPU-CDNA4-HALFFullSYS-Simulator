+TEST(HostGPUKmtState, QueueAndEventLifecycleRejectCrossKindHandles)
+{
+    Kmt state;
+    const auto opened = state.submit(
+        transport(), header(), request(protocol::KmtOperation::OpenKfd, 1));
+    auto queue = request(protocol::KmtOperation::QueueCreate, 2);
+    queue.ownerId = opened.response.ownerId;
+    queue.ownerGeneration = opened.response.ownerGeneration;
+    queue.argumentWords[0] = 1;
+    queue.argumentWords[2] = 64;
+    const auto createdQueue = state.submit(transport(), header(), queue);
+    ASSERT_EQ(createdQueue.response.status, protocol::KmtStatus::Success);
+
+    auto bell = request(protocol::KmtOperation::QueueDoorbell, 3);
+    bell.ownerId = opened.response.ownerId;
+    bell.ownerGeneration = opened.response.ownerGeneration;
+    bell.objectId = createdQueue.response.objectId;
+    bell.objectGeneration = createdQueue.response.objectGeneration;
+    setWords(bell.argumentWords, 0, 1, 7);
+    EXPECT_EQ(state.submit(transport(), header(), bell).response.status,
+              protocol::KmtStatus::Success);
+
+    auto event = request(protocol::KmtOperation::EventCreate, 4);
+    event.ownerId = opened.response.ownerId;
+    event.ownerGeneration = opened.response.ownerGeneration;
+    setWords(event.argumentWords, 0, 1, 0);
+    const auto createdEvent = state.submit(transport(), header(), event);
+    ASSERT_EQ(createdEvent.response.status, protocol::KmtStatus::Success);
+
+    auto wrong = request(protocol::KmtOperation::EventSet, 5);
+    wrong.ownerId = opened.response.ownerId;
+    wrong.ownerGeneration = opened.response.ownerGeneration;
+    wrong.objectId = createdQueue.response.objectId;
+    wrong.objectGeneration = createdQueue.response.objectGeneration;
+    setWords(wrong.argumentWords, 0, 1, 1);
+    EXPECT_EQ(state.submit(transport(), header(), wrong).response.status,
+              protocol::KmtStatus::InvalidHandle);
+
+    auto set = wrong;
+    set.operation = protocol::KmtOperation::EventSet;
+    set.operationSequence = 6;
+    set.objectId = createdEvent.response.objectId;
+    set.objectGeneration = createdEvent.response.objectGeneration;
+    EXPECT_EQ(state.submit(transport(), header(), set).response.status,
+              protocol::KmtStatus::Success);
+
+    auto query = request(protocol::KmtOperation::EventQuery, 7);
+    query.ownerId = opened.response.ownerId;
+    query.ownerGeneration = opened.response.ownerGeneration;
+    query.objectId = createdEvent.response.objectId;
+    query.objectGeneration = createdEvent.response.objectGeneration;
+    const auto queried = state.submit(transport(), header(), query);
+    EXPECT_EQ(queried.response.resultWords[1], 1U);
+    EXPECT_EQ(queried.response.resultWords[2], 1U);
+}
+
+TEST(HostGPUKmtState, SequenceAndUnsupportedDrmAreAtomic)
+{
+    Kmt state;
+    const auto opened = state.submit(
+        transport(), header(), request(protocol::KmtOperation::OpenKfd, 1));
+    auto drm = request(protocol::KmtOperation::ModelDrmCall, 2);
+    drm.ownerId = opened.response.ownerId;
+    drm.ownerGeneration = opened.response.ownerGeneration;
+    drm.argumentWords[0] = 0;
+    drm.argumentWords[1] = 48;
+    drm.copiedBytes = 48;
+    drm.copiedCrc32c = protocol::crc32c(drm.copiedBuffer.data(), 48);
+    const auto unsupported = state.submit(transport(), header(), drm);
+    EXPECT_EQ(unsupported.response.status, protocol::KmtStatus::NotSupported);
+    EXPECT_TRUE(unsupported.sequenceConsumed);
+    EXPECT_EQ(state.ownerCount(), 1U);
+
+    auto stale = request(protocol::KmtOperation::GetVersion, 2);
+    stale.ownerId = opened.response.ownerId;
+    stale.ownerGeneration = opened.response.ownerGeneration;
+    const auto staleResponse = state.submit(transport(), header(), stale);
+    EXPECT_EQ(staleResponse.response.wireStatus,
+              static_cast<int32_t>(protocol::Status::ProtocolState));
+    EXPECT_FALSE(staleResponse.sequenceConsumed);
+
+    auto malformed = stale;
+    malformed.operationSequence = 3;
+    malformed.argumentWords[0] = 1;
+    const auto malformedResponse = state.submit(
+        transport(), header(), malformed);
+    EXPECT_EQ(malformedResponse.response.status,
+              protocol::KmtStatus::InvalidParameter);
+    EXPECT_TRUE(malformedResponse.sequenceConsumed);
+
+    auto next = request(protocol::KmtOperation::GetVersion, 4);
+    next.ownerId = opened.response.ownerId;
+    next.ownerGeneration = opened.response.ownerGeneration;
+    EXPECT_EQ(state.submit(transport(), header(), next).response.status,
+              protocol::KmtStatus::Success);
+}
+
+TEST(HostGPUKmtState, DisconnectInvalidatesAllObjects)
+{
+    Kmt state;
+    const auto opened = state.submit(
+        transport(), header(), request(protocol::KmtOperation::OpenKfd, 1));
+    auto event = request(protocol::KmtOperation::EventCreate, 2);
+    event.ownerId = opened.response.ownerId;
+    event.ownerGeneration = opened.response.ownerGeneration;
+    const auto created = state.submit(transport(), header(), event);
+    ASSERT_EQ(created.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(state.eventCount(), 1U);
+    state.disconnect(transport());
+    EXPECT_EQ(state.ownerCount(), 0U);
+    EXPECT_EQ(state.eventCount(), 0U);
+    EXPECT_EQ(state.submit(transport(), header(), event).response.status,
+              protocol::KmtStatus::InvalidHandle);
+}

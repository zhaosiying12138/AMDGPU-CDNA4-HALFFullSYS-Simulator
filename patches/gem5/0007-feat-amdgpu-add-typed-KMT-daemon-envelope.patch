+TEST(HostGpuProtocol, KmtAckPublishesOnlySuccessfulProviderOutput)
+{
+    KmtResponse response;
+    response.operation = KmtOperation::GetVersion;
+    response.operationSequence = 2;
+    response.ownerId = 3;
+    response.ownerGeneration = 4;
+    response.resultWords[0] = 1;
+    response.resultWords[1] = 0;
+    response.resultBytes = 4;
+    response.copiedResult[0] = 1;
+    response.resultCrc32c = crc32c(
+        response.copiedResult.data(), response.resultBytes);
+    auto frame = encodeKmtAck(goldenMemoryHeader(82), response);
+    ASSERT_EQ(frame.size(), HeaderBytes + KmtPayloadBytes);
+    const uint8_t *payload = frame.data() + HeaderBytes;
+    EXPECT_EQ(load64(payload + 24), response.ownerId);
+    EXPECT_EQ(load64(payload + 32), response.ownerGeneration);
+    EXPECT_EQ(load32(payload + 72), 1U);
+    EXPECT_EQ(load32(payload + 104), 4U);
+    EXPECT_EQ(payload[112], 1U);
+
+    response.status = KmtStatus::NotSupported;
+    response.resultWords[0] = 0xffffffffU;
+    frame = encodeKmtAck(goldenMemoryHeader(83), response);
+    payload = frame.data() + HeaderBytes;
+    EXPECT_EQ(load32(payload + 8),
+              static_cast<uint32_t>(KmtStatus::NotSupported));
+    EXPECT_EQ(load32(payload + 72), 0U);
+    EXPECT_EQ(load32(payload + 104), 0U);
+    EXPECT_TRUE(std::all_of(payload + 112, payload + 240,
+                            [](uint8_t byte) { return byte == 0; }));
+
+    response.status = KmtStatus::Success;
+    response.wireStatus = static_cast<int32_t>(Status::ProtocolState);
+    frame = encodeKmtAck(goldenMemoryHeader(84), response);
+    payload = frame.data() + HeaderBytes;
+    EXPECT_EQ(load32(payload + 12),
+              static_cast<uint32_t>(Status::ProtocolState));
+    EXPECT_EQ(load32(payload + 72), 0U);
+    EXPECT_EQ(load32(payload + 104), 0U);
+}

+#ifndef __DEV_AMDGPU_HOST_GPU_KMT_STATE_HH__
+#define __DEV_AMDGPU_HOST_GPU_KMT_STATE_HH__
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <optional>
+#include <unordered_map>
+
+#include "dev/amdgpu/host_gpu_protocol.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Daemon-owned implementation of the CP-0010 operation envelope.
+ *
+ * This class deliberately has no device, file-descriptor, or production
+ * library dependency.  It owns only simulated handles and sparse bytes;
+ * bridge code supplies the transport owner and negotiated header identity.
+ */
+class HostGPUKmtState
+{
+  public:
+    static constexpr size_t MaximumOwners = 64;
+    static constexpr size_t MaximumAllocations = 1024;
+    static constexpr size_t MaximumQueues = 8;
+    static constexpr size_t MaximumEvents = 1024;
+    static constexpr uint64_t MaximumAllocationBytes = 2ULL << 30;
+    static constexpr uint64_t MaximumTotalBytes = 4ULL << 30;
+    static constexpr uint64_t MaximumTransferBytes = 128;
+    static constexpr uint64_t VirtualAddressBase = 0x0000200000000000ULL;
+    static constexpr uint64_t VirtualAddressStride = 2ULL << 30;
+
+    struct Owner
+    {
+        int fd = -1;
+        uint64_t clientGeneration = 0;
+
+        bool operator==(const Owner &other) const
+        {
+            return fd == other.fd &&
+                clientGeneration == other.clientGeneration;
+        }
+    };
+
+    struct Decision
+    {
+        protocol::KmtResponse response;
+        bool sequenceConsumed = false;
+    };
+
+    explicit HostGPUKmtState(uint64_t initialEpoch = 1);
+
+    Decision submit(const Owner &transportOwner,
+                    const protocol::Header &header,
+                    const protocol::KmtRequest &request);
+
+    void disconnect(const Owner &transportOwner);
+    void clear();
+
+    size_t ownerCount() const { return liveOwners; }
+    size_t allocationCount() const { return liveAllocations; }
+    size_t queueCount() const { return liveQueues; }
+    size_t eventCount() const { return liveEvents; }
+    uint64_t totalAllocatedBytes() const { return totalBytes; }
+
+  private:
+    enum class ObjectKind
+    {
+        Allocation,
+        Queue,
+        Event,
+    };
+
+    struct Session
+    {
+        Owner transportOwner;
+        uint64_t ownerId = 0;
+        uint64_t ownerGeneration = 0;
+        uint64_t lastSequence = 0;
+        uint64_t jobEpoch = 0;
+    };
+
+    struct Allocation
+    {
+        uint64_t ownerId = 0;
+        uint64_t ownerGeneration = 0;
+        uint64_t generation = 0;
+        uint64_t size = 0;
+        uint64_t alignment = 0;
+        uint64_t virtualAddress = 0;
+        std::unordered_map<uint64_t, uint8_t> bytes;
+    };
+
+    struct Queue
+    {
+        uint64_t ownerId = 0;
+        uint64_t ownerGeneration = 0;
+        uint64_t generation = 0;
+        uint64_t lastDoorbell = 0;
+    };
+
+    struct Event
+    {
+        uint64_t ownerId = 0;
+        uint64_t ownerGeneration = 0;
+        uint64_t generation = 0;
+        uint64_t value = 0;
+        uint64_t sequence = 0;
+    };
+
+    static constexpr uint64_t OwnerPrefix = 0x4b4d540000000000ULL;
+    static constexpr uint64_t AllocationPrefix = 0x4d454d0000000000ULL;
+    static constexpr uint64_t QueuePrefix = 0x5155450000000000ULL;
+    static constexpr uint64_t EventPrefix = 0x45564e0000000000ULL;
+    static constexpr uint64_t SlotMask = 0x000000ffffffffffULL;
+
+    static uint64_t splitWords(const std::array<uint32_t,
+                                                   protocol::KmtArgumentWordCount>
+                                   &words, size_t high, size_t low);
+    static void setWords(std::array<uint32_t,
+                                    protocol::KmtArgumentWordCount> &words,
+                         size_t high, size_t low, uint64_t value);
+    static bool noWordsExcept(
+        const std::array<uint32_t, protocol::KmtArgumentWordCount> &words,
+        std::initializer_list<size_t> used);
+    static uint64_t makeId(uint64_t prefix, size_t slot);
+    static bool idHasPrefix(uint64_t id, uint64_t prefix);
+    static size_t idSlot(uint64_t id);
+    static bool conditionSatisfied(uint64_t value, uint32_t condition,
+                                   uint64_t compare);
+    static void store16(std::array<uint8_t, protocol::KmtCopiedBufferBytes>
+                            &buffer, size_t offset, uint16_t value);
+    static void store32(std::array<uint8_t, protocol::KmtCopiedBufferBytes>
+                            &buffer, size_t offset, uint32_t value);
+    static void store64(std::array<uint8_t, protocol::KmtCopiedBufferBytes>
+                            &buffer, size_t offset, uint64_t value);
+    static uint32_t drmArgumentBytes(uint32_t command);
+
+    Session *findSession(const Owner &transportOwner);
+    const Session *findSession(const Owner &transportOwner) const;
+    Session *findSession(const Owner &transportOwner, uint64_t ownerId,
+                         uint64_t ownerGeneration);
+    const Session *findSession(const Owner &transportOwner, uint64_t ownerId,
+                               uint64_t ownerGeneration) const;
+    uint64_t takeGeneration(uint64_t &counter, uint64_t preferred);
+    protocol::KmtResponse responseFor(
+        const protocol::KmtRequest &request) const;
+    Decision wireFailure(const protocol::KmtRequest &request,
+                         protocol::Status status) const;
+    Decision providerFailure(const protocol::KmtRequest &request,
+                             protocol::KmtStatus status) const;
+    Decision invalidParameter(const protocol::KmtRequest &request) const;
+    Decision invalidHandle(const protocol::KmtRequest &request) const;
+    bool shapeValid(const protocol::KmtRequest &request,
+                    bool objectRequired, uint64_t copiedBytes,
+                    std::initializer_list<size_t> usedWords) const;
+    Allocation *resolveAllocation(const Session &session,
+                                   const protocol::KmtRequest &request);
+    Queue *resolveQueue(const Session &session,
+                        const protocol::KmtRequest &request);
+    Event *resolveEvent(const Session &session,
+                        const protocol::KmtRequest &request);
+    void releaseSessionObjects(const Session &session);
+    Decision submitOpen(const Owner &transportOwner,
+                        const protocol::Header &header,
+                        const protocol::KmtRequest &request);
+
+    std::array<std::optional<Session>, MaximumOwners> sessions;
+    std::array<std::optional<Allocation>, MaximumAllocations> allocations;
+    std::array<std::optional<Queue>, MaximumQueues> queues;
+    std::array<std::optional<Event>, MaximumEvents> events;
+    uint64_t nextOwnerGeneration = 0;
+    uint64_t nextAllocationGeneration = 0;
+    uint64_t nextQueueGeneration = 0;
+    uint64_t nextEventGeneration = 0;
+    uint64_t initialEpoch = 1;
+    size_t liveOwners = 0;
+    size_t liveAllocations = 0;
+    size_t liveQueues = 0;
+    size_t liveEvents = 0;
+    uint64_t totalBytes = 0;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_KMT_STATE_HH__

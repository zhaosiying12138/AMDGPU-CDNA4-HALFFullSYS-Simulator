+
+constexpr uint64_t U32Mask = 0xffffffffULL;
+
+bool
+pairPresent(uint64_t id, uint64_t generation)
+{
+    return id != 0 && generation != 0;
+}
+
+bool
+pairAbsent(uint64_t id, uint64_t generation)
+{
+    return id == 0 && generation == 0;
+}
+
+} // anonymous namespace
+
+HostGPUKmtState::HostGPUKmtState(uint64_t epoch) : initialEpoch(epoch)
+{
+    if (initialEpoch == 0)
+        initialEpoch = 1;
+}
+
+uint64_t
+HostGPUKmtState::splitWords(
+    const std::array<uint32_t, protocol::KmtArgumentWordCount> &words,
+    size_t high, size_t low)
+{
+    return (static_cast<uint64_t>(words[high]) << 32) | words[low];
+}
+
+void
+HostGPUKmtState::setWords(
+    std::array<uint32_t, protocol::KmtArgumentWordCount> &words,
+    size_t high, size_t low, uint64_t value)
+{
+    words[high] = static_cast<uint32_t>(value >> 32);
+    words[low] = static_cast<uint32_t>(value & U32Mask);
+}
+
+bool
+HostGPUKmtState::noWordsExcept(
+    const std::array<uint32_t, protocol::KmtArgumentWordCount> &words,
+    std::initializer_list<size_t> used)
+{
+    for (size_t index = 0; index < words.size(); ++index) {
+        if (std::find(used.begin(), used.end(), index) == used.end() &&
+            words[index] != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+uint64_t
+HostGPUKmtState::makeId(uint64_t prefix, size_t slot)
+{
+    return prefix | static_cast<uint64_t>(slot + 1);
+}
+
+bool
+HostGPUKmtState::idHasPrefix(uint64_t id, uint64_t prefix)
+{
+    return (id & ~SlotMask) == prefix && (id & SlotMask) != 0;
+}
+
+size_t
+HostGPUKmtState::idSlot(uint64_t id)
+{
+    return static_cast<size_t>((id & SlotMask) - 1);
+}
+
+bool
+HostGPUKmtState::conditionSatisfied(
+    uint64_t value, uint32_t condition, uint64_t compare)
+{
+    switch (condition) {
+      case 0:
+        return value == compare;
+      case 1:
+        return value != compare;
+      case 2:
+        return value < compare;
+      case 3:
+        return value >= compare;
+      default:
+        return false;
+    }
+}
+
+void
+HostGPUKmtState::store16(
+    std::array<uint8_t, protocol::KmtCopiedBufferBytes> &buffer,
+    size_t offset, uint16_t value)
+{
+    buffer[offset] = static_cast<uint8_t>(value >> 8);
+    buffer[offset + 1] = static_cast<uint8_t>(value);
+}
+
+void
+HostGPUKmtState::store32(
+    std::array<uint8_t, protocol::KmtCopiedBufferBytes> &buffer,
+    size_t offset, uint32_t value)
+{
+    for (size_t index = 0; index < 4; ++index)
+        buffer[offset + index] = static_cast<uint8_t>(
+            value >> (24 - index * 8));
+}
+
+void
+HostGPUKmtState::store64(
+    std::array<uint8_t, protocol::KmtCopiedBufferBytes> &buffer,
+    size_t offset, uint64_t value)
+{
+    for (size_t index = 0; index < 8; ++index)
+        buffer[offset + index] = static_cast<uint8_t>(
+            value >> (56 - index * 8));
+}
+
+uint32_t
+HostGPUKmtState::drmArgumentBytes(uint32_t command)
+{
+    static constexpr std::array<uint32_t, 15> sizes = {
+        48, 8, 16, 24, 16, 16, 16, 32, 16, 4, 32, 8, 16, 16, 16};
+    return command < sizes.size() ? sizes[command] : 0;
+}
+
+HostGPUKmtState::Session *
+HostGPUKmtState::findSession(const Owner &transportOwner)
+{
+    for (auto &slot : sessions) {
+        if (slot && slot->transportOwner == transportOwner)
+            return &*slot;
+    }
+    return nullptr;
+}
+
+const HostGPUKmtState::Session *
+HostGPUKmtState::findSession(const Owner &transportOwner) const
+{
+    for (const auto &slot : sessions) {
+        if (slot && slot->transportOwner == transportOwner)
+            return &*slot;
+    }
+    return nullptr;
+}
+
+HostGPUKmtState::Session *
+HostGPUKmtState::findSession(
+    const Owner &transportOwner, uint64_t ownerId,
+    uint64_t ownerGeneration)
+{
+    Session *session = findSession(transportOwner);
+    if (session == nullptr || session->ownerId != ownerId ||
+        session->ownerGeneration != ownerGeneration) {
+        return nullptr;
+    }
+    return session;
+}
+
+const HostGPUKmtState::Session *
+HostGPUKmtState::findSession(
+    const Owner &transportOwner, uint64_t ownerId,
+    uint64_t ownerGeneration) const
+{
+    const Session *session = findSession(transportOwner);
+    if (session == nullptr || session->ownerId != ownerId ||
+        session->ownerGeneration != ownerGeneration) {
+        return nullptr;
+    }
+    return session;
+}
+
+uint64_t
+HostGPUKmtState::takeGeneration(uint64_t &counter, uint64_t preferred)
+{
+    if (preferred == 0)
+        preferred = initialEpoch;
+    if (counter == 0)
+        counter = preferred;
+    if (counter < preferred)
+        counter = preferred;
+    if (counter == 0 || counter == std::numeric_limits<uint64_t>::max())
+        return 0;
+    const uint64_t result = counter;
+    ++counter;
+    return result;
+}
+
+protocol::KmtResponse
+HostGPUKmtState::responseFor(const protocol::KmtRequest &request) const
+{
+    protocol::KmtResponse response;
+    response.operation = request.operation;
+    response.flags = request.flags;
+    response.operationSequence = request.operationSequence;
+    response.ownerId = request.ownerId;
+    response.ownerGeneration = request.ownerGeneration;
+    response.objectId = request.objectId;
+    response.objectGeneration = request.objectGeneration;
+    response.auxId = request.auxId;
+    response.auxGeneration = request.auxGeneration;
+    return response;
+}
+
+HostGPUKmtState::Decision
+HostGPUKmtState::wireFailure(
+    const protocol::KmtRequest &request, protocol::Status status) const
+{
+    Decision decision;
+    decision.response = responseFor(request);
+    decision.response.status = protocol::KmtStatus::Success;
+    decision.response.wireStatus = static_cast<int32_t>(status);
+    decision.response.resultWords.fill(0);
+    decision.response.resultBytes = 0;
+    decision.response.resultCrc32c = 0;
+    decision.response.copiedResult.fill(0);
+    return decision;
+}
+
+HostGPUKmtState::Decision
+HostGPUKmtState::providerFailure(
+    const protocol::KmtRequest &request, protocol::KmtStatus status) const
+{
+    Decision decision;
+    decision.response = responseFor(request);
+    decision.response.status = status;
+    decision.response.wireStatus = static_cast<int32_t>(protocol::Status::Ok);
+    decision.response.resultWords.fill(0);
+    decision.response.resultBytes = 0;
+    decision.response.resultCrc32c = 0;
+    decision.response.copiedResult.fill(0);
+    return decision;
+}
+
+HostGPUKmtState::Decision
+HostGPUKmtState::invalidParameter(const protocol::KmtRequest &request) const
+{
+    return providerFailure(request, protocol::KmtStatus::InvalidParameter);
+}
+
+HostGPUKmtState::Decision
+HostGPUKmtState::invalidHandle(const protocol::KmtRequest &request) const
+{
+    return providerFailure(request, protocol::KmtStatus::InvalidHandle);
+}
+
+bool
+HostGPUKmtState::shapeValid(
+    const protocol::KmtRequest &request, bool objectRequired,
+    uint64_t copiedBytes, std::initializer_list<size_t> usedWords) const
+{
+    const bool objectPair = pairPresent(
+        request.objectId, request.objectGeneration);
+    if ((objectRequired && !objectPair) ||
+        (!objectRequired && !pairAbsent(
+            request.objectId, request.objectGeneration))) {
+        return false;
+    }
+    if (!pairAbsent(request.auxId, request.auxGeneration) ||
+        !noWordsExcept(request.argumentWords, usedWords) ||
+        request.copiedBytes != copiedBytes) {
+        return false;
+    }
+    if (copiedBytes == 0 && request.copiedCrc32c != 0)
+        return false;
+    if (copiedBytes != 0 &&
+        protocol::crc32c(request.copiedBuffer.data(), copiedBytes) !=
+            request.copiedCrc32c)
+        return false;
+    return true;
+}
+
+HostGPUKmtState::Allocation *
+HostGPUKmtState::resolveAllocation(
+    const Session &session, const protocol::KmtRequest &request)
+{
+    if (!idHasPrefix(request.objectId, AllocationPrefix))
+        return nullptr;
+    const size_t slot = idSlot(request.objectId);
+    if (slot >= allocations.size() || !allocations[slot])
+        return nullptr;
+    Allocation &allocation = *allocations[slot];
+    if (allocation.ownerId != session.ownerId ||
+        allocation.ownerGeneration != session.ownerGeneration ||
+        allocation.generation != request.objectGeneration) {
+        return nullptr;
+    }
+    return &allocation;
+}
+
+HostGPUKmtState::Queue *
+HostGPUKmtState::resolveQueue(
+    const Session &session, const protocol::KmtRequest &request)
+{
+    if (!idHasPrefix(request.objectId, QueuePrefix))
+        return nullptr;
+    const size_t slot = idSlot(request.objectId);
+    if (slot >= queues.size() || !queues[slot])
+        return nullptr;
+    Queue &queue = *queues[slot];
+    if (queue.ownerId != session.ownerId ||
+        queue.ownerGeneration != session.ownerGeneration ||
+        queue.generation != request.objectGeneration) {
+        return nullptr;
+    }
+    return &queue;
+}
+
+HostGPUKmtState::Event *
+HostGPUKmtState::resolveEvent(
+    const Session &session, const protocol::KmtRequest &request)
+{
+    if (!idHasPrefix(request.objectId, EventPrefix))
+        return nullptr;
+    const size_t slot = idSlot(request.objectId);
+    if (slot >= events.size() || !events[slot])
+        return nullptr;
+    Event &event = *events[slot];
+    if (event.ownerId != session.ownerId ||
+        event.ownerGeneration != session.ownerGeneration ||
+        event.generation != request.objectGeneration) {
+        return nullptr;
+    }
+    return &event;
+}
+
+void
+HostGPUKmtState::releaseSessionObjects(const Session &session)
+{
+    for (auto &slot : allocations) {
+        if (slot && slot->ownerId == session.ownerId &&
+            slot->ownerGeneration == session.ownerGeneration) {
+            totalBytes -= slot->size;
+            slot.reset();
+            --liveAllocations;
+        }
+    }
+    for (auto &slot : queues) {
+        if (slot && slot->ownerId == session.ownerId &&
+            slot->ownerGeneration == session.ownerGeneration) {
+            slot.reset();
+            --liveQueues;
+        }
+    }
+    for (auto &slot : events) {
+        if (slot && slot->ownerId == session.ownerId &&
+            slot->ownerGeneration == session.ownerGeneration) {
+            slot.reset();
+            --liveEvents;
+        }
+    }
+}
+
+HostGPUKmtState::Decision
+HostGPUKmtState::submitOpen(
+    const Owner &transportOwner, const protocol::Header &header,
+    const protocol::KmtRequest &request)
+{
+    if (header.jobEpoch == 0 || request.operationSequence == 0 ||
+        request.operationSequence != 1 || request.flags != 0 ||
+        !pairAbsent(request.ownerId, request.ownerGeneration) ||
+        !pairAbsent(request.objectId, request.objectGeneration) ||
+        !pairAbsent(request.auxId, request.auxGeneration) ||
+        !noWordsExcept(request.argumentWords, {}) || request.copiedBytes != 0 ||
+        request.copiedCrc32c != 0) {
+        return wireFailure(request, protocol::Status::Malformed);
+    }
+
+    if (Session *existing = findSession(transportOwner)) {
+        if (request.operationSequence <= existing->lastSequence)
+            return wireFailure(request, protocol::Status::ProtocolState);
+        existing->lastSequence = request.operationSequence;
+        return providerFailure(request, protocol::KmtStatus::KernelAlreadyOpened);
+    }
+
+    size_t slot = 0;
+    while (slot < sessions.size() && sessions[slot])
+        ++slot;
+    if (slot == sessions.size())
+        return providerFailure(request, protocol::KmtStatus::OutOfResources);
+    const uint64_t generation = takeGeneration(nextOwnerGeneration,
+                                                header.jobEpoch);
+    if (generation == 0)
+        return providerFailure(request, protocol::KmtStatus::OutOfResources);
+
+    try {
+        sessions[slot].emplace(Session{
+            transportOwner, makeId(OwnerPrefix, slot), generation, 1,
+            header.jobEpoch});
+    } catch (const std::bad_alloc &) {
+        return providerFailure(request, protocol::KmtStatus::NoMemory);
+    }
+    ++liveOwners;
+    Decision decision;
+    decision.response = responseFor(request);
+    decision.response.status = protocol::KmtStatus::Success;
+    decision.response.ownerId = makeId(OwnerPrefix, slot);
+    decision.response.ownerGeneration = generation;
+    decision.response.objectId = 0;
+    decision.response.objectGeneration = 0;
+    decision.response.auxId = 0;
+    decision.response.auxGeneration = 0;
+    decision.sequenceConsumed = true;
+    return decision;
+}
+
+HostGPUKmtState::Decision
+HostGPUKmtState::submit(
+    const Owner &transportOwner, const protocol::Header &header,
+    const protocol::KmtRequest &request)
+{
+    if (request.operation == protocol::KmtOperation::OpenKfd)
+        return submitOpen(transportOwner, header, request);
+
+    Session *session = findSession(
+        transportOwner, request.ownerId, request.ownerGeneration);
+    if (session == nullptr)
+        return invalidHandle(request);
+    if (header.jobEpoch == 0 || header.jobEpoch != session->jobEpoch)
+        return wireFailure(request, protocol::Status::TopologyMismatch);
+    if (request.operationSequence <= session->lastSequence ||
+        request.operationSequence == std::numeric_limits<uint64_t>::max()) {
+        return wireFailure(request, protocol::Status::ProtocolState);
+    }
+    session->lastSequence = request.operationSequence;
+
+    Decision decision;
+    decision.sequenceConsumed = true;
+    decision.response = responseFor(request);
+    decision.response.ownerId = session->ownerId;
+    decision.response.ownerGeneration = session->ownerGeneration;
+    decision.response.wireStatus = static_cast<int32_t>(protocol::Status::Ok);
+
+    auto fail = [&](protocol::KmtStatus status) {
+        decision.response.status = status;
+        decision.response.objectId = request.objectId;
+        decision.response.objectGeneration = request.objectGeneration;
+        decision.response.resultWords.fill(0);
+        decision.response.resultBytes = 0;
+        decision.response.resultCrc32c = 0;
+        decision.response.copiedResult.fill(0);
+        return decision;
+    };
+    auto malformed = [&]() { return fail(protocol::KmtStatus::InvalidParameter); };
+
+    switch (request.operation) {
+      case protocol::KmtOperation::CloseKfd: {
+        if (!shapeValid(request, false, 0, {}))
+            return malformed();
+        for (const auto &allocation : allocations) {
+            if (allocation && allocation->ownerId == session->ownerId &&
+                allocation->ownerGeneration == session->ownerGeneration)
+                return fail(protocol::KmtStatus::OutOfResources);
+        }
+        for (const auto &queue : queues) {
+            if (queue && queue->ownerId == session->ownerId &&
+                queue->ownerGeneration == session->ownerGeneration)
+                return fail(protocol::KmtStatus::OutOfResources);
+        }
+        for (const auto &event : events) {
+            if (event && event->ownerId == session->ownerId &&
+                event->ownerGeneration == session->ownerGeneration)
+                return fail(protocol::KmtStatus::OutOfResources);
+        }
+        const uint64_t responseOwnerId = session->ownerId;
+        const uint64_t responseOwnerGeneration = session->ownerGeneration;
+        size_t index = sessions.size();
+        for (size_t candidate = 0; candidate < sessions.size(); ++candidate) {
+            if (sessions[candidate] && &*sessions[candidate] == session) {
+                index = candidate;
+                break;
+            }
+        }
+        if (index == sessions.size())
+            return fail(protocol::KmtStatus::InvalidHandle);
+        sessions[index].reset();
+        --liveOwners;
+        decision.response.objectId = 0;
+        decision.response.objectGeneration = 0;
+        decision.response.ownerId = responseOwnerId;
+        decision.response.ownerGeneration = responseOwnerGeneration;
+        return decision;
+      }
+
+      case protocol::KmtOperation::GetVersion:
+        if (!shapeValid(request, false, 0, {}))
+            return malformed();
+        decision.response.resultWords[0] = 1;
+        decision.response.resultWords[1] = 0;
+        decision.response.resultWords[2] = 0;
+        decision.response.resultWords[3] = 0;
+        return decision;
+
+      case protocol::KmtOperation::TopologySnapshot: {
+        if (!shapeValid(request, false, 0, {}))
+            return malformed();
+        decision.response.objectId = 1;
+        decision.response.objectGeneration = header.jobEpoch;
+        decision.response.resultWords[0] = 1;
+        decision.response.resultWords[1] = 1;
+        decision.response.resultWords[2] = 0;
+        setWords(decision.response.resultWords, 4, 5, header.jobEpoch);
+        decision.response.resultBytes = 64;
+        auto &buffer = decision.response.copiedResult;
+        store16(buffer, 0, 1);
+        store16(buffer, 2, 0);
+        store32(buffer, 4, 1);
+        store64(buffer, 8, header.jobEpoch);
+        store32(buffer, 16, 950);
+        store32(buffer, 20, 1);
+        store32(buffer, 24, 64);
+        store32(buffer, 28, 65536);
+        store32(buffer, 32, 48);
+        store32(buffer, 36, MaximumQueues);
+        store32(buffer, 40, MaximumAllocations);
+        store32(buffer, 44, MaximumEvents);
+        store16(buffer, 48, 1);
+        store16(buffer, 50, 1);
+        decision.response.resultCrc32c = protocol::crc32c(
+            buffer.data(), decision.response.resultBytes);
+        return decision;
+      }
+
+      case protocol::KmtOperation::AllocateMemory: {
+        if (!shapeValid(request, false, 0, {0, 1, 2, 3, 4, 5, 6}) ||
+            request.argumentWords[0] != 1 || request.argumentWords[5] != 0 ||
+            request.argumentWords[6] != 0)
+            return malformed();
+        const uint64_t size = splitWords(request.argumentWords, 1, 2);
+        const uint64_t alignment = splitWords(request.argumentWords, 3, 4);
+        if (size == 0 || size > MaximumAllocationBytes ||
+            alignment == 0 || alignment > (1ULL << 30) ||
+            (alignment & (alignment - 1)) != 0 ||
+            size > MaximumTotalBytes - totalBytes)
+            return fail(protocol::KmtStatus::OutOfResources);
+        size_t slot = 0;
+        while (slot < allocations.size() && allocations[slot])
+            ++slot;
+        if (slot == allocations.size())
+            return fail(protocol::KmtStatus::OutOfResources);
+        const uint64_t generation = takeGeneration(
+            nextAllocationGeneration, session->jobEpoch);
+        if (generation == 0)
+            return fail(protocol::KmtStatus::OutOfResources);
+        try {
+            allocations[slot].emplace(Allocation{
+                session->ownerId, session->ownerGeneration, generation,
+                size, alignment,
+                VirtualAddressBase + static_cast<uint64_t>(slot) *
+                    VirtualAddressStride, {}});
+        } catch (const std::bad_alloc &) {
+            return fail(protocol::KmtStatus::NoMemory);
+        }
+        ++liveAllocations;
+        totalBytes += size;
+        decision.response.objectId = makeId(AllocationPrefix, slot);
+        decision.response.objectGeneration = generation;
+        setWords(decision.response.resultWords, 1, 2, size);
+        setWords(decision.response.resultWords, 3, 4, alignment);
+        setWords(decision.response.resultWords, 5, 6,
+                 allocations[slot]->virtualAddress);
+        return decision;
+      }
+
+      case protocol::KmtOperation::FreeMemory: {
+        if (!shapeValid(request, true, 0, {}))
+            return malformed();
+        Allocation *allocation = resolveAllocation(*session, request);
+        if (allocation == nullptr)
+            return fail(protocol::KmtStatus::InvalidHandle);
+        const size_t slot = idSlot(request.objectId);
+        totalBytes -= allocation->size;
+        allocations[slot].reset();
+        --liveAllocations;
+        return decision;
+      }
+
+      case protocol::KmtOperation::CopyMemory: {
+        if (!pairPresent(request.objectId, request.objectGeneration) ||
+            !pairAbsent(request.auxId, request.auxGeneration) ||
+            request.flags != 0 || !noWordsExcept(request.argumentWords,
+                                                  {0, 1, 2, 3, 4}))
+            return malformed();
+        Allocation *allocation = resolveAllocation(*session, request);
+        if (allocation == nullptr)
+            return fail(protocol::KmtStatus::InvalidHandle);
+        const uint32_t direction = request.argumentWords[0];
+        const uint64_t offset = splitWords(request.argumentWords, 1, 2);
+        const uint64_t count = splitWords(request.argumentWords, 3, 4);
+        if ((direction != 1 && direction != 2) || count == 0 ||
+            count > MaximumTransferBytes || offset > allocation->size ||
+            count > allocation->size - offset)
+            return malformed();
+        if (direction == 1) {
+            if (request.copiedBytes != count ||
+                protocol::crc32c(request.copiedBuffer.data(), count) !=
+                    request.copiedCrc32c)
+                return malformed();
+            for (uint64_t index = 0; index < count; ++index) {
+                const uint8_t value = request.copiedBuffer[
+                    static_cast<size_t>(index)];
+                if (value == 0)
+                    allocation->bytes.erase(offset + index);
+                else
+                    allocation->bytes[offset + index] = value;
+            }
+        } else {
+            if (request.copiedBytes != 0 || request.copiedCrc32c != 0)
+                return malformed();
+            for (uint64_t index = 0; index < count; ++index) {
+                const auto found = allocation->bytes.find(offset + index);
+                decision.response.copiedResult[static_cast<size_t>(index)] =
+                    found == allocation->bytes.end() ? 0 : found->second;
+            }
+            decision.response.resultBytes = static_cast<uint32_t>(count);
+            decision.response.resultCrc32c = protocol::crc32c(
+                decision.response.copiedResult.data(), count);
+        }
+        return decision;
+      }
+
+      case protocol::KmtOperation::QueueCreate: {
+        if (!shapeValid(request, false, 0, {0, 1, 2, 3, 4}) ||
+            request.argumentWords[0] != 1 || request.argumentWords[2] == 0 ||
+            request.argumentWords[2] > (1U << 20))
+            return malformed();
+        size_t slot = 0;
+        while (slot < queues.size() && queues[slot])
+            ++slot;
+        if (slot == queues.size())
+            return fail(protocol::KmtStatus::OutOfResources);
+        const uint64_t generation = takeGeneration(
+            nextQueueGeneration, session->jobEpoch);
+        if (generation == 0)
+            return fail(protocol::KmtStatus::OutOfResources);
+        try {
+            queues[slot].emplace(Queue{
+                session->ownerId, session->ownerGeneration, generation, 0});
+        } catch (const std::bad_alloc &) {
+            return fail(protocol::KmtStatus::NoMemory);
+        }
+        ++liveQueues;
+        decision.response.objectId = makeId(QueuePrefix, slot);
+        decision.response.objectGeneration = generation;
+        decision.response.resultWords[0] = request.argumentWords[2];
+        return decision;
+      }
+
+      case protocol::KmtOperation::QueueDestroy: {
+        if (!shapeValid(request, true, 0, {}))
+            return malformed();
+        Queue *queue = resolveQueue(*session, request);
+        if (queue == nullptr)
+            return fail(protocol::KmtStatus::InvalidHandle);
+        queues[idSlot(request.objectId)].reset();
+        --liveQueues;
+        return decision;
+      }
+
+      case protocol::KmtOperation::QueueDoorbell: {
+        if (!shapeValid(request, true, 0, {0, 1}))
+            return malformed();
+        Queue *queue = resolveQueue(*session, request);
+        if (queue == nullptr)
+            return fail(protocol::KmtStatus::InvalidHandle);
+        const uint64_t sequence = splitWords(request.argumentWords, 0, 1);
+        if (sequence == 0 || sequence <= queue->lastDoorbell)
+            return malformed();
+        queue->lastDoorbell = sequence;
+        setWords(decision.response.resultWords, 0, 1, sequence);
+        return decision;
+      }
+
+      case protocol::KmtOperation::EventCreate: {
+        if (!shapeValid(request, false, 0, {0, 1}))
+            return malformed();
+        size_t slot = 0;
+        while (slot < events.size() && events[slot])
+            ++slot;
+        if (slot == events.size())
+            return fail(protocol::KmtStatus::OutOfResources);
+        const uint64_t generation = takeGeneration(
+            nextEventGeneration, session->jobEpoch);
+        if (generation == 0)
+            return fail(protocol::KmtStatus::OutOfResources);
+        try {
+            events[slot].emplace(Event{
+                session->ownerId, session->ownerGeneration, generation,
+                splitWords(request.argumentWords, 0, 1), 0});
+        } catch (const std::bad_alloc &) {
+            return fail(protocol::KmtStatus::NoMemory);
+        }
+        ++liveEvents;
+        decision.response.objectId = makeId(EventPrefix, slot);
+        decision.response.objectGeneration = generation;
+        return decision;
+      }
+
+      case protocol::KmtOperation::EventDestroy:
+      case protocol::KmtOperation::EventSet:
+      case protocol::KmtOperation::EventReset:
+      case protocol::KmtOperation::EventQuery:
+      case protocol::KmtOperation::EventWait: {
+        const bool hasValue = request.operation == protocol::KmtOperation::EventSet;
+        const bool hasWait = request.operation == protocol::KmtOperation::EventWait;
+        bool expectedShape = false;
+        if (hasWait)
+            expectedShape = shapeValid(request, true, 0, {0, 1, 2, 3});
+        else if (hasValue)
+            expectedShape = shapeValid(request, true, 0, {0, 1});
+        else
+            expectedShape = shapeValid(request, true, 0, {});
+        if (!expectedShape)
+            return malformed();
+        Event *event = resolveEvent(*session, request);
+        if (event == nullptr)
+            return fail(protocol::KmtStatus::InvalidHandle);
+        switch (request.operation) {
+          case protocol::KmtOperation::EventDestroy:
+            events[idSlot(request.objectId)].reset();
+            --liveEvents;
+            return decision;
+          case protocol::KmtOperation::EventSet:
+            event->value = splitWords(request.argumentWords, 0, 1);
+            ++event->sequence;
+            return decision;
+          case protocol::KmtOperation::EventReset:
+            event->value = 0;
+            ++event->sequence;
+            return decision;
+          case protocol::KmtOperation::EventQuery:
+            setWords(decision.response.resultWords, 0, 1, event->value);
+            decision.response.resultWords[2] = event->value != 0;
+            setWords(decision.response.resultWords, 3, 4, event->sequence);
+            return decision;
+          case protocol::KmtOperation::EventWait: {
+            const uint64_t condition = splitWords(request.argumentWords, 0, 1);
+            const uint64_t compare = splitWords(request.argumentWords, 2, 3);
+            if (condition > 3)
+                return malformed();
+            setWords(decision.response.resultWords, 0, 1, event->value);
+            if (!conditionSatisfied(event->value,
+                                    static_cast<uint32_t>(condition), compare)) {
+                decision.response.status = protocol::KmtStatus::WaitTimeout;
+            }
+            return decision;
+          }
+          default:
+            return malformed();
+        }
+      }
+
+      case protocol::KmtOperation::PointerInfo: {
+        if (!shapeValid(request, true, 0, {}))
+            return malformed();
+        Allocation *allocation = resolveAllocation(*session, request);
+        if (allocation == nullptr)
+            return fail(protocol::KmtStatus::InvalidHandle);
+        setWords(decision.response.resultWords, 1, 2, 0);
+        setWords(decision.response.resultWords, 3, 4, allocation->size);
+        return decision;
+      }
+
+      case protocol::KmtOperation::ModelDrmCall: {
+        if (!shapeValid(request, false, request.copiedBytes, {0, 1}) ||
+            request.argumentWords[0] > 14 ||
+            request.argumentWords[1] > protocol::KmtCopiedBufferBytes ||
+            request.copiedBytes != drmArgumentBytes(
+                request.argumentWords[0]))
+            return malformed();
+        return fail(protocol::KmtStatus::NotSupported);
+      }
+
+      case protocol::KmtOperation::OpenKfd:
+        return malformed();
+    }
+    return malformed();
+}
+
+void
+HostGPUKmtState::disconnect(const Owner &transportOwner)
+{
+    Session *session = findSession(transportOwner);
+    if (session == nullptr)
+        return;
+    const Session snapshot = *session;
+    releaseSessionObjects(snapshot);
+    for (auto &slot : sessions) {
+        if (slot && slot->transportOwner == transportOwner) {
+            slot.reset();
+            --liveOwners;
+            return;
+        }
+    }
+}
+
+void
+HostGPUKmtState::clear()
+{
+    sessions = {};
+    allocations = {};
+    queues = {};
+    events = {};
+    liveOwners = 0;
+    liveAllocations = 0;
+    liveQueues = 0;
+    liveEvents = 0;
+    totalBytes = 0;
+}
+
+} // namespace hostgpu
+} // namespace gem5

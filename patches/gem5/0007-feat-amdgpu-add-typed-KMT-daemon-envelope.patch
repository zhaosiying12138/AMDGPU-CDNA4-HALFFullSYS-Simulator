+KmtDecodeResult
+decodeKmtRequestRecord(const uint8_t *record, size_t size,
+                       uint32_t configuredMaximum)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason)) {
+        KmtDecodeResult result;
+        result.reason = reason;
+        return result;
+    }
+    if (header.messageType != MessageType::KmtRequest) {
+        KmtDecodeResult result;
+        result.reason = "expected KMT_REQUEST";
+        return result;
+    }
+    if (size - HeaderBytes != KmtPayloadBytes) {
+        KmtDecodeResult result;
+        result.reason = "KMT payload length";
+        return result;
+    }
+
+    KmtRequest request;
+    request.major = load16(payload);
+    request.minor = load16(payload + 2);
+    const uint16_t rawOperation = load16(payload + 4);
+    request.operation = static_cast<KmtOperation>(rawOperation);
+    request.flags = load16(payload + 6);
+    request.operationSequence = load64(payload + 8);
+    request.ownerId = load64(payload + 16);
+    request.ownerGeneration = load64(payload + 24);
+    request.objectId = load64(payload + 32);
+    request.objectGeneration = load64(payload + 40);
+    request.auxId = load64(payload + 48);
+    request.auxGeneration = load64(payload + 56);
+    for (size_t index = 0; index < request.argumentWords.size(); ++index)
+        request.argumentWords[index] = load32(payload + 64 + index * 4);
+    request.copiedBytes = load32(payload + 96);
+    request.copiedCrc32c = load32(payload + 100);
+    std::copy_n(payload + 104, request.copiedBuffer.size(),
+                request.copiedBuffer.begin());
+
+    auto acknowledge = [&](Status status, const std::string &why) {
+        KmtDecodeResult result;
+        result.action = DecodeAction::Acknowledge;
+        result.closeConnection = false;
+        result.status = status;
+        result.reason = why;
+        result.header = header;
+        result.request = request;
+        return result;
+    };
+
+    const bool ownerPair = (request.ownerId == 0) ==
+        (request.ownerGeneration == 0);
+    const bool objectPair = (request.objectId == 0) ==
+        (request.objectGeneration == 0);
+    const bool auxPair = (request.auxId == 0) ==
+        (request.auxGeneration == 0);
+    const bool copiedPaddingZero = std::all_of(
+        request.copiedBuffer.begin() +
+            std::min<size_t>(request.copiedBytes,
+                             request.copiedBuffer.size()),
+        request.copiedBuffer.end(), [](uint8_t value) { return value == 0; });
+    const bool reservedZero = std::all_of(
+        payload + 232, payload + KmtPayloadBytes,
+        [](uint8_t value) { return value == 0; });
+    const bool copiedCrcValid = request.copiedBytes == 0 ?
+        request.copiedCrc32c == 0 :
+        request.copiedBytes <= request.copiedBuffer.size() &&
+        crc32c(request.copiedBuffer.data(), request.copiedBytes) ==
+            request.copiedCrc32c;
+
+    if (!validKmtOperation(rawOperation) || request.flags != 0 ||
+        request.operationSequence == 0 || !ownerPair || !objectPair ||
+        !auxPair || request.copiedBytes > request.copiedBuffer.size() ||
+        !copiedPaddingZero || !copiedCrcValid || !reservedZero) {
+        return acknowledge(Status::Malformed, "invalid KMT fields");
+    }
+    if (request.operation == KmtOperation::OpenKfd &&
+        (request.ownerId != 0 || request.objectId != 0 ||
+         request.auxId != 0)) {
+        return acknowledge(Status::Malformed,
+                           "OPEN_KFD carries an identity");
+    }
+    if (request.major != KmtOperationMajor ||
+        request.minor != KmtOperationMinor) {
+        return acknowledge(Status::UnsupportedVersion,
+                           "unsupported KMT operation version");
+    }
+    return acknowledge(Status::Ok, "valid KMT request");
+}

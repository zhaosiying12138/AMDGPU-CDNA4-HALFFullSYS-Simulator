+TEST(HostGPUKmtState, OpenVersionTopologyAndOwnerGeneration)
+{
+    Kmt state(1);
+    const auto opened = state.submit(
+        transport(), header(), request(protocol::KmtOperation::OpenKfd, 1));
+    ASSERT_EQ(opened.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(opened.response.wireStatus, 0);
+    EXPECT_EQ(opened.response.ownerId, 0x4b4d540000000001ULL);
+    EXPECT_EQ(opened.response.ownerGeneration, 1U);
+    ASSERT_TRUE(opened.sequenceConsumed);
+
+    auto version = request(protocol::KmtOperation::GetVersion, 2);
+    version.ownerId = opened.response.ownerId;
+    version.ownerGeneration = opened.response.ownerGeneration;
+    const auto versionResponse = state.submit(transport(), header(), version);
+    ASSERT_EQ(versionResponse.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(versionResponse.response.resultWords[0], 1U);
+    EXPECT_EQ(versionResponse.response.resultWords[1], 0U);
+
+    auto topology = request(protocol::KmtOperation::TopologySnapshot, 3);
+    topology.ownerId = opened.response.ownerId;
+    topology.ownerGeneration = opened.response.ownerGeneration;
+    const auto topologyResponse = state.submit(
+        transport(), header(), topology);
+    ASSERT_EQ(topologyResponse.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(topologyResponse.response.objectId, 1U);
+    EXPECT_EQ(topologyResponse.response.objectGeneration, 1U);
+    EXPECT_EQ(topologyResponse.response.resultBytes, 64U);
+    EXPECT_EQ(topologyResponse.response.copiedResult[16], 0U);
+    EXPECT_EQ(topologyResponse.response.copiedResult[17], 0U);
+    EXPECT_EQ(topologyResponse.response.copiedResult[18], 3U);
+    EXPECT_EQ(topologyResponse.response.copiedResult[19], 0xb6U);
+}
+
+TEST(HostGPUKmtState, SparseMemoryCopyAndGenerationSafeReuse)
+{
+    Kmt state;
+    const auto opened = state.submit(
+        transport(), header(), request(protocol::KmtOperation::OpenKfd, 1));
+    auto allocation = request(protocol::KmtOperation::AllocateMemory, 2);
+    allocation.ownerId = opened.response.ownerId;
+    allocation.ownerGeneration = opened.response.ownerGeneration;
+    allocation.argumentWords[0] = 1;
+    setWords(allocation.argumentWords, 1, 2, 65536);
+    setWords(allocation.argumentWords, 3, 4, 65536);
+    const auto allocated = state.submit(transport(), header(), allocation);
+    ASSERT_EQ(allocated.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(allocated.response.objectId, 0x4d454d0000000001ULL);
+    EXPECT_EQ(allocated.response.objectGeneration, 1U);
+
+    auto write = request(protocol::KmtOperation::CopyMemory, 3);
+    write.ownerId = opened.response.ownerId;
+    write.ownerGeneration = opened.response.ownerGeneration;
+    write.objectId = allocated.response.objectId;
+    write.objectGeneration = allocated.response.objectGeneration;
+    write.argumentWords[0] = 1;
+    setWords(write.argumentWords, 1, 2, 4);
+    setWords(write.argumentWords, 3, 4, 4);
+    write.copiedBytes = 4;
+    write.copiedBuffer[0] = 0xde;
+    write.copiedBuffer[1] = 0xad;
+    write.copiedBuffer[2] = 0xbe;
+    write.copiedBuffer[3] = 0xef;
+    write.copiedCrc32c = protocol::crc32c(
+        write.copiedBuffer.data(), write.copiedBytes);
+    ASSERT_EQ(state.submit(transport(), header(), write).response.status,
+              protocol::KmtStatus::Success);
+
+    auto read = write;
+    read.operation = protocol::KmtOperation::CopyMemory;
+    read.operationSequence = 4;
+    read.argumentWords[0] = 2;
+    read.copiedBytes = 0;
+    read.copiedCrc32c = 0;
+    const auto readResponse = state.submit(transport(), header(), read);
+    ASSERT_EQ(readResponse.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(readResponse.response.resultBytes, 4U);
+    EXPECT_EQ(readResponse.response.copiedResult[0], 0xdeU);
+    EXPECT_EQ(readResponse.response.copiedResult[3], 0xefU);
+
+    auto free = request(protocol::KmtOperation::FreeMemory, 5);
+    free.ownerId = opened.response.ownerId;
+    free.ownerGeneration = opened.response.ownerGeneration;
+    free.objectId = allocated.response.objectId;
+    free.objectGeneration = allocated.response.objectGeneration;
+    ASSERT_EQ(state.submit(transport(), header(), free).response.status,
+              protocol::KmtStatus::Success);
+
+    allocation.operationSequence = 6;
+    const auto second = state.submit(transport(), header(), allocation);
+    ASSERT_EQ(second.response.status, protocol::KmtStatus::Success);
+    EXPECT_EQ(second.response.objectId, allocated.response.objectId);
+    EXPECT_NE(second.response.objectGeneration,
+              allocated.response.objectGeneration);
+}

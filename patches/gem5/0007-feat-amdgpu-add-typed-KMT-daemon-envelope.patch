+TEST(HostGpuProtocol, KmtRequestRoundTripsFixedOwnerGeneration)
+{
+    KmtRequest request;
+    request.operation = KmtOperation::CopyMemory;
+    request.operationSequence = 9;
+    request.ownerId = 0x1111222233334444ULL;
+    request.ownerGeneration = 0x5555666677778888ULL;
+    request.objectId = 7;
+    request.objectGeneration = 8;
+    request.argumentWords[0] = 1;
+    request.argumentWords[1] = 0;
+    request.argumentWords[2] = 64;
+    request.copiedBytes = 4;
+    request.copiedBuffer[0] = 0xde;
+    request.copiedBuffer[1] = 0xad;
+    request.copiedBuffer[2] = 0xbe;
+    request.copiedBuffer[3] = 0xef;
+    request.copiedCrc32c = crc32c(
+        request.copiedBuffer.data(), request.copiedBytes);
+
+    const auto frame = encodeKmtRequest(goldenMemoryHeader(80), request);
+    ASSERT_EQ(frame.size(), HeaderBytes + KmtPayloadBytes);
+    EXPECT_EQ(load16(frame.data() + 14),
+              static_cast<uint16_t>(MessageType::KmtRequest));
+    const uint8_t *payload = frame.data() + HeaderBytes;
+    EXPECT_EQ(load64(payload + 16), request.ownerId);
+    EXPECT_EQ(load64(payload + 24), request.ownerGeneration);
+    EXPECT_EQ(load64(payload + 32), request.objectId);
+    EXPECT_EQ(load32(payload + 96), request.copiedBytes);
+    EXPECT_EQ(load32(payload + 100), request.copiedCrc32c);
+
+    const auto decoded = decodeKmtRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes);
+    ASSERT_EQ(decoded.action, DecodeAction::Acknowledge);
+    ASSERT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.request.operation, KmtOperation::CopyMemory);
+    EXPECT_EQ(decoded.request.ownerId, request.ownerId);
+    EXPECT_EQ(decoded.request.ownerGeneration, request.ownerGeneration);
+    EXPECT_EQ(decoded.request.objectId, request.objectId);
+    EXPECT_EQ(decoded.request.objectGeneration, request.objectGeneration);
+    EXPECT_EQ(decoded.request.copiedBytes, request.copiedBytes);
+    EXPECT_TRUE(std::equal(
+        request.copiedBuffer.begin(),
+        request.copiedBuffer.begin() + request.copiedBytes,
+        decoded.request.copiedBuffer.begin()));
+}

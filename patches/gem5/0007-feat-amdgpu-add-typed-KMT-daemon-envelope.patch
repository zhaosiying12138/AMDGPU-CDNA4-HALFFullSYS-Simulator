+Kmt::Owner
+transport(int fd = 7, uint64_t generation = 11)
+{
+    return {fd, generation};
+}
+
+protocol::Header
+header(uint64_t epoch = 1, uint64_t connection = 9)
+{
+    protocol::Header result;
+    result.connectionId = connection;
+    result.jobEpoch = epoch;
+    return result;
+}
+
+protocol::KmtRequest
+request(protocol::KmtOperation operation, uint64_t sequence)
+{
+    protocol::KmtRequest result;
+    result.operation = operation;
+    result.operationSequence = sequence;
+    return result;
+}
+
+void
+setWords(std::array<uint32_t, protocol::KmtArgumentWordCount> &words,
+         size_t high, size_t low, uint64_t value)
+{
+    words[high] = static_cast<uint32_t>(value >> 32);
+    words[low] = static_cast<uint32_t>(value);
+}

+inline int32_t
+i32FromBits(uint32_t value)
+{
+    int32_t result;
+    std::memcpy(&result, &value, sizeof(result));
+    return result;
+}
+
+inline uint32_t
+i32Bits(int32_t value)
+{
+    uint32_t result;
+    std::memcpy(&result, &value, sizeof(result));
+    return result;
+}
+
+inline uint32_t
+vop3AddI32(uint32_t lhs, uint32_t rhs, bool clamp)
+{
+    if (!clamp)
+        return lhs + rhs;
+
+    const int64_t sum = static_cast<int64_t>(i32FromBits(lhs)) +
+                        static_cast<int64_t>(i32FromBits(rhs));
+    const int64_t saturated = std::clamp(
+        sum,
+        static_cast<int64_t>(std::numeric_limits<int32_t>::min()),
+        static_cast<int64_t>(std::numeric_limits<int32_t>::max()));
+    return i32Bits(static_cast<int32_t>(saturated));
+}
+
+inline uint32_t
+vop3SubI32(uint32_t lhs, uint32_t rhs, bool clamp)
+{
+    if (!clamp)
+        return lhs - rhs;
+
+    const int64_t difference = static_cast<int64_t>(i32FromBits(lhs)) -
+                               static_cast<int64_t>(i32FromBits(rhs));
+    const int64_t saturated = std::clamp(
+        difference,
+        static_cast<int64_t>(std::numeric_limits<int32_t>::min()),
+        static_cast<int64_t>(std::numeric_limits<int32_t>::max()));
+    return i32Bits(static_cast<int32_t>(saturated));
+}

     Decoder::subDecode_OP_MUBUF(MachInst iFmt)
     {
         InFmt_MUBUF *enc = &iFmt->iFmt_MUBUF;
+
+        // CDNA recycles these MUBUF slots for cache control. Keep the newer
+        // meanings local to the architectures on which LLVM emits them.
+        if (enc->OP == 0x28 &&
+            (gfxVersion == GfxVersion::gfx90a ||
+             gfxVersion == GfxVersion::gfx942 ||
+             gfxVersion == GfxVersion::gfx950)) {
+            return decode_OP_MUBUF__BUFFER_WBL2(iFmt);
+        }
+        if (enc->OP == 0x29 &&
+            (gfxVersion == GfxVersion::gfx942 ||
+             gfxVersion == GfxVersion::gfx950)) {
+            return decode_OP_MUBUF__BUFFER_INV(iFmt);
+        }
+

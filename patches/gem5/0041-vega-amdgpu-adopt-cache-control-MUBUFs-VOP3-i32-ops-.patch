+TEST(GpuDecoderTest, Gfx950BufferCacheControl)
+{
+    struct CacheControlEncoding
+    {
+        uint32_t word0;
+        const char *mnemonic;
+    };
+    // Golden gfx950 encodings from llvm-mc. GLC/SLC encode SC0/SC1.
+    static constexpr std::array<CacheControlEncoding, 2> Encodings = {{
+        {0xe0a0c000, "buffer_wbl2"},
+        {0xe0a4c000, "buffer_inv"},
+    }};
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    for (const auto &encoding : Encodings) {
+        InstFormat words[2] = {};
+        words[0].imm_u32 = encoding.word0;
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        SCOPED_TRACE(encoding.mnemonic);
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), encoding.mnemonic);
+        EXPECT_EQ(inst->instSize(), 8);
+        EXPECT_EQ(inst->getNumOperands(), 0);
+        EXPECT_TRUE(inst->isMemRef());
+        EXPECT_TRUE(inst->isMemSync());
+        EXPECT_TRUE(inst->isGlobalMem());
+        EXPECT_EQ(inst->disassemble().rfind(encoding.mnemonic, 0), 0);
+    }
+}
+
+TEST(GpuDecoderTest, Gfx950WakeupIsFunctionalNop)
+{
+    InstFormat words[2] = {};
+    words[0].imm_u32 = 0xbf830000;
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "s_wakeup");
+    EXPECT_EQ(inst->instSize(), 4);
+    EXPECT_EQ(inst->getNumOperands(), 0);
+    EXPECT_TRUE(inst->isScalar());
+    EXPECT_TRUE(inst->isNop());
+    EXPECT_EQ(inst->disassemble(), "s_wakeup");
+}
+
+TEST(GpuDecoderTest, Gfx950Vop3SignedAddSub)
+{
+    struct Encoding
+    {
+        uint32_t word0;
+        const char *mnemonic;
+    };
+    // LLVM gfx9/CDNA VOP3 encodings; gfx950 retains opcodes 0x29c/0x29d.
+    static constexpr std::array<Encoding, 2> Encodings = {{
+        {0xd29c0001, "v_add_i32"},
+        {0xd29d0001, "v_sub_i32"},
+    }};
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    for (const auto &encoding : Encodings) {
+        InstFormat words[2] = {};
+        words[0].imm_u32 = encoding.word0;
+        words[1].imm_u32 = 0x00020702;
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        SCOPED_TRACE(encoding.mnemonic);
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), encoding.mnemonic);
+        EXPECT_EQ(inst->instSize(), 8);
+        EXPECT_TRUE(inst->isALU());
+        EXPECT_EQ(inst->getNumOperands(), 3);
+        EXPECT_EQ(inst->getOperandSize(0), 4);
+        EXPECT_EQ(inst->getOperandSize(1), 4);
+        EXPECT_EQ(inst->getOperandSize(2), 4);
+        EXPECT_EQ(inst->disassemble().rfind(encoding.mnemonic, 0), 0);
+    }
+}

+constexpr const char *FixtureRelativePath =
+    "projects/rocm-systems/projects/rdc/rdc_libs/rdc_modules/kernels/"
+    "hsaco/gfx950/gpuReadWrite_kernels.hsaco";
+
+void
+require(bool condition, const char *message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+std::vector<uint8_t>
+readFixture(int argc, char **argv)
+{
+    std::vector<std::string> candidates;
+    if (argc > 1)
+        candidates.emplace_back(argv[1]);
+    candidates.emplace_back(FixtureRelativePath);
+    candidates.emplace_back(
+        std::string("../") + std::string(FixtureRelativePath).substr(9));
+    candidates.emplace_back(std::string("../../") + FixtureRelativePath);
+    candidates.emplace_back(std::string("../../../") + FixtureRelativePath);
+    for (const auto &candidate : candidates) {
+        std::ifstream input(candidate, std::ios::binary);
+        if (!input)
+            continue;
+        return {std::istreambuf_iterator<char>(input),
+                std::istreambuf_iterator<char>()};
+    }
+    throw std::runtime_error(
+        "locked gpuReadWrite HSACO fixture is unavailable");
+}
+
+protocol::CodeObjectManifest
+fixtureManifest(const std::vector<uint8_t> &image)
+{
+    protocol::CodeObjectManifest manifest;
+    manifest.imageSize = image.size();
+    manifest.chunkCount = 2;
+    manifest.segmentCount = 3;
+    manifest.kernelIndex = 0;
+    manifest.imageSha256 = {
+        0x7b, 0x6a, 0x4d, 0x2b, 0xb7, 0xf9, 0xc4, 0xe7,
+        0x46, 0x6b, 0xcf, 0x69, 0xf3, 0x11, 0x0e, 0xcb,
+        0xfa, 0xb5, 0x4d, 0x07, 0xab, 0xd4, 0xc7, 0x0b,
+        0x6b, 0xd9, 0x6b, 0x6a, 0x6f, 0xb9, 0xde, 0x56,
+    };
+    manifest.elfMachine = code_object_fixture::ElfMachine;
+    manifest.elfType = code_object_fixture::ElfTypeDyn;
+    manifest.elfOsabi = code_object_fixture::ElfOsabiAmdgpuHsa;
+    manifest.elfAbiVersion = code_object_fixture::ElfAbiVersion;
+    manifest.elfFlags = code_object_fixture::ElfFlags;
+    manifest.gfxTarget = code_object_fixture::GfxTarget;
+    manifest.codeObjectVersion = code_object_fixture::CodeObjectVersion;
+    manifest.metadataMajor = code_object_fixture::MetadataMajor;
+    manifest.metadataMinor = code_object_fixture::MetadataMinor;
+    manifest.relocationCount = code_object_fixture::RelocationCount;
+    manifest.kernargSegmentSize = 280;
+    manifest.kernargSegmentAlign = 8;
+    manifest.maxFlatWorkgroupSize = 256;
+    manifest.wavefrontSize = 64;
+    manifest.sgprCount = 22;
+    manifest.vgprCount = 6;
+    manifest.descriptorSize = code_object_fixture::DescriptorBytes;
+    manifest.kernelCodeEntryByteOffset = 0x1100;
+    manifest.codeVirtualAddress = 0x1900;
+    manifest.codeFileOffset = 0x900;
+    manifest.codeSize = 0x78;
+    manifest.descriptorVirtualAddress = 0x800;
+    manifest.descriptorFileOffset = 0x800;
+    std::copy_n("gpuReadWrite", 12, manifest.kernelName.begin());
+    std::copy_n("gpuReadWrite.kd", 15, manifest.descriptorSymbol.begin());
+    require(image.size() == 5528, "gpuReadWrite fixture size");
+    std::copy_n(image.begin() + manifest.descriptorFileOffset,
+                protocol::CodeObjectDescriptorBytes,
+                manifest.descriptor.begin());
+    manifest.segments[0] = {1, 4, 0, 0, 0x840, 0x840, 0x1000};
+    manifest.segments[1] = {1, 5, 0x900, 0x1900, 0x480, 0x480, 0x1000};
+    manifest.segments[2] = {1, 6, 0xd80, 0x2d80, 0x70, 0x280, 0x1000};
+    return manifest;
+}
+
+struct StagedImage
+{
+    std::vector<uint8_t> image;
+    protocol::CodeObjectManifest manifest;
+};
+
+StagedImage
+stageImage(const std::vector<uint8_t> &image,
+           const protocol::CodeObjectManifest &manifest)
+{
+    HostGPUCodeObjectState state;
+    const HostGPUCodeObjectState::Owner owner{37, 1};
+    protocol::CodeObjectRequest begin;
+    begin.opcode = protocol::CodeObjectOpcode::Begin;
+    begin.manifest = manifest;
+    const auto beginResult = state.submit(owner, begin, 1);
+    require(beginResult.accepted, "native admission code-object begin");
+
+    uint64_t offset = 0;
+    for (uint32_t index = 0; index < manifest.chunkCount; ++index) {
+        protocol::CodeObjectRequest chunk;
+        chunk.opcode = protocol::CodeObjectOpcode::Chunk;
+        chunk.objectId = beginResult.response.objectId;
+        chunk.generation = beginResult.response.generation;
+        chunk.imageOffset = offset;
+        chunk.chunkIndex = index;
+        const auto count = static_cast<uint32_t>(std::min<uint64_t>(
+            manifest.imageSize - offset, protocol::CodeObjectChunkDataBytes));
+        chunk.byteCount = count;
+        std::copy_n(image.begin() + offset, count, chunk.chunkData.begin());
+        chunk.chunkCrc32c = protocol::crc32c(chunk.chunkData.data(), count);
+        const auto result = state.submit(owner, chunk, 2 + index);
+        require(result.accepted, "native admission code-object chunk");
+        offset += count;
+    }
+
+    protocol::CodeObjectRequest commit;
+    commit.opcode = protocol::CodeObjectOpcode::Commit;
+    commit.objectId = beginResult.response.objectId;
+    commit.generation = beginResult.response.generation;
+    commit.byteCount = manifest.imageSize;
+    commit.chunkIndex = manifest.chunkCount;
+    commit.commitSha256 = manifest.imageSha256;
+    const auto commitResult = state.submit(owner, commit, 4);
+    require(commitResult.committed, "native admission code-object commit");
+
+    StagedImage staged;
+    require(state.readCommittedImage(
+                owner, beginResult.response.objectId,
+                beginResult.response.generation, staged.image),
+            "native admission committed image");
+    const auto committedManifest = state.committedManifest(
+        owner, beginResult.response.objectId, beginResult.response.generation);
+    require(committedManifest.has_value(),
+            "native admission committed manifest");
+    staged.manifest = *committedManifest;
+    return staged;
+}
+
+struct AllocationLease
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+    Addr gpuVa = 0;
+    HostNativeMemoryContext::PageLease lease;
+};
+
+AllocationLease
+allocate(HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+         const HostGPUMemoryState::Owner &owner, uint64_t bytes,
+         uint64_t now)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Allocate;
+    request.byteCount = bytes;
+    request.argument = 4096;
+    const auto response = memory.allocate(owner, request, now);
+    require(response.status == protocol::Status::Ok,
+            "native admission allocation");
+    const auto lease = context.map(response.value0, bytes);
+    require(lease.has_value(), "native admission page map");
+    return {response.allocationId, response.generation, response.value0,
+            *lease};
+}
+
+void
+release(HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+        const HostGPUMemoryState::Owner &owner, const AllocationLease &value,
+        uint64_t now)
+{
+    require(context.unmap(value.lease), "native admission page unmap");
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Free;
+    request.allocationId = value.id;
+    request.generation = value.generation;
+    require(memory.free(owner, request, now).status == protocol::Status::Ok,
+            "native admission allocation free");
+}
+
+void
+runSelfTest(const std::vector<uint8_t> &image)
+{
+    const auto manifest = fixtureManifest(image);
+    require(HostGPUCodeObjectState::imageSha256(image) == manifest.imageSha256,
+            "native admission fixture SHA");
+    const auto staged = stageImage(image, manifest);
+
+    HostGPUMemoryState memory;
+    const HostGPUMemoryState::Owner owner{37, 1};
+    HostNativeMemoryContext context(memory, owner);
+    HostNativeCodeObjectMapper mapper(memory, context, owner);
+    const auto mapping = mapper.map(staged.image, staged.manifest);
+    require(mapping && mapping->valid(), "native admission PT_LOAD map");
+
+    const auto data = allocate(memory, context, owner, 4096, 10);
+    const auto kernarg = allocate(memory, context, owner, 4096, 11);
+    const auto packet = allocate(memory, context, owner, 4096, 12);
+    const auto signal = allocate(memory, context, owner, 4096, 13);
+    const uint64_t queueSignalValue = 1;
+    require(context.functionalWrite(
+                signal.gpuVa, &queueSignalValue, sizeof(queueSignalValue)),
+            "native admission signal initialize");
+
+    HostGPUQueueState queues;
+    const HostGPUQueueState::Owner queueOwner{
+        owner.fd, owner.clientGeneration};
+    protocol::Header header;
+    header.requestId = 501;
+    protocol::QueueRequest create;
+    create.opcode = protocol::QueueOpcode::Create;
+    create.arg0 = 4;
+    const auto created = queues.submit(queueOwner, header, create, 20);
+    require(!created.commandAccepted &&
+                created.response.status == protocol::Status::Ok,
+            "native admission queue register");
+
+    HostNativeDispatchAdmission admission;
+    HostNativeDispatchAdmission::Result result;
+    require(admission.admit(
+                *mapping, staged.manifest, context, packet.gpuVa,
+                kernarg.gpuVa, signal.gpuVa, data.gpuVa, data.gpuVa + 0x400,
+                data.gpuVa + 0x800,
+                static_cast<uint32_t>(created.response.queueId),
+                created.response.generation, 1, result),
+            admission.failure());
+    require(result.descriptorLoaded && result.descriptorEntryRelation &&
+                result.hiddenKernargPacked && result.aqlFieldsValid &&
+                result.hsaQueueEntryValid &&
+                result.lifecycleListenerContractSmoke &&
+                !result.kernelExecuted,
+            "native admission result flags");
+    require(context.functionalWrite(packet.gpuVa, result.aqlBytes.data(),
+                                    result.aqlBytes.size()),
+            "native admission packet ring write");
+    std::array<uint8_t, HostNativeDispatchAdmission::AqlPacketBytes> ring;
+    require(context.functionalRead(packet.gpuVa, ring.data(), ring.size()) &&
+                ring == result.aqlBytes,
+            "native admission packet ring read");
+
+    protocol::QueueRequest doorbell;
+    doorbell.opcode = protocol::QueueOpcode::Doorbell;
+    doorbell.queueId = created.response.queueId;
+    doorbell.generation = created.response.generation;
+    doorbell.sequence = 1;
+    doorbell.arg0 = static_cast<uint64_t>(protocol::QueueCommandKind::Noop);
+    const auto rung = queues.submit(queueOwner, header, doorbell, 21);
+    require(rung.commandAccepted &&
+                rung.response.status == protocol::Status::Ok,
+            "native admission queue ring");
+    const auto retired = queues.popReady(22);
+    require(retired && retired->queueId == created.response.queueId &&
+                retired->sequence == 1 && !queues.popReady(22),
+            "native admission queue retire");
+    protocol::QueueRequest destroy;
+    destroy.opcode = protocol::QueueOpcode::Destroy;
+    destroy.queueId = created.response.queueId;
+    destroy.generation = created.response.generation;
+    require(queues.submit(queueOwner, header, destroy, 23).response.status ==
+                protocol::Status::Ok,
+            "native admission queue destroy");
+
+    require(mapper.unmap(*mapping), "native admission PT_LOAD unmap");
+    release(memory, context, owner, signal, 24);
+    release(memory, context, owner, packet, 25);
+    release(memory, context, owner, kernarg, 26);
+    release(memory, context, owner, data, 27);
+}
+
+} // anonymous namespace
+} // namespace gem5::hostgpu
+
+int
+main(int argc, char **argv)
+{
+    try {
+        const auto image = gem5::hostgpu::readFixture(argc, argv);
+        gem5::hostgpu::runSelfTest(image);
+        std::cout
+            << "{\"schema\":\"gem5.host-native.dispatch-admission.v1\","
+               "\"staged_image_roundtrip\":true,"
+               "\"descriptor_loaded\":true,"
+               "\"descriptor_entry_relation\":true,"
+               "\"hidden_kernarg_280b\":true,"
+               "\"workgroup_size_x\":256,"
+               "\"grid_size_x\":1024,"
+               "\"hidden_block_count_x\":4,"
+               "\"aql_packet_64b\":true,"
+               "\"hsa_queue_entry_reused\":true,"
+               "\"hsa_queue_entry_getters\":true,"
+               "\"queue_control_registered\":true,"
+               "\"queue_control_doorbell_accepted\":true,"
+               "\"queue_control_doorbell_completed\":true,"
+               "\"lifecycle_listener_contract_smoke\":true,"
+               "\"adapter_null_legacy_preserved\":true,"
+               "\"hsa_queue_published\":false,"
+               "\"gpu_dispatcher_instantiated\":false,"
+               "\"aql_submitted\":false,"
+               "\"kernel_executed\":false,"
+               "\"cpu_fallback\":false,"
+               "\"vega_x86\":false,"
+               "\"gpu_pipeline_connected\":false,"
+               "\"blocker\":\"B0 admission only: no GPUDispatcher object, "
+               "HSAPP queue publish, CU memory, instruction fetch, AQL "
+               "submission, or Triton execution\"}\n";
+    } catch (const std::exception &error) {
+        std::cerr << "host-native dispatch admission self-test failed: "
+                  << error.what() << '\n';
+        return 1;
+    }
+    return 0;
+}

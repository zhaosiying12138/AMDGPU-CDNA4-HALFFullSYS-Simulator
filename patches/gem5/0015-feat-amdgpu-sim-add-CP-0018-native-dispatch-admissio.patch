+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Bounded native admission adapter for one pinned gfx950 image.
+ *
+ * It intentionally stops after packet/lifecycle admission.  The descriptor,
+ * kernarg and AQL bytes are materialized in HostNativeMemoryContext and an
+ * HSAQueueEntry is constructed for the existing dispatcher listener contract.
+ * No GPUDispatcher object, shader, CU, instruction decoder, or AQL submission
+ * is invoked by this adapter.
+ */
+class HostNativeDispatchAdmission
+{
+  public:
+    static constexpr size_t KernargBytes = 280;
+    static constexpr size_t AqlPacketBytes = 64;
+
+    struct Result
+    {
+        AMDKernelCode descriptor = {};
+        _hsa_dispatch_packet_t packet = {};
+        std::array<uint8_t, KernargBytes> kernarg = {};
+        std::array<uint8_t, AqlPacketBytes> aqlBytes = {};
+        Addr packetVa = 0;
+        Addr kernargVa = 0;
+        Addr completionSignalVa = 0;
+        uint32_t queueId = 0;
+        uint64_t queueGeneration = 0;
+        uint64_t queueSequence = 0;
+        bool descriptorLoaded = false;
+        bool descriptorEntryRelation = false;
+        bool hiddenKernargPacked = false;
+        bool aqlFieldsValid = false;
+        bool hsaQueueEntryValid = false;
+        bool lifecycleListenerContractSmoke = false;
+        bool kernelExecuted = false;
+        std::vector<std::string> listenerEvents;
+    };
+
+    /** Materialize and trace one dispatch using a previously mapped image. */
+    bool admit(const HostNativeCodeObjectMapper::Mapping &mapping,
+               const protocol::CodeObjectManifest &manifest,
+               HostNativeMemoryContext &context, Addr packetVa,
+               Addr kernargVa, Addr completionSignalVa, Addr inputVa,
+               Addr outputVa, Addr resultVa, uint32_t queueId,
+               uint64_t queueGeneration, uint64_t queueSequence,
+               Result &result);
+
+    const char *failure() const { return failureReason; }
+
+  private:
+    class LifecycleRecorder : public GPUDispatchLifecycleListener
+    {
+      public:
+        std::vector<std::string> events;
+
+        void hsaPacketFetched(Addr, uint32_t) override;
+        void commandProcessorSubmitted(const HSAQueueEntry &) override;
+        void gpuDispatcherStarted(const HSAQueueEntry &) override;
+        void hsaPacketRetired(const HSAQueueEntry &, int, int) override;
+    };
+
+    static void storeLe16(uint8_t *destination, uint16_t value);
+    static void storeLe32(uint8_t *destination, uint32_t value);
+    static void storeLe64(uint8_t *destination, uint64_t value);
+    static uint16_t loadLe16(const uint8_t *source);
+    static uint32_t loadLe32(const uint8_t *source);
+    static uint64_t loadLe64(const uint8_t *source);
+    static std::array<uint8_t, KernargBytes> packKernarg(
+        Addr inputVa, Addr outputVa, Addr resultVa);
+    void fail(const char *reason) { failureReason = reason; }
+
+    const char *failureReason = "none";
+};
+
+} // namespace hostgpu
+} // namespace gem5

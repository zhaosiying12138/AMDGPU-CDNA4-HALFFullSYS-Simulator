+
+constexpr uint16_t DispatchHeader = 0x1402;
+constexpr uint16_t DispatchSetup = 1;
+/* The locked RDC producer uses 256-item workgroups over 1024 work-items. */
+constexpr uint16_t WorkgroupX = 256;
+constexpr uint32_t GridX = 1024;
+constexpr uint32_t BlockCountX = GridX / WorkgroupX;
+
+} // anonymous namespace
+
+void
+HostNativeDispatchAdmission::LifecycleRecorder::hsaPacketFetched(
+    Addr, uint32_t)
+{
+    events.emplace_back("hsa_packet_fetched");
+}
+
+void
+HostNativeDispatchAdmission::LifecycleRecorder::
+commandProcessorSubmitted(const HSAQueueEntry &)
+{
+    events.emplace_back("command_processor_submitted");
+}
+
+void
+HostNativeDispatchAdmission::LifecycleRecorder::gpuDispatcherStarted(
+    const HSAQueueEntry &)
+{
+    events.emplace_back("gpu_dispatcher_started");
+}
+
+void
+HostNativeDispatchAdmission::LifecycleRecorder::hsaPacketRetired(
+    const HSAQueueEntry &, int, int)
+{
+    events.emplace_back("hsa_packet_retired");
+}
+
+void
+HostNativeDispatchAdmission::storeLe16(uint8_t *destination, uint16_t value)
+{
+    destination[0] = static_cast<uint8_t>(value);
+    destination[1] = static_cast<uint8_t>(value >> 8);
+}
+
+void
+HostNativeDispatchAdmission::storeLe32(uint8_t *destination, uint32_t value)
+{
+    for (size_t index = 0; index < sizeof(value); ++index)
+        destination[index] = static_cast<uint8_t>(value >> (index * 8));
+}
+
+void
+HostNativeDispatchAdmission::storeLe64(uint8_t *destination, uint64_t value)
+{
+    for (size_t index = 0; index < sizeof(value); ++index)
+        destination[index] = static_cast<uint8_t>(value >> (index * 8));
+}
+
+uint16_t
+HostNativeDispatchAdmission::loadLe16(const uint8_t *source)
+{
+    return static_cast<uint16_t>(source[0]) |
+        (static_cast<uint16_t>(source[1]) << 8);
+}
+
+uint32_t
+HostNativeDispatchAdmission::loadLe32(const uint8_t *source)
+{
+    uint32_t value = 0;
+    for (size_t index = 0; index < sizeof(value); ++index)
+        value |= static_cast<uint32_t>(source[index]) << (index * 8);
+    return value;
+}
+
+uint64_t
+HostNativeDispatchAdmission::loadLe64(const uint8_t *source)
+{
+    uint64_t value = 0;
+    for (size_t index = 0; index < sizeof(value); ++index)
+        value |= static_cast<uint64_t>(source[index]) << (index * 8);
+    return value;
+}
+
+std::array<uint8_t, HostNativeDispatchAdmission::KernargBytes>
+HostNativeDispatchAdmission::packKernarg(
+    Addr inputVa, Addr outputVa, Addr resultVa)
+{
+    std::array<uint8_t, KernargBytes> bytes = {};
+
+    /* Explicit gfx950 gpuReadWrite ABI offsets from the locked metadata. */
+    storeLe64(bytes.data() + 0x00, inputVa);
+    storeLe64(bytes.data() + 0x08, outputVa);
+    storeLe64(bytes.data() + 0x10, resultVa);
+    storeLe32(bytes.data() + 0x18, BlockCountX);
+    storeLe32(bytes.data() + 0x1c, 1);
+    storeLe32(bytes.data() + 0x20, 1);
+    storeLe16(bytes.data() + 0x24, WorkgroupX);
+    storeLe16(bytes.data() + 0x26, 1);
+    storeLe16(bytes.data() + 0x28, 1);
+    storeLe16(bytes.data() + 0x2a, 0);
+    storeLe16(bytes.data() + 0x2c, 0);
+    storeLe16(bytes.data() + 0x2e, 0);
+    storeLe64(bytes.data() + 0x40, 0);
+    storeLe64(bytes.data() + 0x48, 0);
+    storeLe64(bytes.data() + 0x50, 0);
+    storeLe16(bytes.data() + 0x58, 1);
+    return bytes;
+}
+
+bool
+HostNativeDispatchAdmission::admit(
+    const HostNativeCodeObjectMapper::Mapping &mapping,
+    const protocol::CodeObjectManifest &manifest,
+    HostNativeMemoryContext &context, Addr packetVa, Addr kernargVa,
+    Addr completionSignalVa, Addr inputVa, Addr outputVa, Addr resultVa,
+    uint32_t queueId, uint64_t queueGeneration, uint64_t queueSequence,
+    Result &result)
+{
+    failureReason = "none";
+    result = {};
+    result.packetVa = packetVa;
+    result.kernargVa = kernargVa;
+    result.completionSignalVa = completionSignalVa;
+    result.queueId = queueId;
+    result.queueGeneration = queueGeneration;
+    result.queueSequence = queueSequence;
+
+    if (!mapping.valid() || manifest.gfxTarget != 950 ||
+        manifest.relocationCount != 0 || manifest.descriptorSize != 64 ||
+        manifest.kernargSegmentSize != KernargBytes || packetVa == 0 ||
+        kernargVa == 0 || completionSignalVa == 0 || inputVa == 0 ||
+        outputVa == 0 || resultVa == 0 || queueId == 0 ||
+        queueGeneration == 0 ||
+        queueSequence == 0) {
+        fail("native admission precondition");
+        return false;
+    }
+
+    if (!context.functionalRead(
+            mapping.descriptorGpuVa, &result.descriptor,
+            sizeof(result.descriptor))) {
+        fail("descriptor functional read");
+        return false;
+    }
+    result.descriptorLoaded = true;
+
+    std::array<uint8_t, protocol::CodeObjectDescriptorBytes> descriptorBytes;
+    std::memcpy(descriptorBytes.data(), &result.descriptor,
+                descriptorBytes.size());
+    if (!std::equal(descriptorBytes.begin(), descriptorBytes.end(),
+                    manifest.descriptor.begin()) ||
+        loadLe32(descriptorBytes.data() + 8) !=
+            manifest.kernargSegmentSize ||
+        loadLe64(descriptorBytes.data() + 16) !=
+            static_cast<uint64_t>(manifest.kernelCodeEntryByteOffset)) {
+        fail("descriptor manifest mismatch");
+        return false;
+    }
+    result.descriptorEntryRelation = manifest.kernelCodeEntryByteOffset >= 0 &&
+        mapping.descriptorGpuVa + static_cast<Addr>(
+            manifest.kernelCodeEntryByteOffset) == mapping.entryGpuVa &&
+        mapping.entryGpuVa == mapping.codeGpuVa;
+    if (!result.descriptorEntryRelation) {
+        fail("descriptor entry relation");
+        return false;
+    }
+
+    result.kernarg = packKernarg(inputVa, outputVa, resultVa);
+    if (!context.functionalWrite(kernargVa, result.kernarg.data(),
+                                  result.kernarg.size())) {
+        fail("hidden kernarg write");
+        return false;
+    }
+    std::array<uint8_t, KernargBytes> kernargReadback = {};
+    if (!context.functionalRead(kernargVa, kernargReadback.data(),
+                                kernargReadback.size()) ||
+        kernargReadback != result.kernarg ||
+        loadLe64(result.kernarg.data()) != inputVa ||
+        loadLe64(result.kernarg.data() + 8) != outputVa ||
+        loadLe64(result.kernarg.data() + 0x10) != resultVa ||
+        loadLe32(result.kernarg.data() + 0x18) != BlockCountX ||
+        loadLe32(result.kernarg.data() + 0x1c) != 1 ||
+        loadLe32(result.kernarg.data() + 0x20) != 1 ||
+        loadLe16(result.kernarg.data() + 0x24) != WorkgroupX ||
+        loadLe16(result.kernarg.data() + 0x26) != 1 ||
+        loadLe16(result.kernarg.data() + 0x28) != 1 ||
+        loadLe16(result.kernarg.data() + 0x2a) != 0 ||
+        loadLe16(result.kernarg.data() + 0x2c) != 0 ||
+        loadLe16(result.kernarg.data() + 0x2e) != 0 ||
+        loadLe64(result.kernarg.data() + 0x40) != 0 ||
+        loadLe64(result.kernarg.data() + 0x48) != 0 ||
+        loadLe64(result.kernarg.data() + 0x50) != 0 ||
+        loadLe16(result.kernarg.data() + 0x58) != 1) {
+        fail("hidden kernarg ABI");
+        return false;
+    }
+    result.hiddenKernargPacked = true;
+
+    result.packet.header = DispatchHeader;
+    result.packet.setup = DispatchSetup;
+    result.packet.workgroup_size_x = WorkgroupX;
+    result.packet.workgroup_size_y = 1;
+    result.packet.workgroup_size_z = 1;
+    result.packet.grid_size_x = GridX;
+    result.packet.grid_size_y = 1;
+    result.packet.grid_size_z = 1;
+    result.packet.private_segment_size = manifest.privateSegmentFixedSize;
+    result.packet.group_segment_size = manifest.groupSegmentFixedSize;
+    result.packet.kernel_object = mapping.descriptorGpuVa;
+    result.packet.kernarg_address = kernargVa;
+    result.packet.completion_signal = completionSignalVa;
+    static_assert(sizeof(result.packet) == AqlPacketBytes);
+    std::memcpy(result.aqlBytes.data(), &result.packet,
+                result.aqlBytes.size());
+
+    _hsa_dispatch_packet_t packetReadback = {};
+    std::memcpy(&packetReadback, result.aqlBytes.data(),
+                result.aqlBytes.size());
+    result.aqlFieldsValid = packetReadback.header == DispatchHeader &&
+        packetReadback.setup == DispatchSetup &&
+        packetReadback.workgroup_size_x == WorkgroupX &&
+        packetReadback.grid_size_x == GridX &&
+        packetReadback.kernel_object == mapping.descriptorGpuVa &&
+        packetReadback.kernarg_address == kernargVa &&
+        packetReadback.completion_signal == completionSignalVa;
+    if (!result.aqlFieldsValid) {
+        fail("AQL field materialization");
+        return false;
+    }
+
+    HSAQueueEntry task(
+        "gpuReadWrite", queueId, 1, &result.packet, &result.descriptor,
+        packetVa, mapping.codeGpuVa, GfxVersion::gfx950);
+    result.hsaQueueEntryValid = task.kernelName() == "gpuReadWrite" &&
+        task.gfxVersion() == GfxVersion::gfx950 &&
+        task.wgSize(0) == WorkgroupX && task.wgSize(1) == 1 &&
+        task.wgSize(2) == 1 && task.gridSize(0) == GridX &&
+        task.gridSize(1) == 1 && task.gridSize(2) == 1 &&
+        task.numWg(0) == static_cast<int>(BlockCountX) &&
+        task.numWg(1) == 1 && task.numWg(2) == 1 &&
+        task.numWgTotal() == static_cast<int>(BlockCountX) &&
+        task.queueId() == queueId && task.dispatchId() == 1 &&
+        task.hostDispPktAddr() == packetVa &&
+        task.kernargAddr() == kernargVa &&
+        task.codeAddr() == mapping.codeGpuVa &&
+        task.completionSignal() == completionSignalVa;
+    if (!result.hsaQueueEntryValid) {
+        fail("HSAQueueEntry getters");
+        return false;
+    }
+
+    LifecycleRecorder recorder;
+    recorder.hsaPacketFetched(packetVa, queueId);
+    recorder.commandProcessorSubmitted(task);
+    recorder.gpuDispatcherStarted(task);
+    /* Retire is a trace-only lifecycle edge; no CU wave/store is emitted. */
+    recorder.hsaPacketRetired(task, 0, 0);
+    result.listenerEvents = std::move(recorder.events);
+    result.lifecycleListenerContractSmoke =
+        result.listenerEvents == std::vector<std::string>{
+            "hsa_packet_fetched", "command_processor_submitted",
+            "gpu_dispatcher_started", "hsa_packet_retired"};
+    result.kernelExecuted = false;
+    if (!result.lifecycleListenerContractSmoke) {
+        fail("lifecycle listener contract smoke");
+        return false;
+    }
+    return true;
+}
+
+} // namespace hostgpu
+} // namespace gem5

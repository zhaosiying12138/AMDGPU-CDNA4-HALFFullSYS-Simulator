--- a/src/dev/amdgpu/SConscript
+++ b/src/dev/amdgpu/SConscript
@@ -43,6 +43,18 @@ Executable('host_gpu_control_core',
            'host_gpu_queue_state.cc',
            'host_gpu_signal_state.cc')
 
+# A2 functional-parity harness: it reuses the CP13 pinned-dispatch state
+# machine and the sparse memory oracle, while the actual HSAPP/CP/dispatcher
+# pipeline remains behind its existing x86/Process/TLB boundary.
+Executable('host_gpu_native_fixture_core',
+           'host_gpu_native_fixture_main.cc',
+           'host_native_memory_context.cc',
+           'host_gpu_dispatch_state.cc',
+           'host_gpu_protocol.cc',
+           'host_gpu_memory_state.cc',
+           'host_gpu_queue_state.cc',
+           'host_gpu_signal_state.cc')
+
 if not env['CONF']['USE_X86_ISA']:
     Return()
 

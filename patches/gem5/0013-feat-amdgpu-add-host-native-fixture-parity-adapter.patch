+#ifndef __DEV_AMDGPU_HOST_NATIVE_MEMORY_CONTEXT_HH__
+#define __DEV_AMDGPU_HOST_NATIVE_MEMORY_CONTEXT_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+#include "base/types.hh"
+#include "dev/amdgpu/host_gpu_memory_state.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Host-owned functional address-space adapter for the extracted control core.
+ *
+ * HostGPUMemoryState remains the allocation/chunk oracle.  This class only
+ * adds GPU-VA range resolution, page-granular lifetime leases, and functional
+ * byte access.  It has no Process, ThreadContext, MMU, or gem5 System input.
+ */
+class HostNativeMemoryContext
+{
+  public:
+    struct PageLease
+    {
+        uint64_t token = 0;
+        uint64_t allocationId = 0;
+        uint64_t generation = 0;
+        Addr firstPage = 0;
+        uint64_t pageCount = 0;
+        Addr address = 0;
+        uint64_t byteCount = 0;
+
+        bool valid() const { return token != 0 && pageCount != 0; }
+    };
+
+    HostNativeMemoryContext(
+        HostGPUMemoryState &memory, const HostGPUMemoryState::Owner &owner,
+        uint64_t pageBytes = 4096);
+    ~HostNativeMemoryContext();
+
+    HostNativeMemoryContext(const HostNativeMemoryContext &) = delete;
+    HostNativeMemoryContext &operator=(
+        const HostNativeMemoryContext &) = delete;
+
+    std::optional<PageLease> map(Addr address, uint64_t byteCount);
+    bool unmap(const PageLease &lease);
+
+    bool functionalRead(
+        Addr address, uint64_t byteCount,
+        std::vector<uint8_t> &destination,
+        uint64_t dispatchRequestId = 0) const;
+    bool functionalRead(
+        Addr address, void *destination, uint64_t byteCount,
+        uint64_t dispatchRequestId = 0) const;
+    bool functionalWrite(
+        Addr address, const std::vector<uint8_t> &source,
+        uint64_t dispatchRequestId = 0);
+    bool functionalWrite(
+        Addr address, const void *source, uint64_t byteCount,
+        uint64_t dispatchRequestId = 0);
+
+    size_t leaseCount() const { return leases.size(); }
+    uint64_t pageBytes() const { return pageSize; }
+    void clear();
+
+  private:
+    struct ResolvedRange
+    {
+        HostGPUMemoryState::AllocationView allocation;
+        uint64_t offset = 0;
+    };
+
+    bool resolveRange(
+        Addr address, uint64_t byteCount, ResolvedRange &resolved) const;
+    bool coveredByLease(
+        const ResolvedRange &resolved, Addr address,
+        uint64_t byteCount) const;
+    bool takeToken(uint64_t &token);
+
+    HostGPUMemoryState &memory;
+    HostGPUMemoryState::Owner owner;
+    uint64_t pageSize;
+    uint64_t nextToken = 1;
+    bool tokensExhausted = false;
+    std::unordered_map<uint64_t, PageLease> leases;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_NATIVE_MEMORY_CONTEXT_HH__

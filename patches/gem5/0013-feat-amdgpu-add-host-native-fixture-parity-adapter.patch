+#include "dev/amdgpu/host_native_memory_context.hh"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <new>
+#include <stdexcept>
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+HostNativeMemoryContext::HostNativeMemoryContext(
+    HostGPUMemoryState &memoryState,
+    const HostGPUMemoryState::Owner &memoryOwner, uint64_t pageBytes)
+    : memory(memoryState), owner(memoryOwner), pageSize(pageBytes)
+{
+    if (pageSize == 0 || (pageSize & (pageSize - 1)) != 0)
+        throw std::invalid_argument("host-native page size must be a power of two");
+}
+
+HostNativeMemoryContext::~HostNativeMemoryContext()
+{
+    clear();
+}
+
+bool
+HostNativeMemoryContext::takeToken(uint64_t &token)
+{
+    if (tokensExhausted || nextToken == 0)
+        return false;
+    token = nextToken;
+    if (nextToken == std::numeric_limits<uint64_t>::max()) {
+        tokensExhausted = true;
+    } else {
+        ++nextToken;
+    }
+    return true;
+}
+
+bool
+HostNativeMemoryContext::resolveRange(
+    Addr address, uint64_t byteCount, ResolvedRange &resolved) const
+{
+    if (byteCount == 0 ||
+        address > std::numeric_limits<Addr>::max() - (byteCount - 1)) {
+        return false;
+    }
+    for (const auto &allocation : memory.allocationsForOwner(owner)) {
+        if (address < allocation.gpuVa)
+            continue;
+        const uint64_t offset = address - allocation.gpuVa;
+        if (offset <= allocation.size &&
+            byteCount <= allocation.size - offset) {
+            resolved = {allocation, offset};
+            return true;
+        }
+    }
+    return false;
+}
+
+bool
+HostNativeMemoryContext::coveredByLease(
+    const ResolvedRange &resolved, Addr address, uint64_t byteCount) const
+{
+    if (byteCount == 0 ||
+        address > std::numeric_limits<Addr>::max() - (byteCount - 1)) {
+        return false;
+    }
+    const Addr end = address + byteCount;
+    for (const auto &entry : leases) {
+        const auto &lease = entry.second;
+        if (lease.allocationId != resolved.allocation.allocationId ||
+            lease.generation != resolved.allocation.generation) {
+            continue;
+        }
+        if (lease.pageCount > std::numeric_limits<Addr>::max() / pageSize)
+            continue;
+        const Addr leaseEnd = lease.firstPage +
+            static_cast<Addr>(lease.pageCount * pageSize);
+        if (leaseEnd < lease.firstPage)
+            continue;
+        if (address >= lease.firstPage && end <= leaseEnd)
+            return true;
+    }
+    return false;
+}
+
+std::optional<HostNativeMemoryContext::PageLease>
+HostNativeMemoryContext::map(Addr address, uint64_t byteCount)
+{
+    ResolvedRange resolved;
+    if (!resolveRange(address, byteCount, resolved))
+        return std::nullopt;
+
+    const Addr firstPage = address & ~(static_cast<Addr>(pageSize) - 1);
+    const Addr lastAddress = address + byteCount - 1;
+    const Addr lastPage = lastAddress &
+        ~(static_cast<Addr>(pageSize) - 1);
+    if (lastPage < firstPage)
+        return std::nullopt;
+    const uint64_t pageCount =
+        (lastPage - firstPage) / pageSize + 1;
+    uint64_t token = 0;
+    if (!takeToken(token) ||
+        !memory.retainFunctionalPage(
+            owner, resolved.allocation.allocationId,
+            resolved.allocation.generation, token)) {
+        return std::nullopt;
+    }
+
+    PageLease lease{
+        token, resolved.allocation.allocationId,
+        resolved.allocation.generation, firstPage, pageCount,
+        address, byteCount};
+    try {
+        leases.emplace(token, lease);
+    } catch (const std::bad_alloc &) {
+        memory.releaseFunctionalPage(
+            owner, resolved.allocation.allocationId,
+            resolved.allocation.generation, token);
+        return std::nullopt;
+    }
+    return lease;
+}
+
+bool
+HostNativeMemoryContext::unmap(const PageLease &lease)
+{
+    const auto found = leases.find(lease.token);
+    if (found == leases.end())
+        return false;
+    const auto &current = found->second;
+    if (current.allocationId != lease.allocationId ||
+        current.generation != lease.generation ||
+        current.firstPage != lease.firstPage ||
+        current.pageCount != lease.pageCount ||
+        current.address != lease.address ||
+        current.byteCount != lease.byteCount) {
+        return false;
+    }
+    if (!memory.releaseFunctionalPage(
+            owner, current.allocationId, current.generation, current.token)) {
+        return false;
+    }
+    leases.erase(found);
+    return true;
+}
+
+bool
+HostNativeMemoryContext::functionalRead(
+    Addr address, uint64_t byteCount, std::vector<uint8_t> &destination,
+    uint64_t dispatchRequestId) const
+{
+    ResolvedRange resolved;
+    if (!resolveRange(address, byteCount, resolved) ||
+        !coveredByLease(resolved, address, byteCount)) {
+        destination.clear();
+        return false;
+    }
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::CopyD2H;
+    request.allocationId = resolved.allocation.allocationId;
+    request.generation = resolved.allocation.generation;
+    request.offset = resolved.offset;
+    request.byteCount = byteCount;
+    return memory.copyToHost(
+               owner, request, destination, 0, dispatchRequestId).status ==
+        protocol::Status::Ok;
+}
+
+bool
+HostNativeMemoryContext::functionalRead(
+    Addr address, void *destination, uint64_t byteCount,
+    uint64_t dispatchRequestId) const
+{
+    if (!destination)
+        return false;
+    std::vector<uint8_t> bytes;
+    if (!functionalRead(address, byteCount, bytes, dispatchRequestId))
+        return false;
+    std::memcpy(destination, bytes.data(), bytes.size());
+    return true;
+}
+
+bool
+HostNativeMemoryContext::functionalWrite(
+    Addr address, const std::vector<uint8_t> &source,
+    uint64_t dispatchRequestId)
+{
+    ResolvedRange resolved;
+    if (!resolveRange(address, source.size(), resolved) ||
+        !coveredByLease(resolved, address, source.size())) {
+        return false;
+    }
+    return memory.functionalWriteBytes(
+               owner, resolved.allocation.allocationId,
+               resolved.allocation.generation, resolved.offset,
+               source, dispatchRequestId).status == protocol::Status::Ok;
+}
+
+bool
+HostNativeMemoryContext::functionalWrite(
+    Addr address, const void *source, uint64_t byteCount,
+    uint64_t dispatchRequestId)
+{
+    if (!source || byteCount == 0 ||
+        byteCount > std::numeric_limits<size_t>::max()) {
+        return false;
+    }
+    std::vector<uint8_t> bytes;
+    try {
+        bytes.assign(static_cast<const uint8_t *>(source),
+                     static_cast<const uint8_t *>(source) + byteCount);
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    return functionalWrite(address, bytes, dispatchRequestId);
+}
+
+void
+HostNativeMemoryContext::clear()
+{
+    for (const auto &entry : leases) {
+        const auto &lease = entry.second;
+        memory.releaseFunctionalPage(
+            owner, lease.allocationId, lease.generation, lease.token);
+    }
+    leases.clear();
+}
+
+} // namespace hostgpu
+} // namespace gem5

+protocol::MemoryResponse
+HostGPUMemoryState::functionalWriteBytes(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t offset, const std::vector<uint8_t> &source,
+    uint64_t dispatchRequestId)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::CopyH2D;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    request.offset = offset;
+    request.byteCount = source.size();
+    request.argument = protocol::crc32c(source.data(), source.size());
+    return copyFromHost(
+        owner, request, source, 0, dispatchRequestId);
+}
+
+bool
+HostGPUMemoryState::retainFunctionalPage(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t token)
+{
+    if (token == 0)
+        return false;
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr)
+        return false;
+    return allocation->functionalPageTokens.insert(token).second;
+}
+
+bool
+HostGPUMemoryState::releaseFunctionalPage(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t token)
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr || token == 0)
+        return false;
+    return allocation->functionalPageTokens.erase(token) == 1;
+}

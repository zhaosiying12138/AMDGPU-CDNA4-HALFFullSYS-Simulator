+void
+require(bool condition, const char *message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+protocol::Header
+fixtureHeader(uint64_t requestId)
+{
+    protocol::Header header;
+    header.requestId = requestId;
+    header.connectionId = 0x1020304050607080ULL;
+    header.jobEpoch = 0x0102030405060708ULL;
+    for (size_t index = 0; index < header.daemonUuid.size(); ++index)
+        header.daemonUuid[index] = static_cast<uint8_t>(index + 1);
+    return header;
+}
+
+std::vector<uint8_t>
+goldenInput()
+{
+    return {dispatch_fixture::GoldenInput.begin(),
+            dispatch_fixture::GoldenInput.end()};
+}
+
+std::vector<uint8_t>
+goldenOutput()
+{
+    return {dispatch_fixture::GoldenOutput.begin(),
+            dispatch_fixture::GoldenOutput.end()};
+}
+
+struct FixtureHarness
+{
+    HostGPUDispatchState::Owner owner{17, 1};
+    HostGPUQueueState queues;
+    HostGPUMemoryState memory;
+    HostGPUSignalState signals;
+    HostGPUDispatchState dispatch{queues, memory, signals};
+    HostNativeMemoryContext context{memory, {owner.fd, owner.clientGeneration}};
+    HostNativeMemoryContext::PageLease inputLease;
+    HostNativeMemoryContext::PageLease outputLease;
+    protocol::Header header = fixtureHeader(100);
+    protocol::DispatchRequest request;
+
+    FixtureHarness()
+    {
+        const HostGPUQueueState::Owner queueOwner{
+            owner.fd, owner.clientGeneration};
+        const HostGPUMemoryState::Owner memoryOwner{
+            owner.fd, owner.clientGeneration};
+        const HostGPUSignalState::Owner signalOwner{
+            owner.fd, owner.clientGeneration};
+
+        protocol::QueueRequest createQueue;
+        createQueue.opcode = protocol::QueueOpcode::Create;
+        createQueue.arg0 = 1;
+        const auto queue = queues.submit(queueOwner, header, createQueue, 1);
+        require(queue.response.status == protocol::Status::Ok,
+                "fixture queue create");
+
+        protocol::MemoryRequest allocate;
+        allocate.opcode = protocol::MemoryOpcode::Allocate;
+        allocate.byteCount = 4096;
+        allocate.argument = 4096;
+        const auto input = memory.allocate(memoryOwner, allocate, 2);
+        const auto output = memory.allocate(memoryOwner, allocate, 3);
+        require(input.status == protocol::Status::Ok &&
+                    output.status == protocol::Status::Ok,
+                "fixture memory allocate");
+
+        const auto inputLeaseResult = context.map(
+            input.value0, dispatch_fixture::BufferBytes);
+        const auto outputLeaseResult = context.map(
+            output.value0, dispatch_fixture::BufferBytes);
+        require(inputLeaseResult && outputLeaseResult,
+                "fixture page map");
+        inputLease = *inputLeaseResult;
+        outputLease = *outputLeaseResult;
+
+        const auto inputBytes = goldenInput();
+        require(context.functionalWrite(input.value0, inputBytes),
+                "fixture input write");
+        std::vector<uint8_t> initialOutput;
+        require(context.functionalRead(
+                    output.value0, dispatch_fixture::BufferBytes,
+                    initialOutput) &&
+                    std::all_of(
+                        initialOutput.begin(), initialOutput.end(),
+                        [](uint8_t byte) { return byte == 0; }),
+                "fixture output zero");
+
+        protocol::SignalRequest createSignal;
+        createSignal.opcode = protocol::SignalOpcode::Create;
+        createSignal.value = 1;
+        const auto signal = signals.submit(
+            signalOwner, header, createSignal, 4);
+        require(signal.status == protocol::Status::Ok,
+                "fixture signal create");
+
+        protocol::SignalRequest wait;
+        wait.opcode = protocol::SignalOpcode::Wait;
+        wait.signalId = signal.signalId;
+        wait.generation = signal.generation;
+        wait.sequence = 1;
+        wait.value = 0;
+        wait.condition = protocol::SignalCondition::Equal;
+        protocol::Header waitHeader = header;
+        waitHeader.requestId = 99;
+        const auto waiting = signals.submit(
+            signalOwner, waitHeader, wait, 5);
+        require(waiting.status == protocol::Status::Ok && waiting.ready == 0,
+                "fixture signal wait");
+
+        request.queueId = queue.response.queueId;
+        request.queueGeneration = queue.response.generation;
+        request.queueSequence = 1;
+        request.fixtureId = protocol::PinnedDispatchFixtureId;
+        request.inputAllocationId = input.allocationId;
+        request.inputGeneration = input.generation;
+        request.outputAllocationId = output.allocationId;
+        request.outputGeneration = output.generation;
+        request.signalId = signal.signalId;
+        request.signalGeneration = signal.generation;
+        request.expectedSignalValue = 0;
+        request.fixtureManifestSha256 = protocol::PinnedDispatchManifestSha256;
+    }
+
+    void
+    finish()
+    {
+        const HostGPUQueueState::Owner queueOwner{
+            owner.fd, owner.clientGeneration};
+        const HostGPUMemoryState::Owner memoryOwner{
+            owner.fd, owner.clientGeneration};
+        const HostGPUSignalState::Owner signalOwner{
+            owner.fd, owner.clientGeneration};
+
+        require(dispatch.pending() == std::nullopt,
+                "fixture dispatch still pending");
+        require(context.unmap(inputLease) && context.unmap(outputLease),
+                "fixture page unmap");
+
+        protocol::MemoryRequest freeInput;
+        freeInput.opcode = protocol::MemoryOpcode::Free;
+        freeInput.allocationId = request.inputAllocationId;
+        freeInput.generation = request.inputGeneration;
+        protocol::MemoryRequest freeOutput = freeInput;
+        freeOutput.allocationId = request.outputAllocationId;
+        freeOutput.generation = request.outputGeneration;
+        require(memory.free(memoryOwner, freeInput, 24).status ==
+                    protocol::Status::Ok &&
+                    memory.free(memoryOwner, freeOutput, 24).status ==
+                    protocol::Status::Ok,
+                "fixture memory free");
+
+        protocol::SignalRequest destroySignal;
+        destroySignal.opcode = protocol::SignalOpcode::Destroy;
+        destroySignal.signalId = request.signalId;
+        destroySignal.generation = request.signalGeneration;
+        require(signals.submit(
+                    signalOwner, fixtureHeader(103), destroySignal, 24).status ==
+                    protocol::Status::Ok,
+                "fixture signal destroy");
+
+        protocol::QueueRequest destroyQueue;
+        destroyQueue.opcode = protocol::QueueOpcode::Destroy;
+        destroyQueue.queueId = request.queueId;
+        destroyQueue.generation = request.queueGeneration;
+        require(queues.submit(
+                    queueOwner, fixtureHeader(104), destroyQueue, 24)
+                        .response.status == protocol::Status::Ok,
+                "fixture queue destroy");
+    }
+};
+
+void
+runFixtureParity()
+{
+    require(code_object_fixture::Images.size() == 2 &&
+                code_object_fixture::GfxTarget == 950 &&
+                !code_object_fixture::Gem5IsaSupported,
+            "gfx950 fixture provenance");
+    require(dispatch_fixture::CodeImage.size() == 108,
+            "gfx950 fixture code image");
+    const auto packet = dispatch_fixture::materializeAql();
+    require(protocol::crc32c(packet.data(), packet.size()) ==
+                dispatch_fixture::PacketCrc32c,
+            "fixture AQL oracle");
+
+    FixtureHarness fixture;
+
+    auto wrongLease = fixture.inputLease;
+    wrongLease.address += 1;
+    require(!fixture.context.unmap(wrongLease) &&
+                fixture.context.leaseCount() == 2,
+            "fixture rejects mismatched lease unmap");
+
+    std::vector<uint8_t> crossAllocationRead;
+    const auto crossAllocationWrite = std::vector<uint8_t>(32, 0xa5);
+    const Addr inputEnd = fixture.inputLease.address + 4096 - 16;
+    require(!fixture.context.functionalRead(
+                inputEnd, crossAllocationWrite.size(), crossAllocationRead) &&
+                !fixture.context.functionalWrite(
+                    inputEnd, crossAllocationWrite),
+            "fixture rejects cross-allocation functional access");
+
+    protocol::MemoryRequest probeAllocate;
+    probeAllocate.opcode = protocol::MemoryOpcode::Allocate;
+    probeAllocate.byteCount = 4096;
+    probeAllocate.argument = 4096;
+    const auto probe = fixture.memory.allocate(
+        {fixture.owner.fd, fixture.owner.clientGeneration}, probeAllocate, 6);
+    require(probe.status == protocol::Status::Ok,
+            "fixture unmapped probe allocate");
+    std::vector<uint8_t> unmappedRead;
+    const auto unmappedWrite = std::vector<uint8_t>(64, 0x3c);
+    require(!fixture.context.functionalRead(
+                probe.value0, unmappedWrite.size(), unmappedRead) &&
+                !fixture.context.functionalWrite(probe.value0, unmappedWrite),
+            "fixture rejects unmapped functional access");
+    protocol::MemoryRequest freeProbe;
+    freeProbe.opcode = protocol::MemoryOpcode::Free;
+    freeProbe.allocationId = probe.allocationId;
+    freeProbe.generation = probe.generation;
+    require(fixture.memory.free(
+                {fixture.owner.fd, fixture.owner.clientGeneration},
+                freeProbe, 7).status == protocol::Status::Ok,
+            "fixture unmapped probe free");
+
+    const auto admission = fixture.dispatch.admit(
+        fixture.owner, fixture.header, fixture.request, 10,
+        dispatch_fixture::PacketVa);
+    require(admission.admitted && admission.response.status == protocol::Status::Ok,
+            "fixture dispatch admission");
+    require(admission.response.inputGpuVa != 0 &&
+                admission.response.outputGpuVa != 0,
+            "fixture dispatch virtual addresses");
+
+    const auto kernarg = dispatch_fixture::materializeKernarg(
+        admission.response.inputGpuVa, admission.response.outputGpuVa);
+    require(kernarg.size() == 16, "fixture kernarg materialization");
+
+    require(fixture.dispatch.markGpuIssued(
+                dispatch_fixture::PacketVa,
+                dispatch_fixture::InternalQueueGeneration),
+            "fixture GPU issue state");
+    require(fixture.dispatch.markCommandProcessorSubmitted(
+                dispatch_fixture::PacketVa, 42),
+            "fixture CP submission state");
+    require(fixture.dispatch.markDispatcherStarted(
+                dispatch_fixture::PacketVa, 42, 12),
+            "fixture dispatcher state");
+
+    const auto output = goldenOutput();
+    require(!fixture.context.functionalWrite(
+                admission.response.outputGpuVa, output, 999),
+            "fixture rejects foreign functional writer");
+    require(fixture.context.functionalWrite(
+                admission.response.outputGpuVa, output,
+                fixture.header.requestId),
+            "fixture functional XOR oracle write");
+    std::vector<uint8_t> observed;
+    require(fixture.context.functionalRead(
+                admission.response.outputGpuVa,
+                dispatch_fixture::BufferBytes, observed,
+                fixture.header.requestId) && observed == output,
+            "fixture functional XOR oracle read");
+    require(protocol::crc32c(observed.data(), observed.size()) ==
+                dispatch_fixture::GoldenOutputCrc32c,
+            "fixture output CRC oracle");
+
+    const auto completion = fixture.dispatch.retire(
+        dispatch_fixture::PacketVa, 42,
+        dispatch_fixture::GoldenOutputCrc32c, 20, 20);
+    require(completion && completion->response.outputCrc32c ==
+                dispatch_fixture::GoldenOutputCrc32c,
+            "fixture dispatch retire state");
+    require(!fixture.signals.popReady(20),
+            "fixture signal ordering");
+    const auto signalCompletion = fixture.signals.popReady(21);
+    require(signalCompletion && fixture.signals.complete(*signalCompletion),
+            "fixture signal completion");
+    require(fixture.dispatch.completeRetired(*completion),
+            "fixture dispatch completion state");
+
+    protocol::MemoryRequest free;
+    free.opcode = protocol::MemoryOpcode::Free;
+    free.allocationId = fixture.request.outputAllocationId;
+    free.generation = fixture.request.outputGeneration;
+    require(fixture.memory.free(
+                {fixture.owner.fd, fixture.owner.clientGeneration}, free, 22)
+                .status == protocol::Status::Busy,
+            "fixture mapped output lifetime");
+
+    protocol::MemoryRequest lifetimeAllocate;
+    lifetimeAllocate.opcode = protocol::MemoryOpcode::Allocate;
+    lifetimeAllocate.byteCount = 4096;
+    lifetimeAllocate.argument = 4096;
+    const auto lifetime = fixture.memory.allocate(
+        {fixture.owner.fd, fixture.owner.clientGeneration},
+        lifetimeAllocate, 23);
+    require(lifetime.status == protocol::Status::Ok,
+            "fixture lifetime allocation");
+    HostNativeMemoryContext lifetimeContext(
+        fixture.memory,
+        {fixture.owner.fd, fixture.owner.clientGeneration});
+    const auto lifetimeLease = lifetimeContext.map(
+        lifetime.value0, dispatch_fixture::BufferBytes);
+    require(lifetimeLease.has_value(), "fixture lifetime page map");
+    protocol::MemoryRequest freeLifetime = freeProbe;
+    freeLifetime.allocationId = lifetime.allocationId;
+    freeLifetime.generation = lifetime.generation;
+    require(fixture.memory.free(
+                {fixture.owner.fd, fixture.owner.clientGeneration},
+                freeLifetime, 24).status == protocol::Status::Busy,
+            "fixture functional page lifetime busy");
+    fixture.memory.disconnect(
+        {fixture.owner.fd, fixture.owner.clientGeneration});
+    require(fixture.memory.allocationView(
+                {fixture.owner.fd, fixture.owner.clientGeneration},
+                lifetime.allocationId, lifetime.generation).has_value(),
+            "fixture disconnect retains leased allocation");
+    lifetimeContext.clear();
+    require(fixture.memory.allocationView(
+                {fixture.owner.fd, fixture.owner.clientGeneration},
+                lifetime.allocationId, lifetime.generation).has_value(),
+            "fixture clear releases token without reclaim");
+    require(fixture.memory.free(
+                {fixture.owner.fd, fixture.owner.clientGeneration},
+                freeLifetime, 25).status == protocol::Status::Ok,
+            "fixture clear permits lifetime free");
+
+    fixture.finish();
+}
+
+} // namespace
+} // namespace gem5::hostgpu
+
+int
+main()
+{
+    try {
+        gem5::hostgpu::runFixtureParity();
+    } catch (const std::exception &error) {
+        std::cerr << "host_gpu_native_fixture_core self-test failed: "
+                  << error.what() << '\n';
+        return 1;
+    }
+
+    constexpr char output[] =
+        "{\"schema\":\"gem5.host-native.fixture-parity.v1\","
+        "\"functional_parity\":true,\"fixture_oracle\":true,"
+        "\"memory_context\":true,\"dispatch_state_machine\":true,"
+        "\"gfx950_fixture\":true,\"negative_access_checks\":true,"
+        "\"functional_page_lifetime\":true,"
+        "\"kernel_executed\":false,"
+        "\"cpu_fallback\":false,\"vega_x86\":false,"
+        "\"gpu_pipeline_connected\":false,"
+        "\"blocker\":\"HSAPacketProcessor/GPUDispatcher/ComputeUnit "
+        "still require x86 Process/ThreadContext/SE TLB\"}";
+    std::cout << output << '\n';
+    return 0;
+}

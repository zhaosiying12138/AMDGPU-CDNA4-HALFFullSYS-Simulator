     EXPECT_EQ(inst->getOperandSize(1), 4);
 }
 
+TEST(GpuDecoderTest, Gfx950DsAccBitDecodesLikeAccClearTwin)
+{
+    // Live word from an aiter composable-kernel GEMM on gfx950:
+    // DS encoding with ACC (bit 25) set, OP=0x3c (ds_read_u16),
+    // offset0=0x44. The ACC=0 twin clears bit 25 only; both must
+    // decode to the same opcode because the DS sub-decode keys on
+    // the full 8-bit OP field and ACC only redirects data operands.
+    static constexpr uint32_t AccWord = 0xda784400;
+    static constexpr uint32_t NoAccWord = AccWord & ~(1u << 25);
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    for (const uint32_t word0 : {AccWord, NoAccWord}) {
+        InstFormat words[2] = {};
+        words[0].imm_u32 = word0;
+        words[1].imm_u32 = 0x00000000;
+        SCOPED_TRACE(word0);
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->opcode(), "ds_read_u16");
+        EXPECT_EQ(inst->instSize(), 8);
+        EXPECT_TRUE(inst->isMemRef());
+        EXPECT_TRUE(inst->isLoad());
+        EXPECT_TRUE(inst->isGroupSeg());
+        EXPECT_EQ(inst->getNumOperands(), 2);
+        EXPECT_EQ(inst->getOperandSize(0), 4);
+        EXPECT_EQ(inst->getOperandSize(1), 2);
+    }
+}
+

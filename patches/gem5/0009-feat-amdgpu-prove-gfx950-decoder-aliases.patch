+constexpr uint32_t FixtureFmamkWord = 0x2e040c80;
+constexpr uint32_t FixtureLiteral = 0x4f800000;
+
+uint32_t
+vop2Word(uint32_t opcode, uint32_t vdst)
+{
+    return (opcode << 25) | (vdst << 17) | (6u << 9) | 128u;
+}
+
+void
+expectDecode(Decoder &decoder, uint32_t word, const std::string &mnemonic,
+             uint32_t primary, bool f32 = true, bool mad = true,
+             bool literal = true)
+{
+    InstFormat words[2] = {};
+    words[0].imm_u32 = word;
+    words[1].imm_u32 = FixtureLiteral;
+
+    SCOPED_TRACE(testing::Message() << "word=0x" << std::hex << word);
+    EXPECT_EQ((word >> 23) & 0x1ffu, primary);
+
+    std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), mnemonic);
+    EXPECT_EQ(inst->instSize(), literal ? 8 : 4);
+    if (literal)
+        EXPECT_EQ(inst->srcLiteral(), FixtureLiteral);
+    EXPECT_EQ(inst->disassemble().rfind(mnemonic, 0), 0);
+    EXPECT_TRUE(inst->isALU());
+    EXPECT_EQ(inst->isF32(), f32);
+    EXPECT_EQ(inst->isMAD(), mad);
+}
+
+TEST(GpuDecoderTest, GfxVersionOverrideIsolation)
+{
+    EXPECT_EQ((FixtureFmamkWord >> 25) & 0x3fu, 23);
+    EXPECT_EQ((FixtureFmamkWord >> 23) & 0x1ffu, 92);
+
+    Decoder gfx950;
+    gfx950.setGfxVersion(GfxVersion::gfx950);
+    for (uint32_t high = 0; high < 4; ++high) {
+        const uint32_t vdst = (high << 6) | 2u;
+        expectDecode(gfx950, vop2Word(23, vdst), "v_fmamk_f32",
+                     92 + high);
+        expectDecode(gfx950, vop2Word(24, vdst), "v_fmaak_f32",
+                     96 + high);
+    }
+
+    Decoder gfx942;
+    gfx942.setGfxVersion(GfxVersion::gfx942);
+    expectDecode(gfx942, FixtureFmamkWord, "v_fmamk_f32", 92);
+
+    // A later gfx90a decoder must not inherit the CDNA overrides. Its own
+    // opcode 4 override remains active, while the 0x17/0x18 slots reset.
+    Decoder gfx90a;
+    gfx90a.setGfxVersion(GfxVersion::gfx90a);
+    expectDecode(gfx90a, vop2Word(4, 2), "v_fmac_f64", 16, false, false,
+                 false);
+    for (uint32_t high = 0; high < 4; ++high) {
+        const uint32_t vdst = (high << 6) | 2u;
+        expectDecode(gfx90a, vop2Word(23, vdst), "v_madmk_f32",
+                     92 + high);
+        expectDecode(gfx90a, vop2Word(24, vdst), "v_madak_f32",
+                     96 + high);
+    }
+}

     {
     } // ~Decoder
 
+    void Decoder::resetGfxVersionOverrides()
+    {
+        // Keep the shared table at the baseline before applying a new ISA.
+        for (int i = 16; i < 20; ++i)
+            tableDecodePrimary[i] = &Decoder::decode_OP_VOP2__V_MUL_LEGACY_F32;
+        for (int i = 92; i < 96; ++i)
+            tableDecodePrimary[i] = &Decoder::decode_OP_VOP2__V_MADMK_F32;
+        for (int i = 96; i < 100; ++i)
+            tableDecodePrimary[i] = &Decoder::decode_OP_VOP2__V_MADAK_F32;
+    }
+
     void Decoder::fixupGfx90a()
     {
         tableDecodePrimary[16] = &Decoder::decode_OP_VOP2__V_FMAC_F64;
@@ -58,15 +69,34 @@ namespace VegaISA
         tableDecodePrimary[19] = &Decoder::decode_OP_VOP2__V_FMAC_F64;
     }
 
+    void Decoder::fixupGfx940()
+    {
+        // CDNA3/CDNA4 replace the gfx9 VOP2 slots with literal FMA forms.
+        // Each opcode occupies four primary entries because VDST[7:6] is
+        // part of the primary table index.
+        tableDecodePrimary[92] = &Decoder::decode_OP_VOP2__V_FMAMK_F32;
+        tableDecodePrimary[93] = &Decoder::decode_OP_VOP2__V_FMAMK_F32;
+        tableDecodePrimary[94] = &Decoder::decode_OP_VOP2__V_FMAMK_F32;
+        tableDecodePrimary[95] = &Decoder::decode_OP_VOP2__V_FMAMK_F32;
+        tableDecodePrimary[96] = &Decoder::decode_OP_VOP2__V_FMAAK_F32;
+        tableDecodePrimary[97] = &Decoder::decode_OP_VOP2__V_FMAAK_F32;
+        tableDecodePrimary[98] = &Decoder::decode_OP_VOP2__V_FMAAK_F32;
+        tableDecodePrimary[99] = &Decoder::decode_OP_VOP2__V_FMAAK_F32;
+    }
+
     void Decoder::setGfxVersion(GfxVersion gfxVersion)
     {
         // Some ISA have recycled opcodes and are using those going forward.
         // Here we replace those entries in the decoder table.
+        resetGfxVersionOverrides();
         if (gfxVersion == GfxVersion::gfx90a) {
             fixupGfx90a();
         } else if (gfxVersion == GfxVersion::gfx942) {
             fixupGfx90a();
-            // No further changes beyond changes in gfx90a
+            fixupGfx940();
+        } else if (gfxVersion == GfxVersion::gfx950) {
+            fixupGfx90a();
+            fixupGfx940();
         }
     }
 

+float
+bf16ToFloat(const uint8_t *data)
+{
+    uint32_t bits = 0;
+    uint16_t half = 0;
+    std::memcpy(&half, data, sizeof(half));
+    bits = static_cast<uint32_t>(half) << 16;
+    float value = 0;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+uint16_t
+floatToBf16(float value)
+{
+    uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    const uint32_t rounding = 0x7fff + ((bits >> 16) & 1);
+    return static_cast<uint16_t>((bits + rounding) >> 16);
+}
+
+float
+roundToBf16(float value)
+{
+    const uint32_t bits = static_cast<uint32_t>(floatToBf16(value)) << 16;
+    float rounded = 0;
+    std::memcpy(&rounded, &bits, sizeof(rounded));
+    return rounded;
+}

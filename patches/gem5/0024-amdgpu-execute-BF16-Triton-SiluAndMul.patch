+                                         : bits(src0Value, 31, 0);
+            upper_dword = (opsel_hi & 2) ? bits(src1Value, 63, 32)
+                                         : bits(src1Value, 31, 0);
+
+            float dword2 = vop_semantics::packedAddF32(
+                vop_semantics::floatFromBits(lower_dword),
+                vop_semantics::floatFromBits(upper_dword), neg_hi,
+                instData.CLMP);
+
+            uint32_t result1 = vop_semantics::floatToBits(dword1);
+            uint32_t result2 = vop_semantics::floatToBits(dword2);
 
             vdst[lane] = (static_cast<uint64_t>(result2) << 32) | result1;
         }

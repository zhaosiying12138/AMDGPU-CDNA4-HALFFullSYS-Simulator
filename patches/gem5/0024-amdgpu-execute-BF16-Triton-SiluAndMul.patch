+bool
+tritonSiluAndMulInputsSupported(
+    const std::array<std::vector<uint8_t>, 3> &before, uint32_t rows)
+{
+    using namespace triton_silu_and_mul_fixture;
+    if (rows != DecodeRows && rows != PrefillRows)
+        return false;
+    const uint64_t bytes = siluBufferBytes(rows);
+    if (std::any_of(before.begin(), before.end(),
+                    [bytes](const auto &buffer) {
+                        return buffer.size() != bytes;
+                    }))
+        return false;
+    for (uint32_t row = 0; row < rows; ++row) {
+        const uint64_t inputBase = static_cast<uint64_t>(row) *
+            InputElementsPerRow;
+        for (uint32_t col = 0; col < OutputElementsPerRow; ++col) {
+            const float gate = bf16ToFloat(
+                before[0].data() + (inputBase + col) * 2);
+            const float up = bf16ToFloat(
+                before[0].data() +
+                    (inputBase + OutputElementsPerRow + col) * 2);
+            if (!std::isfinite(gate) || !std::isfinite(up))
+                return false;
+            const float expected = gate /
+                (1.0f + std::exp(-gate)) * up;
+            if (!std::isfinite(expected) ||
+                !std::isfinite(roundToBf16(expected))) {
+                return false;
+            }
+        }
+    }
+    return true;
+}

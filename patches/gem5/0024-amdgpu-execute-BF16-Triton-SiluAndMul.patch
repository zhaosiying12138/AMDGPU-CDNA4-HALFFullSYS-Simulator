@@ -76,6 +76,17 @@ TEST(MxfpTest, MxBf16Test)
     EXPECT_EQ(errors, 0);
 }
 
+TEST(MxfpTest, MxBf16PackedStorageOrder)
+{
+    using T = gem5::AMDGPU::mxbfloat16;
+
+    const T lower(1.0f);
+    const T upper(-2.0f);
+    EXPECT_EQ(lower.data, 0x3f800000u);
+    EXPECT_EQ(upper.data, 0xc0000000u);
+    EXPECT_EQ(upper.data | (lower.data >> 16), 0xc0003f80u);
+}
+
 TEST(MxfpTest, MxFp16Test)
 {
     using T = gem5::AMDGPU::mxfloat16;

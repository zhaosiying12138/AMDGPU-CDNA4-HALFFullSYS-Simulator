+TEST(GpuDecoderTest, Cp30PackedBf16OperandLayout)
+{
+    InstFormat words[2] = {};
+    words[0].imm_u32 = 0xd2680000;
+    words[1].imm_u32 = 0x00020300;
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "v_cvt_pk_bf16_f32");
+    EXPECT_EQ(inst->getNumOperands(), 3);
+    EXPECT_EQ(inst->numSrcRegOperands(), 2);
+    EXPECT_EQ(inst->numDstRegOperands(), 1);
+    for (int operand = 0; operand < 3; ++operand)
+        EXPECT_EQ(inst->getOperandSize(operand), 4);
+}
+
+TEST(GpuDecoderTest, Cp30DivideFmasF32OperandLayout)
+{
+    InstFormat words[2] = {};
+    words[0].imm_u32 = 0xd1e20002;
+    words[1].imm_u32 = 0x04763311;
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+    ASSERT_NE(inst, nullptr);
+    EXPECT_EQ(inst->opcode(), "v_div_fmas_f32");
+    EXPECT_TRUE(inst->isF32());
+    EXPECT_TRUE(inst->isFMA());
+    EXPECT_EQ(inst->getNumOperands(), 5);
+    EXPECT_EQ(inst->getOperandSize(0), 4);
+    EXPECT_EQ(inst->getOperandSize(1), 4);
+    EXPECT_EQ(inst->getOperandSize(2), 4);
+    EXPECT_EQ(inst->getOperandSize(3), 8);
+    EXPECT_EQ(inst->getOperandSize(4), 4);
+}
+
 } // anonymous namespace
 } // namespace VegaISA
 } // namespace gem5

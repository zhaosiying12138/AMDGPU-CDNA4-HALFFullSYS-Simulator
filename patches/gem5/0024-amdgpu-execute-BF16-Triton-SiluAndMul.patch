+#ifndef __ARCH_AMDGPU_VEGA_INSTS_VOP_SEMANTICS_HH__
+#define __ARCH_AMDGPU_VEGA_INSTS_VOP_SEMANTICS_HH__
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include "arch/amdgpu/common/dtype/mxfp_types.hh"
+
+namespace gem5
+{
+
+namespace VegaISA
+{
+
+namespace vop_semantics
+{
+
+inline float
+applyOutputModifiers(float value, unsigned omod, bool clamp)
+{
+    switch (omod) {
+      case 0:
+        break;
+      case 1:
+        value *= 2.0f;
+        break;
+      case 2:
+        value *= 4.0f;
+        break;
+      case 3:
+        value *= 0.5f;
+        break;
+      default:
+        std::abort();
+    }
+
+    return clamp ? std::clamp(value, 0.0f, 1.0f) : value;
+}
+
+inline float
+applySourceModifiers(float value, unsigned abs, unsigned neg, unsigned bit)
+{
+    if (abs & bit)
+        value = std::fabs(value);
+    if (neg & bit)
+        value = -value;
+    return value;
+}
+
+inline float
+divFmasF32(float src0, float src1, float src2, bool scale,
+           unsigned omod, bool clamp)
+{
+    float value = std::fma(src0, src1, src2);
+    if (scale)
+        value = std::ldexp(value, 32);
+    return applyOutputModifiers(value, omod, clamp);
+}
+
+inline float
+packedFmaF32(float src0, float src1, float src2, unsigned neg, bool clamp)
+{
+    src0 = applySourceModifiers(src0, 0, neg, 1);
+    src1 = applySourceModifiers(src1, 0, neg, 2);
+    src2 = applySourceModifiers(src2, 0, neg, 4);
+    return applyOutputModifiers(std::fma(src0, src1, src2), 0, clamp);
+}
+
+inline float
+packedMulF32(float src0, float src1, unsigned neg, bool clamp)
+{
+    src0 = applySourceModifiers(src0, 0, neg, 1);
+    src1 = applySourceModifiers(src1, 0, neg, 2);
+    return applyOutputModifiers(src0 * src1, 0, clamp);
+}
+
+inline float
+packedAddF32(float src0, float src1, unsigned neg, bool clamp)
+{
+    src0 = applySourceModifiers(src0, 0, neg, 1);
+    src1 = applySourceModifiers(src1, 0, neg, 2);
+    return applyOutputModifiers(src0 + src1, 0, clamp);
+}
+
+inline float
+floatFromBits(uint32_t value)
+{
+    float result = 0.0f;
+    std::memcpy(&result, &value, sizeof(result));
+    return result;
+}
+
+inline uint32_t
+floatToBits(float value)
+{
+    uint32_t result = 0;
+    std::memcpy(&result, &value, sizeof(result));
+    return result;
+}
+
+template<typename T>
+inline uint32_t
+packF32Pair(float src0, float src1, unsigned abs, unsigned neg,
+            unsigned omod, bool clamp)
+{
+    src0 = applySourceModifiers(src0, abs, neg, 1);
+    src1 = applySourceModifiers(src1, abs, neg, 2);
+    src0 = applyOutputModifiers(src0, omod, clamp);
+    src1 = applyOutputModifiers(src1, omod, clamp);
+
+    const T lower(src0);
+    const T upper(src1);
+    return (upper.data & 0xffff0000u) | (lower.data >> 16);
+}
+
+inline uint32_t
+packF16F32(float src0, float src1, unsigned abs, unsigned neg,
+           unsigned omod, bool clamp)
+{
+    return packF32Pair<AMDGPU::mxfloat16>(
+        src0, src1, abs, neg, omod, clamp);
+}
+
+inline uint32_t
+packBf16F32(float src0, float src1, unsigned abs, unsigned neg,
+            unsigned omod, bool clamp)
+{
+    return packF32Pair<AMDGPU::mxbfloat16>(
+        src0, src1, abs, neg, omod, clamp);
+}
+
+} // namespace vop_semantics
+} // namespace VegaISA
+} // namespace gem5
+
+#endif // __ARCH_AMDGPU_VEGA_INSTS_VOP_SEMANTICS_HH__

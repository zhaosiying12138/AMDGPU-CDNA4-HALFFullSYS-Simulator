+#include <gtest/gtest.h>
+
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+#include "arch/amdgpu/vega/insts/vop_semantics.hh"
+
+namespace gem5
+{
+
+namespace VegaISA
+{
+
+namespace
+{
+
+using namespace vop_semantics;
+
+TEST(VopSemanticsTest, PackedFmaUsesPerSourceNegBits)
+{
+    EXPECT_FLOAT_EQ(packedFmaF32(2.0f, 4.0f, 3.0f, 0, false), 11.0f);
+    EXPECT_FLOAT_EQ(packedFmaF32(2.0f, 4.0f, 3.0f, 1, false), -5.0f);
+    EXPECT_FLOAT_EQ(packedFmaF32(2.0f, 4.0f, 3.0f, 2, false), -5.0f);
+    EXPECT_FLOAT_EQ(packedFmaF32(2.0f, 4.0f, 3.0f, 4, false), 5.0f);
+}
+
+TEST(VopSemanticsTest, PackedF32OperationsClampAfterArithmetic)
+{
+    EXPECT_FLOAT_EQ(packedFmaF32(2.0f, 4.0f, 3.0f, 0, true), 1.0f);
+    EXPECT_FLOAT_EQ(packedMulF32(-2.0f, 4.0f, 0, true), 0.0f);
+    EXPECT_FLOAT_EQ(packedAddF32(0.75f, 0.75f, 0, true), 1.0f);
+    EXPECT_FLOAT_EQ(packedAddF32(-0.75f, 0.25f, 0, true), 0.0f);
+    EXPECT_FLOAT_EQ(packedAddF32(0.25f, 0.5f, 0, true), 0.75f);
+}
+
+TEST(VopSemanticsTest, DivideFmasScalesThenAppliesOutputModifiers)
+{
+    EXPECT_FLOAT_EQ(divFmasF32(2.0f, 3.0f, 4.0f, false, 0, false),
+                    10.0f);
+    EXPECT_FLOAT_EQ(divFmasF32(2.0f, 3.0f, 4.0f, false, 3, false),
+                    5.0f);
+    EXPECT_FLOAT_EQ(divFmasF32(2.0f, 3.0f, 4.0f, false, 1, true),
+                    1.0f);
+    EXPECT_FLOAT_EQ(divFmasF32(0.0f, 0.0f, 1.0f, true, 3, false),
+                    std::ldexp(1.0f, 31));
+    EXPECT_FLOAT_EQ(
+        divFmasF32(0.0f, 0.0f, std::ldexp(1.0f, -40), true, 0, false),
+        std::ldexp(1.0f, -8));
+}
+
+TEST(VopSemanticsTest, PackedConversionsApplyModifiersBeforeNarrowing)
+{
+    const float halfMinSubnormalBeforeScale = std::ldexp(1.0f, -25);
+    EXPECT_EQ(packF16F32(
+                  halfMinSubnormalBeforeScale, 0.0f, 0, 0, 1, false),
+              0x00000001u);
+    EXPECT_EQ(packBf16F32(1.0f, -2.0f, 0, 0, 0, false),
+              0xc0003f80u);
+    EXPECT_EQ(packBf16F32(-2.0f, 2.0f, 1, 2, 0, true),
+              0x00003f80u);
+}
+
+TEST(VopSemanticsTest, PackedBf16PreservesSpecialValues)
+{
+    const uint32_t packed = packBf16F32(
+        std::numeric_limits<float>::infinity(),
+        -std::numeric_limits<float>::infinity(), 0, 0, 0, false);
+    EXPECT_EQ(packed, 0xff807f80u);
+}
+
+} // anonymous namespace
+} // namespace VegaISA
+} // namespace gem5

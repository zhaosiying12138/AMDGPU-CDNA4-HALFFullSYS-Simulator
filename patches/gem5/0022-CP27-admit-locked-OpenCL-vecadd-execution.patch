     }
 }
 
+TEST(GpuDecoderTest, Cp27OpenClVecAddLockedIsa)
+{
+    struct ExpectedInstruction
+    {
+        uint32_t offset;
+        uint32_t size;
+        const char *mnemonic;
+    };
+    static constexpr std::array<ExpectedInstruction, 28> Expected = {{
+        {0, 8, "s_load_dword"},
+        {8, 4, "s_nop"},
+        {12, 8, "s_load_dword"},
+        {20, 8, "s_load_dwordx2"},
+        {28, 4, "v_mov_b32"},
+        {32, 4, "s_mov_b32"},
+        {36, 4, "s_mov_b32"},
+        {40, 4, "s_waitcnt"},
+        {44, 8, "s_and_b32"},
+        {52, 4, "s_mul_i32"},
+        {56, 4, "v_add_u32"},
+        {60, 8, "v_lshl_add_u64"},
+        {68, 4, "v_cmp_gt_u64"},
+        {72, 4, "s_and_saveexec_b64"},
+        {76, 4, "s_cbranch_execz"},
+        {80, 8, "s_load_dwordx4"},
+        {88, 8, "s_load_dwordx2"},
+        {96, 8, "v_lshlrev_b64"},
+        {104, 4, "s_waitcnt"},
+        {108, 8, "v_lshl_add_u64"},
+        {116, 8, "v_lshl_add_u64"},
+        {124, 8, "flat_load_dword"},
+        {132, 8, "flat_load_dword"},
+        {140, 8, "v_lshl_add_u64"},
+        {148, 4, "s_waitcnt"},
+        {152, 4, "v_add_f32"},
+        {156, 8, "flat_store_dword"},
+        {164, 4, "s_endpgm"},
+    }};
+
+    Decoder decoder;
+    decoder.setGfxVersion(GfxVersion::gfx950);
+    for (const auto &expected : Expected) {
+        InstFormat words[2] = {};
+        ASSERT_LE(expected.offset + expected.size,
+                  hostgpu::opencl_vecadd_fixture::KernelCode.size());
+        std::memcpy(
+            words,
+            hostgpu::opencl_vecadd_fixture::KernelCode.data() +
+                expected.offset,
+            expected.size);
+        std::unique_ptr<GPUStaticInst> inst(decoder.decode(words));
+        SCOPED_TRACE(testing::Message() << "offset=" << expected.offset);
+        ASSERT_NE(inst, nullptr);
+        EXPECT_EQ(inst->instSize(), expected.size);
+        EXPECT_EQ(inst->opcode(), expected.mnemonic);
+    }
+}

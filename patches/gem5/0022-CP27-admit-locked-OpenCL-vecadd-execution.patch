+        std::memcpy(
+            &right, before[1].data() + index * sizeof(float), sizeof(right));
+        const float expected = left + right;
+        if (!std::isfinite(left) || !std::isfinite(right) ||
+            !std::isfinite(expected)) {
+            return false;
+        }
+    }
+    return true;
+}

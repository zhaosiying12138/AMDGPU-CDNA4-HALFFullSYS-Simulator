+{
+    outputCrc32c = 0;
+    if (!openClVecAddInputsSupported(before, elementCount) ||
+        after[0] != before[0] || after[1] != before[1] ||
+        after[2].size() != before[2].size()) {
+        return false;
+    }
+    for (uint32_t index = 0; index < elementCount; ++index) {
+        float left = 0;
+        float right = 0;

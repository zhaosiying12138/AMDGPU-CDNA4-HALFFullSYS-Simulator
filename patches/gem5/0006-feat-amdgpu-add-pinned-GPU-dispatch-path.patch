+    store64(payload, 48, response.inputAllocationId);
+    store64(payload, 56, response.inputGeneration);
+    store64(payload, 64, response.outputAllocationId);
+    store64(payload, 72, response.outputGeneration);
+    store64(payload, 80, response.signalId);
+    store64(payload, 88, response.signalGeneration);
+    if (response.status == Status::Ok) {
+        store64(payload, 96, response.traceId);
+        store64(payload, 104, response.inputGpuVa);

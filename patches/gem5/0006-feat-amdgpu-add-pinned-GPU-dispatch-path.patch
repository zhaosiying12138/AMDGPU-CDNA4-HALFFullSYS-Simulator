+#ifndef __DEV_AMDGPU_HOST_GPU_DISPATCH_STATE_HH__
+#define __DEV_AMDGPU_HOST_GPU_DISPATCH_STATE_HH__
+
+#include <cstdint>
+#include <optional>
+
+#include "base/types.hh"
+#include "dev/amdgpu/host_gpu_memory_state.hh"
+#include "dev/amdgpu/host_gpu_protocol.hh"
+#include "dev/amdgpu/host_gpu_queue_state.hh"
+#include "dev/amdgpu/host_gpu_signal_state.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/** Atomic admission and callback correlation for the one pinned dispatch. */
+class HostGPUDispatchState
+{
+  public:
+    struct Owner
+    {
+        int fd = -1;
+        uint64_t clientGeneration = 0;
+
+        bool operator==(const Owner &other) const
+        {
+            return fd == other.fd &&
+                clientGeneration == other.clientGeneration;
+        }
+    };
+
+    struct Pending
+    {
+        Owner owner;
+        protocol::Header header;
+        protocol::DispatchRequest request;
+        protocol::DispatchResponse response;
+        Addr packetVa = 0;
+        uint64_t internalQueueGeneration = 0;
+        int gpuTaskId = -1;
+        bool gpuIssued = false;
+        bool ownerConnected = true;
+        bool retired = false;
+    };
+
+    struct Decision
+    {
+        protocol::DispatchResponse response;
+        bool admitted = false;
+    };
+
+    struct Completion
+    {
+        Owner owner;
+        protocol::Header header;
+        protocol::DispatchResponse response;
+    };
+
+    HostGPUDispatchState(
+        HostGPUQueueState &queueState, HostGPUMemoryState &memoryState,
+        HostGPUSignalState &signalState);
+
+    Decision admit(
+        const Owner &owner, const protocol::Header &header,
+        const protocol::DispatchRequest &request, uint64_t now,
+        Addr packetVa);
+    bool markGpuIssued(Addr packetVa, uint64_t internalQueueGeneration);
+    bool rollbackGpuIssue(Addr packetVa, uint64_t internalQueueGeneration);
+    bool cancelUnissued();
+    bool markCommandProcessorSubmitted(Addr packetVa, int gpuTaskId);
+    bool markDispatcherStarted(
+        Addr packetVa, int gpuTaskId, uint64_t startTick);
+    std::optional<Completion> retire(
+        Addr packetVa, int gpuTaskId, uint32_t outputCrc32c,
+        uint64_t endTick, uint64_t retireTick);
+    bool markPhysicalRetiredWithoutCompletion(Addr packetVa, int gpuTaskId);
+    bool completeRetired(const Completion &completion);
+    bool retireAbandoned(Addr packetVa, int gpuTaskId);
+    void disconnect(const Owner &owner);
+    void clear();
+
+    const std::optional<Pending> &pending() const { return pendingDispatch; }
+
+  private:
+    static protocol::DispatchResponse failureResponse(
+        const protocol::DispatchRequest &request, protocol::Status status);
+    static HostGPUQueueState::Owner queueOwner(const Owner &owner);
+    static HostGPUMemoryState::Owner memoryOwner(const Owner &owner);
+    static HostGPUSignalState::Owner signalOwner(const Owner &owner);
+    bool preconditionsMatch(const Owner &owner,
+                            const protocol::DispatchRequest &request) const;
+    bool pinResources(const Owner &owner, const protocol::Header &header,
+                      const protocol::DispatchRequest &request);
+    void releaseResources(const Pending &pending, bool rollbackQueue = false);
+    bool takeTraceId(uint64_t &traceId);
+
+    HostGPUQueueState &queues;
+    HostGPUMemoryState &memory;
+    HostGPUSignalState &signals;
+    std::optional<Pending> pendingDispatch;
+    uint64_t nextTraceId = 0x5452434500000001ULL;
+    bool traceIdsExhausted = false;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_DISPATCH_STATE_HH__

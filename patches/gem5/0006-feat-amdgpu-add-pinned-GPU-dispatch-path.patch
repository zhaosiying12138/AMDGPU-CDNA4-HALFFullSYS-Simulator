+HostGPUDispatchState::HostGPUDispatchState(
+    HostGPUQueueState &queueState, HostGPUMemoryState &memoryState,
+    HostGPUSignalState &signalState)
+    : queues(queueState), memory(memoryState), signals(signalState)
+{
+}
+
+protocol::DispatchResponse
+HostGPUDispatchState::failureResponse(
+    const protocol::DispatchRequest &request, protocol::Status status)
+{
+    protocol::DispatchResponse response;
+    response.status = status;
+    response.opcode = request.opcode;
+    response.queueId = request.queueId;
+    response.queueGeneration = request.queueGeneration;
+    response.queueSequence = request.queueSequence;
+    response.fixtureId = request.fixtureId;
+    response.inputAllocationId = request.inputAllocationId;
+    response.inputGeneration = request.inputGeneration;
+    response.outputAllocationId = request.outputAllocationId;
+    response.outputGeneration = request.outputGeneration;
+    response.signalId = request.signalId;
+    response.signalGeneration = request.signalGeneration;
+    return response;
+}
+
+HostGPUQueueState::Owner
+HostGPUDispatchState::queueOwner(const Owner &owner)
+{
+    return {owner.fd, owner.clientGeneration};
+}
+
+HostGPUMemoryState::Owner
+HostGPUDispatchState::memoryOwner(const Owner &owner)
+{
+    return {owner.fd, owner.clientGeneration};
+}
+
+HostGPUSignalState::Owner
+HostGPUDispatchState::signalOwner(const Owner &owner)
+{
+    return {owner.fd, owner.clientGeneration};
+}
+
+bool
+HostGPUDispatchState::preconditionsMatch(
+    const Owner &owner, const protocol::DispatchRequest &request) const
+{
+    std::vector<uint8_t> input;
+    std::vector<uint8_t> output;
+    if (!memory.readBytes(
+            memoryOwner(owner), request.inputAllocationId,
+            request.inputGeneration, 0, dispatch_fixture::BufferBytes,
+            input) ||
+        !memory.readBytes(
+            memoryOwner(owner), request.outputAllocationId,
+            request.outputGeneration, 0, dispatch_fixture::BufferBytes,
+            output)) {
+        return false;
+    }
+    return std::equal(input.begin(), input.end(),
+                      dispatch_fixture::GoldenInput.begin()) &&
+        std::all_of(output.begin(), output.end(),
+                    [](uint8_t byte) { return byte == 0; });
+}
+
+bool
+HostGPUDispatchState::pinResources(
+    const Owner &owner, const protocol::Header &header,
+    const protocol::DispatchRequest &request)
+{
+    const auto qOwner = queueOwner(owner);
+    const auto mOwner = memoryOwner(owner);
+    const auto sOwner = signalOwner(owner);
+    if (!queues.pinPinnedDispatch(
+            qOwner, request.queueId, request.queueGeneration,
+            request.queueSequence, header.requestId)) {
+        return false;
+    }
+    if (!memory.pinPinnedDispatchAllocation(
+            mOwner, request.inputAllocationId, request.inputGeneration,
+            header.requestId)) {
+        queues.releasePinnedDispatch(
+            qOwner, request.queueId, request.queueGeneration,
+            header.requestId);
+        return false;
+    }
+    if (!memory.pinPinnedDispatchAllocation(
+            mOwner, request.outputAllocationId, request.outputGeneration,
+            header.requestId)) {
+        memory.releasePinnedDispatchAllocation(
+            mOwner, request.inputAllocationId, request.inputGeneration,
+            header.requestId);
+        queues.releasePinnedDispatch(
+            qOwner, request.queueId, request.queueGeneration,
+            header.requestId);
+        return false;
+    }
+    if (!signals.pinPinnedDispatchSignal(
+            sOwner, request.signalId, request.signalGeneration,
+            header.requestId)) {
+        memory.releasePinnedDispatchAllocation(
+            mOwner, request.outputAllocationId, request.outputGeneration,
+            header.requestId);
+        memory.releasePinnedDispatchAllocation(
+            mOwner, request.inputAllocationId, request.inputGeneration,
+            header.requestId);
+        queues.releasePinnedDispatch(
+            qOwner, request.queueId, request.queueGeneration,
+            header.requestId);
+        return false;
+    }
+    return true;
+}
+
+void
+HostGPUDispatchState::releaseResources(
+    const Pending &pending, bool rollbackQueue)
+{
+    const auto &request = pending.request;
+    const auto requestId = pending.header.requestId;
+    if (rollbackQueue) {
+        queues.cancelPinnedDispatch(
+            queueOwner(pending.owner), request.queueId,
+            request.queueGeneration, request.queueSequence, requestId);
+    } else {
+        queues.releasePinnedDispatch(
+            queueOwner(pending.owner), request.queueId,
+            request.queueGeneration, requestId);
+    }
+    memory.releasePinnedDispatchAllocation(
+        memoryOwner(pending.owner), request.inputAllocationId,
+        request.inputGeneration, requestId);
+    memory.releasePinnedDispatchAllocation(
+        memoryOwner(pending.owner), request.outputAllocationId,
+        request.outputGeneration, requestId);
+    signals.releasePinnedDispatchSignal(
+        signalOwner(pending.owner), request.signalId,
+        request.signalGeneration, requestId);
+}

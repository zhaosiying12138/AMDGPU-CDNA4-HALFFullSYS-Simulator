+std::string
+HostGPUBridge::makeDispatchTraceRecord(
+    const char *event, uint64_t simTick, const protocol::Header &header,
+    const protocol::DispatchResponse &response,
+    const std::string &eventFields) const
+{
+    std::ostringstream stream;
+    stream << "{\"schema\":\"amdgpu-sim.cp8-dispatch-trace.v1\""
+           << ",\"event\":\"" << event << "\""
+           << ",\"sim_tick\":" << simTick
+           << ",\"trace_id\":" << response.traceId
+           << ",\"request_id\":" << header.requestId
+           << ",\"fixture_id\":" << response.fixtureId
+           << ",\"fixture_manifest_sha256\":\""
+           << dispatch_fixture::ManifestSha256Hex << "\""
+           << ",\"code_image_sha256\":\""
+           << dispatch_fixture::CodeImageSha256Hex << "\""
+           << ",\"aql_template_sha256\":\""
+           << dispatch_fixture::AqlTemplateSha256Hex << "\""
+           << ",\"materialized_aql_sha256\":\""
+           << dispatch_fixture::MaterializedAqlSha256Hex << "\""
+           << ",\"queue_id\":" << response.queueId
+           << ",\"queue_generation\":" << response.queueGeneration
+           << ",\"queue_sequence\":" << response.queueSequence
+           << ",\"input_allocation_id\":"
+           << response.inputAllocationId
+           << ",\"input_generation\":" << response.inputGeneration
+           << ",\"output_allocation_id\":"
+           << response.outputAllocationId
+           << ",\"output_generation\":" << response.outputGeneration
+           << ",\"signal_id\":" << response.signalId
+           << ",\"signal_generation\":" << response.signalGeneration
+           << eventFields << "}\n";
+    return stream.str();
+}
+
+HostGPUBridge::DispatchTraceWriteResult
+HostGPUBridge::writeDispatchTraceBatch(
+    const std::vector<std::string> &records)
+{
+    if (!dispatchEnabled || dispatchTraceFd < 0 || records.empty())
+        return DispatchTraceWriteResult::RollbackFailed;
+    const off_t originalEnd = ::lseek(dispatchTraceFd, 0, SEEK_END);
+    if (originalEnd < 0)
+        return DispatchTraceWriteResult::RollbackFailed;
+    std::string batch;
+    try {
+        size_t total = 0;
+        for (const auto &record : records) {
+            if (record.size() > std::numeric_limits<size_t>::max() - total)
+                return DispatchTraceWriteResult::RolledBack;
+            total += record.size();
+        }
+        batch.reserve(total);
+        for (const auto &record : records)
+            batch += record;
+    } catch (const std::bad_alloc &) {
+        return DispatchTraceWriteResult::RolledBack;
+    }
+
+    size_t offset = 0;
+    while (offset < batch.size()) {
+        const ssize_t written = ::write(
+            dispatchTraceFd, batch.data() + offset, batch.size() - offset);
+        if (written < 0 && errno == EINTR)
+            continue;
+        if (written <= 0)
+            break;
+        offset += static_cast<size_t>(written);
+    }
+    if (offset == batch.size() && ::fdatasync(dispatchTraceFd) == 0)
+        return DispatchTraceWriteResult::Ok;
+
+    const bool truncated = ::ftruncate(dispatchTraceFd, originalEnd) == 0;
+    const bool synchronized = truncated && ::fdatasync(dispatchTraceFd) == 0;
+    const bool repositioned = synchronized &&
+        ::lseek(dispatchTraceFd, 0, SEEK_END) == originalEnd;
+    return repositioned ? DispatchTraceWriteResult::RolledBack :
+        DispatchTraceWriteResult::RollbackFailed;
+}
+
+bool
+HostGPUBridge::writeDispatchTrace(
+    const char *event, uint64_t simTick, const protocol::Header &header,
+    const protocol::DispatchResponse &response,
+    const std::string &eventFields)
+{
+    return writeDispatchTraceBatch({makeDispatchTraceRecord(
+        event, simTick, header, response, eventFields)}) ==
+        DispatchTraceWriteResult::Ok;
+}

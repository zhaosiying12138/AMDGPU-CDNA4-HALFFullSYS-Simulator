+void
+HostGPUBridge::prepareDispatchEnvironment()
+{
+    fatal_if(system->threads.empty(),
+             "%s: pinned dispatch requires one SE thread context", name());
+    ThreadContext *thread = system->threads[0];
+    dispatchProcess = thread->getProcessPtr();
+    fatal_if(dispatchProcess == nullptr,
+             "%s: pinned dispatch thread has no SE process", name());
+    fatal_if(!ensurePacketVisible(
+                 InternalDispatchOwner, dispatch_fixture::InternalBase,
+                 dispatch_fixture::InternalBytes),
+             "%s: cannot allocate internal pinned-dispatch pages", name());
+    std::vector<uint8_t> zero(dispatch_fixture::InternalBytes, 0);
+    fatal_if(!writePacketVisible(
+                 InternalDispatchOwner, dispatch_fixture::InternalBase,
+                 zero.data(), zero.size()),
+             "%s: cannot initialize internal pinned-dispatch pages", name());
+    fatal_if(!writePacketVisible(
+                 InternalDispatchOwner, dispatch_fixture::CodeVa,
+                 dispatch_fixture::CodeImage.data(),
+                 dispatch_fixture::CodeImage.size()),
+             "%s: cannot publish pinned gfx950 code image", name());
+
+    _amd_queue_t mqd = {};
+    mqd.hsa_queue.type = _HSA_QUEUE_TYPE_MULTI;
+    mqd.hsa_queue.base_address =
+        reinterpret_cast<void *>(dispatch_fixture::PacketVa);
+    mqd.hsa_queue.size =
+        dispatch_fixture::InternalQueueBytes / AQL_PACKET_SIZE;
+    mqd.hsa_queue.id = dispatch_fixture::InternalQueueId;
+    mqd.read_dispatch_id = 0;
+    mqd.read_dispatch_id_field_base_byte_offset =
+        offsetof(_amd_queue_t, read_dispatch_id);
+    fatal_if(!writePacketVisible(
+                 InternalDispatchOwner, dispatch_fixture::QueueMqdVa,
+                 reinterpret_cast<const uint8_t *>(&mqd), sizeof(mqd)),
+             "%s: cannot publish internal HSA queue descriptor", name());
+    fatal_if(!registerInternalQueue(),
+             "%s: cannot register internal HSA queue", name());
+    gpuDispatcher->setLifecycleListener(this);
+    thread->suspend();
+}
+
+bool
+HostGPUBridge::registerInternalQueue()
+{
+    if (internalQueueRegistered)
+        return true;
+    const Addr readIndex = dispatch_fixture::QueueMqdVa +
+        offsetof(_amd_queue_t, read_dispatch_id);
+    internalQueueRegistered = hsaPacketProcessor->registerHostQueue(
+        readIndex, dispatch_fixture::PacketVa,
+        dispatch_fixture::InternalQueueId,
+        dispatch_fixture::InternalQueueBytes,
+        dispatch_fixture::InternalDoorbellBytes, GfxVersion::gfx950,
+        internalWriteIndex, internalRegisteredIndex);
+    return internalQueueRegistered;
+}

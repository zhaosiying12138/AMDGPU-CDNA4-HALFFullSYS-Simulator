+protocol::Status
+HostGPUMemoryState::validatePinnedDispatchAllocationIdentity(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t minimumBytes) const
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    const Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr || minimumBytes == 0 ||
+        allocation->size < minimumBytes) {
+        return protocol::Status::ProtocolState;
+    }
+    return protocol::Status::Ok;
+}
+
+bool
+HostGPUMemoryState::pinnedDispatchAllocationBusy(
+    const Owner &owner, uint64_t allocationId, uint64_t generation) const
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    const Allocation *allocation = resolve(owner, request);
+    return allocation == nullptr || allocation->dispatchRequestId != 0;
+}
+
+bool
+HostGPUMemoryState::pinnedDispatchAllocationOwned(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t requestId) const
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    const Allocation *allocation = resolve(owner, request);
+    return allocation != nullptr && requestId != 0 &&
+        allocation->dispatchRequestId == requestId;
+}
+
+protocol::Status
+HostGPUMemoryState::validatePinnedDispatchAllocation(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t minimumBytes) const
+{
+    const auto status = validatePinnedDispatchAllocationIdentity(
+        owner, allocationId, generation, minimumBytes);
+    if (status != protocol::Status::Ok)
+        return status;
+    if (pinnedDispatchAllocationBusy(owner, allocationId, generation))
+        return protocol::Status::Busy;
+    return protocol::Status::Ok;
+}
+
+std::optional<HostGPUMemoryState::AllocationView>
+HostGPUMemoryState::allocationView(
+    const Owner &owner, uint64_t allocationId, uint64_t generation) const
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    const Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr)
+        return std::nullopt;
+    return AllocationView{
+        allocationId, generation,
+        virtualAddress(static_cast<size_t>(allocationId - 1)),
+        allocation->size, allocation->alignment};
+}
+
+std::vector<HostGPUMemoryState::AllocationView>
+HostGPUMemoryState::allocationsForOwner(const Owner &owner) const
+{
+    std::vector<AllocationView> result;
+    result.reserve(liveAllocations);
+    for (size_t slot = 0; slot < allocations.size(); ++slot) {
+        const auto &allocation = allocations[slot];
+        if (!allocation || !(allocation->owner == owner))
+            continue;
+        result.push_back(AllocationView{
+            slot + 1, allocation->generation, virtualAddress(slot),
+            allocation->size, allocation->alignment});
+    }
+    return result;
+}
+
+bool
+HostGPUMemoryState::pinPinnedDispatchAllocation(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t requestId)
+{
+    if (requestId == 0 ||
+        validatePinnedDispatchAllocation(
+            owner, allocationId, generation, 1) != protocol::Status::Ok) {
+        return false;
+    }
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    resolve(owner, request)->dispatchRequestId = requestId;
+    return true;
+}
+
+bool
+HostGPUMemoryState::releasePinnedDispatchAllocation(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t requestId)
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr || requestId == 0 ||
+        allocation->dispatchRequestId != requestId) {
+        return false;
+    }
+    allocation->dispatchRequestId = 0;
+    return true;
+}
+
+bool
+HostGPUMemoryState::readBytes(
+    const Owner &owner, uint64_t allocationId, uint64_t generation,
+    uint64_t offset, uint64_t byteCount,
+    std::vector<uint8_t> &destination) const
+{
+    protocol::MemoryRequest request;
+    request.allocationId = allocationId;
+    request.generation = generation;
+    request.offset = offset;
+    request.byteCount = byteCount;
+    const Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr || byteCount == 0 ||
+        !rangeValid(*allocation, request) ||
+        byteCount > std::numeric_limits<size_t>::max()) {
+        return false;
+    }
+
+    try {
+        destination.assign(static_cast<size_t>(byteCount), 0);
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    uint64_t copied = 0;
+    while (copied < byteCount) {
+        const uint64_t absolute = offset + copied;
+        const uint64_t chunkIndex = absolute / ChunkBytes;
+        const size_t chunkOffset = static_cast<size_t>(absolute % ChunkBytes);
+        const size_t count = static_cast<size_t>(std::min<uint64_t>(
+            byteCount - copied, ChunkBytes - chunkOffset));
+        const auto found = allocation->chunks.find(chunkIndex);
+        if (found != allocation->chunks.end()) {
+            std::copy_n(found->second->data() + chunkOffset, count,
+                        destination.data() + static_cast<size_t>(copied));
+        }
+        copied += count;
+    }
+    return true;
+}

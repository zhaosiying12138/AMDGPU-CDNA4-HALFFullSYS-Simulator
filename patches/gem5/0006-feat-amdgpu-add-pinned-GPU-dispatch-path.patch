+DispatchDecodeResult
+decodeDispatchRequestRecord(const uint8_t *record, size_t size,
+                            uint32_t configuredMaximum)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason)) {
+        DispatchDecodeResult result;
+        result.reason = reason;
+        return result;
+    }
+    if (header.messageType != MessageType::DispatchRequest) {
+        DispatchDecodeResult result;
+        result.reason = "expected DISPATCH_REQUEST";
+        return result;
+    }
+    if (size - HeaderBytes != DispatchRequestPayloadBytes) {
+        DispatchDecodeResult result;
+        result.reason = "dispatch payload length";
+        return result;
+    }
+
+    DispatchRequest request;
+    request.major = load16(payload);
+    request.minor = load16(payload + 2);
+    const uint16_t rawOpcode = load16(payload + 4);
+    request.opcode = static_cast<DispatchOpcode>(rawOpcode);
+    request.flags = load16(payload + 6);
+    request.queueId = load64(payload + 8);
+    request.queueGeneration = load64(payload + 16);
+    request.queueSequence = load64(payload + 24);
+    request.fixtureId = load64(payload + 32);
+    request.inputAllocationId = load64(payload + 40);
+    request.inputGeneration = load64(payload + 48);
+    request.outputAllocationId = load64(payload + 56);
+    request.outputGeneration = load64(payload + 64);
+    request.signalId = load64(payload + 72);
+    request.signalGeneration = load64(payload + 80);
+    request.expectedSignalValue = loadSigned64(payload + 88);
+    request.fixtureManifestSha256 =
+        loadBytes<Sha256Bytes>(payload + 96);
+
+    auto acknowledge = [&](Status status, const std::string &why) {
+        DispatchDecodeResult result;
+        result.action = DecodeAction::Acknowledge;
+        result.closeConnection = false;
+        result.status = status;
+        result.reason = why;
+        result.header = header;
+        result.request = request;
+        return result;
+    };
+
+    if (!validDispatchOpcode(rawOpcode) || request.flags != 0 ||
+        request.fixtureId != PinnedDispatchFixtureId ||
+        request.expectedSignalValue != 0 ||
+        request.fixtureManifestSha256 != PinnedDispatchManifestSha256) {
+        return acknowledge(Status::Malformed,
+                           "invalid pinned-dispatch fields");
+    }
+    if (request.major != PinnedDispatchMajor ||
+        request.minor != PinnedDispatchMinor) {
+        return acknowledge(Status::UnsupportedVersion,
+                           "unsupported pinned-dispatch version");
+    }
+    return acknowledge(Status::Ok, "valid pinned-dispatch request");
+}

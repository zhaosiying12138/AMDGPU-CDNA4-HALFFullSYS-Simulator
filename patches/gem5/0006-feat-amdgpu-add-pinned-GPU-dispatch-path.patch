+protocol::Status
+HostGPUQueueState::validatePinnedDispatchIdentity(
+    const Owner &owner, uint64_t queueId, uint64_t generation,
+    uint64_t sequence) const
+{
+    const auto found = queues.find(queueId);
+    if (found == queues.end() || !(found->second.owner == owner) ||
+        found->second.generation != generation ||
+        !isNextSequence(found->second.lastSequence, sequence)) {
+        return protocol::Status::ProtocolState;
+    }
+    return protocol::Status::Ok;
+}

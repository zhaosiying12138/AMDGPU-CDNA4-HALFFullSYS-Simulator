+        dispatch_fixture::PacketVa);
+    ASSERT_TRUE(decision.admitted);
+    EXPECT_EQ(decision.response.status, protocol::Status::Ok);
+    EXPECT_NE(decision.response.traceId, 0U);
+    EXPECT_EQ(decision.response.packetCrc32c,
+              dispatch_fixture::PacketCrc32c);
+
+    protocol::MemoryRequest free;
+    free.opcode = protocol::MemoryOpcode::Free;
+    free.allocationId = fixture.request.outputAllocationId;
+    free.generation = fixture.request.outputGeneration;
+    EXPECT_EQ(fixture.memory.free(
+                  {fixture.owner.fd, fixture.owner.clientGeneration},
+                  free, 11).status,
+              protocol::Status::Busy);
+
+    ASSERT_TRUE(fixture.dispatch.markGpuIssued(
+        dispatch_fixture::PacketVa,
+        dispatch_fixture::InternalQueueGeneration));
+    ASSERT_TRUE(fixture.dispatch.markCommandProcessorSubmitted(
+        dispatch_fixture::PacketVa, 42));

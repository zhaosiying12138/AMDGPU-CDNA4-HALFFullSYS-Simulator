+void
+HostGPUBridge::rollbackPacketVisibleMappings(const std::vector<Addr> &pages)
+{
+    if (!dispatchProcess)
+        return;
+    const Addr pageSize = dispatchProcess->pTable->pageSize();
+    for (const Addr page : pages) {
+        if (mappedPages.erase(page) != 0)
+            dispatchProcess->deallocateMem(page, pageSize);
+    }
+}
+
+void
+HostGPUBridge::releaseMappingRange(Addr address, uint64_t size)
+{
+    if (!dispatchProcess || size == 0 ||
+        address > std::numeric_limits<Addr>::max() - (size - 1)) {
+        return;
+    }
+    const Addr pageSize = dispatchProcess->pTable->pageSize();
+    const Addr first = roundDown(address, pageSize);
+    const Addr last = roundDown(address + size - 1, pageSize);
+    for (Addr page = first;; page += pageSize) {
+        if (mappedPages.erase(page) != 0)
+            dispatchProcess->deallocateMem(page, pageSize);
+        if (page == last)
+            break;
+    }
+}
+
+void
+HostGPUBridge::releaseMappings(const HostGPUDispatchState::Owner &owner)
+{
+    std::array<std::pair<Addr, Addr>, 2> preserve = {};
+    size_t preserveCount = 0;
+    const auto &pending = dispatchState.pending();
+    if (pending && pending->owner == owner && pending->gpuIssued) {
+        const HostGPUMemoryState::Owner memoryOwner{
+            owner.fd, owner.clientGeneration};
+        for (const auto pair : {
+                 std::pair{pending->request.inputAllocationId,
+                           pending->request.inputGeneration},
+                 std::pair{pending->request.outputAllocationId,
+                           pending->request.outputGeneration}}) {
+            const auto allocation = memoryState.allocationView(
+                memoryOwner, pair.first, pair.second);
+            if (!allocation)
+                continue;
+            preserve[preserveCount++] = {
+                roundDown(
+                    allocation->gpuVa,
+                    dispatchProcess->pTable->pageSize()),
+                roundDown(
+                    allocation->gpuVa + allocation->size - 1,
+                    dispatchProcess->pTable->pageSize())};
+        }
+    }
+    bool quarantined = false;
+    for (auto iterator = mappedPages.begin(); iterator != mappedPages.end();) {
+        if (!(iterator->second == owner)) {
+            ++iterator;
+            continue;
+        }
+        bool keep = false;
+        for (size_t index = 0; index < preserveCount; ++index) {
+            keep = keep || (iterator->first >= preserve[index].first &&
+                            iterator->first <= preserve[index].second);
+        }
+        if (keep) {
+            quarantined = true;
+            ++iterator;
+            continue;
+        }
+        dispatchProcess->deallocateMem(
+            iterator->first, dispatchProcess->pTable->pageSize());
+        iterator = mappedPages.erase(iterator);
+    }
+    if (quarantined) {
+        fatal_if(quarantinedOwner && !(*quarantinedOwner == owner),
+            "%s: overlapping dispatch quarantine owners", name());
+        quarantinedOwner = owner;
+    }
+}
+
+void
+HostGPUBridge::releaseQuarantinedMappings()
+{
+    if (!dispatchProcess || !quarantinedOwner)
+        return;
+    for (auto iterator = mappedPages.begin(); iterator != mappedPages.end();) {
+        if (iterator->second == *quarantinedOwner) {
+            dispatchProcess->deallocateMem(
+                iterator->first, dispatchProcess->pTable->pageSize());
+            iterator = mappedPages.erase(iterator);
+        } else {
+            ++iterator;
+        }
+    }
+    quarantinedOwner.reset();
+}
+
+bool
+HostGPUBridge::pendingCorrelationValid(
+    const HostGPUDispatchState::Pending &pending) const
+{
+    const auto &request = pending.request;
+    const auto &response = pending.response;
+    const HostGPUQueueState::Owner queueOwner{
+        pending.owner.fd, pending.owner.clientGeneration};
+    const HostGPUMemoryState::Owner memoryOwner{
+        pending.owner.fd, pending.owner.clientGeneration};
+    const HostGPUSignalState::Owner signalOwner{
+        pending.owner.fd, pending.owner.clientGeneration};
+    const auto input = memoryState.allocationView(
+        memoryOwner, request.inputAllocationId, request.inputGeneration);
+    const auto output = memoryState.allocationView(
+        memoryOwner, request.outputAllocationId, request.outputGeneration);
+    const bool packetInRing = pending.packetVa >= dispatch_fixture::PacketVa &&
+        pending.packetVa < dispatch_fixture::PacketVa +
+            dispatch_fixture::InternalQueueBytes &&
+        (pending.packetVa - dispatch_fixture::PacketVa) % AQL_PACKET_SIZE == 0;
+    return pending.owner.fd >= 0 && pending.owner.clientGeneration != 0 &&
+        pending.header.requestId != 0 && packetInRing &&
+        response.status == protocol::Status::Ok && response.traceId != 0 &&
+        response.fixtureId == protocol::PinnedDispatchFixtureId &&
+        response.packetCrc32c == dispatch_fixture::PacketCrc32c &&
+        response.queueId == request.queueId &&
+        response.queueGeneration == request.queueGeneration &&
+        response.queueSequence == request.queueSequence &&
+        response.inputAllocationId == request.inputAllocationId &&
+        response.inputGeneration == request.inputGeneration &&
+        response.outputAllocationId == request.outputAllocationId &&
+        response.outputGeneration == request.outputGeneration &&
+        response.signalId == request.signalId &&
+        response.signalGeneration == request.signalGeneration &&
+        request.fixtureId == protocol::PinnedDispatchFixtureId &&
+        request.expectedSignalValue == 0 &&
+        request.fixtureManifestSha256 ==
+            protocol::PinnedDispatchManifestSha256 &&
+        input && output && response.inputGpuVa == input->gpuVa &&
+        response.outputGpuVa == output->gpuVa &&
+        pending.internalQueueGeneration ==
+            (pending.gpuIssued ?
+                dispatch_fixture::InternalQueueGeneration : 0) &&
+        queueState.pinnedDispatchOwned(
+            queueOwner, request.queueId, request.queueGeneration,
+            request.queueSequence, pending.header.requestId) &&
+        memoryState.pinnedDispatchAllocationOwned(
+            memoryOwner, request.inputAllocationId, request.inputGeneration,
+            pending.header.requestId) &&
+        memoryState.pinnedDispatchAllocationOwned(
+            memoryOwner, request.outputAllocationId, request.outputGeneration,
+            pending.header.requestId) &&
+        signalState.pinnedDispatchSignalOwned(
+            signalOwner, request.signalId, request.signalGeneration,
+            pending.header.requestId);
+}
+
+void
+HostGPUBridge::retireAbandonedAfterFailure(
+    const HostGPUDispatchState::Pending &snapshot,
+    const HSAQueueEntry &task, int cuId, int workgroupId,
+    const char *reason, bool identityFailure)
+{
+    fatal_if(!snapshot.ownerConnected || snapshot.retired,
+             "%s: invalid connected abandoned-retirement transition", name());
+    failDispatchAfterAdmission(reason, identityFailure);
+
+    const auto &abandoned = dispatchState.pending();
+    fatal_if(!abandoned || abandoned->ownerConnected || abandoned->retired ||
+        !(abandoned->owner == snapshot.owner) ||
+        abandoned->header.requestId != snapshot.header.requestId ||
+        abandoned->response.traceId != snapshot.response.traceId ||
+        abandoned->packetVa != snapshot.packetVa ||
+        abandoned->internalQueueGeneration !=
+            dispatch_fixture::InternalQueueGeneration ||
+        abandoned->gpuTaskId != task.dispatchId() ||
+        task.hostDispPktAddr() != snapshot.packetVa ||
+        task.queueId() != internalRegisteredIndex ||
+        task.completionSignal() != 0 || cuId != 0 || workgroupId != 0 ||
+        !pendingCorrelationValid(*abandoned),
+        "%s: failed dispatch cannot be correlated to real packet retirement",
+        name());
+    fatal_if(!quarantinedOwner || !(*quarantinedOwner == snapshot.owner),
+             "%s: failed dispatch retirement lost its mapping quarantine",
+             name());
+    fatal_if(!dispatchState.retireAbandoned(
+                 task.hostDispPktAddr(), task.dispatchId()),
+             "%s: failed dispatch could not release retained resources",
+             name());
+    releaseQuarantinedMappings();
+    fatal_if(quarantinedOwner,
+             "%s: failed dispatch mapping quarantine was not released", name());
+
+    std::ostringstream fields;
+    fields << ",\"internal_queue_id\":"
+           << dispatch_fixture::InternalQueueId
+           << ",\"internal_queue_generation\":"
+           << dispatch_fixture::InternalQueueGeneration
+           << ",\"packet_va\":" << task.hostDispPktAddr()
+           << ",\"gpu_task_id\":" << task.dispatchId()
+           << ",\"completion_signal\":0"
+           << ",\"cp7_signal_mirrored\":false"
+           << ",\"wire_completion_emitted\":false"
+           << ",\"quarantine_released\":true";
+    fatal_if(!writeDispatchTrace(
+                 "abandoned_packet_retired", curTick(), snapshot.header,
+                 snapshot.response, fields.str()),
+             "%s: cannot persist abandoned packet retirement", name());
+    ++stats.cp8_packets_retired;
+    dispatchEndTick = 0;
+    dispatchFetchReadIndex = 0;
+    dispatchGeometryValidated = false;
+    dispatchWaveStarted = false;
+    dispatchStoreCompleted = false;
+    dispatchWorkgroupCompleted = false;
+    dispatchSignalCompletionEmitted = false;
+    dispatchIdentityCorrelationFailed = false;
+    dispatchTraceEvidenceFailed = false;
+}

+void
+HostGPUBridge::hsaPacketRetired(
+    const HSAQueueEntry &task, int cuId, int workgroupId)
+{
+    const auto pendingSnapshot = dispatchState.pending();
+    if (!pendingSnapshot || !pendingSnapshot->gpuIssued)
+        return;
+    fatal_if(pendingSnapshot->packetVa != task.hostDispPktAddr(),
+             "%s: issued finishPkt packet VA cannot be correlated", name());
+    if (!pendingCorrelationValid(*pendingSnapshot)) {
+        if (pendingSnapshot->ownerConnected) {
+            retireAbandonedAfterFailure(
+                *pendingSnapshot, task, cuId, workgroupId,
+                "retained dispatch identity mismatch", true);
+        } else {
+            failDispatchAfterAdmission(
+                "retained dispatch identity mismatch");
+        }
+        return;
+    }
+    if (!pendingSnapshot->ownerConnected) {
+        if (dispatchIdentityCorrelationFailed ||
+            pendingSnapshot->internalQueueGeneration !=
+                dispatch_fixture::InternalQueueGeneration ||
+            pendingSnapshot->gpuTaskId != task.dispatchId() ||
+            task.queueId() != internalRegisteredIndex ||
+            task.completionSignal() != 0 || cuId != 0 || workgroupId != 0) {
+            failDispatchAfterAdmission(
+                "abandoned packet retirement correlation failure");
+            return;
+        }
+        const auto abandoned = *pendingSnapshot;
+        if (!dispatchState.retireAbandoned(
+                task.hostDispPktAddr(), task.dispatchId())) {
+            failDispatchAfterAdmission(
+                "abandoned packet retained-resource mismatch");
+            return;
+        }
+        releaseQuarantinedMappings();
+        std::ostringstream abandonedFields;
+        abandonedFields << ",\"internal_queue_id\":"
+                        << dispatch_fixture::InternalQueueId
+                        << ",\"internal_queue_generation\":"
+                        << dispatch_fixture::InternalQueueGeneration
+                        << ",\"packet_va\":" << task.hostDispPktAddr()
+                        << ",\"gpu_task_id\":" << task.dispatchId()
+                        << ",\"completion_signal\":0"
+                        << ",\"cp7_signal_mirrored\":false"
+                        << ",\"wire_completion_emitted\":false"
+                        << ",\"quarantine_released\":true";
+        fatal_if(!writeDispatchTrace(
+                "abandoned_packet_retired", curTick(), abandoned.header,
+                abandoned.response, abandonedFields.str()),
+            "%s: cannot persist abandoned packet retirement", name());
+        ++stats.cp8_packets_retired;
+        dispatchEndTick = 0;
+        dispatchFetchReadIndex = 0;
+        dispatchGeometryValidated = false;
+        dispatchWaveStarted = false;
+        dispatchStoreCompleted = false;
+        dispatchWorkgroupCompleted = false;
+        dispatchSignalCompletionEmitted = false;
+        dispatchIdentityCorrelationFailed = false;
+        dispatchTraceEvidenceFailed = false;
+        return;
+    }
+    if (pendingSnapshot->gpuTaskId != task.dispatchId() || cuId != 0 ||
+        workgroupId != 0 || task.completionSignal() != 0 ||
+        !dispatchGeometryValidated || !dispatchWaveStarted ||
+        !dispatchStoreCompleted || !dispatchWorkgroupCompleted ||
+        dispatchFetchReadIndex != internalWriteIndex ||
+        dispatchEndTick == 0 || dispatchIdentityCorrelationFailed) {
+        retireAbandonedAfterFailure(
+            *pendingSnapshot, task, cuId, workgroupId,
+            "packet retirement correlation failure", true);
+        return;
+    }
+
+    std::vector<uint8_t> output;
+    if (!readPacketVisible(
+            pendingSnapshot->owner,
+            pendingSnapshot->response.outputGpuVa,
+            dispatch_fixture::BufferBytes, output) ||
+        !std::equal(output.begin(), output.end(),
+                    dispatch_fixture::GoldenOutput.begin()) ||
+        protocol::crc32c(output.data(), output.size()) !=
+            dispatch_fixture::GoldenOutputCrc32c) {
+        retireAbandonedAfterFailure(
+            *pendingSnapshot, task, cuId, workgroupId,
+            "GPU output validation failure", false);
+        return;
+    }
+
+    std::ostringstream retiredFields;
+    retiredFields << ",\"internal_queue_id\":"
+                  << dispatch_fixture::InternalQueueId
+                  << ",\"internal_queue_generation\":"
+                  << dispatch_fixture::InternalQueueGeneration
+                  << ",\"packet_va\":" << task.hostDispPktAddr()
+                  << ",\"gpu_task_id\":" << task.dispatchId()
+                  << ",\"finish_pkt_read_index\":"
+                  << dispatchFetchReadIndex
+                  << ",\"completion_signal\":0";
+    if (!writeDispatchTrace(
+            "packet_retired", curTick(), pendingSnapshot->header,
+            pendingSnapshot->response, retiredFields.str())) {
+        retireAbandonedAfterFailure(
+            *pendingSnapshot, task, cuId, workgroupId,
+            "packet retirement trace failure", false);
+        return;
+    }
+    ++stats.cp8_packets_retired;
+
+    const auto completion = dispatchState.retire(
+        task.hostDispPktAddr(), task.dispatchId(),
+        dispatch_fixture::GoldenOutputCrc32c, dispatchEndTick, curTick());
+    if (!completion) {
+        fatal_if(!dispatchState.markPhysicalRetiredWithoutCompletion(
+                     task.hostDispPktAddr(), task.dispatchId()),
+                 "%s: physical packet retirement could not be retained",
+                 name());
+        failDispatchAfterAdmission("CP7 signal mirror failure", false);
+        dispatchEndTick = 0;
+        dispatchFetchReadIndex = 0;
+        dispatchGeometryValidated = false;
+        dispatchWaveStarted = false;
+        dispatchStoreCompleted = false;
+        dispatchWorkgroupCompleted = false;
+        dispatchSignalCompletionEmitted = false;
+        dispatchIdentityCorrelationFailed = false;
+        dispatchTraceEvidenceFailed = false;
+        return;
+    }
+    if (!writeDispatchTrace(
+            "cp7_signal_mirrored", curTick(), completion->header,
+            completion->response,
+            ",\"value_before\":1,\"value_after\":0")) {
+        failDispatchAfterAdmission("CP7 signal mirror trace failure", false);
+        dispatchEndTick = 0;
+        dispatchFetchReadIndex = 0;
+        dispatchGeometryValidated = false;
+        dispatchWaveStarted = false;
+        dispatchStoreCompleted = false;
+        dispatchWorkgroupCompleted = false;
+        dispatchSignalCompletionEmitted = false;
+        dispatchIdentityCorrelationFailed = false;
+        dispatchTraceEvidenceFailed = false;
+        return;
+    }
+    retiredDispatchCompletion = completion;
+    scheduleSignalService();
+}

+    const Owner &owner, uint64_t queueId, uint64_t generation,
+    uint64_t sequence, uint64_t requestId) const
+{
+    const auto found = queues.find(queueId);
+    return found != queues.end() && found->second.owner == owner &&
+        found->second.generation == generation &&
+        found->second.lastSequence == sequence && requestId != 0 &&
+        found->second.dispatchRequestId == requestId;
+}
+
+protocol::Status
+HostGPUQueueState::validatePinnedDispatch(
+    const Owner &owner, uint64_t queueId, uint64_t generation,
+    uint64_t sequence) const
+{
+    const auto status = validatePinnedDispatchIdentity(
+        owner, queueId, generation, sequence);
+    if (status != protocol::Status::Ok)
+        return status;
+    if (pinnedDispatchBusy(owner, queueId, generation)) {
+        return protocol::Status::Busy;
+    }
+    return protocol::Status::Ok;
+}
+
+bool
+HostGPUQueueState::pinPinnedDispatch(
+    const Owner &owner, uint64_t queueId, uint64_t generation,
+    uint64_t sequence, uint64_t requestId)
+{
+    if (requestId == 0 ||
+        validatePinnedDispatch(owner, queueId, generation, sequence) !=
+            protocol::Status::Ok) {
+        return false;
+    }
+    Queue &queue = queues.at(queueId);
+    queue.lastSequence = sequence;
+    queue.dispatchRequestId = requestId;
+    return true;
+}
+
+bool
+HostGPUQueueState::releasePinnedDispatch(
+    const Owner &owner, uint64_t queueId, uint64_t generation,
+    uint64_t requestId)
+{
+    auto found = queues.find(queueId);
+    if (found == queues.end() || !(found->second.owner == owner) ||
+        found->second.generation != generation || requestId == 0 ||
+        found->second.dispatchRequestId != requestId) {
+        return false;
+    }
+    found->second.dispatchRequestId = 0;
+    return true;
+}
+
+bool
+HostGPUQueueState::cancelPinnedDispatch(
+    const Owner &owner, uint64_t queueId, uint64_t generation,
+    uint64_t sequence, uint64_t requestId)
+{
+    auto found = queues.find(queueId);
+    if (found == queues.end() || !(found->second.owner == owner) ||
+        found->second.generation != generation || sequence == 0 ||
+        requestId == 0 || found->second.lastSequence != sequence ||
+        found->second.dispatchRequestId != requestId) {
+        return false;
+    }
+    found->second.lastSequence = sequence - 1;
+    found->second.dispatchRequestId = 0;
+    return true;
+}

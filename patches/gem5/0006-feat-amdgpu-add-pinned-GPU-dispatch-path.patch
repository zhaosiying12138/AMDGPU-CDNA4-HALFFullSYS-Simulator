+bool
+HostGPUDispatchState::takeTraceId(uint64_t &traceId)
+{
+    if (traceIdsExhausted || nextTraceId == 0)
+        return false;
+    traceId = nextTraceId;
+    if (nextTraceId == std::numeric_limits<uint64_t>::max()) {
+        traceIdsExhausted = true;
+    } else {
+        ++nextTraceId;
+    }
+    return true;
+}
+
+HostGPUDispatchState::Decision
+HostGPUDispatchState::admit(
+    const Owner &owner, const protocol::Header &header,
+    const protocol::DispatchRequest &request, uint64_t now,
+    Addr packetVa)
+{
+    Decision decision;
+    decision.response = failureResponse(
+        request, protocol::Status::ProtocolState);
+
+    auto status = queues.validatePinnedDispatchIdentity(
+        queueOwner(owner), request.queueId, request.queueGeneration,
+        request.queueSequence);
+    if (status != protocol::Status::Ok) {
+        decision.response.status = status;
+        return decision;
+    }
+    status = memory.validatePinnedDispatchAllocationIdentity(
+        memoryOwner(owner), request.inputAllocationId,
+        request.inputGeneration, dispatch_fixture::BufferBytes);
+    if (status != protocol::Status::Ok) {
+        decision.response.status = status;
+        return decision;
+    }
+    status = memory.validatePinnedDispatchAllocationIdentity(
+        memoryOwner(owner), request.outputAllocationId,
+        request.outputGeneration, dispatch_fixture::BufferBytes);
+    if (status != protocol::Status::Ok) {
+        decision.response.status = status;
+        return decision;
+    }
+    if (request.inputAllocationId == request.outputAllocationId) {
+        decision.response.status = protocol::Status::ProtocolState;
+        return decision;
+    }
+    status = signals.validatePinnedDispatchSignalIdentity(
+        signalOwner(owner), request.signalId,
+        request.signalGeneration, 1);
+    if (status != protocol::Status::Ok) {
+        decision.response.status = status;
+        return decision;
+    }
+    if (pendingDispatch) {
+        decision.response.status = protocol::Status::Busy;
+        return decision;
+    }
+    if (queues.pinnedDispatchBusy(
+            queueOwner(owner), request.queueId, request.queueGeneration) ||
+        memory.pinnedDispatchAllocationBusy(
+            memoryOwner(owner), request.inputAllocationId,
+            request.inputGeneration) ||
+        memory.pinnedDispatchAllocationBusy(
+            memoryOwner(owner), request.outputAllocationId,
+            request.outputGeneration) ||
+        signals.pinnedDispatchSignalBusy(
+            signalOwner(owner), request.signalId,
+            request.signalGeneration)) {
+        decision.response.status = protocol::Status::Busy;
+        return decision;
+    }
+    if (!preconditionsMatch(owner, request)) {
+        decision.response.status = protocol::Status::ProtocolState;
+        return decision;
+    }
+    if (now > std::numeric_limits<uint64_t>::max() - 2) {
+        decision.response.status = protocol::Status::Internal;
+        return decision;
+    }
+
+    const auto input = memory.allocationView(
+        memoryOwner(owner), request.inputAllocationId,
+        request.inputGeneration);
+    const auto output = memory.allocationView(
+        memoryOwner(owner), request.outputAllocationId,
+        request.outputGeneration);
+    uint64_t traceId = 0;
+    if (!input || !output || packetVa == 0 || !takeTraceId(traceId)) {
+        decision.response.status = protocol::Status::ResourceExhausted;
+        return decision;
+    }
+    if (!pinResources(owner, header, request)) {
+        decision.response.status = protocol::Status::Internal;
+        return decision;
+    }
+
+    decision.response.status = protocol::Status::Ok;
+    decision.response.traceId = traceId;
+    decision.response.inputGpuVa = input->gpuVa;
+    decision.response.outputGpuVa = output->gpuVa;
+    decision.response.packetCrc32c = dispatch_fixture::PacketCrc32c;
+    decision.response.admissionTick = now;
+    pendingDispatch.emplace(Pending{
+        owner, header, request, decision.response,
+        packetVa, 0, -1, false, true});
+    decision.admitted = true;
+    return decision;
+}
+
+bool
+HostGPUDispatchState::markGpuIssued(
+    Addr packetVa, uint64_t internalQueueGeneration)
+{
+    if (!pendingDispatch || pendingDispatch->gpuIssued || packetVa == 0 ||
+        internalQueueGeneration == 0 ||
+        pendingDispatch->packetVa != packetVa) {
+        return false;
+    }
+    pendingDispatch->gpuIssued = true;
+    pendingDispatch->internalQueueGeneration = internalQueueGeneration;
+    return true;
+}
+
+bool
+HostGPUDispatchState::rollbackGpuIssue(
+    Addr packetVa, uint64_t internalQueueGeneration)
+{
+    if (!pendingDispatch || !pendingDispatch->gpuIssued ||
+        pendingDispatch->gpuTaskId >= 0 || pendingDispatch->retired ||
+        pendingDispatch->packetVa != packetVa ||
+        pendingDispatch->internalQueueGeneration != internalQueueGeneration) {
+        return false;
+    }
+    pendingDispatch->gpuIssued = false;
+    pendingDispatch->internalQueueGeneration = 0;
+    return true;
+}
+
+bool
+HostGPUDispatchState::cancelUnissued()
+{
+    if (!pendingDispatch || pendingDispatch->gpuIssued)
+        return false;
+    releaseResources(*pendingDispatch, true);
+    pendingDispatch.reset();
+    return true;
+}
+
+bool
+HostGPUDispatchState::markCommandProcessorSubmitted(
+    Addr packetVa, int gpuTaskId)
+{
+    if (!pendingDispatch || !pendingDispatch->gpuIssued || gpuTaskId <= 0 ||
+        pendingDispatch->gpuTaskId >= 0 ||
+        pendingDispatch->packetVa != packetVa) {
+        return false;
+    }
+    pendingDispatch->gpuTaskId = gpuTaskId;
+    return true;
+}
+
+bool
+HostGPUDispatchState::markDispatcherStarted(
+    Addr packetVa, int gpuTaskId, uint64_t startTick)
+{
+    if (!pendingDispatch || !pendingDispatch->gpuIssued || gpuTaskId <= 0 ||
+        pendingDispatch->gpuTaskId != gpuTaskId ||
+        pendingDispatch->packetVa != packetVa ||
+        pendingDispatch->response.startTick != 0 ||
+        startTick <= pendingDispatch->response.admissionTick) {
+        return false;
+    }
+    pendingDispatch->response.startTick = startTick;
+    return true;
+}
+
+std::optional<HostGPUDispatchState::Completion>
+HostGPUDispatchState::retire(
+    Addr packetVa, int gpuTaskId, uint32_t outputCrc32c,
+    uint64_t endTick, uint64_t retireTick)
+{
+    if (!pendingDispatch || !pendingDispatch->gpuIssued ||
+        pendingDispatch->retired ||
+        !pendingDispatch->ownerConnected ||
+        pendingDispatch->packetVa != packetVa ||
+        pendingDispatch->gpuTaskId != gpuTaskId ||
+        pendingDispatch->response.startTick == 0 ||
+        outputCrc32c != dispatch_fixture::GoldenOutputCrc32c ||
+        endTick < pendingDispatch->response.startTick ||
+        retireTick < endTick ||
+        retireTick == std::numeric_limits<uint64_t>::max() ||
+        retireTick <= pendingDispatch->response.admissionTick ||
+        retireTick - pendingDispatch->response.admissionTick <= 1) {
+        return std::nullopt;
+    }
+    if (!signals.mirrorPinnedDispatchCompletion(
+            signalOwner(pendingDispatch->owner),
+            pendingDispatch->request.signalId,
+            pendingDispatch->request.signalGeneration,
+            pendingDispatch->header.requestId, 0, retireTick)) {
+        return std::nullopt;
+    }
+
+    pendingDispatch->response.outputCrc32c = outputCrc32c;
+    pendingDispatch->response.endTick = endTick;
+    pendingDispatch->response.retireTick = retireTick;
+    Completion completion{
+        pendingDispatch->owner, pendingDispatch->header,
+        pendingDispatch->response};
+    pendingDispatch->retired = true;
+    return completion;
+}
+
+bool
+HostGPUDispatchState::markPhysicalRetiredWithoutCompletion(
+    Addr packetVa, int gpuTaskId)
+{
+    if (!pendingDispatch || !pendingDispatch->ownerConnected ||
+        !pendingDispatch->gpuIssued || pendingDispatch->retired ||
+        pendingDispatch->packetVa != packetVa || gpuTaskId <= 0 ||
+        pendingDispatch->gpuTaskId != gpuTaskId ||
+        pendingDispatch->internalQueueGeneration !=
+            dispatch_fixture::InternalQueueGeneration) {
+        return false;
+    }
+    pendingDispatch->retired = true;
+    return true;
+}
+
+bool
+HostGPUDispatchState::completeRetired(const Completion &completion)
+{
+    if (!pendingDispatch || !pendingDispatch->retired ||
+        !pendingDispatch->ownerConnected ||
+        !(pendingDispatch->owner == completion.owner) ||
+        pendingDispatch->header.requestId != completion.header.requestId ||
+        pendingDispatch->response.traceId != completion.response.traceId ||
+        pendingDispatch->response.retireTick !=
+            completion.response.retireTick) {
+        return false;
+    }
+    releaseResources(*pendingDispatch);
+    pendingDispatch.reset();
+    return true;
+}
+
+bool
+HostGPUDispatchState::retireAbandoned(Addr packetVa, int gpuTaskId)
+{
+    if (!pendingDispatch || pendingDispatch->ownerConnected ||
+        !pendingDispatch->gpuIssued || pendingDispatch->retired ||
+        pendingDispatch->packetVa != packetVa ||
+        gpuTaskId <= 0 || pendingDispatch->gpuTaskId != gpuTaskId ||
+        pendingDispatch->internalQueueGeneration !=
+            dispatch_fixture::InternalQueueGeneration ||
+        pendingDispatch->header.requestId == 0 ||
+        pendingDispatch->response.traceId == 0) {
+        return false;
+    }
+    const auto &request = pendingDispatch->request;
+    const auto requestId = pendingDispatch->header.requestId;
+    if (pendingDispatch->response.queueId != request.queueId ||
+        pendingDispatch->response.queueGeneration != request.queueGeneration ||
+        pendingDispatch->response.queueSequence != request.queueSequence ||
+        pendingDispatch->response.inputAllocationId !=
+            request.inputAllocationId ||
+        pendingDispatch->response.inputGeneration != request.inputGeneration ||
+        pendingDispatch->response.outputAllocationId !=
+            request.outputAllocationId ||
+        pendingDispatch->response.outputGeneration !=
+            request.outputGeneration ||
+        pendingDispatch->response.signalId != request.signalId ||
+        pendingDispatch->response.signalGeneration !=
+            request.signalGeneration ||
+        !queues.pinnedDispatchOwned(
+            queueOwner(pendingDispatch->owner), request.queueId,
+            request.queueGeneration, request.queueSequence, requestId) ||
+        !memory.pinnedDispatchAllocationOwned(
+            memoryOwner(pendingDispatch->owner), request.inputAllocationId,
+            request.inputGeneration, requestId) ||
+        !memory.pinnedDispatchAllocationOwned(
+            memoryOwner(pendingDispatch->owner), request.outputAllocationId,
+            request.outputGeneration, requestId) ||
+        !signals.pinnedDispatchSignalOwned(
+            signalOwner(pendingDispatch->owner), request.signalId,
+            request.signalGeneration, requestId)) {
+        return false;
+    }
+    const Owner owner = pendingDispatch->owner;
+    releaseResources(*pendingDispatch);
+    queues.disconnect(queueOwner(owner));
+    memory.disconnect(memoryOwner(owner));
+    signals.disconnect(signalOwner(owner));
+    pendingDispatch.reset();
+    return true;
+}
+
+void
+HostGPUDispatchState::disconnect(const Owner &owner)
+{
+    if (!pendingDispatch || !(pendingDispatch->owner == owner))
+        return;
+    pendingDispatch->ownerConnected = false;
+    if (!pendingDispatch->gpuIssued || pendingDispatch->retired) {
+        releaseResources(*pendingDispatch, !pendingDispatch->gpuIssued);
+        pendingDispatch.reset();
+    }
+}
+
+void
+HostGPUDispatchState::clear()
+{
+    if (pendingDispatch)
+        releaseResources(*pendingDispatch, !pendingDispatch->gpuIssued);
+    pendingDispatch.reset();
+}
+
+} // namespace hostgpu
+} // namespace gem5

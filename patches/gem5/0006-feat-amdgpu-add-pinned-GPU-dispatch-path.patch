+inline std::array<uint8_t, 64>
+materializeAql(Addr codeVa = CodeVa, Addr kernargVa = KernargVa)
+{
+    auto packet = AqlTemplate;
+    storeLe64(packet.data() + 32, codeVa);
+    storeLe64(packet.data() + 40, kernargVa);
+    return packet;
+}
+
+inline std::array<uint8_t, 16>
+materializeKernarg(Addr inputVa, Addr outputVa)
+{
+    std::array<uint8_t, 16> kernarg = {};
+    storeLe64(kernarg.data(), inputVa);
+    storeLe64(kernarg.data() + 8, outputVa);
+    return kernarg;
+}

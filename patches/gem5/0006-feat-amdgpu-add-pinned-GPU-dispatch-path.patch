+void
+HostGPUBridge::hsaPacketFetched(Addr hostPacketAddr, uint32_t registeredIndex)
+{
+    const auto &pending = dispatchState.pending();
+    if (!pending || !pending->gpuIssued)
+        return;
+    if (!pendingCorrelationValid(*pending)) {
+        failDispatchAfterAdmission("retained dispatch identity mismatch");
+        return;
+    }
+    if (hostPacketAddr != pending->packetVa ||
+        registeredIndex != internalRegisteredIndex ||
+        dispatchFetchReadIndex != 0) {
+        failDispatchAfterAdmission("HSAPP fetch correlation failure");
+        return;
+    }
+    dispatchFetchReadIndex = internalWriteIndex;
+    if (!pending->ownerConnected)
+        return;
+    std::ostringstream fields;
+    fields << ",\"component\":\"HSAPacketProcessor\""
+           << ",\"internal_queue_id\":"
+           << dispatch_fixture::InternalQueueId
+           << ",\"internal_queue_generation\":"
+           << dispatch_fixture::InternalQueueGeneration
+           << ",\"packet_va\":" << hostPacketAddr
+           << ",\"read_index\":" << dispatchFetchReadIndex;
+    if (!writeDispatchTrace(
+            "hsapp_packet_fetched", curTick(), pending->header,
+            pending->response, fields.str())) {
+        failDispatchAfterAdmission("HSAPP fetch trace failure", false);
+    } else {
+        ++stats.cp8_hsapp_packets_fetched;
+    }
+}

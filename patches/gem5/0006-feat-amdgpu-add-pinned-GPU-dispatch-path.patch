+bool
+HWScheduler::registerHostQueue(
+    uint64_t hostReadIndexPointer, uint64_t basePointer,
+    uint64_t queueId, uint32_t size, int doorbellSize,
+    GfxVersion gfxVersion, uint64_t readIndex,
+    uint32_t &registeredIndex)
+{
+    registeredIndex = 0;
+    if (queueId >= MAX_ACTIVE_QUEUES || hostReadIndexPointer == 0 ||
+        basePointer == 0 || size < AQL_PACKET_SIZE ||
+        size % AQL_PACKET_SIZE != 0 ||
+        (doorbellSize != 4 && doorbellSize != 8) ||
+        queueId > std::numeric_limits<Addr>::max() /
+            static_cast<uint64_t>(doorbellSize)) {
+        return false;
+    }
+    const Addr offset = queueId * doorbellSize;
+    if (dbMap.count(offset) != 0 || qidMap.count(queueId) != 0 ||
+        activeList.count(queueId) != 0) {
+        return false;
+    }
+
+    registerNewQueue(
+        hostReadIndexPointer, basePointer, queueId, size, doorbellSize,
+        gfxVersion, offset, readIndex);
+    const auto registered = regdListMap.find(queueId);
+    if (registered == regdListMap.end()) {
+        unregisterQueue(queueId, doorbellSize);
+        return false;
+    }
+    registeredIndex = registered->second;
+    return true;
+}
+
+bool
+HWScheduler::ringHostQueue(
+    uint64_t queueId, uint64_t writeIndex, uint32_t &registeredIndex)
+{
+    const auto qid = qidMap.find(queueId);
+    const auto active = activeList.find(static_cast<uint32_t>(queueId));
+    const auto registered = regdListMap.find(static_cast<uint32_t>(queueId));
+    if (qid == qidMap.end() || active == activeList.end() ||
+        registered == regdListMap.end() || writeIndex == 0 ||
+        active->second.qDesc == nullptr ||
+        active->second.qDesc->writeIndex ==
+            std::numeric_limits<uint64_t>::max() ||
+        writeIndex != active->second.qDesc->writeIndex + 1 ||
+        active->second.qDesc->spaceRemaining() == 0) {
+        return false;
+    }
+    registeredIndex = registered->second;
+    write(qid->second, writeIndex);
+    return true;
+}
+
+bool
+HWScheduler::unregisterHostQueue(uint64_t queueId, int doorbellSize)
+{
+    const auto qid = qidMap.find(queueId);
+    const auto active = activeList.find(static_cast<uint32_t>(queueId));
+    if (qid == qidMap.end() || active == activeList.end() ||
+        active->second.qDesc == nullptr ||
+        !active->second.qDesc->isEmpty()) {
+        return false;
+    }
+    unregisterQueue(queueId, doorbellSize);
+    return true;
+}

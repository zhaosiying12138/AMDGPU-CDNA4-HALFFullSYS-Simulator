+void
+HostGPUBridge::failDispatchAfterAdmission(
+    const char *reason, bool identityFailure)
+{
+    const auto pending = dispatchState.pending();
+    if (identityFailure)
+        dispatchIdentityCorrelationFailed = true;
+    else
+        dispatchTraceEvidenceFailed = true;
+    warn("%s: pinned dispatch failed after admission: %s", name(), reason);
+    if (pending && pending->ownerConnected) {
+        closeClient(pending->owner.fd);
+    } else if (pending && identityFailure) {
+        fatal("%s: disconnected dispatch lost retirement correlation: %s",
+              name(), reason);
+    }
+}

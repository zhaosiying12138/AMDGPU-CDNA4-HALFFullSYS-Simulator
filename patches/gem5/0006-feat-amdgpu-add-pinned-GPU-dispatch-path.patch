+protocol::Status
+HostGPUSignalState::validatePinnedDispatchSignalIdentity(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    int64_t requiredValue) const
+{
+    const Signal *signal = resolve(owner, signalId, generation);
+    if (signal == nullptr || signal->value != requiredValue ||
+        !signal->wait || signal->wait->condition !=
+            protocol::SignalCondition::Equal ||
+        signal->wait->compareValue != 0 || signal->wait->ready ||
+        signal->wait->queued) {
+        return protocol::Status::ProtocolState;
+    }
+    return protocol::Status::Ok;
+}
+
+bool
+HostGPUSignalState::pinnedDispatchSignalBusy(
+    const Owner &owner, uint64_t signalId, uint64_t generation) const
+{
+    const Signal *signal = resolve(owner, signalId, generation);
+    return signal == nullptr || signal->dispatchRequestId != 0;
+}
+
+bool
+HostGPUSignalState::pinnedDispatchSignalOwned(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    uint64_t requestId) const
+{
+    const Signal *signal = resolve(owner, signalId, generation);
+    return signal != nullptr && requestId != 0 &&
+        signal->dispatchRequestId == requestId;
+}
+
+protocol::Status
+HostGPUSignalState::validatePinnedDispatchSignal(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    int64_t requiredValue) const
+{
+    const auto status = validatePinnedDispatchSignalIdentity(
+        owner, signalId, generation, requiredValue);
+    if (status != protocol::Status::Ok)
+        return status;
+    if (pinnedDispatchSignalBusy(owner, signalId, generation))
+        return protocol::Status::Busy;
+    return protocol::Status::Ok;
+}
+
+bool
+HostGPUSignalState::pinPinnedDispatchSignal(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    uint64_t requestId)
+{
+    if (requestId == 0 ||
+        validatePinnedDispatchSignal(owner, signalId, generation, 1) !=
+            protocol::Status::Ok) {
+        return false;
+    }
+    auto &slot = signals[signalId - 1];
+    slot->dispatchRequestId = requestId;
+    return true;
+}
+
+bool
+HostGPUSignalState::mirrorPinnedDispatchCompletion(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    uint64_t requestId, int64_t value, uint64_t now)
+{
+    if (signalId == 0 || signalId > signals.size() || requestId == 0)
+        return false;
+    auto &slot = signals[signalId - 1];
+    if (!slot || !(slot->owner == owner) ||
+        slot->generation != generation ||
+        slot->dispatchRequestId != requestId) {
+        return false;
+    }
+    const bool wakesArmed = slot->wait && !slot->wait->ready &&
+        conditionSatisfied(value, slot->wait->condition,
+                           slot->wait->compareValue);
+    if (wakesArmed && now == std::numeric_limits<uint64_t>::max())
+        return false;
+    slot->value = value;
+    if (wakesArmed) {
+        slot->wait->ready = true;
+        slot->wait->capturedValue = value;
+        slot->wait->readyTick = now + CompletionDelay;
+    }
+    return true;
+}
+
+bool
+HostGPUSignalState::releasePinnedDispatchSignal(
+    const Owner &owner, uint64_t signalId, uint64_t generation,
+    uint64_t requestId)
+{
+    if (signalId == 0 || signalId > signals.size() || requestId == 0)
+        return false;
+    auto &slot = signals[signalId - 1];
+    if (!slot || !(slot->owner == owner) ||
+        slot->generation != generation ||
+        slot->dispatchRequestId != requestId) {
+        return false;
+    }
+    slot->dispatchRequestId = 0;
+    return true;
+}
+
+std::optional<int64_t>
+HostGPUSignalState::value(
+    const Owner &owner, uint64_t signalId, uint64_t generation) const
+{
+    const Signal *signal = resolve(owner, signalId, generation);
+    if (signal == nullptr)
+        return std::nullopt;
+    return signal->value;
+}

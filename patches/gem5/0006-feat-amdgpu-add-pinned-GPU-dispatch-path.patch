+TEST(HostGpuDispatchFixture, AuthorityBytesAndMaterializationAreExact)
+{
+    EXPECT_TRUE(dispatch_fixture::geometryMatches(64, 1, 1, 64, 1, 1, 1));
+    EXPECT_FALSE(dispatch_fixture::geometryMatches(65, 1, 1, 64, 1, 1, 2));
+    EXPECT_FALSE(dispatch_fixture::geometryMatches(64, 1, 1, 32, 1, 1, 1));
+    const auto code = fromHex(
+        "0000000000000000100000000000000040000000000000000000000000000000"
+        "000000000000000000000000000000004000af00840000000800000000000000"
+        "00000ac0000000007fc08cbf008040dc00000001700f8cbfff02022a5a000000"
+        "008060dc00010200000081bf");
+    EXPECT_TRUE(std::equal(code.begin(), code.end(),
+                           dispatch_fixture::CodeImage.begin()));
+    EXPECT_EQ(code.size(), dispatch_fixture::CodeImage.size());
+
+    const auto packet = dispatch_fixture::materializeAql();
+    const auto expected = fromHex(
+        "0214010040000100010000004000000001000000010000000000000000000000"
+        "0000000000200000001000000020000000000000000000000000000000000000");
+    EXPECT_TRUE(std::equal(expected.begin(), expected.end(), packet.begin()));
+    EXPECT_EQ(protocol::crc32c(packet.data(), packet.size()),
+              dispatch_fixture::PacketCrc32c);
+
+    const auto kernarg = dispatch_fixture::materializeKernarg(
+        0x0000100300000000ULL, 0x0000100380000000ULL);
+    const auto expectedKernarg = fromHex(
+        "00000000031000000000008003100000");
+    EXPECT_TRUE(std::equal(expectedKernarg.begin(), expectedKernarg.end(),
+                           kernarg.begin()));
+}

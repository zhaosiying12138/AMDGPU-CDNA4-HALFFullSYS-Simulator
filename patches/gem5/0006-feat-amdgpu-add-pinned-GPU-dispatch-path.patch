+bool
+HostGPUBridge::ensurePacketVisible(
+    const HostGPUDispatchState::Owner &owner, Addr address, uint64_t size,
+    std::vector<Addr> *newMappings)
+{
+    if (newMappings)
+        newMappings->clear();
+    if (!dispatchProcess || size == 0 ||
+        address > std::numeric_limits<Addr>::max() - (size - 1)) {
+        return false;
+    }
+    const Addr pageSize = dispatchProcess->pTable->pageSize();
+    const Addr first = roundDown(address, pageSize);
+    const Addr last = roundDown(address + size - 1, pageSize);
+    std::vector<Addr> missing;
+    std::vector<Addr> created;
+    try {
+        const size_t pageCount = static_cast<size_t>(
+            (last - first) / pageSize + 1);
+        missing.reserve(pageCount);
+        created.reserve(pageCount);
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    for (Addr page = first;; page += pageSize) {
+        const auto found = mappedPages.find(page);
+        const bool translated = dispatchProcess->pTable->lookup(page) != nullptr;
+        if (found != mappedPages.end()) {
+            if (!(found->second == owner) || !translated)
+                return false;
+        } else {
+            if (translated)
+                return false;
+            missing.push_back(page);
+        }
+        if (page == last)
+            break;
+    }
+
+    SETranslatingPortProxy proxy(
+        system->threads[0], SETranslatingPortProxy::Always);
+    std::vector<uint8_t> zero;
+    try {
+        zero.assign(pageSize, 0);
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    for (const Addr page : missing) {
+        dispatchProcess->allocateMem(page, pageSize);
+        if (dispatchProcess->pTable->lookup(page) == nullptr) {
+            rollbackPacketVisibleMappings(created);
+            return false;
+        }
+        proxy.writeBlob(page, zero.data(), zero.size());
+        try {
+            if (!mappedPages.emplace(page, owner).second) {
+                dispatchProcess->deallocateMem(page, pageSize);
+                rollbackPacketVisibleMappings(created);
+                return false;
+            }
+        } catch (const std::bad_alloc &) {
+            dispatchProcess->deallocateMem(page, pageSize);
+            rollbackPacketVisibleMappings(created);
+            return false;
+        }
+        created.push_back(page);
+    }
+    if (newMappings)
+        *newMappings = std::move(created);
+    return true;
+}
+
+bool
+HostGPUBridge::packetVisibleRangeOwned(
+    const HostGPUDispatchState::Owner &owner, Addr address,
+    uint64_t size) const
+{
+    if (!dispatchProcess || size == 0 ||
+        address > std::numeric_limits<Addr>::max() - (size - 1)) {
+        return false;
+    }
+    const Addr pageSize = dispatchProcess->pTable->pageSize();
+    const Addr first = roundDown(address, pageSize);
+    const Addr last = roundDown(address + size - 1, pageSize);
+    for (Addr page = first;; page += pageSize) {
+        const auto found = mappedPages.find(page);
+        if (found == mappedPages.end() || !(found->second == owner) ||
+            dispatchProcess->pTable->lookup(page) == nullptr) {
+            return false;
+        }
+        if (page == last)
+            break;
+    }
+    return true;
+}
+
+bool
+HostGPUBridge::writePacketVisible(
+    const HostGPUDispatchState::Owner &owner, Addr address,
+    const uint8_t *data, uint64_t size)
+{
+    if (!data || !ensurePacketVisible(owner, address, size))
+        return false;
+    return writeMappedPacketVisible(owner, address, data, size);
+}
+
+bool
+HostGPUBridge::writeMappedPacketVisible(
+    const HostGPUDispatchState::Owner &owner, Addr address,
+    const uint8_t *data, uint64_t size)
+{
+    if (!data || !packetVisibleRangeOwned(owner, address, size))
+        return false;
+    SETranslatingPortProxy proxy(
+        system->threads[0], SETranslatingPortProxy::Never);
+    proxy.writeBlob(address, data, size);
+    return true;
+}
+
+bool
+HostGPUBridge::readPacketVisible(
+    const HostGPUDispatchState::Owner &owner, Addr address, uint64_t size,
+    std::vector<uint8_t> &data) const
+{
+    if (!dispatchProcess || size == 0 ||
+        size > std::numeric_limits<size_t>::max() ||
+        address > std::numeric_limits<Addr>::max() - (size - 1) ||
+        !packetVisibleRangeOwned(owner, address, size)) {
+        return false;
+    }
+    try {
+        data.assign(static_cast<size_t>(size), 0);
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    SETranslatingPortProxy proxy(
+        system->threads[0], SETranslatingPortProxy::Never);
+    proxy.readBlob(address, data.data(), static_cast<size_t>(size));
+    return true;
+}

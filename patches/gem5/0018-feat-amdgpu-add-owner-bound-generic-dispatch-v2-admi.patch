+namespace gem5
+{
+namespace hostgpu
+{
+
+/**
+ * Owner-bound control state for the generic dispatch-v2 bridge boundary.
+ *
+ * The state owns one mapped object and one kernarg allocation.  Every public
+ * operation carries the connection owner and a non-zero envelope request ID;
+ * both are checked before state or memory mutation.  SUBMIT performs queue /
+ * descriptor / kernarg admission and pins the two resources, but deliberately
+ * stops before GPUDispatcher, Shader, CU, or execution.  Descriptor preload
+ * is an explicit unsupported boundary until the +256-byte entry semantics are
+ * implemented by a matching mapper and CP path.
+ */
+class HostNativeDispatchStateV2
+{
+  public:
+    using Owner = HostGPUMemoryState::Owner;
+
+    enum class Failure
+    {
+        None,
+        InvalidOwner,
+        InvalidRequest,
+        Busy,
+        UnsupportedPreload,
+        Mapping,
+        Allocation,
+        PageMap,
+        Publication,
+        Queue,
+        CommandProcessor,
+        State,
+        Overflow,
+    };
+
+    struct RequestContext
+    {
+        Owner owner;
+        uint64_t requestId = 0;
+    };
+
+    using Request = protocol::GenericDispatchRequest;
+    using Response = protocol::GenericDispatchResponse;
+
+    HostNativeDispatchStateV2(
+        HostGPUMemoryState &memoryState, HostNativeMemoryContext &memoryContext,
+        HostNativeCodeObjectMapper &codeMapper,
+        HostNativeCommandProcessorCore &cpCore, const Owner &owner);
+    ~HostNativeDispatchStateV2();
+
+    HostNativeDispatchStateV2(const HostNativeDispatchStateV2 &) = delete;
+    HostNativeDispatchStateV2 &operator=(const HostNativeDispatchStateV2 &) =
+        delete;
+
+    bool map(
+        const RequestContext &context, const Request &request,
+        const std::vector<uint8_t> &image, const protocol::CodeObjectManifest &manifest,
+        Response &response);
+    bool allocateKernarg(
+        const RequestContext &context, const Request &request,
+        Response &response);
+    bool publishKernarg(
+        const RequestContext &context, const Request &request, uint64_t offset,
+        uint64_t allocationId, uint64_t allocationGeneration,
+        const std::vector<uint8_t> &bytes);
+    bool submit(
+        const RequestContext &context, const Request &request,
+        Addr completionSignalVa, HostNativeQueueCore &queue,
+        const HostNativeQueueCore::FetchedPacket &fetched,
+        HostNativeCommandProcessorCore::Result &result,
+        Response &response,
+        GPUDispatchLifecycleListener *listener = nullptr);
+    bool retire(
+        const RequestContext &context, const Request &request,
+        HostNativeQueueCore &queue);
+    bool unmap(
+        const RequestContext &context, const Request &request,
+        Response &response);
+
+    /** Release idle resources; an admitted submission must be retired first. */
+    bool clear();
+
+    const Owner &owner() const { return boundOwner; }
+    bool hasMapping() const { return mapping.has_value(); }
+    bool hasKernarg() const { return kernarg.has_value(); }
+    bool hasSubmission() const { return submission.has_value(); }
+    const char *failure() const { return failureReason.c_str(); }
+    Failure failureCode() const { return lastFailure; }
+    static const char *failureName(Failure failure);
+
+  private:
+    struct MappingRecord
+    {
+        uint64_t objectId = 0;
+        uint64_t objectGeneration = 0;
+        uint64_t mappingId = 0;
+        uint64_t mappingGeneration = 0;
+        HostNativeCodeObjectMapper::Mapping value;
+        protocol::CodeObjectManifest manifest;
+    };
+
+    struct KernargRecord
+    {
+        uint64_t objectId = 0;
+        uint64_t objectGeneration = 0;
+        uint64_t mappingId = 0;
+        uint64_t mappingGeneration = 0;
+        HostGPUMemoryState::AllocationView allocation;
+        HostNativeMemoryContext::PageLease lease;
+        std::vector<std::pair<uint64_t, uint64_t>> publishedRanges;
+    };
+
+    struct SubmissionRecord
+    {
+        uint64_t objectId = 0;
+        uint64_t objectGeneration = 0;
+        uint64_t mappingId = 0;
+        uint64_t mappingGeneration = 0;
+        uint64_t kernargAllocationId = 0;
+        uint64_t kernargGeneration = 0;
+        uint64_t kernargOffset = 0;
+        uint64_t kernargSize = 0;
+        uint64_t signalId = 0;
+        uint64_t signalGeneration = 0;
+        uint64_t expectedSignalValueBits = 0;
+        uint64_t traceId = 0;
+        HostNativeQueueCore *queue = nullptr;
+        uint64_t ticket = 0;
+        uint64_t queueIndex = 0;
+        uint64_t queueId = 0;
+        uint64_t queueGeneration = 0;
+        uint64_t queueSequence = 0;
+        uint64_t requestId = 0;
+        uint64_t dispatchId = 0;
+    };
+
+    bool validateContext(const RequestContext &context) const;
+    bool validateObject(uint64_t objectId, uint64_t objectGeneration) const;
+    bool validateMapping(const Request &request) const;
+    bool validateKernarg(
+        const Request &request, uint64_t allocationId,
+        uint64_t allocationGeneration) const;
+    bool descriptorPreload(
+        const HostNativeCodeObjectMapper::Mapping &value, uint32_t &length,
+        uint32_t &offset) const;
+    bool rangePublished(uint64_t offset, uint64_t bytes) const;
+    void rememberPublishedRange(uint64_t offset, uint64_t bytes);
+    bool releaseKernarg();
+    bool releaseMapping();
+    bool fail(protocol::Status status, Failure failure, const char *reason);
+    bool failResponse(
+        const Request &request, Response &response, protocol::Status status,
+        Failure failure, const char *reason);
+    static bool powerOfTwo(uint64_t value);
+    static bool rangeFits(uint64_t offset, uint64_t bytes, uint64_t size);
+
+    HostGPUMemoryState &memory;
+    HostNativeMemoryContext &context;
+    HostNativeCodeObjectMapper &mapper;
+    HostNativeCommandProcessorCore &commandProcessor;
+    const Owner boundOwner;
+    std::optional<MappingRecord> mapping;
+    std::optional<KernargRecord> kernarg;
+    std::optional<SubmissionRecord> submission;
+    uint64_t nextMappingId = 1;
+    uint64_t nextTraceId = 1;
+    Failure lastFailure = Failure::None;
+    std::string failureReason = "none";
+};
+
+/** Thin bridge-facing facade; wire codecs can translate into these calls. */
+class HostNativeDispatchBridgeAdapter
+{
+  public:
+    using State = HostNativeDispatchStateV2;
+    using Owner = State::Owner;
+
+    explicit HostNativeDispatchBridgeAdapter(State &dispatchState)
+        : state(dispatchState)
+    {}
+
+    bool handleMap(
+        const Owner &owner, uint64_t requestId,
+        const State::Request &request, const std::vector<uint8_t> &image,
+        const protocol::CodeObjectManifest &manifest,
+        State::Response &response);
+    bool handleAlloc(
+        const Owner &owner, uint64_t requestId,
+        const State::Request &request, State::Response &response);
+    bool handleKernargWrite(
+        const Owner &owner, uint64_t requestId,
+        const State::Request &request, uint64_t offset,
+        uint64_t allocationId, uint64_t allocationGeneration,
+        const std::vector<uint8_t> &bytes);
+    bool handleSubmit(
+        const Owner &owner, uint64_t requestId,
+        const State::Request &request, Addr completionSignalVa,
+        HostNativeQueueCore &queue,
+        const HostNativeQueueCore::FetchedPacket &fetched,
+        HostNativeCommandProcessorCore::Result &result,
+        State::Response &response,
+        GPUDispatchLifecycleListener *listener = nullptr)
+    {
+        return state.submit({owner, requestId}, request, completionSignalVa,
+                            queue, fetched, result, response, listener);
+    }
+    bool handleRetire(
+        const Owner &owner, uint64_t requestId,
+        const State::Request &request, HostNativeQueueCore &queue)
+    {
+        return state.retire({owner, requestId}, request, queue);
+    }
+    bool handleUnmap(
+        const Owner &owner, uint64_t requestId,
+        const State::Request &request, State::Response &response);
+
+    State &stateRef() { return state; }
+    const State &stateRef() const { return state; }
+
+  private:
+    State &state;
+};
+

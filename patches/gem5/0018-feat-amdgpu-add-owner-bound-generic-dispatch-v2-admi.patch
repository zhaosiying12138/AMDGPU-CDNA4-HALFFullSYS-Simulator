+GenericDispatchDecodeResult
+genericRequestDrop(const std::string &reason, bool closeConnection = true)
+{
+    GenericDispatchDecodeResult result;
+    result.action = DecodeAction::Drop;
+    result.closeConnection = closeConnection;
+    result.reason = reason;
+    return result;
+}
+
+GenericDispatchDecodeResult
+genericRequestAck(Status status, const std::string &reason,
+                  const Header &header,
+                  const GenericDispatchRequest &request)
+{
+    GenericDispatchDecodeResult result;
+    result.action = DecodeAction::Acknowledge;
+    result.closeConnection = false;
+    result.status = status;
+    result.reason = reason;
+    result.header = header;
+    result.request = request;
+    return result;
+}
+
+GenericDispatchResponseDecodeResult
+genericResponseDrop(const std::string &reason, bool closeConnection = true)
+{
+    GenericDispatchResponseDecodeResult result;
+    result.action = DecodeAction::Drop;
+    result.closeConnection = closeConnection;
+    result.reason = reason;
+    return result;
+}
+
+GenericDispatchResponseDecodeResult
+genericResponseAck(Status status, const std::string &reason,
+                   const Header &header,
+                   const GenericDispatchResponse &response)
+{
+    GenericDispatchResponseDecodeResult result;
+    result.action = DecodeAction::Acknowledge;
+    result.closeConnection = false;
+    result.status = status;
+    result.reason = reason;
+    result.header = header;
+    result.response = response;
+    return result;
+}
+
+GenericDispatchDecodeResult
+decodeGenericRequestInternal(const uint8_t *record, size_t size,
+                             uint32_t configuredMaximum,
+                             const Capabilities *selected)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason))
+        return genericRequestDrop(reason);
+    if (size != GenericDispatchRecordBytes)
+        return genericRequestDrop("generic record size");
+    if (header.messageType != MessageType::GenericDispatchRequest)
+        return genericRequestAck(Status::Malformed,
+                                 "expected generic dispatch request", header,
+                                 {});
+    if (selected != nullptr && !genericDispatchCapabilitySelected(*selected))
+        return genericRequestAck(Status::UnsupportedCapability,
+                                 "generic dispatch capability was not negotiated",
+                                 header, {});
+
+    GenericDispatchRequest request;
+    request.major = load16(payload + GenericRequestMajorOffset);
+    request.minor = load16(payload + GenericRequestMinorOffset);
+    const uint16_t rawOpcode = load16(payload + GenericRequestOpcodeOffset);
+    if (validGenericOpcode(rawOpcode))
+        request.opcode = static_cast<GenericDispatchOpcode>(rawOpcode);
+    else
+        request.opcode = static_cast<GenericDispatchOpcode>(rawOpcode);
+    request.flags = load16(payload + GenericRequestFlagsOffset);
+    request.objectId = load64(payload + GenericRequestObjectOffset);
+    request.objectGeneration =
+        load64(payload + GenericRequestObjectGenerationOffset);
+    request.mappingId = load64(payload + GenericRequestMappingOffset);
+    request.mappingGeneration =
+        load64(payload + GenericRequestMappingGenerationOffset);
+    request.queueId = load64(payload + GenericRequestQueueOffset);
+    request.queueGeneration = load64(payload + GenericRequestQueueGenerationOffset);
+    request.queueSequence = load64(payload + GenericRequestQueueSequenceOffset);
+    request.kernelIndex = load32(payload + GenericRequestKernelIndexOffset);
+    request.reserved = load32(payload + GenericRequestReservedOffset);
+    request.imageSha256 = loadBytes<Sha256Bytes>(
+        payload + GenericRequestImageShaOffset);
+    request.kernelName = loadBytes<GenericDispatchKernelNameBytes>(
+        payload + GenericRequestKernelNameOffset);
+
+    size_t activeEnd = GenericDispatchCommonBytes;
+    if (request.opcode == GenericDispatchOpcode::MapObject) {
+        request.map.gfxTarget = load32(payload + GenericRequestBodyOffset);
+        request.map.relocationCount = load32(payload + GenericRequestBodyOffset + 4);
+        request.map.kernargSegmentSize =
+            load32(payload + GenericRequestBodyOffset + 8);
+        request.map.kernargSegmentAlign =
+            load32(payload + GenericRequestBodyOffset + 12);
+        request.map.descriptorPreloadDwords =
+            load32(payload + GenericRequestBodyOffset + 16);
+        request.map.pageSize = load32(payload + GenericRequestBodyOffset + 20);
+        activeEnd = 256;
+    } else if (request.opcode == GenericDispatchOpcode::AllocKernarg) {
+        request.allocKernarg.sizeBytes =
+            load64(payload + GenericRequestBodyOffset);
+        request.allocKernarg.alignmentBytes =
+            load64(payload + GenericRequestBodyOffset + 8);
+        request.allocKernarg.allocationFlags =
+            load32(payload + GenericRequestBodyOffset + 16);
+        request.allocKernarg.reserved =
+            load32(payload + GenericRequestBodyOffset + 20);
+        activeEnd = 256;
+    } else if (request.opcode == GenericDispatchOpcode::SubmitAql) {
+        request.submit.kernargAllocationId =
+            load64(payload + GenericRequestBodyOffset);
+        request.submit.kernargGeneration =
+            load64(payload + GenericRequestBodyOffset + 8);
+        request.submit.kernargOffset =
+            load64(payload + GenericRequestBodyOffset + 16);
+        request.submit.kernargSize =
+            load64(payload + GenericRequestBodyOffset + 24);
+        request.submit.signalId =
+            load64(payload + GenericRequestBodyOffset + 32);
+        request.submit.signalGeneration =
+            load64(payload + GenericRequestBodyOffset + 40);
+        request.submit.expectedSignalValueBits =
+            load64(payload + GenericRequestBodyOffset + 48);
+        request.submit.gridX = load32(payload + GenericRequestBodyOffset + 56);
+        request.submit.gridY = load32(payload + GenericRequestBodyOffset + 60);
+        request.submit.gridZ = load32(payload + GenericRequestBodyOffset + 64);
+        request.submit.workgroupX =
+            load32(payload + GenericRequestBodyOffset + 68);
+        request.submit.workgroupY =
+            load32(payload + GenericRequestBodyOffset + 72);
+        request.submit.workgroupZ =
+            load32(payload + GenericRequestBodyOffset + 76);
+        request.submit.numWarps =
+            load32(payload + GenericRequestBodyOffset + 80);
+        request.submit.numCtas =
+            load32(payload + GenericRequestBodyOffset + 84);
+        request.submit.sharedMemoryBytes =
+            load32(payload + GenericRequestBodyOffset + 88);
+        request.submit.wavefrontSize =
+            load32(payload + GenericRequestBodyOffset + 92);
+        request.submit.launchFlags =
+            load32(payload + GenericRequestBodyOffset + 96);
+        request.submit.reserved =
+            load32(payload + GenericRequestBodyOffset + 100);
+        activeEnd = 336;
+    } else if (!validGenericOpcode(rawOpcode)) {
+        return genericRequestAck(Status::Malformed,
+                                 "unknown generic dispatch opcode", header,
+                                 request);
+    }
+
+    if (std::any_of(payload + activeEnd,
+                    payload + GenericDispatchPayloadBytes,
+                    [](uint8_t byte) { return byte != 0; })) {
+        return genericRequestAck(Status::Malformed,
+                                 "noncanonical generic request padding", header,
+                                 request);
+    }
+    const Status status = validateGenericRequest(request, reason);
+    return genericRequestAck(status, reason, header, request);
+}
+
+GenericDispatchResponseDecodeResult
+decodeGenericResponseInternal(const uint8_t *record, size_t size,
+                              uint32_t configuredMaximum,
+                              const Capabilities *selected,
+                              uint64_t expectedRequestId,
+                              MessageType expectedMessageType)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason))
+        return genericResponseDrop(reason);
+    if (size != GenericDispatchRecordBytes)
+        return genericResponseDrop("generic response size");
+    if (!genericHeaderType(expectedMessageType) ||
+        header.messageType != expectedMessageType)
+        return genericResponseDrop("generic response message type");
+    if (expectedRequestId != 0 && header.requestId != expectedRequestId)
+        return genericResponseDrop("generic response request ID");
+    if (selected != nullptr && !genericDispatchCapabilitySelected(*selected))
+        return genericResponseAck(Status::UnsupportedCapability,
+                                  "generic dispatch capability was not negotiated",
+                                  header, {});
+
+    GenericDispatchResponse response;
+    response.major = load16(payload + GenericResponseMajorOffset);
+    response.minor = load16(payload + GenericResponseMinorOffset);
+    const uint32_t rawStatus = load32(payload + GenericResponseStatusOffset);
+    response.status = static_cast<Status>(rawStatus);
+    response.opcode = static_cast<GenericDispatchOpcode>(
+        load16(payload + GenericResponseOpcodeOffset));
+    response.flags = load16(payload + GenericResponseFlagsOffset);
+    response.errorCode = load32(payload + GenericResponseErrorOffset);
+    response.objectId = load64(payload + GenericResponseObjectOffset);
+    response.objectGeneration =
+        load64(payload + GenericResponseObjectGenerationOffset);
+    response.mappingId = load64(payload + GenericResponseMappingOffset);
+    response.mappingGeneration =
+        load64(payload + GenericResponseMappingGenerationOffset);
+    response.mappedBaseVa = load64(payload + GenericResponseMappedBaseOffset);
+    response.mappedEndVa = load64(payload + GenericResponseMappedEndOffset);
+    response.descriptorVa = load64(payload + GenericResponseDescriptorOffset);
+    response.codeVa = load64(payload + GenericResponseCodeOffset);
+    response.entryVa = load64(payload + GenericResponseEntryOffset);
+    response.mappedBytes = load64(payload + GenericResponseMappedBytesOffset);
+    response.kernargAllocationId = load64(payload + GenericResponseKernargOffset);
+    response.kernargGeneration =
+        load64(payload + GenericResponseKernargGenerationOffset);
+    response.kernargVa = load64(payload + GenericResponseKernargVaOffset);
+    response.kernargSize = load64(payload + GenericResponseKernargSizeOffset);
+    response.kernargAlignment =
+        load64(payload + GenericResponseKernargAlignOffset);
+    response.kernelIndex = load32(payload + GenericResponseKernelIndexOffset);
+    response.segmentCount = load32(payload + GenericResponseSegmentsOffset);
+    response.descriptorPreloadDwords =
+        load32(payload + GenericResponsePreloadOffset);
+    response.reserved = load32(payload + GenericResponseReservedOffset);
+    response.ticketId = load64(payload + GenericResponseTicketOffset);
+    response.traceId = load64(payload + GenericResponseTraceOffset);
+    response.queueId = load64(payload + GenericResponseQueueOffset);
+    response.queueGeneration =
+        load64(payload + GenericResponseQueueGenerationOffset);
+    response.queueSequence = load64(payload + GenericResponseQueueSequenceOffset);
+    response.signalId = load64(payload + GenericResponseSignalOffset);
+    response.signalGeneration =
+        load64(payload + GenericResponseSignalGenerationOffset);
+    response.signalValueBits = load64(payload + GenericResponseSignalValueOffset);
+    response.packetVa = load64(payload + GenericResponsePacketVaOffset);
+    response.packetCrc32c = load32(payload + GenericResponsePacketCrcOffset);
+    response.outputCrc32c = load32(payload + GenericResponseOutputCrcOffset);
+    response.simTick = load64(payload + GenericResponseSimTickOffset);
+    response.admissionTick = load64(payload + GenericResponseAdmissionTickOffset);
+    response.startTick = load64(payload + GenericResponseStartTickOffset);
+    response.endTick = load64(payload + GenericResponseEndTickOffset);
+    response.retireTick = load64(payload + GenericResponseRetireTickOffset);
+    response.imageSha256 =
+        loadBytes<Sha256Bytes>(payload + GenericResponseImageShaOffset);
+
+    if (response.major != GenericDispatchMajor ||
+        response.minor != GenericDispatchMinor)
+        return genericResponseAck(Status::UnsupportedVersion,
+                                  "generic response payload version", header,
+                                  response);
+    if (response.flags != 0 || !validGenericOpcode(
+            static_cast<uint16_t>(response.opcode)) ||
+        rawStatus > static_cast<uint32_t>(Status::Internal) ||
+        response.reserved != 0 ||
+        std::any_of(payload + GenericResponseActiveEnd,
+                    payload + GenericDispatchPayloadBytes,
+                    [](uint8_t byte) { return byte != 0; })) {
+        return genericResponseAck(Status::Malformed,
+                                  "invalid generic response fields", header,
+                                  response);
+    }
+    if (response.status == Status::Ok) {
+        if (!genericResponseSuccessValid(response, expectedMessageType))
+            return genericResponseAck(Status::Malformed,
+                                      "invalid successful generic response",
+                                      header, response);
+        return genericResponseAck(Status::Ok, "generic response decoded",
+                                  header, response);
+    }
+    if (response.errorCode == 0 || !genericResponseFieldsZero(response))
+        return genericResponseAck(Status::Malformed,
+                                  "noncanonical failed generic response", header,
+                                  response);
+    return genericResponseAck(response.status, "generic stage rejected", header,
+                              response);
+}

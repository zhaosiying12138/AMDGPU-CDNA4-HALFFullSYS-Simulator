+bool
+genericResponseFieldsZero(const GenericDispatchResponse &response)
+{
+    return response.objectId == 0 && response.objectGeneration == 0 &&
+        response.mappingId == 0 && response.mappingGeneration == 0 &&
+        response.mappedBaseVa == 0 && response.mappedEndVa == 0 &&
+        response.descriptorVa == 0 && response.codeVa == 0 &&
+        response.entryVa == 0 && response.mappedBytes == 0 &&
+        response.kernargAllocationId == 0 && response.kernargGeneration == 0 &&
+        response.kernargVa == 0 && response.kernargSize == 0 &&
+        response.kernargAlignment == 0 && response.kernelIndex == 0 &&
+        response.segmentCount == 0 && response.descriptorPreloadDwords == 0 &&
+        response.reserved == 0 && response.ticketId == 0 &&
+        response.traceId == 0 && response.queueId == 0 &&
+        response.queueGeneration == 0 && response.queueSequence == 0 &&
+        response.signalId == 0 && response.signalGeneration == 0 &&
+        response.signalValueBits == 0 && response.packetVa == 0 &&
+        response.packetCrc32c == 0 && response.outputCrc32c == 0 &&
+        response.simTick == 0 && response.admissionTick == 0 &&
+        response.startTick == 0 && response.endTick == 0 &&
+        response.retireTick == 0 && genericBytesZero(response.imageSha256);
+}

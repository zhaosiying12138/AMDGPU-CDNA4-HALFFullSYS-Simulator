+void
+storeGenericRequestPayload(std::vector<uint8_t> &payload,
+                           const GenericDispatchRequest &request)
+{
+    store16(payload, GenericRequestMajorOffset, request.major);
+    store16(payload, GenericRequestMinorOffset, request.minor);
+    store16(payload, GenericRequestOpcodeOffset,
+            static_cast<uint16_t>(request.opcode));
+    store16(payload, GenericRequestFlagsOffset, request.flags);
+    store64(payload, GenericRequestObjectOffset, request.objectId);
+    store64(payload, GenericRequestObjectGenerationOffset,
+            request.objectGeneration);
+    store64(payload, GenericRequestMappingOffset, request.mappingId);
+    store64(payload, GenericRequestMappingGenerationOffset,
+            request.mappingGeneration);
+    store64(payload, GenericRequestQueueOffset, request.queueId);
+    store64(payload, GenericRequestQueueGenerationOffset,
+            request.queueGeneration);
+    store64(payload, GenericRequestQueueSequenceOffset, request.queueSequence);
+    store32(payload, GenericRequestKernelIndexOffset, request.kernelIndex);
+    store32(payload, GenericRequestReservedOffset, request.reserved);
+    storeBytes(payload, GenericRequestImageShaOffset, request.imageSha256);
+    std::copy(request.kernelName.begin(), request.kernelName.end(),
+              payload.begin() + GenericRequestKernelNameOffset);
+
+    switch (request.opcode) {
+      case GenericDispatchOpcode::MapObject:
+        store32(payload, GenericRequestBodyOffset, request.map.gfxTarget);
+        store32(payload, GenericRequestBodyOffset + 4,
+                request.map.relocationCount);
+        store32(payload, GenericRequestBodyOffset + 8,
+                request.map.kernargSegmentSize);
+        store32(payload, GenericRequestBodyOffset + 12,
+                request.map.kernargSegmentAlign);
+        store32(payload, GenericRequestBodyOffset + 16,
+                request.map.descriptorPreloadDwords);
+        store32(payload, GenericRequestBodyOffset + 20, request.map.pageSize);
+        break;
+      case GenericDispatchOpcode::AllocKernarg:
+        store64(payload, GenericRequestBodyOffset,
+                request.allocKernarg.sizeBytes);
+        store64(payload, GenericRequestBodyOffset + 8,
+                request.allocKernarg.alignmentBytes);
+        store32(payload, GenericRequestBodyOffset + 16,
+                request.allocKernarg.allocationFlags);
+        store32(payload, GenericRequestBodyOffset + 20,
+                request.allocKernarg.reserved);
+        break;
+      case GenericDispatchOpcode::SubmitAql:
+        store64(payload, GenericRequestBodyOffset,
+                request.submit.kernargAllocationId);
+        store64(payload, GenericRequestBodyOffset + 8,
+                request.submit.kernargGeneration);
+        store64(payload, GenericRequestBodyOffset + 16,
+                request.submit.kernargOffset);
+        store64(payload, GenericRequestBodyOffset + 24,
+                request.submit.kernargSize);
+        store64(payload, GenericRequestBodyOffset + 32, request.submit.signalId);
+        store64(payload, GenericRequestBodyOffset + 40,
+                request.submit.signalGeneration);
+        store64(payload, GenericRequestBodyOffset + 48,
+                request.submit.expectedSignalValueBits);
+        store32(payload, GenericRequestBodyOffset + 56, request.submit.gridX);
+        store32(payload, GenericRequestBodyOffset + 60, request.submit.gridY);
+        store32(payload, GenericRequestBodyOffset + 64, request.submit.gridZ);
+        store32(payload, GenericRequestBodyOffset + 68,
+                request.submit.workgroupX);
+        store32(payload, GenericRequestBodyOffset + 72,
+                request.submit.workgroupY);
+        store32(payload, GenericRequestBodyOffset + 76,
+                request.submit.workgroupZ);
+        store32(payload, GenericRequestBodyOffset + 80, request.submit.numWarps);
+        store32(payload, GenericRequestBodyOffset + 84, request.submit.numCtas);
+        store32(payload, GenericRequestBodyOffset + 88,
+                request.submit.sharedMemoryBytes);
+        store32(payload, GenericRequestBodyOffset + 92,
+                request.submit.wavefrontSize);
+        store32(payload, GenericRequestBodyOffset + 96,
+                request.submit.launchFlags);
+        store32(payload, GenericRequestBodyOffset + 100,
+                request.submit.reserved);
+        break;
+      case GenericDispatchOpcode::UnmapObject:
+        break;
+    }
+}
+
+void
+storeGenericResponsePayload(std::vector<uint8_t> &payload,
+                            const GenericDispatchResponse &response)
+{
+    store16(payload, GenericResponseMajorOffset, response.major);
+    store16(payload, GenericResponseMinorOffset, response.minor);
+    store32(payload, GenericResponseStatusOffset,
+            static_cast<uint32_t>(response.status));
+    store16(payload, GenericResponseOpcodeOffset,
+            static_cast<uint16_t>(response.opcode));
+    store16(payload, GenericResponseFlagsOffset, response.flags);
+    store32(payload, GenericResponseErrorOffset, response.errorCode);
+    store64(payload, GenericResponseObjectOffset, response.objectId);
+    store64(payload, GenericResponseObjectGenerationOffset,
+            response.objectGeneration);
+    store64(payload, GenericResponseMappingOffset, response.mappingId);
+    store64(payload, GenericResponseMappingGenerationOffset,
+            response.mappingGeneration);
+    store64(payload, GenericResponseMappedBaseOffset, response.mappedBaseVa);
+    store64(payload, GenericResponseMappedEndOffset, response.mappedEndVa);
+    store64(payload, GenericResponseDescriptorOffset, response.descriptorVa);
+    store64(payload, GenericResponseCodeOffset, response.codeVa);
+    store64(payload, GenericResponseEntryOffset, response.entryVa);
+    store64(payload, GenericResponseMappedBytesOffset, response.mappedBytes);
+    store64(payload, GenericResponseKernargOffset,
+            response.kernargAllocationId);
+    store64(payload, GenericResponseKernargGenerationOffset,
+            response.kernargGeneration);
+    store64(payload, GenericResponseKernargVaOffset, response.kernargVa);
+    store64(payload, GenericResponseKernargSizeOffset, response.kernargSize);
+    store64(payload, GenericResponseKernargAlignOffset,
+            response.kernargAlignment);
+    store32(payload, GenericResponseKernelIndexOffset, response.kernelIndex);
+    store32(payload, GenericResponseSegmentsOffset, response.segmentCount);
+    store32(payload, GenericResponsePreloadOffset,
+            response.descriptorPreloadDwords);
+    store32(payload, GenericResponseReservedOffset, response.reserved);
+    store64(payload, GenericResponseTicketOffset, response.ticketId);
+    store64(payload, GenericResponseTraceOffset, response.traceId);
+    store64(payload, GenericResponseQueueOffset, response.queueId);
+    store64(payload, GenericResponseQueueGenerationOffset,
+            response.queueGeneration);
+    store64(payload, GenericResponseQueueSequenceOffset,
+            response.queueSequence);
+    store64(payload, GenericResponseSignalOffset, response.signalId);
+    store64(payload, GenericResponseSignalGenerationOffset,
+            response.signalGeneration);
+    store64(payload, GenericResponseSignalValueOffset,
+            response.signalValueBits);
+    store64(payload, GenericResponsePacketVaOffset, response.packetVa);
+    store32(payload, GenericResponsePacketCrcOffset, response.packetCrc32c);
+    store32(payload, GenericResponseOutputCrcOffset, response.outputCrc32c);
+    store64(payload, GenericResponseSimTickOffset, response.simTick);
+    store64(payload, GenericResponseAdmissionTickOffset, response.admissionTick);
+    store64(payload, GenericResponseStartTickOffset, response.startTick);
+    store64(payload, GenericResponseEndTickOffset, response.endTick);
+    store64(payload, GenericResponseRetireTickOffset, response.retireTick);
+    storeBytes(payload, GenericResponseImageShaOffset, response.imageSha256);
+}
+
+GenericDispatchResponse
+canonicalGenericFailure(const GenericDispatchResponse &response)
+{
+    GenericDispatchResponse canonical;
+    canonical.major = GenericDispatchMajor;
+    canonical.minor = GenericDispatchMinor;
+    canonical.status = response.status;
+    canonical.opcode = response.opcode;
+    canonical.flags = 0;
+    canonical.errorCode = response.errorCode != 0
+        ? response.errorCode : static_cast<uint32_t>(response.status);
+    return canonical;
+}

+constexpr uint64_t MinimumKernargAlignment = 8;
+constexpr uint64_t MaximumKernargAlignment = 65536;
+
+void
+resetResponse(
+    const HostNativeDispatchStateV2::Request &request,
+    HostNativeDispatchStateV2::Response &response)
+{
+    response = {};
+    response.major = protocol::GenericDispatchMajor;
+    response.minor = protocol::GenericDispatchMinor;
+    response.opcode = request.opcode;
+}
+
+bool
+requestVersionValid(const HostNativeDispatchStateV2::Request &request)
+{
+    return request.major == protocol::GenericDispatchMajor &&
+        request.minor == protocol::GenericDispatchMinor && request.flags == 0 &&
+        request.reserved == 0;
+}
+
+bool
+opcodeIs(
+    const HostNativeDispatchStateV2::Request &request,
+    protocol::GenericDispatchOpcode opcode)
+{
+    return request.opcode == opcode;
+}
+
+template <size_t N>
+bool
+bytesZero(const std::array<uint8_t, N> &value)
+{
+    return std::all_of(value.begin(), value.end(),
+                       [](uint8_t byte) { return byte == 0; });
+}
+
+bool
+kernelNameMatches(
+    const std::array<uint8_t, protocol::GenericDispatchKernelNameBytes> &name,
+    const protocol::CodeObjectManifest &manifest)
+{
+    return std::equal(
+               manifest.kernelName.begin(), manifest.kernelName.end(),
+               name.begin()) &&
+        std::all_of(
+            name.begin() + manifest.kernelName.size(), name.end(),
+            [](uint8_t byte) { return byte == 0; });
+}
+

+bool
+genericResponseSuccessValid(const GenericDispatchResponse &response,
+                             MessageType type)
+{
+    if (response.status != Status::Ok || response.errorCode != 0 ||
+        response.flags != 0 || response.reserved != 0 ||
+        response.objectId == 0 || response.objectGeneration == 0 ||
+        response.mappingId == 0 || response.mappingGeneration == 0 ||
+        response.kernelIndex >= GenericDispatchMaximumKernels ||
+        (response.opcode != GenericDispatchOpcode::UnmapObject &&
+         genericBytesZero(response.imageSha256))) {
+        return false;
+    }
+
+    switch (response.opcode) {
+      case GenericDispatchOpcode::MapObject:
+        return type == MessageType::GenericDispatchAck &&
+            response.mappedBaseVa != 0 &&
+            response.mappedEndVa > response.mappedBaseVa &&
+            response.mappedBytes != 0 &&
+            response.mappedEndVa - response.mappedBaseVa >=
+                response.mappedBytes &&
+            response.descriptorVa != 0 && response.codeVa != 0 &&
+            response.entryVa != 0 && response.segmentCount != 0 &&
+            response.segmentCount <= CodeObjectMaximumSegments &&
+            response.kernargAllocationId == 0 &&
+            response.kernargGeneration == 0 && response.kernargVa == 0 &&
+            response.kernargSize == 0 && response.kernargAlignment == 0 &&
+            response.ticketId == 0 && response.traceId == 0 &&
+            response.queueId == 0 && response.queueGeneration == 0 &&
+            response.queueSequence == 0 && response.signalId == 0 &&
+            response.signalGeneration == 0 && response.signalValueBits == 0 &&
+            response.packetVa == 0 && response.packetCrc32c == 0 &&
+            response.outputCrc32c == 0 && response.simTick == 0 &&
+            response.admissionTick == 0 && response.startTick == 0 &&
+            response.endTick == 0 && response.retireTick == 0;
+
+      case GenericDispatchOpcode::AllocKernarg:
+        return type == MessageType::GenericDispatchAck &&
+            response.mappedBaseVa == 0 && response.mappedEndVa == 0 &&
+            response.descriptorVa == 0 && response.codeVa == 0 &&
+            response.entryVa == 0 && response.mappedBytes == 0 &&
+            response.kernargAllocationId != 0 &&
+            response.kernargGeneration != 0 && response.kernargVa != 0 &&
+            response.kernargSize != 0 &&
+            response.kernargSize <= GenericDispatchMaximumKernargBytes &&
+            response.kernargAlignment >= 8 &&
+            response.kernargAlignment <= 65536 &&
+            genericPowerOfTwo(response.kernargAlignment) &&
+            response.kernelIndex == 0 && response.segmentCount == 0 &&
+            response.descriptorPreloadDwords == 0 && response.ticketId == 0 &&
+            response.traceId == 0 && response.queueId == 0 &&
+            response.queueGeneration == 0 && response.queueSequence == 0 &&
+            response.signalId == 0 && response.signalGeneration == 0 &&
+            response.signalValueBits == 0 && response.packetVa == 0 &&
+            response.packetCrc32c == 0 && response.outputCrc32c == 0 &&
+            response.simTick == 0 && response.admissionTick == 0 &&
+            response.startTick == 0 && response.endTick == 0 &&
+            response.retireTick == 0;
+
+      case GenericDispatchOpcode::SubmitAql:
+        return (type == MessageType::GenericDispatchAck ||
+                type == MessageType::GenericDispatchCompletion) &&
+            response.queueId != 0 && response.queueGeneration != 0 &&
+            response.queueSequence != 0 && response.signalId != 0 &&
+            response.signalGeneration != 0 && response.signalValueBits == 1 &&
+            response.ticketId != 0 && response.traceId != 0 &&
+            response.packetVa != 0 && response.kernargAllocationId != 0 &&
+            response.kernargGeneration != 0 && response.kernargVa != 0 &&
+            response.kernargSize != 0 &&
+            response.kernargSize <= GenericDispatchMaximumKernargBytes &&
+            response.kernargAlignment >= 8 &&
+            response.kernargAlignment <= 65536 &&
+            genericPowerOfTwo(response.kernargAlignment);
+
+      case GenericDispatchOpcode::UnmapObject:
+        return type == MessageType::GenericDispatchAck &&
+            response.mappedBaseVa == 0 && response.mappedEndVa == 0 &&
+            response.descriptorVa == 0 && response.codeVa == 0 &&
+            response.entryVa == 0 && response.mappedBytes == 0 &&
+            response.kernargAllocationId == 0 &&
+            response.kernargGeneration == 0 && response.kernargVa == 0 &&
+            response.kernargSize == 0 && response.kernargAlignment == 0 &&
+            response.ticketId == 0 && response.traceId == 0 &&
+            response.queueId == 0 && response.queueGeneration == 0 &&
+            response.queueSequence == 0 && response.signalId == 0 &&
+            response.signalGeneration == 0 && response.signalValueBits == 0 &&
+            response.packetVa == 0 && response.packetCrc32c == 0 &&
+            response.outputCrc32c == 0 && response.simTick == 0 &&
+            response.admissionTick == 0 && response.startTick == 0 &&
+            response.endTick == 0 && response.retireTick == 0 &&
+            response.kernelIndex == 0 && response.segmentCount == 0 &&
+            response.descriptorPreloadDwords == 0;
+    }
+    return false;
+}

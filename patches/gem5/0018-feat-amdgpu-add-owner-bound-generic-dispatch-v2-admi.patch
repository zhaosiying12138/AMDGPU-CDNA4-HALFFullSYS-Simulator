+HostNativeDispatchStateV2::HostNativeDispatchStateV2(
+    HostGPUMemoryState &memoryState, HostNativeMemoryContext &memoryContext,
+    HostNativeCodeObjectMapper &codeMapper,
+    HostNativeCommandProcessorCore &cpCore, const Owner &owner)
+    : memory(memoryState), context(memoryContext), mapper(codeMapper),
+      commandProcessor(cpCore), boundOwner(owner)
+{
+}
+
+HostNativeDispatchStateV2::~HostNativeDispatchStateV2()
+{
+    /* A submitted task must be retired by its bridge owner first. */
+    if (!submission)
+        clear();
+}
+
+const char *
+HostNativeDispatchStateV2::failureName(Failure failure)
+{
+    switch (failure) {
+      case Failure::None:
+        return "none";
+      case Failure::InvalidOwner:
+        return "invalid_owner";
+      case Failure::InvalidRequest:
+        return "invalid_request";
+      case Failure::Busy:
+        return "busy";
+      case Failure::UnsupportedPreload:
+        return "unsupported_preload";
+      case Failure::Mapping:
+        return "mapping";
+      case Failure::Allocation:
+        return "allocation";
+      case Failure::PageMap:
+        return "page_map";
+      case Failure::Publication:
+        return "publication";
+      case Failure::Queue:
+        return "queue";
+      case Failure::CommandProcessor:
+        return "command_processor";
+      case Failure::State:
+        return "state";
+      case Failure::Overflow:
+        return "overflow";
+    }
+    return "unknown";
+}
+
+bool
+HostNativeDispatchStateV2::fail(
+    protocol::Status status, Failure failure, const char *reason)
+{
+    lastFailure = failure;
+    failureReason = reason;
+    (void)status;
+    return false;
+}
+
+bool
+HostNativeDispatchStateV2::failResponse(
+    const Request &request, Response &response, protocol::Status status,
+    Failure failure, const char *reason)
+{
+    resetResponse(request, response);
+    response.status = status;
+    response.errorCode = static_cast<uint32_t>(failure);
+    return fail(status, failure, reason);
+}
+
+bool
+HostNativeDispatchStateV2::validateContext(
+    const RequestContext &requestContext) const
+{
+    return requestContext.owner == boundOwner && requestContext.requestId != 0;
+}
+
+bool
+HostNativeDispatchStateV2::validateObject(
+    uint64_t objectId, uint64_t objectGeneration) const
+{
+    return mapping && objectId != 0 && objectGeneration != 0 &&
+        mapping->objectId == objectId &&
+        mapping->objectGeneration == objectGeneration;
+}
+
+bool
+HostNativeDispatchStateV2::validateMapping(const Request &request) const
+{
+    return validateObject(request.objectId, request.objectGeneration) &&
+        request.mappingId != 0 && request.mappingGeneration != 0 &&
+        mapping->mappingId == request.mappingId &&
+        mapping->mappingGeneration == request.mappingGeneration;
+}
+
+bool
+HostNativeDispatchStateV2::validateKernarg(
+    const Request &request, uint64_t allocationId,
+    uint64_t allocationGeneration) const
+{
+    return validateMapping(request) && kernarg &&
+        allocationId != 0 && allocationGeneration != 0 &&
+        kernarg->allocation.allocationId == allocationId &&
+        kernarg->allocation.generation == allocationGeneration;
+}
+
+bool
+HostNativeDispatchStateV2::powerOfTwo(uint64_t value)
+{
+    return value != 0 && (value & (value - 1)) == 0;
+}
+
+bool
+HostNativeDispatchStateV2::rangeFits(
+    uint64_t offset, uint64_t bytes, uint64_t size)
+{
+    return offset <= size && bytes <= size - offset;
+}
+
+bool
+HostNativeDispatchStateV2::descriptorPreload(
+    const HostNativeCodeObjectMapper::Mapping &value,
+    uint32_t &length, uint32_t &offset) const
+{
+    length = 0;
+    offset = 0;
+    AMDKernelCode descriptor = {};
+    if (!context.functionalRead(
+            value.descriptorGpuVa, &descriptor,
+            sizeof(descriptor))) {
+        return false;
+    }
+    length = descriptor.kernarg_preload_spec_length;
+    offset = descriptor.kernarg_preload_spec_offset;
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::rangePublished(uint64_t offset, uint64_t bytes) const
+{
+    if (!kernarg || bytes == 0 || !rangeFits(
+            offset, bytes, kernarg->allocation.size)) {
+        return false;
+    }
+    for (const auto &range : kernarg->publishedRanges) {
+        if (offset >= range.first && bytes <= range.second - offset)
+            return true;
+    }
+    return false;
+}
+
+void
+HostNativeDispatchStateV2::rememberPublishedRange(
+    uint64_t offset, uint64_t bytes)
+{
+    if (bytes == 0)
+        return;
+    uint64_t start = offset;
+    uint64_t end = offset + bytes;
+    std::vector<std::pair<uint64_t, uint64_t>> merged;
+    merged.reserve(kernarg->publishedRanges.size() + 1);
+    bool inserted = false;
+    for (const auto &range : kernarg->publishedRanges) {
+        const uint64_t rangeStart = range.first;
+        const uint64_t rangeEnd = range.second;
+        if (rangeEnd < start) {
+            merged.push_back(range);
+        } else if (end < rangeStart) {
+            if (!inserted) {
+                merged.emplace_back(start, end);
+                inserted = true;
+            }
+            merged.push_back(range);
+        } else {
+            start = std::min(start, rangeStart);
+            end = std::max(end, rangeEnd);
+        }
+    }
+    if (!inserted)
+        merged.emplace_back(start, end);
+    kernarg->publishedRanges = std::move(merged);
+}

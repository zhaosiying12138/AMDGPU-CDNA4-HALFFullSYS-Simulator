+bool
+validGenericOpcode(uint16_t raw)
+{
+    return raw >= static_cast<uint16_t>(GenericDispatchOpcode::MapObject) &&
+           raw <= static_cast<uint16_t>(GenericDispatchOpcode::UnmapObject);
+}
+
+bool
+genericPowerOfTwo(uint64_t value)
+{
+    return value != 0 && (value & (value - 1)) == 0;
+}
+
+template <size_t N>
+bool
+genericBytesZero(const std::array<uint8_t, N> &value)
+{
+    return std::all_of(value.begin(), value.end(),
+                       [](uint8_t byte) { return byte == 0; });
+}
+
+template <size_t N>
+bool
+genericNulPaddedAscii(const std::array<uint8_t, N> &value)
+{
+    const auto nul = std::find(value.begin(), value.end(), uint8_t(0));
+    if (nul == value.begin() || nul == value.end())
+        return false;
+    if (!std::all_of(value.begin(), nul,
+                     [](uint8_t byte) { return byte < 0x80; }))
+        return false;
+    return std::all_of(nul + 1, value.end(),
+                       [](uint8_t byte) { return byte == 0; });
+}
+
+bool
+genericHeaderType(MessageType type)
+{
+    return type == MessageType::GenericDispatchAck ||
+           type == MessageType::GenericDispatchCompletion;
+}

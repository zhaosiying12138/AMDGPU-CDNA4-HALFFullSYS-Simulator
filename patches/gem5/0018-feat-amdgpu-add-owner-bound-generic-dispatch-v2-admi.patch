+bool
+HostNativeDispatchStateV2::map(
+    const RequestContext &requestContext, const Request &request,
+    const std::vector<uint8_t> &image,
+    const protocol::CodeObjectManifest &manifest, Response &response)
+{
+    resetResponse(request, response);
+    if (!validateContext(requestContext)) {
+        return failResponse(
+            request, response, requestContext.owner == boundOwner ?
+                protocol::Status::Malformed : protocol::Status::Unauthorized,
+            requestContext.owner == boundOwner ? Failure::InvalidRequest :
+                Failure::InvalidOwner,
+            requestContext.owner == boundOwner ?
+                "invalid MAP request context" : "MAP owner mismatch");
+    }
+    if (!requestVersionValid(request) ||
+        !opcodeIs(request, protocol::GenericDispatchOpcode::MapObject) ||
+        request.objectId == 0 || request.objectGeneration == 0 ||
+        request.mappingId != 0 || request.mappingGeneration != 0 ||
+        request.queueId != 0 || request.queueGeneration != 0 ||
+        request.queueSequence != 0 || request.kernelIndex >=
+            protocol::GenericDispatchMaximumKernels || image.empty() ||
+        request.map.gfxTarget != protocol::GenericDispatchGfxTarget ||
+        request.map.relocationCount != 0 ||
+        request.map.pageSize != context.pageBytes() || mapping ||
+        bytesZero(request.imageSha256) ||
+        bytesZero(manifest.imageSha256) ||
+        bytesZero(manifest.kernelName) ||
+        !kernelNameMatches(request.kernelName, manifest)) {
+        return failResponse(
+            request, response, mapping ? protocol::Status::Busy :
+                protocol::Status::Malformed,
+            mapping ? Failure::Busy : Failure::InvalidRequest,
+            mapping ? "MAP already owns a mapping" : "invalid MAP request");
+    }
+    if (request.map.descriptorPreloadDwords != 0) {
+        return failResponse(
+            request, response, protocol::Status::UnsupportedCapability,
+            Failure::UnsupportedPreload,
+            "descriptor preload is unsupported by native v2 admission");
+    }
+    if (request.imageSha256 != manifest.imageSha256) {
+        return failResponse(
+            request, response, protocol::Status::ProtocolState,
+            Failure::InvalidRequest, "MAP image digest mismatch");
+    }
+    if (request.kernelIndex != manifest.kernelIndex ||
+        request.map.kernargSegmentSize != manifest.kernargSegmentSize ||
+        request.map.kernargSegmentAlign != manifest.kernargSegmentAlign) {
+        return failResponse(
+            request, response, protocol::Status::ProtocolState,
+            Failure::InvalidRequest, "MAP manifest metadata mismatch");
+    }
+
+    auto mapped = mapper.map(image, manifest);
+    if (!mapped || !mapped->valid()) {
+        return failResponse(
+            request, response, protocol::Status::Internal, Failure::Mapping,
+            "code-object mapping failed");
+    }
+    const auto ownerAllocation = memory.allocationView(
+        boundOwner, mapped->allocation.allocationId,
+        mapped->allocation.generation);
+    if (!ownerAllocation || ownerAllocation->gpuVa != mapped->allocation.gpuVa ||
+        ownerAllocation->size != mapped->allocation.size) {
+        mapper.unmap(*mapped);
+        return failResponse(
+            request, response, protocol::Status::Unauthorized,
+            Failure::InvalidOwner, "mapped allocation owner mismatch");
+    }
+
+    uint32_t preloadLength = 0;
+    uint32_t preloadOffset = 0;
+    if (!descriptorPreload(*mapped, preloadLength, preloadOffset)) {
+        mapper.unmap(*mapped);
+        return failResponse(
+            request, response, protocol::Status::Internal, Failure::Mapping,
+            "mapped descriptor read failed");
+    }
+    if (preloadLength != 0 || preloadOffset != 0) {
+        mapper.unmap(*mapped);
+        return failResponse(
+            request, response, protocol::Status::UnsupportedCapability,
+            Failure::UnsupportedPreload,
+            "kernarg preload is unsupported by native v2 admission");
+    }
+    if (nextMappingId == 0 || mapped->lease.generation == 0) {
+        mapper.unmap(*mapped);
+        return failResponse(
+            request, response, protocol::Status::ResourceExhausted,
+            Failure::Overflow, "mapping identity exhausted");
+    }
+
+    const uint64_t mappingId = nextMappingId++;
+    const uint64_t mappingGeneration = mapped->lease.generation;
+    MappingRecord record;
+    record.objectId = request.objectId;
+    record.objectGeneration = request.objectGeneration;
+    record.mappingId = mappingId;
+    record.mappingGeneration = mappingGeneration;
+    record.value = *mapped;
+    record.manifest = manifest;
+    try {
+        mapping.emplace(std::move(record));
+    } catch (const std::bad_alloc &) {
+        mapper.unmap(*mapped);
+        return failResponse(
+            request, response, protocol::Status::ResourceExhausted,
+            Failure::Mapping, "mapping state allocation failed");
+    }
+
+    response.status = protocol::Status::Ok;
+    response.objectId = request.objectId;
+    response.objectGeneration = request.objectGeneration;
+    response.mappingId = mappingId;
+    response.mappingGeneration = mappingGeneration;
+    response.mappedBaseVa = mapping->value.allocation.gpuVa;
+    if (mapping->value.mappedBytes >
+        std::numeric_limits<Addr>::max() - response.mappedBaseVa) {
+        mapping.reset();
+        mapper.unmap(*mapped);
+        return failResponse(
+            request, response, protocol::Status::ResourceExhausted,
+            Failure::Overflow, "mapped range overflows GPU VA");
+    }
+    response.mappedEndVa = response.mappedBaseVa + mapping->value.mappedBytes;
+    response.descriptorVa = mapping->value.descriptorGpuVa;
+    response.codeVa = mapping->value.codeGpuVa;
+    response.entryVa = mapping->value.entryGpuVa;
+    response.mappedBytes = mapping->value.mappedBytes;
+    response.kernelIndex = request.kernelIndex;
+    response.segmentCount = mapping->value.segmentCount;
+    response.descriptorPreloadDwords = 0;
+    response.imageSha256 = request.imageSha256;
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::allocateKernarg(
+    const RequestContext &requestContext, const Request &request,
+    Response &response)
+{
+    resetResponse(request, response);
+    if (!validateContext(requestContext)) {
+        return failResponse(
+            request, response, requestContext.owner == boundOwner ?
+                protocol::Status::Malformed : protocol::Status::Unauthorized,
+            requestContext.owner == boundOwner ? Failure::InvalidRequest :
+                Failure::InvalidOwner,
+            requestContext.owner == boundOwner ?
+                "invalid ALLOC request context" : "ALLOC owner mismatch");
+    }
+    if (!requestVersionValid(request) ||
+        !opcodeIs(request, protocol::GenericDispatchOpcode::AllocKernarg) ||
+        !validateMapping(request) || kernarg ||
+        request.queueId != 0 || request.queueGeneration != 0 ||
+        request.queueSequence != 0 || request.kernelIndex != 0 ||
+        request.allocKernarg.sizeBytes == 0 ||
+        request.allocKernarg.sizeBytes > HostGPUMemoryState::MaximumTransferBytes ||
+        !powerOfTwo(request.allocKernarg.alignmentBytes) ||
+        request.allocKernarg.alignmentBytes < MinimumKernargAlignment ||
+        request.allocKernarg.alignmentBytes > MaximumKernargAlignment ||
+        request.allocKernarg.allocationFlags != 0 ||
+        request.allocKernarg.reserved != 0 ||
+        !bytesZero(request.imageSha256) || !bytesZero(request.kernelName)) {
+        return failResponse(
+            request, response, kernarg ? protocol::Status::Busy :
+                protocol::Status::Malformed,
+            kernarg ? Failure::Busy : Failure::InvalidRequest,
+            kernarg ? "ALLOC already owns kernarg" : "invalid ALLOC request");
+    }
+
+    const uint64_t backingAlignment =
+        request.allocKernarg.alignmentBytes > 4096 ? 65536 : 4096;
+    protocol::MemoryRequest allocationRequest;
+    allocationRequest.opcode = protocol::MemoryOpcode::Allocate;
+    allocationRequest.byteCount = request.allocKernarg.sizeBytes;
+    allocationRequest.argument = backingAlignment;
+    const auto allocation = memory.allocate(
+        boundOwner, allocationRequest, requestContext.requestId);
+    if (allocation.status != protocol::Status::Ok) {
+        return failResponse(
+            request, response, allocation.status, Failure::Allocation,
+            "kernarg allocation failed");
+    }
+    const auto view = memory.allocationView(
+        boundOwner, allocation.allocationId, allocation.generation);
+    if (!view) {
+        protocol::MemoryRequest freeRequest;
+        freeRequest.opcode = protocol::MemoryOpcode::Free;
+        freeRequest.allocationId = allocation.allocationId;
+        freeRequest.generation = allocation.generation;
+        memory.free(boundOwner, freeRequest, requestContext.requestId);
+        return failResponse(
+            request, response, protocol::Status::Internal, Failure::Allocation,
+            "kernarg allocation identity disappeared");
+    }
+    const auto lease = context.map(view->gpuVa, view->size);
+    if (!lease) {
+        protocol::MemoryRequest freeRequest;
+        freeRequest.opcode = protocol::MemoryOpcode::Free;
+        freeRequest.allocationId = allocation.allocationId;
+        freeRequest.generation = allocation.generation;
+        memory.free(boundOwner, freeRequest, requestContext.requestId);
+        return failResponse(
+            request, response, protocol::Status::Internal, Failure::PageMap,
+            "kernarg page lease failed");
+    }
+
+    KernargRecord record;
+    record.objectId = request.objectId;
+    record.objectGeneration = request.objectGeneration;
+    record.mappingId = request.mappingId;
+    record.mappingGeneration = request.mappingGeneration;
+    record.allocation = *view;
+    record.lease = *lease;
+    try {
+        kernarg.emplace(std::move(record));
+    } catch (const std::bad_alloc &) {
+        context.unmap(*lease);
+        protocol::MemoryRequest freeRequest;
+        freeRequest.opcode = protocol::MemoryOpcode::Free;
+        freeRequest.allocationId = allocation.allocationId;
+        freeRequest.generation = allocation.generation;
+        memory.free(boundOwner, freeRequest, requestContext.requestId);
+        return failResponse(
+            request, response, protocol::Status::ResourceExhausted,
+            Failure::Allocation, "kernarg state allocation failed");
+    }
+
+    response.status = protocol::Status::Ok;
+    response.objectId = request.objectId;
+    response.objectGeneration = request.objectGeneration;
+    response.mappingId = request.mappingId;
+    response.mappingGeneration = request.mappingGeneration;
+    response.kernargAllocationId = view->allocationId;
+    response.kernargGeneration = view->generation;
+    response.kernargVa = view->gpuVa;
+    response.kernargSize = view->size;
+    response.kernargAlignment = view->alignment;
+    response.imageSha256 = mapping->manifest.imageSha256;
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::publishKernarg(
+    const RequestContext &requestContext, const Request &request,
+    uint64_t offset, uint64_t allocationId, uint64_t allocationGeneration,
+    const std::vector<uint8_t> &bytes)
+{
+    if (!validateContext(requestContext)) {
+        return fail(
+            requestContext.owner == boundOwner ? protocol::Status::Malformed :
+                protocol::Status::Unauthorized,
+            requestContext.owner == boundOwner ? Failure::InvalidRequest :
+                Failure::InvalidOwner,
+            requestContext.owner == boundOwner ?
+                "invalid kernarg publication context" :
+                "kernarg publication owner mismatch");
+    }
+    if (!requestVersionValid(request) ||
+        !opcodeIs(request, protocol::GenericDispatchOpcode::AllocKernarg) ||
+        !validateKernarg(request, allocationId, allocationGeneration) ||
+        bytes.empty() ||
+        bytes.size() > HostGPUMemoryState::MaximumTransferBytes ||
+        !rangeFits(offset, bytes.size(), kernarg->allocation.size) ||
+        submission || !bytesZero(request.imageSha256) ||
+        !bytesZero(request.kernelName)) {
+        return fail(
+            submission ? protocol::Status::Busy : protocol::Status::Malformed,
+            submission ? Failure::Busy : Failure::Publication,
+            submission ? "kernarg is pinned by a submission" :
+                "invalid kernarg publication");
+    }
+    if (offset > std::numeric_limits<Addr>::max() - kernarg->allocation.gpuVa)
+        return fail(protocol::Status::Malformed, Failure::Overflow,
+                    "kernarg publication address overflow");
+    if (!context.functionalWrite(
+            kernarg->allocation.gpuVa + offset, bytes.data(), bytes.size(),
+            requestContext.requestId)) {
+        return fail(protocol::Status::Internal, Failure::Publication,
+                    "kernarg functional publication failed");
+    }
+    rememberPublishedRange(offset, bytes.size());
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::submit(
+    const RequestContext &requestContext, const Request &request,
+    Addr completionSignalVa, HostNativeQueueCore &queue,
+    const HostNativeQueueCore::FetchedPacket &fetched,
+    HostNativeCommandProcessorCore::Result &result, Response &response,
+    GPUDispatchLifecycleListener *listener)
+{
+    resetResponse(request, response);
+    if (!validateContext(requestContext)) {
+        return failResponse(
+            request, response, requestContext.owner == boundOwner ?
+                protocol::Status::Malformed : protocol::Status::Unauthorized,
+            requestContext.owner == boundOwner ? Failure::InvalidRequest :
+                Failure::InvalidOwner,
+            requestContext.owner == boundOwner ?
+                "invalid SUBMIT request context" : "SUBMIT owner mismatch");
+    }
+    const auto &body = request.submit;
+    if (!requestVersionValid(request) ||
+        !opcodeIs(request, protocol::GenericDispatchOpcode::SubmitAql) ||
+        !validateKernarg(
+            request, body.kernargAllocationId, body.kernargGeneration) ||
+        submission || !fetched.valid() ||
+        !queue.isRegistered() || requestContext.requestId == 0 ||
+        body.expectedSignalValueBits != 1 || completionSignalVa == 0 ||
+        body.signalId == 0 || body.signalGeneration == 0 ||
+        body.kernargSize == 0 ||
+        body.kernargSize > HostGPUMemoryState::MaximumTransferBytes ||
+        body.kernargOffset != 0 ||
+        body.kernargSize != mapping->manifest.kernargSegmentSize ||
+        !rangeFits(body.kernargOffset, body.kernargSize,
+                   kernarg->allocation.size) ||
+        !rangePublished(body.kernargOffset, body.kernargSize) ||
+        request.kernelIndex >= protocol::GenericDispatchMaximumKernels ||
+        request.queueId == 0 || request.queueGeneration == 0 ||
+        request.queueSequence == 0 ||
+        body.gridX == 0 || body.gridY == 0 || body.gridZ == 0 ||
+        body.workgroupX == 0 || body.workgroupY == 0 || body.workgroupZ == 0 ||
+        body.numWarps == 0 || body.numCtas == 0 ||
+        body.wavefrontSize != 64 || body.launchFlags != 0 || body.reserved != 0 ||
+        request.kernelIndex != mapping->manifest.kernelIndex ||
+        request.imageSha256 != mapping->manifest.imageSha256 ||
+        !kernelNameMatches(request.kernelName, mapping->manifest)) {
+        /* Generic request carries the dispatch identity in the envelope. */
+        return failResponse(
+            request, response, submission ? protocol::Status::Busy :
+                protocol::Status::Malformed,
+            submission ? Failure::Busy : Failure::InvalidRequest,
+            submission ? "SUBMIT already admitted" : "invalid SUBMIT request");
+    }
+    if (requestContext.requestId == 0 ||
+        requestContext.requestId > static_cast<uint64_t>(INT_MAX)) {
+        return failResponse(
+            request, response, protocol::Status::Malformed, Failure::Overflow,
+            "SUBMIT request identity cannot become a task ID");
+    }
+    if (nextTraceId == 0) {
+        return failResponse(
+            request, response, protocol::Status::ResourceExhausted,
+            Failure::Overflow, "SUBMIT trace identity exhausted");
+    }
+    const uint64_t traceId = nextTraceId++;
+    if (request.queueId != queue.config().activeQueueId ||
+        request.queueGeneration != queue.config().generation ||
+        request.queueSequence - 1 != fetched.queueIndex ||
+        fetched.activeQueueId != request.queueId ||
+        fetched.queueGeneration != request.queueGeneration ||
+        fetched.registeredIndex != queue.registeredIndex() ||
+        !queue.ownsPending(fetched)) {
+        return failResponse(
+            request, response, protocol::Status::ProtocolState, Failure::Queue,
+            "SUBMIT queue identity mismatch");
+    }
+
+    _hsa_dispatch_packet_t packet = {};
+    std::memcpy(&packet, fetched.bytes.data(), sizeof(packet));
+    if (packet.completion_signal != completionSignalVa ||
+        packet.kernarg_address > std::numeric_limits<Addr>::max() -
+            body.kernargOffset ||
+        packet.kernarg_address !=
+            kernarg->allocation.gpuVa + body.kernargOffset ||
+        body.workgroupX > protocol::GenericDispatchMaximumWorkgroupDimension ||
+        body.workgroupY > protocol::GenericDispatchMaximumWorkgroupDimension ||
+        body.workgroupZ > protocol::GenericDispatchMaximumWorkgroupDimension ||
+        body.sharedMemoryBytes > protocol::GenericDispatchMaximumSharedBytes ||
+        static_cast<uint64_t>(body.workgroupX) * body.workgroupY * body.workgroupZ !=
+            static_cast<uint64_t>(body.numWarps) * body.wavefrontSize) {
+        return failResponse(
+            request, response, protocol::Status::ProtocolState, Failure::Queue,
+            "SUBMIT AQL geometry or kernarg identity mismatch");
+    }
+
+    uint32_t preloadLength = 0;
+    uint32_t preloadOffset = 0;
+    if (!descriptorPreload(mapping->value, preloadLength, preloadOffset)) {
+        return failResponse(
+            request, response, protocol::Status::Internal, Failure::Mapping,
+            "SUBMIT descriptor read failed");
+    }
+    if (preloadLength != 0 || preloadOffset != 0) {
+        return failResponse(
+            request, response, protocol::Status::UnsupportedCapability,
+            Failure::UnsupportedPreload,
+            "kernarg preload is unsupported by native v2 admission");
+    }
+
+    /* Pin before CP reads; requestId is the dispatch owner for all reads. */
+    if (!memory.pinPinnedDispatchAllocation(
+            boundOwner, mapping->value.allocation.allocationId,
+            mapping->value.allocation.generation, requestContext.requestId)) {
+        return failResponse(
+            request, response, protocol::Status::Busy, Failure::Busy,
+            "code mapping is already pinned");
+    }
+    if (!memory.pinPinnedDispatchAllocation(
+            boundOwner, kernarg->allocation.allocationId,
+            kernarg->allocation.generation, requestContext.requestId)) {
+        memory.releasePinnedDispatchAllocation(
+            boundOwner, mapping->value.allocation.allocationId,
+            mapping->value.allocation.generation, requestContext.requestId);
+        return failResponse(
+            request, response, protocol::Status::Busy, Failure::Busy,
+            "kernarg allocation is already pinned");
+    }
+
+    if (!commandProcessor.submit(
+            fetched, queue, mapping->value, mapping->manifest, context,
+            requestContext.requestId, result, listener,
+            requestContext.requestId)) {
+        /* The CP may reject after queue.fetch; return that slot to pending so
+         * a caller can retry or explicitly cancel without losing ownership. */
+        if (!queue.cancelFetch(fetched.ticket)) {
+            memory.releasePinnedDispatchAllocation(
+                boundOwner, kernarg->allocation.allocationId,
+                kernarg->allocation.generation, requestContext.requestId);
+            memory.releasePinnedDispatchAllocation(
+                boundOwner, mapping->value.allocation.allocationId,
+                mapping->value.allocation.generation, requestContext.requestId);
+            return failResponse(
+                request, response, protocol::Status::ProtocolState,
+                Failure::Queue, "CP failure left queue fetch pending");
+        }
+        memory.releasePinnedDispatchAllocation(
+            boundOwner, kernarg->allocation.allocationId,
+            kernarg->allocation.generation, requestContext.requestId);
+        memory.releasePinnedDispatchAllocation(
+            boundOwner, mapping->value.allocation.allocationId,
+            mapping->value.allocation.generation, requestContext.requestId);
+        return failResponse(
+            request, response, protocol::Status::ProtocolState,
+            Failure::CommandProcessor, commandProcessor.failure());
+    }
+
+    submission.emplace(SubmissionRecord{
+        request.objectId, request.objectGeneration, request.mappingId,
+        request.mappingGeneration, body.kernargAllocationId,
+        body.kernargGeneration, body.kernargOffset, body.kernargSize,
+        body.signalId, body.signalGeneration, body.expectedSignalValueBits,
+        traceId,
+        &queue, fetched.ticket, fetched.queueIndex, request.queueId,
+        request.queueGeneration, request.queueSequence, requestContext.requestId,
+        requestContext.requestId});
+    response.status = protocol::Status::Ok;
+    response.objectId = request.objectId;
+    response.objectGeneration = request.objectGeneration;
+    response.mappingId = request.mappingId;
+    response.mappingGeneration = request.mappingGeneration;
+    response.kernargAllocationId = kernarg->allocation.allocationId;
+    response.kernargGeneration = kernarg->allocation.generation;
+    response.kernargVa = kernarg->allocation.gpuVa + body.kernargOffset;
+    response.kernargSize = body.kernargSize;
+    response.kernargAlignment = kernarg->allocation.alignment;
+    response.ticketId = fetched.ticket;
+    response.queueId = request.queueId;
+    response.queueGeneration = request.queueGeneration;
+    response.queueSequence = request.queueSequence;
+    response.signalId = body.signalId;
+    response.signalGeneration = body.signalGeneration;
+    response.signalValueBits = body.expectedSignalValueBits;
+    response.traceId = traceId;
+    response.packetVa = fetched.hostPacketVa;
+    response.kernelIndex = request.kernelIndex;
+    response.descriptorPreloadDwords = 0;
+    response.imageSha256 = request.imageSha256;
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::retire(
+    const RequestContext &requestContext, const Request &request,
+    HostNativeQueueCore &queue)
+{
+    if (!validateContext(requestContext))
+        return fail(
+            requestContext.owner == boundOwner ? protocol::Status::Malformed :
+                protocol::Status::Unauthorized,
+            requestContext.owner == boundOwner ? Failure::InvalidRequest :
+                Failure::InvalidOwner,
+            requestContext.owner == boundOwner ?
+                "invalid RETIRE request context" : "RETIRE owner mismatch");
+    if (!requestVersionValid(request) ||
+        !opcodeIs(request, protocol::GenericDispatchOpcode::SubmitAql) ||
+        !submission || !mapping || !kernarg || submission->queue != &queue ||
+        request.objectId != submission->objectId ||
+        request.objectGeneration != submission->objectGeneration ||
+        request.mappingId != submission->mappingId ||
+        request.mappingGeneration != submission->mappingGeneration ||
+        request.queueId != submission->queueId ||
+        request.queueGeneration != submission->queueGeneration ||
+        request.queueSequence != submission->queueSequence ||
+        request.submit.kernargAllocationId !=
+            submission->kernargAllocationId ||
+        request.submit.kernargGeneration != submission->kernargGeneration ||
+        request.submit.kernargOffset != submission->kernargOffset ||
+        request.submit.kernargSize != submission->kernargSize ||
+        request.submit.signalId != submission->signalId ||
+        request.submit.signalGeneration != submission->signalGeneration ||
+        request.submit.expectedSignalValueBits !=
+            submission->expectedSignalValueBits ||
+        submission->traceId == 0 ||
+        !validateKernarg(
+            request, submission->kernargAllocationId,
+            submission->kernargGeneration) ||
+        request.kernelIndex != mapping->manifest.kernelIndex ||
+        request.imageSha256 != mapping->manifest.imageSha256 ||
+        !kernelNameMatches(request.kernelName, mapping->manifest) ||
+        requestContext.requestId != submission->requestId) {
+        return fail(
+            submission ? protocol::Status::ProtocolState :
+                protocol::Status::Malformed,
+            submission ? Failure::State : Failure::InvalidRequest,
+            submission ? "RETIRE identity mismatch" : "no admitted submission");
+    }
+    if (!queue.retire(submission->queueIndex, requestContext.requestId))
+        return fail(protocol::Status::ProtocolState, Failure::Queue,
+                    queue.failure());
+
+    const bool kernargReleased = memory.releasePinnedDispatchAllocation(
+        boundOwner, kernarg->allocation.allocationId,
+        kernarg->allocation.generation, submission->dispatchId);
+    const bool mappingReleased = memory.releasePinnedDispatchAllocation(
+        boundOwner, mapping->value.allocation.allocationId,
+        mapping->value.allocation.generation, submission->dispatchId);
+    submission.reset();
+    if (!kernargReleased || !mappingReleased)
+        return fail(protocol::Status::Internal, Failure::State,
+                    "retire pin release failed");
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::releaseKernarg()
+{
+    if (!kernarg)
+        return true;
+    if (!context.unmap(kernarg->lease)) {
+        fail(protocol::Status::Busy, Failure::PageMap,
+             "kernarg page lease release failed");
+        return false;
+    }
+    protocol::MemoryRequest freeRequest;
+    freeRequest.opcode = protocol::MemoryOpcode::Free;
+    freeRequest.allocationId = kernarg->allocation.allocationId;
+    freeRequest.generation = kernarg->allocation.generation;
+    const auto response = memory.free(boundOwner, freeRequest, 0);
+    if (response.status != protocol::Status::Ok) {
+        fail(response.status, Failure::Allocation,
+             "kernarg allocation release failed");
+        return false;
+    }
+    kernarg.reset();
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::releaseMapping()
+{
+    if (!mapping)
+        return true;
+    if (!mapper.unmap(mapping->value)) {
+        fail(protocol::Status::Busy, Failure::Mapping,
+             "code mapping release failed");
+        return false;
+    }
+    mapping.reset();
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::unmap(
+    const RequestContext &requestContext, const Request &request,
+    Response &response)
+{
+    resetResponse(request, response);
+    if (!validateContext(requestContext)) {
+        return failResponse(
+            request, response, requestContext.owner == boundOwner ?
+                protocol::Status::Malformed : protocol::Status::Unauthorized,
+            requestContext.owner == boundOwner ? Failure::InvalidRequest :
+                Failure::InvalidOwner,
+            requestContext.owner == boundOwner ?
+                "invalid UNMAP request context" : "UNMAP owner mismatch");
+    }
+    if (!requestVersionValid(request) ||
+        !opcodeIs(request, protocol::GenericDispatchOpcode::UnmapObject) ||
+        !validateMapping(request) || request.queueId != 0 ||
+        request.queueGeneration != 0 || request.queueSequence != 0 ||
+        request.kernelIndex != 0 || submission ||
+        !bytesZero(request.imageSha256) || !bytesZero(request.kernelName)) {
+        return failResponse(
+            request, response, submission ? protocol::Status::Busy :
+                protocol::Status::ProtocolState,
+            submission ? Failure::Busy : Failure::State,
+            submission ? "UNMAP has an admitted submission" :
+                "invalid UNMAP identity");
+    }
+    response.objectId = request.objectId;
+    response.objectGeneration = request.objectGeneration;
+    response.mappingId = request.mappingId;
+    response.mappingGeneration = request.mappingGeneration;
+    response.imageSha256 = mapping->manifest.imageSha256;
+    if (kernarg && !releaseKernarg()) {
+        response.status = protocol::Status::Busy;
+        response.errorCode = static_cast<uint32_t>(lastFailure);
+        response.opcode = request.opcode;
+        return false;
+    }
+    if (!releaseMapping()) {
+        response.status = protocol::Status::Busy;
+        response.errorCode = static_cast<uint32_t>(lastFailure);
+        response.opcode = request.opcode;
+        return false;
+    }
+    response.status = protocol::Status::Ok;
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchStateV2::clear()
+{
+    if (submission)
+        return fail(protocol::Status::Busy, Failure::Busy,
+                    "cannot clear an admitted submission");
+    if (!releaseKernarg() || !releaseMapping())
+        return false;
+    lastFailure = Failure::None;
+    failureReason = "none";
+    return true;
+}
+
+bool
+HostNativeDispatchBridgeAdapter::handleMap(
+    const Owner &owner, uint64_t requestId, const State::Request &request,
+    const std::vector<uint8_t> &image,
+    const protocol::CodeObjectManifest &manifest, State::Response &response)
+{
+    return state.map({owner, requestId}, request, image, manifest, response);
+}
+
+bool
+HostNativeDispatchBridgeAdapter::handleAlloc(
+    const Owner &owner, uint64_t requestId, const State::Request &request,
+    State::Response &response)
+{
+    return state.allocateKernarg({owner, requestId}, request, response);
+}
+
+bool
+HostNativeDispatchBridgeAdapter::handleKernargWrite(
+    const Owner &owner, uint64_t requestId, const State::Request &request,
+    uint64_t offset, uint64_t allocationId, uint64_t allocationGeneration,
+    const std::vector<uint8_t> &bytes)
+{
+    return state.publishKernarg(
+        {owner, requestId}, request, offset, allocationId,
+        allocationGeneration, bytes);
+}
+
+bool
+HostNativeDispatchBridgeAdapter::handleUnmap(
+    const Owner &owner, uint64_t requestId, const State::Request &request,
+    State::Response &response)
+{
+    return state.unmap({owner, requestId}, request, response);
+}
+
+} // namespace hostgpu
+} // namespace gem5

+TEST(HostGpuProtocol, GenericDispatchRequestsUseFixedV2Payload)
+{
+    const auto capabilities = genericSelectedCapabilities();
+    const Header header = goldenMemoryHeader(401);
+    auto request = goldenGenericMapRequest();
+    auto frame = encodeGenericDispatchRequest(header, request, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    EXPECT_EQ(frame[HeaderBytes], 0U);
+    EXPECT_EQ(frame[HeaderBytes + 1], GenericDispatchMajor);
+    EXPECT_EQ(load16(frame.data() + 14),
+              static_cast<uint16_t>(MessageType::GenericDispatchRequest));
+
+    auto decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities);
+    EXPECT_EQ(decoded.action, DecodeAction::Acknowledge);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.request.objectId, request.objectId);
+    EXPECT_EQ(decoded.request.map.kernargSegmentSize, 48U);
+
+    Capabilities absent = {};
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, absent);
+    EXPECT_EQ(decoded.status, Status::UnsupportedCapability);
+    EXPECT_FALSE(decoded.closeConnection);
+    Capabilities foreign = genericDispatchCapability();
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, foreign);
+    EXPECT_EQ(decoded.status, Status::UnsupportedCapability);
+    EXPECT_FALSE(decoded.closeConnection);
+
+    request.map.descriptorPreloadDwords = 12;
+    frame = encodeGenericDispatchRequest(header, request);
+    EXPECT_TRUE(frame.empty());
+
+    request = goldenGenericMapRequest();
+    frame = encodeGenericDispatchRequest(header, request, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    store32(frame, HeaderBytes + GenericDispatchCommonBytes + 16, 12);
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities);
+    EXPECT_EQ(decoded.status, Status::UnsupportedCapability);
+    EXPECT_NE(decoded.reason.find("preload"), std::string::npos);
+
+    request = goldenGenericMapRequest();
+    request.opcode = GenericDispatchOpcode::AllocKernarg;
+    request.mappingId = 11;
+    request.mappingGeneration = 13;
+    request.imageSha256.fill(0);
+    request.kernelName.fill(0);
+    request.allocKernarg.sizeBytes = 48;
+    request.allocKernarg.alignmentBytes = 8;
+    frame = encodeGenericDispatchRequest(header, request, capabilities);
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.request.allocKernarg.sizeBytes, 48U);
+
+    request = goldenGenericMapRequest();
+    request.opcode = GenericDispatchOpcode::SubmitAql;
+    request.mappingId = 11;
+    request.mappingGeneration = 13;
+    request.queueId = 17;
+    request.queueGeneration = 19;
+    request.queueSequence = 23;
+    request.submit.kernargAllocationId = 29;
+    request.submit.kernargGeneration = 31;
+    request.submit.kernargSize = 48;
+    request.submit.signalId = 37;
+    request.submit.signalGeneration = 41;
+    request.submit.expectedSignalValueBits = 1;
+    request.submit.gridX = 24832;
+    request.submit.gridY = 1;
+    request.submit.gridZ = 1;
+    request.submit.workgroupX = 256;
+    request.submit.workgroupY = 1;
+    request.submit.workgroupZ = 1;
+    request.submit.numWarps = 4;
+    request.submit.numCtas = 1;
+    request.submit.wavefrontSize = 64;
+    frame = encodeGenericDispatchRequest(header, request, capabilities);
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.request.submit.gridX, 24832U);
+
+    request = goldenGenericMapRequest();
+    request.opcode = GenericDispatchOpcode::UnmapObject;
+    request.mappingId = 11;
+    request.mappingGeneration = 13;
+    request.imageSha256.fill(0);
+    request.kernelName.fill(0);
+    frame = encodeGenericDispatchRequest(header, request, capabilities);
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities);
+    EXPECT_EQ(decoded.status, Status::Ok);
+
+    frame[HeaderBytes + GenericDispatchPayloadBytes - 1] = 0xa5;
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchRequestRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+}

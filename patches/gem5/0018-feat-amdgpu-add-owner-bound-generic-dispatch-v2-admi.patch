+std::vector<uint8_t>
+readFixture(int argc, char **argv)
+{
+    std::vector<std::string> candidates;
+    if (argc > 1)
+        candidates.emplace_back(argv[1]);
+    candidates.emplace_back(FixtureRelativePath);
+    candidates.emplace_back(
+        std::string("../") + std::string(FixtureRelativePath).substr(9));
+    candidates.emplace_back(std::string("../../") + FixtureRelativePath);
+    candidates.emplace_back(std::string("../../../") + FixtureRelativePath);
+    for (const auto &candidate : candidates) {
+        std::ifstream input(candidate, std::ios::binary);
+        if (!input)
+            continue;
+        return {std::istreambuf_iterator<char>(input),
+                std::istreambuf_iterator<char>()};
+    }
+    throw std::runtime_error("locked gpuReadWrite HSACO fixture is unavailable");
+}
+
+protocol::CodeObjectManifest
+fixtureManifest(const std::vector<uint8_t> &image)
+{
+    protocol::CodeObjectManifest manifest;
+    manifest.imageSize = image.size();
+    manifest.chunkCount = 2;
+    manifest.segmentCount = 3;
+    manifest.kernelIndex = 0;
+    manifest.imageSha256 = {
+        0x7b, 0x6a, 0x4d, 0x2b, 0xb7, 0xf9, 0xc4, 0xe7,
+        0x46, 0x6b, 0xcf, 0x69, 0xf3, 0x11, 0x0e, 0xcb,
+        0xfa, 0xb5, 0x4d, 0x07, 0xab, 0xd4, 0xc7, 0x0b,
+        0x6b, 0xd9, 0x6b, 0x6a, 0x6f, 0xb9, 0xde, 0x56,
+    };
+    manifest.elfMachine = code_object_fixture::ElfMachine;
+    manifest.elfType = code_object_fixture::ElfTypeDyn;
+    manifest.elfOsabi = code_object_fixture::ElfOsabiAmdgpuHsa;
+    manifest.elfAbiVersion = code_object_fixture::ElfAbiVersion;
+    manifest.elfFlags = code_object_fixture::ElfFlags;
+    manifest.gfxTarget = code_object_fixture::GfxTarget;
+    manifest.codeObjectVersion = code_object_fixture::CodeObjectVersion;
+    manifest.metadataMajor = code_object_fixture::MetadataMajor;
+    manifest.metadataMinor = code_object_fixture::MetadataMinor;
+    manifest.relocationCount = code_object_fixture::RelocationCount;
+    manifest.kernargSegmentSize = 280;
+    manifest.kernargSegmentAlign = 8;
+    manifest.maxFlatWorkgroupSize = 256;
+    manifest.wavefrontSize = 64;
+    manifest.sgprCount = 22;
+    manifest.vgprCount = 6;
+    manifest.descriptorSize = code_object_fixture::DescriptorBytes;
+    manifest.kernelCodeEntryByteOffset = 0x1100;
+    manifest.codeVirtualAddress = 0x1900;
+    manifest.codeFileOffset = 0x900;
+    manifest.codeSize = 0x78;
+    manifest.descriptorVirtualAddress = 0x800;
+    manifest.descriptorFileOffset = 0x800;
+    std::copy_n("gpuReadWrite", 12, manifest.kernelName.begin());
+    std::copy_n("gpuReadWrite.kd", 15, manifest.descriptorSymbol.begin());
+    require(image.size() == 5528, "gpuReadWrite fixture size");
+    std::copy_n(image.begin() + manifest.descriptorFileOffset,
+                protocol::CodeObjectDescriptorBytes,
+                manifest.descriptor.begin());
+    manifest.segments[0] = {1, 4, 0, 0, 0x840, 0x840, 0x1000};
+    manifest.segments[1] = {1, 5, 0x900, 0x1900, 0x480, 0x480, 0x1000};
+    manifest.segments[2] = {1, 6, 0xd80, 0x2d80, 0x70, 0x280, 0x1000};
+    return manifest;
+}
+
+struct StagedImage
+{
+    std::vector<uint8_t> image;
+    protocol::CodeObjectManifest manifest;
+};
+
+StagedImage
+stageImage(const std::vector<uint8_t> &image,
+           const protocol::CodeObjectManifest &manifest)
+{
+    HostGPUCodeObjectState state;
+    const HostGPUCodeObjectState::Owner owner{37, 1};
+    protocol::CodeObjectRequest begin;
+    begin.opcode = protocol::CodeObjectOpcode::Begin;
+    begin.manifest = manifest;
+    const auto beginResult = state.submit(owner, begin, 1);
+    require(beginResult.accepted, "v2 code-object begin");
+
+    uint64_t offset = 0;
+    for (uint32_t index = 0; index < manifest.chunkCount; ++index) {
+        protocol::CodeObjectRequest chunk;
+        chunk.opcode = protocol::CodeObjectOpcode::Chunk;
+        chunk.objectId = beginResult.response.objectId;
+        chunk.generation = beginResult.response.generation;
+        chunk.imageOffset = offset;
+        chunk.chunkIndex = index;
+        const auto count = static_cast<uint32_t>(std::min<uint64_t>(
+            manifest.imageSize - offset, protocol::CodeObjectChunkDataBytes));
+        chunk.byteCount = count;
+        std::copy_n(image.begin() + offset, count, chunk.chunkData.begin());
+        chunk.chunkCrc32c = protocol::crc32c(chunk.chunkData.data(), count);
+        require(state.submit(owner, chunk, 2 + index).accepted,
+                "v2 code-object chunk");
+        offset += count;
+    }
+
+    protocol::CodeObjectRequest commit;
+    commit.opcode = protocol::CodeObjectOpcode::Commit;
+    commit.objectId = beginResult.response.objectId;
+    commit.generation = beginResult.response.generation;
+    commit.byteCount = manifest.imageSize;
+    commit.chunkIndex = manifest.chunkCount;
+    commit.commitSha256 = manifest.imageSha256;
+    const auto commitResult = state.submit(owner, commit, 4);
+    require(commitResult.committed, "v2 code-object commit");
+
+    StagedImage staged;
+    require(state.readCommittedImage(owner, beginResult.response.objectId,
+                                     beginResult.response.generation,
+                                     staged.image),
+            "v2 committed image");
+    const auto committedManifest = state.committedManifest(
+        owner, beginResult.response.objectId, beginResult.response.generation);
+    require(committedManifest.has_value(), "v2 committed manifest");
+    staged.manifest = *committedManifest;
+    return staged;
+}
+
+struct AllocationLease
+{
+    uint64_t id = 0;
+    uint64_t generation = 0;
+    Addr gpuVa = 0;
+    HostNativeMemoryContext::PageLease lease;
+};
+
+AllocationLease
+allocate(HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+         const HostGPUMemoryState::Owner &owner, uint64_t bytes, uint64_t now)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Allocate;
+    request.byteCount = bytes;
+    request.argument = 4096;
+    const auto response = memory.allocate(owner, request, now);
+    require(response.status == protocol::Status::Ok, "v2 allocation");
+    const auto lease = context.map(response.value0, bytes);
+    require(lease.has_value(), "v2 page map");
+    return {response.allocationId, response.generation, response.value0,
+            *lease};
+}
+
+void
+release(HostGPUMemoryState &memory, HostNativeMemoryContext &context,
+        const HostGPUMemoryState::Owner &owner, const AllocationLease &value,
+        uint64_t now)
+{
+    require(context.unmap(value.lease), "v2 page unmap");
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Free;
+    request.allocationId = value.id;
+    request.generation = value.generation;
+    require(memory.free(owner, request, now).status == protocol::Status::Ok,
+            "v2 allocation free");
+}
+
+void
+runSelfTest(const std::vector<uint8_t> &image)
+{
+    const auto manifest = fixtureManifest(image);
+    require(HostGPUCodeObjectState::imageSha256(image) == manifest.imageSha256,
+            "v2 fixture SHA");
+    const auto staged = stageImage(image, manifest);
+
+    HostGPUMemoryState memory;
+    const HostGPUMemoryState::Owner owner{37, 1};
+    const HostGPUMemoryState::Owner wrongOwner{38, 1};
+    HostNativeMemoryContext context(memory, owner);
+    HostNativeCodeObjectMapper mapper(memory, context, owner);
+    HostNativeCommandProcessorCore commandProcessor;
+    HostNativeDispatchStateV2 state(
+        memory, context, mapper, commandProcessor, owner);
+    HostNativeDispatchBridgeAdapter adapter(state);
+    protocol::Header wireHeader;
+    wireHeader.requestId = 10;
+    wireHeader.connectionId = 37;
+    wireHeader.jobEpoch = owner.clientGeneration;
+
+    HostNativeDispatchStateV2::Request mapRequest;
+    mapRequest.opcode = protocol::GenericDispatchOpcode::MapObject;
+    mapRequest.objectId = 1;
+    mapRequest.objectGeneration = 1;
+    mapRequest.imageSha256 = staged.manifest.imageSha256;
+    mapRequest.map.gfxTarget = protocol::GenericDispatchGfxTarget;
+    mapRequest.map.kernargSegmentSize = staged.manifest.kernargSegmentSize;
+    mapRequest.map.kernargSegmentAlign = staged.manifest.kernargSegmentAlign;
+    mapRequest.map.pageSize = context.pageBytes();
+    std::copy(
+        staged.manifest.kernelName.begin(), staged.manifest.kernelName.end(),
+        mapRequest.kernelName.begin());
+
+    auto preloadRequest = mapRequest;
+    preloadRequest.map.descriptorPreloadDwords = 1;
+    HostNativeDispatchStateV2::Response preloadResponse;
+    require(!adapter.handleMap(
+                owner, 10, preloadRequest, staged.image, staged.manifest,
+                preloadResponse) &&
+                preloadResponse.status == protocol::Status::UnsupportedCapability &&
+                state.failureCode() ==
+                    HostNativeDispatchStateV2::Failure::UnsupportedPreload,
+            "v2 preload fail-closed");
+
+    HostNativeDispatchStateV2::Response mapResponse;
+    require(adapter.handleMap(
+                owner, 10, mapRequest, staged.image, staged.manifest,
+                mapResponse) &&
+                mapResponse.status == protocol::Status::Ok &&
+                mapResponse.mappingId != 0 && mapResponse.descriptorVa != 0,
+            state.failure());
+    require(!protocol::encodeGenericDispatchAck(wireHeader, mapResponse).empty(),
+            "v2 MAP response wire validation");
+
+    HostNativeDispatchStateV2::Request allocRequest = mapRequest;
+    allocRequest.opcode = protocol::GenericDispatchOpcode::AllocKernarg;
+    allocRequest.imageSha256 = {};
+    allocRequest.kernelName = {};
+    allocRequest.mappingId = mapResponse.mappingId;
+    allocRequest.mappingGeneration = mapResponse.mappingGeneration;
+    allocRequest.allocKernarg.sizeBytes = staged.manifest.kernargSegmentSize;
+    allocRequest.allocKernarg.alignmentBytes = staged.manifest.kernargSegmentAlign;
+    HostNativeDispatchStateV2::Response wrongResponse;
+    require(!adapter.handleAlloc(
+                wrongOwner, 11, allocRequest, wrongResponse) &&
+                wrongResponse.status == protocol::Status::Unauthorized,
+            "v2 owner-bound allocation rejection");
+
+    HostNativeDispatchStateV2::Response allocResponse;
+    require(adapter.handleAlloc(owner, 11, allocRequest, allocResponse) &&
+                allocResponse.status == protocol::Status::Ok &&
+                allocResponse.kernargAllocationId != 0,
+            state.failure());
+    require(!protocol::encodeGenericDispatchAck(wireHeader, allocResponse).empty(),
+            "v2 ALLOC response wire validation");
+    std::vector<uint8_t> kernarg(staged.manifest.kernargSegmentSize, 0);
+    HostNativeDispatchStateV2::Request writeRequest = allocRequest;
+    require(adapter.handleKernargWrite(
+                owner, 12, writeRequest, 0, allocResponse.kernargAllocationId,
+                allocResponse.kernargGeneration, kernarg),
+            state.failure());
+
+    const auto packetAllocation = allocate(memory, context, owner, QueueBytes, 13);
+    const auto signalAllocation = allocate(memory, context, owner, 4096, 14);
+    const auto mqdAllocation = allocate(memory, context, owner, 4096, 15);
+    const auto dataAllocation = allocate(memory, context, owner, 4096, 16);
+
+    uint64_t signalValue = 1;
+    require(context.functionalWrite(signalAllocation.gpuVa, &signalValue,
+                                    sizeof(signalValue)),
+            "v2 signal initialize");
+
+    _amd_queue_t mqd = {};
+    mqd.hsa_queue.base_address =
+        reinterpret_cast<void *>(packetAllocation.gpuVa);
+    mqd.hsa_queue.size = QueueBytes / HostNativeQueueCore::PacketBytes;
+    mqd.hsa_queue.id = QueueId;
+    mqd.read_dispatch_id = 0;
+    mqd.write_dispatch_id = 0;
+    mqd.read_dispatch_id_field_base_byte_offset =
+        offsetof(_amd_queue_t, read_dispatch_id);
+    static_assert(sizeof(mqd) == 256);
+    require(context.functionalWrite(mqdAllocation.gpuVa, &mqd, sizeof(mqd)),
+            "v2 MQD initialize");
+
+    _hsa_dispatch_packet_t packet = {};
+    packet.header = DispatchHeader;
+    packet.setup = 1;
+    packet.workgroup_size_x = 256;
+    packet.workgroup_size_y = 1;
+    packet.workgroup_size_z = 1;
+    packet.grid_size_x = 1024;
+    packet.grid_size_y = 1;
+    packet.grid_size_z = 1;
+    packet.kernel_object = mapResponse.descriptorVa;
+    packet.kernarg_address = allocResponse.kernargVa;
+    packet.completion_signal = signalAllocation.gpuVa;
+    std::array<uint8_t, HostNativeQueueCore::PacketBytes> packetBytes = {};
+    std::memcpy(packetBytes.data(), &packet, packetBytes.size());
+
+    HostNativeQueueCore queue(context);
+    HostNativeQueueCore::Config queueConfig;
+    queueConfig.baseVa = packetAllocation.gpuVa;
+    queueConfig.hostReadIndexVa =
+        mqdAllocation.gpuVa + offsetof(_amd_queue_t, read_dispatch_id);
+    queueConfig.activeQueueId = QueueId;
+    queueConfig.generation = QueueGeneration;
+    queueConfig.registeredIndex = 0;
+    queueConfig.queueBytes = QueueBytes;
+    queueConfig.doorbellBytes = DoorbellBytes;
+    require(queue.registerQueue(queueConfig), queue.failure());
+    require(queue.publish(packetAllocation.gpuVa, packetBytes.data(),
+                          packetBytes.size(), 17),
+            queue.failure());
+    uint32_t registeredIndex = 0;
+    require(queue.ring(1, registeredIndex) && registeredIndex == 0,
+            queue.failure());
+    mqd.write_dispatch_id = 1;
+    require(context.functionalWrite(mqdAllocation.gpuVa, &mqd, sizeof(mqd)),
+            "v2 MQD write index");
+
+    HostNativeQueueCore::FetchedPacket fetched;
+    require(queue.fetch(fetched, nullptr, 17) && fetched.valid(),
+            queue.failure());
+
+    HostNativeDispatchStateV2::Request submitRequest = allocRequest;
+    submitRequest.opcode = protocol::GenericDispatchOpcode::SubmitAql;
+    submitRequest.imageSha256 = staged.manifest.imageSha256;
+    std::copy(
+        staged.manifest.kernelName.begin(), staged.manifest.kernelName.end(),
+        submitRequest.kernelName.begin());
+    submitRequest.queueId = QueueId;
+    submitRequest.queueGeneration = QueueGeneration;
+    submitRequest.queueSequence = 1;
+    submitRequest.submit.kernargAllocationId = allocResponse.kernargAllocationId;
+    submitRequest.submit.kernargGeneration = allocResponse.kernargGeneration;
+    submitRequest.submit.kernargOffset = 0;
+    submitRequest.submit.kernargSize = staged.manifest.kernargSegmentSize;
+    submitRequest.submit.signalId = 7;
+    submitRequest.submit.signalGeneration = 1;
+    submitRequest.submit.expectedSignalValueBits = 1;
+    submitRequest.submit.gridX = 1024;
+    submitRequest.submit.gridY = 1;
+    submitRequest.submit.gridZ = 1;
+    submitRequest.submit.workgroupX = 256;
+    submitRequest.submit.workgroupY = 1;
+    submitRequest.submit.workgroupZ = 1;
+    submitRequest.submit.numWarps = 4;
+    submitRequest.submit.numCtas = 1;
+    submitRequest.submit.wavefrontSize = 64;
+
+    /* The adapter owns the locked CP read shape: no sub-range kernarg
+     * dispatch can reach a CP that reads the full manifest segment. */
+    auto rejectedRangeRequest = submitRequest;
+    rejectedRangeRequest.submit.kernargSize--;
+    HostNativeCommandProcessorCore::Result rejectedResult;
+    HostNativeDispatchStateV2::Response rejectedResponse;
+    require(!adapter.handleSubmit(
+                owner, 17, rejectedRangeRequest, signalAllocation.gpuVa,
+                queue, fetched, rejectedResult, rejectedResponse) &&
+                rejectedResponse.status == protocol::Status::Malformed &&
+                state.failureCode() ==
+                    HostNativeDispatchStateV2::Failure::InvalidRequest &&
+                queue.ownsPending(fetched),
+            "v2 kernarg sub-range rejected");
+
+    /* A CP rejection after queue admission must return the fetched slot to
+     * the queue owner.  Corrupting the mapped descriptor leaves the fetched
+     * packet identity intact, so the failure occurs inside the CP verifier. */
+    uint8_t descriptorByte = 0;
+    require(context.functionalRead(
+                mapResponse.descriptorVa, &descriptorByte, sizeof(descriptorByte)),
+            "v2 descriptor read before CP rejection");
+    const uint8_t rejectedDescriptorByte = descriptorByte ^ 1;
+    require(context.functionalWrite(
+                mapResponse.descriptorVa, &rejectedDescriptorByte,
+                sizeof(rejectedDescriptorByte)),
+            "v2 descriptor corruption");
+    require(!adapter.handleSubmit(
+                owner, 17, submitRequest, signalAllocation.gpuVa, queue,
+                fetched, rejectedResult, rejectedResponse) &&
+                rejectedResponse.status == protocol::Status::ProtocolState &&
+                state.failureCode() ==
+                    HostNativeDispatchStateV2::Failure::CommandProcessor &&
+                !queue.ownsPending(fetched),
+            "v2 malformed CP request rejected");
+    require(context.functionalWrite(
+                mapResponse.descriptorVa, &descriptorByte,
+                sizeof(descriptorByte)),
+            "v2 descriptor restore");
+    require(queue.fetch(fetched, nullptr, 17) && fetched.valid(),
+            queue.failure());
+
+    HostNativeCommandProcessorCore::Result result;
+    HostNativeDispatchStateV2::Response submitResponse;
+    require(adapter.handleSubmit(
+                owner, 17, submitRequest, signalAllocation.gpuVa, queue,
+                fetched, result, submitResponse) &&
+                submitResponse.status == protocol::Status::Ok &&
+                result.taskValid && result.commandProcessorSubmitted &&
+                !result.kernelExecuted && state.hasSubmission() &&
+                submitResponse.traceId != 0,
+            state.failure());
+    require(!protocol::encodeGenericDispatchAck(wireHeader, submitResponse).empty(),
+            "v2 SUBMIT response wire validation");
+
+    HostNativeDispatchStateV2::Response unmapResponse;
+    auto unmapRequest = mapRequest;
+    unmapRequest.opcode = protocol::GenericDispatchOpcode::UnmapObject;
+    unmapRequest.imageSha256 = {};
+    unmapRequest.kernelName = {};
+    unmapRequest.mappingId = mapResponse.mappingId;
+    unmapRequest.mappingGeneration = mapResponse.mappingGeneration;
+    require(!adapter.handleUnmap(owner, 17, unmapRequest, unmapResponse) &&
+                unmapResponse.status == protocol::Status::Busy,
+            "v2 in-flight unmap rejection");
+    auto forgedRetire = submitRequest;
+    forgedRetire.objectGeneration++;
+    require(!adapter.handleRetire(owner, 17, forgedRetire, queue) &&
+                state.hasSubmission() &&
+                state.failureCode() ==
+                    HostNativeDispatchStateV2::Failure::State,
+            "v2 forged retire object identity rejection");
+    forgedRetire = submitRequest;
+    forgedRetire.submit.signalId++;
+    require(!adapter.handleRetire(owner, 17, forgedRetire, queue) &&
+                state.hasSubmission() &&
+                state.failureCode() ==
+                    HostNativeDispatchStateV2::Failure::State,
+            "v2 forged retire signal identity rejection");
+    require(adapter.handleRetire(owner, 17, submitRequest, queue),
+            state.failure());
+    require(adapter.handleUnmap(owner, 18, unmapRequest, unmapResponse) &&
+                unmapResponse.status == protocol::Status::Ok &&
+                !state.hasMapping() && !state.hasKernarg(),
+            state.failure());
+    require(!protocol::encodeGenericDispatchAck(wireHeader, unmapResponse).empty(),
+            "v2 UNMAP response wire validation");
+
+    release(memory, context, owner, dataAllocation, 19);
+    release(memory, context, owner, mqdAllocation, 20);
+    release(memory, context, owner, signalAllocation, 21);
+    release(memory, context, owner, packetAllocation, 22);
+}
+
+} // anonymous namespace
+} // namespace gem5::hostgpu
+
+int
+main(int argc, char **argv)
+{
+    try {
+        const auto image = gem5::hostgpu::readFixture(argc, argv);
+        gem5::hostgpu::runSelfTest(image);
+        std::cout
+            << "{\"schema\":\"gem5.host-native.dispatch-state-v2.v1\","
+               "\"map\":true,\"alloc_kernarg\":true,"
+               "\"owner_bound\":true,\"preload\":\"unsupported\","
+               "\"submit_admitted\":true,\"retired\":true,"
+               "\"unmapped\":true,\"hsa_queue_entry\":true,"
+               "\"wire_ack_valid\":true,\"identity_guards\":true,"
+               "\"cp_failure_cancelled\":true,"
+               "\"gpu_dispatcher\":false,\"compute_unit\":false,"
+               "\"kernel_executed\":false,\"cpu_fallback\":false,"
+               "\"execution_claim\":false}\n";
+    } catch (const std::exception &error) {
+        std::cerr << "host-native dispatch state v2 self-test failed: "
+                  << error.what() << '\n';
+        return 1;
+    }
+    return 0;

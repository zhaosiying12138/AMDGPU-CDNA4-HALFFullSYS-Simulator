+Capabilities
+genericSelectedCapabilities()
+{
+    Capabilities capabilities = topologyCapability();
+    capabilities[QueueControlCapabilityByte] |= QueueControlCapabilityMask;
+    capabilities[MemoryControlCapabilityByte] |= MemoryControlCapabilityMask;
+    capabilities[SignalEventCapabilityByte] |= SignalEventCapabilityMask;
+    capabilities[CodeObjectTransferCapabilityByte] |=
+        CodeObjectTransferCapabilityMask;
+    capabilities[GenericDispatchCapabilityByte] |=
+        GenericDispatchCapabilityMask;
+    return capabilities;
+}
+
+GenericDispatchRequest
+goldenGenericMapRequest()
+{
+    GenericDispatchRequest request;
+    request.opcode = GenericDispatchOpcode::MapObject;
+    request.objectId = 7;
+    request.objectGeneration = 9;
+    request.map.kernargSegmentSize = 48;
+    request.map.kernargSegmentAlign = 8;
+    request.map.pageSize = GenericDispatchPageSize4K;
+    for (size_t index = 0; index < request.imageSha256.size(); ++index)
+        request.imageSha256[index] = static_cast<uint8_t>(index + 1);
+    request.kernelName[0] = 'v';
+    request.kernelName[1] = 'e';
+    request.kernelName[2] = 'c';
+    request.kernelName[3] = 'a';
+    request.kernelName[4] = 'd';
+    request.kernelName[5] = 'd';
+    return request;
+}

+bool
+genericDispatchCapabilitySelected(const Capabilities &selected)
+{
+    return (selected[GenericDispatchCapabilityByte] &
+            GenericDispatchCapabilityMask) != 0 &&
+        (selected[0] & 0x01) != 0 &&
+        (selected[QueueControlCapabilityByte] &
+         QueueControlCapabilityMask) != 0 &&
+        (selected[MemoryControlCapabilityByte] &
+         MemoryControlCapabilityMask) != 0 &&
+        (selected[SignalEventCapabilityByte] &
+         SignalEventCapabilityMask) != 0 &&
+        (selected[CodeObjectTransferCapabilityByte] &
+         CodeObjectTransferCapabilityMask) != 0;
+}

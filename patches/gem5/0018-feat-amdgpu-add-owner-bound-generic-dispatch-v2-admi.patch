+TEST(HostGpuProtocol, GenericDispatchCapabilityUsesWireByteOne)
+{
+    const auto capability = genericDispatchCapability();
+    EXPECT_EQ(capability[0], 0U);
+    EXPECT_EQ(capability[GenericDispatchCapabilityByte],
+              GenericDispatchCapabilityMask);
+
+    auto server = goldenServer();
+    auto hello = goldenHello();
+    const auto selected = genericSelectedCapabilities();
+    server.supported = selected;
+    hello.offered = selected;
+    hello.required = selected;
+    auto negotiated = negotiate(goldenHeader(), hello, server);
+    ASSERT_EQ(negotiated.status, Status::Ok);
+    EXPECT_TRUE(genericDispatchCapabilitySelected(negotiated.selected));
+    EXPECT_EQ(negotiated.selected[GenericDispatchCapabilityByte], 0x01U);
+
+    hello = goldenHello();
+    hello.offered = selected;
+    hello.required = genericDispatchCapability();
+    server.supported = hello.offered;
+    negotiated = negotiate(goldenHeader(), hello, server);
+    EXPECT_EQ(negotiated.status, Status::UnsupportedCapability);
+}

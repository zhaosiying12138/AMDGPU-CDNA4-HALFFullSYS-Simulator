+TEST(HostGpuProtocol, GenericDispatchSuccessIdentityFieldsAreRequired)
+{
+    const auto capabilities = genericSelectedCapabilities();
+    const Header header = goldenMemoryHeader(403);
+
+    GenericDispatchResponse submit;
+    submit.status = Status::Ok;
+    submit.opcode = GenericDispatchOpcode::SubmitAql;
+    submit.objectId = 7;
+    submit.objectGeneration = 9;
+    submit.mappingId = 11;
+    submit.mappingGeneration = 13;
+    submit.queueId = 17;
+    submit.queueGeneration = 19;
+    submit.queueSequence = 23;
+    submit.signalId = 37;
+    submit.signalGeneration = 41;
+    submit.signalValueBits = 1;
+    submit.kernargAllocationId = 29;
+    submit.kernargGeneration = 31;
+    submit.kernargVa = 0x100000004000ULL;
+    submit.kernargSize = 48;
+    submit.kernargAlignment = 8;
+    submit.ticketId = 59;
+    submit.traceId = 67;
+    submit.packetVa = 0x100000005000ULL;
+    submit.imageSha256.fill(0xa5);
+
+    auto frame = encodeGenericDispatchAck(header, submit, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    auto decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Ok);
+
+    /* A successful SUBMIT ACK carries the trace identity used by WAIT. */
+    submit.traceId = 0;
+    EXPECT_TRUE(encodeGenericDispatchAck(header, submit, capabilities).empty());
+    submit.traceId = 67;
+    frame = encodeGenericDispatchAck(header, submit, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    store64(frame, HeaderBytes + 96, 0);
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+
+    GenericDispatchResponse unmap;
+    unmap.status = Status::Ok;
+    unmap.opcode = GenericDispatchOpcode::UnmapObject;
+    unmap.objectId = 7;
+    unmap.objectGeneration = 9;
+    unmap.mappingId = 11;
+    unmap.mappingGeneration = 13;
+
+    frame = encodeGenericDispatchAck(header, unmap, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Ok);
+
+    /* UNMAP is identity-only, but both object and mapping identities remain
+     * mandatory even when its digest is omitted. */
+    unmap.objectId = 0;
+    EXPECT_TRUE(encodeGenericDispatchAck(header, unmap, capabilities).empty());
+    unmap.objectId = 7;
+    unmap.mappingId = 0;
+    EXPECT_TRUE(encodeGenericDispatchAck(header, unmap, capabilities).empty());
+
+    unmap.mappingId = 11;
+    frame = encodeGenericDispatchAck(header, unmap, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    store64(frame, HeaderBytes + 16, 0);
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+
+    frame = encodeGenericDispatchAck(header, unmap, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    store64(frame, HeaderBytes + 32, 0);
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+}

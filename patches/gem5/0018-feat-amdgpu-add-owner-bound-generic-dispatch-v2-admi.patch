+Status
+validateGenericRequest(const GenericDispatchRequest &request,
+                       std::string &reason)
+{
+    if (request.major != GenericDispatchMajor ||
+        request.minor != GenericDispatchMinor) {
+        reason = "generic payload version";
+        return Status::UnsupportedVersion;
+    }
+    const uint16_t rawOpcode = static_cast<uint16_t>(request.opcode);
+    if (request.flags != 0 || request.reserved != 0 ||
+        !validGenericOpcode(rawOpcode)) {
+        reason = "generic request common fields";
+        return Status::Malformed;
+    }
+
+    const bool hashPresent = !genericBytesZero(request.imageSha256);
+    const bool namePresent = genericNulPaddedAscii(request.kernelName);
+    const bool hashAbsent = genericBytesZero(request.imageSha256);
+    const bool nameAbsent = genericBytesZero(request.kernelName);
+
+    switch (request.opcode) {
+      case GenericDispatchOpcode::MapObject:
+        if (request.objectId == 0 || request.objectGeneration == 0 ||
+            request.mappingId != 0 || request.mappingGeneration != 0 ||
+            request.queueId != 0 || request.queueGeneration != 0 ||
+            request.queueSequence != 0 ||
+            request.kernelIndex >= GenericDispatchMaximumKernels ||
+            !hashPresent || !namePresent ||
+            request.map.kernargSegmentSize == 0 ||
+            request.map.kernargSegmentSize > GenericDispatchMaximumKernargBytes ||
+            request.map.kernargSegmentAlign < 8 ||
+            request.map.kernargSegmentAlign > 65536 ||
+            !genericPowerOfTwo(request.map.kernargSegmentAlign) ||
+            (request.map.pageSize != GenericDispatchPageSize4K &&
+             request.map.pageSize != GenericDispatchPageSize64K)) {
+            reason = "invalid MAP_OBJECT fields";
+            return Status::Malformed;
+        }
+        if (request.map.gfxTarget != GenericDispatchGfxTarget) {
+            reason = "generic gfx target";
+            return Status::TopologyMismatch;
+        }
+        if (request.map.relocationCount != 0) {
+            reason = "generic relocations are unsupported";
+            return Status::UnsupportedCapability;
+        }
+        if (request.map.descriptorPreloadDwords != 0) {
+            reason = "generic descriptor preload is unsupported";
+            return Status::UnsupportedCapability;
+        }
+        return Status::Ok;
+
+      case GenericDispatchOpcode::AllocKernarg:
+        if (request.objectId == 0 || request.objectGeneration == 0 ||
+            request.mappingId == 0 || request.mappingGeneration == 0 ||
+            request.queueId != 0 || request.queueGeneration != 0 ||
+            request.queueSequence != 0 || request.kernelIndex != 0 ||
+            !hashAbsent || !nameAbsent ||
+            request.allocKernarg.sizeBytes == 0 ||
+            request.allocKernarg.sizeBytes > GenericDispatchMaximumKernargBytes ||
+            request.allocKernarg.alignmentBytes < 8 ||
+            request.allocKernarg.alignmentBytes > 65536 ||
+            !genericPowerOfTwo(request.allocKernarg.alignmentBytes) ||
+            request.allocKernarg.allocationFlags != 0 ||
+            request.allocKernarg.reserved != 0) {
+            reason = "invalid ALLOC_KERNARG fields";
+            return Status::Malformed;
+        }
+        return Status::Ok;
+
+      case GenericDispatchOpcode::SubmitAql: {
+        const auto &body = request.submit;
+        const uint64_t workgroupSize =
+            static_cast<uint64_t>(body.workgroupX) * body.workgroupY *
+            body.workgroupZ;
+        const uint64_t expectedWorkgroupSize =
+            static_cast<uint64_t>(body.numWarps) * body.wavefrontSize;
+        if (request.objectId == 0 || request.objectGeneration == 0 ||
+            request.mappingId == 0 || request.mappingGeneration == 0 ||
+            request.queueId == 0 || request.queueGeneration == 0 ||
+            request.queueSequence == 0 ||
+            request.kernelIndex >= GenericDispatchMaximumKernels ||
+            !hashPresent || !namePresent ||
+            body.kernargAllocationId == 0 || body.kernargGeneration == 0 ||
+            body.kernargSize == 0 ||
+            body.kernargSize > GenericDispatchMaximumKernargBytes ||
+            body.kernargOffset >
+                GenericDispatchMaximumKernargBytes - body.kernargSize ||
+            body.signalId == 0 || body.signalGeneration == 0 ||
+            body.expectedSignalValueBits != 1 || body.gridX == 0 ||
+            body.gridY == 0 || body.gridZ == 0 || body.workgroupX == 0 ||
+            body.workgroupY == 0 || body.workgroupZ == 0 ||
+            body.workgroupX > GenericDispatchMaximumWorkgroupDimension ||
+            body.workgroupY > GenericDispatchMaximumWorkgroupDimension ||
+            body.workgroupZ > GenericDispatchMaximumWorkgroupDimension ||
+            workgroupSize > GenericDispatchMaximumWorkgroupDimension ||
+            body.gridX < body.workgroupX || body.gridY < body.workgroupY ||
+            body.gridZ < body.workgroupZ || body.numWarps == 0 ||
+            body.numWarps > GenericDispatchMaximumWarps || body.numCtas == 0 ||
+            body.numCtas > GenericDispatchMaximumCtas ||
+            body.sharedMemoryBytes > GenericDispatchMaximumSharedBytes ||
+            body.wavefrontSize != 64 || expectedWorkgroupSize != workgroupSize ||
+            body.launchFlags != 0 || body.reserved != 0) {
+            reason = "invalid SUBMIT_AQL fields";
+            return Status::Malformed;
+        }
+        return Status::Ok;
+      }
+
+      case GenericDispatchOpcode::UnmapObject:
+        if (request.objectId == 0 || request.objectGeneration == 0 ||
+            request.mappingId == 0 || request.mappingGeneration == 0 ||
+            request.queueId != 0 || request.queueGeneration != 0 ||
+            request.queueSequence != 0 || request.kernelIndex != 0 ||
+            !hashAbsent || !nameAbsent) {
+            reason = "invalid UNMAP_OBJECT fields";
+            return Status::Malformed;
+        }
+        /* The active body is empty; decode-side zero-tail validation covers it. */
+        return Status::Ok;
+    }
+    reason = "unknown generic opcode";
+    return Status::Malformed;
+}

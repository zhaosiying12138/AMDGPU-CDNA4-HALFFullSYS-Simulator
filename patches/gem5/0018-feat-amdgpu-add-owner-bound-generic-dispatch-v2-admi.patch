+TEST(HostGpuProtocol, GenericDispatchResponsesCanonicalizeFailures)
+{
+    const auto capabilities = genericSelectedCapabilities();
+    const Header header = goldenMemoryHeader(402);
+    GenericDispatchResponse response;
+    response.status = Status::Ok;
+    response.opcode = GenericDispatchOpcode::MapObject;
+    response.objectId = 7;
+    response.objectGeneration = 9;
+    response.mappingId = 11;
+    response.mappingGeneration = 13;
+    response.mappedBaseVa = 0x100000000000ULL;
+    response.mappedEndVa = 0x100000003000ULL;
+    response.descriptorVa = 0x1000000005c0ULL;
+    response.codeVa = 0x100000001600ULL;
+    response.entryVa = 0x100000001600ULL;
+    response.mappedBytes = 0x3000;
+    response.segmentCount = 3;
+    response.descriptorPreloadDwords = 12;
+    for (size_t index = 0; index < response.imageSha256.size(); ++index)
+        response.imageSha256[index] = static_cast<uint8_t>(index + 1);
+    auto frame = encodeGenericDispatchAck(header, response, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    auto decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.response.descriptorPreloadDwords, 12U);
+
+    response = {};
+    response.status = Status::Ok;
+    response.opcode = GenericDispatchOpcode::SubmitAql;
+    response.objectId = 7;
+    response.objectGeneration = 9;
+    response.mappingId = 11;
+    response.mappingGeneration = 13;
+    response.queueId = 17;
+    response.queueGeneration = 19;
+    response.queueSequence = 23;
+    response.signalId = 37;
+    response.signalGeneration = 41;
+    response.signalValueBits = 1;
+    response.kernargAllocationId = 29;
+    response.kernargGeneration = 31;
+    response.kernargVa = 0x100000004000ULL;
+    response.kernargSize = 48;
+    response.kernargAlignment = 8;
+    response.ticketId = 59;
+    response.traceId = 67;
+    response.packetVa = 0x100000005000ULL;
+    for (size_t index = 0; index < response.imageSha256.size(); ++index)
+        response.imageSha256[index] = static_cast<uint8_t>(index + 1);
+    frame = encodeGenericDispatchCompletion(header, response, capabilities);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchCompletion);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_EQ(decoded.response.packetVa, response.packetVa);
+
+    response = {};
+    response.status = Status::Ok;
+    response.opcode = GenericDispatchOpcode::UnmapObject;
+    response.objectId = 7;
+    response.objectGeneration = 9;
+    response.mappingId = 11;
+    response.mappingGeneration = 13;
+    /* UNMAP identity is sufficient; runtime permits an omitted digest. */
+    frame = encodeGenericDispatchAck(header, response, capabilities);
+    ASSERT_EQ(frame.size(), GenericDispatchRecordBytes);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Ok);
+    EXPECT_TRUE(std::all_of(decoded.response.imageSha256.begin(),
+                            decoded.response.imageSha256.end(),
+                            [](uint8_t byte) { return byte == 0; }));
+
+    response.status = Status::Malformed;
+    response.major = 99;
+    response.minor = 99;
+    response.flags = 0xffff;
+    response.errorCode = 0;
+    response.mappedBaseVa = 0xdeadbeef;
+    response.imageSha256.fill(0xa5);
+    frame = encodeGenericDispatchAck(header, response, capabilities);
+    const uint8_t *payload = frame.data() + HeaderBytes;
+    EXPECT_EQ(load16(payload), GenericDispatchMajor);
+    EXPECT_EQ(load16(payload + 2), GenericDispatchMinor);
+    EXPECT_EQ(load16(payload + 10), 0U);
+    EXPECT_EQ(load64(payload + 48), 0U);
+    EXPECT_TRUE(std::all_of(payload + 272, payload + 272 + Sha256Bytes,
+                            [](uint8_t byte) { return byte == 0; }));
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+    EXPECT_FALSE(decoded.closeConnection);
+
+    /* A failure written on the wire must remain canonical; a stale VA is
+     * rejected even when the frame CRC is recomputed. */
+    store64(frame, HeaderBytes + 48, 0xdeadbeefULL);
+    recomputeCrc(frame);
+    decoded = decodeGenericDispatchResponseRecord(
+        frame.data(), frame.size(), MaximumRecordBytes, capabilities,
+        header.requestId, MessageType::GenericDispatchAck);
+    EXPECT_EQ(decoded.status, Status::Malformed);
+
+    response = {};
+    response.status = Status::Ok;
+    response.opcode = GenericDispatchOpcode::MapObject;
+    response.objectId = 7;
+    response.objectGeneration = 9;
+    response.mappingId = 11;
+    response.mappingGeneration = 13;
+    EXPECT_TRUE(encodeGenericDispatchAck(header, response, capabilities)
+                    .empty());
+}

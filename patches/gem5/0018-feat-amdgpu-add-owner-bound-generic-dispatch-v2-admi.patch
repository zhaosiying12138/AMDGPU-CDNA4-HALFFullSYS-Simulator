+std::vector<uint8_t>
+encodeGenericDispatchRequest(const Header &header,
+                            const GenericDispatchRequest &request)
+{
+    std::string reason;
+    if (validateGenericRequest(request, reason) != Status::Ok)
+        return {};
+    std::vector<uint8_t> payload(GenericDispatchPayloadBytes, 0);
+    storeGenericRequestPayload(payload, request);
+    Header encoded = header;
+    encoded.messageType = MessageType::GenericDispatchRequest;
+    return encodeFrame(encoded, payload);
+}
+
+std::vector<uint8_t>
+encodeGenericDispatchRequest(const Header &header,
+                            const GenericDispatchRequest &request,
+                            const Capabilities &selected)
+{
+    if (!genericDispatchCapabilitySelected(selected))
+        return {};
+    return encodeGenericDispatchRequest(header, request);
+}
+
+std::vector<uint8_t>
+encodeGenericDispatchResponse(MessageType type, const Header &request,
+                              const GenericDispatchResponse &response)
+{
+    if (!genericHeaderType(type) ||
+        static_cast<uint32_t>(response.status) >
+            static_cast<uint32_t>(Status::Internal) ||
+        !validGenericOpcode(static_cast<uint16_t>(response.opcode)))
+        return {};
+    GenericDispatchResponse encodedResponse = response;
+    if (response.status == Status::Ok) {
+        if (!genericResponseSuccessValid(response, type))
+            return {};
+    } else {
+        encodedResponse = canonicalGenericFailure(response);
+    }
+    std::vector<uint8_t> payload(GenericDispatchPayloadBytes, 0);
+    storeGenericResponsePayload(payload, encodedResponse);
+    Header encoded = request;
+    encoded.messageType = type;
+    return encodeFrame(encoded, payload);
+}
+
+std::vector<uint8_t>
+encodeGenericDispatchResponse(MessageType type, const Header &request,
+                              const GenericDispatchResponse &response,
+                              const Capabilities &selected)
+{
+    if (!genericDispatchCapabilitySelected(selected))
+        return {};
+    return encodeGenericDispatchResponse(type, request, response);
+}

+Capabilities
+genericDispatchCapability()
+{
+    Capabilities capabilities = {};
+    /* Runtime capability word 0 bit 8 is byte 1 bit 0 on the wire. */
+    capabilities[GenericDispatchCapabilityByte] =
+        GenericDispatchCapabilityMask;
+    return capabilities;

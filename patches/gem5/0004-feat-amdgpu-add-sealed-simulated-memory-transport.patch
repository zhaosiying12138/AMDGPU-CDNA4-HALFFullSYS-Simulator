+#include "dev/amdgpu/host_gpu_memory_state.hh"
+
+#include <algorithm>
+#include <cassert>
+#include <limits>
+#include <new>
+#include <utility>
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+protocol::MemoryResponse
+HostGPUMemoryState::responseFor(
+    const protocol::MemoryRequest &request, protocol::Status status)
+{
+    protocol::MemoryResponse response;
+    response.status = status;
+    response.opcode = request.opcode;
+    response.allocationId = request.allocationId;
+    response.generation = request.generation;
+    return response;
+}
+
+uint64_t
+HostGPUMemoryState::virtualAddress(size_t slot)
+{
+    assert(slot < MaximumAllocations);
+    assert(slot <=
+           (std::numeric_limits<uint64_t>::max() - VirtualAddressBase) /
+               VirtualAddressStride);
+    return VirtualAddressBase +
+        static_cast<uint64_t>(slot) * VirtualAddressStride;
+}
+
+bool
+HostGPUMemoryState::takeGeneration(uint64_t &generation)
+{
+    if (generationExhausted || nextGeneration == 0)
+        return false;
+    generation = nextGeneration;
+    if (nextGeneration == std::numeric_limits<uint64_t>::max()) {
+        generationExhausted = true;
+    } else {
+        ++nextGeneration;
+    }
+    return true;
+}
+
+HostGPUMemoryState::Allocation *
+HostGPUMemoryState::resolve(
+    const Owner &owner, const protocol::MemoryRequest &request)
+{
+    if (request.allocationId == 0 ||
+        request.allocationId > allocations.size()) {
+        return nullptr;
+    }
+    auto &slot = allocations[request.allocationId - 1];
+    if (!slot || !(slot->owner == owner) ||
+        slot->generation != request.generation) {
+        return nullptr;
+    }
+    return &*slot;
+}
+
+const HostGPUMemoryState::Allocation *
+HostGPUMemoryState::resolve(
+    const Owner &owner, const protocol::MemoryRequest &request) const
+{
+    if (request.allocationId == 0 ||
+        request.allocationId > allocations.size()) {
+        return nullptr;
+    }
+    const auto &slot = allocations[request.allocationId - 1];
+    if (!slot || !(slot->owner == owner) ||
+        slot->generation != request.generation) {
+        return nullptr;
+    }
+    return &*slot;
+}
+
+bool
+HostGPUMemoryState::rangeValid(
+    const Allocation &allocation, const protocol::MemoryRequest &request)
+{
+    return request.offset <= allocation.size &&
+        request.byteCount <= allocation.size - request.offset;
+}
+
+protocol::MemoryResponse
+HostGPUMemoryState::allocate(
+    const Owner &owner, const protocol::MemoryRequest &request, uint64_t now)
+{
+    if (request.byteCount == 0 ||
+        (request.argument != 4096 && request.argument != 65536)) {
+        return responseFor(request, protocol::Status::Malformed);
+    }
+    auto response = responseFor(request, protocol::Status::ResourceExhausted);
+    if (request.byteCount > MaximumAllocationBytes ||
+        request.byteCount > MaximumTotalBytes - liveBytes ||
+        liveAllocations >= MaximumAllocations) {
+        return response;
+    }
+
+    size_t slot = 0;
+    while (slot < allocations.size() && allocations[slot])
+        ++slot;
+    if (slot == allocations.size())
+        return response;
+
+    uint64_t generation = 0;
+    if (!takeGeneration(generation))
+        return response;
+    try {
+        allocations[slot].emplace(Allocation{
+            owner, generation, request.byteCount, request.argument, {}});
+    } catch (const std::bad_alloc &) {
+        return responseFor(request, protocol::Status::Internal);
+    }
+    ++liveAllocations;
+    liveBytes += request.byteCount;
+    response.status = protocol::Status::Ok;
+    response.allocationId = slot + 1;
+    response.generation = generation;
+    response.value0 = virtualAddress(slot);
+    response.value1 = request.byteCount;
+    response.value2 = request.argument;
+    response.simTick = now;
+    return response;
+}
+
+protocol::MemoryResponse
+HostGPUMemoryState::free(
+    const Owner &owner, const protocol::MemoryRequest &request, uint64_t now)
+{
+    auto response = responseFor(request, protocol::Status::ProtocolState);
+    Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr)
+        return response;
+    const uint64_t released = allocation->size;
+    allocations[request.allocationId - 1].reset();
+    --liveAllocations;
+    liveBytes -= released;
+    response.status = protocol::Status::Ok;
+    response.simTick = now;
+    return response;
+}
+
+protocol::MemoryResponse
+HostGPUMemoryState::validateCopy(
+    const Owner &owner, const protocol::MemoryRequest &request) const
+{
+    if (request.byteCount == 0 ||
+        request.offset > std::numeric_limits<uint64_t>::max() -
+            request.byteCount) {
+        return responseFor(request, protocol::Status::Malformed);
+    }
+    auto response = responseFor(request, protocol::Status::ProtocolState);
+    const Allocation *allocation = resolve(owner, request);
+    if (allocation == nullptr || !rangeValid(*allocation, request))
+        return response;
+    if (request.byteCount > MaximumTransferBytes) {
+        response.status = protocol::Status::ResourceExhausted;
+        return response;
+    }
+    response.status = protocol::Status::Ok;
+    return response;
+}
+
+protocol::MemoryResponse
+HostGPUMemoryState::copyFromHost(
+    const Owner &owner, const protocol::MemoryRequest &request,
+    const std::vector<uint8_t> &source, uint64_t now)
+{
+    auto response = validateCopy(owner, request);
+    if (response.status != protocol::Status::Ok)
+        return response;
+    if (request.opcode != protocol::MemoryOpcode::CopyH2D ||
+        source.size() != request.byteCount) {
+        return responseFor(request, protocol::Status::Internal);
+    }
+    const uint32_t crc = protocol::crc32c(source.data(), source.size());
+    if (request.argument != crc)
+        return responseFor(request, protocol::Status::Malformed);
+
+    Allocation *allocation = resolve(owner, request);
+    const uint64_t firstChunk = request.offset / ChunkBytes;
+    const uint64_t lastChunk =
+        (request.offset + request.byteCount - 1) / ChunkBytes;
+    std::vector<std::pair<uint64_t, std::unique_ptr<Chunk>>> prepared;
+    std::vector<uint64_t> inserted;
+    try {
+        prepared.reserve(static_cast<size_t>(lastChunk - firstChunk + 1));
+        for (uint64_t chunk = firstChunk; chunk <= lastChunk; ++chunk) {
+            if (allocation->chunks.find(chunk) == allocation->chunks.end()) {
+                prepared.emplace_back(chunk, std::make_unique<Chunk>());
+            }
+        }
+        allocation->chunks.reserve(
+            allocation->chunks.size() + prepared.size());
+        inserted.reserve(prepared.size());
+        for (auto &entry : prepared) {
+            const auto result = allocation->chunks.emplace(
+                entry.first, std::move(entry.second));
+            if (!result.second)
+                throw std::bad_alloc();
+            inserted.push_back(entry.first);
+        }
+    } catch (const std::bad_alloc &) {
+        for (const uint64_t chunk : inserted)
+            allocation->chunks.erase(chunk);
+        return responseFor(request, protocol::Status::Internal);
+    }
+
+    uint64_t copied = 0;
+    while (copied < request.byteCount) {
+        const uint64_t address = request.offset + copied;
+        const uint64_t chunkIndex = address / ChunkBytes;
+        const size_t chunkOffset = static_cast<size_t>(address % ChunkBytes);
+        const size_t count = static_cast<size_t>(std::min<uint64_t>(
+            request.byteCount - copied, ChunkBytes - chunkOffset));
+        auto &chunk = *allocation->chunks.at(chunkIndex);
+        std::copy_n(source.data() + static_cast<size_t>(copied), count,
+                    chunk.data() + chunkOffset);
+        copied += count;
+    }
+
+    response.status = protocol::Status::Ok;
+    response.value0 = request.offset;
+    response.value1 = request.byteCount;
+    response.value2 = crc;
+    response.simTick = now;
+    return response;
+}
+
+protocol::MemoryResponse
+HostGPUMemoryState::copyToHost(
+    const Owner &owner, const protocol::MemoryRequest &request,
+    std::vector<uint8_t> &destination, uint64_t now) const
+{
+    destination.clear();
+    auto response = validateCopy(owner, request);
+    if (response.status != protocol::Status::Ok)
+        return response;
+    if (request.opcode != protocol::MemoryOpcode::CopyD2H)
+        return responseFor(request, protocol::Status::Internal);
+
+    try {
+        destination.assign(static_cast<size_t>(request.byteCount), 0);
+    } catch (const std::bad_alloc &) {
+        return responseFor(request, protocol::Status::Internal);
+    }
+    const Allocation *allocation = resolve(owner, request);
+    uint64_t copied = 0;
+    while (copied < request.byteCount) {
+        const uint64_t address = request.offset + copied;
+        const uint64_t chunkIndex = address / ChunkBytes;
+        const size_t chunkOffset = static_cast<size_t>(address % ChunkBytes);
+        const size_t count = static_cast<size_t>(std::min<uint64_t>(
+            request.byteCount - copied, ChunkBytes - chunkOffset));
+        const auto found = allocation->chunks.find(chunkIndex);
+        if (found != allocation->chunks.end()) {
+            std::copy_n(found->second->data() + chunkOffset, count,
+                        destination.data() + static_cast<size_t>(copied));
+        }
+        copied += count;
+    }
+    const uint32_t crc = protocol::crc32c(
+        destination.data(), destination.size());
+    response.status = protocol::Status::Ok;
+    response.value0 = request.offset;
+    response.value1 = request.byteCount;
+    response.value2 = crc;
+    response.simTick = now;
+    return response;
+}
+
+void
+HostGPUMemoryState::disconnect(const Owner &owner)
+{
+    for (auto &slot : allocations) {
+        if (slot && slot->owner == owner) {
+            liveBytes -= slot->size;
+            --liveAllocations;
+            slot.reset();
+        }
+    }
+}
+
+void
+HostGPUMemoryState::clear()
+{
+    for (auto &slot : allocations)
+        slot.reset();
+    liveAllocations = 0;
+    liveBytes = 0;
+}
+
+size_t
+HostGPUMemoryState::committedChunkCount() const
+{
+    size_t count = 0;
+    for (const auto &slot : allocations) {
+        if (slot)
+            count += slot->chunks.size();
+    }
+    return count;
+}
+
+} // namespace hostgpu
+} // namespace gem5

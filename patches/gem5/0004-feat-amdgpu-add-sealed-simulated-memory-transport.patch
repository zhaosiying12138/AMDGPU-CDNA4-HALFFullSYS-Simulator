+void
+HostGPUBridge::processMemoryRecord(const PendingRecord &record)
+{
+    auto found = clients.find(record.clientFd);
+    if (found == clients.end() ||
+        found->second->generation != record.generation) {
+        return;
+    }
+    Client &client = *found->second;
+    const auto decoded = protocol::decodeMemoryRequestRecord(
+        record.bytes.data(), record.bytes.size(), maximumRecord);
+    if (decoded.action == protocol::DecodeAction::Drop) {
+        if (decoded.closeConnection)
+            closeClient(record.clientFd);
+        return;
+    }
+
+    const bool copyOpcode =
+        decoded.request.opcode == protocol::MemoryOpcode::CopyH2D ||
+        decoded.request.opcode == protocol::MemoryOpcode::CopyD2H;
+    const bool hasCarrier = static_cast<bool>(record.carrier);
+    protocol::Status decodedStatus = decoded.status;
+    if (copyOpcode != hasCarrier)
+        decodedStatus = protocol::Status::Malformed;
+
+    protocol::Status sessionStatus = protocol::Status::Ok;
+    const bool memorySelected =
+        (client.selectedCapabilities[
+             protocol::MemoryControlCapabilityByte] &
+         protocol::MemoryControlCapabilityMask) != 0;
+    if (decoded.header.daemonUuid != identity.daemonUuid) {
+        sessionStatus = protocol::Status::InstanceMismatch;
+    } else if (decoded.header.connectionId != client.connectionId) {
+        sessionStatus = protocol::Status::ProtocolState;
+    } else if (decoded.header.jobEpoch != identity.jobEpoch) {
+        sessionStatus = protocol::Status::TopologyMismatch;
+    } else if (!memorySelected) {
+        sessionStatus = protocol::Status::UnsupportedCapability;
+    }
+    protocol::Status status = queueRequestStatus(
+        decodedStatus, sessionStatus);
+    if (status == protocol::Status::Ok) {
+        if (client.requestIds.observe(decoded.header.requestId) !=
+            RequestIdResult::Fresh) {
+            status = protocol::Status::ProtocolState;
+        }
+    }
+
+    protocol::MemoryResponse response = memoryFailure(
+        decoded.request, status);
+    if (status == protocol::Status::Ok) {
+        const HostGPUMemoryState::Owner owner{
+            record.clientFd, record.generation};
+        switch (decoded.request.opcode) {
+          case protocol::MemoryOpcode::Allocate:
+            response = memoryState.allocate(
+                owner, decoded.request, curTick());
+            break;
+          case protocol::MemoryOpcode::Free:
+            response = memoryState.free(owner, decoded.request, curTick());
+            break;
+          case protocol::MemoryOpcode::CopyH2D:
+          case protocol::MemoryOpcode::CopyD2H: {
+            response = memoryState.validateCopy(owner, decoded.request);
+            if (response.status != protocol::Status::Ok)
+                break;
+            const auto access = decoded.request.opcode ==
+                    protocol::MemoryOpcode::CopyH2D ?
+                MemoryCarrierAccess::HostToDevice :
+                MemoryCarrierAccess::DeviceToHost;
+            if (!validateMemoryCarrier(
+                    record.carrier.get(), client.uid,
+                    decoded.request.byteCount, access)) {
+                response = memoryFailure(
+                    decoded.request, protocol::Status::Unauthorized);
+                break;
+            }
+
+            std::vector<uint8_t> bytes;
+            if (decoded.request.opcode ==
+                    protocol::MemoryOpcode::CopyH2D) {
+                try {
+                    bytes.resize(
+                        static_cast<size_t>(decoded.request.byteCount));
+                } catch (const std::bad_alloc &) {
+                    response = memoryFailure(
+                        decoded.request, protocol::Status::Internal);
+                    break;
+                }
+                if (!readExactAt(record.carrier.get(), bytes)) {
+                    response = memoryFailure(
+                        decoded.request, protocol::Status::Internal);
+                    break;
+                }
+                response = memoryState.copyFromHost(
+                    owner, decoded.request, bytes, curTick());
+                break;
+            }
+
+            response = memoryState.copyToHost(
+                owner, decoded.request, bytes, curTick());
+            if (response.status != protocol::Status::Ok)
+                break;
+            const auto writeResult = writeMemoryCarrier(
+                record.carrier.get(), bytes.data(), bytes.size());
+            if (writeResult != MemoryCarrierIoResult::Ok) {
+                response = memoryFailure(
+                    decoded.request,
+                    writeResult == MemoryCarrierIoResult::ResourceExhausted ?
+                        protocol::Status::ResourceExhausted :
+                        protocol::Status::Internal);
+                break;
+            }
+            const auto finalizeResult = finalizeDeviceToHostCarrier(
+                record.carrier.get());
+            if (finalizeResult != MemoryCarrierFinalizeResult::Ok) {
+                response = memoryFailure(
+                    decoded.request,
+                    finalizeResult ==
+                            MemoryCarrierFinalizeResult::Unauthorized ?
+                        protocol::Status::Unauthorized :
+                        protocol::Status::Internal);
+                break;
+            }
+            std::vector<uint8_t> verified;
+            try {
+                verified.resize(bytes.size());
+            } catch (const std::bad_alloc &) {
+                response = memoryFailure(
+                    decoded.request, protocol::Status::Internal);
+                break;
+            }
+            if (!readExactAt(record.carrier.get(), verified) ||
+                verified != bytes ||
+                protocol::crc32c(verified.data(), verified.size()) !=
+                    response.value2) {
+                response = memoryFailure(
+                    decoded.request, protocol::Status::Internal);
+            }
+            break;
+          }
+        }
+    }
+
+    client.state.finishEstablishedRecord();
+    const auto responseHeader = protocol::queueResponseHeader(
+        decoded.header, identity, client.connectionId);
+    const auto encoded = protocol::encodeMemoryAck(responseHeader, response);
+    sendQueueResponse(record.clientFd, record.generation, encoded,
+                      OutboundKind::MemoryAck);
+}

+
+namespace gem5::hostgpu
+{
+namespace
+{
+
+HostGPUMemoryState::Owner
+owner(int fd = 7, uint64_t generation = 11)
+{
+    return {fd, generation};
+}
+
+protocol::MemoryRequest
+allocate(uint64_t bytes, uint64_t alignment = 4096)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Allocate;
+    request.byteCount = bytes;
+    request.argument = alignment;
+    return request;
+}
+
+protocol::MemoryRequest
+freeRequest(const protocol::MemoryResponse &allocation)
+{
+    protocol::MemoryRequest request;
+    request.opcode = protocol::MemoryOpcode::Free;
+    request.allocationId = allocation.allocationId;
+    request.generation = allocation.generation;
+    return request;
+}
+
+protocol::MemoryRequest
+copyRequest(const protocol::MemoryResponse &allocation,
+            protocol::MemoryOpcode opcode, uint64_t offset, uint64_t bytes)
+{
+    protocol::MemoryRequest request;
+    request.opcode = opcode;
+    request.allocationId = allocation.allocationId;
+    request.generation = allocation.generation;
+    request.offset = offset;
+    request.byteCount = bytes;
+    return request;
+}
+
+TEST(HostGPUMemoryState, LargeAllocationIsSparseAndInitiallyZero)
+{
+    HostGPUMemoryState state;
+    const auto allocation = state.allocate(
+        owner(), allocate(HostGPUMemoryState::MaximumAllocationBytes, 65536),
+        10);
+    ASSERT_EQ(allocation.status, protocol::Status::Ok);
+    EXPECT_EQ(allocation.allocationId, 1U);
+    EXPECT_NE(allocation.generation, 0U);
+    EXPECT_EQ(allocation.value0, HostGPUMemoryState::VirtualAddressBase);
+    EXPECT_EQ(allocation.value1,
+              HostGPUMemoryState::MaximumAllocationBytes);
+    EXPECT_EQ(state.committedChunkCount(), 0U);
+
+    auto read = copyRequest(allocation, protocol::MemoryOpcode::CopyD2H,
+                            HostGPUMemoryState::ChunkBytes - 8, 16);
+    std::vector<uint8_t> bytes;
+    const auto response = state.copyToHost(owner(), read, bytes, 11);
+    EXPECT_EQ(response.status, protocol::Status::Ok);
+    EXPECT_EQ(bytes, std::vector<uint8_t>(16, 0));
+    EXPECT_EQ(state.committedChunkCount(), 0U);
+}
+
+TEST(HostGPUMemoryState, CrossChunkWriteCommitsOnlyAfterCrcValidation)
+{
+    HostGPUMemoryState state;
+    const auto allocation = state.allocate(
+        owner(), allocate(HostGPUMemoryState::ChunkBytes * 2), 1);
+    ASSERT_EQ(allocation.status, protocol::Status::Ok);
+
+    std::vector<uint8_t> source(96);
+    for (size_t index = 0; index < source.size(); ++index)
+        source[index] = static_cast<uint8_t>(index * 7 + 3);
+    auto write = copyRequest(allocation, protocol::MemoryOpcode::CopyH2D,
+                             HostGPUMemoryState::ChunkBytes - 8,
+                             source.size());
+    write.argument = protocol::crc32c(source.data(), source.size()) ^ 1U;
+    EXPECT_EQ(state.copyFromHost(owner(), write, source, 2).status,
+              protocol::Status::Malformed);
+    EXPECT_EQ(state.committedChunkCount(), 0U);
+
+    write.argument = protocol::crc32c(source.data(), source.size());
+    const auto stored = state.copyFromHost(owner(), write, source, 3);
+    EXPECT_EQ(stored.status, protocol::Status::Ok);
+    EXPECT_EQ(stored.value0, write.offset);
+    EXPECT_EQ(stored.value1, source.size());
+    EXPECT_EQ(stored.value2, write.argument);
+    EXPECT_EQ(state.committedChunkCount(), 2U);
+
+    auto read = copyRequest(allocation, protocol::MemoryOpcode::CopyD2H,
+                            write.offset - 4, source.size() + 8);
+    std::vector<uint8_t> result;
+    const auto loaded = state.copyToHost(owner(), read, result, 4);
+    ASSERT_EQ(loaded.status, protocol::Status::Ok);
+    ASSERT_EQ(result.size(), source.size() + 8);
+    EXPECT_TRUE(std::all_of(result.begin(), result.begin() + 4,
+                            [](uint8_t byte) { return byte == 0; }));
+    EXPECT_TRUE(std::equal(source.begin(), source.end(), result.begin() + 4));
+    EXPECT_TRUE(std::all_of(result.end() - 4, result.end(),
+                            [](uint8_t byte) { return byte == 0; }));
+    EXPECT_EQ(loaded.value2, protocol::crc32c(result.data(), result.size()));
+}
+
+TEST(HostGPUMemoryState, ReusesSlotOnlyWithNewGenerationAndZeroBacking)
+{
+    HostGPUMemoryState state;
+    const auto first = state.allocate(owner(), allocate(65536), 1);
+    ASSERT_EQ(first.status, protocol::Status::Ok);
+    std::vector<uint8_t> bytes(16, 0xa5);
+    auto write = copyRequest(
+        first, protocol::MemoryOpcode::CopyH2D, 0, bytes.size());
+    write.argument = protocol::crc32c(bytes.data(), bytes.size());
+    ASSERT_EQ(state.copyFromHost(owner(), write, bytes, 2).status,
+              protocol::Status::Ok);
+    ASSERT_EQ(state.free(owner(), freeRequest(first), 3).status,
+              protocol::Status::Ok);
+
+    const auto second = state.allocate(owner(), allocate(65536), 4);
+    ASSERT_EQ(second.status, protocol::Status::Ok);
+    EXPECT_EQ(second.allocationId, first.allocationId);
+    EXPECT_NE(second.generation, first.generation);
+    EXPECT_EQ(second.value0, first.value0);
+    EXPECT_EQ(state.free(owner(), freeRequest(first), 5).status,
+              protocol::Status::ProtocolState);
+
+    std::vector<uint8_t> loaded;
+    const auto read = copyRequest(
+        second, protocol::MemoryOpcode::CopyD2H, 0, bytes.size());
+    ASSERT_EQ(state.copyToHost(owner(), read, loaded, 6).status,
+              protocol::Status::Ok);
+    EXPECT_EQ(loaded, std::vector<uint8_t>(bytes.size(), 0));
+}
+
+TEST(HostGPUMemoryState, EnforcesRangeTransferAndLogicalByteLimits)
+{
+    HostGPUMemoryState state;
+    const auto first = state.allocate(
+        owner(), allocate(HostGPUMemoryState::MaximumAllocationBytes), 1);
+    const auto second = state.allocate(
+        owner(), allocate(HostGPUMemoryState::MaximumAllocationBytes), 2);
+    ASSERT_EQ(first.status, protocol::Status::Ok);
+    ASSERT_EQ(second.status, protocol::Status::Ok);
+    EXPECT_EQ(state.totalBytes(), HostGPUMemoryState::MaximumTotalBytes);
+    EXPECT_EQ(state.allocate(owner(), allocate(1), 3).status,
+              protocol::Status::ResourceExhausted);
+    const auto tooLarge = state.allocate(
+        owner(), allocate(HostGPUMemoryState::MaximumAllocationBytes + 1), 4);
+    EXPECT_EQ(tooLarge.status, protocol::Status::ResourceExhausted);
+    EXPECT_EQ(tooLarge.value0, 0U);
+    EXPECT_EQ(tooLarge.value1, 0U);
+    EXPECT_EQ(tooLarge.value2, 0U);
+    EXPECT_EQ(tooLarge.simTick, 0U);
+
+    auto oversized = copyRequest(
+        first, protocol::MemoryOpcode::CopyD2H, 0,
+        HostGPUMemoryState::MaximumTransferBytes + 1);
+    EXPECT_EQ(state.validateCopy(owner(), oversized).status,
+              protocol::Status::ResourceExhausted);
+    auto outside = copyRequest(
+        first, protocol::MemoryOpcode::CopyD2H,
+        HostGPUMemoryState::MaximumAllocationBytes - 7, 8);
+    EXPECT_EQ(state.validateCopy(owner(), outside).status,
+              protocol::Status::ProtocolState);
+    EXPECT_EQ(state.validateCopy(owner(8, 11),
+                                 copyRequest(first,
+                                     protocol::MemoryOpcode::CopyD2H, 0, 1))
+                  .status,
+              protocol::Status::ProtocolState);
+
+    auto zero = copyRequest(
+        first, protocol::MemoryOpcode::CopyD2H, 0, 0);
+    EXPECT_EQ(state.validateCopy(owner(), zero).status,
+              protocol::Status::Malformed);
+    auto overflow = copyRequest(
+        first, protocol::MemoryOpcode::CopyD2H,
+        std::numeric_limits<uint64_t>::max(), 2);
+    EXPECT_EQ(state.validateCopy(owner(), overflow).status,
+              protocol::Status::Malformed);
+}
+
+TEST(HostGPUMemoryState, SlotSevenUsesFrozenVirtualAddressFormula)
+{
+    HostGPUMemoryState state;
+    protocol::MemoryResponse seventh;
+    for (size_t slot = 0; slot < 7; ++slot) {
+        seventh = state.allocate(owner(), allocate(4096), slot + 1);
+        ASSERT_EQ(seventh.status, protocol::Status::Ok);
+    }
+    EXPECT_EQ(seventh.allocationId, 7U);
+    EXPECT_EQ(seventh.value0, 0x0000100300000000ULL);
+}
+
+TEST(HostGPUMemoryState, ClearDoesNotReuseDaemonLifetimeGeneration)
+{
+    HostGPUMemoryState state;
+    const auto first = state.allocate(owner(), allocate(4096), 1);
+    ASSERT_EQ(first.status, protocol::Status::Ok);
+    state.clear();
+    const auto second = state.allocate(owner(), allocate(4096), 2);
+    ASSERT_EQ(second.status, protocol::Status::Ok);
+    EXPECT_EQ(second.allocationId, first.allocationId);
+    EXPECT_GT(second.generation, first.generation);
+}
+
+TEST(HostGPUMemoryState, DisconnectReclaimsOnlyMatchingClientGeneration)
+{
+    HostGPUMemoryState state;
+    const auto first = state.allocate(owner(9, 1), allocate(4096), 1);
+    const auto second = state.allocate(owner(9, 2), allocate(8192), 2);
+    ASSERT_EQ(first.status, protocol::Status::Ok);
+    ASSERT_EQ(second.status, protocol::Status::Ok);
+    state.disconnect(owner(9, 1));
+    EXPECT_EQ(state.allocationCount(), 1U);
+    EXPECT_EQ(state.totalBytes(), 8192U);
+    EXPECT_EQ(state.free(owner(9, 1), freeRequest(first), 3).status,
+              protocol::Status::ProtocolState);
+    EXPECT_EQ(state.free(owner(9, 2), freeRequest(second), 4).status,
+              protocol::Status::Ok);
+    EXPECT_EQ(state.allocationCount(), 0U);
+}
+
+TEST(HostGPUMemoryState, EnforcesSlotLimitWithoutEagerBacking)
+{
+    HostGPUMemoryState state;
+    std::vector<protocol::MemoryResponse> allocations;
+    allocations.reserve(HostGPUMemoryState::MaximumAllocations);
+    for (size_t index = 0; index < HostGPUMemoryState::MaximumAllocations;
+         ++index) {
+        const auto allocation = state.allocate(owner(), allocate(1), index);
+        ASSERT_EQ(allocation.status, protocol::Status::Ok);
+        allocations.push_back(allocation);
+    }
+    EXPECT_EQ(state.committedChunkCount(), 0U);
+    EXPECT_EQ(state.allocate(owner(), allocate(1), 2000).status,
+              protocol::Status::ResourceExhausted);
+}
+
+} // anonymous namespace
+} // namespace gem5::hostgpu

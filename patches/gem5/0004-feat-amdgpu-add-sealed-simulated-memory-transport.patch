+{
+    reset();
+}
+
+OwnedFileDescriptor::OwnedFileDescriptor(OwnedFileDescriptor &&other) noexcept
+    : descriptor(other.release())
+{
+}
+
+OwnedFileDescriptor &
+OwnedFileDescriptor::operator=(OwnedFileDescriptor &&other) noexcept
+{
+    if (this != &other)
+        reset(other.release());
+    return *this;
+}
+
+int
+OwnedFileDescriptor::release()
+{
+    const int fd = descriptor;
+    descriptor = -1;
+    return fd;
+}
+
+void
+OwnedFileDescriptor::reset(int fd)
+{
+    if (descriptor >= 0)
+        ::close(descriptor);
+    descriptor = fd;
+}
+
+ReceivedRights
+takeReceivedFileDescriptor(const msghdr &message)
+{
+    ReceivedRights result;
+    bool sawControl = false;
+    bool invalid = false;
+
+    const bool structurallyValid = walkControlMessages(
+        message, [&](const cmsghdr &control, const uint8_t *payload,
+                     size_t payloadBytes) {
+        sawControl = true;
+        if (control.cmsg_level != SOL_SOCKET ||
+            control.cmsg_type != SCM_RIGHTS) {
+            invalid = true;
+            return;
+        }
+        if (payloadBytes == 0 || payloadBytes % sizeof(int) != 0)
+            invalid = true;
+        const size_t descriptorCount = payloadBytes / sizeof(int);
+        for (size_t index = 0; index < descriptorCount; ++index) {
+            int fd = -1;
+            std::memcpy(&fd, payload + index * sizeof(fd),
+                        sizeof(fd));
+            if (fd < 0) {
+                invalid = true;
+                continue;
+            }
+            ++result.visibleCount;
+            if (!result.descriptor) {
+                result.descriptor.reset(fd);
+            } else {
+                ::close(fd);
+            }
+        }
+    });
+
+    if (!structurallyValid || (message.msg_controllen != 0 && !sawControl))
+        invalid = true;
+    if (invalid || result.visibleCount > 1) {
+        result.descriptor.reset();
+        result.status = ReceivedRightsStatus::Invalid;
+    } else if (result.visibleCount == 1) {
+        result.status = ReceivedRightsStatus::One;
+    }
+    return result;
+}
+
+bool
+validateMemoryCarrier(int fd, uid_t owner, uint64_t byteCount,
+                      MemoryCarrierAccess access)
+{
+    if (fd < 0 || byteCount == 0 ||
+        byteCount > static_cast<uint64_t>(std::numeric_limits<off_t>::max())) {
+        return false;
+    }
+    struct stat metadata = {};
+    if (::fstat(fd, &metadata) != 0 || !S_ISREG(metadata.st_mode) ||
+        metadata.st_uid != owner || metadata.st_nlink != 0 ||
+        (metadata.st_mode & 07777) != 0600 || metadata.st_size < 0 ||
+        static_cast<uint64_t>(metadata.st_size) != byteCount) {
+        return false;
+    }
+    const int descriptorFlags = ::fcntl(fd, F_GETFD);
+    const int fileFlags = ::fcntl(fd, F_GETFL);
+    const int seals = ::fcntl(fd, F_GET_SEALS);
+    if (descriptorFlags < 0 || (descriptorFlags & FD_CLOEXEC) == 0 ||
+        fileFlags < 0 || seals < 0) {
+        return false;
+    }
+
+    constexpr int SizeSeals = F_SEAL_SHRINK | F_SEAL_GROW;
+    constexpr int CompleteSeals =
+        SizeSeals | F_SEAL_WRITE | F_SEAL_SEAL;
+    const int mode = fileFlags & O_ACCMODE;
+    if (access == MemoryCarrierAccess::HostToDevice) {
+        return (mode == O_RDONLY || mode == O_RDWR) &&
+               seals == CompleteSeals;
+    }
+    return mode == O_RDWR && seals == SizeSeals;
+}
+
+MemoryCarrierIoResult
+writeMemoryCarrier(int fd, const uint8_t *bytes, size_t size)
+{
+    size_t offset = 0;
+    while (offset < size) {
+        const ssize_t result = ::pwrite(
+            fd, bytes + offset, size - offset, static_cast<off_t>(offset));
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result < 0) {
+            return errno == ENOSPC ?
+                MemoryCarrierIoResult::ResourceExhausted :
+                MemoryCarrierIoResult::Internal;
+        }
+        if (result == 0)
+            return MemoryCarrierIoResult::Internal;
+        offset += static_cast<size_t>(result);
+    }
+    return MemoryCarrierIoResult::Ok;
+}
+
+MemoryCarrierFinalizeResult
+finalizeDeviceToHostCarrier(int fd)
+{
+    constexpr int CompleteSeals = F_SEAL_SHRINK | F_SEAL_GROW |
+        F_SEAL_WRITE | F_SEAL_SEAL;
+    if (::fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE | F_SEAL_SEAL) != 0) {
+        return errno == EBUSY ? MemoryCarrierFinalizeResult::Unauthorized :
+            MemoryCarrierFinalizeResult::Internal;
+    }
+    return ::fcntl(fd, F_GET_SEALS) == CompleteSeals ?
+        MemoryCarrierFinalizeResult::Ok :
+        MemoryCarrierFinalizeResult::Internal;
+}

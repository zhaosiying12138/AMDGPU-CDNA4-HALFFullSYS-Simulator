+MemoryDecodeResult
+decodeMemoryRequestRecord(const uint8_t *record, size_t size,
+                          uint32_t configuredMaximum)
+{
+    Header header;
+    const uint8_t *payload = nullptr;
+    std::string reason;
+    if (!decodeEstablishedEnvelope(record, size, configuredMaximum, header,
+                                   payload, reason)) {
+        MemoryDecodeResult result;
+        result.reason = reason;
+        return result;
+    }
+    if (header.messageType != MessageType::MemoryRequest) {
+        MemoryDecodeResult result;
+        result.reason = "expected MEMORY_REQUEST";
+        return result;
+    }
+    if (size - HeaderBytes != MemoryPayloadBytes) {
+        MemoryDecodeResult result;
+        result.reason = "memory payload length";
+        return result;
+    }
+
+    MemoryRequest request;
+    request.major = load16(payload);
+    request.minor = load16(payload + 2);
+    const uint16_t rawOpcode = load16(payload + 4);
+    request.opcode = static_cast<MemoryOpcode>(rawOpcode);
+    request.flags = load16(payload + 6);
+    request.allocationId = load64(payload + 8);
+    request.generation = load64(payload + 16);
+    request.offset = load64(payload + 24);
+    request.byteCount = load64(payload + 32);
+    request.argument = load64(payload + 40);
+    const uint64_t reserved0 = load64(payload + 48);
+    const uint64_t reserved1 = load64(payload + 56);
+
+    auto acknowledge = [&](Status status, const std::string &why) {
+        MemoryDecodeResult result;
+        result.action = DecodeAction::Acknowledge;
+        result.closeConnection = false;
+        result.status = status;
+        result.reason = why;
+        result.header = header;
+        result.request = request;
+        return result;
+    };
+
+    if (!validMemoryOpcode(rawOpcode) || request.flags != 0 ||
+        reserved0 != 0 || reserved1 != 0) {
+        return acknowledge(Status::Malformed,
+                           "invalid simulated-memory fields");
+    }
+
+    switch (request.opcode) {
+      case MemoryOpcode::Allocate:
+        if (request.allocationId != 0 || request.generation != 0 ||
+            request.offset != 0 || request.byteCount == 0 ||
+            (request.argument != 4096 && request.argument != 65536)) {
+            return acknowledge(Status::Malformed,
+                               "invalid allocation fields");
+        }
+        break;
+      case MemoryOpcode::Free:
+        if (request.allocationId == 0 || request.generation == 0 ||
+            request.offset != 0 || request.byteCount != 0 ||
+            request.argument != 0) {
+            return acknowledge(Status::Malformed, "invalid free fields");
+        }
+        break;
+      case MemoryOpcode::CopyH2D:
+        if (request.allocationId == 0 || request.generation == 0 ||
+            request.byteCount == 0 ||
+            request.offset > std::numeric_limits<uint64_t>::max() -
+                request.byteCount ||
+            request.argument > std::numeric_limits<uint32_t>::max()) {
+            return acknowledge(Status::Malformed, "invalid H2D fields");
+        }
+        break;
+      case MemoryOpcode::CopyD2H:
+        if (request.allocationId == 0 || request.generation == 0 ||
+            request.byteCount == 0 ||
+            request.offset > std::numeric_limits<uint64_t>::max() -
+                request.byteCount ||
+            request.argument != 0) {
+            return acknowledge(Status::Malformed, "invalid D2H fields");
+        }
+        break;
+    }
+    if (request.major != MemoryControlMajor ||
+        request.minor != MemoryControlMinor) {
+        return acknowledge(Status::UnsupportedVersion,
+                           "unsupported simulated-memory version");
+    }
+    return acknowledge(Status::Ok, "valid simulated-memory request");
+}

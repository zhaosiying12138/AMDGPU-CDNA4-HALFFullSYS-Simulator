+#ifndef __DEV_AMDGPU_HOST_GPU_MEMORY_STATE_HH__
+#define __DEV_AMDGPU_HOST_GPU_MEMORY_STATE_HH__
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+#include "dev/amdgpu/host_gpu_protocol.hh"
+
+namespace gem5
+{
+namespace hostgpu
+{
+
+/** Bounded bridge-owned functional memory; no GPU packet path is involved. */
+class HostGPUMemoryState
+{
+  public:
+    static constexpr size_t MaximumAllocations = 1024;
+    static constexpr uint64_t MaximumAllocationBytes = 2ULL << 30;
+    static constexpr uint64_t MaximumTotalBytes = 4ULL << 30;
+    static constexpr uint64_t MaximumTransferBytes = 16ULL << 20;
+    static constexpr size_t ChunkBytes = 64ULL << 10;
+    static constexpr uint64_t VirtualAddressBase = 0x0000100000000000ULL;
+    static constexpr uint64_t VirtualAddressStride = 2ULL << 30;
+
+    struct Owner
+    {
+        int fd = -1;
+        uint64_t clientGeneration = 0;
+
+        bool operator==(const Owner &other) const
+        {
+            return fd == other.fd &&
+                   clientGeneration == other.clientGeneration;
+        }
+    };
+
+    protocol::MemoryResponse allocate(
+        const Owner &owner, const protocol::MemoryRequest &request,
+        uint64_t now);
+    protocol::MemoryResponse free(
+        const Owner &owner, const protocol::MemoryRequest &request,
+        uint64_t now);
+    protocol::MemoryResponse validateCopy(
+        const Owner &owner, const protocol::MemoryRequest &request) const;
+    protocol::MemoryResponse copyFromHost(
+        const Owner &owner, const protocol::MemoryRequest &request,
+        const std::vector<uint8_t> &source, uint64_t now);
+    protocol::MemoryResponse copyToHost(
+        const Owner &owner, const protocol::MemoryRequest &request,
+        std::vector<uint8_t> &destination, uint64_t now) const;
+
+    void disconnect(const Owner &owner);
+    void clear();
+
+    size_t allocationCount() const { return liveAllocations; }
+    uint64_t totalBytes() const { return liveBytes; }
+    size_t committedChunkCount() const;
+
+  private:
+    using Chunk = std::array<uint8_t, ChunkBytes>;
+
+    struct Allocation
+    {
+        Owner owner;
+        uint64_t generation = 0;
+        uint64_t size = 0;
+        uint64_t alignment = 0;
+        std::unordered_map<uint64_t, std::unique_ptr<Chunk>> chunks;
+    };
+
+    static protocol::MemoryResponse responseFor(
+        const protocol::MemoryRequest &request, protocol::Status status);
+    Allocation *resolve(
+        const Owner &owner, const protocol::MemoryRequest &request);
+    const Allocation *resolve(
+        const Owner &owner, const protocol::MemoryRequest &request) const;
+    static bool rangeValid(
+        const Allocation &allocation, const protocol::MemoryRequest &request);
+    bool takeGeneration(uint64_t &generation);
+    static uint64_t virtualAddress(size_t slot);
+
+    std::array<std::optional<Allocation>, MaximumAllocations> allocations;
+    uint64_t nextGeneration = 1;
+    bool generationExhausted = false;
+    size_t liveAllocations = 0;
+    uint64_t liveBytes = 0;
+};
+
+} // namespace hostgpu
+} // namespace gem5
+
+#endif // __DEV_AMDGPU_HOST_GPU_MEMORY_STATE_HH__

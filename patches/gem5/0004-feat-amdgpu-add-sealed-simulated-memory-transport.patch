+template <typename Visitor>
+bool
+walkControlMessages(const msghdr &message, Visitor &&visitor)
+{
+    if (message.msg_controllen == 0)
+        return true;
+    if (message.msg_control == nullptr)
+        return false;
+
+    const auto *control = static_cast<const uint8_t *>(message.msg_control);
+    size_t offset = 0;
+    while (offset < message.msg_controllen) {
+        const size_t remaining = message.msg_controllen - offset;
+        if (remaining < CMSG_LEN(0))
+            return false;
+
+        cmsghdr header = {};
+        std::memcpy(&header, control + offset, sizeof(header));
+        if (header.cmsg_len < CMSG_LEN(0) ||
+            header.cmsg_len > remaining) {
+            return false;
+        }
+        const size_t payloadBytes = header.cmsg_len - CMSG_LEN(0);
+        visitor(header, control + offset + CMSG_LEN(0), payloadBytes);
+
+        const size_t aligned = CMSG_ALIGN(header.cmsg_len);
+        if (aligned > remaining) {
+            if (header.cmsg_len != remaining)
+                return false;
+            offset = message.msg_controllen;
+        } else {
+            offset += aligned;
+        }
+    }
+    return true;
+}

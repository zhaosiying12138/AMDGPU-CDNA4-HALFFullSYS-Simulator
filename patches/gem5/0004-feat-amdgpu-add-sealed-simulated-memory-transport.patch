+TEST(HostGPUSocketUtils, TakesOneDescriptorAndClosesMultipleDescriptors)
+{
+    int sockets[2] = {-1, -1};
+    ASSERT_EQ(::socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets),
+              0);
+    int pipeFds[2] = {-1, -1};
+    ASSERT_EQ(::pipe2(pipeFds, O_CLOEXEC), 0);
+
+    ASSERT_GT(sendRights(sockets[0], pipeFds, 1, true), 0);
+    std::array<uint8_t, 1> payload = {};
+    alignas(cmsghdr)
+        std::array<uint8_t, CMSG_SPACE(sizeof(int) * 2)> control = {};
+    msghdr message = {};
+    iovec vector = {payload.data(), payload.size()};
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.data();
+    message.msg_controllen = control.size();
+    ASSERT_EQ(::recvmsg(sockets[1], &message, MSG_CMSG_CLOEXEC), 1);
+    const size_t beforeTake = openFileDescriptorCount();
+    {
+        auto received = takeReceivedFileDescriptor(message);
+        EXPECT_EQ(received.status, ReceivedRightsStatus::One);
+        EXPECT_EQ(received.visibleCount, 1U);
+        ASSERT_TRUE(received.descriptor);
+        EXPECT_NE(::fcntl(received.descriptor.get(), F_GETFD) & FD_CLOEXEC, 0);
+        EXPECT_EQ(openFileDescriptorCount(), beforeTake);
+    }
+    EXPECT_EQ(openFileDescriptorCount(), beforeTake - 1);
+
+    ASSERT_GT(sendRights(sockets[0], pipeFds, 2, true), 0);
+    control.fill(0);
+    message.msg_controllen = control.size();
+    message.msg_flags = 0;
+    ASSERT_EQ(::recvmsg(sockets[1], &message, MSG_CMSG_CLOEXEC), 1);
+    const size_t beforeInvalid = openFileDescriptorCount();
+    auto invalid = takeReceivedFileDescriptor(message);
+    EXPECT_EQ(invalid.status, ReceivedRightsStatus::Invalid);
+    EXPECT_EQ(invalid.visibleCount, 2U);
+    EXPECT_FALSE(invalid.descriptor);
+    EXPECT_EQ(openFileDescriptorCount(), beforeInvalid - 2);
+
+    ::close(pipeFds[0]);
+    ::close(pipeFds[1]);
+    ::close(sockets[0]);
+    ::close(sockets[1]);

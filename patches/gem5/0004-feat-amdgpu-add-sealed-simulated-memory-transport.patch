+std::vector<uint8_t>
+encodeMemoryAck(const Header &request, const MemoryResponse &response)
+{
+    std::vector<uint8_t> payload(MemoryPayloadBytes, 0);
+    store16(payload, 0, MemoryControlMajor);
+    store16(payload, 2, MemoryControlMinor);
+    store32(payload, 4, static_cast<uint32_t>(response.status));
+    store16(payload, 8, static_cast<uint16_t>(response.opcode));
+    store64(payload, 16, response.allocationId);
+    store64(payload, 24, response.generation);
+    if (response.status == Status::Ok) {
+        store64(payload, 32, response.value0);
+        store64(payload, 40, response.value1);
+        store64(payload, 48, response.value2);
+        store64(payload, 56, response.simTick);
+    }
+    Header encoded = request;
+    encoded.messageType = MessageType::MemoryAck;
+    return encodeFrame(encoded, payload);

 #include <vector>
 
 #include "dev/amdgpu/host_gpu_dispatch_fixture.hh"
+#include "dev/amdgpu/host_gpu_code_object_fixture.hh"
 
 namespace gem5
 {
@@ -175,6 +176,42 @@ TEST(HostGpuDispatchFixture, AuthorityBytesAndMaterializationAreExact)
                            kernarg.begin()));
 }
 
+TEST(HostGpuCodeObjectFixture, LockedGfx950MetadataIsNotExecutionProof)
+{
+    using namespace code_object_fixture;
+    ASSERT_EQ(Images.size(), 2U);
+    EXPECT_EQ(ElfMachine, 224U);
+    EXPECT_EQ(ElfTypeDyn, 3U);
+    EXPECT_EQ(ElfOsabiAmdgpuHsa, 64U);
+    EXPECT_EQ(ElfAbiVersion, 4U);
+    EXPECT_EQ(ElfFlags, 0x54fU);
+    EXPECT_EQ(GfxTarget, 950U);
+    EXPECT_EQ(CodeObjectVersion, 6U);
+    EXPECT_EQ(MetadataMajor, 1U);
+    EXPECT_EQ(MetadataMinor, 2U);
+    EXPECT_EQ(DescriptorBytes, 64U);
+    EXPECT_EQ(RelocationCount, 0U);
+    EXPECT_FALSE(Gem5IsaSupported);
+
+    const auto &readWrite = Images[0];
+    EXPECT_STREQ(readWrite.id, "gfx950-rdc-gpuReadWrite-v1");
+    EXPECT_EQ(readWrite.byteCount, 5528U);
+    EXPECT_EQ(readWrite.kernelCount, 1U);
+    EXPECT_STREQ(readWrite.kernels[0].descriptorSymbol, "gpuReadWrite.kd");
+    EXPECT_EQ(readWrite.kernels[0].kernargBytes, 280U);
+    EXPECT_EQ(readWrite.kernels[0].descriptorFileOffset, 0x800U);
+    EXPECT_EQ(readWrite.kernels[0].codeEntryByteOffset, 0x1100U);
+
+    const auto &binarySearch = Images[1];
+    EXPECT_STREQ(binarySearch.id, "gfx950-rdc-binary-search-v1");
+    EXPECT_EQ(binarySearch.byteCount, 11296U);
+    EXPECT_EQ(binarySearch.kernelCount, 3U);
+    EXPECT_EQ(binarySearch.kernels[0].kernargBytes, 280U);
+    EXPECT_EQ(binarySearch.kernels[1].kernargBytes, 288U);
+    EXPECT_EQ(binarySearch.kernels[2].descriptorRsrc3, 2U);
+    EXPECT_EQ(binarySearch.kernels[2].descriptorRsrc1, 0xaf0081U);
+}
+
 TEST(HostGpuDispatchState, AdmissionPinsAndRealRetireMirrorsSignal)
 {

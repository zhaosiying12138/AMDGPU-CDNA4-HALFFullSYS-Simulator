+GpuAgent::FastCopyResult GpuAgent::TryHostAccessibleFastCopy(
+    void* dst, const void* src, size_t size,
+    const std::vector<core::Signal*>* dep_signals, core::Signal* out_signal,
+    const std::vector<core::Signal*>* gang_signals) const {
+  auto* runtime = core::Runtime::runtime_singleton_;
+  if (!runtime->flag().enable_dtif_fast_copy() || profiling_enabled()) {
+    return FastCopyResult::Fallback;
+  }
+
+  const bool async = out_signal != nullptr;
+  if (async && (dep_signals == nullptr || gang_signals == nullptr ||
+                !dep_signals->empty() || !gang_signals->empty())) {
+    return FastCopyResult::Fallback;
+  }
+
+  enum class EndpointKind { Host, Device, Unsupported };
+  struct Endpoint {
+    EndpointKind kind = EndpointKind::Unsupported;
+    void* cpu_address = nullptr;
+    bool range_overflow = false;
+    bool read_only = false;
+  };
+
+  const auto classify = [&](const void* ptr) {
+    Endpoint endpoint;
+    hsa_amd_pointer_info_t info = {};
+    info.size = sizeof(info);
+    if (runtime->PtrInfo(ptr, &info, nullptr, nullptr, nullptr) != HSA_STATUS_SUCCESS) {
+      return endpoint;
+    }
+
+    if (info.type == HSA_EXT_POINTER_TYPE_UNKNOWN) {
+      endpoint.kind = EndpointKind::Host;
+      endpoint.cpu_address = const_cast<void*>(ptr);
+      return endpoint;
+    }
+
+    const uintptr_t address = reinterpret_cast<uintptr_t>(ptr);
+    bool address_in_range = false;
+    size_t offset = 0;
+    const auto resolve_range = [&](const void* base) {
+      if (base == nullptr) return false;
+      const uintptr_t base_address = reinterpret_cast<uintptr_t>(base);
+      if (address < base_address) return false;
+      const uintptr_t candidate_offset = address - base_address;
+      if (candidate_offset >= info.sizeInBytes) return false;
+      address_in_range = true;
+      if (size > info.sizeInBytes - candidate_offset) {
+        return false;
+      }
+      offset = static_cast<size_t>(candidate_offset);
+      return true;
+    };
+
+    // Prefer the host alias when the caller supplied it. Locked allocations
+    // may expose a distinct GPU alias for the same backing store.
+    bool complete_range = resolve_range(info.hostBaseAddress);
+    if (!complete_range) complete_range = resolve_range(info.agentBaseAddress);
+    if (!complete_range) {
+      endpoint.range_overflow = address_in_range;
+      return endpoint;
+    }
+
+    if (info.hostBaseAddress == nullptr) return endpoint;
+    endpoint.cpu_address = reinterpret_cast<void*>(
+        reinterpret_cast<uintptr_t>(info.hostBaseAddress) + offset);
+    endpoint.read_only =
+        (info.alloc_flags & HSA_AMD_POINTER_INFO_ALLOC_FLAG_READONLY) != 0;
+
+    if (info.type == HSA_EXT_POINTER_TYPE_LOCKED) {
+      endpoint.kind = EndpointKind::Host;
+      return endpoint;
+    }
+    if (info.type != HSA_EXT_POINTER_TYPE_HSA) return endpoint;
+
+    if (info.agentOwner.handle == public_handle().handle) {
+      if ((info.alloc_flags & HSA_AMD_POINTER_INFO_ALLOC_FLAG_HOST_ACCESS) != 0) {
+        endpoint.kind = EndpointKind::Device;
+      }
+      return endpoint;
+    }
+
+    for (const auto* cpu_agent : runtime->cpu_agents()) {
+      if (info.agentOwner.handle == cpu_agent->public_handle().handle) {
+        endpoint.kind = EndpointKind::Host;
+        break;
+      }
+    }
+    return endpoint;
+  };
+
+  Endpoint dst_endpoint = classify(dst);
+  Endpoint src_endpoint = classify(src);
+  if (dst_endpoint.range_overflow || src_endpoint.range_overflow) {
+    return FastCopyResult::InvalidArgument;
+  }
+  if (dst_endpoint.read_only) return FastCopyResult::Fallback;
+
+  const bool h2d = dst_endpoint.kind == EndpointKind::Device &&
+                   src_endpoint.kind == EndpointKind::Host;
+  const bool d2h = dst_endpoint.kind == EndpointKind::Host &&
+                   src_endpoint.kind == EndpointKind::Device;
+  if (!h2d && !d2h) return FastCopyResult::Fallback;
+
+  std::memcpy(dst_endpoint.cpu_address, src_endpoint.cpu_address, size);
+  if (async) {
+    HSA::hsa_signal_subtract_screlease(core::Signal::Convert(out_signal), 1);
+  }
+  return FastCopyResult::Success;
+}
